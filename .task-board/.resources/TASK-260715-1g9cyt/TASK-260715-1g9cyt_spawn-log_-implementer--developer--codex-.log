+            "sdk": "iphoneos",
+            "minimum": "18.0",
+            "architectures": ["arm64"],
+            "target_triples": ["arm64-apple-ios18.0"]
+          },
+          {
+            "library_identifier": "ios-arm64_x86_64-simulator",
+            "platform": "ios",
+            "variant": "simulator",
+            "sdk": "iphonesimulator",
+            "minimum": "18.0",
