+    case .libSSH2Adapter:
+      try await LibSSH2ConformanceDriver().run(gate)
+    case .reluxNIOSSHAdapterUnavailable:
+      withKnownIssue(
+        "ReluxNIOSSH has no SSHTransport adapter target; candidate remains red without emulation"
+      ) {
