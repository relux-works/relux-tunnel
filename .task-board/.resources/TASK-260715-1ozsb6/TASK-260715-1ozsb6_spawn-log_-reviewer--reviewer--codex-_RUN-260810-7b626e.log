  1137	  private func transportError(
  1138	    code: SSHTransportErrorCode,
  1139	    phase: SSHTransportPhase,
  1140	    scope: SSHTransportErrorScope? = nil
  1141	  ) -> SSHTransportError {
  1142	    try! SSHTransportError(
  1143	      code: code,
  1144	      phase: phase,
  1145	      scope: scope ?? .lane(lane),
  1146	      retryDisposition: code == .cancelled || code == .timedOut ? .newConnection : .never,
  1147	      requiresTeardown: scope == nil,
  1148	      channelOpenReason: code == .channelOpenRejected ? .unsupported : .notApplicable
  1149	    )
  1150	  }
