   697	  private func validateAlgorithmPolicy(_ policy: SSHAlgorithmPolicy) throws {
   698	    let capabilities = LibSSH2TransportFactory().capabilities
   699	    guard Set(policy.keyExchange).isSubset(of: capabilities.keyExchangeAlgorithms),
   700	      Set(policy.hostKey).isSubset(of: capabilities.hostKeyAlgorithms),
   701	      Set(policy.cipher).isSubset(of: capabilities.cipherAlgorithms),
   702	      Set(policy.mac).isSubset(of: capabilities.macAlgorithms)
   703	    else {
   704	      throw transportError(code: .algorithmNegotiationFailed, phase: .configuration)
   705	    }
   706	    let normalized = (policy.keyExchange + policy.hostKey + policy.cipher + policy.mac)
   707	      .map { $0.lowercased() }
   708	    guard !normalized.contains(where: { $0.contains("sha1") || $0.contains("-cbc") }) else {
   709	      throw transportError(code: .algorithmNegotiationFailed, phase: .configuration)
   710	    }
   711	  }
