    /// See: ``SSHChildChannelOptions/Types/PeerMaximumMessageLengthOption``.
    public static let peerMaximumMessageLength: SSHChildChannelOptions.Types.PeerMaximumMessageLengthOption = .init()

    /// See: ``SSHChildChannelOptions/Types/ReceiveWindowConfigurationOption``.
    public static let receiveWindowConfiguration: SSHChildChannelOptions.Types.ReceiveWindowConfigurationOption =
        .init()

    /// See: ``SSHChildChannelOptions/Types/ReceiveWindowSnapshotOption``.
