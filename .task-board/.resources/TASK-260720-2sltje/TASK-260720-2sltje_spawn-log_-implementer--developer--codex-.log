+static long long monotonic_milliseconds(void)
+{
+    struct timespec now;
+
+    if(clock_gettime(CLOCK_MONOTONIC, &now))
+        return -1;
+    return (long long)now.tv_sec * 1000 + now.tv_nsec / 1000000;
