   715	  public func encode(to encoder: any Encoder) throws {
   716	    try Self.validateMetricNames(counters.keys)
   717	    try Self.validateMetricNames(gauges.keys)
   718	    try Self.validateMetricNames(histograms.keys)
   719	    var container = encoder.container(keyedBy: CodingKeys.self)
   720	    try container.encode(protocolVersion, forKey: .protocolVersion)
   721	    try container.encode(kind, forKey: .kind)
   722	    try container.encode(schemaVersion, forKey: .schemaVersion)
   723	    try container.encodeIfPresent(requestID, forKey: .requestID)
   724	    try container.encode(runtimeGeneration, forKey: .runtimeGeneration)
   725	    try container.encode(snapshotSequence, forKey: .snapshotSequence)
   726	    try container.encode(counters, forKey: .counters)
   727	    try container.encode(gauges, forKey: .gauges)
   728	    try container.encode(histograms, forKey: .histograms)
   729	    try container.encode(errors, forKey: .errors)
   730	    try container.encodeIfPresent(sshBootstrapError, forKey: .sshBootstrapError)
