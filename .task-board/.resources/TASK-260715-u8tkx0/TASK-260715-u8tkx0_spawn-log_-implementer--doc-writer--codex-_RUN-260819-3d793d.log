+validator_path = root / "scripts/relay_supply_chain.py"
+text = validator_path.read_text(encoding="utf-8")
+text, count = re.subn(
+    r'^APPROVED_RELAY_VERSION = "[^"]+"$',
+    f'APPROVED_RELAY_VERSION = "{relay_version}"',
