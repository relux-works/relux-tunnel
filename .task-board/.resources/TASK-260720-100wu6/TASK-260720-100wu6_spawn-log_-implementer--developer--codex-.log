+extension SSHHostKeyDecision {
+  public var outcome: SSHHostDecisionOutcome {
+    switch self {
+    case .acceptFirstUse:
+      .firstUseAccepted
+    case .acceptMatch:
+      .matchAccepted
+    case .rejectUnknown:
+      .unknownRejected
+    case .rejectChanged:
+      .changedRejected
+    case .rejectAlgorithm:
+      .algorithmRejected
+    case .rejectPolicy:
+      .policyRejected
