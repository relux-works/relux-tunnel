   367	    for index in range(visible.find("(", opening), len(visible)):
   368	        if not code[index]:
   369	            continue
   370	        if visible[index] == "(":
   371	            depth += 1
   372	        elif visible[index] == ")":
   373	            depth -= 1
   374	            if depth == 0:
   375	                return visible[opening : index + 1]
