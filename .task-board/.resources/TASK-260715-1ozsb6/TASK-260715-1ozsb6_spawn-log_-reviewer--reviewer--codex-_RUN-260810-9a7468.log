  1031	      throw transportError(code: .connectionClosed, phase: phase)
  1032	    }
  1033	    let directions = libssh2_session_block_directions(engineSession)
  1034	    var interests = Set<SSHTCPReadiness>()
  1035	    if directions & LIBSSH2_SESSION_BLOCK_INBOUND != 0 { interests.insert(.readable) }
  1036	    if directions & LIBSSH2_SESSION_BLOCK_OUTBOUND != 0 { interests.insert(.writable) }
  1037	    if interests.isEmpty { interests = [.readable, .writable] }
