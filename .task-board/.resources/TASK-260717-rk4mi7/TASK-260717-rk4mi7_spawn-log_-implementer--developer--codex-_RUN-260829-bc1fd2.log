@Suite("ReluxProxyMac target contract")
struct ReluxProxyMacTargetTests {
  @Test("host plist owns identity version floor and fail-closed Sparkle settings")
  func infoPlist() throws {
    let plist = try TargetContractSupport.plist(at: "App/ReluxProxyMac/Info.plist")

    #expect(plist["CFBundleIdentifier"] as? String == "$(PRODUCT_BUNDLE_IDENTIFIER)")
    #expect(plist["CFBundlePackageType"] as? String == "APPL")
    #expect(plist["CFBundleShortVersionString"] as? String == "$(MARKETING_VERSION)")
    #expect(plist["CFBundleVersion"] as? String == "$(CURRENT_PROJECT_VERSION)")
    #expect(plist["LSMinimumSystemVersion"] as? String == "$(MACOSX_DEPLOYMENT_TARGET)")
    #expect(plist["SUFeedURL"] as? String == "https://updates.relux.works/macos/appcast.xml")
    #expect(plist["SUPublicEDKey"] as? String == "tx8SLAmqME/ldUthxRV5PFQiUt1MX65blT29cA8My1U=")
    #expect(plist["SUVerifyUpdateBeforeExtraction"] as? Bool == true)
    #expect(plist["SURequireSignedFeed"] as? Bool == true)
    #expect(plist["SUSignedFeedFailureExpirationInterval"] as? Int == 0)
    #expect(plist["SUScheduledCheckInterval"] as? Int == 86_400)
    #expect(plist["SUAllowsAutomaticUpdates"] as? Bool == false)
    #expect(plist["SUAutomaticallyUpdate"] as? Bool == false)
    #expect(plist["SUEnableSystemProfiling"] as? Bool == false)
    #expect(plist["SUEnableJavaScript"] as? Bool == false)
    #expect(plist["SUShowReleaseNotes"] as? Bool == true)
    #expect(plist["SUEnableInstallerLauncherService"] as? Bool == true)
    #expect(plist["SUEnableDownloaderService"] as? Bool == false)
    #expect(plist["SUEnableInstallerConnectionService"] as? Bool == false)
    #expect(plist["SUEnableInstallerStatusService"] as? Bool == false)
  }

