    readPlatform: {
      HarnessPlatformMetadata(
        operatingSystem: "fixture",
        operatingSystemVersion: "1",
        architecture: "fixture"
      )
    }
  )
  let data = try! HarnessConfigurationCodec.encode(configuration)
