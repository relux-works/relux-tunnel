@@ -42,6 +42,13 @@
 ABSOLUTE_BUILD_PATH = re.compile(
     rb"/(?:Users|private/(?:tmp|var)|var/folders|tmp)/[^\x00\n ]+"
 )
+HEV_SDK_PLATFORMS = {
+    "iphoneos": "ios",
+    "iphonesimulator": "ios",
+    "macosx": "macos",
+    "appletvos": "tvos",
+    "appletvsimulator": "tvos",
+}
 
 
 class NativeDependencyError(RuntimeError):
@@ -106,6 +113,7 @@
     cwd: Path | None = None,
     capture: bool = False,
