+        Issue.record("cancelled channel open unexpectedly completed")
+      } catch let error as SSHTransportError {
+        #expect(error.code == .cancelled, "iteration \(iteration)")
+        #expect(error.phase == .channelOpen, "iteration \(iteration)")
