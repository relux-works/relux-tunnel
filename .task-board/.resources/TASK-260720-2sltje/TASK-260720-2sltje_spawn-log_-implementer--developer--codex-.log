+
+    sleep_milliseconds(1100);
+    rc = libssh2_session_global_request(
+        session, keepalive_name, sizeof(keepalive_name) - 1,
+        NULL, 0, &reply);
+    if(rc != LIBSSH2_ERROR_TIMEOUT ||
+       reply != LIBSSH2_GLOBAL_REQUEST_REPLY_NONE)
+        return 1;
+    ++misses;
