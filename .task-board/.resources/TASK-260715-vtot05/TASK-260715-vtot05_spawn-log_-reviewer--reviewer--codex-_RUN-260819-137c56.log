   577	def read_archive_assets(archive: Path, contract: dict[str, Any]) -> list[bytes]:
   578	    provenance = validate_provenance(contract["buildProvenance"])
   579	    descriptor: int | None
   580	    descriptor, _ = open_regular_path(
   581	        archive,
   582	        "trusted relay archive",
   583	        maximum_size=MAX_ARCHIVE_BYTES,
   584	    )
   585	    try:
   586	        try:
   587	            archive_stream = os.fdopen(descriptor, "rb")
   588	        except BaseException:
   589	            close_descriptor_after_fdopen_failure(descriptor)
   590	            descriptor = None
   591	            raise
   592	        descriptor = None
   593	        with archive_stream:
   594	            if sha256_stream(archive_stream) != provenance["archiveSHA256"]:
   595	                raise AssetManifestError("trusted relay archive checksum mismatch")
   596	            archive_stream.seek(0)
   597	            with gzip.GzipFile(fileobj=archive_stream, mode="rb") as decompressed:
   598	                return parse_ustar_assets(decompressed, contract)
   599	    except (EOFError, gzip.BadGzipFile, OSError) as error:
   600	        raise AssetManifestError("trusted relay archive is unparseable") from error
   601	    finally:
   602	        if descriptor is not None:
   603	            os.close(descriptor)
