+        peakOpenChannels: peakOpenChannels.load(ordering: .relaxed),
+        peakReservedQueuedBytes: peakReservedQueuedBytes.load(ordering: .relaxed),
+        peakAdapterBufferedBytes: peakAdapterBufferedBytes.load(ordering: .relaxed)
+      )
