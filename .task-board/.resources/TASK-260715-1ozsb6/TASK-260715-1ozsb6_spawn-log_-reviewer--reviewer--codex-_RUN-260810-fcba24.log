  1461	  private func beginChannelEOF(
  1462	    identity: SSHChannelIdentity,
  1463	    until deadline: ContinuousClock.Instant
  1464	  ) async throws -> LibSSH2SessionOperationPermit {
  1465	    try beginChannelOperation(identity: identity, phase: .channelEOF)
  1466	    guard let writeGate = channelWriteGates[identity] else {
  1467	      finishChannelOperation(identity: identity)
  1468	      throw transportError(code: .channelClosed, phase: .channelEOF, scope: .channel(identity))
  1469	    }
  1470	    do {
  1471	      let now = dependencies.clock.now()
  1472	      guard now < deadline else { throw LibSSH2TimeoutError.elapsed }
  1473	      return try await withTimeout(now.duration(to: deadline), clock: dependencies.clock) {
  1474	        try await writeGate.acquire()
  1475	      }
  1476	    } catch {
  1477	      finishChannelOperation(identity: identity)
  1478	      if (error as? LibSSH2SessionOperationGateError) == .resourceLimitExceeded {
  1479	        throw transportError(
  1480	          code: .resourceLimitExceeded,
  1481	          phase: .channelEOF,
  1482	          scope: .channel(identity)
  1483	        )
  1484	      }
