   354	  private func exerciseRepeatedConcurrentCancellation(transport: LibSSH2Transport) async throws {
   355	    for iteration in 0..<5 {
   356	      let channel = try await transport.openExecChannel(
   357	        request: SSHExecRequest(command: "sleep 2"),
   358	        policy: fixtureChannelPolicy()
   359	      )
   360	      let pendingRead = Task { try await channel.read(maximumBytes: 1) }
   361	      for _ in 0..<200 {
   362	        if await transport.snapshot().gauges.pendingReads == 1 { break }
   363	        await Task.yield()
   364	      }
   365	      #expect(await transport.snapshot().gauges.pendingReads == 1, "iteration \(iteration)")
   366	      await channel.cancel()
   367	      do {
   368	        _ = try await pendingRead.value
   369	        Issue.record(
   370	          "concurrent channel read unexpectedly completed", sourceLocation: #_sourceLocation)
   371	      } catch let error as SSHTransportError {
   372	        #expect(error.code == .cancelled, "iteration \(iteration)")
   373	        #expect(error.phase == .channelRead, "iteration \(iteration)")
   374	      }
   375	      #expect(await transport.snapshot().gauges.pendingReads == 0, "iteration \(iteration)")
   376	    }
   377	  }
