+      #expect(channel.writtenBytes == localPayload)
+      #expect(local.writtenBytes == remotePayload)
+      #expect(sha256Hex(channel.writtenBytes) == sha256Hex(localPayload))
+      #expect(sha256Hex(local.writtenBytes) == sha256Hex(remotePayload))
