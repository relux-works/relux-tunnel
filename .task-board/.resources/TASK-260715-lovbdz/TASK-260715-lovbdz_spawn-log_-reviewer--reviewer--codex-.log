   573	  private static func isValid(_ value: String) -> Bool {
   574	    guard !value.isEmpty, value.utf8.count <= maximumUTF8Bytes else { return false }
   575	    return value.utf8.allSatisfy {
   576	      (UInt8(ascii: "a")...UInt8(ascii: "z")).contains($0)
   577	        || (UInt8(ascii: "0")...UInt8(ascii: "9")).contains($0)
   578	        || $0 == UInt8(ascii: "_")
   579	    }
   580	  }
   581	}
