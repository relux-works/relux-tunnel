    #if compiler(>=6.2)\n39|      case .wifiAware:\n40|        return SSHBootstrapErrorMapper.transport(\n41|          .unavailable,\n42|          stage: stage,\n43|          configurationGeneration: configurationGeneration,\n44|          context: context\n45|        )\n46|    #endif\n47|    @unknown default:\n48|      return SSHBootstrapErrorMapper.transport(\n49|        .unexpected,\n50|        stage: stage,\n51|        configurationGeneration: configurationGeneration,\n52|        context: context\n53|      )\n54|    }\n55|  }\n56|\n57|  public static func credential(\n58|    _ error: MacOSCredentialResolverError,\n59|    configurationGeneration: UInt64\n60|  ) -> SSHBootstrapProviderError {\n61|    switch error {\n62|    case .credentialNotProvisioned:\n63|      SSHBootstrapErrorMapper.credential(\n64|        .notProvisioned,\n65|        configurationGeneration: configurationGeneration\n66|      )\n67|    case .credentialAccessDenied:\n68|      SSHBootstrapErrorMapper.credential(\n69|        .accessDenied,\n70|        configurationGeneration: configurationGeneration\n71|      )\n72|    case .credentialWrongClass, .credentialMalformed:\n73|      SSHBootstrapErrorMapper.credential(\n74|        .malformed,\n75|        configurationGeneration: configurationGeneration\n76|      )\n77|    case .credentialGenerationMismatch:\n78|      SSHBootstrapErrorMapper.credential(\n79|        .generationMismatch,\n80|        configurationGeneration: configurationGeneration\n81|      )\n82|    case .credentialPassphraseRequired:\n83|      SSHBootstrapErrorMapper.credential(\n84|        .passphraseRequired,\n85|        configurationGeneration: configurationGeneration\n86|      )\n87|    case .credentialPassphraseInvalid:\n88|      SSHBootstrapErrorMapper.credential(\n89|        .passphraseInvalid,\n90|        configurationGeneration: configurationGeneration\n91|      )\n92|    case .credentialKeyUnsupported:\n93|      SSHBootstrapErrorMapper.credential(\n94|        .keyUnsupported,\n95|        configurationGeneration: configurationGeneration\n96|      )\n97|    case .operationCancelled:\n98|      SSHBootstrapErrorMapper.cancellation(\n99|        .taskCancelled,\n100|        configurationGeneration: configurationGeneration\n101|      )\n102|    }\n103|  }\n104|\n105|  static func credential(\n106|    status: OSStatus,\n107|    itemLookup: Bool,\n108|    configurationGeneration: UInt64\n109|  ) -> SSHBootstrapProviderError {\n110|    credential(\n111|      MacOSCredentialResolverError(status: status, itemLookup: itemLookup),\n112|      configurationGeneration: configurationGeneration\n113|    )\n114|  }\n115|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
