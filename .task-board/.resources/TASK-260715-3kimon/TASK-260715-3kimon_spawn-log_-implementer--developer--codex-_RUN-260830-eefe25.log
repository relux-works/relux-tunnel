+  @Test("pressure gates every channel class and never mutates rejected reservations")
+  func pressureClassMatrix() throws {
+    let lane = fixtureLane()
+    let bulkMeasurement = SSHBulkPathMeasurement(
+      bandwidthBitsPerSecond: 8_000_000,
+      roundTripTimeNanoseconds: 64_000_000)
+    let cases: [(SSHReceiveWindowPressure, SSHReceiveWindowClass, Bool)] = [
+      (.pressure, .control, true),
+      (.pressure, .ordinary, false),
+      (.pressure, .bulk, false),
+      (.pressure, .relay, true),
+      (.critical, .control, false),
+      (.critical, .ordinary, false),
+      (.critical, .bulk, false),
+      (.critical, .relay, false),
+    ]
+
+    for (index, testCase) in cases.enumerated() {
+      let (pressure, channelClass, permitted) = testCase
+      var ledger = try fixtureLedger(lane: lane)
+      ledger.setPressure(pressure)
+      let before = ledger.snapshot()
+      let measurement = channelClass == .bulk ? bulkMeasurement : nil
+
+      if permitted {
+        _ = try ledger.reserveInitial(
+          channel: fixtureChannel(50 + index),
+          lane: lane.identity,
+          channelClass: channelClass,
+          generation: 7,
+          bulkMeasurement: measurement)
+        #expect(ledger.snapshot().reservedChannelCount == 1)
+      } else {
+        #expect(throws: SSHReceiveWindowRefusal.memoryPressure) {
+          _ = try ledger.reserveInitial(
+            channel: fixtureChannel(50 + index),
+            lane: lane.identity,
+            channelClass: channelClass,
+            generation: 7,
+            bulkMeasurement: measurement)
+        }
+        let after = ledger.snapshot()
+        #expect(after.reservedChannelCount == before.reservedChannelCount)
+        #expect(after.managedWindowReservedBytes == before.managedWindowReservedBytes)
+        #expect(after.globalWindowReservedBytes == before.globalWindowReservedBytes)
+        #expect(after.ledgerCommittedBytes == before.ledgerCommittedBytes)
+        #expect(after.laneWindowReservedBytes == before.laneWindowReservedBytes)
+        #expect(after.metrics.initialReservations == before.metrics.initialReservations)
+        #expect(after.metrics.refusals[.memoryPressure] == 1)
+      }
+    }
+  }
