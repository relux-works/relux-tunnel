  1076	  private func lookupSnapshot(generation: UInt64) async -> TunnelRuntimePublishedSnapshot? {
  1077	    guard activeGeneration?.identifier == generation else { return nil }
  1078	    guard let signal = activeGeneration?.retirementSignal else { return nil }
  1079	    let first = ProviderFirstResult<SnapshotLookupResult>()
  1080	    Task { [snapshotSource] in
  1081	      first.resolve(.value(await snapshotSource.latestProviderSnapshot()))
  1082	    }
  1083	    let retirement = Task {
  1084	      do {
  1085	        try await signal.wait()
  1086	        first.resolve(.retired)
  1087	      } catch {
  1088	        // The source won and removed this retirement subscription.
  1089	      }
  1090	    }
  1091	    let result = await first.wait()
  1092	    if case .value = result { retirement.cancel() }
  1093	    switch result {
  1094	    case .value(let snapshot):
  1095	      return snapshot
  1096	    case .retired:
  1097	      return nil
  1098	    }
  1099	  }
