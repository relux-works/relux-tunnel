+          fingerprintSHA256: fingerprint,
+          observedAt: timestamp
+        )
+      ),
+      isAccepted: false
+    ),
+    HostDecisionCase(name: "rejectChanged", decision: .rejectChanged, isAccepted: false),
+    HostDecisionCase(
+      name: "rejectRevoked",
+      decision: .rejectRevoked(audit),
