+    )
+
+    await transport.close()
+    await transport.close()
+    let closed = await transport.snapshot()
+    #expect(closed.connectionState == .closed)
+    #expect(closed.gauges.openDirectChannels == 0)
+    #expect(closed.gauges.openExecChannels == 0)
+  }
