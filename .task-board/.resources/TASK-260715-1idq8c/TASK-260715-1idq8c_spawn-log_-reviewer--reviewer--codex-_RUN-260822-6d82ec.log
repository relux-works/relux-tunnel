    10	
    11	let output = URL(fileURLWithPath: CommandLine.arguments[1], isDirectory: true)
    12	try FileManager.default.createDirectory(at: output, withIntermediateDirectories: true)
    13	
    14	func write(_ color: NSColor, to url: URL) throws {
    15	  guard
    16	    let bitmap = NSBitmapImageRep(
    17	      bitmapDataPlanes: nil,
    18	      pixelsWide: 32,
    19	      pixelsHigh: 32,
    20	      bitsPerSample: 8,
    21	      samplesPerPixel: 4,
    22	      hasAlpha: true,
    23	      isPlanar: false,
    24	      colorSpaceName: .deviceRGB,
    25	      bytesPerRow: 0,
    26	      bitsPerPixel: 0
    27	    )
    28	  else {
    29	    throw CocoaError(.fileWriteUnknown)
    30	  }
    31	  for y in 0..<bitmap.pixelsHigh {
    32	    for x in 0..<bitmap.pixelsWide {
    33	      bitmap.setColor(color, atX: x, y: y)
    34	    }
    35	  }
    36	  guard let data = bitmap.representation(using: .png, properties: [:]) else {
    37	    throw CocoaError(.fileWriteUnknown)
    38	  }
    39	  try data.write(to: url, options: .atomic)
    40	}
    41	
    42	try write(
    43	  NSColor(deviceRed: 0.10, green: 0.35, blue: 0.90, alpha: 1),
    44	  to: output.appendingPathComponent("reference-input.png")
    45	)
    46	try write(
    47	  NSColor(deviceRed: 0.95, green: 0.35, blue: 0.10, alpha: 1),
