   882	
   883	private func makeSocketPair(sendBufferBytes: Int32? = nil) throws -> TestSocketPair {
   884	  var descriptors = [Int32](repeating: -1, count: 2)
   885	  guard socketpair(AF_UNIX, SOCK_STREAM, 0, &descriptors) == 0 else {
   886	    throw UDPAdapterTestError.systemCall(errno)
   887	  }
   888	  if var sendBufferBytes {
   889	    guard
   890	      setsockopt(
   891	        descriptors[0],
   892	        SOL_SOCKET,
   893	        SO_SNDBUF,
   894	        &sendBufferBytes,
   895	        socklen_t(MemoryLayout.size(ofValue: sendBufferBytes))
   896	      ) == 0
   897	    else {
   898	      Darwin.close(descriptors[0])
   899	      Darwin.close(descriptors[1])
   900	      throw UDPAdapterTestError.systemCall(errno)
   901	    }
