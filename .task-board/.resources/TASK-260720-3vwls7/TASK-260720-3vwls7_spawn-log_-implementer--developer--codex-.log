+        "libssh2_cmake_flags": [
+          "-DBUILD_STATIC_LIBS=ON",
+          "-DBUILD_SHARED_LIBS=OFF",
+          "-DBUILD_EXAMPLES=OFF",
+          "-DBUILD_TESTING=OFF",
+          "-DLIBSSH2_BUILD_DOCS=OFF",
+          "-DENABLE_DEBUG_LOGGING=OFF",
