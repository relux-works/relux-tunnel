  1049	      }
  1050	      if error is CancellationError
  1051	        || (error as? LibSSH2SessionOperationGateError) == .shutDown
  1052	      {
  1053	        throw transportError(code: .cancelled, phase: .channelOpen, scope: .operation)
  1054	      }
  1055	      throw map(error, phase: .channelOpen, scope: .operation)
  1056	    }
  1057	  }
