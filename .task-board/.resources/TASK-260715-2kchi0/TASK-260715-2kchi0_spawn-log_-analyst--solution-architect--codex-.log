+        "server", "algorithms", "profile", "policies", "parameters",
+        "traffic", "impairment", "schedule",
+    ):
+        projected[key] = data[key]
+    return projected
+
+
+try:
+    with open(sys.argv[1], "r", encoding="utf-8") as source:
+        document = json.load(
