   662	  private func finishRekeyFlight(with result: Result<Void, Error>) {
   663	    let waiters = Array(rekeyWaiters.values)
   664	    rekeyWaiters.removeAll(keepingCapacity: false)
   665	    rekeyReasons.removeAll(keepingCapacity: false)
   666	    rekeyFlightInProgress = false
   667	    rekeyFlightDeadline = nil
   668	    for waiter in waiters { waiter.complete(with: result) }
   669	  }
