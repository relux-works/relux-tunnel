    28	  @Test("Unicode and noncanonical or malformed stored host names fail closed")
    29	  func invalidHostNames() throws {
    30	    let invalidHosts: [SSHProfileCanonicalHost] = [
    31	      .init(kind: .dns, value: "bücher.example"),
    32	      .init(kind: .dns, value: "Example.com"),
    33	      .init(kind: .dns, value: "example.com."),
    34	      .init(kind: .dns, value: "example..com"),
    35	      .init(kind: .dns, value: "_ssh.example.com"),
    36	      .init(kind: .dns, value: "192.168.001.1"),
