diff --git a/.temp/TASK-260717-xempiv/read-sparkle-public-key.swift b/.temp/TASK-260717-xempiv/read-sparkle-public-key.swift
new file mode 100644
index 0000000000000000000000000000000000000000..bafcfc4212097f63914108aa56888896d77c143d
--- /dev/null
+++ b/.temp/TASK-260717-xempiv/read-sparkle-public-key.swift
@@ -0,0 +1,29 @@
+import Foundation
+import Security
+
+let query: [String: Any] = [
+  kSecClass as String: kSecClassGenericPassword,
+  kSecAttrService as String: "https://sparkle-project.org",
+  kSecAttrAccount as String: "ed25519",
+  kSecAttrProtocol as String: kSecAttrProtocolSSH,
+  kSecReturnAttributes as String: true,
+  kSecReturnData as String: false,
+]
+
+var result: CFTypeRef?
+let status = SecItemCopyMatching(query as CFDictionary, &result)
+guard status == errSecSuccess else {
+  FileHandle.standardError.write(Data("attribute lookup failed: \(status)\n".utf8))
+  exit(1)
+}
+guard
+  let attributes = result as? [String: Any],
+  let comment = attributes[kSecAttrComment as String] as? String,
+  let publicKey = comment.split(separator: "\n").last.map(String.init),
+  Data(base64Encoded: publicKey)?.count == 32
+else {
+  FileHandle.standardError.write(Data("public key comment is missing or malformed\n".utf8))
+  exit(2)
+}
+
+print(publicKey)
