   844	  private func exerciseRepeatedConcurrentCancellation(transport: LibSSH2Transport) async throws {
   845	    for iteration in 0..<5 {
   846	      let channel = try await transport.openExecChannel(
   847	        request: SSHExecRequest(command: "sleep 2"),
   848	        policy: fixtureChannelPolicy()
   849	      )
   850	      let pendingRead = Task { try await channel.read(maximumBytes: 1) }
   851	      for _ in 0..<200 {
