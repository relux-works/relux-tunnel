+  public static func apple(rawValue: Int, duringStartup: Bool) -> Self {
+    switch rawValue {
+    case 1:
+      .userInitiated
+    case 2:
+      .providerFailure
+    case 7, 14 where duringStartup:
+      .startupFailure
