diff --git a/Tests/ReluxProxyMacTests/ReluxUpdateSettingsTests.swift b/Tests/ReluxProxyMacTests/ReluxUpdateSettingsTests.swift
new file mode 100644
index 0000000..80b6e22
--- /dev/null
+++ b/Tests/ReluxProxyMacTests/ReluxUpdateSettingsTests.swift
@@ -0,0 +1,282 @@
+import Foundation
+import Testing
+@testable import ReluxProxyMac
+
+@Suite("ReluxProxyMac update settings")
+@MainActor
+struct ReluxUpdateSettingsTests {
+  private let stableFeedURL = URL(string: "https://updates.relux.works/macos/appcast.xml")!
+
+  @Test("preferences persist only the automatic-check and channel values")
+  func preferencesPersistAcrossReconstruction() throws {
+    let suiteName = "ReluxUpdateSettingsTests.\(UUID().uuidString)"
+    let defaults = try #require(UserDefaults(suiteName: suiteName))
+    defer { defaults.removePersistentDomain(forName: suiteName) }
+
+    let firstStore = ReluxUserDefaultsUpdatePreferences(defaults: defaults)
+    #expect(firstStore.automaticallyChecksForUpdates)
+    #expect(firstStore.selectedChannel == .stable)
+    firstStore.automaticallyChecksForUpdates = false
+    firstStore.selectedChannel = .preRelease
+
+    let reconstructedStore = ReluxUserDefaultsUpdatePreferences(defaults: defaults)
+    #expect(!reconstructedStore.automaticallyChecksForUpdates)
+    #expect(reconstructedStore.selectedChannel == .preRelease)
+    #expect(
+      Set(defaults.persistentDomain(forName: suiteName)?.keys.map { $0 } ?? []) == [
+        ReluxUserDefaultsUpdatePreferences.automaticChecksKey,
+        ReluxUserDefaultsUpdatePreferences.selectedChannelKey,
+      ])
+  }
+
+  @Test("configured pre-release metadata gates the channel selector")
+  func channelPolicyGatesPreReleaseSelection() {
+    let preferences = TestUpdatePreferences(
+      automaticallyChecksForUpdates: false,
+      selectedChannel: .preRelease
+    )
+    let updater = TestUpdater()
+    let scheduler = TestUpdateScheduler()
+    let model = makeModel(
+      preReleaseChannel: nil,
+      preferences: preferences,
+      updater: updater,
+      scheduler: scheduler
+    )
+
+    #expect(!model.feedPolicy.supportsPreRelease)
+    #expect(model.selectedChannel == .stable)
+    #expect(preferences.selectedChannel == .stable)
+    #expect(updater.selectedChannel == .stable)
+    model.selectedChannel = .preRelease
+    #expect(model.selectedChannel == .stable)
+  }
+
+  @Test("malformed pre-release metadata fails closed")
+  func malformedChannelMetadataFailsClosed() {
+    #expect(throws: ReluxProxyUpdaterConfigurationError.invalidPreReleaseChannel) {
+      try ReluxProxyUpdaterConfiguration.feedPolicy(
+        in: [
+          "SUFeedURL": stableFeedURL.absoluteString,
+          "ReluxPreReleaseUpdateChannel": "beta/../../private",
+        ])
+    }
+  }
+
+  @Test("Check for Updates invokes the updater exactly once")
+  func checkForUpdatesExactlyOnce() {
+    let updater = TestUpdater()
+    let model = makeModel(updater: updater)
+
+    model.checkForUpdates()
+
+    #expect(updater.checkCount == 1)
+    #expect(model.presentationModel.state == .checking)
+    #expect(!model.canCheckForUpdates)
+  }
+
+  @Test("automatic scheduling is idempotent and cancellation is cancel-safe")
+  func schedulingAndCancellation() {
+    let preferences = TestUpdatePreferences()
+    let updater = TestUpdater()
+    let scheduler = TestUpdateScheduler()
+    let model = makeModel(
+      preferences: preferences,
+      updater: updater,
+      scheduler: scheduler
+    )
+
+    #expect(scheduler.scheduledIntervals == [86_400])
+    #expect(scheduler.cancelCount == 0)
+    model.automaticallyChecksForUpdates = true
+    #expect(scheduler.scheduledIntervals == [86_400])
+
+    model.automaticallyChecksForUpdates = false
+    model.automaticallyChecksForUpdates = false
+    #expect(scheduler.cancelCount == 1)
+    #expect(!preferences.automaticallyChecksForUpdates)
+  }
+
+  @Test("disabled automatic checks remain suppressed after reconstruction")
+  func disabledChecksRemainSuppressedAfterRelaunch() {
+    let preferences = TestUpdatePreferences(automaticallyChecksForUpdates: false)
+    let firstScheduler = TestUpdateScheduler()
+    _ = makeModel(preferences: preferences, scheduler: firstScheduler)
+    let relaunchedScheduler = TestUpdateScheduler()
+    _ = makeModel(preferences: preferences, scheduler: relaunchedScheduler)
+
+    #expect(firstScheduler.scheduledIntervals.isEmpty)
+    #expect(firstScheduler.cancelCount == 1)
+    #expect(relaunchedScheduler.scheduledIntervals.isEmpty)
+    #expect(relaunchedScheduler.cancelCount == 1)
+  }
+
+  @Test("channel changes persist and reset the accepted updater cycle once")
+  func channelChangeReconfiguresUpdater() {
+    let preferences = TestUpdatePreferences()
+    let updater = TestUpdater()
+    let model = makeModel(preferences: preferences, updater: updater)
+    let resetBaseline = updater.resetCount
+
+    model.selectedChannel = .preRelease
+    model.selectedChannel = .preRelease
+
+    #expect(preferences.selectedChannel == .preRelease)
+    #expect(updater.selectedChannel == .preRelease)
+    #expect(updater.resetCount == resetBaseline + 1)
+  }
+
+  @Test("every updater lifecycle event has a deterministic presentation state")
+  func presentationStates() {
+    let presentation = ReluxUpdatePresentationModel()
+    let cases: [(ReluxUpdatePresentationEvent, ReluxUpdatePresentationState)] = [
+      (.reset, .idle),
+      (.checkStarted, .checking),
+      (.upToDate, .upToDate),
+      (.updateAvailable, .available),
+      (.downloadStarted, .downloading),
+      (.readyToRelaunch, .readyToRelaunch),
+      (.failed, .failed),
+    ]
+
+    for (event, expectedState) in cases {
+      presentation.receive(event)
+      #expect(presentation.state == expectedState)
+    }
+  }
+
+  @Test("failure presentation discards URL path signature key and token details")
+  func failurePresentationIsRedacted() {
+    let presentation = ReluxUpdatePresentationModel()
+    let sensitiveValues = [
+      "https://updates.example/private/appcast.xml?token=secret",
+      "/Users/private/update.zip",
+      "signature=private-signature",
+      "key=private-key",
+    ]
+    let error = NSError(
+      domain: sensitiveValues.joined(separator: " "),
+      code: 42,
+      userInfo: [NSLocalizedDescriptionKey: sensitiveValues.joined(separator: " ")]
+    )
+
+    presentation.receiveFailure(error)
+    let message = String(localized: presentation.state.message)
+
+    #expect(presentation.state == .failed)
+    for sensitiveValue in sensitiveValues {
+      #expect(!message.contains(sensitiveValue))
+    }
+  }
+
+  @Test("background checks cannot steal focus through Sparkle standard UI")
+  func backgroundPresentationDoesNotStealFocus() {
+    #expect(!ReluxScheduledUpdatePresentationPolicy.letsSparklePresent(userInitiated: false))
+    #expect(ReluxScheduledUpdatePresentationPolicy.letsSparklePresent(userInitiated: true))
+  }
+
+  @Test("production host uses MenuBarExtra without activating a window")
+  func menuBarHostContract() throws {
+    let source = try TargetContractSupport.text(at: "App/ReluxProxyMac/Sources/main.swift")
+    let menu = try TargetContractSupport.text(
+      at: "App/ReluxProxyMac/Sources/ReluxUpdateSettings.swift"
+    )
+
+    #expect(source.contains("MenuBarExtra("))
+    #expect(!source.contains("NSApplication.shared.activate"))
+    #expect(!source.contains("openWindow"))
+    #expect(menu.contains("Automatically Check for Updates"))
+    #expect(menu.contains("Check for Updates…"))
+    #expect(menu.contains("if model.feedPolicy.supportsPreRelease"))
+  }
+
+  @Test("English update copy is present in the host string catalog")
+  func localizedEnglishCopy() throws {
+    let catalogData = try TargetContractSupport.data(
+      at: "App/ReluxProxyMac/Resources/Localizable.xcstrings"
+    )
+    let catalog = try #require(
+      JSONSerialization.jsonObject(with: catalogData) as? [String: Any]
+    )
+    let strings = try #require(catalog["strings"] as? [String: Any])
+
+    for expected in [
+      "Automatically Check for Updates",
+      "Check for Updates…",
+      "Update Channel",
+      "The update check failed. Try again later.",
+    ] {
+      #expect(strings[expected] != nil)
+    }
+  }
+
+  private func makeModel(
+    preReleaseChannel: String? = "prerelease",
+    preferences: TestUpdatePreferences = TestUpdatePreferences(),
+    updater: TestUpdater = TestUpdater(),
+    scheduler: TestUpdateScheduler = TestUpdateScheduler()
+  ) -> ReluxUpdateSettingsModel {
+    ReluxUpdateSettingsModel(
+      feedPolicy: ReluxUpdateFeedPolicy(
+        stableFeedURL: stableFeedURL,
+        preReleaseChannel: preReleaseChannel
+      ),
+      preferences: preferences,
+      updater: updater,
+      scheduler: scheduler
+    )
+  }
+}
+
+final class TestUpdatePreferences: ReluxUpdatePreferencesStoring {
+  var automaticallyChecksForUpdates: Bool
+  var selectedChannel: ReluxUpdateChannel
+
+  init(
+    automaticallyChecksForUpdates: Bool = true,
+    selectedChannel: ReluxUpdateChannel = .stable
+  ) {
+    self.automaticallyChecksForUpdates = automaticallyChecksForUpdates
+    self.selectedChannel = selectedChannel
+  }
+}
+
+@MainActor
+private final class TestUpdater: ReluxUpdaterControlling {
+  var automaticallyChecksForUpdates = false
+  var updateCheckInterval: TimeInterval = 0
+  var selectedChannel: ReluxUpdateChannel = .stable
+  var canCheckForUpdates = true
+  private(set) var checkCount = 0
+  private(set) var resetCount = 0
+
+  func checkForUpdates() {
+    checkCount += 1
+  }
+
+  func resetUpdateCycle() {
+    resetCount += 1
+  }
+}
+
+@MainActor
+final class TestUpdateScheduler: ReluxUpdateScheduling {
+  private(set) var scheduledIntervals: [TimeInterval] = []
+  private(set) var cancelCount = 0
+
+  func scheduleAutomaticChecks(
+    every interval: TimeInterval,
+    using updater: any ReluxUpdaterControlling
+  ) {
+    scheduledIntervals.append(interval)
+    updater.updateCheckInterval = interval
+    updater.automaticallyChecksForUpdates = true
+    updater.resetUpdateCycle()
+  }
+
+  func cancelAutomaticChecks(using updater: any ReluxUpdaterControlling) {
+    cancelCount += 1
+    updater.automaticallyChecksForUpdates = false
+    updater.resetUpdateCycle()
+  }
+}
