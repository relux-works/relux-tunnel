-    await context.dependencies.runtime.metrics.incrementCounter(
-      named: "harness.mtu_matrix.packets_sent",
-      by: rows.reduce(0) { $0 + UInt64($1.packetsSent) }
-    )
-    await context.dependencies.runtime.metrics.incrementCounter(
