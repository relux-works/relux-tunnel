    46	static HevSocks5Addr *
    47	hev_socks5_client_udp_get_upstream_addr (HevSocks5Client *base)
    48	{
    49	    HevSocks5AddrFamily family;
    50	    HevSocks5Addr *addr;
    51	
    52	    family = hev_socks5_get_addr_family (HEV_SOCKS5 (base));
    53	
    54	    switch (family) {
    55	    case HEV_SOCKS5_ADDR_FAMILY_IPV4:
    56	        addr = hev_malloc0 (7);
    57	        if (addr)
    58	            addr->atype = HEV_SOCKS5_ADDR_TYPE_IPV4;
    59	        break;
    60	    case HEV_SOCKS5_ADDR_FAMILY_IPV6:
    61	        addr = hev_malloc0 (19);
    62	        if (addr)
    63	            addr->atype = HEV_SOCKS5_ADDR_TYPE_IPV6;
    64	        break;
    65	    default:
    66	        addr = NULL;
    67	    }
    68	
    69	    return addr;
    70	}
    71	
    72	static int
    73	hev_socks5_client_udp_set_upstream_addr (HevSocks5Client *base,
    74	                                         HevSocks5Addr *addr)
    75	{
    76	    HevSocks5ClientUDP *self = HEV_SOCKS5_CLIENT_UDP (base);
    77	    struct sockaddr_in6 saddr;
    78	    struct sockaddr *sadp;
    79	    HevSocks5Class *klass;
    80	    int addr_family;
    81	    int res;
    82	    int fd;
    83	
    84	    if (HEV_SOCKS5 (base)->type != HEV_SOCKS5_TYPE_UDP_IN_UDP)
    85	        return 0;
    86	
    87	    memset (&saddr, 0, sizeof (saddr));
    88	    addr_family = hev_socks5_get_addr_family (HEV_SOCKS5 (self));
    89	    res = hev_socks5_addr_into_sockaddr6 (addr, &saddr, &addr_family);
    90	    if (res < 0) {
    91	        LOG_W ("%p socks5 client udp addr", self);
    92	        return -1;
    93	    }
    94	
    95	    fd = hev_socks5_socket (SOCK_DGRAM);
    96	    if (fd < 0) {
    97	        LOG_E ("%p socks5 client udp socket", self);
    98	        return -1;
    99	    }
   100	
   101	    sadp = (struct sockaddr *)&saddr;
   102	    klass = HEV_OBJECT_GET_CLASS (self);
   103	    res = klass->binder (HEV_SOCKS5 (self), fd, sadp);
   104	    if (res < 0) {
   105	        LOG_W ("%p socks5 client udp bind", self);
   106	        hev_task_del_fd (hev_task_self (), fd);
   107	        close (fd);
   108	        return -1;
   109	    }
   110	
   111	    res = hev_task_io_socket_connect (fd, sadp, sizeof (saddr), task_io_yielder,
   112	                                      self);
   113	    if (res < 0) {
   114	        LOG_I ("%p socks5 client udp connect", self);
   115	        hev_task_del_fd (hev_task_self (), fd);
   116	        close (fd);
   117	        return -1;
   118	    }
   119	
   120	    HEV_SOCKS5 (self)->udp_associated = 1;
   121	    self->fd = fd;
   122	
   123	    return 0;
   124	}
