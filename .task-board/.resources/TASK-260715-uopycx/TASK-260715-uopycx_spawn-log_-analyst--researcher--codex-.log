   274	        struct sockaddr *saddr = mvec[0].msg_hdr.msg_name;
   275	        socklen_t alen = mvec[0].msg_hdr.msg_namelen;
   276	        if (connect (fd, saddr, alen) < 0)
   277	            return -1;
   278	        HEV_SOCKS5 (self)->udp_associated = 1;
   279	    }
