diff --git a/App/ReluxProxyMac/Sources/ReluxProxyUpdaterLifecycle.swift b/App/ReluxProxyMac/Sources/ReluxProxyUpdaterLifecycle.swift
new file mode 100644
index 0000000..88beebb
--- /dev/null
+++ b/App/ReluxProxyMac/Sources/ReluxProxyUpdaterLifecycle.swift
@@ -0,0 +1,81 @@
+import AppKit
+import Foundation
+import Sparkle
+
+enum ReluxProxyUpdaterConfigurationError: Error, Equatable {
+  case missingFeedURL
+  case invalidFeedURL
+  case missingPublicEDKey
+  case invalidPublicEDKey
+}
+
+enum ReluxProxyUpdaterConfiguration {
+  static let feedURLKey = "SUFeedURL"
+  static let publicEDKeyKey = "SUPublicEDKey"
+
+  static func feedURL(in infoDictionary: [String: Any]) throws -> URL {
+    guard let rawValue = infoDictionary[feedURLKey] as? String, !rawValue.isEmpty else {
+      throw ReluxProxyUpdaterConfigurationError.missingFeedURL
+    }
+    guard
+      let components = URLComponents(string: rawValue),
+      components.scheme == "https",
+      components.host != nil,
+      components.user == nil,
+      components.password == nil,
+      components.query == nil,
+      components.fragment == nil,
+      let url = components.url
+    else {
+      throw ReluxProxyUpdaterConfigurationError.invalidFeedURL
+    }
+    return url
+  }
+
+  static func publicEDKey(in infoDictionary: [String: Any]) throws -> Data {
+    guard let rawValue = infoDictionary[publicEDKeyKey] as? String, !rawValue.isEmpty else {
+      throw ReluxProxyUpdaterConfigurationError.missingPublicEDKey
+    }
+    guard let publicKey = Data(base64Encoded: rawValue), publicKey.count == 32 else {
+      throw ReluxProxyUpdaterConfigurationError.invalidPublicEDKey
+    }
+    return publicKey
+  }
+}
+
+enum ReluxProxyUpdaterLaunchPolicy {
+  static func shouldStartUpdater(environment: [String: String]) -> Bool {
+    environment["XCTestConfigurationFilePath"] == nil
+  }
+}
+
+@MainActor
+final class ReluxProxyUpdaterLifecycle {
+  let feedURL: URL
+  private let controller: SPUStandardUpdaterController
+
+  init(infoDictionary: [String: Any], startingUpdater: Bool = true) throws {
+    feedURL = try ReluxProxyUpdaterConfiguration.feedURL(in: infoDictionary)
+    _ = try ReluxProxyUpdaterConfiguration.publicEDKey(in: infoDictionary)
+    controller = SPUStandardUpdaterController(
+      startingUpdater: startingUpdater,
+      updaterDelegate: nil,
+      userDriverDelegate: nil
+    )
+  }
+
+  var isControllerConstructed: Bool { true }
+}
+
+@MainActor
+final class ReluxProxyAppDelegate: NSObject, NSApplicationDelegate {
+  let updaterLifecycle: ReluxProxyUpdaterLifecycle
+
+  init(infoDictionary: [String: Any], startingUpdater: Bool = true) throws {
+    updaterLifecycle = try ReluxProxyUpdaterLifecycle(
+      infoDictionary: infoDictionary,
+      startingUpdater: startingUpdater
+    )
+    super.init()
+  }
+}
