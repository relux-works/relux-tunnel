+    >> "$raw_log" 2>&1 &
+  log_pid=$!
+  sleep 1
+
+  for ((cycle = 1; cycle <= cycles; cycle++)); do
+    "$app_binary" --run-probe >/dev/null 2>&1 &
+    app_pid=$!
