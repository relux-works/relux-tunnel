    guard let input = inputs[kind] else {
      throw MacOSProductionBindingError.incompatibleBinding(kind)
    }
    try validateEvidence(
      input,
      label: kind,
      taskID: taskID,
      outcomeDigest: outcomeDigest,
      reviewDigest: reviewDigest
    )
    return input
  }

