{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4b7","stream":{"kind":"session","id":"01a0aa7a-9815-7302-a96f-7a8fde67c84b"},"sequence":182,"recorded_at":1780531400000359,"record_type":"event","durability":"durable","causation_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","run_stream":{"kind":"run","id":"7cb39f37-e5ea-43fc-a612-eaf97474622d"},"task_stream":{"kind":"task","id":"01a0aa7a-fc56-7421-9aea-a6c94b3332f3"},"task_id":"01a0aa7a-fc56-7421-9aea-a6c94b3332f3","event":{"kind":"output","task_id":"01a0aa7a-fc56-7421-9aea-a6c94b3332f3","chunk":"Read text file `Sources/ReluxTunnelLibSSH2Adapter/LibSSH2Transport.swift`.\n1|import Foundation\n2|import ReluxLibSSH2\n3|import ReluxTunnelCore\n4|\n5|public enum LibSSH2PackagingAnchor {\n6|  public static let schemaVersion: UInt16 = 1\n7|\n8|  public static func linkageSmoke() -> Bool {\n9|    libssh2_session_rekey(nil) == LIBSSH2_ERROR_BAD_USE\n10|  }\n11|}\n12|\n13|struct LibSSH2ChannelAPI: Sendable {\n14|  var processStartup: @Sendable (OpaquePointer, String) -> Int32\n15|  var write: @Sendable (OpaquePointer, Data, Int) -> Int\n16|  var close: @Sendable (OpaquePointer) -> Int32\n17|  var free: @Sendable (OpaquePointer) -> Int32\n18|\n19|  static let live = LibSSH2ChannelAPI(\n20|    processStartup: { pointer, command in\n21|      command.utf8CString.withUnsafeBytes { bytes in\n22|        libssh2_channel_process_startup(\n23|          pointer,\n24|          \"exec\",\n25|          UInt32(\"exec\".utf8.count),\n26|          bytes.bindMemory(to: CChar.self).baseAddress,\n27|          UInt32(max(0, bytes.count - 1))\n28|        )\n29|      }\n30|    },\n31|    write: { pointer, bytes, count in\n32|      bytes.withUnsafeBytes { raw in\n33|        libssh2_channel_write_ex(\n34|          pointer,\n35|          0,\n36|          raw.bindMemory(to: CChar.self).baseAddress,\n37|          count\n38|        )\n39|      }\n40|    },\n41|    close: { libssh2_channel_close($0) },\n42|    free: { libssh2_channel_free($0) }\n43|  )\n44|}\n45|\n46|public struct LibSSH2TransportFactory: SSHTransportFactory {\n47|  public static let m3OwnerTaskID = \"TASK-260728-3cveay\"\n48|\n49|  public let capabilities = SSHAdapterCapabilities(\n50|    features: Set(SSHAdapterFeature.allCases),\n51|    deferredSemantics: SSHDeferredSemanticCapabilities(\n52|      consumerDrivenReceiveWindowCredit: .unsupported,\n53|      rfcChannelOpenFailureReasons: .unsupported,\n54|      exactExecExitMetadata: .unsupported,\n55|      deepRekeyAndKeepaliveObservability: .unsupported\n56|    ),\n57|    keyExchangeAlgorithms: [\n58|      \"curve25519-sha256\", \"curve25519-sha256@libssh.org\",\n59|      \"ecdh-sha2-nistp256\", \"ecdh-sha2-nistp384\", \"ecdh-sha2-nistp521\",\n60|      \"diffie-hellman-group16-sha512\", \"diffie-hellman-group18-sha512\",\n61|      \"diffie-hellman-group14-sha256\",\n62|    ],\n63|    hostKeyAlgorithms: [\n64|      \"ssh-ed25519\", \"ecdsa-sha2-nistp256\", \"ecdsa-sha2-nistp384\",\n65|      \"ecdsa-sha2-nistp521\", \"rsa-sha2-512\", \"rsa-sha2-256\",\n66|    ],\n67|    cipherAlgorithms: [\n68|      \"chacha20-poly1305@openssh.com\", \"aes256-gcm@openssh.com\",\n69|      \"aes128-gcm@openssh.com\", \"aes256-ctr\", \"aes192-ctr\", \"aes128-ctr\",\n70|    ],\n71|    macAlgorithms: [\n72|      \"hmac-sha2-512-etm@openssh.com\", \"hmac-sha2-256-etm@openssh.com\",\n73|      \"hmac-sha2-512\", \"hmac-sha2-256\",\n74|    ],\n75|    publicKeyAuthenticationAlgorithms: [\n76|      \"ssh-ed25519\", \"ecdsa-sha2-nistp256\", \"ecdsa-sha2-nistp384\",\n77|      \"ecdsa-sha2-nistp521\", \"rsa-sha2-512\", \"rsa-sha2-256\",\n78|    ]\n79|  )\n80|\n81|  private let maximumTransportBufferBytes: Int\n82|  private let channelAPI: LibSSH2ChannelAPI\n83|\n84|  public init(maximumTransportBufferBytes: Int = 256 * 1_024) {\n85|    self.init(maximumTransportBufferBytes: maximumTransportBufferBytes, channelAPI: .live)\n86|  }\n87|\n88|  init(\n89|    maximumTransportBufferBytes: Int = 256 * 1_024,\n90|    channelAPI: LibSSH2ChannelAPI\n91|  ) {\n92|    precondition(maximumTransportBufferBytes > 0 && maximumTransportBufferBytes <= 1_048_576)\n93|    self.maximumTransportBufferBytes = maximumTransportBufferBytes\n94|    self.channelAPI = channelAPI\n95|  }\n96|\n97|  public func makeTransport(\n98|    lane: SSHLaneIdentity,\n99|    dependencies: SSHTransportDependencies\n100|  ) async throws -> any SSHTransport {\n101|    try LibSSH2GlobalRuntime.initialize()\n102|    return LibSSH2Transport(\n103|      lane: lane,\n104|      dependencies: dependencies,\n105|      maximumTransportBufferBytes: maximumTransportBufferBytes,\n106|      channelAPI: channelAPI\n107|    )\n108|  }\n109|}\n110|\n111|private struct LibSSH2ChannelRecord {\n112|  let pointer: OpaquePointer\n113|  let kind: SSHChannelKind\n114|  let policy: SSHChannelPolicy\n115|  var writeEOF = false\n116|  var closed = false\n117|}\n118|\n119|private struct LibSSH2ReadOperation: Hashable {\n120|  let channel: SSHChannelIdentity\n121|  let stream: Int32\n122|}\n123|\n124|struct LibSSH2OwnedResourceSnapshot: Equatable, Sendable {\n125|  let channels: Int\n126|  let socketOwned: Bool\n127|  let sessionOwned: Bool\n128|  let automaticTasks: Int\n129|  let customAllocations: Int\n130|  let bufferedBytes: Int\n131|}\n132|\n133|public actor LibSSH2Transport: SSHTransport {\n134|  private static let maximumPendingOperations = 64\n135|\n136|  private let lane: SSHLaneIdentity\n137|  private let dependencies: SSHTransportDependencies\n138|  private let context: LibSSH2SessionContext\n139|  private let channelAPI: LibSSH2ChannelAPI\n140|  private let sessionOperationGate = LibSSH2SessionOperationGate(\n141|    maximumWaiters: maximumPendingOperations\n142|  )\n143|  let asyncOperations = LibSSH2OwnedAsyncOperationRegistry(\n144|    maximumOperations: maximumPendingOperations\n145|  )\n146|  private let teardownAsyncOperations = LibSSH2OwnedAsyncOperationRegistry(\n147|    maximumOperations: 2\n148|  )\n149|  private var state = SSHConnectionState.idle\n150|  private var connection: (any SSHTCPConnection)?\n151|  private var engineSession: OpaquePointer?\n152|  private var sessionContextPointer: UnsafeMutableRawPointer?\n153|  private var configuration: SSHConnectionConfiguration?\n154|  private var negotiatedAlgorithms: SSHNegotiatedAlgorithms?\n155|  private var channels: [SSHChannelIdentity: LibSSH2ChannelRecord] = [:]\n156|  private var counters = SSHTransportCounters(\n157|    windowAdjustments: .unsupported,\n158|    windowAdjustmentBytes: .unsupported,\n159|    serverRekeys: .unsupported,\n160|    keepalivesAcknowledged: .unsupported,\n161|    keepalivesTimedOut: .unsupported\n162|  )\n163|  private var rekeySentBytesBaseline: UInt64 = 0\n164|  private var rekeyReceivedBytesBaseline: UInt64 = 0\n165|  private var byteRekeyScheduled = false\n166|  private var protectedNetworkBaseline: (received: UInt64, sent: UInt64)?\n167|  private var automaticRekeyTask: Task<Void, Never>?\n168|  private var automaticKeepaliveTask: Task<Void, Never>?\n169|  private var byteRekeyTask: Task<Void, Never>?\n170|  private var rekeyFlightTask: Task<Void, Never>?\n171|  private var rekeyFlightInProgress = false\n172|  private var rekeyFlightDeadline: ContinuousClock.Instant?\n173|  private var rekeyReasons: Set<SSHRekeyReason> = []\n174|  private var rekeyWaiters: [UUID: LibSSH2OperationWaiter] = [:]\n175|  private var pendingChannelOpens = 0\n176|  private var channelOpenDrainWaiter: CheckedContinuation<Void, Never>?\n177|  private var pendingReads: Set<LibSSH2ReadOperation> = []\n178|  private var pendingWriteBytes: [SSHChannelIdentity: Int] = [:]\n179|  private var pendingWriteOperations = 0\n180|  private var channelWriteGates: [SSHChannelIdentity: LibSSH2SessionOperationGate] = [:]\n181|  private var pendingChannelOperationCounts: [SSHChannelIdentity: Int] = [