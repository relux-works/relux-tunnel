   113	static void
   114	hev_socks5_tunnel_insert_session (HevListNode *node)
   115	{
   116	    HevSocks5SessionData *sd;
   117	    int max_session_count;
   118	
   119	    hev_list_add_tail (&session_set, node);
   120	    session_count++;
   121	
   122	    max_session_count = hev_config_get_misc_max_session_count ();
   123	    if (!max_session_count || session_count < max_session_count)
   124	        return;
