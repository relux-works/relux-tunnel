+      } catch {
+        first.resolve(.value(.failure(.runtimeStartupFailed)))
+      }
+    }
+    Task {
+      await signal.wait()
+      first.resolve(.retired)
+    }
+    switch await first.wait() {
+    case .value(.success(let snapshot)):
+      return snapshot
+    case .value(.failure), .retired:
+      return nil
+    }
+  }
