+        (continuation: CheckedContinuation<Void, any Error>) in
+        let waiters: [CheckedContinuation<Void, Never>] = lock.withLock {
+          if Task<Never, Never>.isCancelled {
+            continuation.resume(throwing: CancellationError())
+            return []
