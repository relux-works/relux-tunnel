+#!/usr/bin/env python3
+from __future__ import annotations
+
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+
+ROOT = Path(__file__).resolve().parents[3]
+MODULE_PATH = ROOT / "scripts" / "relay_supply_chain.py"
+sys.path.insert(0, str(ROOT))
+SPEC = importlib.util.spec_from_file_location("relay_supply_chain_contract_review", MODULE_PATH)
+assert SPEC is not None and SPEC.loader is not None
+SC = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(SC)
+CONFIG = SC.load_json(SC.SOURCE_PATH)
+
+
+def component(config: dict, identifier: str) -> dict:
+    return next(item for item in config["components"] if item["id"] == identifier)
+
+
+def must_reject(name: str, mutate, expected: str) -> bool:
+    config = copy.deepcopy(CONFIG)
+    mutate(config)
+    try:
+        SC.validate_config(config)
+    except SC.SupplyChainError as error:
+        accepted = expected in str(error)
+        print(f"{name}: rejected={accepted} reason={error}")
+        return accepted
+    print(f"{name}: rejected=False reason=ACCEPTED")
+    return False
+
+
+def sha256(value: bytes) -> str:
+    return hashlib.sha256(value).hexdigest()
+
+
+def main() -> int:
+    checks = [
+        must_reject(
+            "relay-source-hash",
+            lambda c: component(c, "relux-relay-source").update(contentSHA256="0" * 64),
+            "authoritative provenance mismatch",
+        ),
+        must_reject(
+            "recipe-hash",
+            lambda c: component(c, "relay-build-recipe").update(contentSHA256="0" * 64),
+            "authoritative provenance mismatch",
+        ),
+        must_reject(
+            "compiler-hash",
+            lambda c: component(c, "go-compiler-linker").update(contentSHA256="0" * 64),
+            "authoritative provenance mismatch",
+        ),
+        must_reject(
+            "stdlib-hash",
+            lambda c: component(c, "go-standard-library").update(contentSHA256="0" * 64),
+            "authoritative provenance mismatch",
+        ),
+        must_reject(
+            "license-mapping",
+            lambda c: component(c, "relux-relay-source").update(license="GPL-3.0-only"),
+            "lacks notice coverage",
+        ),
+        must_reject(
+            "notice-coverage",
+            lambda c: component(c, "go-standard-library").update(
+                noticeObligation="none-build-only-tool"
+            ),
+            "approved license mapping mismatch",
+        ),
+        must_reject(
+            "mutable-branch-url",
+            lambda c: c["build"].update(
+                recipeSource="https://github.com/relux-works/relux-tunnel/tree/main"
+            ),
+            "outside its immutable pinned allowlist",
+        ),
+        must_reject(
+            "query-url",
+            lambda c: c["source"].update(repository=c["source"]["repository"] + "?x=1"),
+            "outside its immutable pinned allowlist",
+        ),
+        must_reject(
+            "fragment-url",
+            lambda c: c["source"].update(repository=c["source"]["repository"] + "#x"),
+            "outside its immutable pinned allowlist",
+        ),
+        must_reject(
+            "empty-runtime-roots",
+            lambda c: c["runtimePolicy"].update(scanRoots=[]),
+            "runtime audit scope",
+        ),
+        must_reject(
+            "reordered-runtime-roots",
+            lambda c: c["runtimePolicy"].update(scanRoots=["Sources", "App", "relay"]),
+            "runtime audit scope",
+        ),
+        must_reject(
+            "weakened-exclusions",
+            lambda c: c["runtimePolicy"].update(excludedPaths=[]),
+            "runtime audit scope",
+        ),
+        must_reject(
+            "m5-boundary-drift",
+            lambda c: c["boundary"].pop(),
+            "M2/M5 supply-chain boundary",
+        ),
+    ]
+
+    first = SC.generated_outputs(CONFIG)
+    second = SC.generated_outputs(CONFIG)
+    for relative, contents in first.items():
+        same = contents == second[relative] == (ROOT / relative).read_bytes()
+        print(f"deterministic:{relative}: same={same} sha256={sha256(contents)}")
+        checks.append(same)
+
+    first_asset = SC.stable_json(SC.expected_asset_source(CONFIG, first))
+    second_asset = SC.stable_json(SC.expected_asset_source(CONFIG, second))
+    asset_same = first_asset == second_asset == SC.ASSET_SOURCE_PATH.read_bytes()
+    print(f"deterministic:{SC.ASSET_SOURCE_PATH.relative_to(ROOT)}: same={asset_same} sha256={sha256(first_asset)}")
+    checks.append(asset_same)
+
+    tool, first_manifest = SC.expected_asset_manifest()
+    _, second_manifest = SC.expected_asset_manifest()
+    first_swift = tool.render_swift(first_manifest)
+    second_swift = tool.render_swift(second_manifest)
+    swift_same = first_swift == second_swift == tool.DEFAULT_SWIFT.read_bytes()
+    print(f"deterministic:{tool.DEFAULT_SWIFT.relative_to(ROOT)}: same={swift_same} sha256={sha256(first_swift)}")
+    checks.append(swift_same)
+
+    linkage = SC.linkage_id(CONFIG)
+    inventory_link = json.loads(first[CONFIG["outputs"]["inventory"]])[
+        "manifestLinkageSHA256"
+    ]
+    provenance = json.loads(first[CONFIG["outputs"]["provenance"]])
+    provenance_link = provenance["predicate"]["runDetails"]["byproducts"][1][
+        "digest"
+    ]["sha256"]
+    asset_link = json.loads(first_asset)["supplyChain"]["manifestLinkageSHA256"]
+    links_same = linkage == inventory_link == provenance_link == asset_link
+    print(f"manifest-linkage: same={links_same} sha256={linkage}")
+    checks.append(links_same)
+
+    try:
+        SC.reject_sensitive_generated({"probe": b"token=secret\n/Users/reviewer/tmp\n"})
+    except SC.SupplyChainError as error:
+        print(f"privacy-negative: rejected=True reason={error}")
+        checks.append(True)
+    else:
+        print("privacy-negative: rejected=False reason=ACCEPTED")
+        checks.append(False)
+
+    return 0 if all(checks) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

