    exit 1
fi
if [ "$(id -u)" -eq 0 ]; then
    echo "portable native Linux smoke must run as an unprivileged user" >&2
    exit 1
fi

case "$(uname -m)" in
    x86_64|amd64)
        architecture=amd64
        ;;
    aarch64|arm64)
        architecture=arm64
        ;;
    *)
        echo "portable native Linux smoke host architecture is unsupported" >&2
        exit 1
        ;;
esac

