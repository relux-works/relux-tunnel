+extension RuntimeDiagnosticsRecorder: TCPAdmissionDiagnosticsSink {
+  public func recordTCPAdapterCounter(
+    _ counter: RuntimeTCPAdapterCounter,
+    by amount: UInt64
+  ) {
+    store.incrementCounter(
