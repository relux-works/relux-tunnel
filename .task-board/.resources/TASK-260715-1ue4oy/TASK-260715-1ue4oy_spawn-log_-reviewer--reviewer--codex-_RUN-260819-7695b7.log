   130	def pbx_object(text: str, object_id: str) -> str:
   131	    """Return one generated PBX object body, including its outer braces."""
   132	    declaration = re.search(
   133	        rf"(?m)^\s*{re.escape(object_id)}(?:\s+/\*.*?\*/)?\s*=\s*\{{", text
   134	    )
   135	    if declaration is None:
   136	        raise ContractError(
   137	            f"generated project references missing PBX object {object_id}"
   138	        )
   139
   140	    opening = text.find("{", declaration.start())
   141	    depth = 0
   142	    in_string = False
   143	    escaped = False
   144	    for index in range(opening, len(text)):
   145	        character = text[index]
   146	        if in_string:
   147	            if escaped:
   148	                escaped = False
   149	            elif character == "\\":
   150	                escaped = True
   151	            elif character == '"':
   152	                in_string = False
   153	            continue
   154	        if character == '"':
   155	            in_string = True
   156	        elif character == "{":
   157	            depth += 1
   158	        elif character == "}":
   159	            depth -= 1
   160	            if depth == 0:
   161	                return text[opening : index + 1]
   162	    raise ContractError(f"unterminated generated PBX object {object_id}")
