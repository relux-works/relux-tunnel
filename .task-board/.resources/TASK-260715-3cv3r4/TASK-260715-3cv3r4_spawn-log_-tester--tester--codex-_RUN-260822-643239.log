+    OwnedVPNManagerRepository.managerContractKey: .unsignedInteger(
+      UInt64(OwnedVPNManagerRepository.managerContractVersion)
+    ),
+    OwnedVPNManagerRepository.configurationReferenceKey: .data(payload),
+  ]
+}
