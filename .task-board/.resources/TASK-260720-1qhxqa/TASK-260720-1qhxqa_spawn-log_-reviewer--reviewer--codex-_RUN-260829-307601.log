   178	            depth += 1
   179	        elif text[index] == ")":
   180	            depth -= 1
   181	            if depth == 0:
   182	                return text[opening : index + 1]
   183	    raise BindingError("REPOSITORY-GRAPH", f"unterminated target block {name}")
