+private final class TestAtomicCounter: Sendable {
+  private let value = Atomic<Int>(0)
+
+  func increment() {
+    _ = value.wrappingAdd(1, ordering: .relaxed)
+  }
+
+  func load() -> Int {
+    value.load(ordering: .relaxed)
+  }
+}
