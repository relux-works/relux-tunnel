  1101	  private func lookupDiagnostics(
  1102	    requestID: OpaqueRuntimeRequestIdentifier,
  1103	    generation: UInt64
  1104	  ) async -> RuntimeDiagnosticsSnapshot? {
  1105	    guard activeGeneration?.identifier == generation else { return nil }
  1106	    guard let signal = activeGeneration?.retirementSignal else { return nil }
  1107	    let first = ProviderFirstResult<DiagnosticsLookupResult>()
  1108	    Task { [diagnosticsSource] in
  1109	      do {
  1110	        first.resolve(
  1111	          .value(
  1112	            .success(
  1113	              try await diagnosticsSource.providerDiagnosticsSnapshot(requestID: requestID)
  1114	            ))
  1115	        )
  1116	      } catch {
  1117	        first.resolve(.value(.failure(.runtimeStartupFailed)))
  1118	      }
  1119	    }
  1120	    let retirement = Task {
  1121	      do {
  1122	        try await signal.wait()
  1123	        first.resolve(.retired)
  1124	      } catch {
  1125	        // The source won and removed this retirement subscription.
  1126	      }
  1127	    }
  1128	    let result = await first.wait()
  1129	    if case .value = result { retirement.cancel() }
  1130	    switch result {
  1131	    case .value(.success(let snapshot)):
