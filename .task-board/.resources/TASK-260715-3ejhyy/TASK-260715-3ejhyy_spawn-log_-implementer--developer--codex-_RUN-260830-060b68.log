   344	    _ input: [String: Any],
   345	    _ capability: String
   346	  ) throws {
   347	    let capabilities = try array(input["requiredCapabilities"])
   348	    guard capabilities.contains(where: { string($0) == capability }) else {
   349	      throw MacOSProductionBindingError.mandatoryCapabilityMissing(capability)
   350	    }
   351	  }
   352	
   353	  private static func requirePin(
   354	    _ pins: [String: Any],
   355	    _ name: String,
   356	    _ value: String
   357	  ) throws {
   358	    guard string(pins[name]) == value else {
   359	      throw MacOSProductionBindingError.pinMismatch(name)
   360	    }
   361	  }
   362	
   363	  private static func sha256(_ data: Data) -> String {
   364	    SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
   365	  }
   366	
   367	  private static func object(_ value: Any?) throws -> [String: Any] {
   368	    guard let value = value as? [String: Any] else {
   369	      throw MacOSProductionBindingError.malformedManifest
   370	    }
   371	    return value
   372	  }
   373	
   374	  private static func array(_ value: Any?) throws -> [Any] {
   375	    guard let value = value as? [Any] else {
   376	      throw MacOSProductionBindingError.malformedManifest
   377	    }
   378	    return value
   379	  }
   380	
   381	  private static func string(_ value: Any?) -> String? { value as? String }
   382	  private static func bool(_ value: Any?) -> Bool? { value as? Bool }
   383	  private static func int(_ value: Any?) -> Int? { (value as? NSNumber)?.intValue }
   384	}
