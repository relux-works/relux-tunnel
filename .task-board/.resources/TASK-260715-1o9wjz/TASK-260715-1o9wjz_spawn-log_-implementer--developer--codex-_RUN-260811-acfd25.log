+      NullMacOSCredentialSecretLifecycleObserver()
+  ) -> any SSHCredentialProvider {
+    MacOSSystemKeychainCredentialResolver(
+      securityClient: securityClient,
+      formatRegistry: formatRegistry,
+      lifecycleObserver: lifecycleObserver
+    )
+  }
 }
 
