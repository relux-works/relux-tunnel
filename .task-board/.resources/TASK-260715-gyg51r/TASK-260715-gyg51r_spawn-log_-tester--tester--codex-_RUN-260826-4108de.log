+    "output_path": {
+      "value": ".temp/TASK-260715-gyg51r/TASK-260715-gyg51r_raw-matrix.json",
+      "privacy": "sensitive"
+    },
+    "packets_per_row": {
+      "value": "512",
+      "privacy": "public"
+    }
+  }
+}
