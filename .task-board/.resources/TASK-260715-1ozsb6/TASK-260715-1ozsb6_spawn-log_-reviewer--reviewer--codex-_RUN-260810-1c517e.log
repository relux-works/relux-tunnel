  2145	        // destructor advances libssh2's retained nonblocking sub-operation;
  2146	        // yielding between a fixed number of attempts avoids a cleanup spin.
  2147	        await Task.yield()
  2148	        freeResult = libssh2_session_free(engineSession)
  2149	      }
  2150	      if freeResult == 0 {
  2151	        self.engineSession = nil
  2152	        sessionContextPointer = nil
  2153	      } else {
  2154	        sessionFreed = false
  2155	      }
  2156	    }
  2157	    guard sessionFreed else {
  2158	      connection = nil
  2159	      negotiatedAlgorithms = nil
  2160	      if state != .failed { try? await transition(to: .failed) }
  2161	      return
  2162	    }
  2163	    channels.removeAll(keepingCapacity: false)
  2164	    channelWriteGates.removeAll(keepingCapacity: false)
  2165	    disposingChannels.removeAll(keepingCapacity: false)
  2166	    channelDisposalTasks.removeAll(keepingCapacity: false)
  2167	    pendingWriteBytes.removeAll(keepingCapacity: false)
  2168	    pendingChannelOperationCounts.removeAll(keepingCapacity: false)
  2169	    channelDrainWaiters.removeAll(keepingCapacity: false)
  2170	    context.network.discard()
  2171	    connection = nil
  2172	    negotiatedAlgorithms = nil
  2173	    if state != .closed {
  2174	      if state != .closing { try? await transition(to: .closing) }
  2175	      try? await transition(to: .closed)
  2176	    }
  2177	  }
