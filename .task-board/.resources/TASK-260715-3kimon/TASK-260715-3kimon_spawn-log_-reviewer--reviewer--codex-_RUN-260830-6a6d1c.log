        let channel = fixtureChannel(1_000 + iteration)
        if (try? ledger.reserveInitial(
          channel: channel,
          lane: lane.identity,
          channelClass: SSHReceiveWindowClass.allCases[Int(random.next() % 4)],
          generation: 7,
          bulkMeasurement: SSHBulkPathMeasurement(
            bandwidthBitsPerSecond: random.next(),
