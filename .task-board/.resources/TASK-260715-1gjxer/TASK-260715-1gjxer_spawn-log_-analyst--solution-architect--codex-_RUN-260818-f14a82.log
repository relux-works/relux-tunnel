+    process.arguments = [
+      "-N", "-T", "-o", "BatchMode=yes", "-o", "ExitOnForwardFailure=yes",
+      "-o", "ControlMaster=no", "-L",
+      "127.0.0.1:\(localPort):127.0.0.1:\(remoteSSHPort)", "relux",
+    ]
