+    await fixture.bridge.stop()
+    try await handle.waitForTermination()
+
+    #expect(fixture.socketIO.closedDescriptors == [101, 100])
+    #expect(
+      fixture.events.snapshot().suffix(6) == [
+        "flow.shutdown",
+        "readiness.cancel",
+        "borrow.stop",
+        "borrow.return",
+        "close.101",
+        "close.100",
