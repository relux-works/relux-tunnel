+)
+
+recipe_records = records(
+    [item["path"] for item in supply["build"]["recipeFiles"]],
+    recipe_commit,
+)
+recipe_url = (
+    "https://github.com/relux-works/relux-tunnel/tree/" f"{recipe_commit}"
+)
+supply["build"].update({
