+    for value in strings:
+        if SHELL_OR_DOWNLOAD_PATTERN.search(value) is not None:
+            return "shell or download command"
+        if HTTP_LOCATOR_PATTERN.search(value) is not None:
+            return "HTTP source locator"
+    return None
+
