   271	    private func processInboundMessageResult(
   272	        _ result: SSHConnectionStateMachine.StateMachineInboundProcessResult,
   273	        context: ChannelHandlerContext
   274	    ) throws {
   275	        switch result {
   276	        case .emitMessage(let message):
   277	            try self.writeMessage(message, context: context)
