package query

import (
	"strings"
	"time"

	"github.com/relux-works/skill-agent-facing-api/agentquery"
	"github.com/relux-works/skill-project-management/pkg/board"
)

// ChecklistItemResponse is the JSON representation of a checklist item.
// It matches the existing fields.ChecklistItemResponse for output compatibility.
type ChecklistItemResponse struct {
	Text string `json:"text"`
	Done bool   `json:"done"`
}

// ResourceRefResponse is the JSON representation of a resource reference.
type ResourceRefResponse struct {
	Name        string `json:"name"`
	URI         string `json:"uri"`
	Description string `json:"description,omitempty"`
}

// registerFields registers all field accessors on the schema.
// Each accessor extracts a single field from a BoardItem, matching the output
// of the existing fields.Apply() implementation.
func registerFields(s *agentquery.Schema[BoardItem]) {
	s.Field("id", func(item BoardItem) any {
		return item.Element.ID()
	})

	s.Field("type", func(item BoardItem) any {
		return string(item.Element.Type)
	})

	s.Field("name", func(item BoardItem) any {
		return item.Element.Name
	})

	s.Field("title", func(item BoardItem) any {
		return item.Element.Title
	})

	s.Field("status", func(item BoardItem) any {
		return string(item.Element.Status)
	})

	s.Field("review", func(item BoardItem) any {
		return string(board.NormalizeReviewPolicy(item.Element.Review))
	})

	s.Field("task_class", func(item BoardItem) any {
		return string(board.NormalizeTaskClass(item.Element.TaskClass))
	})

	s.Field("estimate", func(item BoardItem) any {
		return elementEstimateResponse(item.Element, item.Board)
	})

	s.Field("observability", func(item BoardItem) any {
		return buildObservability(item.Board, item.Element)
	})

	s.Field("parent", func(item BoardItem) any {
		return item.Element.ParentID
	})

	s.Field("assignee", func(item BoardItem) any {
		return item.Element.AssignedTo
	})

	s.Field("description", func(item BoardItem) any {
		return item.Element.Description
	})

	s.Field("scope", func(item BoardItem) any {
		return item.Element.Scope
	})

	s.Field("ac", func(item BoardItem) any {
		return item.Element.AC
	})

	s.Field("blockedBy", func(item BoardItem) any {
		if item.Element.BlockedBy == nil {
			return []string{}
		}
		return item.Element.BlockedBy
	})

	s.Field("blocks", func(item BoardItem) any {
		if item.Element.Blocks == nil {
			return []string{}
		}
		return item.Element.Blocks
	})

	s.Field("derivedBlockedBy", func(item BoardItem) any {
		projection := board.BuildDependencyProjection(item.Board)
		return nonNilIDs(projection.DerivedBlockedBy[item.Element.ID()])
	})

	s.Field("derivedBlocks", func(item BoardItem) any {
		projection := board.BuildDependencyProjection(item.Board)
		return nonNilIDs(projection.DerivedBlocks[item.Element.ID()])
	})

	s.Field("checklist", func(item BoardItem) any {
		items := make([]ChecklistItemResponse, len(item.Element.Checklist))
		for i, ci := range item.Element.Checklist {
			items[i] = ChecklistItemResponse{Text: ci.Text, Done: ci.Checked}
		}
		return items
	})

	s.Field("notes", func(item BoardItem) any {
		return item.Element.Notes
	})

	s.Field("created", func(item BoardItem) any {
		if !item.Element.CreatedAt.IsZero() {
			return item.Element.CreatedAt.UTC().Format(time.RFC3339)
		}
		return ""
	})

	s.Field("updated", func(item BoardItem) any {
		if !item.Element.LastUpdate.IsZero() {
			return item.Element.LastUpdate.UTC().Format(time.RFC3339)
		}
		return ""
	})

	s.Field("isBlocked", func(item BoardItem) any {
		return item.Board.IsBlocked(item.Element)
	})

	s.Field("isAdvisoryBlocked", func(item BoardItem) any {
		projection := board.BuildDependencyProjection(item.Board)
		return projection.IsAdvisoryBlocked(item.Board, item.Element)
	})

	s.Field("children", func(item BoardItem) any {
		children := item.Board.Children(item.Element)
		ids := make([]string, len(children))
		for i, c := range children {
			ids[i] = c.ID()
		}
		return ids
	})

	s.Field("preconditionResources", func(item BoardItem) any {
		return resourceRefResponses(item.Element.PreconditionResources)
	})

	s.Field("outcomeResources", func(item BoardItem) any {
		return resourceRefResponses(item.Element.OutcomeResources)
	})
}

func resourceRefResponses(resources []board.ResourceRef) []ResourceRefResponse {
	refs := make([]ResourceRefResponse, len(resources))
	for i, r := range resources {
		refs[i] = ResourceRefResponse{Name: r.Name, URI: r.URI, Description: r.Description}
	}
	return refs
}

// registerPresets registers the base field presets and the project
// observability family, then sets default fields.
func registerPresets(s *agentquery.Schema[BoardItem]) {
	s.Preset("minimal", "id", "status")
	s.Preset("default", "id", "name", "status")
	s.Preset("overview", "id", "name", "status", "assignee", "parent")
	s.Preset("full",
		"id", "type", "name", "title", "status", "review", "task_class", "estimate", "observability", "parent", "assignee",
		"description", "scope", "ac", "blockedBy", "blocks", "derivedBlockedBy", "derivedBlocks",
		"checklist", "notes", "created", "updated", "isBlocked", "isAdvisoryBlocked", "children",
		"preconditionResources", "outcomeResources",
	)
	s.Preset("progress", "id", "status", "review", "task_class", "estimate", "checklist", "notes", "blockedBy", "derivedBlockedBy", "isBlocked", "isAdvisoryBlocked")
	s.Preset("planning", "id", "name", "status", "blockedBy", "blocks", "derivedBlockedBy", "derivedBlocks", "parent")
	s.Preset("observability-project", "observability")
	s.Preset("observability-epic", "id", "name", "status", "observability")
	s.Preset("observability-story", "id", "name", "status", "observability")
	s.Preset("observability-task", "id", "name", "status", "observability")

	// Default fields match the "default" preset: id, name, status
	s.DefaultFields("id", "name", "status")
}

func elementEstimateResponse(element *board.Element, b *board.Board) any {
	if element == nil {
		return nil
	}
	switch element.Type {
	case board.TaskType, board.BugType:
		return estimateResponse(element.Estimate)
	case board.StoryType, board.EpicType:
		return estimateProjectionResponse(board.BuildEstimateProjection(b, element))
	default:
		return nil
	}
}

func estimateResponse(estimate *board.Estimate) map[string]any {
	normalized := board.NormalizeEstimate(estimate)
	response := map[string]any{"kind": string(normalized.Kind)}
	if normalized.Scale != nil {
		response["scale"] = map[string]any{
			"kind":   string(normalized.Scale.Kind),
			"number": normalized.Scale.Number,
		}
	}
	return response
}

func estimateProjectionResponse(projection *board.EstimateProjection) any {
	if projection == nil {
		return nil
	}
	return estimateProjectionResponseValue(projection)
}

func estimateProjectionResponseValue(projection *board.EstimateProjection) map[string]any {
	response := map[string]any{"kind": string(projection.Kind)}
	if projection.Scale != nil {
		response["scale"] = map[string]any{
			"kind":   string(projection.Scale.Kind),
			"number": projection.Scale.Number,
		}
	}
	if projection.RolledEstimate != nil {
		response["rolledEstimate"] = estimateProjectionResponseValue(projection.RolledEstimate)
