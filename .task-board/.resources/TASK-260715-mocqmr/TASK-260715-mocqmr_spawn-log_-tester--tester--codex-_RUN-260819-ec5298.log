+        ctypes.byref(ruleset_attr),
+        ctypes.sizeof(ruleset_attr),
+        ctypes.c_uint(0),
+    )
+    if ruleset_fd < 0:
+        raise OSError(ctypes.get_errno(), "landlock ruleset failed")
