   765	public struct SSHProfileSnapshotExpectation: Equatable, Sendable {
   766	  public let profileID: OpaqueProfileIdentifier
   767	  public let configurationGeneration: UInt64
   768	
   769	  public init(profileID: OpaqueProfileIdentifier, configurationGeneration: UInt64) {
   770	    self.profileID = profileID
   771	    self.configurationGeneration = configurationGeneration
   772	  }
