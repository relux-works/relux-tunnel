diff --git a/Tests/ReluxTunnelLibSSH2AdapterTests/LibSSH2BridgeTests.swift b/Tests/ReluxTunnelLibSSH2AdapterTests/LibSSH2BridgeTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..a9038ccb46033273305478599280398ea7002039
--- /dev/null
