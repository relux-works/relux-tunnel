   759	def dispatch(provider: BuiltinProvider, request: Mapping[str, object]) -> dict:
   760	    response = provider.handle(request)
   761	    if request.get("action") == "prepare":
   762	        _tag_process_kinds(provider.state_root, str(request["serverId"]))
   763	    return response
