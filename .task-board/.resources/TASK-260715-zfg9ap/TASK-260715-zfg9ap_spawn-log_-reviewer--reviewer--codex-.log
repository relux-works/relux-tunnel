   899	  private func enqueue(
   900	    _ update: Update,
   901	    droppedUpdates: RuntimeDiagnosticsDroppedUpdateCounter
   902	  ) {
   903	    guard pendingUpdateSlots.wait(timeout: .now()) == .success else {
   904	      droppedUpdates.increment()
   905	      return
   906	    }
   907	    stateQueue.async { [self] in
   908	      defer { pendingUpdateSlots.signal() }
   909	      guard update.generation == state.runtimeGeneration else { return }
   910	      apply(update)
   911	    }
   912	  }
   913	
   914	  private func apply(_ update: Update) {
   915	    switch update {
   916	    case .incrementCounter(let name, let amount, _):
   917	      incrementKnownCounter(name, by: amount)
   918	    case .setGauge(let name, let value, _):
   919	      applyGauge(name, value: value)
   920	    case .stateTransition(let lifecycleState, let uptime, _):
   921	      incrementKnownCounter(RuntimeDiagnosticsMetricMap.transitionCounter(lifecycleState), by: 1)
   922	      let timeGauge = RuntimeDiagnosticsMetricMap.transitionTimeGauge(lifecycleState)
   923	      state.gauges[timeGauge] = max(state.gauges[timeGauge] ?? 0, clampedInt64(uptime))
   924	    case .tcpFlowOpened:
   925	      incrementKnownCounter("tcp_flows_opened_total", by: 1)
   926	      let current = state.gauges["tcp_active_flows"] ?? 0
   927	      let active = current == Int64.max ? Int64.max : current + 1
   928	      state.gauges["tcp_active_flows"] = active
   929	      state.gauges["tcp_peak_flows"] = max(state.gauges["tcp_peak_flows"] ?? 0, active)
   930	    case .tcpFlowClosed:
   931	      let active = state.gauges["tcp_active_flows"] ?? 0
   932	      guard active > 0 else {
   933	        incrementKnownCounter("diagnostics_rejected_metric_update_total", by: 1)
   934	        return
   935	      }
   936	      state.gauges["tcp_active_flows"] = active - 1
   937	      incrementKnownCounter("tcp_flows_closed_total", by: 1)
   938	    case .dnsResult(let result, let latency, _):
   939	      incrementKnownCounter(RuntimeDiagnosticsMetricMap.dnsResultCounter(result), by: 1)
   940	      for index in state.dnsLatencyCounts.indices
   941	      where latency <= RuntimeDiagnosticsSchema.dnsLatencyBucketUpperBoundsMilliseconds[index] {
   942	        state.dnsLatencyCounts[index] = state.dnsLatencyCounts[index].saturatingAdding(1)
   943	      }
   944	    case .tcpChannelOpenLatency(let latency, _):
   945	      for index in state.tcpChannelOpenLatencyCounts.indices
   946	      where latency
   947	        <= RuntimeDiagnosticsSchema.tcpChannelOpenLatencyBucketUpperBoundsMilliseconds[index]
   948	      {
   949	        state.tcpChannelOpenLatencyCounts[index] =
   950	          state.tcpChannelOpenLatencyCounts[index].saturatingAdding(1)
   951	      }
   952	    case .route(let mode, let installed, _):
   953	      state.gauges["route_mode_compatible"] = mode == .compatible ? 1 : 0
   954	      state.gauges["route_mode_unknown"] = mode == .unknown ? 1 : 0
   955	      state.gauges["route_installed"] = installed ? 1 : 0
   956	    case .memory(let physicalFootprintBytes, let availableMemoryBytes, _):
   957	      let footprint = clampedInt64(physicalFootprintBytes)
   958	      let available = clampedInt64(availableMemoryBytes)
   959	      incrementKnownCounter("memory_sample_total", by: 1)
   960	      state.gauges["memory_physical_footprint_bytes"] = footprint
   961	      state.gauges["memory_physical_footprint_peak_bytes"] = max(
   962	        state.gauges["memory_physical_footprint_peak_bytes"] ?? 0,
   963	        footprint
   964	      )
   965	      state.gauges["memory_available_bytes"] = available
   966	      state.gauges["memory_available_min_bytes"] =
   967	        state.hasAvailableMemorySample
   968	        ? min(state.gauges["memory_available_min_bytes"] ?? available, available)
   969	        : available
   970	      state.hasAvailableMemorySample = true
   971	    case .error(let code, _):
   972	      state.errors[code.domain] = code
   973	    case .clearError(let domain, _):
   974	      state.errors.removeValue(forKey: domain)
   975	    case .rejected:
   976	      incrementKnownCounter("diagnostics_rejected_metric_update_total", by: 1)
   977	    }
   978	  }
   979	
   980	  private func applyGauge(_ name: String, value: Int64) {
   981	    switch name {
   982	    case "packet_bridge_forward_datagram_max_bytes",
   983	      "packet_bridge_reverse_datagram_max_bytes",
   984	      "memory_physical_footprint_peak_bytes",
   985	      "tcp_peak_flows",
   986	      RuntimeTCPAdapterGauge.peakPendingHandshakes.rawValue,
   987	      RuntimeTCPAdapterGauge.peakReservedFlows.rawValue,
   988	      RuntimeTCPAdapterGauge.peakOpeningFlows.rawValue,
   989	      RuntimeTCPAdapterGauge.peakOpenChannels.rawValue,
   990	      RuntimeTCPAdapterGauge.peakReservedQueuedBytes.rawValue,
   991	      RuntimeTCPAdapterGauge.peakAdapterBufferedBytes.rawValue,
   992	      "hev_transmitted_packets",
   993	      "hev_transmitted_bytes",
   994	      "hev_received_packets",
   995	      "hev_received_bytes":
   996	      state.gauges[name] = max(state.gauges[name] ?? 0, value)
   997	    case "memory_available_min_bytes":
   998	      if state.hasAvailableMemorySample {
   999	        state.gauges[name] = min(state.gauges[name] ?? value, value)
  1000	      } else {
  1001	        state.gauges[name] = value
  1002	        state.hasAvailableMemorySample = true
  1003	      }
  1004	    default:
  1005	      state.gauges[name] = value
  1006	    }
  1007	  }
  1008	
  1009	  private func mergeDroppedUpdates() {
  1010	    let dropped = state.droppedUpdates.value.exchange(0, ordering: .relaxed)
  1011	    incrementKnownCounter("diagnostics_ingestion_drop_total", by: dropped)
  1012	  }
  1013	
  1014	  private func reconcileTCPAdmissionGauges() {
  1015	    guard let snapshot = state.tcpAdmissionGauges.load() else { return }
  1016	    state.gauges[RuntimeTCPAdapterGauge.sessionHealthCode.rawValue] =
  1017	      snapshot.sessionHealthCode
  1018	    state.gauges[RuntimeTCPAdapterGauge.pendingHandshakes.rawValue] =
  1019	      snapshot.pendingHandshakes
  1020	    state.gauges[RuntimeTCPAdapterGauge.reservedFlows.rawValue] = snapshot.reservedFlows
  1021	    state.gauges[RuntimeTCPAdapterGauge.parsingFlows.rawValue] = snapshot.parsingFlows
  1022	    state.gauges[RuntimeTCPAdapterGauge.openingFlows.rawValue] = snapshot.openingFlows
  1023	    state.gauges[RuntimeTCPAdapterGauge.streamingFlows.rawValue] = snapshot.streamingFlows
  1024	    state.gauges[RuntimeTCPAdapterGauge.halfClosedFlows.rawValue] = snapshot.halfClosedFlows
  1025	    state.gauges[RuntimeTCPAdapterGauge.openChannels.rawValue] = snapshot.openChannels
  1026	    state.gauges[RuntimeTCPAdapterGauge.reservedQueuedBytes.rawValue] =
  1027	      snapshot.reservedQueuedBytes
  1028	    state.gauges[RuntimeTCPAdapterGauge.adapterBufferedBytes.rawValue] =
  1029	      snapshot.adapterBufferedBytes
  1030	    state.gauges[RuntimeTCPAdapterGauge.localToSSHBufferedBytes.rawValue] =
  1031	      snapshot.localToSSHBufferedBytes
  1032	    state.gauges[RuntimeTCPAdapterGauge.sshToLocalBufferedBytes.rawValue] =
  1033	      snapshot.sshToLocalBufferedBytes
  1034	    state.gauges[RuntimeTCPAdapterGauge.peakPendingHandshakes.rawValue] =
  1035	      snapshot.peakPendingHandshakes
  1036	    state.gauges[RuntimeTCPAdapterGauge.peakReservedFlows.rawValue] =
  1037	      snapshot.peakReservedFlows
  1038	    state.gauges[RuntimeTCPAdapterGauge.peakOpeningFlows.rawValue] =
  1039	      snapshot.peakOpeningFlows
  1040	    state.gauges[RuntimeTCPAdapterGauge.peakOpenChannels.rawValue] =
  1041	      snapshot.peakOpenChannels
  1042	    state.gauges[RuntimeTCPAdapterGauge.peakReservedQueuedBytes.rawValue] =
  1043	      snapshot.peakReservedQueuedBytes
  1044	    state.gauges[RuntimeTCPAdapterGauge.peakAdapterBufferedBytes.rawValue] =
  1045	      snapshot.peakAdapterBufferedBytes
  1046	    state.gauges["tcp_active_flows"] = snapshot.reservedFlows
  1047	    state.gauges["tcp_peak_flows"] = snapshot.peakReservedFlows
  1048	  }
  1049	
  1050	  private func incrementKnownCounter(_ name: String, by amount: UInt64) {
  1051	    state.counters[name] = (state.counters[name] ?? 0).saturatingAdding(amount)
  1052	  }
  1053	
  1054	  private func clampedInt64(_ value: UInt64) -> Int64 {
  1055	    value > UInt64(Int64.max) ? Int64.max : Int64(value)
  1056	  }
