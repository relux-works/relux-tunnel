+func eventually(
+  attempts: Int = 10_000,
+  _ condition: @escaping @Sendable () async -> Bool
+) async -> Bool {
+  for _ in 0..<attempts {
+    if await condition() {
+      return true
+    }
+    await Task.yield()
+  }
+  return false
+}
