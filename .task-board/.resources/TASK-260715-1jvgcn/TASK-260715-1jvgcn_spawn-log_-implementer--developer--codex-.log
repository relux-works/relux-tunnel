+	})
+	if len(reused.Outbound) != 1 || len(relay.Receive(106, reused.Outbound[0]).Events) != 1 {
+		t.Fatalf("retired credit reuse = %#v", reused)
+	}
+
+	floodCount := uint64(lastFloodID - firstFloodID + 1)
