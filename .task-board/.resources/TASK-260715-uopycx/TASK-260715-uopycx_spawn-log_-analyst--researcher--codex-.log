    41	static int
    42	task_io_yielder (HevTaskYieldType type, void *data)
    43	{
    44	    HevSocks5 *self = data;
    45	    HevListNode *node;
    46	    int res;
    47	
    48	    if (self->type == HEV_SOCKS5_TYPE_UDP_IN_UDP) {
    49	        ssize_t res;
    50	        char buf;
    51	
    52	        res = recv (self->fd, &buf, sizeof (buf), 0);
    53	        if ((res == 0) || ((res < 0) && (errno != EAGAIN))) {
    54	            hev_socks5_set_timeout (self, 0);
    55	            return -1;
    56	        }
    57	    }
    58	
    59	    res = hev_socks5_task_io_yielder (type, data);
    60	    node = hev_socks5_session_get_node (HEV_SOCKS5_SESSION (self));
    61	    hev_socks5_tunnel_update_session (node);
    62	
    63	    return res;
    64	}
    65	
    66	static int
    67	hev_socks5_session_udp_fwd_f (HevSocks5SessionUDP *self, unsigned int num)
    68	{
    69	    HevSocks5UDPMsg msgv[num];
    70	    HevSocks5UDPFrame *frame;
    71	    HevListNode *node;
    72	    struct pbuf *buf;
    73	    int i, res;
    74	
    75	    res = self->frames;
    76	    if (res <= 0)
    77	        return 0;
    78	
    79	    res = (res > num) ? num : res;
    80	    node = hev_list_first (&self->frame_list);
    81	    for (i = 0; i < res; i++) {
    82	        frame = container_of (node, HevSocks5UDPFrame, node);
    83	        node = hev_list_node_next (node);
    84	        buf = frame->data;
    85	
    86	        msgv[i].buf = buf->payload;
    87	        msgv[i].len = buf->len;
    88	        msgv[i].addr = &frame->addr;
    89	    }
    90	
    91	    res = hev_socks5_udp_sendmmsg (HEV_SOCKS5_UDP (self), msgv, res);
    92	    if (res <= 0) {
    93	        LOG_D ("%p socks5 session udp fwd f send", self);
    94	        return -1;
    95	    }
    96	
    97	    for (i = 0; i < res; i++) {
    98	        node = hev_list_first (&self->frame_list);
    99	        frame = container_of (node, HevSocks5UDPFrame, node);
   100	        buf = frame->data;
   101	
   102	        hev_list_del (&self->frame_list, node);
   103	        hev_free (frame);
   104	        pbuf_free (buf);
   105	        self->frames--;
   106	    }
   107	
   108	    return 1;
   109	}
   110	
   111	static int
   112	hev_socks5_session_udp_fwd_b (HevSocks5SessionUDP *self, unsigned int num)
   113	{
   114	    char buf[UDP_BUF_SIZE * num];
   115	    HevSocks5UDPMsg msgv[num];
   116	    int i, res;
   117	
   118	    for (i = 0; i < num; i++) {
   119	        msgv[i].buf = buf + UDP_BUF_SIZE * i;
   120	        msgv[i].len = UDP_BUF_SIZE;
   121	    }
   122	
   123	    res = hev_socks5_udp_recvmmsg (HEV_SOCKS5_UDP (self), msgv, num, 1);
   124	    if (res <= 0) {
   125	        if (res == -1 && errno == EAGAIN)
   126	            return 0;
   127	        LOG_D ("%p socks5 session udp fwd b recv", self);
   128	        return -1;
   129	    }
   130	
   131	    for (i = 0; i < res; i++) {
   132	        ip_addr_t saddr;
   133	        struct pbuf *b;
   134	        uint16_t port;
   135	        err_t err;
   136	        int ret;
   137	
   138	        if (self->addr && self->port) {
   139	            ip_2_ip4 (&saddr)->addr = self->addr;
   140	            port = self->port;
   141	        } else {
   142	            ret = hev_socks5_addr_into_lwip (msgv[i].addr, &saddr, &port);
   143	            if (ret < 0) {
   144	                LOG_D ("%p socks5 session udp fwd b addr", self);
   145	                return -1;
   146	            }
   147	        }
   148	
   149	        b = pbuf_alloc_reference (msgv[i].buf, msgv[i].len, PBUF_REF);
   150	        if (!b) {
   151	            LOG_D ("%p socks5 session udp fwd b buf", self);
   152	            return -1;
   153	        }
   154	
   155	        hev_task_mutex_lock (self->mutex);
   156	        err = udp_sendfrom (self->pcb, b, &saddr, port);
   157	        hev_task_mutex_unlock (self->mutex);
   158	
   159	        pbuf_free (b);
   160	        if (err != ERR_OK) {
   161	            LOG_D ("%p socks5 session udp fwd b send", self);
   162	            return -1;
   163	        }
   164	    }
   165	
   166	    return 1;
   167	}
