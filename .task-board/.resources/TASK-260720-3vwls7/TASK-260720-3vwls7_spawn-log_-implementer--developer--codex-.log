+
+def test_source_gates(
+    item: dict[str, Any], libssh2_archive: Path, openssl_archive: Path
+) -> None:
+    with tempfile.TemporaryDirectory(prefix="relux-libssh2-source-gates-") as temporary:
+        work = Path(temporary)
