   162	@MainActor
   163	@Observable
   164	final class ReluxUpdateSettingsModel {
   165	  static let automaticCheckInterval: TimeInterval = 86_400
   166	
   167	  let feedPolicy: ReluxUpdateFeedPolicy
   168	  let presentationModel: ReluxUpdatePresentationModel
   169	  private let preferences: any ReluxUpdatePreferencesStoring
   170	  private let updater: any ReluxUpdaterControlling
   171	  private let scheduler: any ReluxUpdateScheduling
   172	
   173	  var automaticallyChecksForUpdates: Bool {
   174	    didSet {
   175	      guard automaticallyChecksForUpdates != oldValue else { return }
   176	      preferences.automaticallyChecksForUpdates = automaticallyChecksForUpdates
   177	      reconcileSchedule()
   178	    }
   179	  }
   180	
   181	  var selectedChannel: ReluxUpdateChannel {
   182	    didSet {
   183	      let effectiveChannel = feedPolicy.effectiveChannel(for: selectedChannel)
   184	      guard effectiveChannel == selectedChannel else {
   185	        selectedChannel = effectiveChannel
   186	        return
   187	      }
   188	      guard selectedChannel != oldValue else { return }
   189	      preferences.selectedChannel = selectedChannel
   190	      updater.selectedChannel = selectedChannel
   191	      updater.resetUpdateCycle()
   192	    }
   193	  }
   194	
   195	  init(
   196	    feedPolicy: ReluxUpdateFeedPolicy,
   197	    preferences: any ReluxUpdatePreferencesStoring,
   198	    updater: any ReluxUpdaterControlling,
   199	    scheduler: any ReluxUpdateScheduling,
   200	    presentationModel: ReluxUpdatePresentationModel = ReluxUpdatePresentationModel()
   201	  ) {
   202	    self.feedPolicy = feedPolicy
   203	    self.preferences = preferences
   204	    self.updater = updater
   205	    self.scheduler = scheduler
   206	    self.presentationModel = presentationModel
   207	    automaticallyChecksForUpdates = preferences.automaticallyChecksForUpdates
   208	    selectedChannel = feedPolicy.effectiveChannel(for: preferences.selectedChannel)
   209	    preferences.selectedChannel = selectedChannel
   210	    updater.selectedChannel = selectedChannel
   211	    reconcileSchedule()
   212	  }
   213	
   214	  var canCheckForUpdates: Bool {
   215	    switch presentationModel.state {
   216	    case .checking, .downloading: false
   217	    default: updater.canCheckForUpdates
   218	    }
   219	  }
   220	
   221	  func checkForUpdates() {
   222	    presentationModel.receive(.checkStarted)
   223	    updater.checkForUpdates()
   224	  }
   225	
   226	  private func reconcileSchedule() {
   227	    if automaticallyChecksForUpdates {
   228	      scheduler.scheduleAutomaticChecks(every: Self.automaticCheckInterval, using: updater)
   229	    } else {
   230	      scheduler.cancelAutomaticChecks(using: updater)
   231	    }
   232	  }
   233	}
