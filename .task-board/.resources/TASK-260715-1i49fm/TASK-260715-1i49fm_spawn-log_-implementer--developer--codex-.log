   147	/// One generation-scoped update handle.
   148	///
   149	/// A handle from an older generation becomes a no-op after the store advances,
   150	/// preventing late packet or SSH callbacks from contaminating the next run.
   151	public final class RuntimeDiagnosticsRecorder: @unchecked Sendable, TunnelMetrics,
   152	  SSHTransportMetricsSink
   153	{
   154	  public let runtimeGeneration: UInt64
   155	
   156	  private let store: RuntimeDiagnosticsStore
   157	
   158	  fileprivate init(store: RuntimeDiagnosticsStore, runtimeGeneration: UInt64) {
   159	    self.store = store
   160	    self.runtimeGeneration = runtimeGeneration
   161	  }
   162	
   163	  public func incrementCounter(named name: String, by amount: UInt64) async {
   164	    store.incrementCounter(name, by: amount, generation: runtimeGeneration)
   165	  }
   166	
   167	  public func setGauge(named name: String, to value: Int64) async {
   168	    store.setGauge(name, to: value, generation: runtimeGeneration)
   169	  }
   170	
   171	  public func snapshot() async -> TunnelMetricsSnapshot {
   172	    store.metricsSnapshot(generation: runtimeGeneration)
   173	  }
   174	
   175	  public func record(_ update: SSHMetricUpdate) async {
   176	    switch update {
   177	    case .increment(let counter, let amount):
   178	      store.incrementCounter(
   179	        RuntimeDiagnosticsMetricMap.name(counter),
   180	        by: amount,
   181	        generation: runtimeGeneration
   182	      )
   183	    case .set(let gauge, let value):
   184	      store.setGauge(
   185	        RuntimeDiagnosticsMetricMap.name(gauge),
   186	        to: value,
   187	        generation: runtimeGeneration
   188	      )
   189	    }
   190	  }
   191	
   192	  public func recordStateTransition(
   193	    to state: TunnelLifecycleState,
   194	    atUptimeMilliseconds: UInt64
   195	  ) {
   196	    store.recordStateTransition(
   197	      to: state,
   198	      atUptimeMilliseconds: atUptimeMilliseconds,
   199	      generation: runtimeGeneration
   200	    )
   201	  }
   202	
   203	  public func recordHealth(
   204	    _ health: RuntimeDiagnosticHealth,
   205	    for component: RuntimeDiagnosticComponent
   206	  ) {
   207	    store.setGauge(
   208	      RuntimeDiagnosticsMetricMap.healthGauge(component),
   209	      to: health.rawValue,
   210	      generation: runtimeGeneration
   211	    )
   212	  }
   213	
   214	  public func recordQueueDrop(_ reason: RuntimeQueueDropReason, by amount: UInt64 = 1) {
   215	    store.incrementCounter(
   216	      RuntimeDiagnosticsMetricMap.dropCounter(reason),
   217	      by: amount,
   218	      generation: runtimeGeneration
   219	    )
   220	  }
   221	
   222	  public func recordTCPFlowOpened() {
   223	    store.recordTCPFlowOpened(generation: runtimeGeneration)
   224	  }
   225	
   226	  public func recordTCPFlowClosed() {
   227	    store.recordTCPFlowClosed(generation: runtimeGeneration)
   228	  }
   229	
   230	  public func recordTCPBytes(sent: UInt64, received: UInt64) {
   231	    store.incrementCounter("tcp_bytes_sent_total", by: sent, generation: runtimeGeneration)
   232	    store.incrementCounter(
   233	      "tcp_bytes_received_total",
   234	      by: received,
   235	      generation: runtimeGeneration
   236	    )
   237	  }
   238	
   239	  public func recordDNSResult(
   240	    _ result: RuntimeDNSResultClass,
   241	    latencyMilliseconds: UInt64
   242	  ) {
   243	    store.recordDNSResult(
   244	      result,
   245	      latencyMilliseconds: latencyMilliseconds,
   246	      generation: runtimeGeneration
   247	    )
   248	  }
   249	
   250	  public func recordRoute(mode: RuntimeRouteMode, installed: Bool) {
   251	    store.recordRoute(mode: mode, installed: installed, generation: runtimeGeneration)
   252	  }
   253	
   254	  public func recordMemorySample(
   255	    physicalFootprintBytes: UInt64,
   256	    availableMemoryBytes: UInt64
   257	  ) {
   258	    store.recordMemorySample(
   259	      physicalFootprintBytes: physicalFootprintBytes,
   260	      availableMemoryBytes: availableMemoryBytes,
   261	      generation: runtimeGeneration
   262	    )
   263	  }
   264	
   265	  public func recordError(_ error: RedactedRuntimeError) {
   266	    store.recordError(error, generation: runtimeGeneration)
   267	  }
   268	
   269	  public func clearError(domain: RuntimeErrorDomain) {
   270	    store.clearError(domain: domain, generation: runtimeGeneration)
   271	  }
   272	}
