+/// The production implementation performs new system calls for every accepted observation.
+/// It intentionally has no stored sample value that could be reused as future availability.
+public protocol MemoryPlatformSamplingService: Sendable {
+  func sampleCurrentProcessMemory() -> MemoryPlatformSample
+}
+
+public struct SystemMemoryPlatformSamplingService: MemoryPlatformSamplingService {
+  public init() {}
+
+  public func sampleCurrentProcessMemory() -> MemoryPlatformSample {
+    let footprint = Self.physicalFootprint()
+    #if os(iOS)
+      let advisory: MemoryByteSample = .available(
+        bytes: UInt64(os_proc_available_memory()),
+        provenance: .osProcessAvailableMemory)
+    #else
+      let advisory: MemoryByteSample = .unavailable(
+        reason: .unsupportedPlatform,
+        provenance: .osProcessAvailableMemory)
+    #endif
+    return MemoryPlatformSample(
+      physicalFootprint: footprint.current,
+      physicalFootprintPeak: footprint.peak,
+      advisoryAvailableMemory: advisory)
+  }
+
+  private static func physicalFootprint() -> (
+    current: MemoryByteSample, peak: MemoryByteSample
+  ) {
+    var info = task_vm_info_data_t()
+    var count = mach_msg_type_number_t(
+      MemoryLayout<task_vm_info_data_t>.size / MemoryLayout<natural_t>.size)
+    let status = withUnsafeMutablePointer(to: &info) { pointer in
+      pointer.withMemoryRebound(to: integer_t.self, capacity: Int(count)) {
+        task_info(mach_task_self_, task_flavor_t(TASK_VM_INFO), $0, &count)
+      }
+    }
+    guard status == KERN_SUCCESS else {
+      let unavailable: MemoryByteSample = .unavailable(
+        reason: .systemCallFailed, provenance: .taskVMPhysicalFootprint)
+      return (unavailable, unavailable)
+    }
+    return (
+      .available(bytes: info.phys_footprint, provenance: .taskVMPhysicalFootprint),
+      .available(
+        bytes: UInt64(max(0, info.ledger_phys_footprint_peak)),
+        provenance: .taskVMPhysicalFootprint)
+    )
+  }
+}
