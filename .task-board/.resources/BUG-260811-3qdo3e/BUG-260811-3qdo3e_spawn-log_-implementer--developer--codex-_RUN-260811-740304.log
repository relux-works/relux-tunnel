   191	  func drainServices(
   192	    until deadline: ContinuousClock.Instant,
   193	    clock: any TunnelClock
   194	  ) async -> Bool {
   195	    let waiter = LibSSH2BridgeOperationWaiter()
   196	    let identifier = UUID()
   197	    let tasks: [Task<Void, Error>] = lock.withLock {
   198	      guard !serviceTasks.isEmpty else { return [] }
   199	      serviceDrainWaiters[identifier] = waiter
