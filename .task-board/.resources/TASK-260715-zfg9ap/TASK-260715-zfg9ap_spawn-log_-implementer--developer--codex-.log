+  #expect(snapshot.halfClosedFlows == 0, sourceLocation: sourceLocation)
+  #expect(snapshot.openChannels == 0, sourceLocation: sourceLocation)
+  #expect(snapshot.reservedQueuedBytes == 0, sourceLocation: sourceLocation)
