{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c751","stream":{"kind":"session","id":"01a0a9c6-18e8-73c2-87df-807f8e977157"},"sequence":515,"recorded_at":1780531400001025,"record_type":"event","durability":"durable","causation_id":"7f8b7742-5a98-412e-8203-1d9787ac5c82","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7f8b7742-5a98-412e-8203-1d9787ac5c82","run_stream":{"kind":"run","id":"7f8b7742-5a98-412e-8203-1d9787ac5c82"},"task_stream":{"kind":"task","id":"01a0a9c7-91c2-7681-b87b-59dc736f0a64"},"task_id":"01a0a9c7-91c2-7681-b87b-59dc736f0a64","event":{"kind":"output","task_id":"01a0a9c7-91c2-7681-b87b-59dc736f0a64","chunk":"Read text file `Tests/ReluxTunnelCoreTests/MacOSSystemKeychainCredentialResolverTests.swift`.\n(119 line(s) above)\n120|    let cases: [(MacOSCredentialResolverError, SSHBootstrapErrorCode)] = [\n121|      (.credentialNotProvisioned, .credentialNotProvisioned),\n122|      (.credentialAccessDenied, .credentialAccessDenied),\n123|      (.credentialWrongClass, .credentialMalformed),\n124|      (.credentialGenerationMismatch, .credentialGenerationMismatch),\n125|      (.credentialMalformed, .credentialMalformed),\n126|      (.credentialPassphraseRequired, .credentialPassphraseRequired),\n127|      (.credentialPassphraseInvalid, .credentialPassphraseInvalid),\n128|      (.credentialKeyUnsupported, .credentialKeyUnsupported),\n129|      (.operationCancelled, .operationCancelled),\n130|    ]\n131|\n132|    #expect(Set(cases.map(\\.0)) == Set(MacOSCredentialResolverError.allCases))\n133|    for (source, expectedCode) in cases {\n134|      let error = MacOSSSHBootstrapErrorMapper.credential(\n135|        source,\n136|        configurationGeneration: 13\n137|      )\n138|      #expect(error.diagnostic.code == expectedCode)\n139|      #expect(error.diagnostic.configurationGeneration == 13)\n140|      #expect(\n141|        error.diagnostic.retryDisposition\n142|          == (source == .operationCancelled ? .cancelled : .terminal)\n143|      )\n144|    }\n145|  }\n146|\n147|  @Test(\"NW and POSIX classes map without endpoint or underlying prose\")\n148|  func networkFrameworkBootstrapProjection() {\n149|    let context = SSHBootstrapDiagnosticContext(endpointFamily: .ipv6)\n150|    let unavailable = MacOSSSHBootstrapErrorMapper.network(\n151|      NWError.posix(.ENETUNREACH),\n152|      stage: .physicalPathResolution,\n153|      configurationGeneration: 5,\n154|      context: context\n155|    )\n156|    let reset = MacOSSSHBootstrapErrorMapper.network(\n157|      NWError.posix(.ECONNRESET),\n158|      stage: .endpointConnect,\n159|      configurationGeneration: 5,\n160|      context: context\n161|    )\n162|    let dns = MacOSSSHBootstrapErrorMapper.network(\n163|      NWError.dns(-65_537),\n164|      stage: .endpointConnect,\n165|      configurationGeneration: 5,\n166|      context: context\n167|    )\n168|    let tls = MacOSSSHBootstrapErrorMapper.network(\n169|      NWError.tls(-9_800),\n170|      stage: .algorithmNegotiation,\n171|      configurationGeneration: 5,\n172|      context: context\n173|    )\n174|\n175|    #expect(unavailable.diagnostic.code == .pathUnavailable)\n176|    #expect(unavailable.diagnostic.retryDisposition == .retryableLater)\n177|    #expect(reset.diagnostic.code == .endpointConnectFailed)\n178|    #expect(reset.diagnostic.retryDisposition == .retryableLater)\n179|    #expect(reset.diagnostic.context.endpointFamily == .ipv6)\n180|    #expect(dns.diagnostic.code == .endpointConnectFailed)\n181|    #expect(dns.diagnostic.retryDisposition == .retryableLater)\n182|    #expect(tls.diagnostic.code == .negotiationFailed)\n183|    #expect(tls.diagnostic.retryDisposition == .terminal)\n184|  }\n185|\n186|  // NWError.wifiAware exists only in the macOS 26 SDK (Swift 6.2+ toolchain).\n187|  #if compiler(>=6.2)\n188|    @Test(\"wifiAware maps to unavailable without platform values\")\n189|    func wifiAwareBootstrapProjection() throws {\n190|      guard #available(macOS 26, *) else { return }\n191|      let context = SSHBootstrapDiagnosticContext(endpointFamily: .ipv6)\n192|      let error = MacOSSSHBootstrapErrorMapper.network(\n193|        NWError.wifiAware(987_456),\n194|        stage: .endpointConnect,\n195|        configurationGeneration: 5,\n196|        context: context\n197|      )\n198|\n199|      #expect(error.diagnostic.code == .endpointConnectFailed)\n200|      #expect(error.diagnostic.retryDisposition == .retryableLater)\n201|      #expect(error.diagnostic.context.endpointFamily == .ipv6)\n202|      #expect(error.diagnostic.configurationGeneration == 5)\n203|      let encoded = try JSONEncoder().encode(error.diagnostic)\n204|      #expect(!String(data: encoded, encoding: .utf8)!.contains(\"987456\"))\n205|    }\n206|  #endif\n207|\n208|  @Test(\"record generation digest truncation and trailing bytes fail closed\")\n209|  func strictRecordFormat() async throws {\n210|    let reference = UUID(uuidString: \"dddddddd-dddd-dddd-dddd-dddddddddddd\")!\n211|    let handle = fixtureKeychainHandle()\n212|    var records = [\n213|      credentialRecord(reference: reference, generation: 7, format: 1),\n214|      credentialRecord(reference: reference, generation: 7, format: 1) + [0],\n215|    ]\n216|    records[0][records[0].count - 1] ^= 0xFF\n217|\n218|    for record in records {\n219|      let security = FixtureSystemKeychainClient(\n(more lines below)","final_result":true}}}
