  1060	
  1061	private struct RuntimeSchemaHeader: Decodable {
  1062	  let schemaVersion: UInt16
  1063	}
  1064	
  1065	enum RuntimeJSONCodec {
  1066	  static func encode<T: Encodable>(_ value: T, maximumBytes: Int) throws -> Data {
  1067	    let encoder = JSONEncoder()
  1068	    encoder.outputFormatting = [.sortedKeys, .withoutEscapingSlashes]
  1069	    do {
  1070	      let data = try encoder.encode(value)
  1071	      guard data.count <= maximumBytes else {
  1072	        throw RuntimeMessageCodecError.payloadTooLarge(
  1073	          maximumBytes: maximumBytes,
  1074	          actualBytes: data.count
  1075	        )
  1076	      }
  1077	      return data
  1078	    } catch let error as RuntimeMessageCodecError {
  1079	      throw error
  1080	    } catch {
  1081	      throw RuntimeMessageCodecError.corruptPayload
  1082	    }
  1083	  }
  1084	
  1085	  static func decodeVersioned<T: Decodable>(
  1086	    _ type: T.Type,
  1087	    from data: Data,
  1088	    maximumBytes: Int
  1089	  ) throws -> T {
  1090	    try StrictJSONValidator.validate(data, maximumBytes: maximumBytes)
  1091	    let header: RuntimeSchemaHeader = try decodeJSON(RuntimeSchemaHeader.self, from: data)
  1092	    guard header.schemaVersion == RuntimeMessageProtocol.currentSchemaVersion else {
  1093	      throw RuntimeMessageCodecError.unsupportedSchemaVersion(header.schemaVersion)
  1094	    }
  1095	    return try decodeJSON(type, from: data)
  1096	  }
  1097	
  1098	  static func decodeMessage<T: Decodable>(
  1099	    _ type: T.Type,
  1100	    from data: Data,
  1101	    maximumBytes: Int,
  1102	    acceptedKinds: Set<String>
  1103	  ) throws -> T {
  1104	    try StrictJSONValidator.validate(data, maximumBytes: maximumBytes)
  1105	    let header: RuntimeMessageHeader = try decodeJSON(RuntimeMessageHeader.self, from: data)
  1106	    guard header.protocolVersion >= RuntimeMessageProtocol.minimumProtocolVersion,
  1107	      header.protocolVersion <= RuntimeMessageProtocol.maximumProtocolVersion
  1108	    else {
  1109	      throw RuntimeMessageCodecError.unsupportedProtocolVersion(header.protocolVersion)
  1110	    }
  1111	    guard header.schemaVersion == RuntimeMessageProtocol.currentSchemaVersion else {
  1112	      throw RuntimeMessageCodecError.unsupportedSchemaVersion(header.schemaVersion)
  1113	    }
  1114	    guard acceptedKinds.contains(header.kind) else {
  1115	      throw RuntimeMessageCodecError.unsupportedKind
