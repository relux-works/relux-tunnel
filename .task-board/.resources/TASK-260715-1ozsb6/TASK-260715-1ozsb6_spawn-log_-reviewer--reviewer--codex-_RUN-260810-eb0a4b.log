   732	  private func authenticate(username: String, publicKey: Data, timeout: Duration) async throws {
   733	    guard let engineSession else {
   734	      throw transportError(code: .invalidState, phase: .authentication)
   735	    }
   736	    let deadline = dependencies.clock.now().advanced(by: timeout)
   737	    while true {
   738	      try checkCancellation(phase: .authentication)
   739	      var abstract = sessionContextPointer
   740	      let result = username.withCString { user in
   741	        publicKey.withUnsafeBytes { bytes in
   742	          libssh2_userauth_publickey(
   743	            engineSession,
   744	            user,
   745	            bytes.bindMemory(to: UInt8.self).baseAddress,
   746	            bytes.count,
   747	            reluxLibSSH2SignCallback,
   748	            &abstract
   749	          )
   750	        }
   751	      }
   752	      if result == 0 { return }
   753	      guard result == LIBSSH2_ERROR_EAGAIN else {
   754	        counters.authenticationRejected += 1
   755	        await metric(.increment(.authenticationRejected, by: 1))
   756	        throw engineError(result, phase: .authentication, fallback: .authenticationRejected)
   757	      }
   758	      try await progress(until: deadline, phase: .authentication)
   759	    }
   760	  }

