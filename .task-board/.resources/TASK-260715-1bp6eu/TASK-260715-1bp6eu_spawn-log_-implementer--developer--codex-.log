+            runtimeGeneration: snapshot.capabilities.runtimeGeneration,
+            snapshotSequence: snapshot.capabilities.snapshotSequence,
+            tcp: snapshot.capabilities.tcp,
+            safeDNS: snapshot.capabilities.safeDNS,
