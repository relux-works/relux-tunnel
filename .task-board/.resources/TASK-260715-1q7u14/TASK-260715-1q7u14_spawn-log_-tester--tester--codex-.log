  fileprivate func effectiveLimits(maxFrame: UInt32) -> RelayEffectiveLimits {
    RelayEffectiveLimits(
      effectiveMaxFrame: maxFrame,
      maxUDPPayload: min(
        maximumUDPPayloadBytes,
        RelayProtocolV1.maxUDPPayloadClientDefault
      ),
      maxAssociations: min(
