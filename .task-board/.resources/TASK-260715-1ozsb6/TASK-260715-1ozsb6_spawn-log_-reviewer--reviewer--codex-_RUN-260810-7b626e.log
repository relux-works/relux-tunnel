   492	  private func configureEngine(configuration: SSHConnectionConfiguration) throws {
   493	    let opaque = Unmanaged.passUnretained(context).toOpaque()
   494	    sessionContextPointer = opaque
   495	    let freeCallback = unsafeBitCast(reluxLibSSH2FreeCallback, to: OpaquePointer.self)
   496	    guard
   497	      let session = libssh2_session_init_ex(
   498	        reluxLibSSH2AllocateCallback,
   499	        freeCallback,
   500	        reluxLibSSH2ReallocateCallback,
   501	        opaque
   502	      )
   503	    else {
   504	      throw transportError(code: .resourceLimitExceeded, phase: .initialKeyExchange)
   505	    }
   506	    engineSession = session
   507	    libssh2_session_set_blocking(session, 0)
   508	    let sendCallback: (@convention(c) () -> Void)? = unsafeBitCast(
   509	      reluxLibSSH2SendCallback,
   510	      to: Optional<@convention(c) () -> Void>.self
   511	    )
   512	    let receiveCallback: (@convention(c) () -> Void)? = unsafeBitCast(
   513	      reluxLibSSH2ReceiveCallback,
   514	      to: Optional<@convention(c) () -> Void>.self
   515	    )
   516	    _ = libssh2_session_callback_set2(session, Int32(LIBSSH2_CALLBACK_SEND), sendCallback)
   517	    _ = libssh2_session_callback_set2(session, Int32(LIBSSH2_CALLBACK_RECV), receiveCallback)
   518	
   519	    try setPreference(Int32(LIBSSH2_METHOD_KEX), configuration.algorithms.keyExchange)
   520	    try setPreference(Int32(LIBSSH2_METHOD_HOSTKEY), configuration.algorithms.hostKey)
   521	    try setPreference(Int32(LIBSSH2_METHOD_CRYPT_CS), configuration.algorithms.cipher)
   522	    try setPreference(Int32(LIBSSH2_METHOD_CRYPT_SC), configuration.algorithms.cipher)
   523	    try setPreference(Int32(LIBSSH2_METHOD_MAC_CS), configuration.algorithms.mac)
   524	    try setPreference(Int32(LIBSSH2_METHOD_MAC_SC), configuration.algorithms.mac)
   525	    try setPreference(Int32(LIBSSH2_METHOD_SIGN_ALGO), configuration.algorithms.hostKey)
   526	    libssh2_keepalive_config(
   527	      session,
   528	      1,
   529	      UInt32(max(2, configuration.keepalive.interval.wholeSeconds))
   530	    )
   531	  }
