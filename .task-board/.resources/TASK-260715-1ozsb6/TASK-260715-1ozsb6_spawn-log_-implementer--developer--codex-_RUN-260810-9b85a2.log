+  func evaluate(_ input: SSHHostKeyPolicyInput) async throws -> SSHHostKeyDecision {
+    await trace.append(.hostPolicy)
+    return .acceptFirstUse(SSHTrustRecordReference(rawValue: "fixture.trust"))
