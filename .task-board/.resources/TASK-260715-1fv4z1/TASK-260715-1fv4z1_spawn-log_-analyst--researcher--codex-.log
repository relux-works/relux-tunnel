     6	
     7	permissions:
     8	  contents: write
     9	  id-token: write
    10	  attestations: write
    11	
    12	concurrency:
    13	  group: release-${{ github.ref }}
    14	  cancel-in-progress: false
    15	
    16	jobs:
    17	  notarized-dmg:
    18	    runs-on: macos-15
    19	    steps:
    20	      - uses: actions/checkout@v7
    21	        with:
    22	          fetch-depth: 0
    23	
    24	      - name: Import Developer ID identity
    25	        env:
    26	          MACOS_CERT_P12: ${{ secrets.MACOS_CERT_P12 }}
    27	        run: |
    28	          echo "$MACOS_CERT_P12" | base64 --decode > /tmp/relux-devid.p12
    29	          security create-keychain -p ci-temp ci.keychain
    30	          security set-keychain-settings -lut 21600 ci.keychain
    31	          security unlock-keychain -p ci-temp ci.keychain
    32	          security import /tmp/relux-devid.p12 -k ci.keychain -P "" -T /usr/bin/codesign
    33	          security set-key-partition-list -S apple-tool:,apple: -s -k ci-temp ci.keychain
    34	          security list-keychains -d user -s ci.keychain login.keychain
    35	          rm -f /tmp/relux-devid.p12
    36	
    37	      - name: Build signed universal app
    38	        env:
    39	          VERSION: ${{ github.ref_name }}
    40	          BUILD_NUMBER: ${{ github.run_number }}
    41	          SIGN_IDENTITY: "Developer ID Application: Relux Works, LLC (262RZ595FP)"
    42	        run: scripts/build-app.sh
    43	
    44	      - name: Package and sign DMG
    45	        env:
    46	          VERSION: ${{ github.ref_name }}
    47	        run: |
    48	          scripts/create-dmg.sh
    49	          codesign --force --sign "Developer ID Application: Relux Works, LLC (262RZ595FP)" \
    50	            --timestamp dist/ReluxProxy-*.dmg
    51	
    52	      - name: Notarize and staple
    53	        env:
    54	          ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
    55	          ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
    56	          ASC_KEY_P8: ${{ secrets.ASC_KEY_P8 }}
    57	        run: |
    58	          echo "$ASC_KEY_P8" | base64 --decode > /tmp/asc.p8
    59	          xcrun notarytool submit dist/ReluxProxy-*.dmg \
    60	            --key /tmp/asc.p8 \
    61	            --key-id "$ASC_KEY_ID" \
    62	            --issuer "$ASC_ISSUER_ID" \
    63	            --wait
    64	          rm -f /tmp/asc.p8
    65	          xcrun stapler staple dist/ReluxProxy-*.dmg
    66	          xcrun stapler validate dist/ReluxProxy-*.dmg
    67	          spctl -a -t open --context context:primary-signature -v dist/ReluxProxy-*.dmg
    68	
    69	      - name: Create stable latest asset and checksums
    70	        run: |
    71	          cp dist/ReluxProxy-*.dmg dist/ReluxProxy.dmg
    72	          (cd dist && shasum -a 256 ReluxProxy-*.dmg ReluxProxy.dmg > SHA256SUMS)
    73	
    74	      - name: Attest build provenance
    75	        uses: actions/attest-build-provenance@v4
    76	        with:
    77	          subject-path: dist/ReluxProxy*.dmg
    78	
    79	      - name: Publish GitHub release
    80	        uses: softprops/action-gh-release@v3
    81	        with:
    82	          files: |
    83	            dist/ReluxProxy-*.dmg
    84	            dist/ReluxProxy.dmg
    85	            dist/SHA256SUMS
    86	          generate_release_notes: true

