  1028	  private func beginChannelOpen(
  1029	    until deadline: ContinuousClock.Instant
  1030	  ) async throws -> LibSSH2SessionOperationPermit {
  1031	    guard state == .ready || state == .rekeying else {
  1032	      throw transportError(code: .invalidState, phase: .channelOpen)
  1033	    }
  1034	    pendingChannelOpens += 1
  1035	    await metric(.set(.pendingChannelOpens, to: Int64(pendingChannelOpens)))
