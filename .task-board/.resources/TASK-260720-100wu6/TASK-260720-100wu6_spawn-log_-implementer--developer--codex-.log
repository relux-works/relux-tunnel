+    #expect(throws: SSHContractValidationError.invalidWindowAdjustment) {
+      _ = try SSHWindowAdjustment(
+        channel: fixtureChannelID(1),
+        before: 7,
+        amount: 2,
+        after: 9,
+        cap: 8
+      )
