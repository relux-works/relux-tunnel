  2062	private final class LoopbackEchoServer: @unchecked Sendable {
  2063	  let port: UInt16
  2064	  private let lock = NSLock()
  2065	  private var listener: Int32?
  2066	  private var client: Int32?
  2067	  private var task: Task<Void, Never>?
  2068	
  2069	  init() throws {
