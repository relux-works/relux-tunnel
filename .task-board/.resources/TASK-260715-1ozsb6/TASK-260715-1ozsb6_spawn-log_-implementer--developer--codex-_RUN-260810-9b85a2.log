   794	  private func progress(until deadline: ContinuousClock.Instant, phase: SSHTransportPhase)
   795	    async throws
   796	  {
   797	    try checkCancellation(phase: phase)
   798	    let now = dependencies.clock.now()
   799	    guard now < deadline else { throw transportError(code: .timedOut, phase: phase) }
   800	    let remaining = now.duration(to: deadline)
   801	    if context.signatureIsPending() {
   802	      try await withTimeout(remaining, clock: dependencies.clock) {
   803	        await self.context.waitForSignature()
   804	      }
   805	      return
   806	    }
   807	    guard let connection, let engineSession else {
   808	      throw transportError(code: .connectionClosed, phase: phase)
   809	    }
   810	    let directions = libssh2_session_block_directions(engineSession)
   811	    var interests = Set<SSHTCPReadiness>()
   812	    if directions & LIBSSH2_SESSION_BLOCK_INBOUND != 0 { interests.insert(.readable) }
   813	    if directions & LIBSSH2_SESSION_BLOCK_OUTBOUND != 0 { interests.insert(.writable) }
   814	    if interests.isEmpty { interests = [.readable, .writable] }
   815	    let requestedInterests = interests
   816	    try await withTimeout(remaining, clock: dependencies.clock) {
   817	      try await self.context.network.service(
   818	        connection: connection,
   819	        interests: requestedInterests
   820	      )
   821	    }
   822	  }
