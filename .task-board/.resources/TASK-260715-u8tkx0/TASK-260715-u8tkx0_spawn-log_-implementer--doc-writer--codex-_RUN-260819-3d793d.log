+asset.update({
+    "relayVersion": relay_version,
+    "sourceCommit": source_commit,
+    "buildProvenance": {
+        "kind": "taskBoardResource",
+        "taskID": archive_task,
+        "resourceName": archive_resource,
+        "archiveSHA256": archive_sha256,
+    },
+    "assets": [
+        {
+            "os": item["os"],
+            "arch": item["arch"],
+            "archivePath": f'{item["os"]}-{item["arch"]}/{item["filename"]}',
+            "fileName": item["filename"],
+            "byteSize": item["size"],
+            "sha256": item["sha256"],
