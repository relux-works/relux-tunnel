    49	/// Synchronous cancellation and force-close seam for handles whose platform
    50	/// APIs can be interrupted without waiting for an async callback.
    51	public protocol ProviderCleanupControllable: AnyObject, Sendable {
    52	  func cancelProviderWork()
    53	  func forceCloseProviderHandle()
    54	}
    55	
    56	/// Fixed-capacity, generation-scoped cleanup fan-out.
    57	///
    58	/// A handle registered after retirement is cancelled and force-closed
    59	/// immediately, which prevents a late startup callback from escaping into a
    60	/// newer generation.
    61	public final class ProviderCleanupRegistry: @unchecked Sendable {
    62	  public static let maximumHandles = 64
    63	
    64	  private enum State {
    65	    case accepting
    66	    case cancelling
    67	    case retired
    68	  }
    69	
    70	  private let lock = NSLock()
    71	  private var state = State.accepting
    72	  private var handles: [ObjectIdentifier: any ProviderCleanupControllable] = [:]
    73	
    74	  public init() {}
    75	
    76	  @discardableResult
    77	  public func register(_ handle: any ProviderCleanupControllable) -> Bool {
    78	    let action: RegistrationAction = lock.withLock {
    79	      switch state {
    80	      case .accepting where handles.count < Self.maximumHandles:
    81	        handles[ObjectIdentifier(handle)] = handle
    82	        return .accepted
    83	      case .accepting, .cancelling:
    84	        return .cancelAndForceClose
    85	      case .retired:
    86	        return .cancelAndForceClose
    87	      }
    88	    }
    89	    if action == .cancelAndForceClose {
    90	      handle.cancelProviderWork()
    91	      handle.forceCloseProviderHandle()
    92	      return false
    93	    }
    94	    return true
    95	  }
    96	
    97	  public func cancelAll() {
    98	    let snapshot: [any ProviderCleanupControllable] = lock.withLock {
    99	      guard state != .retired else { return [] }
   100	      state = .cancelling
   101	      return Array(handles.values)
   102	    }
   103	    for handle in snapshot {
   104	      handle.cancelProviderWork()
   105	    }
   106	  }
   107	
   108	  public func forceCloseAll() {
   109	    let snapshot: [any ProviderCleanupControllable] = lock.withLock {
   110	      state = .retired
   111	      let snapshot = Array(handles.values)
   112	      handles.removeAll(keepingCapacity: false)
   113	      return snapshot
   114	    }
   115	    for handle in snapshot {
   116	      handle.cancelProviderWork()
   117	      handle.forceCloseProviderHandle()
   118	    }
   119	  }
   120	
   121	  public func retireAfterGracefulCleanup() {
   122	    lock.withLock {
   123	      state = .retired
   124	      handles.removeAll(keepingCapacity: false)
   125	    }
   126	  }
   127	
   128	  var registeredHandleCount: Int {
   129	    lock.withLock { handles.count }
   130	  }
   131	
   132	  private enum RegistrationAction {
   133	    case accepted
   134	    case cancelAndForceClose
   135	  }
   136	}
