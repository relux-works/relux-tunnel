    65	/// Ordering key for immutable runtime snapshots.
    66	///
    67	/// A consumer accepts a position only when its generation is newer, or when it
    68	/// has a strictly higher sequence in the same generation.
    69	public struct RuntimeSnapshotPosition: Codable, Equatable, Sendable {
    70	  public let runtimeGeneration: UInt64
    71	  public let snapshotSequence: UInt64
    72	
    73	  public init(runtimeGeneration: UInt64, snapshotSequence: UInt64) {
    74	    self.runtimeGeneration = runtimeGeneration
    75	    self.snapshotSequence = snapshotSequence
    76	  }
    77	
    78	  public func isNewer(than previous: RuntimeSnapshotPosition?) -> Bool {
    79	    guard let previous else { return true }
    80	    if runtimeGeneration != previous.runtimeGeneration {
    81	      return runtimeGeneration > previous.runtimeGeneration
    82	    }
    83	    return snapshotSequence > previous.snapshotSequence
    84	  }
    85	}
