   840	def atomic_exchange(left: Path, right: Path) -> None:
   841	    library = ctypes.CDLL(None, use_errno=True)
   842	    left_bytes = os.fsencode(left)
   843	    right_bytes = os.fsencode(right)
   844	    if sys.platform == "darwin":
   845	        function = library.renameatx_np
   846	        function.argtypes = [
   847	            ctypes.c_int,
   848	            ctypes.c_char_p,
   849	            ctypes.c_int,
   850	            ctypes.c_char_p,
   851	            ctypes.c_uint,
   852	        ]
   853	        function.restype = ctypes.c_int
   854	        result = function(-2, left_bytes, -2, right_bytes, 0x00000002)
   855	    elif sys.platform.startswith("linux"):
   856	        function = library.renameat2
   857	        function.argtypes = [
   858	            ctypes.c_int,
   859	            ctypes.c_char_p,
   860	            ctypes.c_int,
   861	            ctypes.c_char_p,
   862	            ctypes.c_uint,
   863	        ]
   864	        function.restype = ctypes.c_int
   865	        result = function(-100, left_bytes, -100, right_bytes, 0x00000002)
   866	    else:
   867	        raise AssetManifestError(
   868	            "atomic relay asset directory replacement is unavailable"
   869	        )
   870	    if result != 0:
   871	        error_number = ctypes.get_errno()
   872	        raise AssetManifestError(
   873	            "atomic relay asset directory replacement failed"
   874	        ) from OSError(error_number, os.strerror(error_number))
