+output_dir="$repo_root/.temp/TASK-260715-2kchi0/schema-rework04"
+mkdir -p "$output_dir"
+
+accept() {
+  check-jsonschema --schemafile "$schema" "$2" >"$output_dir/$1.accept.log"
+}
+
+reject() {
+  if check-jsonschema --schemafile "$schema" "$2" >"$output_dir/$1.reject.log" 2>&1; then
+    echo "unexpected schema acceptance: $1" >&2
+    exit 1
+  fi
+}
+
+merge() {
+  jq -s '.[0] * .[1]' "$1" "$2" >"$3"
+}
+
+check-jsonschema --check-metaschema "$schema" >"$output_dir/metaschema.log"
+accept base "$base"
+
+merge "$base" "$fixtures/TASK-260715-2kchi0_equality-boundary-valid.overlay.json" "$output_dir/equality.json"
+accept equality "$output_dir/equality.json"
+
+jq -s '. as $d | ($d[0] * $d[1]) |
+  .comparison = $d[1].comparison |
+  .review.exactCoverage = $d[1].review.exactCoverage' \
+  "$base" "$fixtures/TASK-260715-2kchi0_multi-repetition-valid.overlay.json" \
+  >"$output_dir/multi.json"
+accept multi "$output_dir/multi.json"
+
+merge "$output_dir/multi.json" "$fixtures/TASK-260715-2kchi0_m3-valid.overlay.json" "$output_dir/m3.json"
+accept m3 "$output_dir/m3.json"
+
+merge "$output_dir/m3.json" "$fixtures/TASK-260715-2kchi0_production-authorized-m3-valid.overlay.json" "$output_dir/production.json"
+accept production "$output_dir/production.json"
+
+jq -e '.comparison.multiplicity.candidateCount == 3 and
+  .comparison.multiplicity.coverage.numerator == 59 and
+  .comparison.multiplicity.coverage.denominator == 60 and
+  .comparison.multiplicity.intervalRanks.lowerIndex == 83 and
+  .comparison.multiplicity.intervalRanks.upperIndex == 9916 and
+  .review.candidateCount == 3 and
+  .review.exactCoverage.numerator == 59 and
+  .review.exactCoverage.denominator == 60' "$output_dir/m3.json" >/dev/null
+
+merge "$base" "$fixtures/TASK-260715-2kchi0_one-over-invalid.overlay.json" "$output_dir/one-over.json"
+reject one-over "$output_dir/one-over.json"
+
+merge "$base" "$fixtures/TASK-260715-2kchi0_hostile-invalid.overlay.json" "$output_dir/hostile.json"
+reject hostile "$output_dir/hostile.json"
+
+merge "$output_dir/production.json" "$fixtures/TASK-260715-2kchi0_missing-review-statistics-invalid.overlay.json" "$output_dir/missing-review.json"
+reject missing-review "$output_dir/missing-review.json"
+
+merge "$base" "$fixtures/TASK-260715-2kchi0_unavailable-measured-pass-invalid.overlay.json" "$output_dir/unavailable-status.json"
+reject unavailable-status "$output_dir/unavailable-status.json"
+
+jq -s '. as $d | ($d[0] * $d[1]) |
+  .status.exclusion = $d[1].status.exclusion' \
+  "$base" "$fixtures/TASK-260715-2kchi0_invalid-environment-measured-pass-invalid.overlay.json" \
+  >"$output_dir/invalid-environment-status.json"
+reject invalid-environment-status "$output_dir/invalid-environment-status.json"
+
+hostile_filters=(
+  '.review.reviewer = {"available":false,"reasonCode":"not-measured","reason":"Hostile mutation.","ownerTaskID":"TASK-260721-2ohf99"}'
+  '.review.reviewedAtUTC = {"available":false,"reasonCode":"not-measured","reason":"Hostile mutation.","ownerTaskID":"TASK-260721-2ohf99"}'
+  '.review.classification = {"available":false,"reasonCode":"not-measured","reason":"Hostile mutation.","ownerTaskID":"TASK-260721-2ohf99"}'
+  '.review.comparisonGroupID = {"available":false,"reasonCode":"not-measured","reason":"Hostile mutation.","ownerTaskID":"TASK-260721-2ohf99"}'
+  '.review.candidateCount = 0'
+  '.review.exactCoverage = {"available":false,"reasonCode":"not-measured","reason":"Hostile mutation.","ownerTaskID":"TASK-260721-2ohf99"}'
+  '.comparison = {"available":false,"reasonCode":"not-measured","reason":"Hostile mutation.","ownerTaskID":"TASK-260721-2ohf99"}'
+  '.review.acceptedUpdateLineage = []'
+  '.authority.provisional = true'
+  '.authority.blockers = ["TASK-260715-1gjxer"]'
+  '.policies.dns.productionAuthorizationPermitted = false'
+  '.gates.cleanup.passed = false'
+  '.privacy.privacyScan.passed = false'
+)
+
+hostile_index=0
+for filter in "${hostile_filters[@]}"; do
+  hostile_index=$((hostile_index + 1))
+  jq "$filter" "$output_dir/production.json" >"$output_dir/production-hostile-$hostile_index.json"
+  reject "production-hostile-$hostile_index" "$output_dir/production-hostile-$hostile_index.json"
+done
+
+echo "TASK-260715-2kchi0 contract schema regression: pass"
