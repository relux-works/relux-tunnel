 let application = NSApplication.shared
 application.setActivationPolicy(.accessory)
+
+let appDelegate: ReluxProxyAppDelegate
+do {
+  appDelegate = try ReluxProxyAppDelegate(infoDictionary: Bundle.main.infoDictionary ?? [:])
+} catch {
