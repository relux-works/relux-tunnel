   418	    try operation()
   419	    Issue.record("expected \(code.rawValue)")
   420	  } catch let failure as RelayDatagramFailure {
   421	    #expect(failure.code == code)
   422	    #expect(failure.scope == scope)
   423	    #expect(failure.disposition == disposition)
