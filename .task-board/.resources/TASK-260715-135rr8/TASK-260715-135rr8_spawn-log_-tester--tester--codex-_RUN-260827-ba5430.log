+        cycle: iteration + 1,
+        descriptors: process.descriptors,
+        processThreads: process.threads,
+        physicalFootprintBytes: process.physicalFootprintBytes,
+        liveHEVSessionsAfterCleanup: harness.adapter.liveChannelCount,
+        outstandingReadsAfterCleanup: driver.outstandingReadCount,
+        queuedBatchesAfterCleanup: driver.queuedBatchCount
+      )
+    )
+  }
+
+  let final = try physicalProcessSnapshot()
+  let footprintSamples = samples.map(\.physicalFootprintBytes)
+  let monotonicGrowthObserved =
+    footprintSamples.count > 1
+    && zip(footprintSamples, footprintSamples.dropFirst()).allSatisfy(<)
+  #expect(acceptedSessions == cycles)
+  #expect(
+    !monotonicGrowthObserved,
+    "physical footprint grew monotonically across all \(cycles) start/stop cycles"
+  )
+  return PhysicalMemoryLifecycleEvidence(
+    cycles: cycles,
+    result: "measured in this emitting process; all lifecycle invariants passed",
+    cancellationPoints:
+      "covered by PacketFlowBridge lifecycle/fault suites at pre-borrow, active read, and stop",
+    initialDescriptors: initial.descriptors,
+    finalDescriptors: final.descriptors,
+    initialThreads: initial.threads,
+    finalThreads: final.threads,
+    initialPhysicalFootprintBytes: initial.physicalFootprintBytes,
+    finalPhysicalFootprintBytes: final.physicalFootprintBytes,
+    monotonicGrowthObserved: monotonicGrowthObserved,
+    samples: samples
+  )
+}
