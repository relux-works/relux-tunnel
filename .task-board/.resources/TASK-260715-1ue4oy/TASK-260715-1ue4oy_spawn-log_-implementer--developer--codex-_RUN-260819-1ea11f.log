   606	def validate_asset_descriptor(
   607	    descriptor: int,
   608	    status: os.stat_result,
   609	    asset: dict[str, Any],
   610	    source: dict[str, Any],
   611	    contract: dict[str, Any],
   612	) -> None:
   613	    if stat.S_IMODE(status.st_mode) != 0o755:
   614	        raise AssetManifestError("relay asset has an unsafe mode")
   615
   616	    commit = contract["sourceCommit"].encode("ascii")
   617	    version = ("Xb" + contract["relayVersion"]).encode("ascii")
   618	    maximum_pattern_size = max(len(commit), len(version))
   619	    tail = b""
   620	    header = bytearray()
   621	    commit_count = 0
   622	    version_seen = False
   623	    total = 0
   624	    digest = hashlib.sha256()
   625
   626	    try:
   627	        while True:
   628	            chunk = os.read(descriptor, READ_CHUNK_BYTES)
   629	            if not chunk:
   630	                break
   631	            total += len(chunk)
   632	            if total > asset["byteSize"]:
   633	                raise AssetManifestError("relay asset grew while reading")
   634	            digest.update(chunk)
   635	            if len(header) < 20:
   636	                header.extend(chunk[: 20 - len(header)])
   637	            window = tail + chunk
   638	            commit_count += count_new_matches(window, len(tail), commit)
   639	            if not version_seen:
   640	                version_seen = count_new_matches(window, len(tail), version) > 0
   641	            tail = window[-(maximum_pattern_size - 1) :]
   642	    except OSError as error:
   643	        raise AssetManifestError("relay asset could not be read") from error
   644
   645	    if total != asset["byteSize"]:
   646	        raise AssetManifestError("relay asset size changed while reading")
   647	    if digest.hexdigest() != asset["sha256"]:
   648	        raise AssetManifestError("relay asset bytes do not match the manifest")
   649	    verify_binary_header(bytes(header), source["os"], source["arch"])
   650	    if commit_count != 1 or not version_seen:
   651	        raise AssetManifestError("relay asset embedded build identity mismatch")
