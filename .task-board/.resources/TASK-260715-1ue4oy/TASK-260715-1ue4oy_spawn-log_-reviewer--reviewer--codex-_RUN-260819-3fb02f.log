   443	    def test_fdopen_failures_close_owned_descriptors(self) -> None:
   444	        real_open = manifest_tool.os.open
   445	        opened: list[int] = []
   446
   447	        def track_open(*args, **kwargs) -> int:
   448	            descriptor = real_open(*args, **kwargs)
   449	            opened.append(descriptor)
   450	            return descriptor
   451
   452	        with mock.patch.object(manifest_tool.os, "open", side_effect=track_open):
   453	            with mock.patch.object(
   454	                manifest_tool.os, "fdopen", side_effect=OSError("injected fdopen")
   455	            ):
   456	                with self.assertRaises(manifest_tool.AssetManifestError):
   457	                    manifest_tool.sha256_file(self.archive)
   458	        self.assertEqual(len(opened), 1)
   459	        with self.assertRaises(OSError):
   460	            os.fstat(opened[0])
   461
   462	        opened.clear()
   463	        with mock.patch.object(manifest_tool.os, "open", side_effect=track_open):
   464	            with mock.patch.object(
   465	                manifest_tool.os, "fdopen", side_effect=OSError("injected fdopen")
   466	            ):
   467	                with self.assertRaises(manifest_tool.AssetManifestError):
   468	                    manifest_tool.read_archive_assets(self.archive, self.contract)
   469	        self.assertEqual(len(opened), 1)
   470	        with self.assertRaises(OSError):
   471	            os.fstat(opened[0])
   472
   473	        directory_descriptor = real_open(
   474	            self.root, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
   475	        )
   476	        opened.clear()
   477	        try:
   478	            with mock.patch.object(manifest_tool.os, "open", side_effect=track_open):
   479	                with mock.patch.object(
   480	                    manifest_tool.os,
   481	                    "fdopen",
   482	                    side_effect=OSError("injected fdopen"),
   483	                ):
   484	                    with self.assertRaises(manifest_tool.AssetManifestError):
   485	                        manifest_tool.write_new_file_at(
   486	                            directory_descriptor, "fdopen-failure", b"data", 0o600
   487	                        )
   488	        finally:
   489	            os.close(directory_descriptor)
   490	        self.assertEqual(len(opened), 1)
   491	        with self.assertRaises(OSError):
   492	            os.fstat(opened[0])
