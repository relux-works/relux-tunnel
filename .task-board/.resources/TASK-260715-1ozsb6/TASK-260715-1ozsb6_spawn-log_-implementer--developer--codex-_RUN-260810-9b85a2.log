diff --git a/Tests/ReluxTunnelLibSSH2AdapterTests/LibSSH2AdapterIntegrationTests.swift b/Tests/ReluxTunnelLibSSH2AdapterTests/LibSSH2AdapterIntegrationTests.swift
new file mode 100644
