+
+def swift_contents_of_surface(tokens: list[tuple[str, str]]) -> str | None:
+    loader_types = swift_loader_types(tokens)
+    for index, (kind, value) in enumerate(tokens):
+        if kind != "identifier" or value != "contentsOf":
+            continue
