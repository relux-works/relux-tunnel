   414	
   415	    let sameGenerationReplacement = try SSHProfileProviderConfigurationCodec.encode(
   416	      fixture(generation: 7, account: "changed-account")
   417	    )
   418	    #expect(throws: SSHProfileSnapshotLoaderError.profileGenerationMismatch) {
   419	      try loader.capture(from: sameGenerationReplacement)
