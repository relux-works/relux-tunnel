   658	extension CSPRNG {
   659	    /// A SSH key exchange cookie is 16 random bytes.
   660	    fileprivate mutating func randomCookie(allocator: ByteBufferAllocator) -> ByteBuffer {
   661	        var buffer = allocator.buffer(capacity: 16)
   662	        buffer.writeInteger(self.next())
   663	        buffer.writeInteger(self.next())
