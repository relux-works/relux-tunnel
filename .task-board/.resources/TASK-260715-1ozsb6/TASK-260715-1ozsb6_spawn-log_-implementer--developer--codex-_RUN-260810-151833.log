  1420	      try await progress(
  1421	        until: deadline,
  1422	        phase: .channelWrite,
  1423	        scope: .channel(identity)
  1424	      )
  1425	      await emit(
  1426	        .writeBackpressureEnded(
  1427	          channel: identity,
  1428	          waitDuration: started.duration(to: dependencies.clock.now())
  1429	        )
  1430	      )
  1431	    }
  1432	  }
