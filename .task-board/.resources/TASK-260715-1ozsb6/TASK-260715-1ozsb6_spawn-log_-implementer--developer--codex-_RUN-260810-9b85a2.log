-      } catch {
-        self?.resolve(.failure(error))
-      }
-    }
-    let shouldCancel = lock.withLock { () -> Bool in
-      if resolution != nil { return true }
-      self.operationTask = operationTask
-      self.timeoutTask = timeoutTask
-      return false
-    }
-    if shouldCancel {
-      operationTask.cancel()
-      timeoutTask.cancel()
-    }
-  }
-
-  func cancel() {
-    resolve(.failure(CancellationError()))
-  }
-
-  private func resolve(_ result: Result<Value, Error>) {
-    let completion = lock.withLock {
-      () -> (CheckedContinuation<Value, Error>?, Task<Void, Never>?, Task<Void, Never>?) in
-      guard resolution == nil else { return (nil, nil, nil) }
-      resolution = result
-      let completion = (continuation, operationTask, timeoutTask)
-      continuation = nil
-      operationTask = nil
-      timeoutTask = nil
-      return completion
-    }
-    completion.1?.cancel()
-    completion.2?.cancel()
-    completion.0?.resume(with: result)
-  }
-}
-
 private func withTimeout<Value: Sendable>(
   _ timeout: Duration,
   clock: any TunnelClock,
   operation: @escaping @Sendable () async throws -> Value
 ) async throws -> Value {
-  let race = LibSSH2TimeoutRace<Value>()
-  return try await withTaskCancellationHandler {
