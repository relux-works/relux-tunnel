+      configuration.trustRecordReference ?? SSHTrustRecordReference(rawValue: "fixture-trust")
+    ).acceptance(for: input)
+    return SSHSession(
+      identity: SSHSessionIdentity(
+        rawValue: UUID(uuidString: "20000000-0000-0000-0000-000000000001")!
