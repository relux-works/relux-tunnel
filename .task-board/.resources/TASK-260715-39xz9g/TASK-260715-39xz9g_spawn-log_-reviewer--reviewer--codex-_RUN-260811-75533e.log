   317	def serve_endpoint(connection: socket.socket, mode: str) -> EndpointResult:
   318	    if mode not in REQUIRED_ENDPOINTS:
   319	        raise FixtureError(f"unsupported endpoint mode {mode!r}")
   320	    digest = hashlib.sha256()
   321	    received = 0
   322	    if mode == "early-close":
   323	        connection.shutdown(socket.SHUT_WR)
   324	        while connection.recv(64 * 1024):
   325	            pass
   326	        return EndpointResult(0, f"SHA256:{digest.hexdigest()}")
   327	    if mode == "reset":
   328	        connection.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))
   329	        return EndpointResult(0, f"SHA256:{digest.hexdigest()}")
   330	
   331	    while True:
   332	        chunk = connection.recv(64 * 1024)
   333	        if not chunk:
   334	            break
   335	        received += len(chunk)
   336	        digest.update(chunk)
   337	        if mode == "disconnect":
   338	            break
   339	        if mode in {"echo", "half-close"}:
   340	            connection.sendall(chunk)
   341	        if mode == "half-close":
   342	            connection.shutdown(socket.SHUT_WR)
   343	            mode = "sink"
   344	    return EndpointResult(received, f"SHA256:{digest.hexdigest()}")
