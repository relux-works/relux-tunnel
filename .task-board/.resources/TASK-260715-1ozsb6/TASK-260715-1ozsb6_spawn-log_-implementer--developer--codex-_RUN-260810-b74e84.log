+      precondition(!started)
+      started = true
+      operationTask = Task {
+        let outcome: Result<Value, Error>
+        do {
+          outcome = .success(try await self.operation())
+        } catch {
+          outcome = .failure(error)
+        }
+        self.childCompleted(.operation, outcome: outcome)
+      }
+      timerTask = Task {
+        let outcome: Result<Value, Error>
