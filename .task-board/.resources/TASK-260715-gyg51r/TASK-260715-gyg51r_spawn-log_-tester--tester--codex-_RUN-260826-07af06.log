+final class MTUMatrixOutputTarget: @unchecked Sendable {
+  let directoryComponents: [String]
+  fileprivate let directoryIdentities: [MTUMatrixDirectoryIdentity]
+  let fileName: String
+  private var descriptors: [Int32]
+  private let lock = NSLock()
