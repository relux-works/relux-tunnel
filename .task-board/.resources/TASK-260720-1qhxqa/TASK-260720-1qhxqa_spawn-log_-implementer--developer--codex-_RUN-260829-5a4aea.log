   379	def array_field(block: str, field: str, row: str) -> str:
   380	    visible, code = swift_lexical_view(block, row)
   381	    matches = [
   382	        match
   383	        for match in re.finditer(rf"\b{re.escape(field)}\s*:\s*\[", visible)
   384	        if code[match.start()]
   385	    ]
   386	    if len(matches) != 1:
   387	        raise BindingError(row, f"expected exactly one {field} array, got {len(matches)}")
   388	    opening = visible.find("[", matches[0].start())
   389	    depth = 0
   390	    for index in range(opening, len(visible)):
   391	        if not code[index]:
   392	            continue
   393	        character = visible[index]
   394	        if character == "[":
   395	            depth += 1
   396	        elif character == "]":
   397	            depth -= 1
   398	            if depth == 0:
   399	                return visible[opening + 1 : index]
   400	    raise BindingError(row, f"unterminated {field} array")
