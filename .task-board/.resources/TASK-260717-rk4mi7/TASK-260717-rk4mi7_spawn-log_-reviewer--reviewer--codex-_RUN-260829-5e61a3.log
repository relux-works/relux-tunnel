   243	
   244	@MainActor
   245	private final class TestUpdater: ReluxUpdaterControlling {
   246	  var automaticallyChecksForUpdates = false
   247	  var updateCheckInterval: TimeInterval = 0
   248	  var selectedChannel: ReluxUpdateChannel = .stable
   249	  var canCheckForUpdates = true
   250	  private(set) var checkCount = 0
   251	  private(set) var resetCount = 0
   252	
   253	  func checkForUpdates() {
   254	    checkCount += 1
   255	  }
   256	
   257	  func resetUpdateCycle() {
   258	    resetCount += 1
   259	  }
   260	}
   261	
   262	@MainActor
   263	final class TestUpdateScheduler: ReluxUpdateScheduling {
   264	  private(set) var scheduledIntervals: [TimeInterval] = []
   265	  private(set) var cancelCount = 0
   266	
   267	  func scheduleAutomaticChecks(
   268	    every interval: TimeInterval,
   269	    using updater: any ReluxUpdaterControlling
   270	  ) {
   271	    scheduledIntervals.append(interval)
   272	    updater.updateCheckInterval = interval
   273	    updater.automaticallyChecksForUpdates = true
   274	    updater.resetUpdateCycle()
   275	  }
   276	
   277	  func cancelAutomaticChecks(using updater: any ReluxUpdaterControlling) {
   278	    cancelCount += 1
   279	    updater.automaticallyChecksForUpdates = false
   280	    updater.resetUpdateCycle()
   281	  }
   282	}

