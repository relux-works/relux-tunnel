{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c73d","stream":{"kind":"session","id":"01a0aa7a-9815-7302-a96f-7a8fde67c84b"},"sequence":505,"recorded_at":1780531400001005,"record_type":"event","durability":"durable","causation_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","run_stream":{"kind":"run","id":"7cb39f37-e5ea-43fc-a612-eaf97474622d"},"task_stream":{"kind":"task","id":"01a0aa7b-e6fa-7b62-afb0-75f60abb8edb"},"task_id":"01a0aa7b-e6fa-7b62-afb0-75f60abb8edb","event":{"kind":"output","task_id":"01a0aa7b-e6fa-7b62-afb0-75f60abb8edb","chunk":"Read text file `Tests/ReluxTunnelCoreTests/MacOSProductionRuntimeOwnershipTests.swift`.\n1|import Foundation\n2|import Testing\n3|\n4|@testable import ReluxTunnelCore\n5|@testable import ReluxTunnelMacOSAdapter\n6|@testable import ReluxTunnelNativeAdapter\n7|\n8|@Suite(\"macOS production runtime ownership\")\n9|struct MacOSProductionRuntimeOwnershipTests {\n10|  @Test(\"exact returned graph authenticates, activates after settings, and releases in reverse\")\n11|  func exactGraphLifecycle() async throws {\n12|    let trace = ProductionOwnershipTrace()\n13|    let runtimeConfiguration = ownershipRuntimeConfiguration()\n14|    let factory = MacOSProductionDependencyFactory(\n15|      bindingManifestSource: { ownershipManifestData() },\n16|      runtimeInputs: MacOSProductionRuntimeInputs(\n17|        diagnosticsWindow: .seconds(2),\n18|        virtualDNSEndpoints: [TunnelEndpoint(host: \"192.0.2.53\", port: 53)],\n19|        maximumPendingPrivateConnections: 8,\n20|        privateAuthenticationTimeoutMilliseconds: 1_000\n21|      ),\n22|      componentFactories: ownershipComponentFactories(\n23|        trace: trace,\n24|        runtimeConfiguration: runtimeConfiguration\n25|      ),\n26|      makeSelectedSSH: { _ in\n27|        trace.record(\"ssh.selection\")\n28|        return MacOSSelectedSSHDependencies(\n29|          transportFactory: OwnershipSSHTransportFactory(trace: trace),\n30|          credentialProvider: OwnershipCredentialProvider(trace: trace),\n31|          makeHostKeyPolicy: { _ in\n32|            trace.record(\"ssh.host-policy.create\")\n33|            return OwnershipHostPolicy(trace: trace)\n34|          },\n35|          mapCredentialError: {\n36|            MacOSSSHBootstrapErrorMapper.credential($0, configurationGeneration: $1)\n37|          }\n38|        )\n39|      },\n40|      makePacketBridge: { _, generation, _, _, _, _ in\n41|        trace.record(\"packet.prepare-owner\")\n42|        #expect(generation == 1)\n43|        return OwnershipPacketBridge(trace: trace)\n44|      }\n45|    )\n46|    let packetFlow = OwnershipPacketFlow(trace: trace)\n47|    let runtime = try await factory.makeRuntime(\n48|      context: ownershipRuntimeContext(packetFlow: packetFlow)\n49|    )\n50|\n51|    #expect(trace.count(\"packet.prepare-owner\") == 0)\n52|    #expect(trace.resourceAcquisitionCount == 0)\n53|\n54|    try await runtime.start()\n55|\n56|    let startup = trace.events\n57|    #expect(trace.count(\"ssh.transport.create\") == 1)\n58|    #expect(trace.count(\"ssh.host-policy.evaluate\") == 1)\n59|    #expect(trace.count(\"ssh.credential.lookup\") == 1)\n60|    #expect(trace.count(\"tcp.prepare\") == 1)\n61|    #expect(trace.count(\"dns.prepare\") == 1)\n62|    #expect(trace.count(\"packet.prepare-owner\") == 1)\n63|    #expect(trace.count(\"packet.descriptor\") == 1)\n64|    #expect(trace.count(\"packet.hev-lease\") == 1)\n65|    #expect(trace.count(\"packet.hev-thread\") == 1)\n66|    #expect(trace.count(\"packet.private-listener\") == 1)\n67|    #expect(trace.count(\"packet.read\") == 1)\n68|    #expect(\n69|      startup.firstIndex(of: \"settings.apply\")! < startup.firstIndex(of: \"packet.descriptor\")!)\n70|    #expect(\n71|      startup.firstIndex(of: \"packet.prepare-owner\")!\n72|        < startup.firstIndex(of: \"settings.apply\")!\n73|    )\n74|    #expect(\n75|      startup[startup.startIndex..<startup.firstIndex(of: \"settings.apply\")!]\n76|        .allSatisfy {\n77|          !$0.hasPrefix(\"packet.descriptor\") && !$0.hasPrefix(\"packet.hev-\")\n78|            && $0 != \"packet.private-listener\" && $0 != \"packet.read\"\n79|        }\n80|    )\n81|\n82|    await runtime.stop(reason: .userInitiated)\n83|    await runtime.stop(reason: .userInitiated)\n84|\n85|    let cleanup = trace.events\n86|    assertOrdered(\n87|      [\n88|        \"tcp.close-admission\", \"dns.close-admission\", \"packet.stop\", \"settings.clear\",\n89|        \"dns.stop\", \"tcp.stop\", \"ssh.transport.close\",\n90|      ],\n91|      in: cleanup\n92|    )\n93|    #expect(trace.count(\"packet.stop\") == 1)\n94|    #expect(trace.count(\"settings.clear\") == 1)\n95|    #expect(trace.count(\"dns.stop\") == 1)\n96|    #expect(trace.count(\"tcp.stop\") == 1)\n97|    #expect(trace.count(\"ssh.transport.close\") == 1)\n98|  }\n99|\n100|  private func assertOrdered(_ expected: [String], in actual: [String]) {\n101|    var previous = -1\n102|    for event in expected {\n103|      guard let index = actual.firstIndex(of: event) else {\n104|        Issue.record(\"missing lifecycle event: \\(event)\")\n105|        return\n106|      }\n107|      #expect(index > previous)\n108|      previous = index\n109|    }\n110|  }\n111|}\n112|\n113|private func ownershipComponentFactories(\n114|  trace: ProductionOwnershipTrace,\n115|  runtimeConfiguration: RuntimeConfigurationSnapshot\n116|) -> MacOSProductionComponentFactories {\n117|  MacOSProductionComponentFactories(\n118|    makeConfigurationSource: {\n119|      trace.record(\"configuration-source.create\")\n120|      return OwnershipConfigurationSource(\n121|        trace: trace,\n122|        configuration: runtimeConfiguration\n123|      )\n124|    },\n125|    makeSSHRuntimeServices: {\n126|      trace.record(\"ssh.services.create\")\n127|      return MacOSProductionSSHRuntimeServices(\n128|        profileSource: OwnershipProfileSource(trace: trace),\n129|        configurationBuilder: OwnershipSSHConfigurationBuilder(trace: trace),\n130|        resolver: OwnershipResolver(),\n131|        connector: OwnershipConnector(),\n132|        logger: OwnershipSSHLogger(),\n133|        observer: OwnershipSSHObserver(),\n134|        metrics: OwnershipSSHMetrics(),\n135|        identityGenerator: OwnershipIdentities()\n136|      )\n137|    },\n138|    makeTCPFactory: {\n139|      trace.record(\"tcp.factory.create\")\n140|      return OwnershipTCPFactory(trace: trace)\n141|    },\n142|    makeDNSFactory: {\n143|      trace.record(\"dns.factory.create\")\n144|      return OwnershipDNSFactory(trace: trace)\n145|    },\n146|    makePrivateIngressHandler: {\n147|      trace.record(\"packet.handler.create\")\n148|      return OwnershipPrivateIngressHandler()\n149|    },\n150|    makeSettingsPlanBuilder: {\n151|      trace.record(\"settings.builder.create\")\n152|      return OwnershipSettingsBuilder(trace: trace)\n153|    },\n154|    makeSettingsApplier: {\n155|      trace.record(\"settings.applier.create\")\n156|      return OwnershipSettingsApplier(trace: trace)\n157|    },\n158|    makeSnapshotStore: { OwnershipSnapshotStore() }\n159|  )\n160|}\n161|\n162|private final class ProductionOwnershipTrace: @unchecked Sendable {\n163|  private let lock = NSLock()\n164|  private var recorded: [String] = []\n165|\n166|  var events: [String] { lock.withLock { recorded } }\n167|\n168|  var resourceAcquisitionCount: Int {\n169|    lock.withLock {\n170|      recorded.count {\n171|        $0 == \"packet.descriptor\" || $0 == \"packet.hev-lease\"\n172|          || $0 == \"packet.hev-thread\" || $0 == \"packet.private-listener\"\n173|          || $0 == \"packet.read\"\n174|      }\n175|    }\n176|  }\n177|\n178|  func record(_ event: String) { lock.withLock { recorded.append(event) } }\n179|  func count(_ event: String) -> Int { lock.withLock { recorded.count { $0 == event } } }\n180|}\n181|\n182|private struct OwnershipConfigurationSource: ConfigurationSnapshotSource {\n183|  let trace: ProductionOwnershipTrace\n184|  let configuration: RuntimeConfigurationSnapshot\n185|\n186|  func loadValidatedSnapshot(\n187|    for reference: TunnelConfigurationReference\n188|  ) async throws -> RuntimeConfigurationSnapshot {\n189|    trace.record(\"configuration.load\")\n190|    return configuration\n191|  }\n192|}\n193|\n194|private struct OwnershipProfileSource: MacOSProductionSSHProfileSource {\n195|  let trace: ProductionOwnershipTrace\n196|\n197|  func loadProfile(\n198|    for configuration: RuntimeConfigurationSnapshot\n199|  ) async throws -> SSHProfileSnapshotV1 {\n200|    trace.record(\"ssh.profile.load\")\n201|    return ownershipProfile(configuration: configuration)\n202|  }\n203|}\n204|\n205|private struct OwnershipSSHConfigurationBuilder:\n206|  MacOSProductionSSHConnectionConfigurationBuilding\n207|{\n208|  let trace: ProductionOwnershipTrace\n209|\n210|  func makeConnectionConfiguration(\n211|    profile: SSHProfileSnapshotV1,\n212|    runtimeConfiguration: RuntimeConfigurationSnapshot,\n213|    capabilities: SSHAdapterCapabilities\n214|  ) throws -> SSHConnectionConfiguration {\n215|    trace.record(\"ssh.configuration.build\")\n216|    return try SSHConnectionConfiguration(\n217|      canonicalHostname: profile.canonicalHost.value,\n218|      endpoint: TunnelEndpoint(host: profile.canonicalHost.value, port: profile.port),\n219|      username: profile.account,\n220|      profileReference: TunnelConfigurationReference(\n221|        profileIdentifier: runtimeConfiguration.profileIdentifier\n222|      ),\n223|      credentialReference: SSHCredentialReference(\n224|        rawValue: profile.credential.reference.rawValue.uuidString.lowercased()\n225|      ),\n226|      credentialGeneration: profile.credential.generation,\n227|      trustRecordReference: SSHTrustRecordReference(\n228|        rawValue: runtimeConfiguration.trustReference.rawValue.uuidString.lowercased()\n229|      ),\n230|      algorithms: SSHAlgorithmPolicy(\n231|        keyExchange: [\"curve25519-sha256\"],\n232|        hostKey: [\"ssh-ed25519\"],\n233|        cipher: [\"aes256-ctr\"],\n234|        mac: [\"hmac-sha2-256\"]\n235|      ),\n236|      timeouts: try ownershipTimeouts(),\n237|      rekey: SSHRekeyPolicy(\n238|        protectedByteThresholdPerDirection: 4_096,\n239|        elapsedTimeThreshold: .milliseconds(100),\n240|        timeout: .seconds(10)\n241|      ),\n242|      keepalive: SSHKeepalivePolicy(\n243|        interval: .seconds(60),\n244|        replyTimeout: .seconds(10),\n245|        allowedConsecutiveMisses: 1\n246|      )\n247|    )\n248|  }\n249|}\n250|\n251|private struct OwnershipSSHTransportFactory: SSHTransportFactory {\n252|  let trace: ProductionOwnershipTrace\n253|  let capabilities = ownershipCapabilities()\n254|\n255|  func makeTransport(\n256|    lane: SSHLaneIdentity,\n257|    dependencies: SSHTransportDependencies\n258|  ) async throws -> any SSHTransport {\n259|    trace.record(\"ssh.transport.create\")\n260|    return OwnershipSSHTransport(\n261|      trace: trace,\n262|      lane: lane,\n263|      dependencies: dependencies\n264|    )\n265|  }\n266|}\n267|\n268|private actor OwnershipSSHTransport: SSHTransport {\n269|  let trace: ProductionOwnershipTrace\n270|  let lane: SSHLaneIdentity\n271|  let dependencies: SSHTransportDependencies\n272|  var closed = false\n273|\n274|  init(\n275|    trace: ProductionOwnershipTrace,\n276|    lane: SSHLaneIdentity,\n277|    dependencies: SSHTransportDependencies\n278|  ) {\n279|    self.trace = trace\n280|    self.lane = lane\n281|    self.dependencies = dependencies\n282|  }\n283|\n284|  func connect(configuration: SSHConnectionConfiguration) async throws -> SSHSession {\n285|    trace.record(\"ssh.transport.connect\")\n286|    let evidence = try SSHHostKeyEvidence(algorithm: \"ssh-ed25519\", keyBytes: Data([1]))\n287|    let input = SSHHostKeyPolicyInput(\n288|      canonicalHostname: configuration.canonicalHostname,\n289|      connectedEndpoint: configuration.endpoint,\n290|      evidence: evidence,\n291|      lane: lane,\n292|      trustRecordReference: configuration.trustRecordReference\n293|    )\n294|    let decision = try await dependencies.hostKeyPolicy.evaluate(input)\n295|    let acceptance = try decision.acceptance(for: input)\n296|    let credential = try await dependencies.credentialProvider.credential(\n297|      for: SSHCredentialRequest(\n298|        credentialReference: configuration.credentialReference,\n299|        credentialGeneration: configuration.credentialGeneration,\n300|        username: configuration.username,\n301|        allowedPublicKeyAlgorithms: [\"ssh-ed25519\"],\n302|        acceptedHost: acceptance\n303|      )\n304|    )\n305|    credential.retire()\n306|    trace.record(\"ssh.transport.ready\")\n307|    return SSHSession(\n308|      identity: dependencies.identityGenerator.makeSessionIdentity(),\n309|      acceptedHost: acceptance,\n310|      negotiatedAlgorithms: ownershipNegotiatedAlgorithms(),\n311|      keyExchangeGeneration: .unsupported\n312|    )\n313|  }\n314|\n315|  func openDirectTCPIP(\n316|    destination: TunnelEndpoint,\n317|    originator: TunnelEndpoint,\n318|    policy: SSHChannelPolicy\n319|  ) async throws -> any SSHByteChannel { throw OwnershipError.notUsed }\n320|\n321|  func openExecChannel(\n322|    request: SSHExecRequest,\n323|    policy: SSHChannelPolicy\n324|  ) async throws -> any SSHExecChannel { throw OwnershipError.notUsed }\n325|\n326|  func upload(_ request: SSHExecUploadRequest) async throws -> SSHExecExit {\n327|    throw OwnershipError.notUsed\n328|  }\n329|\n330|  func requestRekey(reason: SSHClientRekeyReason) async throws {}\n331|  func sendKeepalive() async throws -> SSHDeferredSemanticReport<Duration> { .unsupported }\n332|  func snapshot() async -> SSHTransportSnapshot { ownershipTransportSnapshot(lane: lane) }\n333|\n334|  func close() async {\n335|    guard !closed else { return }\n336|    closed = true\n337|    trace.record(\"ssh.transport.close\")\n338|  }\n339|}\n340|\n341|private struct OwnershipHostPolicy: SSHHostKeyPolicy {\n342|  let trace: ProductionOwnershipTrace\n343|\n344|  func evaluate(_ input: SSHHostKeyPolicyInput) async throws -> SSHHostKeyDecision {\n345|    trace.record(\"ssh.host-policy.evaluate\")\n346|    return .acceptMatch(\n347|      input.trustRecordReference\n348|        ?? SSHTrustRecordReference(rawValue: \"missing-trust-reference\")\n349|    )\n350|  }\n351|}\n352|\n353|private struct OwnershipCredentialProvider: SSHCredentialProvider {\n354|  let trace: ProductionOwnershipTrace\n355|\n356|  func credential(for request: SSHCredentialRequest) async throws\n357|    -> any SSHPublicKeyCredential\n358|  {\n359|    trace.record(\"ssh.credential.lookup\")\n360|    return OwnershipCredential()\n361|  }\n362|}\n363|\n364|private struct OwnershipCredential: SSHPublicKeyCredential {\n365|  let algorithm = \"ssh-ed25519\"\n366|  let publicKeyBytes = Data([1])\n367|  func sign(_ payload: Data) async throws -> Data { Data([2]) }\n368|}\n369|\n370|private struct OwnershipTCPFactory: TCPConsumerFactory {\n371|  let trace: ProductionOwnershipTrace\n372|\n373|  func prepare(\n374|    session: any SSHBootstrapSession,\n375|    runtimeGeneration: UInt64,\n376|    healthSink: any TunnelRuntimeHealthEventSink\n377|  ) async throws -> any TCPConsumer {\n378|    guard session is any M1SSHChannelSession else { throw OwnershipError.wrongSSHSession }\n379|    trace.record(\"tcp.prepare\")\n380|    return OwnershipTCPConsumer(trace: trace)\n381|  }\n382|}\n383|\n384|private final class OwnershipTCPConsumer: M1TCPIngressConsumer, @unchecked Sendable {\n385|  let trace: ProductionOwnershipTrace\n386|  init(trace: ProductionOwnershipTrace) { self.trace = trace }\n387|  func openTCP(destination: TunnelEndpoint, originator: TunnelEndpoint) async throws\n388|    -> any SSHByteChannel\n389|  { throw OwnershipError.notUsed }\n390|  func closeAdmission() async { trace.record(\"tcp.close-admission\") }\n391|  func stop() async { trace.record(\"tcp.stop\") }\n392|  func health() async -> TunnelRuntimeComponentHealth { .healthy }\n393|}\n394|\n395|private struct OwnershipDNSFactory: DNSConsumerFactory {\n396|  let trace: ProductionOwnershipTrace\n397|\n398|  func prepareSafeDNS(\n399|    session: any SSHBootstrapSession,\n400|    runtimeGeneration: UInt64,\n401|    healthSink: any TunnelRuntimeHealthEventSink\n402|  ) async throws -> any DNSConsumer {\n403|    guard session is any M1SSHChannelSession else { throw OwnershipError.wrongSSHSession }\n404|    trace.record(\"dns.prepare\")\n405|    return OwnershipDNSConsumer(trace: trace)\n406|  }\n407|}\n408|\n409|private final class OwnershipDNSConsumer: M1DNSIngressConsumer, @unchecked Sendable {\n410|  let trace: ProductionOwnershipTrace\n411|  init(trace: ProductionOwnershipTrace) { self.trace = trace }\n412|  func openTCP(destination: TunnelEndpoint, originator: TunnelEndpoint) async throws\n413|    -> any SSHByteChannel\n414|  { throw OwnershipError.notUsed }\n415|  func exchangeUDP(\n416|    _ query: Data,\n417|    destination: TunnelEndpoint,\n418|    originator: TunnelEndpoint\n419|  ) async throws -> Data { throw OwnershipError.notUsed }\n420|  func closeAdmission() async { trace.record(\"dns.close-admission\") }\n421|  func stop() async { trace.record(\"dns.stop\") }\n422|  func health() async -> TunnelRuntimeComponentHealth { .healthy }\n423|}\n424|\n425|private final class OwnershipPacketBridge: PacketBridge, @unchecked Sendable {\n426|  let trace: ProductionOwnershipTrace\n427|  private let lock = NSLock()\n428|  private var stopped = false\n429|\n430|  init(trace: ProductionOwnershipTrace) { self.trace = trace }\n431|\n432|  func start(\n433|    packetFlow: any PacketFlow,\n434|    configuration: PacketBridgeConfiguration\n435|  ) async throws -> PacketFlowBridgeRunHandle {\n436|    trace.record(\"packet.descriptor\")\n437|    trace.record(\"packet.private-listener\")\n438|    trace.record(\"packet.hev-lease\")\n439|    trace.record(\"packet.hev-thread\")\n440|    _ = try await packetFlow.readPackets()\n441|    return PacketFlowBridgeRunHandle(completion: PacketBridgeRunCompletion())\n442|  }\n443|\n444|  func stop() async {\n445|    let shouldRecord = lock.withLock { () -> Bool in\n446|      guard !stopped else { return false }\n447|      stopped = true\n448|      return true\n449|    }\n450|    if shouldRecord { trace.record(\"packet.stop\") }\n451|  }\n452|\n453|  func metrics() async -> TunnelMetricsSnapshot {\n454|    TunnelMetricsSnapshot(schemaVersion: 1, counters: [:], gauges: [:])\n455|  }\n456|}\n457|\n458|private final class OwnershipPacketFlow: PacketFlow, @unchecked Sendable {\n459|  let trace: ProductionOwnershipTrace\n460|  init(trace: ProductionOwnershipTrace) { self.trace = trace }\n461|  func readPackets() async throws -> PacketReadBatch {\n462|    trace.record(\"packet.read\")\n463|    return PacketReadBatch(results: [])\n464|  }\n465|  func writePackets(_ packets: [TunnelPacket]) async throws {}\n466|}\n467|\n468|private struct OwnershipSettingsPlan: NetworkSettingsPlan {}\n469|\n470|private struct OwnershipSettingsBuilder: NetworkSettingsPlanBuilder {\n471|  let trace: ProductionOwnershipTrace\n472|  func makePlan(\n473|    configuration: RuntimeConfigurationSnapshot,\n474|    connectedEndpoint: TunnelEndpoint,\n475|    runtimeGeneration: UInt64\n476|  ) throws -> any NetworkSettingsPlan {\n477|    trace.record(\"settings.plan\")\n478|    return OwnershipSettingsPlan()\n479|  }\n480|}\n481|\n482|private struct OwnershipSettingsApplier: NetworkSettingsApplier {\n483|  let trace: ProductionOwnershipTrace\n484|  func apply(_ plan: any NetworkSettingsPlan, runtimeGeneration: UInt64) async throws {\n485|    trace.record(\"settings.apply\")\n486|  }\n487|  func clear(runtimeGeneration: UInt64) async throws { trace.record(\"settings.clear\") }\n488|}\n489|\n490|private struct OwnershipSnapshotStore: RuntimeSnapshotStore {\n491|  func publish(_ snapshot: TunnelRuntimePublishedSnapshot) async {}\n492|}\n493|\n494|private struct OwnershipPrivateIngressHandler: M1HEVAuthenticatedConnectionHandler {\n495|  func acceptAuthenticatedConnection(\n496|    _ channel: HEVSOCKSChannel,\n497|    ingress: any M1PrivateIngressDispatching\n498|  ) {\n499|    channel.close()\n500|  }\n(more lines below)","final_result":true}}}
