   649	public enum SSHProfileProviderConfigurationCodec {
   650	  public static let maximumEnvelopeBytes = RuntimeMessageSizeLimit.providerConfiguration
   651	
   652	  public static func encode(
   653	    _ snapshot: SSHProfileSnapshotV1
   654	  ) throws -> [String: VPNProviderConfigurationValue] {
   655	    let data = try SSHProfileSnapshotCodec.encode(snapshot)
   656	    let configuration: [String: VPNProviderConfigurationValue] = [
   657	      OwnedVPNManagerRepository.ownerKey: .string(OwnedVPNManagerRepository.ownerValue),
   658	      OwnedVPNManagerRepository.managerContractKey: .integer(
   659	        OwnedVPNManagerRepository.managerContractVersion
   660	      ),
   661	      OwnedVPNManagerRepository.configurationReferenceKey: .data(data),
   662	    ]
   663	    guard try envelopeSize(configuration) <= maximumEnvelopeBytes else {
   664	      throw SSHProfileSnapshotLoaderError.profileOversize
   665	    }
   666	    return configuration
   667	  }
   668	
   669	  public static func decode(
   670	    _ configuration: [String: VPNProviderConfigurationValue]?
   671	  ) throws -> SSHProfileSnapshotV1 {
   672	    try decodeCapture(configuration).snapshot
   673	  }
   674	
   675	  public static func envelopeSize(
   676	    _ configuration: [String: VPNProviderConfigurationValue]
   677	  ) throws -> Int {
   678	    let propertyList = try exactPropertyList(configuration)
   679	    do {
   680	      return try PropertyListSerialization.data(
   681	        fromPropertyList: propertyList,
   682	        format: .binary,
   683	        options: 0
   684	      ).count
   685	    } catch {
   686	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   687	    }
   688	  }
   689	
   690	  static func decodeCapture(
   691	    _ configuration: [String: VPNProviderConfigurationValue]?
   692	  ) throws -> (snapshot: SSHProfileSnapshotV1, data: Data) {
   693	    guard let configuration else {
   694	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   695	    }
   696	    let propertyList = try exactPropertyList(configuration)
   697	    guard
   698	      case .data(let data) = configuration[
   699	        OwnedVPNManagerRepository.configurationReferenceKey
   700	      ]
   701	    else {
   702	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   703	    }
   704	    guard data.count <= maximumEnvelopeBytes else {
   705	      throw SSHProfileSnapshotLoaderError.profileOversize
   706	    }
   707	    do {
   708	      let envelope = try PropertyListSerialization.data(
   709	        fromPropertyList: propertyList,
   710	        format: .binary,
   711	        options: 0
   712	      )
   713	      guard envelope.count <= maximumEnvelopeBytes else {
   714	        throw SSHProfileSnapshotLoaderError.profileOversize
   715	      }
   716	    } catch let error as SSHProfileSnapshotLoaderError {
   717	      throw error
   718	    } catch {
   719	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   720	    }
   721	    return (try SSHProfileSnapshotCodec.decode(data), data)
   722	  }
   723	
   724	  private static func exactPropertyList(
   725	    _ configuration: [String: VPNProviderConfigurationValue]
   726	  ) throws -> [String: Any] {
   727	    let requiredKeys: Set<String> = [
   728	      OwnedVPNManagerRepository.ownerKey,
   729	      OwnedVPNManagerRepository.managerContractKey,
   730	      OwnedVPNManagerRepository.configurationReferenceKey,
   731	    ]
   732	    guard Set(configuration.keys) == requiredKeys,
   733	      configuration[OwnedVPNManagerRepository.ownerKey]
   734	        == .string(OwnedVPNManagerRepository.ownerValue)
   735	    else {
   736	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   737	    }
   738	    guard
   739	      case .integer(let managerVersion)? = configuration[
   740	        OwnedVPNManagerRepository.managerContractKey
   741	      ]
   742	    else {
   743	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   744	    }
   745	    guard managerVersion == OwnedVPNManagerRepository.managerContractVersion else {
   746	      throw SSHProfileSnapshotLoaderError.profileVersionUnsupported
   747	    }
   748	    guard
   749	      case .data(let data)? = configuration[
   750	        OwnedVPNManagerRepository.configurationReferenceKey
   751	      ]
   752	    else {
   753	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   754	    }
   755	    return [
   756	      OwnedVPNManagerRepository.ownerKey: OwnedVPNManagerRepository.ownerValue,
   757	      OwnedVPNManagerRepository.managerContractKey: NSNumber(
   758	        value: OwnedVPNManagerRepository.managerContractVersion
   759	      ),
   760	      OwnedVPNManagerRepository.configurationReferenceKey: data,
   761	    ]
   762	  }
   763	}
