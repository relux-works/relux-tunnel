   527	  public func requestRekey(reason: SSHClientRekeyReason) async throws {
   528	    guard state == .ready || state == .rekeying, !closeRequested, let configuration else {
   529	      throw transportError(code: .invalidState, phase: .rekey)
   530	    }
   531	    guard rekeyWaiters.count < 1_024 else {
   532	      throw transportError(code: .resourceLimitExceeded, phase: .rekey, scope: .operation)
   533	    }
   534	    let waiter = LibSSH2OperationWaiter()
   535	    rekeyWaiters[waiter.identifier] = waiter
   536	    rekeyReasons.insert(.client(reason))
   537	    incrementRekeyCounter(reason)
   538	    if rekeyFlightTask == nil {
   539	      let now = dependencies.clock.now()
   540	      let explicitDeadline = now.advanced(by: configuration.timeouts.explicitRekey)
   541	      let rekeyDeadline = now.advanced(by: configuration.rekey.timeout)
   542	      let deadline = min(explicitDeadline, rekeyDeadline)
   543	      rekeyFlightDeadline = deadline
   544	      rekeyFlightTask = Task { [weak self] in
   545	        guard let self else { return }
   546	        await self.runRekeyFlight(until: deadline)
   547	      }
   548	    }
   549	    do {
   550	      guard let deadline = rekeyFlightDeadline else {
   551	        throw transportError(code: .invalidState, phase: .rekey, scope: .operation)
   552	      }
   553	      let now = dependencies.clock.now()
   554	      guard now < deadline else { throw LibSSH2TimeoutError.elapsed }
   555	      try await withTimeout(now.duration(to: deadline), clock: dependencies.clock) {
   556	        try await waiter.wait()
   557	      }
   558	    } catch {
   559	      rekeyWaiters.removeValue(forKey: waiter.identifier)
   560	      let mapped =
   561	        if error is CancellationError {
   562	          transportError(code: .cancelled, phase: .rekey, scope: .operation)
   563	        } else if error is LibSSH2TimeoutError {
   564	          transportError(code: .timedOut, phase: .rekey, scope: .operation)
   565	        } else {
   566	          map(error, phase: .rekey, fallback: .rekeyFailed, scope: .operation)
   567	        }
   568	      await recordTerminalOperation(mapped)
   569	      throw mapped
   570	    }
   571	  }
   572	
   573	  private func runRekeyFlight(until deadline: ContinuousClock.Instant) async {
   574	    var permit: LibSSH2SessionOperationPermit?
   575	    do {
   576	      permit = try await beginSessionOperation(phase: .rekey, until: deadline)
   577	      try await performRequestRekey(until: deadline)
   578	      if let permit { finishSessionOperation(permit) }
   579	      finishRekeyFlight(with: .success(()))
   580	    } catch {
   581	      if let permit { finishSessionOperation(permit) }
   582	      let mapped = map(error, phase: .rekey, fallback: .rekeyFailed)
   583	      await recordTerminalOperation(mapped)
   584	      if state != .failed, state != .closing, state != .closed {
   585	        try? await transition(to: .failed)
   586	      }
   587	      await tearDown()
   588	      finishRekeyFlight(with: .failure(mapped))
   589	    }
   590	  }
   591	
   592	  private func finishRekeyFlight(with result: Result<Void, Error>) {
   593	    let waiters = Array(rekeyWaiters.values)
   594	    rekeyWaiters.removeAll(keepingCapacity: false)
   595	    rekeyReasons.removeAll(keepingCapacity: false)
   596	    rekeyFlightTask = nil
   597	    rekeyFlightDeadline = nil
   598	    for waiter in waiters { waiter.complete(with: result) }
   599	  }
   600	
   601	  private func performRequestRekey(until deadline: ContinuousClock.Instant) async throws {
   602	    guard state == .ready else {
   603	      throw transportError(code: .invalidState, phase: .rekey)
   604	    }
   605	    await emit(.rekeyTriggered(rekeyReasons))
   606	    try await transition(to: .rekeying)
   607	    await emit(.rekeyStarted(reasons: rekeyReasons, generation: counters.rekeysSucceeded + 1))
   608	    do {
   609	      while true {
   610	        try checkCancellation(phase: .rekey)
   611	        guard state == .rekeying, let engineSession else {
   612	          throw transportError(code: .cancelled, phase: .rekey)
   613	        }
   614	        let result = libssh2_session_rekey(engineSession)
   615	        if result == 0 { break }
   616	        guard result == LIBSSH2_ERROR_EAGAIN else {
   617	          throw engineError(result, phase: .rekey, fallback: .rekeyFailed)
   618	        }
   619	        try await progress(until: deadline, phase: .rekey)
   620	      }
   621	      counters.rekeysSucceeded += 1
   622	      rekeySentBytesBaseline = counters.protectedBytesSent
   623	      rekeyReceivedBytesBaseline = counters.protectedBytesReceived
   624	      await metric(.increment(.rekeysSucceeded, by: 1))
   625	      await emit(.rekeySucceeded(reasons: rekeyReasons, generation: counters.rekeysSucceeded))
   626	      try await transition(to: .ready)
   627	    } catch {
   628	      counters.rekeysFailed += 1
   629	      await metric(.increment(.rekeysFailed, by: 1))
   630	      await emit(
   631	        .rekeyFailed(
   632	          reasons: rekeyReasons,
   633	          generation: counters.rekeysSucceeded + 1,
   634	          code: .rekeyFailed
   635	        )
   636	      )
   637	      throw map(error, phase: .rekey, fallback: .rekeyFailed)
   638	    }
   639	  }
