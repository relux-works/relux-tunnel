   298	/// One generation-scoped update handle.
   299	///
   300	/// A handle from an older generation becomes a no-op after the store advances,
   301	/// preventing late packet or SSH callbacks from contaminating the next run.
   302	public final class RuntimeDiagnosticsRecorder: @unchecked Sendable, TunnelMetrics,
   303	  SSHTransportMetricsSink
   304	{
   305	  public let runtimeGeneration: UInt64
   306	
   307	  private let store: RuntimeDiagnosticsStore
