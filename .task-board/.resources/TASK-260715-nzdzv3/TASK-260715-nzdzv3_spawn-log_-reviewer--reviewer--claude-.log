делает коллизию вероятной именно под bulk-трафиком туннеля. Адаптер обязан гейтить/очередить записи по `rekeySnapshot.keyExchangeInProgress` и событиям started/succeeded — форк даёт ровно эту observability.\n2. Footgun конфига: `windowAdjustmentThreshold > initialWindowSize` проходит preconditions, но никогда не сработает — канал навсегда встанет без WINDOW_ADJUST; и remaining credit никогда не растёт выше `initialWindowSize`, даже если cap больше. Политика адаптера должна держать threshold ≤ initial.\n\nНа борде: нота с вердиктом, ревью-отчёт как outcome resource, чеклист закрыт, статус `done`. Коммиты не делал — по правилам их оставляем человеку (в `RELUX_DELTA.md` готова последовательность из четырёх логических коммитов).","stop_reason":"end_turn","session_id":"0875ddfe-adf4-4523-939a-8351fe99ffce","total_cost_usd":8.057576,"usage":{"input_tokens":62,"cache_creation_input_tokens":134798,"cache_read_input_tokens":3695519,"output_tokens":33077,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":134798,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":1237,"cache_read_input_tokens":149355,"cache_creation_input_tokens":548,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":548},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":11537,"outputTokens":18,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"webSearchRequests":0,"costUSD":0.011627,"contextWindow":200000,"maxOutputTokens":32000},"claude-fable-5":{"inputTokens":62,"outputTokens":33077,"cacheReadInputTokens":3695519,"cacheCreationInputTokens":134798,"webSearchRequests":0,"costUSD":8.045948999999998,"contextWindow":1000000,"maxOutputTokens":64000}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","uuid":"d994042a-3e0e-42a1-8a9e-6979ccbc1c44"}
