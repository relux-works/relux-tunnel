+		--libssh2-archive "$(LIBSSH2_SOURCE_ARCHIVE)" \
+		--openssl-archive "$(OPENSSL_SOURCE_ARCHIVE)" \
+		--output NativeDependencies/Artifacts/ReluxLibSSH2.xcframework
+
+validate-libssh2: check-libssh2 test-libssh2
