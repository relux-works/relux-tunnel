  @Test("invalid snapshots stop before fake Keychain and network boundaries")
  func invalidSnapshotsHaveNoDownstreamAccess() throws {
    let validData = try SSHProfileSnapshotCodec.encode(fixture())
    let invalidPayloads = try [
      mutateJSON(validData) { $0["configurationGeneration"] = 0 },
      mutateJSON(validData) { $0["canonicalHost"] = ["kind": "dns", "value": "Bad.invalid"] },
      mutateJSON(validData) { $0["schemaVersion"] = 2 },
      mutateJSON(validData) { $0["privateKeyMaterial"] = "synthetic-key-fixture" },
    ]

    for payload in invalidPayloads {
      var configuration = try SSHProfileProviderConfigurationCodec.encode(fixture())
      configuration[OwnedVPNManagerRepository.configurationReferenceKey] = .data(payload)
      let access = ProfileDownstreamAccessProbe()

      #expect(throws: SSHProfileSnapshotLoaderError.self) {
        try captureThenAccess(configuration, probe: access)
      }
      #expect(access.keychainCalls == 0)
      #expect(access.networkCalls == 0)
    }

    let access = ProfileDownstreamAccessProbe()
    try captureThenAccess(
      SSHProfileProviderConfigurationCodec.encode(fixture()),
      probe: access
    )
    #expect(access.keychainCalls == 1)
    #expect(access.networkCalls == 1)
  }

  @Test("recursive prohibited fields reject and secret bytes are unrepresentable")
  func prohibitedFieldsAndPrivacy() throws {
    let snapshot = fixture()
    let validData = try SSHProfileSnapshotCodec.encode(snapshot)
    let validText = String(decoding: validData, as: UTF8.self).lowercased()
    for prohibited in ["privatekey", "private_key", "passphrase", "password", "rawhostkey"] {
      #expect(!validText.contains(prohibited))
    }
    #expect(!containsData(snapshot))

    let prohibitedFixtures = [
      "privateKeyMaterial",
      "PASSWORD-VALUE",
      "passphraseBytes",
      "privateKeyData",
      "Seed.Bytes",
      "decrypted_private-key",
      "rawHostKeyData",
      "STAGING.CREDENTIAL_payload",
      "key-bytes-payload",
    ]
    for (index, field) in prohibitedFixtures.enumerated() {
      let data = try mutateJSON(validData) { object in
        switch index % 3 {
        case 0:
          object[field] = "redacted-fixture"
        case 1:
          object["future"] = ["nested": [field: "redacted-fixture"]]
        default:
          object["future"] = [["nested": [[field: "redacted-fixture"]]]]
        }
      }
      #expect(throws: SSHProfileSnapshotLoaderError.profileContainsProhibitedField) {
        try SSHProfileSnapshotCodec.decode(data)
      }
    }

    let error = SSHProfileSnapshotLoaderError.profileContainsProhibitedField
    #expect(
      String(reflecting: error)
        == "ReluxTunnelCore.SSHProfileSnapshotLoaderError.profileContainsProhibitedField")
  }

