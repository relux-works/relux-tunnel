  1337	private func maximumDrawup(_ samples: [UInt64]) -> UInt64 {
  1338	  guard var runningMinimum = samples.first else { return 0 }
  1339	  var maximum: UInt64 = 0
  1340	  for sample in samples.dropFirst() {
  1341	    runningMinimum = min(runningMinimum, sample)
  1342	    maximum = max(maximum, sample - runningMinimum)
  1343	  }
  1344	  return maximum
  1345	}
