+// swift-tools-version: 6.2
+import PackageDescription
+
+let package = Package(
+  name: "ReluxProfileLoaderReview",
+  platforms: [.macOS(.v15)],
+  dependencies: [.package(path: "/Users/iv/Developer/relux-tunnel")],
