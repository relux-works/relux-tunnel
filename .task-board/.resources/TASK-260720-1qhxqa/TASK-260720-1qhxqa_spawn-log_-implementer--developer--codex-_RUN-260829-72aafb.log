+
+def project_folder_resources(project: str, block: str, row: str) -> list[str]:
+    resources: list[str] = []
+    pattern = re.compile(r"\.folderReference\s*\(\s*path:\s*([A-Za-z_][A-Za-z0-9_]*)\s*\)")
