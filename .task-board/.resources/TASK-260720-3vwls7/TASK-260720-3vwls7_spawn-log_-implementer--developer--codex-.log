+def verify_artifact(item: dict[str, Any]) -> None:
+    verify_patch_manifest(item)
+    verify_xcode_build(item)
+    artifact = REPOSITORY_ROOT / item["integration"]["artifact_path"]
+    run(
+        [
+            str(REPOSITORY_ROOT / "scripts" / "native-dependency-tool.py"),
+            "inspect",
+            "--dependency",
+            DEPENDENCY_NAME,
+            "--xcframework",
