    'same production entry point', 'none may depend on Linux runner availability',
    'Every successor check required by the macOS',
]
for token in required:
    assert token in flat, token
for target in re.findall(r'\\]\\((\\.\\.?/["'^)]+)'"\\)', text):
    assert (p.parent / target).resolve().exists(), target

def accepts(payload):
    return (
        payload.get('valid') is True
        and isinstance(payload.get('errors'), list)
        and not payload['errors']
        and isinstance(payload.get('warnings'), list)
        and not payload['warnings']
