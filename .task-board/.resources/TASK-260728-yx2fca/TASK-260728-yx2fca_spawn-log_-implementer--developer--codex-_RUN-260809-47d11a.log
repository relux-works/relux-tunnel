  public let name: SSHExecSignalName
  public let coreDumped: SSHDeferredSemanticReport<Bool>

  public init(name: SSHExecSignalName, coreDumped: SSHDeferredSemanticReport<Bool>) {
    self.name = name
    self.coreDumped = coreDumped
  }
}

