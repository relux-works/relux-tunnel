   879	  public init(
   880	    initialReceiveWindowBytes: Int,
   881	    consumerReceiveWindowCredit: SSHDeferredSemanticReport<SSHConsumerReceiveWindowPolicy>,
   882	    maximumBufferedReadBytes: Int,
   883	    maximumQueuedWriteBytes: Int,
   884	    maximumWriteCallBytes: Int
   885	  ) throws {
   886	    let positiveValues: [(Int, SSHValidationField)] = [
   887	      (initialReceiveWindowBytes, .initialReceiveWindowBytes),
   888	      (maximumBufferedReadBytes, .maximumBufferedReadBytes),
   889	      (maximumQueuedWriteBytes, .maximumQueuedWriteBytes),
   890	      (maximumWriteCallBytes, .maximumWriteCallBytes),
   891	    ]
   892	    for (value, field) in positiveValues where value <= 0 {
   893	      throw SSHContractValidationError.nonPositive(field)
   894	    }
   895	    if case .reported(let policy) = consumerReceiveWindowCredit,
   896	      policy.initialReceiveWindowBytes != initialReceiveWindowBytes
   897	    {
   898	      throw SSHContractValidationError.initialReceiveWindowPolicyMismatch
   899	    }
   900	    self.initialReceiveWindowBytes = initialReceiveWindowBytes
   901	    self.consumerReceiveWindowCredit = consumerReceiveWindowCredit
   902	    self.maximumBufferedReadBytes = maximumBufferedReadBytes
   903	    self.maximumQueuedWriteBytes = maximumQueuedWriteBytes
   904	    self.maximumWriteCallBytes = maximumWriteCallBytes
   905	  }
   906	}
