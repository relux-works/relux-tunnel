   622	  private func startGeneration(configuration: TunnelConfiguration) async throws {
   623	    guard phase == .idle, !awaitingSystemStopAfterProviderFailure else {
   624	      throw ProviderAdapterError.lifecycleBusy(phase)
   625	    }
   626	    guard latestGeneration < UInt64.max else {
   627	      throw ProviderAdapterError.generationExhausted
   628	    }
   629	
   630	    latestGeneration += 1
   631	    let generation = latestGeneration
   632	    failureAdmission.releaseForNewGeneration()
   633	    let registry = ProviderCleanupRegistry()
   634	    if let controllable = packetFlow as? any ProviderCleanupControllable {
   635	      registry.register(controllable)
   636	    }
   637	    activeGeneration = ActiveGeneration(
   638	      identifier: generation,
   639	      cleanupRegistry: registry,
   640	      retirementSignal: ProviderRetirementSignal(),
   641	      runtime: nil
   642	    )
   643	    resetRequestLedger(for: generation)
   644	    phase = .starting
   645	
   646	    let context = TunnelRuntimeContext(
   647	      configuration: configuration,
   648	      packetFlow: packetFlow,
   649	      dependencies: dependencies,
   650	      cleanupRegistry: registry
   651	    )
   652	    let operation = Task { [runtimeFactory, weak self] () -> StartRaceResult in
   653	      do {
   654	        let runtime = try await runtimeFactory.makeRuntime(context: context)
   655	        guard self != nil else {
   656	          if let controllable = runtime as? any ProviderCleanupControllable {
   657	            registry.register(controllable)
   658	          }
   659	          registry.forceCloseAll()
   660	          Task { await runtime.stop(reason: .startupFailure) }
   661	          return .failed(.startCancelled)
   662	        }
   663	        guard
   664	          await self?.install(
   665	            runtime: runtime,
   666	            generation: generation,
   667	            registry: registry
   668	          ) == true
   669	        else {
   670	          Task { await runtime.stop(reason: .startupFailure) }
   671	          return .failed(.startCancelled)
   672	        }
   673	        try await runtime.start()
   674	        return .succeeded
   675	      } catch is CancellationError {
   676	        return .failed(.startCancelled)
   677	      } catch let error as ProviderAdapterError {
   678	        return .failed(error)
   679	      } catch {
   680	        return .failed(.runtimeStartupFailed)
   681	      }
   682	    }
   683	
   684	    let outcome = await raceStart(operation)
   685	    switch outcome {
   686	    case .succeeded:
   687	      guard phase == .starting, activeGeneration?.identifier == generation else {
   688	        await joinCleanupIfPresent(generation: generation)
   689	        throw ProviderAdapterError.startCancelled
   690	      }
   691	      phase = .running
   692	    case .failed(let error):
   693	      await stopAndJoin(
   694	        reason: error == .startCancelled ? .system : .startupFailure,
   695	        generation: generation,
   696	        keepStoppingAfterCleanup: false
   697	      )
   698	      throw error
   699	    case .deadline:
   700	      operation.cancel()
   701	      await stopAndJoin(
   702	        reason: .startupFailure,
   703	        generation: generation,
   704	        keepStoppingAfterCleanup: false
   705	      )
   706	      throw ProviderAdapterError.startupTimedOut
   707	    }
   708	  }
