   407	private func ledger(
   408	  clock: ManualMemoryClock,
   409	  current: UInt64 = 50,
   410	  reserved: UInt64? = nil,
   411	  committed: UInt64 = 50,
   412	  peak: UInt64 = 60
   413	) -> MemoryLedgerAvailability {
   414	  .available(
   415	    MemoryLedgerSnapshot(
   416	      capturedAt: clock.now(),
   417	      currentBytes: current,
   418	      reservedBytes: reserved ?? committed,
   419	      committedBytes: committed,
   420	      peakBytes: max(peak, max(current, committed))))
   421	}
   422	
   423	private func sample(
   424	  footprint: UInt64 = 100,
   425	  peak: UInt64 = 120,
   426	  advisory: UInt64? = 900
   427	) -> MemoryPlatformSample {
   428	  MemoryPlatformSample(
   429	    physicalFootprint: .available(
   430	      bytes: footprint, provenance: .taskVMPhysicalFootprint),
   431	    physicalFootprintPeak: .available(
   432	      bytes: peak, provenance: .taskVMPhysicalFootprint),
