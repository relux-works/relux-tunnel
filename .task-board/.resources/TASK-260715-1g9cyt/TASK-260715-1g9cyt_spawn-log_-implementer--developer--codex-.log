+{
+  "schema_version": 1,
+  "cache_policy": {
+    "environment_variable": "RELUX_NATIVE_CACHE_DIR",
+    "default_under_tmpdir": "relux-native-dependencies",
+    "key_fields": [
+      "dependency",
+      "revision",
+      "source_sha256",
+      "xcode_build",
+      "compiler_flags"
+    ],
+    "runtime_downloads_allowed": false,
+    "cache_is_authoritative": false,
+    "mismatch_policy": "delete the keyed entry and rebuild only after source verification passes"
+  },
+  "dependencies": {
+    "relux-native-fixture": {
+      "revision": "relux-native-fixture-1",
+      "source": {
+        "kind": "repository_files",
+        "files": [
+          "NativeDependencies/Fixtures/ReluxNativeFixture/LICENSE",
