   915	  public init(
   916	    initialReceiveWindowBytes: Int,
   917	    maximumAdvertisedReceiveWindowBytes: Int,
   918	    windowAdjustThresholdBytes: Int
   919	  ) throws {
   920	    let positiveValues: [(Int, SSHValidationField)] = [
   921	      (initialReceiveWindowBytes, .initialReceiveWindowBytes),
   922	      (maximumAdvertisedReceiveWindowBytes, .maximumAdvertisedReceiveWindowBytes),
   923	      (windowAdjustThresholdBytes, .windowAdjustThresholdBytes),
   924	    ]
