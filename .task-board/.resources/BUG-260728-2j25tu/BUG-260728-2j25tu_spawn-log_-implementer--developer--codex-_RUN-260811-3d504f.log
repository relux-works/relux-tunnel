   547	
   548	    let baseline = await adapter.snapshot()
   549	    #expect(baseline.activeConnections == 0)
   550	    #expect(baseline.registry.associationCount == 0)
   551	    #expect(baseline.registry.metrics.hevCleanupCallbacks == 3)
