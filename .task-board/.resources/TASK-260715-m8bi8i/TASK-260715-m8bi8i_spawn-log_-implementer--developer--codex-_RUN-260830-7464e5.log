+      ),
+      credentialReference: OpaqueCredentialReference(
+        UUID(uuidString: "33333333-3333-3333-3333-333333333333")!
+      ),
+      trustReference: OpaqueTrustReference(
+        UUID(uuidString: "44444444-4444-4444-4444-444444444444")!
+      )
+    )
+  }
+}
