   380	private final class M1HarnessGeneration: @unchecked Sendable {
   381	  let runtimeGeneration: UInt64
   382	  private let scenario: M1RuntimeHarnessScenario
   383	  private let profileIdentifier: OpaqueProfileIdentifier
   384	  private let packetFlow: M1HarnessPacketFlow
   385	  private let environment: TunnelRuntimeDependencies
   386	  private let probe = M1HarnessProbe()
   387	  private let diagnostics: RuntimeDiagnosticsStore
   388	  private let recorder: RuntimeDiagnosticsRecorder
   389	
   390	  init(
   391	    scenario: M1RuntimeHarnessScenario,
   392	    generation: UInt64,
   393	    profileIdentifier: OpaqueProfileIdentifier,
   394	    packetFlow: M1HarnessPacketFlow,
   395	    environment: TunnelRuntimeDependencies
   396	  ) {
   397	    self.scenario = scenario
   398	    runtimeGeneration = generation
   399	    self.profileIdentifier = profileIdentifier
   400	    self.environment = environment
   401	    self.packetFlow = packetFlow
   402	    diagnostics = RuntimeDiagnosticsStore(runtimeGeneration: generation)
   403	    recorder = diagnostics.recorder()
   404	  }
   405	
   406	  func dependencies() -> TunnelRuntimeCoordinatorDependencies {
   407	    let packetFactory = BridgeBackedM1PacketPlaneFactory(
   408	      configuration: PacketBridgeConfiguration(
   409	        mtu: 1_500,
   410	        sendBufferBytes: 32_768,
   411	        receiveBufferBytes: 32_768,
   412	        maximumWorkCount: 64,
   413	        workTimeBudget: .milliseconds(5),
   414	        diagnosticsWindow: .seconds(1)
   415	      ),
   416	      virtualDNSEndpoints: [m1DNSFixtureEndpoint]
   417	    ) { [probe, recorder, scenario, environment] ingress, generation in
   418	      probe.setIngress(ingress)
   419	      let bridge = PacketFlowBridge(
   420	        socketIO: M1HarnessTrackingSocketIO(probe: probe),
   421	        descriptorConsumer: M1HarnessDescriptorConsumer(probe: probe),
   422	        clock: environment.clock,
   423	        logger: environment.logger,
   424	        metrics: recorder,
   425	        runIDSource: M1HarnessRunIDSource(generation: generation),
   426	        lifecycleBarrier: M1HarnessPacketBarrier(scenario: scenario, probe: probe)
   427	      )
   428	      return M1HarnessIngressBridge(bridge: bridge, probe: probe)
   429	    }
   430	    return TunnelRuntimeCoordinatorDependencies(
   431	      configurationSource: M1HarnessConfigurationSource(
   432	        profileIdentifier: profileIdentifier,
   433	        probe: probe
   434	      ),
   435	      sshBootstrap: M1HarnessSSHBootstrap(
   436	        scenario: scenario,
   437	        probe: probe,
   438	        recorder: recorder
   439	      ),
   440	      tcpFactory: M1HarnessTCPFactory(probe: probe, recorder: recorder),
   441	      dnsFactory: M1HarnessDNSFactory(
   442	        scenario: scenario,
   443	        probe: probe,
   444	        recorder: recorder
   445	      ),
   446	      packetPlaneFactory: packetFactory,
   447	      settingsPlanBuilder: M1HarnessSettingsBuilder(probe: probe),
   448	      settingsApplier: M1HarnessSettingsApplier(
   449	        scenario: scenario,
   450	        probe: probe,
   451	        recorder: recorder
   452	      ),
   453	      snapshotStore: M1HarnessSnapshotStore(probe: probe)
   454	    )
   455	  }
   456	
   457	  func injectionWasObserved() -> Bool {
   458	    switch scenario {
   459	    case .authenticationFailure:
   460	      probe.contains("ssh.authenticate.injected")
   461	    case .packetFailure:
   462	      probe.contains("packet.activate.injected")
   463	    case .dnsFailure:
   464	      probe.contains("dns.prepare.injected")
   465	    case .routeApplyFailure:
   466	      probe.contains("route.apply.injected")
   467	    case .midSessionSSHFailure:
   468	      probe.contains("ssh.loss.injected")
   469	    case .midSessionDNSFailure:
   470	      probe.contains("dns.loss.injected")
   471	    case .success:
   472	      false
   473	    }
   474	  }
   475	
   476	  func verifyReady(runtime: any TunnelRuntime) async throws {
   477	    guard await runtime.lifecycleState() == .connectedDegraded,
   478	      let latest = probe.allSnapshots().last,
   479	      latest.lifecycle.lifecycleState == .connectedDegraded,
   480	      latest.lifecycle.tcp,
   481	      latest.lifecycle.safeDNS,
   482	      !latest.lifecycle.udp,
   483	      latest.lifecycle.routesInstalled,
   484	      latest.lifecycle.healthy
   485	    else {
   486	      throw M1RuntimeHarnessError.runtimeInvariant
   487	    }
   488	    try requireOrderedEvents([
   489	      "configuration.load", "ssh.authenticate", "tcp.prepare", "dns.prepare",
   490	      "packet.prepare", "route.plan", "route.apply", "packet.activate",
   491	    ])
   492	  }
   493	
   494	  func exchangeRepresentativeTraffic() async throws {
   495	    guard let ingress = probe.capturedIngress() else {
   496	      throw M1RuntimeHarnessError.trafficInvariant
   497	    }
   498	    let tcpDispatch = try await ingress.dispatch(
   499	      .tcp(destination: m1TCPFixtureEndpoint, originator: m1OriginatorFixtureEndpoint)
   500	    )
   501	    guard case .tcp(let channel) = tcpDispatch else {
   502	      throw M1RuntimeHarnessError.trafficInvariant
   503	    }
   504	    let written = try await channel.writeSome(m1TCPRequest)
   505	    try await channel.finishWriting()
   506	    let response = try await channel.read(maximumBytes: 4_096)
   507	    await channel.close()
   508	    guard written == m1TCPRequest.count, response == m1TCPResponse else {
   509	      throw M1RuntimeHarnessError.trafficInvariant
   510	    }
   511	
   512	    let dnsDispatch = try await ingress.dispatch(
   513	      .udp(
   514	        payload: m1DNSQuery,
   515	        destination: m1DNSFixtureEndpoint,
   516	        originator: m1OriginatorFixtureEndpoint
   517	      )
   518	    )
   519	    guard case .dnsUDP(let dnsResponse) = dnsDispatch, dnsResponse == m1DNSResponse else {
   520	      throw M1RuntimeHarnessError.trafficInvariant
   521	    }
   522	    probe.record("traffic.complete")
   523	  }
   524	
   525	  func requestAndVerifyDiagnostics() throws {
   526	    let snapshot = try diagnostics.snapshot()
   527	    guard snapshot.runtimeGeneration == runtimeGeneration,
   528	      snapshot.counters["tcp_flows_opened_total"] == 1,
   529	      snapshot.counters["tcp_flows_closed_total"] == 1,
   530	      snapshot.counters["tcp_bytes_sent_total"] == UInt64(m1TCPRequest.count),
   531	      snapshot.counters["tcp_bytes_received_total"] == UInt64(m1TCPResponse.count),
   532	      snapshot.counters["dns_result_success_total"] == 1,
   533	      snapshot.gauges["route_installed"] == 1
   534	    else {
   535	      throw M1RuntimeHarnessError.diagnosticsInvariant
   536	    }
   537	    let encoded = try JSONEncoder().encode(snapshot)
   538	    guard let text = String(data: encoded, encoding: .utf8),
   539	      !text.contains(m1TCPFixtureEndpoint.host),
   540	      !text.contains(m1DNSFixtureEndpoint.host),
   541	      !text.contains(profileIdentifier.rawValue.uuidString)
   542	    else {
   543	      throw M1RuntimeHarnessError.privacyInvariant
   544	    }
   545	    probe.record("diagnostics.snapshot")
   546	  }
   547	
   548	  func injectMandatoryLoss() async throws {
   549	    switch scenario {
   550	    case .midSessionSSHFailure:
   551	      guard let session = probe.capturedSSHSession() else {
   552	        throw M1RuntimeHarnessError.injectionNotObserved
   553	      }
   554	      await session.injectLoss()
   555	    case .midSessionDNSFailure:
   556	      guard let dns = probe.capturedDNSConsumer() else {
   557	        throw M1RuntimeHarnessError.injectionNotObserved
   558	      }
   559	      await dns.injectLoss()
   560	    case .success, .authenticationFailure, .packetFailure, .dnsFailure,
   561	      .routeApplyFailure:
   562	      throw M1RuntimeHarnessError.injectionNotObserved
   563	    }
   564	  }
   565	
   566	  func verifyMandatoryFailure(runtime: any TunnelRuntime) async throws {
   567	    guard injectionWasObserved(), await runtime.lifecycleState() == .failed else {
   568	      throw M1RuntimeHarnessError.runtimeInvariant
   569	    }
   570	  }
   571	
   572	  func verifyAfterStop(runtime: any TunnelRuntime) async throws {
   573	    let activeReads = await packetFlow.activeReadCount()
   574	    guard probe.hasBalancedResources(activePacketReads: activeReads) else {
   575	      throw M1RuntimeHarnessError.resourceGrowth
   576	    }
   577	    let state = await runtime.lifecycleState()
   578	    guard state == .disconnected || state == .failed else {
   579	      throw M1RuntimeHarnessError.runtimeInvariant
   580	    }
   581	    let lifecycles = probe.allSnapshots().map(\.lifecycle.lifecycleState)
   582	    guard lifecycles.first == .connecting,
   583	      lifecycles.contains(.disconnecting),
   584	      lifecycles.last == state
   585	    else {
   586	      throw M1RuntimeHarnessError.runtimeInvariant
   587	    }
   588	  }
   589	
   590	  private func requireOrderedEvents(_ expected: [String]) throws {
   591	    let events = probe.allEvents()
   592	    var previous = -1
   593	    for event in expected {
   594	      guard let index = events.firstIndex(of: event), index > previous else {
   595	        throw M1RuntimeHarnessError.runtimeInvariant
   596	      }
   597	      previous = index
   598	    }
   599	  }
   600	}

