+def count_new_matches(window: bytes, previous_tail_size: int, pattern: bytes) -> int:
+    count = 0
+    start = 0
+    while True:
+        match = window.find(pattern, start)
+        if match < 0:
+            return count
+        if match + len(pattern) > previous_tail_size:
+            count += 1
+        start = match + 1
