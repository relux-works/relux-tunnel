diff --git a/Tests/ReluxTunnelCoreTests/SSHReceiveWindowBudgetPolicyTests.swift b/Tests/ReluxTunnelCoreTests/SSHReceiveWindowBudgetPolicyTests.swift
index 151ddbe8b3684dc05a92e89fcef2217e68a5219f..8447d4e8ed634ec81647f32de8a82ac48bd475e9
--- a/Tests/ReluxTunnelCoreTests/SSHReceiveWindowBudgetPolicyTests.swift
+++ b/Tests/ReluxTunnelCoreTests/SSHReceiveWindowBudgetPolicyTests.swift
@@ -184,6 +184,89 @@
     #expect(after.metrics.refusals[.insufficientReservation] == 1)
   }
 
+  @Test("adjustment rejects outstanding credit above the reserved window without mutation")
+  func adjustmentRejectsCreditAboveReservation() throws {
+    let lane = fixtureLane()
+    var ledger = try fixtureLedger(lane: lane)
+    let channel = fixtureChannel(16)
+    let initial = try ledger.reserveInitial(
+      channel: channel, lane: lane.identity, channelClass: .control, generation: 7)
+    #expect(initial.initialWindowBytes == 32 * 1_024)
+    #expect(initial.maximumAdvertisedWindowBytes == 64 * 1_024)
+    let before = ledger.snapshot()
+
+    #expect(throws: SSHReceiveWindowRefusal.invalidOutstandingCredit) {
+      _ = try ledger.reserveAdjustment(
+        channel: channel,
+        generation: 7,
+        outstandingAdvertisedCreditBytes: 32 * 1_024 + 1)
+    }
+
+    let after = ledger.snapshot()
+    #expect(after.reservedChannelCount == before.reservedChannelCount)
+    #expect(after.managedWindowReservedBytes == before.managedWindowReservedBytes)
+    #expect(after.globalWindowReservedBytes == before.globalWindowReservedBytes)
+    #expect(after.ledgerCommittedBytes == before.ledgerCommittedBytes)
+    #expect(after.laneWindowReservedBytes == before.laneWindowReservedBytes)
+    #expect(after.metrics.initialReservations == before.metrics.initialReservations)
+    #expect(after.metrics.adjustmentReservations == before.metrics.adjustmentReservations)
+    #expect(after.metrics.adjustmentBytes == before.metrics.adjustmentBytes)
+    #expect(after.metrics.refusals[.invalidOutstandingCredit] == 1)
+  }
+
+  @Test("pressure gates every channel class and never mutates rejected reservations")
+  func pressureClassMatrix() throws {
+    let lane = fixtureLane()
+    let bulkMeasurement = SSHBulkPathMeasurement(
+      bandwidthBitsPerSecond: 8_000_000,
+      roundTripTimeNanoseconds: 64_000_000)
+    let cases: [(SSHReceiveWindowPressure, SSHReceiveWindowClass, Bool)] = [
+      (.pressure, .control, true),
+      (.pressure, .ordinary, false),
+      (.pressure, .bulk, false),
+      (.pressure, .relay, true),
+      (.critical, .control, false),
+      (.critical, .ordinary, false),
+      (.critical, .bulk, false),
+      (.critical, .relay, false),
+    ]
+
+    for (index, testCase) in cases.enumerated() {
+      let (pressure, channelClass, permitted) = testCase
+      var ledger = try fixtureLedger(lane: lane)
+      ledger.setPressure(pressure)
+      let before = ledger.snapshot()
+      let measurement = channelClass == .bulk ? bulkMeasurement : nil
