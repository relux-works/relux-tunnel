            expected = self.assets[target]
            self.assertEqual(entry["byteSize"], len(expected))
            self.assertEqual(entry["sha256"], hashlib.sha256(expected).hexdigest())
            self.assertEqual(entry["buildIdentity"]["selfSha256"], entry["sha256"])

