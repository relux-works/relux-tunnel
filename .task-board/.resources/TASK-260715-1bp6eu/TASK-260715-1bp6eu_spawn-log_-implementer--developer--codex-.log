+  private var _count = 0
+
+  func record(_ value: Value) {
+    lock.withLock { _count += 1 }
+    Task { await channel.send(value) }
+  }
+
+  func next() async -> Value { await channel.next() }
+  var count: Int { lock.withLock { _count } }
+}
