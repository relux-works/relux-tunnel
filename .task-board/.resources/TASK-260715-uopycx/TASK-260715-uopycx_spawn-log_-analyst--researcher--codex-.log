     1	# HevSocks5Core
     2	
     3	HevSocks5Core is a simple, lightweight socks5 library.
     4	
     5	**Features**
     6	* IPv4/IPv6. (dual stack)
     7	* Standard `CONNECT` command.
     8	* Standard `UDP ASSOCIATE` command.
     9	* Extended `FWD UDP` command. (UDP in TCP)
    10	* Multiple username/password authentication.
    11	
    12	**Dependencies**
    13	* HevTaskSystem - https://github.com/heiher/hev-task-system
    14	
    15	## Examples
    16	
    17	### Server
    18	
    19	```c
    20	#include <unistd.h>
    21	
    22	#include <hev-task.h>
    23	#include <hev-task-io.h>
    24	#include <hev-task-io-socket.h>
    25	#include <hev-task-dns.h>
    26	#include <hev-task-system.h>
    27	
    28	#include <hev-socks5-server.h>
    29	
    30	static void
    31	server_entry (void *data)
    32	{
    33	    HevSocks5Server *server = data;
    34	    hev_socks5_server_run (server);
    35	    hev_object_unref (HEV_OBJECT (server));
    36	}
    37	
    38	static void
    39	listener_entry (void *data)
    40	{
    41	    struct addrinfo hints = { 0 };
    42	    struct addrinfo *result;
    43	    int fd;
    44	
    45	    hints.ai_family = AF_INET6;
    46	    hints.ai_socktype = SOCK_STREAM;
    47	    hints.ai_flags = AI_PASSIVE;
    48	
    49	    hev_task_dns_getaddrinfo (NULL, "1080", &hints, &result);
    50	    fd = hev_task_io_socket_socket (AF_INET6, SOCK_STREAM, 0);
    51	    bind (fd, result->ai_addr, result->ai_addrlen);
    52	    freeaddrinfo (result);
    53	    listen (fd, 5);
    54	
    55	    hev_task_add_fd (hev_task_self (), fd, POLLIN);
    56	
    57	    for (;;) {
    58	        HevSocks5Server *server;
    59	        HevTask *task;
    60	        int nfd;
    61	
    62	        nfd = hev_task_io_socket_accept (fd, NULL, NULL, NULL, NULL);
    63	
    64	        task = hev_task_new (-1);
    65	        server = hev_socks5_server_new (nfd);
    66	        hev_task_run (task, server_entry, server);
    67	    }
    68	
    69	    close (fd);
    70	}
