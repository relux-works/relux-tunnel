   554	
   555	  private func performUpload(
   556	    _ request: SSHExecUploadRequest,
   557	    until deadline: ContinuousClock.Instant
   558	  ) async throws -> SSHExecExit {
   559	    guard let configuration else {
   560	      throw transportError(code: .invalidState, phase: .uploadSource)
   561	    }
   562	    let channelOpenDeadline = min(
   563	      deadline,
   564	      dependencies.clock.now().advanced(by: configuration.timeouts.channelOpen)
   565	    )
   566	    let channel = try await openExecChannel(
   567	      request: request.exec,
   568	      policy: request.channelPolicy,
   569	      until: channelOpenDeadline
   570	    )
   571	    let execChannel = channel as! LibSSH2ExecChannel
   572	    do {
   573	      async let stdout: Void = drain(
   574	        channel: execChannel,
   575	        standardError: false,
   576	        until: deadline
   577	      )
   578	      async let stderr: Void = drain(
   579	        channel: execChannel,
   580	        standardError: true,
   581	        until: deadline
   582	      )
   583	      while let bytes = try await readUploadSource(request, until: deadline) {
   584	        guard !bytes.isEmpty, bytes.count <= request.chunkBytes else {
   585	          throw transportError(code: .protocolViolation, phase: .uploadSource)
   586	        }
   587	        var offset = 0
   588	        while offset < bytes.count {
   589	          let written = try await channelWrite(
   590	            identity: execChannel.identity,
   591	            bytes: Data(bytes[offset...]),
   592	            deadline: deadline
   593	          )
   594	          offset += written
   595	        }
   596	      }
   597	      try await channelFinishWriting(identity: execChannel.identity, deadline: deadline)
   598	      let exit = try await channelExit(identity: execChannel.identity, deadline: deadline)
   599	      _ = try await (stdout, stderr)
   600	      await execChannel.close()
   601	      return exit
   602	    } catch {
   603	      await resetChannelAfterFailedOperation(identity: execChannel.identity)
   604	      if error is LibSSH2TimeoutError
   605	        || (error as? SSHTransportError)?.code == .timedOut
   606	      {
   607	        throw transportError(code: .timedOut, phase: .uploadSource, scope: .operation)
   608	      }
   609	      throw map(error, phase: .uploadSource, scope: .channel(execChannel.identity))
   610	    }
   611	  }
