+      "credential-reference-private",
+      "destination.private",
+      "origin.private",
+      "private exec command",
+      "/private/remote/path",
+      "private-key-material",
+      "payload-secret",
+    ]
+
+    for sentinel in sentinels {
+      #expect(!diagnostics.contains(sentinel))
+    }
+  }
