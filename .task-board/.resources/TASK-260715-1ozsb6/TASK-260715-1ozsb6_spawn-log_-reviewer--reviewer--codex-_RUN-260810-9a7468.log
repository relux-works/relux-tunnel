  1122	  private struct State {
  1123	    var rejectStartup = false
  1124	    var closeEAGAINRemaining = 0
  1125	    var freeEAGAINRemaining = 0
  1126	    var closeCallCount = 0
  1127	    var freeCallCount = 0
  1128	  }
  1129	
  1130	  private let state = Mutex(State())
  1131	
  1132	  var api: LibSSH2ChannelAPI {
  1133	    let live = LibSSH2ChannelAPI.live
  1134	    return LibSSH2ChannelAPI(
  1135	      processStartup: { [self] pointer, command in
  1136	        let reject = state.withLock { state in
  1137	          defer { state.rejectStartup = false }
  1138	          return state.rejectStartup
  1139	        }
  1140	        return reject ? LIBSSH2_ERROR_CHANNEL_REQUEST_DENIED : live.processStartup(pointer, command)
  1141	      },
  1142	      close: { [self] pointer in
  1143	        let inject = state.withLock { state in
  1144	          state.closeCallCount += 1
  1145	          guard state.closeEAGAINRemaining > 0 else { return false }
  1146	          state.closeEAGAINRemaining -= 1
  1147	          return true
  1148	        }
  1149	        return inject ? LIBSSH2_ERROR_EAGAIN : live.close(pointer)
  1150	      },
  1151	      free: { [self] pointer in
  1152	        let inject = state.withLock { state in
  1153	          state.freeCallCount += 1
  1154	          guard state.freeEAGAINRemaining > 0 else { return false }
  1155	          state.freeEAGAINRemaining -= 1
  1156	          return true
  1157	        }
  1158	        return inject ? LIBSSH2_ERROR_EAGAIN : live.free(pointer)
  1159	      }
  1160	    )
  1161	  }
