+def require_denied(action):
+    try:
+        value = action()
+    except OSError as error:
+        if error.errno in (errno.EACCES, errno.EPERM):
+            return
+        raise
+    if isinstance(value, subprocess.Popen):
+        value.kill()
+        value.wait()
+    if isinstance(value, socket.socket):
+        value.close()
