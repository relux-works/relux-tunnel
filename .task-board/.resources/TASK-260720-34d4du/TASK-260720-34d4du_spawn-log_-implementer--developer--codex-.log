   382	    private func negotiatedAlgorithms(_ message: SSHMessage.KeyExchangeMessage) throws -> NegotiationResult {
   383	        let (keyExchange, hostKey) = try self.negotiatedKeyExchangeAlgorithm(
   384	            peerKeyExchangeAlgorithms: message.keyExchangeAlgorithms,
   385	            peerHostKeyAlgorithms: message.serverHostKeyAlgorithms
   386	        )
   387	        let (clientEncryption, clientMAC) = try self.negotiatedTransportProtection(
   388	            peerEncryptionAlgorithms: message.encryptionAlgorithmsClientToServer,
   389	            peerMacAlgorithms: message.macAlgorithmsClientToServer
   390	        )
   391	        let (serverEncryption, serverMAC) = try self.negotiatedTransportProtection(
   392	            peerEncryptionAlgorithms: message.encryptionAlgorithmsServerToClient,
   393	            peerMacAlgorithms: message.macAlgorithmsServerToClient
   394	        )
   395	
   396	        // We only support symmetrical negotiation results.
   397	        guard clientEncryption == serverEncryption, clientMAC == serverMAC else {
   398	            throw NIOSSHError.keyExchangeNegotiationFailure
   399	        }
   400	
   401	        // Ok, now we need to find the right transport protection scheme. This can technically fail.
   402	        guard
   403	            let scheme = self.protectionSchemes.first(where: {
   404	                $0.cipherName == clientEncryption && ($0.macName == nil || $0.macName! == clientMAC)
   405	            })
   406	        else {
   407	            throw NIOSSHError.keyExchangeNegotiationFailure
   408	        }
   409	
   410	        // Great, we have a protection scheme. Build the negotiation result.
   411	        return NegotiationResult(
   412	            negotiatedKeyExchangeAlgorithm: keyExchange,
   413	            negotiatedHostKeyAlgorithm: hostKey,
   414	            negotiatedProtection: scheme
   415	        )
   416	    }
   417	
   418	    private func negotiatedKeyExchangeAlgorithm(
   419	        peerKeyExchangeAlgorithms: [Substring],
   420	        peerHostKeyAlgorithms: [Substring]
   421	    ) throws -> (keyExchange: Substring, hostKey: Substring) {
   422	        // From RFC 4253:
   423	        //
   424	        // > The first algorithm MUST be the preferred (and guessed) algorithm.  If
   425	        // > both sides make the same guess, that algorithm MUST be used.
   426	        // > Otherwise, the following algorithm MUST be used to choose a key
   427	        // > exchange method: Iterate over client's kex algorithms, one at a
   428	        // > time.  Choose the first algorithm that satisfies the following
   429	        // > conditions:
   430	        // >
   431	        // > +  the server also supports the algorithm,
   432	        // >
   433	        // > +  if the algorithm requires an encryption-capable host key,
   434	        // >    there is an encryption-capable algorithm on the server's
   435	        // >    server_host_key_algorithms that is also supported by the
   436	        // >    client, and
   437	        // >
   438	        // > +  if the algorithm requires a signature-capable host key,
   439	        // >    there is a signature-capable algorithm on the server's
   440	        // >    server_host_key_algorithms that is also supported by the
   441	        // >    client.
   442	        // >
   443	        // > If no algorithm satisfying all these conditions can be found, the
   444	        // > connection fails, and both sides MUST disconnect.
   445	
   446	        // Ok, rephrase as client and server instead of us and them.
   447	        let clientAlgorithms: [Substring]
   448	        let serverAlgorithms: [Substring]
   449	        let clientHostKeyAlgorithms: [Substring]
   450	        let serverHostKeyAlgorithms: [Substring]
   451	
   452	        switch self.role {
   453	        case .client:
   454	            clientAlgorithms = Self.supportedKeyExchangeAlgorithms
   455	            serverAlgorithms = peerKeyExchangeAlgorithms
   456	            clientHostKeyAlgorithms = self.supportedHostKeyAlgorithms
   457	            serverHostKeyAlgorithms = peerHostKeyAlgorithms
   458	        case .server:
   459	            clientAlgorithms = peerKeyExchangeAlgorithms
   460	            serverAlgorithms = Self.supportedKeyExchangeAlgorithms
   461	            clientHostKeyAlgorithms = peerHostKeyAlgorithms
   462	            serverHostKeyAlgorithms = self.supportedHostKeyAlgorithms
   463	        }
   464	
   465	        // Let's find the first protocol the client supports that the server does too.
   466	        for algorithm in clientAlgorithms {
   467	            guard serverAlgorithms.contains(algorithm) else {
   468	                continue
   469	            }
   470	
   471	            // Ok, got one. We need a signing capable host key algorithm, which for us is all of them.
   472	            // Again, we prefer the first one the client supports that the server does too.
   473	            for hostKeyAlgorithm in clientHostKeyAlgorithms {
   474	                guard serverHostKeyAlgorithms.contains(hostKeyAlgorithm) else {
   475	                    continue
   476	                }
   477	
   478	                // Got one! This one works.
   479	                return (keyExchange: algorithm, hostKey: hostKeyAlgorithm)
   480	            }
   481	        }
   482	
   483	        // Completed the loop with usable protocols, we have to throw.
   484	        throw NIOSSHError.keyExchangeNegotiationFailure
   485	    }
   486	
   487	    private func negotiatedTransportProtection(
   488	        peerEncryptionAlgorithms: [Substring],
   489	        peerMacAlgorithms: [Substring]
   490	    ) throws -> (encryption: Substring, mac: Substring) {
   491	        // Ok, rephrase as client and server instead of us and them.
   492	        let clientEncryptionAlgorithms: [Substring]
   493	        let serverEncryptionAlgorithms: [Substring]
   494	        let clientMACAlgorithms: [Substring]
   495	        let serverMACAlgorithms: [Substring]
   496	
   497	        switch self.role {
   498	        case .client:
   499	            clientEncryptionAlgorithms = self.supportedEncryptionAlgorithms
   500	            clientMACAlgorithms = self.supportedMacAlgorithms
   501	            serverEncryptionAlgorithms = peerEncryptionAlgorithms
   502	            serverMACAlgorithms = peerMacAlgorithms
   503	        case .server:
   504	            clientEncryptionAlgorithms = peerEncryptionAlgorithms
   505	            clientMACAlgorithms = peerMacAlgorithms
   506	            serverEncryptionAlgorithms = self.supportedEncryptionAlgorithms
   507	            serverMACAlgorithms = self.supportedMacAlgorithms
   508	        }
   509	
   510	        // Ok, the algorithm is that we choose the first encryption and MAC algorithm in the client's list that
   511	        // is in the server's list as well.
   512	        guard let encryption = clientEncryptionAlgorithms.first(where: { serverEncryptionAlgorithms.contains($0) })
   513	        else {
   514	            throw NIOSSHError.keyExchangeNegotiationFailure
   515	        }
   516	
   517	        // Ok great, now work out what we negotiated as a MAC.
   518	        guard let mac = clientMACAlgorithms.first(where: { serverMACAlgorithms.contains($0) }) else {
   519	            throw NIOSSHError.keyExchangeNegotiationFailure
   520	        }
   521	
   522	        return (encryption, mac)
   523	    }
   524	
   525	    private mutating func addKeyExchangeInitMessagesToExchangeBytes(
   526	        clientsMessage: SSHMessage.KeyExchangeMessage,
   527	        serversMessage: SSHMessage.KeyExchangeMessage
   528	    ) {
   529	        // Write the client's bytes to the exchange bytes first.
   530	        self.initialExchangeBytes.writeCompositeSSHString { buffer in
   531	            buffer.writeSSHMessage(.keyExchange(clientsMessage))
   532	        }
   533	
   534	        self.initialExchangeBytes.writeCompositeSSHString { buffer in
   535	            buffer.writeSSHMessage(.keyExchange(serversMessage))
   536	        }
   537	    }
   538	
   539	    private func exchangerForAlgorithm(_ algorithm: Substring) throws -> EllipticCurveKeyExchangeProtocol {
   540	        for implementation in Self.supportedKeyExchangeImplementations {
   541	            if implementation.keyExchangeAlgorithmNames.contains(algorithm) {
   542	                return implementation.init(
   543	                    ourRole: self.role,
   544	                    previousSessionIdentifier: self.previousSessionIdentifier
   545	                )
   546	            }
   547	        }
   548	
   549	        // Huh, we didn't find it. Weird error.
   550	        throw NIOSSHError.keyExchangeNegotiationFailure
   551	    }
   552	
   553	    private func expectingIncorrectGuess(_ kexMessage: SSHMessage.KeyExchangeMessage) -> Bool {
   554	        // A guess is wrong if the key exchange algorithm and/or the host key algorithm differ from our preference.
   555	        kexMessage.firstKexPacketFollows
   556	            && (kexMessage.keyExchangeAlgorithms.first != Self.supportedKeyExchangeAlgorithms.first
   557	                || kexMessage.serverHostKeyAlgorithms.first != self.supportedHostKeyAlgorithms.first)
   558	    }
   559	
   560	    // The host key algorithms supported by this peer, in order of preference.
   561	    private var supportedHostKeyAlgorithms: [Substring] {
   562	        switch self.role {
   563	        case .client:
   564	            return Self.supportedServerHostKeyAlgorithms
   565	        case .server(let configuration):
   566	            return configuration.hostKeys.flatMap { $0.hostKeyAlgorithms }
   567	        }
   568	    }
   569	
   570	    /// The encryption algorithms supported by this peer, in order of preference.
   571	    private var supportedEncryptionAlgorithms: [Substring] {
   572	        self.protectionSchemes.map { Substring($0.cipherName) }
   573	    }
   574	
   575	    /// The MAC algorithms supported by this peer, in order of preference.
   576	    private var supportedMacAlgorithms: [Substring] {
   577	        let schemes = self.protectionSchemes.compactMap { $0.macName.map { Substring($0) } }
   578	
   579	        // We do a weird thing here: if there are no MAC schemes, we lie and put one in. This is
   580	        // because some schemes (such as AES-GCM in OpenSSH mode) ignore the MAC negotiation.
   581	        // Worse case, we fail out later in the handshake because the peer actually wanted it.
   582	        if schemes.isEmpty {
   583	            return ["hmac-sha2-256"]
   584	        } else {
   585	            return schemes
   586	        }
   587	    }
   588	}
