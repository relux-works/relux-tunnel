+      (
+        Data(
+          #"{"kind":"getCapabilities","protocolVersion":2,"requestID":"00000000-0000-0000-0000-000000000012","schemaVersion":1}"#.utf8
+        ),
+        .unsupportedProtocolVersion
+      ),
+      (
+        Data(
+          #"{"kind":"getCapabilities","protocolVersion":1,"requestID":"00000000-0000-0000-0000-000000000013","schemaVersion":2}"#.utf8
+        ),
+        .unsupportedSchemaVersion
+      ),
+      (
+        try RuntimeMessageCodec.encode(RuntimeCommand(kind: .getCapabilities)),
+        .unsupportedValue
+      ),
+    ]
+
