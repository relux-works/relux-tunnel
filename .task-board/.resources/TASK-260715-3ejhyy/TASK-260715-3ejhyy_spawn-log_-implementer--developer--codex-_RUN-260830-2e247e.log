  public init(rawValue: UUID) {
    self.rawValue = rawValue
  }
}

/// Opaque identity for one authenticated SSH session.
public struct SSHSessionIdentity: Hashable, Sendable {
  public let rawValue: UUID

  public init(rawValue: UUID) {
    self.rawValue = rawValue
  }
}

