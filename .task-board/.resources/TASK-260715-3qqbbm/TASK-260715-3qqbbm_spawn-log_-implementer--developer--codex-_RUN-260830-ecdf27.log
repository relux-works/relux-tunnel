   228	def verify_generated_project(path: Path) -> None:
   229	    text = path.read_text(encoding="utf-8")
   230	    provider = named_native_target(text, "ReluxProxyMacTunnel")
   231	    frameworks = target_phase(text, provider, "PBXFrameworksBuildPhase")
   232	    resources = target_phase(text, provider, "PBXResourcesBuildPhase")
   233	    require_phase_edge(
   234	        text,
   235	        frameworks,
   236	        "productRef",
   237	        "ReluxTunnelMacOSAdapter",
   238	        "Frameworks",
   239	    )
   240	    require_phase_edge(
   241	        text,
   242	        resources,
   243	        "fileRef",
   244	        "relay-assets-v1",
   245	        "Resources",
   246	    )
   247	    if "CReluxNativeFixture" in text:
   248	        raise ContractError("CReluxNativeFixture leaked into the generated app project")
