{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c461","stream":{"kind":"session","id":"01a0a9f3-0aae-7543-b404-eee867114d41"},"sequence":139,"recorded_at":1780531400000273,"record_type":"event","durability":"durable","causation_id":"a55aec8e-a7e3-4a93-bd48-0c1f165c8ec5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a55aec8e-a7e3-4a93-bd48-0c1f165c8ec5","run_stream":{"kind":"run","id":"a55aec8e-a7e3-4a93-bd48-0c1f165c8ec5"},"call_id":"call_01a0a9f3528a737898b17024a164091e","text":"Read text file `Sources/ReluxTunnelHarnessSupport/M1RuntimeCommand.swift`.\n1|import Darwin\n2|import Foundation\n3|import ReluxTunnelCore\n4|\n5|public enum M1RuntimeHarnessScenario: String, CaseIterable, Sendable {\n6|  case success\n7|  case authenticationFailure = \"authentication-failure\"\n8|  case packetFailure = \"packet-failure\"\n9|  case dnsFailure = \"dns-failure\"\n10|  case routeApplyFailure = \"route-apply-failure\"\n11|  case midSessionSSHFailure = \"mid-session-ssh-failure\"\n12|  case midSessionDNSFailure = \"mid-session-dns-failure\"\n13|\n14|  fileprivate var isStartupFailure: Bool {\n15|    switch self {\n16|    case .authenticationFailure, .packetFailure, .dnsFailure, .routeApplyFailure:\n17|      true\n18|    case .success, .midSessionSSHFailure, .midSessionDNSFailure:\n19|      false\n20|    }\n21|  }\n22|\n23|  fileprivate var exitCode: HarnessExitCode {\n24|    switch self {\n25|    case .success:\n26|      .success\n27|    case .authenticationFailure:\n28|      .m1AuthenticationFailure\n29|    case .packetFailure:\n30|      .m1PacketFailure\n31|    case .dnsFailure:\n32|      .m1DNSFailure\n33|    case .routeApplyFailure:\n34|      .m1RouteApplyFailure\n35|    case .midSessionSSHFailure, .midSessionDNSFailure:\n36|      .m1MandatoryFailure\n37|    }\n38|  }\n39|}\n40|\n41|public enum M1RuntimeHarnessError: Error, Equatable, CustomStringConvertible,\n42|  HarnessExitCodeProvidingError\n43|{\n44|  case invalidFixture\n45|  case unsupportedScenario\n46|  case invalidRepetitionCount\n47|  case faultScenarioMustRunOnce\n48|  case sensitiveControlParameter\n49|  case profileReferenceMustBeSensitive\n50|  case missingDependencyRevision\n51|  case injected(M1RuntimeHarnessScenario)\n52|  case injectionNotObserved\n53|  case runtimeInvariant\n54|  case trafficInvariant\n55|  case diagnosticsInvariant\n56|  case resourceGrowth\n57|  case privacyInvariant\n58|  case hostLifetimeInvariant\n59|\n60|  public var harnessExitCode: HarnessExitCode {\n61|    switch self {\n62|    case .unsupportedScenario, .invalidRepetitionCount, .faultScenarioMustRunOnce,\n63|      .sensitiveControlParameter, .profileReferenceMustBeSensitive,\n64|      .missingDependencyRevision, .invalidFixture:\n65|      .usage\n66|    case .injected(let scenario):\n67|      scenario.exitCode\n68|    case .injectionNotObserved, .runtimeInvariant, .trafficInvariant,\n69|      .diagnosticsInvariant, .resourceGrowth, .privacyInvariant,\n70|      .hostLifetimeInvariant:\n71|      .failure\n72|    }\n73|  }\n74|\n75|  public var description: String {\n76|    switch self {\n77|    case .invalidFixture:\n78|      \"m1-runtime invalid fixture\"\n79|    case .unsupportedScenario:\n80|      \"m1-runtime unsupported scenario\"\n81|    case .invalidRepetitionCount:\n82|      \"m1-runtime repetitions must be in 1...8\"\n83|    case .faultScenarioMustRunOnce:\n84|      \"m1-runtime failure scenarios require repetitions=1\"\n85|    case .sensitiveControlParameter:\n86|      \"m1-runtime control parameters must be public\"\n87|    case .profileReferenceMustBeSensitive:\n88|      \"m1-runtime profile reference must be sensitive\"\n89|    case .missingDependencyRevision:\n90|      \"m1-runtime required dependency revision is missing\"\n91|    case .injected(let scenario):\n92|      \"m1-runtime injected \\(scenario.rawValue)\"\n93|    case .injectionNotObserved:\n94|      \"m1-runtime configured injection was not observed\"\n95|    case .runtimeInvariant:\n96|      \"m1-runtime lifecycle invariant failed\"\n97|    case .trafficInvariant:\n98|      \"m1-runtime traffic invariant failed\"\n99|    case .diagnosticsInvariant:\n100|      \"m1-runtime diagnostics invariant failed\"\n101|    case .resourceGrowth:\n102|      \"m1-runtime resource growth detected\"\n103|    case .privacyInvariant:\n104|      \"m1-runtime privacy invariant failed\"\n105|    case .hostLifetimeInvariant:\n106|      \"m1-runtime retained simulated host owner\"\n107|    }\n108|  }\n109|}\n110|\n111|public struct M1RuntimeHarnessCommand: HarnessCommand {\n112|  public static let maximumRepetitions = 8\n113|  public let name = \"m1-runtime\"\n114|\n115|  public init() {}\n116|\n117|  public func run(context: HarnessCommandContext) async throws {\n118|    let fixture = try M1HarnessFixture(configuration: context.configuration)\n119|    let sessionFactory = DeterministicHarnessSessionFactory { runtimeContext, generation in\n120|      guard let packetFlow = runtimeContext.packetFlow as? M1HarnessPacketFlow else {\n121|        throw M1RuntimeHarnessError.runtimeInvariant\n122|      }\n123|      let generationFixture = M1HarnessGeneration(\n124|        scenario: fixture.scenario,\n125|        generation: generation,\n126|        profileIdentifier: runtimeContext.configuration.profileReference.profileIdentifier,\n127|        packetFlow: packetFlow,\n128|        environment: runtimeContext.dependencies\n129|      )\n130|      fixture.registry.insert(generationFixture)\n131|      return generationFixture.dependencies()\n132|    }\n133|    for expectedGeneration in 1...fixture.repetitions {\n134|      var hostOwner: M1HarnessHostOwner? = M1HarnessHostOwner(\n135|        dependencies: context.dependencies,\n136|        sessionFactory: sessionFactory\n137|      )\n138|      weak var weakHostOwner = hostOwner\n139|\n140|      let runtime = try await hostOwner!.makeRuntime(\n141|        configuration: try context.configuration.tunnelConfiguration(),\n142|      )\n143|      guard\n144|        let coordinator = runtime as? TunnelRuntimeCoordinator,\n145|        coordinator.runtimeGeneration == UInt64(expectedGeneration),\n146|        let generationFixture = fixture.registry.generation(UInt64(expectedGeneration))\n147|      else {\n148|        throw M1RuntimeHarnessError.runtimeInvariant\n149|      }\n150|\n151|      do {\n152|        try await runtime.start()\n153|      } catch {\n154|        guard fixture.scenario.isStartupFailure,\n155|          generationFixture.injectionWasObserved()\n156|        else {\n157|          throw error\n158|        }\n159|        try await generationFixture.verifyAfterStop(runtime: runtime)\n160|        throw M1RuntimeHarnessError.injected(fixture.scenario)\n161|      }\n162|\n163|      guard !fixture.scenario.isStartupFailure else {\n164|        await runtime.stop(reason: .startupFailure)\n165|        throw M1RuntimeHarnessError.injectionNotObserved\n166|      }\n167|      try await generationFixture.verifyReady(runtime: runtime)\n168|\n169|      hostOwner = nil\n170|      guard weakHostOwner == nil else {\n171|        await runtime.stop(reason: .providerFailure)\n172|        throw M1RuntimeHarnessError.hostLifetimeInvariant\n173|      }\n174|\n175|      try await generationFixture.exchangeRepresentativeTraffic()\n176|      try generationFixture.requestAndVerifyDiagnostics()\n177|\n178|      switch fixture.scenario {\n179|      case .midSessionSSHFailure, .midSessionDNSFailure:\n180|        try await generationFixture.injectMandatoryLoss()\n181|        try await generationFixture.awaitMandatoryFailure(runtime: runtime)\n182|        await runtime.stop(reason: .providerFailure)\n183|        try await generationFixture.verifyAfterStop(runtime: runtime)\n184|        throw M1RuntimeHarnessError.injected(fixture.scenario)\n185|      case .success:\n186|        await runtime.stop(reason: .userInitiated)\n187|        try await generationFixture.verifyAfterStop(runtime: runtime)\n188|      case .authenticationFailure, .packetFailure, .dnsFailure, .routeApplyFailure:\n189|        throw M1RuntimeHarnessError.injectionNotObserved\n190|      }\n191|    }\n192|\n193|    let metrics = context.dependencies.runtime.metrics\n194|    await metrics.incrementCounter(\n195|      named: \"harness.m1.generations_total\",\n196|      by: UInt64(fixture.repetitions)\n197|    )\n198|    await metrics.incrementCounter(\n199|      named: \"harness.m1.tcp_fixture_exchanges_total\",\n200|      by: UInt64(fixture.repetitions)\n201|    )\n202|    await metrics.incrementCounter(\n203|      named: \"harness.m1.dns_fixture_exchanges_total\",\n204|      by: UInt64(fixture.repetitions)\n205|    )\n206|    for resource in [\"descriptor\", \"task\", \"channel\", \"socket\", \"native_runtime\"] {\n207|      await metrics.setGauge(named: \"harness.m1.\\(resource)_growth\", to: 0)\n208|    }\n209|    await metrics.setGauge(named: \"harness.m1.host_owner_retained\", to: 0)\n210|  }\n211|}\n212|\n213|public struct M1RuntimeHarnessPacketEndpointFactory: HarnessPacketEndpointFactory {\n214|  public init() {}\n215|\n216|  public func makePacketFlow() async throws -> any PacketFlow {\n217|    M1HarnessPacketFlow()\n218|  }\n219|}\n220|\n221|private let m1DNSFixtureEndpoint = TunnelEndpoint(host: \"192.0.2.53\", port: 53)\n222|private let m1TCPFixtureEndpoint = TunnelEndpoint(host: \"198.51.100.80\", port: 443)\n223|private let m1OriginatorFixtureEndpoint = TunnelEndpoint(host: \"192.0.2.2\", port: 49_152)\n224|private let m1TCPRequest = Data(\"GET /fixture HTTP/1.0\\r\\n\\r\\n\".utf8)\n225|private let m1TCPResponse = Data(\"HTTP/1.0 204 Fixture\\r\\n\\r\\n\".utf8)\n226|private let m1DNSQuery = Data([0x12, 0x34, 0x01, 0x00])\n227|private let m1DNSResponse = Data([0x12, 0x34, 0x81, 0x80])\n228|\n229|/// Simulates the containing host's ownership of the composition/bootstrap\n230|/// boundary. The returned runtime must retain everything needed for forwarding\n231|/// because this owner is released immediately after readiness.\n232|private final class M1HarnessHostOwner {\n233|  private let composition: HarnessCoreComposition\n234|  private let sessionFactory: DeterministicHarnessSessionFactory\n235|\n236|  init(\n237|    dependencies: HarnessCommandDependencies,\n238|    sessionFactory: DeterministicHarnessSessionFactory\n239|  ) {\n240|    composition = HarnessCoreComposition(dependencies: dependencies)\n241|    self.sessionFactory = sessionFactory\n242|  }\n243|\n244|  func makeRuntime(\n245|    configuration: TunnelConfiguration\n246|  ) async throws -> any TunnelRuntime {\n247|    try await composition.makeRuntime(\n248|      configuration: configuration,\n249|      factory: sessionFactory\n250|    )\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
