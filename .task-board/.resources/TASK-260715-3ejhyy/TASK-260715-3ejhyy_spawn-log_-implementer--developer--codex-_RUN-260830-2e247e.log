    _ errorCode: ProviderNSErrorCode,
    cancelTunnelWithError: @escaping ProviderCancelTunnelHandler
  ) {
    adapter.providerDidFail(errorCode, cancelTunnelWithError: cancelTunnelWithError)
  }
}
