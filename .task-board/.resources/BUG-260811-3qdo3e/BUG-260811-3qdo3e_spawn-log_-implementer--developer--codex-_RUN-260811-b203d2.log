  printf 'unfiltered %02d: exit=%d elapsed=%ds %s\\n' \""'$i" "$rc" "$elapsed" "$result"
  if (( rc != 0 )); then tail -120 "$log"; exit "$rc"; fi
  if [[ -z "$count" || "$count" -lt 426 ]]; then tail -120 "$log"; exit 86; fi
