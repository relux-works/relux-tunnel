  "c1AuthorizationScope": {
    "authorizedAppIds": [
      "works.relux.tunnel.mac",
      "works.relux.tunnel.mac.tunnel",
      "works.relux.tunnel.probe.mac",
      "works.relux.tunnel.probe.mac.tunnel"
    ],
    "authorizedAppGroups": [],
    "authorizedCapabilities": [
      "Network Extensions capability on the four macOS App IDs"
    ],
    "authorizedProfiles": [
      "one Mac Development profile per macOS App ID, with this Apple-silicon Mac registered"
    ],
    "authorizedChannels": [
      "development"
    ],
    "authorizedNetworkExtensionValues": [
      "packet-tunnel-provider"
    ],
    "capabilityValueNote": "The portal capability is enabled per App ID by NAME ('Network Extensions'); the entitlement VALUES that end up authorized are a property of the profile class then generated. Because C1 creates Mac Development profiles only, the values C1 puts in circulation are the unsuffixed ones. The '-systemextension' values enter only with the Developer ID profiles owned by TASK-260715-3gkwn0, outside C1. The operator is therefore never asked to select an entitlement value at C1.",
    "explicitlyNotAuthorized": [
      "works.relux.tunnel.ios",
      "works.relux.tunnel.ios.tunnel",
      "works.relux.tunnel.probe.ios",
      "works.relux.tunnel.probe.ios.tunnel",
      "any Developer ID or App Store distribution profile",
      "any change to works.relux.proxy",
      "any App Group record, including group.works.relux.tunnel and group.works.relux.tunnel.probe",
      "the App Groups capability on any App ID"
    ],
    "appGroupNote": "r4: Ceremony C1 creates NO App Group record and enables the App Groups capability on NO App ID. Rule G4 prohibits com.apple.security.application-groups on every macOS target, so no C1-authorized App ID needs it, and the two records' only consumers are the four iOS App IDs that C1 explicitly does not authorize. The records are allocated when iOS re-arms under ADR-024. This shrinks the ceremony; it adds no sitting that ADR-024 did not already require."
  },
  "authorizesPortalMutationBy": "TASK-260715-3jloqy",
  "humanAuthorizationNode": "TASK-260728-q5kjta",
  "amendmentRule": "This matrix is amended only by TASK-260715-ypo7yo (or a successor task that explicitly assumes ownership), on the strength of a named resolving task. An amendment MUST update this JSON, bump revision, append to revisionLog, keep validate_matrix.py passing, and state which open constraint it closes. Downstream tasks do not locally reinterpret a row; they raise a blocker against the owner.",
  "consumers": [
    "TASK-260728-q5kjta — Ceremony C1 authorization scope",
    "TASK-260715-3jloqy — portal mutation and verification",
    "TASK-260715-1r0fxv / TASK-260715-9yp8to — macOS probe and Gate P0",
    "TASK-260715-uyju7n / TASK-260715-33oofa — generated targets",
    "TASK-260715-379cpk / TASK-260715-1o9wjz — keychain vault and extension resolver",
    "TASK-260715-3f4lxy — profile snapshot loader",
    "TASK-260715-1tzaed — macOS release identity contract",
    "TASK-260715-3gkwn0 — Developer ID / notary environment",
    "TASK-260715-3661ps — iOS TestFlight / App Store",
    "TASK-260715-3dno4w — iOS profile inspection",
    "TASK-260728-7ii1xz — macOS credential transport (OC-1, OC-4)"
  ],
  "downstreamConsequences": [
    {
      "owner": "TASK-260728-q5kjta",
      "consequence": "Ceremony C1 shrinks. Step 3 no longer creates group.works.relux.tunnel or group.works.relux.tunnel.probe and no longer enables the App Groups capability on any of the four macOS App IDs. The Network Extensions capability and the four Mac Development profiles are unchanged. Fewer portal mutations, same sitting."
    },
    {
      "owner": "TASK-260715-3jloqy",
      "consequence": "Portal verification must assert the NEGATIVE: none of the four macOS App IDs has App Groups enabled, and no Mac Development profile's Entitlements dict carries com.apple.security.application-groups. Assertion A16."
    },
    {
      "owner": "TASK-260715-uyju7n",
      "consequence": "Generated macOS targets must NOT declare com.apple.security.application-groups, and Xcode's App Groups capability must not be added to them. G1's instruction about the Register App Groups build setting now applies to iOS targets only. A macOS .entitlements file carrying the key fails A16."
    },
    {
      "owner": "TASK-260715-1r0fxv",
      "consequence": "The macOS probe pair carries no App Group and no keychain group. Its entitlement inspection (its AC5) gains A16 as a negative check. The probe's app-message path is unaffected - sendProviderMessage needs no App Group."
    },
    {
      "owner": "TASK-260715-3f4lxy",
      "consequence": "The macOS profile snapshot loader cannot read an App Group container and cannot fall back to one. On macOS the non-secret snapshot arrives in providerConfiguration; on iOS the App Group container remains correct. This is the same revision TASK-260728-7ii1xz section 8 already assigns."
    },
    {
      "owner": "TASK-260715-1tzaed",
      "consequence": "PlatformVPNIdentity (Sources/ReluxTunnelCore/VPNManagerRepository.swift:17) declares appGroupIdentifier as a non-optional String for both platforms, and production(for:) still throws. When that binding is authored there is no macOS App Group value to supply. The shape must change - most plainly to an optional or a platform-keyed identity - and this matrix is the input that forces it. No product source was changed by this revision."
    },
    {
      "owner": "spec amendment, owner TASK-260715-35nc5m",
      "consequence": ".spec/architecture.md:111 ('Shared mutable state is limited to an App Group configuration snapshot and Keychain references') and .spec/threat-model.md DF-02 / M-02 state an iOS property as if it were cross-platform. On macOS neither half holds: the group container is not shared and the secret lives in the root-unlocked system-domain keychain rather than the user's password-protected Data Protection Keychain. TASK-260728-7ii1xz already flags security-claims.md and threat-model.md M-02; architecture.md:111 is added here. This matrix records the divergence; it does not edit the spec."
    }
  ],
