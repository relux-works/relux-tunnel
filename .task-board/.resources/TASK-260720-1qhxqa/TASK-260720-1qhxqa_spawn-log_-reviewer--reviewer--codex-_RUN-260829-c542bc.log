   279	        if character == '"':
   280	            in_string = True
   281	        elif character == "[":
   282	            depth += 1
   283	        elif character == "]":
   284	            depth -= 1
   285	            if depth == 0:
   286	                return block[opening + 1 : index]
   287	    raise BindingError(row, f"unterminated {field} array")
