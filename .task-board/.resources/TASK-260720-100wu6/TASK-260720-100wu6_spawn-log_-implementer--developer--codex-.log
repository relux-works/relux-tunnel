+    #expect(acceptedHost.evidence == evidence)
+    #expect(acceptedHost.outcome == .matchAccepted)
+
+    #expect(throws: SSHHostAcceptanceError.rejected(.changedRejected)) {
+      _ = try SSHHostKeyDecision.rejectChanged.acceptance(for: input)
