   195	    if not stat.S_ISREG(status.st_mode):
   196	        os.close(descriptor)
   197	        raise AssetManifestError(f"{label} is not a regular file")
   198	    if status.st_size > maximum_size:
   199	        os.close(descriptor)
   200	        raise AssetManifestError(f"{label} exceeds its size limit")
   201	    if expected_size is not None and status.st_size != expected_size:
   202	        os.close(descriptor)
   203	        raise AssetManifestError(f"{label} size does not match the manifest")
