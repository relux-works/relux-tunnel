+  @Test("bounded diagnostics drops still reconcile every current TCP gauge")
+  func boundedDiagnosticsGaugeConvergence() async throws {
+    let (snapshotEntered, snapshotEnteredContinuation) = AsyncStream<Void>.makeStream()
