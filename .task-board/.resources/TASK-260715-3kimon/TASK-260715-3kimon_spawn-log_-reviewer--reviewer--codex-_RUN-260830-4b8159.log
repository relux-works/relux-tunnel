   494	  public mutating func reserveAdjustment(
   495	    channel: SSHChannelIdentity,
   496	    generation: UInt64,
   497	    outstandingAdvertisedCreditBytes: Int
   498	  ) throws -> SSHReceiveWindowAdjustmentDecision {
   499	    do {
   500	      guard generation == self.generation else { throw SSHReceiveWindowRefusal.staleGeneration }
   501	      guard var reservation = reservations[channel] else {
   502	        throw SSHReceiveWindowRefusal.unknownChannel
   503	      }
   504	      _ = try availableLane(reservation.lane, generation: generation)
   505	      guard pressure == .normal || pressure == .soft else {
   506	        throw SSHReceiveWindowRefusal.memoryPressure
   507	      }
   508	      guard outstandingAdvertisedCreditBytes >= 0,
   509	        outstandingAdvertisedCreditBytes <= reservation.capBytes,
   510	        outstandingAdvertisedCreditBytes <= reservation.reservedWindowBytes
   511	      else { throw SSHReceiveWindowRefusal.invalidOutstandingCredit }
   512	      guard outstandingAdvertisedCreditBytes <= reservation.lowWaterBytes else {
   513	        throw SSHReceiveWindowRefusal.aboveLowWater
   514	      }
   515	
   516	      let advertisedHeadroom = reservation.capBytes - outstandingAdvertisedCreditBytes
   517	      let reservationHeadroom = reservation.capBytes - reservation.reservedWindowBytes
   518	      let reusableReservedBytes =
   519	        reservation.reservedWindowBytes - outstandingAdvertisedCreditBytes
   520	      let laneHeadroom =
   521	        configuration.perLaneWindowCeilingBytes - laneReservedBytes(reservation.lane)
   522	      let globalHeadroom = configuration.globalWindowCeilingBytes - globalWindowReservedBytes
   523	      let ledgerHeadroom = configuration.globalLedgerCeilingBytes - ledgerCommittedBytes
   524	      let newlyReservableBytes = min(
   525	        reservationHeadroom, laneHeadroom, globalHeadroom, ledgerHeadroom)
   526	      let availableAdjustmentBytes = reusableReservedBytes + newlyReservableBytes
   527	      let adjustmentBytes = min(advertisedHeadroom, availableAdjustmentBytes)
   528	      guard adjustmentBytes > 0 else {
   529	        throw SSHReceiveWindowRefusal.insufficientReservation
   530	      }
   531	      let newlyReservedBytes = max(0, adjustmentBytes - reusableReservedBytes)
   532	      let (after, overflow) = outstandingAdvertisedCreditBytes.addingReportingOverflow(
   533	        adjustmentBytes)
   534	      guard !overflow, after <= reservation.capBytes else {
   535	        throw SSHReceiveWindowRefusal.immutableChannelCap
   536	      }
   537	      reservation.reservedWindowBytes += newlyReservedBytes
   538	      reservations[channel] = reservation
   539	      metrics.adjustmentReservations += 1
   540	      metrics.adjustmentBytes = metrics.adjustmentBytes.saturatingAdd(UInt64(adjustmentBytes))
   541	      return SSHReceiveWindowAdjustmentDecision(
   542	        channel: channel,
   543	        beforeOutstandingCreditBytes: outstandingAdvertisedCreditBytes,
   544	        adjustmentBytes: adjustmentBytes,
   545	        afterOutstandingCreditBytes: after,
   546	        newlyReservedBytes: newlyReservedBytes)
   547	    } catch let refusal as SSHReceiveWindowRefusal {
   548	      recordRefusal(refusal)
   549	      throw refusal
   550	    }
   551	  }
