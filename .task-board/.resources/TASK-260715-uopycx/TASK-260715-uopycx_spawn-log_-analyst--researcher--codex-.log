    38	#ifndef LWIP_LWIPOPTS_H
    39	#define LWIP_LWIPOPTS_H
    40	
    41	/*
    42	 * Include user defined options first. Anything not defined in these files
    43	 * will be set to standard values. Override anything you don't like!
    44	 */
    45	#include "lwipopts.h"
    46	#include "lwip/debug.h"
    47	
    48	/*
    49	   -----------------------------------------------
    50	   ---------- Platform specific locking ----------
    51	   -----------------------------------------------
    52	*/
    53	
    54	/**
    55	 * SYS_LIGHTWEIGHT_PROT==1: if you want inter-task protection for certain
    56	 * critical regions during buffer allocation, deallocation and memory
    57	 * allocation and deallocation.
    58	 */
    59	#define SYS_LIGHTWEIGHT_PROT            0
    60	
    61	/**
    62	 * NO_SYS==1: Provides VERY minimal functionality. Otherwise,
    63	 * use lwIP facilities.
    64	 */
    65	#define NO_SYS                          1
    66	
    67	/**
    68	 * LWIP_TIMERS==0: Drop support for sys_timeout and lwip-internal cyclic timers.
    69	 * (the array of lwip-internal cyclic timers is still provided)
    70	 * (check NO_SYS_NO_TIMERS for compatibility to old versions)
    71	 */
    72	#define LWIP_TIMERS                     0
    73	
    74	/**
    75	 * LWIP_DONT_PROVIDE_BYTEORDER_FUNCTIONS: Don't provides byte order
    76	 * functions.
    77	 */
    78	#ifndef LWIP_DONT_PROVIDE_BYTEORDER_FUNCTIONS
    79	#define LWIP_DONT_PROVIDE_BYTEORDER_FUNCTIONS
    80	#endif
    81	
    82	/*
    83	   ------------------------------------
    84	   ---------- Memory options ----------
    85	   ------------------------------------
    86	*/
    87	
    88	/**
    89	 * MEM_ALIGNMENT: should be set to the alignment of the CPU
    90	 *    4 byte alignment -> #define MEM_ALIGNMENT 4
    91	 *    2 byte alignment -> #define MEM_ALIGNMENT 2
    92	 */
    93	#define MEM_ALIGNMENT                   4U
    94	
    95	/**
    96	 * MEM_CUSTOM_ALLOCATOR==1: Use malloc/free/realloc provided by a custom
    97	 * implementation instead of the lwip internal allocator. Can save code size if
    98	 * you already use it. If enabled, you have to define those functions:
    99	 */
   100	#define MEM_CUSTOM_ALLOCATOR            1
   101	
   102	void hev_free (void *ptr);
   103	#define MEM_CUSTOM_FREE hev_free
   104	
   105	void *hev_malloc (size_t size);
   106	#define MEM_CUSTOM_MALLOC hev_malloc
   107	
   108	void *hev_calloc (size_t nmemb, size_t size);
   109	#define MEM_CUSTOM_CALLOC hev_calloc
   110	
   111	/*
   112	   ------------------------------------------------
   113	   ---------- Internal Memory Pool Sizes ----------
   114	   ------------------------------------------------
   115	*/
   116	/**
   117	 * MEMP_NUM_PBUF: the number of memp struct pbufs (used for PBUF_ROM and PBUF_REF).
   118	 * If the application sends a lot of data out of ROM (or other static memory),
   119	 * this should be set high.
   120	 */
   121	#define MEMP_NUM_PBUF                   8192
   122	
   123	/**
   124	 * MEMP_NUM_RAW_PCB: Number of raw connection PCBs
   125	 * (requires the LWIP_RAW option)
   126	 */
   127	#define MEMP_NUM_RAW_PCB                4
   128	
   129	/**
   130	 * MEMP_NUM_UDP_PCB: the number of UDP protocol control blocks. One
   131	 * per active UDP "connection".
   132	 * (requires the LWIP_UDP option)
   133	 */
   134	#define MEMP_NUM_UDP_PCB                1024
   135	
   136	/**
   137	 * MEMP_NUM_TCP_PCB: the number of simulatenously active TCP connections.
   138	 * (requires the LWIP_TCP option)
   139	 */
   140	#define MEMP_NUM_TCP_PCB                4096
   141	
   142	/**
   143	 * MEMP_NUM_TCP_PCB_LISTEN: the number of listening TCP connections.
   144	 * (requires the LWIP_TCP option)
   145	 */
   146	#define MEMP_NUM_TCP_PCB_LISTEN         16
   147	
   148	/**
   149	 * MEMP_NUM_TCP_SEG: the number of simultaneously queued TCP segments.
   150	 * (requires the LWIP_TCP option)
   151	 */
   152	#define MEMP_NUM_TCP_SEG                8192
   153	
   154	/**
   155	 * MEMP_NUM_REASSDATA: the number of simultaneously IP packets queued for
   156	 * reassembly (whole packets, not fragments!)
   157	 */
   158	#define MEMP_NUM_REASSDATA              1
   159	
   160	/**
   161	 * MEMP_NUM_ARP_QUEUE: the number of simulateously queued outgoing
   162	 * packets (pbufs) that are waiting for an ARP request (to resolve
   163	 * their destination address) to finish.
   164	 * (requires the ARP_QUEUEING option)
   165	 */
   166	#define MEMP_NUM_ARP_QUEUE              2
   167	
   168	/**
   169	 * MEMP_NUM_SYS_TIMEOUT: the number of simulateously active timeouts.
   170	 * (requires NO_SYS==0)
   171	 */
   172	#define MEMP_NUM_SYS_TIMEOUT            8
   173	
   174	/**
   175	 * MEMP_NUM_NETBUF: the number of struct netbufs.
   176	 * (only needed if you use the sequential API, like api_lib.c)
   177	 */
   178	#define MEMP_NUM_NETBUF                 2
   179	
   180	/**
   181	 * MEMP_NUM_NETCONN: the number of struct netconns.
   182	 * (only needed if you use the sequential API, like api_lib.c)
   183	 */
   184	#define MEMP_NUM_NETCONN               32
   185	
   186	/**
   187	 * MEMP_NUM_TCPIP_MSG_API: the number of struct tcpip_msg, which are used
   188	 * for callback/timeout API communication.
   189	 * (only needed if you use tcpip.c)
   190	 */
   191	#define MEMP_NUM_TCPIP_MSG_API          8
   192	
   193	/**
   194	 * MEMP_NUM_TCPIP_MSG_INPKT: the number of struct tcpip_msg, which are used
   195	 * for incoming packets.
   196	 * (only needed if you use tcpip.c)
   197	 */
   198	#define MEMP_NUM_TCPIP_MSG_INPKT        8
   199	
   200	/**
   201	 * PBUF_POOL_SIZE: the number of buffers in the pbuf pool.
   202	 */
   203	#define PBUF_POOL_SIZE                  32
   204	
   205	/*
   206	   ---------------------------------
   207	   ---------- ARP options ----------
   208	   ---------------------------------
   209	*/
   210	/**
   211	 * LWIP_ARP==1: Enable ARP functionality.
   212	 */
   213	#define LWIP_ARP                        0
   214	
   215	/*
   216	   --------------------------------
   217	   ---------- IP options ----------
   218	   --------------------------------
   219	*/
   220	/**
   221	 * IP_FORWARD==1: Enables the ability to forward IP packets across network
   222	 * interfaces. If you are going to run lwIP on a device with only one network
   223	 * interface, define this to 0.
   224	 */
   225	#define IP_FORWARD                      0
   226	
   227	/**
   228	 * IP_OPTIONS: Defines the behavior for IP options.
   229	 *      IP_OPTIONS_ALLOWED==0: All packets with IP options are dropped.
   230	 *      IP_OPTIONS_ALLOWED==1: IP options are allowed (but not parsed).
   231	 */
   232	#define IP_OPTIONS_ALLOWED              1
   233	
   234	/**
   235	 * IP_REASSEMBLY==1: Reassemble incoming fragmented IP packets. Note that
   236	 * this option does not affect outgoing packet sizes, which can be controlled
   237	 * via IP_FRAG.
   238	 */
   239	#define IP_REASSEMBLY                   1
   240	
   241	/**
   242	 * IP_FRAG==1: Fragment outgoing IP packets if their size exceeds MTU. Note
   243	 * that this option does not affect incoming packet sizes, which can be
   244	 * controlled via IP_REASSEMBLY.
   245	 */
   246	#define IP_FRAG                         1
   247	
   248	/**
   249	 * IP_REASS_MAXAGE: Maximum time (in multiples of IP_TMR_INTERVAL - so seconds, normally)
   250	 * a fragmented IP packet waits for all fragments to arrive. If not all fragments arrived
   251	 * in this time, the whole packet is discarded.
   252	 */
   253	#define IP_REASS_MAXAGE                 3
   254	
   255	/**
   256	 * IP_REASS_MAX_PBUFS: Total maximum amount of pbufs waiting to be reassembled.
   257	 * Since the received pbufs are enqueued, be sure to configure
   258	 * PBUF_POOL_SIZE > IP_REASS_MAX_PBUFS so that the stack is still able to receive
   259	 * packets even if the maximum amount of fragments is enqueued for reassembly!
   260	 */
   261	#define IP_REASS_MAX_PBUFS              4
   262	
   263	/**
   264	 * IP_FRAG_USES_STATIC_BUF==1: Use a static MTU-sized buffer for IP
   265	 * fragmentation. Otherwise pbufs are allocated and reference the original
   266	    * packet data to be fragmented.
   267	*/
   268	#define IP_FRAG_USES_STATIC_BUF         0
   269	
   270	/**
   271	 * IP_DEFAULT_TTL: Default value for Time-To-Live used by transport layers.
   272	 */
   273	#define IP_DEFAULT_TTL                  255
   274	
   275	/*
   276	   ---------------------------------------
   277	   ---------- IPv6 options ---------------
   278	   ---------------------------------------
   279	*/
   280	/**
   281	 * LWIP_IPV6==1: Enable IPv6 module.
   282	 */
   283	#define LWIP_IPV6                       1
   284	
   285	#ifdef __LP64__
   286	#define IPV6_FRAG_COPYHEADER            1
   287	#endif
   288	
   289	/*
   290	   ----------------------------------
   291	   ---------- ICMP options ----------
   292	   ----------------------------------
   293	*/
   294	/**
   295	 * LWIP_ICMP==1: Enable ICMP module inside the IP stack.
   296	 * Be careful, disable that make your product non-compliant to RFC1122
   297	 */
   298	#define LWIP_ICMP                       1
