      isOnDemandEnabled: manager.isOnDemandEnabled,
      hasOnDemandRules: !(manager.onDemandRules?.isEmpty ?? true),
      hasAppRules: !manager.appRules.isEmpty,
      sessionStatus: VPNManagerSessionStatus(manager.connection.status)
