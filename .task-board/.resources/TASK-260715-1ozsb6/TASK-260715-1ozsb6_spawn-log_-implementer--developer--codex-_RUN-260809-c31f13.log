   928	    guard initialReceiveWindowBytes <= maximumAdvertisedReceiveWindowBytes else {
   929	      throw SSHContractValidationError.initialReceiveWindowExceedsCap
   930	    }
   931	    guard windowAdjustThresholdBytes <= maximumAdvertisedReceiveWindowBytes else {
   932	      throw SSHContractValidationError.windowAdjustThresholdExceedsCap
   933	    }
   934	    self.initialReceiveWindowBytes = initialReceiveWindowBytes
   935	    self.maximumAdvertisedReceiveWindowBytes = maximumAdvertisedReceiveWindowBytes
   936	    self.windowAdjustThresholdBytes = windowAdjustThresholdBytes
   937	  }
