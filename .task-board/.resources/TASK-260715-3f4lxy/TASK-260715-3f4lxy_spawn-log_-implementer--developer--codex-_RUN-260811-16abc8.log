+          throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
+        }
+      }
+      if record.revocationReason != nil, revocationReason == nil {
+        throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
+      }
