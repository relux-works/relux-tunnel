 /// Public-API adapter for the macOS provider's `NEPacketTunnelFlow`.
diff --git a/Sources/ReluxTunnelMacOSAdapter/MacOSSystemKeychainCredentialResolver.swift b/Sources/ReluxTunnelMacOSAdapter/MacOSSystemKeychainCredentialResolver.swift
new file mode 100644
index 0000000000000000000000000000000000000000..97a088b3d7af38c608d59f6b3bf0df19bc90c61b
