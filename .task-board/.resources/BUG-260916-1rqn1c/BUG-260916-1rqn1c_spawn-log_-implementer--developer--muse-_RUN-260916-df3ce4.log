{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c611","stream":{"kind":"session","id":"01a0aa36-84df-7ea0-97e7-e05c9626f459"},"sequence":355,"recorded_at":1780531400000705,"record_type":"event","durability":"durable","causation_id":"c23023ed-e109-49ec-9468-86fe7a097ec0","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c23023ed-e109-49ec-9468-86fe7a097ec0","run_stream":{"kind":"run","id":"c23023ed-e109-49ec-9468-86fe7a097ec0"},"call_id":"call_01a0aa37555176fbbafcae51033399f0","text":"Read text file `scripts/select-native-xcode.sh`.\n1|#!/bin/sh\n2|# Select the Xcode that produced the pinned native artifacts, then prove it.\n3|#\n4|# NativeDependencies/manifest.json pins a single Xcode build for both native\n5|# dependencies (libssh2-openssl compiler.xcode_build and hev-lwip\n6|# rebuild.xcode_build). Verification (scripts/libssh2-fork-tool.py verify)\n7|# rejects any other build, so the hosted job must select the pinned Xcode\n8|# explicitly instead of relying on the runner default. Unknown or disagreeing\n9|# pins are refused: supporting a new toolchain is an explicit decision with\n10|# rebuilt artifacts, never silent drift.\n11|set -eu\n12|\n13|repo_root=$(CDPATH='' cd -- \"$(dirname -- \"$0\")/..\" && pwd)\n14|manifest=${RELUX_NATIVE_MANIFEST:-\"$repo_root/NativeDependencies/manifest.json\"}\n15|\n16|pins=$(python3 - \"$manifest\" <<'PY'\n17|import json\n18|import sys\n19|\n20|try:\n21|    with open(sys.argv[1], encoding=\"utf-8\") as handle:\n22|        manifest = json.load(handle)\n23|    dependencies = manifest[\"dependencies\"]\n24|    libssh2 = dependencies[\"libssh2-openssl\"][\"compiler\"][\"xcode_build\"]\n25|    hev = dependencies[\"hev-lwip\"][\"rebuild\"][\"xcode_build\"]\n26|except (OSError, ValueError, KeyError, TypeError) as error:\n27|    print(f\"select-native-xcode: cannot read pinned Xcode builds: {error}\", file=sys.stderr)\n28|    raise SystemExit(2)\n29|if not libssh2 or not hev:\n30|    print(\"select-native-xcode: pinned Xcode build is empty\", file=sys.stderr)\n31|    raise SystemExit(2)\n32|if libssh2 != hev:\n33|    print(f\"select-native-xcode: refusing disagreeing pins: libssh2 {libssh2}, hev {hev}\",\n34|          file=sys.stderr)\n35|    raise SystemExit(2)\n36|print(libssh2)\n37|PY\n38|)\n39|expected_build=$pins\n40|\n41|# Pinned build -> installed Xcode, per the official runner inventory\n42|# (actions/runner-images images/macos/macos-26-arm64-Readme.md). A build with\n43|# no row here has no supported hosted Xcode and must be refused, not guessed.\n44|# RELUX_XCODE_ROOT exists only so tests can stage a fake install tree; hosted\n45|# runners always use the /Applications default below.\n46|xcode_root=${RELUX_XCODE_ROOT:-/Applications}\n47|case \"$expected_build\" in\n48|  17F42) xcode_app=\"$xcode_root/Xcode_26.5.app\" ;;\n49|  *)\n50|    echo \"select-native-xcode: no supported hosted Xcode for pinned build $expected_build\" >&2\n51|    exit 2\n52|    ;;\n53|esac\n54|\n55|if [ ! -d \"$xcode_app\" ]; then\n56|  echo \"select-native-xcode: expected $xcode_app is not installed\" >&2\n57|  exit 2\n58|fi\n59|\n60|developer_dir=\"$xcode_app/Contents/Developer\"\n61|current_dir=$(xcode-select -p)\n62|if [ \"$current_dir\" != \"$developer_dir\" ]; then\n63|  sudo xcode-select -s \"$developer_dir\"\n64|fi\n65|\n66|version_output=$(xcodebuild -version)\n67|case \"$version_output\" in\n68|  *\"Build version $expected_build\"*) ;;\n69|  *)\n70|    echo \"select-native-xcode: Xcode build mismatch: expected Build version $expected_build, got $version_output\" >&2\n71|    exit 1\n72|    ;;\n73|esac\n74|\n75|echo \"select-native-xcode: using $xcode_app (Build version $expected_build)\"","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c613","stream":{"kind":"session","id":"01a0aa36-84df-7ea0-97e7-e05c9626f459"},"sequence":356,"recorded_at":1780531400000707,"record_type":"event","durability":"durable","causation_id":"c23023ed-e109-49ec-9468-86fe7a097ec0","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c23023ed-e109-49ec-9468-86fe7a097ec0","run_stream":{"kind":"run","id":"c23023ed-e109-49ec-9468-86fe7a097ec0"},"call_id":"call_01a0aa37569877deb7e9fc708135813b","text":"Read text file `scripts/tests/test_native_toolchain_alignment.py`.\n1|\"\"\"Native toolchain alignment: hosted runner must provide the manifest-pinned Xcode.\n2|\n3|Production entry points:\n4|  scripts/select-native-xcode.sh (invoked by the credential-free CI job)\n5|  .github/workflows/ci.yml (job selects the image, script selects the Xcode)\n6|\n7|Fixtures never touch the real xcode-select/xcodebuild: every behavioral case\n8|runs the production script with PATH shims and a fixture manifest.\n9|\"\"\"\n10|import json\n11|import os\n12|import stat\n13|import subprocess\n14|import tempfile\n15|import unittest\n16|from pathlib import Path\n17|\n18|ROOT = Path(__file__).resolve().parents[2]\n19|MANIFEST = ROOT / \"NativeDependencies/manifest.json\"\n20|WORKFLOW = ROOT / \".github/workflows/ci.yml\"\n21|SCRIPT = ROOT / \"scripts/select-native-xcode.sh\"\n22|\n23|# Independent oracle from the official GitHub runner-images inventory\n24|# (images/macos/macos-26-arm64-Readme.md, image 20260907.0351.1):\n25|# Xcode 26.5 build 17F42 ships at /Applications/Xcode_26.5.app on macos-26,\n26|# whose default is Xcode 26.6 build 17F113. macos-15 tops out at Xcode 26.3\n27|# build 17C529 with default Xcode 16.4 build 16F6, so it cannot host the pin.\n28|EXPECTED_APP_NAME_BY_BUILD = {\"17F42\": \"Xcode_26.5.app\"}\n29|REQUIRED_RUNS_ON = \"macos-26\"\n30|\n31|\n32|def manifest_pins(manifest_path):\n33|    manifest = json.loads(Path(manifest_path).read_text(encoding=\"utf-8\"))\n34|    libssh2 = manifest[\"dependencies\"][\"libssh2-openssl\"][\"compiler\"][\"xcode_build\"]\n35|    hev = manifest[\"dependencies\"][\"hev-lwip\"][\"rebuild\"][\"xcode_build\"]\n36|    return libssh2, hev\n37|\n38|\n39|def credential_free_job_block():\n40|    \"\"\"Extract the raw YAML block of the credential-free job without pyyaml.\"\"\"\n41|    lines = WORKFLOW.read_text(encoding=\"utf-8\").splitlines()\n42|    begin = next(index for index, line in enumerate(lines)\n43|                 if line == \"  generated-project-credential-free:\")\n44|    end = next((index for index in range(begin + 1, len(lines))\n45|                if lines[index] and not lines[index].startswith(\" \")\n46|                or lines[index].startswith(\"  \") and not lines[index].startswith(\"   \")),\n47|               len(lines))\n48|    return \"\\n\".join(lines[begin:end])\n49|\n50|\n51|def write_shim(path, body):\n52|    path.write_text(body, encoding=\"utf-8\")\n53|    path.chmod(path.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)\n54|\n55|\n56|def run_selection_script(fixture_manifest, selected_name, xcodebuild_output,\n57|                         install_app=True):\n58|    \"\"\"Run the production script with shims and a staged install tree.\n59|\n60|    Returns (exit, stdout+stderr, calls, selected path, staged app root).\n61|    selected_name is an Xcode app bundle name inside the staged root.\n62|    \"\"\"\n63|    with tempfile.TemporaryDirectory(prefix=\"native-xcode-\") as directory:\n64|        root = Path(directory)\n65|        bin_dir = root / \"bin\"\n66|        bin_dir.mkdir()\n67|        apps_root = root / \"Apps\"\n68|        apps_root.mkdir()\n69|        if install_app:\n70|            # Stage the pinned app plus the macos-26 default as a decoy, so a\n71|            # mutant selecting the wrong app fails on the recorded path.\n72|            (apps_root / \"Xcode_26.5.app\").mkdir()\n73|            (apps_root / \"Xcode_26.6.app\").mkdir()\n74|        selected_file = root / \"selected\"\n75|        selected_file.write_text(f\"{apps_root}/{selected_name}/Contents/Developer\",\n76|                                 encoding=\"utf-8\")\n77|        call_log = root / \"calls.log\"\n78|        call_log.write_text(\"\", encoding=\"utf-8\")\n79|        write_shim(bin_dir / \"xcode-select\",\n80|                   '#!/bin/sh\\n'\n81|                   'echo \"xcode-select $*\" >> \"$CALL_LOG\"\\n'\n82|                   'if [ \"$1\" = \"-p\" ]; then cat \"$SELECTED_FILE\"; '\n83|                   'elif [ \"$1\" = \"-s\" ]; then printf \"%s\" \"$2\" > \"$SELECTED_FILE\"; '\n84|                   'else exit 9; fi\\n')\n85|        write_shim(bin_dir / \"xcodebuild\", '#!/bin/sh\\nprintf \"%s\" \"$XCODEBUILD_OUTPUT\"\\n')\n86|        write_shim(bin_dir / \"sudo\", '#!/bin/sh\\necho \"sudo $*\" >> \"$CALL_LOG\"\\nexec \"$@\"\\n')\n87|        manifest_file = root / \"manifest.json\"\n88|        manifest_file.write_text(fixture_manifest, encoding=\"utf-8\")\n89|        result = subprocess.run(\n90|            [\"sh\", str(SCRIPT)],\n91|            env={**os.environ, \"PATH\": f\"{bin_dir}:/usr/bin:/bin\",\n92|                 \"CALL_LOG\": str(call_log), \"SELECTED_FILE\": str(selected_file),\n93|                 \"XCODEBUILD_OUTPUT\": xcodebuild_output,\n94|                 \"RELUX_NATIVE_MANIFEST\": str(manifest_file),\n95|                 \"RELUX_XCODE_ROOT\": str(apps_root)},\n96|            capture_output=True, text=True)\n97|        return (result.returncode, result.stdout + result.stderr,\n98|                call_log.read_text(encoding=\"utf-8\"), selected_file.read_text(encoding=\"utf-8\"),\n99|                str(apps_root))\n100|\n101|\n102|def fixture_manifest(libssh2_pin, hev_pin=...):\n103|    hev = libssh2_pin if hev_pin is ... else hev_pin\n104|    return json.dumps({\"dependencies\": {\n105|        \"libssh2-openssl\": {\"compiler\": {\"xcode_build\": libssh2_pin}},\n106|        \"hev-lwip\": {\"rebuild\": {\"xcode_build\": hev}}}})\n107|\n108|\n109|class NativeToolchainAlignmentTests(unittest.TestCase):\n110|    def test_manifest_pins_agree_on_single_toolchain(self):\n111|        libssh2, hev = manifest_pins(MANIFEST)\n112|        self.assertTrue(libssh2, \"libssh2 pin is empty\")\n113|        self.assertEqual(hev, libssh2,\n114|                         \"native dependencies pin different Xcode builds; \"\n115|                         \"hosted selection is undefined until they agree\")\n116|\n117|    def test_workflow_runs_credential_free_job_on_macos26(self):\n118|        block = credential_free_job_block()\n119|        self.assertIn(f\"runs-on: {REQUIRED_RUNS_ON}\", block,\n120|                      \"credential-free job must run on macos-26: macos-15 ships \"\n121|                      \"at most Xcode 26.3 (17C529) and cannot provide the pinned 17F42\")\n122|        self.assertNotIn(\"runs-on: macos-15\\n\", block + \"\\n\")\n123|\n124|    def test_workflow_selects_pinned_xcode_before_gate(self):\n125|        block = credential_free_job_block()\n126|        self.assertIn(\"scripts/select-native-xcode.sh\", block,\n127|                      \"credential-free job must select the pinned Xcode explicitly: \"\n128|                      \"the macos-26 default (Xcode 26.6, 17F113) is not the pin\")\n129|        select = block.index(\"scripts/select-native-xcode.sh\")\n130|        gate = block.index(\"make credential-free-validate\")\n131|        self.assertLess(select, gate, \"Xcode selection must precede the credential-free gate\")\n132|\n133|    def test_selection_defaults_to_applications_root(self):\n134|        self.assertIn(\"xcode_root=${RELUX_XCODE_ROOT:-/Applications}\", SCRIPT.read_text(),\n135|                      \"hosted runners install Xcode under /Applications; the test-only \"\n136|                      \"override must never change the production default\")\n137|\n138|    def test_selection_maps_manifest_pin_to_documented_app(self):\n139|        libssh2, _ = manifest_pins(MANIFEST)\n140|        expected_name = EXPECTED_APP_NAME_BY_BUILD[libssh2]\n141|        exit_code, output, _, selected, apps_root = run_selection_script(\n142|            fixture_manifest(libssh2),\n143|            \"Xcode_26.6.app\",\n144|            f\"Xcode 26.5\\nBuild version {libssh2}\\n\")\n145|        self.assertEqual(exit_code, 0, output)\n146|        self.assertEqual(selected, f\"{apps_root}/{expected_name}/Contents/Developer\", output)\n147|\n148|    def test_selection_is_idempotent_when_already_selected(self):\n149|        libssh2, _ = manifest_pins(MANIFEST)\n150|        expected_name = EXPECTED_APP_NAME_BY_BUILD[libssh2]\n151|        exit_code, output, calls, _, _ = run_selection_script(\n152|            fixture_manifest(libssh2),\n153|            expected_name,\n154|            f\"Xcode 26.5\\nBuild version {libssh2}\\n\")\n155|        self.assertEqual(exit_code, 0, output)\n156|        self.assertNotIn(\"sudo xcode-select -s\", calls, output)\n157|\n158|    def test_selection_rejects_xcode16_default(self):\n159|        # Mirrors hosted run35091586150: macos-15 default Xcode 16.4 (16F6).\n160|        libssh2, _ = manifest_pins(MANIFEST)\n161|        exit_code, output, _, _, _ = run_selection_script(\n162|            fixture_manifest(libssh2),\n163|            \"Xcode_16.4.app\",\n164|            \"Xcode 16.4\\nBuild version 16F6\\n\")\n165|        self.assertNotEqual(exit_code, 0, output)\n166|        self.assertIn(\"mismatch\", output)\n167|\n168|    def test_selection_rejects_macos26_default_build(self):\n169|        # macos-26 default Xcode 26.6 (17F113) is close to but not the pin.\n170|        libssh2, _ = manifest_pins(MANIFEST)\n171|        exit_code, output, _, _, _ = run_selection_script(\n172|            fixture_manifest(libssh2),\n173|            \"Xcode_26.6.app\",\n174|            \"Xcode 26.6\\nBuild version 17F113\\n\")\n175|        self.assertNotEqual(exit_code, 0, output)\n176|        self.assertIn(\"mismatch\", output)\n177|\n178|    def test_selection_refuses_missing_install(self):\n179|        exit_code, output, _, _, _ = run_selection_script(\n180|            fixture_manifest(\"17F42\"),\n181|            \"Xcode_26.5.app\",\n182|            \"Xcode 26.5\\nBuild version 17F42\\n\",\n183|            install_app=False)\n184|        self.assertEqual(exit_code, 2, output)\n185|        self.assertIn(\"not installed\", output)\n186|\n187|    def test_selection_refuses_disagreeing_manifest_pins(self):\n188|        exit_code, output, _, _, _ = run_selection_script(\n189|            fixture_manifest(\"17F42\", \"17C529\"),\n190|            \"Xcode_26.5.app\",\n191|            \"Xcode 26.5\\nBuild version 17F42\\n\")\n192|        self.assertEqual(exit_code, 2, output)\n193|        self.assertIn(\"17F42\", output)\n194|        self.assertIn(\"17C529\", output)\n195|\n196|    def test_selection_refuses_unmapped_build(self):\n197|        # Xcode 26.3 (17C529) exists on runners but never produced the artifacts.\n198|        exit_code, output, _, _, _ = run_selection_script(\n199|            fixture_manifest(\"17C529\"),\n200|            \"Xcode_26.3.app\",\n201|            \"Xcode 26.3\\nBuild version 17C529\\n\")\n202|        self.assertEqual(exit_code, 2, output)\n203|        self.assertIn(\"17C529\", output)\n204|\n205|    def test_selection_refuses_missing_pin(self):\n206|        fixture = json.dumps({\"dependencies\": {\n207|            \"libssh2-openssl\": {\"compiler\": {\"xcode_build\": \"17F42\"}},\n208|            \"hev-lwip\": {\"rebuild\": {}}}})\n209|        exit_code, output, _, _, _ = run_selection_script(\n210|            fixture,\n211|            \"Xcode_26.5.app\",\n212|            \"Xcode 26.5\\nBuild version 17F42\\n\")\n213|        self.assertEqual(exit_code, 2, output)\n214|\n215|\n216|if __name__ == \"__main__\":\n217|    unittest.main()","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
