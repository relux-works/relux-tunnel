+private struct PhysicalProcessSnapshot: Sendable {
+  let physicalFootprintBytes: UInt64
+  let peakPhysicalFootprintBytes: UInt64
+  let availableMemoryBytes: UInt64?
+  let availableMemoryAvailability: String
+  let descriptors: Int
+  let threads: Int
+}
+
