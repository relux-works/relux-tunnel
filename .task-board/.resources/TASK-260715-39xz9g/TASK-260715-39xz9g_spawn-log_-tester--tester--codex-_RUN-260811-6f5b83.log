   204	class BuiltinProvider:
   205	    def __init__(self, state_root: Path | None = None):
   206	        configured = os.environ.get(STATE_ROOT_ENV)
   207	        self.state_root = Path(configured) if configured else (state_root or DEFAULT_STATE_ROOT)
   208	        self._processes: dict[int, subprocess.Popen[bytes]] = {}
   209	
   210	    def handle(self, request: Mapping[str, object]) -> dict:
   211	        if request.get("protocol") != "relux-ssh-matrix-provider-v1":
   212	            raise ProviderError("provider protocol mismatch")
   213	        server_id = request.get("serverId")
   214	        if server_id not in fixture.REQUIRED_SERVERS:
   215	            raise ProviderError("provider server ID is not in the fixture matrix")
   216	        action = request.get("action")
   217	        if action == "prepare":
   218	            return self._prepare(str(server_id))
   219	        if action == "rotate":
   220	            return self._rotate(str(server_id))
   221	        if action == "probe":
   222	            return self._probe(str(server_id))
   223	        if action == "control":
   224	            scenario_id = request.get("scenarioId")
   225	            if scenario_id not in fixture.SCENARIO_FIXTURE_EVIDENCE:
   226	                raise ProviderError("provider scenario control is not approved")
   227	            return self._control(str(server_id), str(scenario_id))
   228	        if action == "teardown":
   229	            return self._teardown(str(server_id))
   230	        raise ProviderError("provider action is not supported")
   231	
   232	    def _server_dir(self, server_id: str) -> Path:
   233	        return self.state_root / server_id
   234	
   235	    def _state_path(self, server_id: str) -> Path:
   236	        return self._server_dir(server_id) / "state.json"
   237	
   238	    def _load_state(self, server_id: str) -> dict:
   239	        try:
   240	            state = json.loads(self._state_path(server_id).read_text(encoding="utf-8"))
   241	        except (OSError, json.JSONDecodeError) as error:
   242	            raise ProviderError(f"{server_id} provider state is unavailable") from error
   243	        if not isinstance(state, dict) or state.get("serverId") != server_id:
   244	            raise ProviderError(f"{server_id} provider state is invalid")
   245	        return state
   246	
   247	    def _save_state(self, server_id: str, state: dict) -> None:
   248	        directory = self._server_dir(server_id)
   249	        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
   250	        os.chmod(directory, 0o700)
   251	        path = self._state_path(server_id)
   252	        path.write_bytes(fixture.canonical_json(state))
   253	        os.chmod(path, 0o600)
   254	
   255	    def _prepare(self, server_id: str) -> dict:
   256	        if self._state_path(server_id).exists():
   257	            self._teardown(server_id)
   258	        if server_id.startswith("macos-"):
   259	            state = self._prepare_macos(server_id)
   260	        elif server_id == "linux-current":
   261	            state = self._prepare_linux()
   262	        else:
   263	            state = self._prepare_relux()
   264	        self._save_state(server_id, state)
   265	        return {"status": "ok", "runtime": state["runtime"]}
   266	
   267	    def _generate_key(self, path: Path, key_type: str, comment: str) -> None:
   268	        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
   269	        arguments = [
   270	            "/usr/bin/ssh-keygen",
   271	            "-q",
   272	            "-t",
   273	            key_type,
   274	            "-N",
   275	            "",
   276	            "-C",
   277	            comment,
   278	            "-f",
   279	            str(path),
   280	        ]
   281	        if key_type == "ecdsa":
   282	            arguments[4:4] = ["-b", "256"]
   283	        _run(arguments)
   284	        os.chmod(path, 0o600)
   285	
   286	    def _start_endpoint_supervisor(
   287	        self, server_id: str, command_prefix: list[str] | None
   288	    ) -> tuple[dict, dict]:
   289	        directory = self._server_dir(server_id)
   290	        output_path = directory / "endpoints.json"
   291	        error_path = directory / "endpoints.log"
   292	        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
   293	        if command_prefix is None:
   294	            arguments = [sys.executable, "-u", "-c", ENDPOINT_WORKER]
   295	        else:
   296	            remote_command = f"python3 -u -c {shlex.quote(ENDPOINT_WORKER)}"
   297	            arguments = [*command_prefix, remote_command]
   298	        with output_path.open("wb") as output, error_path.open("wb") as error:
   299	            process = subprocess.Popen(
   300	                arguments,
   301	                stdin=subprocess.DEVNULL,
   302	                stdout=output,
   303	                stderr=error,
   304	                start_new_session=True,
   305	            )
   306	        self._processes[process.pid] = process
   307	        deadline = time.monotonic() + 10
   308	        while time.monotonic() < deadline:
   309	            if process.poll() is not None:
   310	                raise ProviderError("endpoint supervisor exited; output redacted")
   311	            try:
   312	                text = output_path.read_text(encoding="utf-8").strip()
   313	                if text:
   314	                    endpoints = json.loads(text.splitlines()[0])
   315	                    fixture._validate_runtime(
   316	                        server_id,
   317	                        {
   318	                            "runtime": {
   319	                                "host": "127.0.0.1",
   320	                                "port": 22,
   321	                                "identityReference": "validation-only",
   322	                                "destinationEndpoints": endpoints,
   323	                            }
   324	                        },
   325	                    )
   326	                    return endpoints, {"pid": process.pid, "marker": fixture.TASK_ID}
   327	            except (OSError, json.JSONDecodeError, fixture.FixtureError):
   328	                pass
   329	            time.sleep(0.05)
   330	        self._terminate_owned_process(process.pid, fixture.TASK_ID)
   331	        raise ProviderError("endpoint supervisor did not become ready")
   332	
   333	    def _prepare_macos(self, server_id: str) -> dict:
   334	        directory = self._server_dir(server_id)
   335	        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
   336	        fallback = server_id == "macos-approved-older-profile"
   337	        host_key = directory / "host-key"
   338	        user_key = directory / "user-key-initial"
   339	        self._generate_key(host_key, "ecdsa" if fallback else "ed25519", f"{fixture.TASK_ID}-{server_id}-host")
   340	        self._generate_key(user_key, "ecdsa" if fallback else "ed25519", f"{fixture.TASK_ID}-{server_id}-user")
   341	        authorized = directory / "authorized_keys"
   342	        authorized.write_text(user_key.with_suffix(".pub").read_text(encoding="utf-8"), encoding="utf-8")
   343	        os.chmod(authorized, 0o600)
   344	        endpoints, endpoint_process = self._start_endpoint_supervisor(server_id, None)
   345	        port = _free_port()
   346	        sshd_process = self._start_macos_sshd(server_id, port, host_key)
   347	        runtime = {
   348	            "account": getpass.getuser(),
   349	            "destinationEndpoints": endpoints,
   350	            "host": "127.0.0.1",
   351	            "identityReference": f"ephemeral-file://{user_key}",
   352	            "port": port,
   353	            "stdioExec": REMOTE_STDIO,
   354	        }
   355	        return {
   356	            "hostKey": str(host_key),
   357	            "hostKeyType": "ecdsa-sha2-nistp256" if fallback else "ssh-ed25519",
   358	            "processes": [endpoint_process, sshd_process],
   359	            "runtime": runtime,
   360	            "serverId": server_id,
   361	            "userKey": str(user_key),
   362	            "userKeyType": "ecdsa-sha2-nistp256" if fallback else "ssh-ed25519",
   363	        }
   364	
   365	    def _start_macos_sshd(self, server_id: str, port: int, host_key: Path) -> dict:
   366	        directory = self._server_dir(server_id)
   367	        configuration = directory / "sshd_config"
   368	        log = directory / "sshd.log"
   369	        fallback = server_id == "macos-approved-older-profile"
   370	        directives = [
   371	            f"Port {port}",
   372	            "ListenAddress 127.0.0.1",
   373	            "Protocol 2",
   374	            f"HostKey {host_key}",
   375	            f"PidFile {directory / 'sshd.pid'}",
   376	            f"AuthorizedKeysFile {directory / 'authorized_keys'}",
   377	            "StrictModes no",
   378	            "PasswordAuthentication no",
   379	            "KbdInteractiveAuthentication no",
   380	            "PubkeyAuthentication yes",
   381	            "UsePAM no",
   382	            "PermitRootLogin no",
   383	            f"AllowUsers {getpass.getuser()}",
   384	            "AllowTcpForwarding yes",
   385	            "RekeyLimit 32K 0",
   386	            "LogLevel VERBOSE",
   387	        ]
   388	        if fallback:
   389	            directives.extend(
   390	                [
   391	                    "KexAlgorithms diffie-hellman-group14-sha256",
   392	                    "HostKeyAlgorithms ecdsa-sha2-nistp256",
   393	                    "Ciphers aes128-ctr",
   394	                    "MACs hmac-sha2-512",
   395	                ]
   396	            )
   397	        configuration.write_text("\n".join(directives) + "\n", encoding="utf-8")
   398	        _run(["/usr/sbin/sshd", "-t", "-f", str(configuration)])
   399	        process = subprocess.Popen(
   400	            ["/usr/sbin/sshd", "-D", "-E", str(log), "-f", str(configuration)],
   401	            stdin=subprocess.DEVNULL,
   402	            stdout=subprocess.DEVNULL,
   403	            stderr=subprocess.DEVNULL,
   404	            start_new_session=True,
   405	        )
   406	        self._processes[process.pid] = process
   407	        deadline = time.monotonic() + 5
   408	        while time.monotonic() < deadline:
   409	            if process.poll() is not None:
   410	                raise ProviderError("task-owned macOS sshd exited; output redacted")
   411	            try:
   412	                with socket.create_connection(("127.0.0.1", port), timeout=0.2):
   413	                    return {"pid": process.pid, "marker": str(directory)}
   414	            except OSError:
   415	                time.sleep(0.05)
   416	        self._terminate_owned_process(process.pid, str(directory))
   417	        raise ProviderError("task-owned macOS sshd did not become reachable")
