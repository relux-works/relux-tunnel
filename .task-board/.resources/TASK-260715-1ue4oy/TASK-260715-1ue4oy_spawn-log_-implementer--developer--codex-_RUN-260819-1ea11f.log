   773	def write_new_file_at(
   774	    directory_descriptor: int, name: str, contents: bytes, mode: int
   775	) -> None:
   776	    if not name or name in {".", ".."} or PurePosixPath(name).name != name:
   777	        raise AssetManifestError("relay asset output name is unsafe")
   778	    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0)
