+      for configuration in [first, second] {
+        group.addTask {
+          do {
+            _ = try loader.capture(from: configuration)
+            return true
+          } catch SSHProfileSnapshotLoaderError.profileGenerationMismatch {
+            return false
+          } catch {
+            return false
+          }
+        }
+      }
+      var values: [Bool] = []
+      for await value in group { values.append(value) }
+      return values
