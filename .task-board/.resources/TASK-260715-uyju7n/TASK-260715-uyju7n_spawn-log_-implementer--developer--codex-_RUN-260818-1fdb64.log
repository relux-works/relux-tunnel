   "ReluxProxyIOSTunnel",
 ]
 
+private let macOSDeploymentTargets: DeploymentTargets = .macOS("15.0")
+
+private func targetSettings(
+  debugXCConfig: Path,
+  releaseXCConfig: Path,
+  additionalBaseSettings: SettingsDictionary = [:]
+) -> Settings {
+  .settings(
+    base: [
+      "SWIFT_STRICT_CONCURRENCY": "complete",
