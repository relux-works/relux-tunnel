  2054	    if teardownTask != nil { teardownTask = nil }
  2055	  }
  2056	
  2057	  private func startTearDownIfNeeded() -> Task<Void, Never> {
  2058	    if let teardownTask { return teardownTask }
  2059	    let task = Task { [weak self] in
  2060	      guard let self else { return }
  2061	      await self.performTearDown()
  2062	    }
  2063	    teardownTask = task
  2064	    return task
  2065	  }
  2066	
  2067	  private func performTearDown() async {
  2068	    let deadline = dependencies.clock.now().advanced(
  2069	      by: configuration?.timeouts.transportClose ?? .seconds(1)
  2070	    )
  2071	    let ownedTasks = [
  2072	      automaticRekeyTask,
  2073	      automaticKeepaliveTask,
  2074	      byteRekeyTask,
  2075	      rekeyFlightTask,
  2076	    ].compactMap { $0 }
  2077	    for task in ownedTasks { task.cancel() }
  2078	    asyncOperations.cancelAll()
  2079	    sessionOperationGate.cancelPending()
  2080	    context.network.beginShutdown()
  2081	    if let connection, let remaining = remainingDuration(until: deadline) {
  2082	      _ = try? await withTimeout(
  2083	        remaining,
  2084	        clock: dependencies.clock,
  2085	        registry: asyncOperations
  2086	      ) {
  2087	        await connection.close()
  2088	      }
  2089	    }
  2090	    if ownedTasks.isEmpty {
  2091	      clearAutomaticTaskReferences()
  2092	    } else if let remaining = remainingDuration(until: deadline) {
  2093	      _ = try? await withTimeout(
  2094	        remaining,
  2095	        clock: dependencies.clock,
  2096	        registry: asyncOperations
  2097	      ) { [weak self] in
  2098	        for task in ownedTasks { await task.value }
