@@ -0,0 +1,63 @@
+import Foundation
+import ReluxTunnelCore
+
+func fixture(account: String = "fixture-account") -> SSHProfileSnapshotV1 {
+  let digest = Data(repeating: 0x01, count: 32).base64EncodedString().dropLast()
+  let record = SSHHostIdentityRecordV1(
+    algorithm: .sshEd25519,
+    fingerprintSHA256: SSHHostKeyFingerprint("SHA256:\(digest)"),
+    state: .approved,
+    provenance: .firstUseApproval,
+    firstSeenAt: SSHProfileTimestamp("2026-08-11T10:00:00.000Z"),
+    lastSeenAt: SSHProfileTimestamp("2026-08-11T10:00:01.000Z"),
+    approvedAt: SSHProfileTimestamp("2026-08-11T10:00:01.000Z"),
+    revokedAt: nil,
+    revocationReason: nil
+  )
+  return SSHProfileSnapshotV1(
+    configurationGeneration: 7,
+    profileID: OpaqueProfileIdentifier(UUID(uuidString: "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa")!),
+    createdAt: SSHProfileTimestamp("2026-08-11T09:00:00.000Z"),
+    updatedAt: SSHProfileTimestamp("2026-08-11T10:00:01.000Z"),
+    displayName: "Fixture Profile",
+    canonicalHost: .init(kind: .dns, value: "example.com"),
+    port: 22,
+    account: account,
+    credential: .init(
+      reference: OpaqueCredentialReference(UUID(uuidString: "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb")!),
+      generation: 3
+    ),
+    hostPolicy: .init(allowedAlgorithms: [.sshEd25519], records: [record])
+  )
+}
+
+let valid = try SSHProfileSnapshotCodec.encode(fixture())
+var object = try JSONSerialization.jsonObject(with: valid) as! [String: Any]
+object["future"] = ["privateKeyMaterial": "redacted"]
+let prohibitedVariant = try JSONSerialization.data(
+  withJSONObject: object,
+  options: [.sortedKeys, .withoutEscapingSlashes]
+)
+do {
+  _ = try SSHProfileSnapshotCodec.decode(prohibitedVariant)
+  print("PROHIBITED_EQUIVALENT_ACCEPTED")
+} catch {
+  print("PROHIBITED_EQUIVALENT_REJECTED \(error)")
+}
+
+let expected = fixture()
+let replaced = fixture(account: "changed-account")
+let expectation = SSHProfileSnapshotExpectation(
+  profileID: expected.profileID,
+  configurationGeneration: expected.configurationGeneration
+)
+let loader = SSHProfileRuntimeSnapshotLoader()
+do {
+  let accepted = try loader.capture(
+    from: SSHProfileProviderConfigurationCodec.encode(replaced),
+    expectation: expectation
+  )
+  print("FIRST_CAPTURE_REPLACEMENT_ACCEPTED account=\(accepted.account)")
+} catch {
+  print("FIRST_CAPTURE_REPLACEMENT_REJECTED \(error)")
+}

