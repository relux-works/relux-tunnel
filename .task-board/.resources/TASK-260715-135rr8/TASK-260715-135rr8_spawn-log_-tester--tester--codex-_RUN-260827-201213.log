+  let descriptors: Int
+  let swiftTasks: Int?
+  let swiftTasksAvailability: String
+  let processThreads: Int
+  let drops: UInt64
+  let failures: [String]
+}
+
+private struct PhysicalMemoryLifecycleEvidence: Codable, Sendable {
+  let cycles: Int
