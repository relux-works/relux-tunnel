Первая digest-команда сама нашла косяк в моей `jq` проекции: форматирование TSV упало, но shell-группа вернула 0 по последней команде. Этот лог не считаю evidence. Перезапускаю с явной проверкой каждого этапа и fail-closed exit propagation.
exec
/bin/zsh -lc "set -o pipefail
{
  rows=.temp/TASK-260720-1qhxqa/accepted-resource-rows-rev8.tsv
  jq -r '(.runtimeContract | ([.taskId,.resourceName,.sha256] | @tsv), ([.taskId,.reviewerVerdict.resourceName,.reviewerVerdict.sha256] | @tsv)), (.acceptedInputs[] | ([.taskId,.acceptedOutcome.resourceName,.acceptedOutcome.sha256] | @tsv), ([.taskId,.reviewerVerdict.resourceName,.reviewerVerdict.sha256] | @tsv))' Configuration/TASK-260720-1qhxqa_m0-production-bindings-v1.json > \""'$rows" || exit 1
  digest_rc=0
  while IFS=$'"'\\t' read -r task name expected; do
    path=\""'$TASK_BOARD_DIR/.resources/$task/$name"
    if [[ ! -f "$path" ]]; then
      printf '"'MISSING\\t%s\\t%s\\texpected=%s\\n' \""'$task" "$name" "$expected"
      digest_rc=1
      continue
    fi
    actual=$(shasum -a 256 "$path" | awk '"'{print "'$1}'"') || { digest_rc=1; continue; }
    if [[ \""'$actual" != "$expected" ]]; then
      printf '"'MISMATCH\\t%s\\t%s\\texpected=%s\\tactual=%s\\n' \""'$task" "$name" "$expected" "$actual"
      digest_rc=1
    else
      printf '"'MATCH\\t%s\\t%s\\t%s\\n' \""'$task" "$name" "$actual"
    fi
