+    context.install(credential: ReversingCredential())
+    let payload = Data([1, 2, 3, 4])
+
+    #expect(context.requestSignature(for: payload) == nil)
+    var result: Result<Data, LibSSH2BridgeError>?
+    for _ in 0..<100 where result == nil {
+      await Task.yield()
+      result = context.requestSignature(for: payload)
+    }
+    #expect(try result?.get() == Data([4, 3, 2, 1]))
+  }
