    let adapter = RecordingSOCKSAdapter()
    let boundary = HEVLoopbackSOCKSBoundary(
      adapter: adapter,
      credentials: testAccess().credentials,
      maximumPendingConnections: 4,
      authenticationTimeoutMilliseconds: 1_000
