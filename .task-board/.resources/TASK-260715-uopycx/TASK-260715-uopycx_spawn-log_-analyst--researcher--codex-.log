            }
        }
        logger.info("✅ TSocks5Tunnel.run ")

         }
     
    // MARK: - 配置虚拟网卡 (macOS 版本)
    
    // 👇 **核心适配点 2：全新的、为 macOS 定制的网络设置方法**
    private func setMacosTunnelNetworkSettings() async throws {
        let settings = NEPacketTunnelNetworkSettings(tunnelRemoteAddress: "192.168.0.1") // 此地址不重要
        settings.mtu = NSNumber(value: MTU)

        // --- IPv4 设置 ---
        let ipv4Settings = NEIPv4Settings(
            addresses: ["198.18.0.1"], // 虚拟网卡 IP (同 iOS)
            subnetMasks: ["255.255.0.0"]
        )
        
        // a) 包含默认路由，捕获所有流量
        ipv4Settings.includedRoutes = [NEIPv4Route.default()]
        
        // b) **macOS 成功的关键**: 排除必要的路由以防止循环
        var excludedRoutes: [NEIPv4Route] = []
        
        // 硬编码排除物理网关
        let hardcodedGateway = "192.168.1.1"
        excludedRoutes.append(NEIPv4Route(destinationAddress: hardcodedGateway, subnetMask: "255.255.255.0"))
        logger.notice("✅ [macOS] Excluding hardcoded physical gateway: \(hardcodedGateway, privacy: .public)")

        // (可选但强烈推荐) 排除 DNS 服务器路由，防止 DNS 循环
        let dnsServers = ["1.1.1.1", "8.8.8.8"]
        for server in dnsServers {
       //     excludedRoutes.append(NEIPv4Route(destinationAddress: server, subnetMask: "255.255.255.255"))
            logger.notice("✅ [macOS] Excluding DNS server: \(server, privacy: .public)")
        }

        ipv4Settings.excludedRoutes = excludedRoutes
        settings.ipv4Settings = ipv4Settings

        // --- IPv6 设置 ---
        let ipv6Settings = NEIPv6Settings(
            addresses: ["fd6e:a81b:704f:1211::1"], // (同 iOS)
            networkPrefixLengths: [64]
        )
        ipv6Settings.includedRoutes = [NEIPv6Route.default()]
        // 注意：如果您的物理网络有 IPv6，也需要在此处排除 IPv6 网关和 DNS 服务器
        settings.ipv6Settings = ipv6Settings

        // --- DNS 设置 ---
        let dnsSettings = NEDNSSettings(servers: dnsServers + ["2606:4700:4700::1111", "2001:4860:4860::8888"])
        dnsSettings.matchDomains = [""]
        settings.dnsSettings = dnsSettings

        // --- 应用设置 ---
        try await setTunnelNetworkSettings(settings)
        logger.notice("✅ [macOS] Applied network settings with excluded routes.")
    }
}


// MARK: - 辅助定义

enum PacketTunnelError: Error, LocalizedError {
    case missingSocks5Port
    case missingXrayConfig
    
    var errorDescription: String? {
        switch self {
        case .missingSocks5Port:
            return "Missing 'socks5Port' in tunnel options."
        case .missingXrayConfig:
            return "Missing 'base64String' (Xray config) in tunnel options."
        }
    }
}

// 👇 **核心适配点 3：使用修正后的、安全的扩展**
extension NEProviderStopReason {
    var description: String {
        switch self {
        case .none: return "None"
        case .userInitiated: return "User Initiated"
        case .providerFailed: return "Provider Failed"
        case .noNetworkAvailable: return "No Network Available"
        case .unrecoverableNetworkChange: return "Unrecoverable Network Change"
        case .providerDisabled: return "Provider Disabled"
        case .authenticationCanceled: return "Authentication Canceled"
        case .configurationFailed: return "Configuration Failed"
        case .idleTimeout: return "Idle Timeout"
        case .appUpdate: return "App Update"
        case .superceded: return "Superceded by another connection"
        case .userLogout: return "User Logout"
        case .userSwitch: return "User Switch"
        case .connectionFailed: return "Connection Failed"
        case .sleep: return "Device is going to sleep"
        @unknown default: return "Unknown (\(self.rawValue))"
        }
    }
}

