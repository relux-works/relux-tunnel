+    #expect(snapshot.gauges["tcp_session_health_code"] == 1)
+    #expect(snapshot.gauges["tcp_peak_reserved_flows"] == 1)
+    #expect(snapshot.gauges["tcp_peak_opening_flows"] == 1)
