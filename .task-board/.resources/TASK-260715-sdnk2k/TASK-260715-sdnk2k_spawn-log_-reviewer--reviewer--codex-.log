   235	  public init(direction: BytePumpDirection, reason: BytePumpTerminalReason) {
   236	    self.direction = direction
   237	    self.reason = reason
   238	  }
   239	}
   240	
   241	public struct BoundedFullDuplexBytePumpOutcome: Equatable, Sendable {
   242	  public let localToSSH: BytePumpTerminalEvent
   243	  public let sshToLocal: BytePumpTerminalEvent
   244	
   245	  public init(
   246	    localToSSH: BytePumpTerminalEvent,
   247	    sshToLocal: BytePumpTerminalEvent
   248	  ) {
   249	    self.localToSSH = localToSSH
   250	    self.sshToLocal = sshToLocal
   251	  }
   252	}
   253	
   254	public enum BytePumpOperation: String, Equatable, Sendable {
   255	  case read
   256	  case write
   257	  case readinessWait = "readiness_wait"
   258	}
   259	
   260	/// Finite, aggregate-safe observations. No case can carry endpoints, payload,
   261	/// hashes, credentials, channel identity, flow identity, or free-form errors.
   262	public enum BytePumpDiagnosticUpdate: Equatable, Sendable {
   263	  case operation(direction: BytePumpDirection, operation: BytePumpOperation)
   264	  case bytes(direction: BytePumpDirection, count: Int)
   265	  case fairnessYield(direction: BytePumpDirection)
   266	  case pressure(direction: BytePumpDirection, readiness: LocalByteStreamReadiness)
   267	  case bufferedBytes(direction: BytePumpDirection, count: Int)
   268	  case aggregateReservedBytes(Int)
   269	  case terminal(BytePumpTerminalEvent)
   270	}
   271	
   272	public protocol BytePumpDiagnosticsSink: AnyObject, Sendable {
   273	  /// Must return promptly; updates are already finite and bounded by pump work.
   274	  func record(_ update: BytePumpDiagnosticUpdate)
   275	}
   276	
   277	public final class NoOpBytePumpDiagnosticsSink: BytePumpDiagnosticsSink, @unchecked Sendable {
   278	  public init() {}
   279	
   280	  public func record(_ update: BytePumpDiagnosticUpdate) {}
   281	}
