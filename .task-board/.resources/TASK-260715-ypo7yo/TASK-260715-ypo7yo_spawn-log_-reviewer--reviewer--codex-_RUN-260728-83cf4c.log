      }
    ],
    "coverageScan": {
      "shape": "(?:\\*\\*)?(<number-word>|\\d+)(?:\\*\\*)?\\s+(?:(?:\\*\\*)?authored(?:\\*\\*)?\\s+)?keys?\\b",
