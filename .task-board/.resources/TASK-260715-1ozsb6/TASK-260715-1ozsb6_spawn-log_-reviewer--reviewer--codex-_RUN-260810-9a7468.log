  1163	  var closeCallCount: Int { state.withLock(\.closeCallCount) }
  1164	  var freeCallCount: Int { state.withLock(\.freeCallCount) }
  1165	  var closeEAGAINRemaining: Int { state.withLock(\.closeEAGAINRemaining) }
  1166	  var freeEAGAINRemaining: Int { state.withLock(\.freeEAGAINRemaining) }
  1167	
  1168	  func rejectNextStartup(freeEAGAINCount: Int) {
  1169	    state.withLock {
  1170	      $0.rejectStartup = true
  1171	      $0.freeEAGAINRemaining = freeEAGAINCount
  1172	    }
  1173	  }
  1174	
  1175	  func armClose(closeEAGAINCount: Int, freeEAGAINCount: Int) {
  1176	    state.withLock {
  1177	      $0.closeEAGAINRemaining = closeEAGAINCount
  1178	      $0.freeEAGAINRemaining = freeEAGAINCount
  1179	    }
  1180	  }
  1181	}
