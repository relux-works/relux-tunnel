     // This function mostly exists for testing purposes: we don't initiate re-keying today because it's not
     // well-supported by evidence. But we want to be able to test against implementations who do, so we have support for
     // kicking it off.
     internal func _rekey() throws {
-        // As this is test-only there are a bunch of preconditions in here, we don't really mind if we hit them in testing.
-        var buffer = self.context!.channel.allocator.buffer(capacity: 1024)
+        guard let context = self.context else {
+            throw ChannelError.ioOnClosedChannel
+        }
+        try self.startOrCoalesceRekey(reasons: [.manual], promise: nil, context: context)
+    }
+}
+
+private extension NIOSSHHandler {
+    func recordProtectedOutboundBytes(_ count: Int) {
+        guard self.keyExchangeGeneration > 0 else {
+            return
+        }
+        self.protectedBytesSent = self.protectedBytesSent.addingWithoutOverflow(UInt64(count))
+    }
+
+    func recordProtectedInboundBytes(_ count: Int) {
+        guard self.keyExchangeGeneration > 0 else {
+            return
+        }
+        self.protectedBytesReceived = self.protectedBytesReceived.addingWithoutOverflow(UInt64(count))
+    }
+
+    func observeKeyExchangeTransition(
+        wasKeyExchangeInProgress: Bool,
+        context: ChannelHandlerContext
+    ) {
+        let isKeyExchangeInProgress = self.stateMachine.isKeyExchangeInProgress
+
+        if !wasKeyExchangeInProgress, isKeyExchangeInProgress, self.stateMachine.hasActivated {
+            self.rekeyReasons.insert(.serverInitiated)
+            context.fireUserInboundEventTriggered(
+                NIOSSHRekeyStartedEvent(
+                    reasons: self.rekeyReasons,
+                    currentGeneration: self.keyExchangeGeneration
+                )
+            )
+        } else if wasKeyExchangeInProgress, !isKeyExchangeInProgress {
+            self.keyExchangeSucceeded(context: context)
+        }
+
+        self.scheduleTimeRekeyIfNeeded(context: context)
+    }
+
+    func keyExchangeSucceeded(context: ChannelHandlerContext) {
+        self.protectedBytesSent = 0
+        self.protectedBytesReceived = 0
+        self.lastKeyExchangeTime = self.rekeyClock.now()
+        self.rekeyTimer?.cancel()
+        self.rekeyTimer = nil
+        self.keyExchangeGeneration += 1
+
+        guard self.keyExchangeGeneration > 1 else {
+            return
+        }
+
+        let reasons = self.rekeyReasons
+        self.rekeyReasons = []
+        context.fireUserInboundEventTriggered(
+            NIOSSHRekeySucceededEvent(reasons: reasons, newGeneration: self.keyExchangeGeneration)
+        )
+        self.succeedRekeyPromises()
+    }
+
+    func startOrCoalesceRekey(
+        reasons: Set<NIOSSHRekeyReason>,
+        promise: EventLoopPromise<Void>?,
+        context: ChannelHandlerContext
+    ) throws {
+        if self.stateMachine.hasActivated, self.stateMachine.isKeyExchangeInProgress {
+            self.rekeyReasons.formUnion(reasons)
+            if let promise {
+                self.rekeyPromises.append(promise)
+            }
+            return
+        }
+
+        guard self.stateMachine.isActive else {
+            throw ChannelError.operationUnsupported
+        }
+
+        self.rekeyReasons.formUnion(reasons)
+        if let promise {
+            self.rekeyPromises.append(promise)
+        }
+
+        var buffer = context.channel.allocator.buffer(capacity: 1024)
         try self.stateMachine.beginRekeying(
             buffer: &buffer,
-            allocator: self.context!.channel.allocator,
-            loop: self.context!.eventLoop
+            allocator: context.channel.allocator,
+            loop: context.eventLoop
         )
-        self.context!.writeAndFlush(self.wrapOutboundOut(buffer), promise: nil)
+        self.recordProtectedOutboundBytes(buffer.readableBytes)
+        context.writeAndFlush(self.wrapOutboundOut(buffer), promise: nil)
+        context.fireUserInboundEventTriggered(
+            NIOSSHRekeyStartedEvent(
+                reasons: self.rekeyReasons,
+                currentGeneration: self.keyExchangeGeneration
+            )
+        )
+    }
+
+    func evaluateAutomaticRekey(context: ChannelHandlerContext) {
+        guard case .client = self.stateMachine.role, self.keyExchangeGeneration > 0 else {
+            return
+        }
+
+        var reasons: Set<NIOSSHRekeyReason> = []
+        if let threshold = self.rekeyPolicy.outboundByteThreshold, self.protectedBytesSent >= threshold {
+            reasons.insert(.outboundByteThreshold)
+        }
+        if let threshold = self.rekeyPolicy.inboundByteThreshold, self.protectedBytesReceived >= threshold {
+            reasons.insert(.inboundByteThreshold)
+        }
+        if let threshold = self.rekeyPolicy.elapsedTimeThreshold,
+            let origin = self.lastKeyExchangeTime,
+            self.elapsedNanoseconds(since: origin) >= UInt64(threshold.nanoseconds)
+        {
+            reasons.insert(.elapsedTimeThreshold)
+        }
+
+        guard !reasons.isEmpty else {
+            self.scheduleTimeRekeyIfNeeded(context: context)
+            return
+        }
+
+        do {
+            try self.startOrCoalesceRekey(reasons: reasons, promise: nil, context: context)
+        } catch {
+            context.fireErrorCaught(error)
+        }
+    }
+
+    func scheduleTimeRekeyIfNeeded(context: ChannelHandlerContext) {
+        guard self.rekeyTimer == nil, self.stateMachine.isActive,
+            let threshold = self.rekeyPolicy.elapsedTimeThreshold,
+            let origin = self.lastKeyExchangeTime
+        else {
+            return
+        }
+
+        let thresholdNanoseconds = UInt64(threshold.nanoseconds)
+        let elapsed = self.elapsedNanoseconds(since: origin)
+        let remaining = elapsed >= thresholdNanoseconds ? 0 : thresholdNanoseconds - elapsed
+        let delay = TimeAmount.nanoseconds(Int64(clamping: remaining))
+        let loopBoundHandlerAndContext = NIOLoopBound((self, context), eventLoop: context.eventLoop)
+
+        self.rekeyTimer = context.eventLoop.scheduleTask(in: delay) {
+            let (handler, context) = loopBoundHandlerAndContext.value
+            handler.rekeyTimer = nil
+            guard handler.context != nil else {
+                return
+            }
+            handler.evaluateAutomaticRekey(context: context)
+        }
+    }
+
+    func elapsedNanoseconds(since origin: NIODeadline) -> UInt64 {
+        let now = self.rekeyClock.now().uptimeNanoseconds
+        return now >= origin.uptimeNanoseconds ? now - origin.uptimeNanoseconds : 0
+    }
+
+    func succeedRekeyPromises() {
+        let promises = self.rekeyPromises
+        self.rekeyPromises.removeAll(keepingCapacity: true)
+        for promise in promises {
+            promise.succeed(())
+        }
+    }
+
+    func failRekeyPromises(_ error: Error) {
+        let promises = self.rekeyPromises
+        self.rekeyPromises.removeAll(keepingCapacity: true)
+        for promise in promises {
+            promise.fail(error)
+        }
+    }
+}
+
+private extension UInt64 {
+    func addingWithoutOverflow(_ other: UInt64) -> UInt64 {
+        let (result, overflow) = self.addingReportingOverflow(other)
+        return overflow ? .max : result
     }
 }
 
