+        f"-DOPENSSL_ROOT_DIR={openssl}",
+        f"-DOPENSSL_INCLUDE_DIR={openssl / 'include'}",
+        f"-DOPENSSL_CRYPTO_LIBRARY={openssl / 'lib' / 'libcrypto.a'}",
