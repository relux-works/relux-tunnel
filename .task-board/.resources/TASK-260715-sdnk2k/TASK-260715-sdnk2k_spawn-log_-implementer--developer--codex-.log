+      readBehavior = .wouldBlockStall
+      writeBehavior = .accept
+      channelRead = .eof
+      channelWrite = .accept
+      scheduler = nil
+    case .localWritable:
+      readBehavior = .eof
+      writeBehavior = .wouldBlockStall
