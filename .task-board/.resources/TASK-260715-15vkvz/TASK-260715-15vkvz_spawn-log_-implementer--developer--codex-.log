+      case .terminalWithoutNotification:
+        status = .disconnected
+        return false
+      case .terminalWithNotification:
+        status = .disconnected
+        return true
+      }
+    }
+    if synchronousNotification { callback() }
+    lock.withLock { _events.append(.registrationReturned) }
+    return token
+  }
