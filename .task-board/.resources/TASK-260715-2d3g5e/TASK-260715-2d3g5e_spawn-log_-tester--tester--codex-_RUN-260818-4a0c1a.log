+          metrics: recorder,
+          logger: recorder
+        )
+      ) as! LibSSH2Transport
+    let configuration = try fixtureConfiguration(
+      port: server.port,
+      canonicalHostname: hostSentinel,
+      endpointHost: endpointSentinel,
+      username: NSUserName(),
+      credentialReference: SSHCredentialReference(rawValue: credentialSentinel)
+    )
+
