diff --git a/scripts/relay_asset_manifest.py b/scripts/relay_asset_manifest.py
index dd87a7ef5ac53b15486a6b1df8e56632f7922256..09a75a1d71702ea674de5b3b971e5ea747930fa4
--- a/scripts/relay_asset_manifest.py
+++ b/scripts/relay_asset_manifest.py
@@ -1001,12 +1001,25 @@
     staging: Path,
     bundle: Path,
     event_hook: Callable[[str, Path], None] | None,
+    *,
+    destination_existed_at_start: bool,
 ) -> None:
     parent = bundle.parent
     if staging.parent != parent:
         raise AssetManifestError("relay asset staging directory is not a sibling")
     parent_descriptor = open_bundle_directory(parent)
     try:
+        if not destination_existed_at_start:
+            if event_hook is not None:
+                event_hook("before_initial_publish", bundle)
+            atomic_rename_at(
+                parent_descriptor, staging.name, bundle.name, exchange=False
+            )
+            os.fsync(parent_descriptor)
+            if event_hook is not None:
+                event_hook("after_publish", bundle)
+            return
+
         try:
             existing_status = os.stat(
                 bundle.name, dir_fd=parent_descriptor, follow_symlinks=False
@@ -1072,6 +1085,7 @@
             not stat.S_ISDIR(status.st_mode) or stat.S_ISLNK(status.st_mode)
         ):
             raise AssetManifestError("relay asset bundle destination is unsafe")
+        destination_existed_at_start = status is not None
     else:
         if existing != manifest:
             raise AssetManifestError("existing relay asset bundle is stale")
@@ -1113,7 +1127,12 @@
             ) from error
         if event_hook is not None:
             event_hook("before_publish", staging)
-        publish_staged_bundle(staging, bundle, event_hook)
+        publish_staged_bundle(
+            staging,
+            bundle,
+            event_hook,
+            destination_existed_at_start=destination_existed_at_start,
+        )
     except BaseException:
         remove_owned_directory(staging, staging_identity)
         raise
diff --git a/scripts/tests/test_relay_asset_manifest.py b/scripts/tests/test_relay_asset_manifest.py
index f23b98d3fa58909ad56bee118ceab5ee240cfbd3..0c3b24d11efff28d170880a19218cf085c0cc687
--- a/scripts/tests/test_relay_asset_manifest.py
+++ b/scripts/tests/test_relay_asset_manifest.py
@@ -600,6 +600,36 @@
         self.assertEqual(marker.read_text(encoding="utf-8"), "preserve")
         self.assertEqual(list(bundle.parent.glob(f".{bundle.name}.staging-*")), [])

+    def test_pre_publish_race_preserves_foreign_destination(self) -> None:
+        bundle = self.root / "pre-publish-raced-destination"
+        marker = bundle / "foreign-marker"
+        foreign_identity: tuple[int, int] | None = None
+
+        def create_foreign_destination(event: str, _: Path) -> None:
+            nonlocal foreign_identity
+            if event == "before_publish":
+                bundle.mkdir()
+                marker.write_text("preserve", encoding="utf-8")
+                foreign_identity = manifest_tool.directory_identity(
+                    bundle, "foreign fixture"
+                )
+
+        with self.assertRaises(manifest_tool.AssetManifestError):
+            manifest_tool.generate_bundle(
+                self.archive,
+                bundle,
+                self.loaded_contract(),
+                event_hook=create_foreign_destination,
+            )
+
+        self.assertIsNotNone(foreign_identity)
+        self.assertEqual(
+            manifest_tool.directory_identity(bundle, "foreign fixture"),
