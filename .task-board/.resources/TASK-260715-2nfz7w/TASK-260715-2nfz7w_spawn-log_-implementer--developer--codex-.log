+// swift-tools-version: 6.1
+
+import PackageDescription
+
+let package = Package(
+    name: "ReluxTunnel",
+    platforms: [
+        .iOS(.v18),
+        .macOS(.v15),
+    ],
+    products: [
+        .library(name: "ReluxTunnelCore", targets: ["ReluxTunnelCore"]),
