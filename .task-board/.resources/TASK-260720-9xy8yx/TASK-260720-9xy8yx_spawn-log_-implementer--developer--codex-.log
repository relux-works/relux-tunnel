diff --git a/Tests/ReluxTunnelCoreTests/PacketFlowAdapterTests.swift b/Tests/ReluxTunnelCoreTests/PacketFlowAdapterTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..d2eb924aaa06eb40cac091b82fd55f94d158f944
