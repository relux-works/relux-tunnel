  public let code: Int

  public init(domain: String, code: Int) {
    self.domain = domain
    self.code = code
  }
}

public protocol VPNHostSession: AnyObject, Sendable {
  var status: VPNManagerSessionStatus { get }

  func startTunnel(options: [String: Data]) throws
