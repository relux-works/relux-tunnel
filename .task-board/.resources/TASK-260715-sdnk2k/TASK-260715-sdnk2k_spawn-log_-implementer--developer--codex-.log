+private struct PumpLCG {
+  var state: UInt64
+
+  mutating func next() -> UInt64 {
+    state = state &* 6_364_136_223_846_793_005 &+ 1_442_695_040_888_963_407
+    return state
+  }
+
+  mutating func nextInt(upperBound: Int) -> Int {
+    Int(next() % UInt64(upperBound))
+  }
+}
