+
+    def test_lifecycle_attempts_teardown_for_every_prepared_row(self):
+        manifest = fixture.load_manifest()
+        servers = {server["id"]: server for server in manifest["servers"]}
+        teardown_ids = []
+
+        def fake_dispatch(_provider, request):
