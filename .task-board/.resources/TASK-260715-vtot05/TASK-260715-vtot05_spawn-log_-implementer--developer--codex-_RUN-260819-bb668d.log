+    def string_start(index: int) -> tuple[int, int] | None:
+        cursor = index
+        while cursor < len(text) and text[cursor] == "#":
+            cursor += 1
+        if cursor >= len(text) or text[cursor] != '"':
+            return None
+        quote_length = 3 if text.startswith('"""', cursor) else 1
+        return cursor - index, quote_length
+
