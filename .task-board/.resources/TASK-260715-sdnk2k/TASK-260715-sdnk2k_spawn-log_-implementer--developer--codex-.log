+  let channel = StallSSHByteChannel(readBehavior: .stall, writeBehavior: .stall)
+  let pump = try BoundedFullDuplexBytePump(
+    local: local,
+    channel: channel,
+    configuration: configuration,
+    bufferBudget: budget
+  )
+  return (pump, channel)
+}
