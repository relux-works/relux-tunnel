  private func drain(channel: LibSSH2ExecChannel, standardError: Bool) async throws {
    while true {
      let bytes =
        if standardError {
          try await channel.readStandardError(maximumBytes: 16 * 1_024)
        } else {
          try await channel.read(maximumBytes: 16 * 1_024)
        }
