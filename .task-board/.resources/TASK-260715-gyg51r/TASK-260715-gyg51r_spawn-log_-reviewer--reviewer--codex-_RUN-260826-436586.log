codex
Нашёл ещё один attack surface в реализации: `open(rootPath, O_NOFOLLOW)` запрещает symlink только в последнем компоненте `.temp`, но следует symlink’ам в предках абсолютного project path. Проверяю безопасно в изолированном scratch-проекте: после parse переименую сам project directory и заменю его symlink’ом на внешний project с обычной `.temp`. Если запись уйдёт туда, rev3 containment всё ещё пробиваем.
exec
/bin/zsh -lc 'review_root="$PWD"
binary="$review_root/.build/debug/ReluxTunnelHarness"
config="$review_root/.temp/TASK-260715-gyg51r-review/root-symlink-config.json"
container="$review_root/.temp/TASK-260715-gyg51r-review/ancestor-swap-container"
project="$container/project"
displaced="$container/project-original"
external_project="/tmp/TASK-260715-gyg51r-review-ancestor-external-RUN-260826-436586"
log="$review_root/.temp/TASK-260715-gyg51r-review/ancestor-swap-attack-01.log"
mkdir -p "$project/.temp" "$external_project/.temp"
cd "$project"
"$binary" mtu-matrix --configuration "$config" > "$log" 2>&1 &
command_pid=$!
sleep 0.02
mv "$project" "$displaced"
ln -s "$external_project" "$project"
wait "$command_pid"
command_exit=$?
cd "$review_root"
if [ -e "$external_project/.temp/matrix.json" ]; then external_written=yes; else external_written=no; fi
if [ -e "$displaced/.temp/matrix.json" ]; then displaced_written=yes; else displaced_written=no; fi
