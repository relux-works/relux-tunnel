   122	public enum RelayDatagramWire {
   123	  /// Computes and validates the exact HEV record size before allocation.
   124	  public static func encodedLength(
   125	    endpoint: RelayDatagramEndpoint,
   126	    dataLength: UInt64,
   127	    maximumPayloadLength: UInt16 = RelayProtocolV1.maxUDPPayloadClientDefault
   128	  ) throws -> Int {
   129	    try validateMaximumPayloadLength(maximumPayloadLength)
   130	    let headerLength = try validateEndpoint(endpoint, phase: .encoding)
   131	    let (recordLength, overflow) = UInt64(headerLength).addingReportingOverflow(dataLength)
   132	    guard !overflow, recordLength <= UInt64(Int.max) else {
   133	      throw encodingFailure(.arithmeticOverflow, phase: .encoding)
   134	    }
   135	    guard dataLength <= UInt64(RelayProtocolV1.maxUDPPayloadClientHardCeiling) else {
   136	      throw encodingFailure(.messageLengthExceedsProtocolMaximum, phase: .data)
   137	    }
   138	    guard dataLength <= UInt64(maximumPayloadLength) else {
   139	      throw encodingFailure(.messageLengthExceedsLocalMaximum, phase: .data)
   140	    }
   141	    guard recordLength <= UInt64(RelayProtocolV1.maxHEVRecordWidth) else {
   142	      throw encodingFailure(.arithmeticOverflow, phase: .encoding)
   143	    }
   144	    return Int(recordLength)
   145	  }
   146	}
   147	
   148	public struct RelayDatagramCodec: Sendable {
   149	  public let maximumPayloadLength: UInt16
   150	  public private(set) var metrics = RelayDatagramCodecMetrics()
   151	
   152	  public init(
   153	    maximumPayloadLength: UInt16 = RelayProtocolV1.maxUDPPayloadClientDefault
   154	  ) throws {
   155	    try validateMaximumPayloadLength(maximumPayloadLength)
   156	    self.maximumPayloadLength = maximumPayloadLength
   157	  }
   158	
   159	  public mutating func encode(_ datagram: RelayDatagram) throws -> Data {
   160	    do {
   161	      let recordLength = try RelayDatagramWire.encodedLength(
   162	        endpoint: datagram.endpoint,
   163	        dataLength: UInt64(datagram.data.count),
   164	        maximumPayloadLength: maximumPayloadLength
   165	      )
   166	      let addressBytes = datagram.endpoint.address.wireBytes
   167	      let headerLength = recordLength - datagram.data.count
   168	
   169	      var record = Data()
   170	      record.reserveCapacity(recordLength)
   171	      appendDatagramBigEndian(UInt16(datagram.data.count), to: &record)
   172	      record.append(UInt8(headerLength))
   173	      record.append(datagram.endpoint.address.type.rawValue)
   174	      if case .domain = datagram.endpoint.address {
   175	        record.append(UInt8(addressBytes.count))
   176	      }
   177	      record.append(addressBytes)
   178	      appendDatagramBigEndian(datagram.endpoint.port, to: &record)
   179	      record.append(datagram.data)
   180	
   181	      guard record.count == recordLength else {
   182	        throw encodingFailure(.arithmeticOverflow, phase: .encoding)
   183	      }
   184	      metrics.encodedRecords += 1
   185	      metrics.encodedBytes += UInt64(record.count)
   186	      return record
   187	    } catch let failure as RelayDatagramFailure {
   188	      metrics.failures += 1
   189	      throw failure
   190	    }
   191	  }
   192	
   193	  /// Decodes one complete envelope payload. HEV structure is validated before
   194	  /// payload-limit policy, and every check finishes before slicing/materializing.
   195	  public mutating func decode(_ record: Data) throws -> RelayDatagram {
   196	    metrics.inputRecords += 1
   197	    metrics.inputBytes += UInt64(record.count)
   198	
   199	    do {
   200	      let layout = try validateRecordLayout(record)
   201	      let addressStart = record.index(record.startIndex, offsetBy: layout.addressOffset)
   202	      let addressEnd = record.index(addressStart, offsetBy: layout.addressLength)
   203	      let dataStart = record.index(record.startIndex, offsetBy: layout.headerLength)
   204	
   205	      let addressBytes = Data(record[addressStart..<addressEnd])
   206	      let data = Data(record[dataStart..<record.endIndex])
   207	      let address: RelayDatagramAddress =
   208	        switch layout.addressType {
   209	        case .ipv4: .ipv4(addressBytes)
   210	        case .ipv6: .ipv6(addressBytes)
   211	        case .domain: .domain(addressBytes)
   212	        }
   213	      let datagram = RelayDatagram(
   214	        endpoint: RelayDatagramEndpoint(address: address, port: layout.port),
   215	        data: data
   216	      )
   217	
   218	      metrics.decodedRecords += 1
   219	      metrics.decodedMaterializedBytes += UInt64(addressBytes.count + data.count)
   220	      return datagram
   221	    } catch let failure as RelayDatagramFailure {
   222	      metrics.failures += 1
   223	      throw failure
   224	    }
   225	  }
   226	
   227	  private func validateRecordLayout(_ record: Data) throws -> RelayDatagramLayout {
   228	    guard record.count >= 4 else {
   229	      throw decodingFailure(.truncatedFixedHeader, phase: .fixedHeader)
   230	    }
   231	
   232	    let messageLength =
   233	      (Int(record.byte(at: 0)) << 8) | Int(record.byte(at: 1))
   234	    let headerLength = Int(record.byte(at: 2))
   235	    guard
   236	      let addressType = RelayProtocolV1.AddressType(rawValue: record.byte(at: 3))
   237	    else {
   238	      throw decodingFailure(.unknownAddressType, phase: .address)
   239	    }
   240	    let addressOffset: Int
   241	    let addressLength: Int
   242	    let expectedHeaderLength: Int
   243	    switch addressType {
   244	    case .ipv4:
   245	      addressOffset = 4
   246	      addressLength = 4
   247	      expectedHeaderLength = RelayProtocolV1.hevHDRLENIPv4
   248	    case .ipv6:
   249	      addressOffset = 4
   250	      addressLength = 16
   251	      expectedHeaderLength = RelayProtocolV1.hevHDRLENIPv6
   252	    case .domain:
   253	      guard record.count >= 5 else {
   254	        throw decodingFailure(.truncatedAddress, phase: .address)
   255	      }
   256	      addressOffset = 5
   257	      addressLength = Int(record.byte(at: 4))
   258	      guard
   259	        addressLength >= RelayProtocolV1.minDomainWireBytes,
   260	        addressLength <= RelayProtocolV1.maxDomainWireBytes
   261	      else {
   262	        throw decodingFailure(.invalidAddressLength, phase: .address)
   263	      }
   264	      expectedHeaderLength = RelayProtocolV1.hevHDRLENDomainBase + addressLength
   265	    }
   266	
   267	    guard headerLength == expectedHeaderLength else {
   268	      throw decodingFailure(.headerLengthMismatch, phase: .fixedHeader)
   269	    }
   270	    let addressEnd = addressOffset + addressLength
   271	    guard record.count >= addressEnd else {
   272	      throw decodingFailure(.truncatedAddress, phase: .address)
   273	    }
   274	    let portEnd = addressEnd + RelayProtocolV1.hevPortWidth
   275	    guard record.count >= portEnd else {
   276	      throw decodingFailure(.truncatedPort, phase: .port)
   277	    }
   278	    guard portEnd == headerLength else {
   279	      throw decodingFailure(.headerLengthMismatch, phase: .fixedHeader)
   280	    }
   281	    let port =
   282	      (UInt16(record.byte(at: addressEnd)) << 8)
   283	      | UInt16(record.byte(at: addressEnd + 1))
   284	    guard port != 0 else {
   285	      throw decodingFailure(.invalidPort, phase: .port)
   286	    }
   287	
   288	    let availableDataLength = record.count - headerLength
   289	    guard availableDataLength == messageLength else {
   290	      throw decodingFailure(.messageLengthMismatch, phase: .data)
   291	    }
   292	    let (outerLength, overflow) = headerLength.addingReportingOverflow(messageLength)
   293	    guard !overflow else {
   294	      throw decodingFailure(.arithmeticOverflow, phase: .outerLength)
   295	    }
   296	    guard outerLength == record.count else {
   297	      throw decodingFailure(.outerLengthMismatch, phase: .outerLength)
   298	    }
   299	    guard messageLength <= Int(RelayProtocolV1.maxUDPPayloadClientHardCeiling) else {
   300	      throw decodingFailure(.messageLengthExceedsProtocolMaximum, phase: .data)
   301	    }
   302	    guard messageLength <= Int(maximumPayloadLength) else {
   303	      throw localLimitFailure()
   304	    }
   305	
   306	    return RelayDatagramLayout(
   307	      addressType: addressType,
   308	      addressOffset: addressOffset,
   309	      addressLength: addressLength,
   310	      headerLength: headerLength,
   311	      port: port
   312	    )
   313	  }
   314	}
   315	
   316	private struct RelayDatagramLayout {
   317	  let addressType: RelayProtocolV1.AddressType
   318	  let addressOffset: Int
   319	  let addressLength: Int
   320	  let headerLength: Int
   321	  let port: UInt16
   322	}
   323	
   324	private func validateMaximumPayloadLength(_ value: UInt16) throws {
   325	  guard
   326	    value >= RelayProtocolV1.maxUDPPayloadFloor,
   327	    value <= RelayProtocolV1.maxUDPPayloadClientHardCeiling
   328	  else {
   329	    throw RelayDatagramFailure(
   330	      code: .invalidConfiguration,
   331	      phase: .configuration,
   332	      scope: .session,
   333	      disposition: .closeSession
   334	    )
   335	  }
   336	}
   337	
   338	private func validateEndpoint(
   339	  _ endpoint: RelayDatagramEndpoint,
   340	  phase: RelayDatagramPhase
   341	) throws -> Int {
   342	  guard endpoint.port != 0 else {
   343	    throw encodingFailure(.invalidPort, phase: .port)
   344	  }
   345	  let length = endpoint.address.wireBytes.count
   346	  switch endpoint.address {
   347	  case .ipv4:
   348	    guard length == 4 else {
   349	      throw encodingFailure(.invalidAddressLength, phase: phase)
   350	    }
   351	    return RelayProtocolV1.hevHDRLENIPv4
   352	  case .ipv6:
   353	    guard length == 16 else {
   354	      throw encodingFailure(.invalidAddressLength, phase: phase)
   355	    }
   356	    return RelayProtocolV1.hevHDRLENIPv6
   357	  case .domain:
   358	    guard
   359	      length >= RelayProtocolV1.minDomainWireBytes,
   360	      length <= RelayProtocolV1.maxDomainWireBytes
   361	    else {
   362	      throw encodingFailure(.invalidAddressLength, phase: phase)
   363	    }
   364	    return RelayProtocolV1.hevHDRLENDomainBase + length
   365	  }
   366	}
   367	
   368	private func encodingFailure(
   369	  _ code: RelayDatagramFailureCode,
   370	  phase: RelayDatagramPhase
   371	) -> RelayDatagramFailure {
   372	  RelayDatagramFailure(
   373	    code: code,
   374	    phase: phase,
   375	    scope: .association,
   376	    disposition: .rejectDatagram
   377	  )
   378	}
   379	
   380	private func decodingFailure(
   381	  _ code: RelayDatagramFailureCode,
   382	  phase: RelayDatagramPhase
   383	) -> RelayDatagramFailure {
   384	  RelayDatagramFailure(
   385	    code: code,
   386	    phase: phase,
   387	    scope: .association,
   388	    disposition: .closeAssociation
   389	  )
   390	}
   391	
   392	private func localLimitFailure() -> RelayDatagramFailure {
   393	  RelayDatagramFailure(
   394	    code: .messageLengthExceedsLocalMaximum,
   395	    phase: .data,
   396	    scope: .association,
   397	    disposition: .rejectDatagram
   398	  )
   399	}
   400	
   401	private func appendDatagramBigEndian(_ value: UInt16, to data: inout Data) {
   402	  data.append(UInt8(truncatingIfNeeded: value >> 8))
   403	  data.append(UInt8(truncatingIfNeeded: value))
   404	}
