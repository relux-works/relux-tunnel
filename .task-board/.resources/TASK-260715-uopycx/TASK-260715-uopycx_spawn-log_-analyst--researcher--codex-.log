    28	static int
    29	task_io_yielder (HevTaskYieldType type, void *data)
    30	{
    31	    HevSocks5 *self = data;
    32	
    33	    if (self->type == HEV_SOCKS5_TYPE_UDP_IN_UDP) {
    34	        ssize_t res;
    35	        char buf;
    36	
    37	        res = recv (self->fd, &buf, sizeof (buf), 0);
    38	        if ((res == 0) || ((res < 0) && (errno != EAGAIN))) {
    39	            hev_socks5_set_timeout (self, 0);
    40	            return -1;
    41	        }
    42	    }
    43	
    44	    return hev_socks5_task_io_yielder (type, data);
    45	}
