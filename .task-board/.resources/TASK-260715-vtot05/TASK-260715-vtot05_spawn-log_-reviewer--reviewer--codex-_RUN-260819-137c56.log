   498	def read_exact_stream(stream: Any, size: int, label: str) -> bytes:
   499	    chunks: list[bytes] = []
   500	    remaining = size
   501	    while remaining:
   502	        chunk = stream.read(min(remaining, READ_CHUNK_BYTES))
   503	        if not chunk:
   504	            raise AssetManifestError(f"trusted relay archive {label} is truncated")
   505	        chunks.append(chunk)
   506	        remaining -= len(chunk)
   507	    return b"".join(chunks)
   508	
