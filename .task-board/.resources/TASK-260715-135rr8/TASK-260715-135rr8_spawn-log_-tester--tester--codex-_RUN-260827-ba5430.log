+      makeUDPPacket(
+        family: .ipv4,
+        source: Data([10, 43, UInt8(iteration / 250), UInt8(iteration % 250 + 1)]),
+        destination: Data([192, 0, 2, 1]),
+        sourcePort: UInt16(55_000 + iteration),
+        destinationPort: 7,
+        payload: Data([UInt8(iteration)])
