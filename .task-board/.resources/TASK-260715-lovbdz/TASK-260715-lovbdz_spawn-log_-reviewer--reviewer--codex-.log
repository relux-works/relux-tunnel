   552	/// Validated finite-token error code. It cannot contain endpoints or error text.
   553	public struct RedactedRuntimeErrorCode: Codable, Hashable, Sendable {
   554	  public static let maximumUTF8Bytes = 64
   555	  public let rawValue: String
   556	
   557	  public init(_ rawValue: String) throws {
   558	    guard Self.isValid(rawValue) else {
   559	      throw RuntimeMessageCodecError.unsupportedValue
   560	    }
