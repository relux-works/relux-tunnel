   215	
   216	    do {
   217	      failurePhase = .resolution
   218	      try await transition(to: .resolving)
   219	      let endpoints = try await withTimeout(
   220	        configuration.timeouts.resolution,
   221	        clock: dependencies.clock,
   222	        registry: asyncOperations,
   223	        operation: {
   224	          try await self.dependencies.resolver.resolve(
   225	            hostname: configuration.endpoint.host,
   226	            port: configuration.endpoint.port
   227	          )
   228	        }
   229	      )
   230	      guard let endpoint = endpoints.first else {
   231	        throw transportError(code: .resolutionFailed, phase: .resolution)
   232	      }
   233	
   234	      failurePhase = .tcpConnect
   235	      try await transition(to: .tcpConnecting)
   236	      let connection = try await withTimeout(
   237	        configuration.timeouts.tcpConnect,
   238	        clock: dependencies.clock,
   239	        registry: asyncOperations,
   240	        cleanupAbandonedResult: { connection in await connection.close() },
   241	        operation: { try await self.dependencies.connector.connect(to: endpoint) }
   242	      )
