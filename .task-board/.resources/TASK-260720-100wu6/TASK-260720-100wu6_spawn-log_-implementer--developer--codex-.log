+  @Test("byte, time, explicit, server rekey and keepalive share typed events")
+  func rekeyAndKeepaliveSchema() throws {
+    let clock = ContinuousClock()
+    let reasons: Set<SSHRekeyReason> = [
+      .client(.byteThreshold),
+      .client(.timeThreshold),
+      .client(.test),
+      .client(.manual),
+      .serverInitiated,
