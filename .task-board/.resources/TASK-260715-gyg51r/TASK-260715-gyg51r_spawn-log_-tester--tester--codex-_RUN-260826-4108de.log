+private func makeMatrixRow(
+  pressure: MTUMatrixPressure,
+  drops: Int,
+  recovery: Bool = true
+) -> MTUMatrixRow {
+  MTUMatrixRow(
+    id: "test-row",
+    family: .ipv4,
+    mtu: 1_500,
+    pressure: pressure,
+    trafficGenerator: "test",
+    durationNanoseconds: 1,
+    requestedSendBufferBytes: 4_096,
+    effectiveSendBufferBytes: 4_096,
+    requestedReceiveBufferBytes: 4_096,
