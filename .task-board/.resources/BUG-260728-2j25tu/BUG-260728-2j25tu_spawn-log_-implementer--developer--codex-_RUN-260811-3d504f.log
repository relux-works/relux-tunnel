   553	    #expect(baseline.metrics.remoteErrors == 2)
   554	    #expect(baseline.metrics.remoteCloses == 3)
   555	    #expect(baseline.metrics.lateCallbacks == 1)
   556	    #expect(baseline.inboundQueuedBytes == 0)
   557	    #expect(baseline.outboundQueuedBytes == 0)
   558	    #expect(relay.snapshot().isEmpty)
