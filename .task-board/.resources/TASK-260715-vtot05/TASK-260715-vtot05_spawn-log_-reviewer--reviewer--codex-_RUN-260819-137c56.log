   711	def open_bundle_directory(bundle: Path) -> int:
   712	    no_follow = getattr(os, "O_NOFOLLOW", None)
   713	    directory_flag = getattr(os, "O_DIRECTORY", None)
   714	    if no_follow is None or directory_flag is None:
   715	        raise AssetManifestError(
   716	            "trusted relay directory no-follow opens are unavailable"
   717	        )
   718	    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | no_follow | directory_flag
   719	    descriptor: int | None = None
   720	    try:
   721	        descriptor = os.open(bundle, flags)
   722	        status = os.fstat(descriptor)
   723	    except OSError as error:
   724	        if descriptor is not None:
   725	            os.close(descriptor)
   726	        raise AssetManifestError("relay asset bundle is missing or unsafe") from error
   727	    if not stat.S_ISDIR(status.st_mode):
   728	        os.close(descriptor)
   729	        raise AssetManifestError("relay asset bundle is missing or unsafe")
   730	    return descriptor
