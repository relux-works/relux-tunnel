            ["git", "show", f"{revision}:{path}"],
            cwd=ROOT,
            check=True,
            capture_output=True,
        )
    except (OSError, subprocess.CalledProcessError) as error:
        raise SupplyChainError(f"pinned Git input is unavailable: {path}") from error
    return result.stdout


