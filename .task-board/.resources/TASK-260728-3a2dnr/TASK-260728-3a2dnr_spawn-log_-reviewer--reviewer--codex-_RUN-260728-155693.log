state = {}
stack = []
cycles = []
visit = lambda do |id|
  return if state[id] == 2
  if state[id] == 1
    i = stack.index(id) || 0
    cycles << (stack[i..] + [id])
    return
  end
  state[id] = 1
  stack << id
  Array(by[id][\"blockedBy\"]).each { |b| visit.call(b) if by.key?(b) }
  stack.pop
  state[id] = 2
end
by.each_key { |id| visit.call(id) }
leaf = data.count { |x| x[\"id\"].start_with?(\"TASK-\", \"BUG-\") }
blocked = data.select { |x| x[\"status\"] == \"blocked\" }.map { |x| x[\"id\"] }
puts \"elements=#{data.length}\"
puts \"leaf_tasks_bugs=#{leaf}\"
puts \"missing_blockers=#{missing.length}\"
puts \"cycles=#{cycles.length}\"
puts \"blocked_count=#{blocked.length}\"
puts \"blocked_ids=#{blocked.sort.join(\",\")}\" 
exit 1 unless missing.empty? && cycles.empty?
