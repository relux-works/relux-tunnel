  2215	  private func transition(to next: SSHConnectionState) async throws {
  2216	    guard state.permitsTransition(to: next) else {
  2217	      throw transportError(code: .invalidState, phase: phase(for: state))
  2218	    }
  2219	    let previous = state
  2220	    state = next
  2221	    await emit(.connectionTransition(from: previous, to: next))
  2222	  }
