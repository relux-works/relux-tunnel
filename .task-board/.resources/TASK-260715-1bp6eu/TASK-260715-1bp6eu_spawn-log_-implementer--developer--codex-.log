+      values.append(value)
+    } else {
+      waiters.removeFirst().resume(returning: value)
+    }
+  }
+
+  func next() async -> Value {
+    if !values.isEmpty { return values.removeFirst() }
+    return await withCheckedContinuation { waiters.append($0) }
+  }
