   941	        except OSError as error:
   942	            raise AssetManifestError(
   943	                "relay asset bundle destination is unavailable"
   944	            ) from error
   945	        if status is not None and (
   946	            not stat.S_ISDIR(status.st_mode) or stat.S_ISLNK(status.st_mode)
   947	        ):
   948	            raise AssetManifestError("relay asset bundle destination is unsafe")
