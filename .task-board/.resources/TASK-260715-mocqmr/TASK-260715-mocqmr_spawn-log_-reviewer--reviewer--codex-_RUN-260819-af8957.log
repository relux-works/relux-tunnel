name: ci

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  generated-project-credential-free:
    name: generated project credential-free validation
    # macos-15 is the arm64 image; keep this label paired with the arm64 Mise checksum.
    runs-on: macos-15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          path: relux-tunnel

      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: relux-works/relux-proxy
          ref: 2557aba1c030d0643d76e0bc3b185f6d5fd172e1
          fetch-depth: 0
          persist-credentials: false
          path: relux-proxy

      - uses: jdx/mise-action@3c2e0cf82a5b2e5249f0d3635a4d83d0ae861518 # v4.2.5
        with:
          version: 2026.3.10
          sha256: c7a0eb1035de974b42d36b69c4b55b836c06b455b990dd6ac530aaf05d4a8a17 # mise-v2026.3.10-macos-arm64
          install: false
          cache: false

      - name: Run the local credential-free gate
        working-directory: relux-tunnel
        run: make credential-free-validate LEGACY_ROOT="$GITHUB_WORKSPACE/relux-proxy"

      - name: Upload privacy-safe validation evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: credential-free-generated-project-${{ github.run_id }}
          path: |
            relux-tunnel/.temp/TASK-260715-sbrrp7/credential-free-validation/summary.log
            relux-tunnel/.temp/TASK-260715-sbrrp7/credential-free-validation/environment.log
            relux-tunnel/.temp/TASK-260715-sbrrp7/credential-free-validation/logs
          if-no-files-found: error
          retention-days: 14

  validate:
    name: board + spec validation
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Validate workflow YAML
        run: |
          python3 - <<'PY'
          import glob, sys, yaml
          bad = False
          for f in glob.glob(".github/workflows/*.yml"):
              try:
                  yaml.safe_load(open(f))
                  print(f"ok   {f}")
              except Exception as e:
                  print(f"FAIL {f}: {e}"); bad = True
          sys.exit(1 if bad else 0)
          PY

      - name: Check spec presence
        run: |
          missing=0
          for f in architecture decisions platform-distribution product \
                   routing-dns-lifecycle security-privacy ssh-transport \
                   relay-protocol packet-plane threat-model validation delivery; do
            if [ ! -f ".spec/$f.md" ]; then echo "MISSING .spec/$f.md"; missing=1; fi
          done
          [ "$missing" = 0 ] && echo "all required specs present"
          exit $missing

      - name: Check board structure
        run: |
          python3 - <<'PY'
          import os, sys
          root = ".task-board"
          bad = False
          if not os.path.isdir(root):
              print("no .task-board directory"); sys.exit(1)
          n = 0
          for dirpath, dirnames, filenames in os.walk(root):
              # .resources/ holds resource payloads keyed by element id, not board elements
              if ".resources" in dirnames:
                  dirnames.remove(".resources")
              base = os.path.basename(dirpath)
              if base.split("-")[0] in ("EPIC", "STORY", "TASK", "BUG"):
                  n += 1
                  for req in ("README.md", "progress.md"):
                      if req not in filenames:
                          print(f"FAIL {dirpath}: missing {req}"); bad = True
          print(f"checked {n} board elements")
          sys.exit(1 if bad or n == 0 else 0)
          PY

  relay-toolchain:
    name: pinned offline relay toolchain
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Verify checked-in pins and missing-input failure
        run: |
          make relay-supply-chain-audit relay-supply-chain-test relay-toolchain-check relay-toolchain-negative-test
          python3 -m unittest scripts/tests/test_relay_asset_smoke.py

      - name: Fetch the approved checksum-pinned Go input
        run: |
          mkdir -p .temp/relay-tools
          read -r go_archive go_sha go_url <<EOF
          $(python3 -c 'import json; d=json.load(open("relay/toolchain-manifest-v1.json")); x=next(v for v in d["hostToolArchives"] if v["host"] == "linux/amd64"); print(x["artifact"], x["sha256"], x["source"])')
          EOF
          curl --fail --location --proto '=https' --tlsv1.2 \
            --output ".temp/relay-tools/$go_archive" "$go_url"
          printf '%s  %s\n' "$go_sha" ".temp/relay-tools/$go_archive" | sha256sum --check --strict
          make relay-provision-go RELAY_GO_ARCHIVE=".temp/relay-tools/$go_archive"

      - name: Test, vet, license-extract, and clean-build all four targets offline
        run: |
          source_date_epoch=$(git show -s --format=%ct HEAD)
          make relay-toolchain-ci \
            RELAY_VERSION=0.0.0 \
            SOURCE_COMMIT="$GITHUB_SHA" \
            SOURCE_DATE_EPOCH="$source_date_epoch" \
            RELAY_BUILD_CLEAN_FLAG=--require-clean

  relay-portable-runtime:
    name: portable runtime ${{ matrix.target }} on ${{ matrix.runner }}
    strategy:
      fail-fast: false
      matrix:
        include:
          - target: darwin/amd64
            slug: darwin-amd64
            runner: macos-15-intel
          - target: darwin/arm64
            slug: darwin-arm64
            runner: macos-15
          - target: linux/amd64
            slug: linux-amd64
            runner: ubuntu-24.04
          - target: linux/arm64
            slug: linux-arm64
            runner: ubuntu-24.04-arm
    runs-on: ${{ matrix.runner }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Verify checked-in pins and runtime-gate tests
        run: make relay-toolchain-check relay-toolchain-negative-test

      - name: Fetch the approved checksum-pinned host tools
        env:
          RELAY_HOST_TARGET: ${{ matrix.target }}
        run: |
          mkdir -p .temp/relay-tools
          read -r go_archive go_sha go_url syft_archive syft_sha syft_url <<EOF
          $(python3 -c 'import json,os; d=json.load(open("relay/toolchain-manifest-v1.json")); h=os.environ["RELAY_HOST_TARGET"]; g=next(v for v in d["hostToolArchives"] if v["host"] == h); s=next(v for v in d["buildOnlyTools"][0]["hostArchives"] if v["host"] == h); print(g["artifact"], g["sha256"], g["source"], s["artifact"], s["sha256"], s["source"])')
          EOF
          curl --fail --location --proto '=https' --tlsv1.2 \
            --output ".temp/relay-tools/$go_archive" "$go_url"
          curl --fail --location --proto '=https' --tlsv1.2 \
            --output ".temp/relay-tools/$syft_archive" "$syft_url"
          python3 - "$go_sha" ".temp/relay-tools/$go_archive" "$syft_sha" ".temp/relay-tools/$syft_archive" <<'PY'
          import hashlib, pathlib, sys
          for expected, name in zip(sys.argv[1::2], sys.argv[2::2], strict=True):
              actual = hashlib.sha256(pathlib.Path(name).read_bytes()).hexdigest()
              if actual != expected:
                  raise SystemExit("checksum-pinned host tool mismatch")
          PY
          make relay-provision-tools \
            RELAY_GO_ARCHIVE=".temp/relay-tools/$go_archive" \
            RELAY_SYFT_ARCHIVE=".temp/relay-tools/$syft_archive"

      - name: Clean-build the exact four-asset manifest offline
        run: |
          source_date_epoch=$(git show -s --format=%ct HEAD)
          make relay-shell-release \
            RELAY_VERSION=0.0.0 \
            SOURCE_COMMIT="$GITHUB_SHA" \
            SOURCE_DATE_EPOCH="$source_date_epoch"

      - name: Gate native rootless stdio and runtime boundaries
        run: |
          mkdir -p ".build/relay/runtime-evidence/${{ matrix.slug }}"
          python3 scripts/relay_asset_smoke.py \
            --target "${{ matrix.target }}" \
            --runner-kind native \
            --runner-name "${{ matrix.runner }}" \
            --runner-owner TASK-260715-36gq4m \
            --require-native \
            --manifest .build/relay/apple-bundle-input/relux-relay-manifest-v1.json \
            --executable ".build/relay/apple-bundle-input/relux-relay-${{ matrix.slug }}" \
            --evidence ".build/relay/runtime-evidence/${{ matrix.slug }}/report.json"

      - name: Retain exact gated asset and privacy-safe runner evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: runtime-evidence-${{ matrix.slug }}-${{ github.run_id }}
          path: |
            .build/relay/apple-bundle-input/relux-relay-${{ matrix.slug }}
            .build/relay/apple-bundle-input/relux-relay-${{ matrix.slug }}.spdx.json
            .build/relay/apple-bundle-input/relux-relay-manifest-v1.json
            .build/relay/apple-bundle-input/relux-relay-SHA256SUMS
            .build/relay/runtime-evidence/${{ matrix.slug }}/report.json
          if-no-files-found: warn
          retention-days: 14
