     6	/// macOS normalization layer for Network.framework and Security.framework failures.
     7	/// Platform values are consumed for classification and are never copied into diagnostics.
     8	public enum MacOSSSHBootstrapErrorMapper {
     9	  public static func network(
    10	    _ error: NWError,
    11	    stage: SSHBootstrapStage,
    12	    configurationGeneration: UInt64,
    13	    context: SSHBootstrapDiagnosticContext = .none
    14	  ) -> SSHBootstrapProviderError {
    15	    switch error {
    16	    case .posix(let code):
    17	      return SSHBootstrapErrorMapper.transport(
    18	        posixCode: Int32(code.rawValue),
    19	        stage: stage,
    20	        configurationGeneration: configurationGeneration,
    21	        context: context
    22	      )
    23	    case .dns:
    24	      return SSHBootstrapErrorMapper.transport(
    25	        .unavailable,
    26	        stage: stage,
    27	        configurationGeneration: configurationGeneration,
    28	        context: context
    29	      )
    30	    case .tls:
    31	      return SSHBootstrapErrorMapper.transport(
    32	        .unexpected,
    33	        stage: stage,
    34	        configurationGeneration: configurationGeneration,
    35	        context: context
    36	      )
    37	    case .wifiAware:
    38	      return SSHBootstrapErrorMapper.transport(
    39	        .unavailable,
    40	        stage: stage,
    41	        configurationGeneration: configurationGeneration,
    42	        context: context
    43	      )
    44	    @unknown default:
    45	      return SSHBootstrapErrorMapper.transport(
    46	        .unexpected,
    47	        stage: stage,
    48	        configurationGeneration: configurationGeneration,
    49	        context: context
    50	      )
    51	    }
    52	  }
