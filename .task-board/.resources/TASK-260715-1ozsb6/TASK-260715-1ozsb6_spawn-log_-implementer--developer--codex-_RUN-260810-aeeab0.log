  1615	public protocol SSHTransport: AnyObject, Sendable {
  1616	  /// Valid only while the transport is idle. Returns after host acceptance and
  1617	  /// public-key authentication have moved the connection to `ready`.
  1618	  func connect(configuration: SSHConnectionConfiguration) async throws -> SSHSession
  1619	
  1620	  /// Opens an RFC 4254 direct-tcpip channel with the supplied endpoints verbatim.
  1621	  func openDirectTCPIP(
  1622	    destination: TunnelEndpoint,
  1623	    originator: TunnelEndpoint,
  1624	    policy: SSHChannelPolicy
  1625	  ) async throws -> any SSHByteChannel
  1626	
  1627	  /// Opens one session channel, sends exactly one exec request, and returns only
  1628	  /// after the peer accepts that request.
  1629	  func openExecChannel(
  1630	    request: SSHExecRequest,
  1631	    policy: SSHChannelPolicy
  1632	  ) async throws -> any SSHExecChannel
  1633	
  1634	  /// Performs bounded exec-stdin upload while draining stdout and stderr.
  1635	  func upload(_ request: SSHExecUploadRequest) async throws -> SSHExecExit
  1636	
  1637	  /// Uses the same production rekey path as automatic and server triggers.
  1638	  func requestRekey(reason: SSHClientRekeyReason) async throws
  1639	
  1640	  /// Sends through the configured keepalive path. Exact reply RTT is explicitly
  1641	  /// reported only when the adapter exposes the M3 observability semantic.
  1642	  func sendKeepalive() async throws -> SSHDeferredSemanticReport<Duration>
