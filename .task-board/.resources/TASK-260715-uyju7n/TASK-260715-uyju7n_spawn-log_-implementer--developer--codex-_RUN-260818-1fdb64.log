        "com.apple.security.application-groups": {
          "status": "prohibited",
          "portalCapability": false,
          "rationale": "Withheld under rule G4: the probe's own contract names no shared-container function. TASK-260715-1jckn0 scopes the disposable iOS probe to NETunnelProviderManager save, load, enable, start, status, app-message and stop, one provider protocol and a versioned response, and a clean stop; its AC3 puts the entire host-to-provider exchange on app messaging, which needs no App Group. The r4 rationale said the probe 'exercises the same shared-container path production depends on', but the path the probe actually exercises is sendProviderMessage, and G4 tests a mechanism currently selected on THIS target, never one inherited from the target it resembles. Granting it would make a disposable probe carry an entitlement it never calls and would put an App Group record into circulation with no reader.",
          "reopensOnly": "This row reopens if, and only if, TASK-260715-1jckn0 gains a concrete shared-container deliverable - a named snapshot or UserDefaults exchange that the probe writes on one side and reads on the other - carrying its own acceptance criterion and its own archive or runtime evidence. It does NOT reopen because the production iOS rows carry the group, nor to keep the probe target shaped like production, nor because iOS re-arms under ADR-024. Reopening is an amendment under section 11 that names the new probe acceptance criterion and re-creates the probe App Group record deleted in r5.",
          "decidedBy": "TASK-260715-ypo7yo r5, on reviewer verdict 04 F3"
        },
        "keychain-access-groups": {
          "status": "prohibited",
          "portalCapability": false,
          "rationale": "The probe handles no credentials.",
          "reopensOnly": "This row reopens if, and only if, TASK-260715-1jckn0 gains a deliverable in which the probe host writes a credential that the probe appex must read back, with its own acceptance criterion and evidence. Today the probe stores no credential: its scope is the NETunnelProviderManager lifecycle and a versioned app message, and its provider protocol carries no secret. It does NOT reopen merely because the production iOS pair shares a group - under rule G4's probeRule a probe inherits identifiers and profile classes, never entitlements.",
          "decidedBy": "TASK-260715-ypo7yo r5, on reviewer verdict 04 F1 (rule K2, applied to every withheld row rather than only the one the finding named)"
        },
        "com.apple.security.app-sandbox": {
          "status": "not-applicable",
          "portalCapability": false,
          "requirementSource": "platform-inherent",
          "requirementBasis": "iOS apps are always sandboxed.",
          "rationale": "Not an authored key on iOS."
        }
      }
