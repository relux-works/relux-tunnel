import copy, os, tempfile
from scripts import relay_supply_chain as sc
cfg = sc.load_json(sc.SOURCE_PATH)

def roots(root):
    for rel in cfg['runtimePolicy']['scanRoots']:
        (root/rel).mkdir(parents=True)

def probe(label, rel, body):
    with tempfile.TemporaryDirectory() as td:
        root=Path(td); roots(root)
        p=root/rel; p.parent.mkdir(parents=True, exist_ok=True); p.write_text(body, encoding='utf-8')
        try:
            sc.scan_runtime(cfg, root)
        except sc.SupplyChainError as e:
            print(f'REJECTED {label}: {e}')
        else:
            print(f'ACCEPTED {label}')

