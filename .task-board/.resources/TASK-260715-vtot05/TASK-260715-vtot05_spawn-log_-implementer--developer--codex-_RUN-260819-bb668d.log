+                end = text.find("`", index + 1)
+                if end > index + 1:
+                    value = text[index + 1 : end]
+                    if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", value):
+                        tokens.append(("identifier", value))
+                        index = end + 1
