    38	    log_file = hev_config_get_misc_log_file ();
    39	    log_level = hev_config_get_misc_log_level ();
    40	
    41	    res = hev_config_get_misc_connect_timeout ();
    42	    hev_socks5_set_connect_timeout (res);
    43	    res = hev_config_get_misc_tcp_read_write_timeout ();
    44	    hev_socks5_set_tcp_timeout (res);
    45	    res = hev_config_get_misc_udp_read_write_timeout ();
    46	    hev_socks5_set_udp_timeout (res);
    47	
    48	    res = hev_config_get_misc_udp_recv_buffer_size ();
    49	    hev_socks5_set_udp_recv_buffer_size (res);
    50	
    51	    res = hev_logger_init (log_level, log_file);
    52	    if (res < 0)
    53	        return -2;
    54	
    55	    res = hev_socks5_logger_init (log_level, log_file);
    56	    if (res < 0)
    57	        return -3;
    58	
    59	    nofile = hev_config_get_misc_limit_nofile ();
    60	    res = set_limit_nofile (nofile);
    61	    if (res < 0)
    62	        LOG_I ("set limit nofile");
    63	
    64	    pid_file = hev_config_get_misc_pid_file ();
    65	    if (pid_file)
    66	        run_as_daemon (pid_file);
    67	
    68	    res = hev_task_system_init ();
    69	    if (res < 0)
    70	        return -4;
    71	
    72	    lwip_init ();
    73	
    74	    res = hev_socks5_tunnel_init (tun_fd);
    75	    if (res < 0)
    76	        return -5;
    77	
    78	    hev_socks5_tunnel_run ();
    79	
    80	    hev_socks5_tunnel_fini ();
    81	    hev_socks5_logger_fini ();
    82	    hev_logger_fini ();
    83	    hev_config_fini ();
    84	    hev_task_system_fini ();
    85	
    86	    return 0;
    87	}
