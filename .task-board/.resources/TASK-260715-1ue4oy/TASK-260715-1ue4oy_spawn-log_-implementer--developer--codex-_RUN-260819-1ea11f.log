            members = bundle.getmembers()
            names = [member.name for member in members]
            expected_names = [asset["archivePath"] for asset in contract["assets"]]
            if names != expected_names or len(set(names)) != len(names):
                raise AssetManifestError(
                    "trusted relay archive member set or order changed"
                )
            contents_by_target: list[bytes] = []
            for member, asset in zip(members, contract["assets"], strict=True):
                if (
                    not member.isfile()
                    or member.issym()
                    or member.islnk()
                    or member.size != asset["byteSize"]
                    or stat.S_IMODE(member.mode) != 0o755
                ):
                    raise AssetManifestError(
                        "trusted relay archive contains an unsafe asset"
                    )
                stream = bundle.extractfile(member)
                if stream is None:
                    raise AssetManifestError(
                        "trusted relay archive asset is unreadable"
                    )
                contents = stream.read(asset["byteSize"] + 1)
                if len(contents) != member.size or stream.read(1):
                    raise AssetManifestError("trusted relay archive asset is truncated")
                if len(contents) != asset["byteSize"]:
                    raise AssetManifestError(
                        "trusted relay archive asset size mismatch"
                    )
