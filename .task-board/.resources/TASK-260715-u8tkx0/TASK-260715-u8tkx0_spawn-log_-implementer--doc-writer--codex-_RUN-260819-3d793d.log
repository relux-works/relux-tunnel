+)
+
+git diff --exit-code -- "${ROTATION_PATHS[@]}"
+git apply --check "$ROTATION_PATCH"
+git apply "$ROTATION_PATCH"
+make relay-supply-chain-generate
+make relay-supply-chain-audit relay-supply-chain-test relay-asset-manifest-test
