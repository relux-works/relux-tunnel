   421	  private func isRateLimited(
   422	    trigger: MemoryObservationTrigger, at now: ContinuousClock.Instant
   423	  ) -> Bool {
   424	    if trigger == .memoryWarning && state < .pressure { return false }
   425	    let prior = trigger == .cadence ? lastCadenceObservation : lastEventObservations[trigger]
   426	    let interval = trigger == .cadence ? configuration.cadence : configuration.minimumEventInterval
   427	    guard let prior else { return false }
   428	    return prior.duration(to: now) < interval
   429	  }
   430	
   431	  private func markAccepted(trigger: MemoryObservationTrigger, at now: ContinuousClock.Instant) {
   432	    if trigger == .cadence {
   433	      lastCadenceObservation = now
   434	    } else {
   435	      lastEventObservations[trigger] = now
   436	    }
   437	  }
   438	
   439	  private func sanitize(
   440	    _ sample: MemoryPlatformSample, overran: Bool
   441	  ) -> MemoryPlatformSample {
   442	    guard !overran else {
   443	      return MemoryPlatformSample(
   444	        physicalFootprint: .unavailable(
   445	          reason: .executionTimeExceeded, provenance: .taskVMPhysicalFootprint),
   446	        physicalFootprintPeak: .unavailable(
   447	          reason: .executionTimeExceeded, provenance: .taskVMPhysicalFootprint),
   448	        advisoryAvailableMemory: .unavailable(
   449	          reason: .executionTimeExceeded, provenance: .osProcessAvailableMemory))
   450	    }
   451	    let currentSample = sanitizeProvenance(
   452	      sample.physicalFootprint, expected: .taskVMPhysicalFootprint)
   453	    let peakSample = sanitizeProvenance(
   454	      sample.physicalFootprintPeak, expected: .taskVMPhysicalFootprint)
   455	    let advisorySample = sanitizeProvenance(
   456	      sample.advisoryAvailableMemory, expected: .osProcessAvailableMemory)
   457	    if let current = currentSample.bytes, let peak = peakSample.bytes, peak < current {
   458	      return MemoryPlatformSample(
   459	        physicalFootprint: .unavailable(
   460	          reason: .malformed, provenance: .taskVMPhysicalFootprint),
   461	        physicalFootprintPeak: .unavailable(
   462	          reason: .malformed, provenance: .taskVMPhysicalFootprint),
   463	        advisoryAvailableMemory: advisorySample)
   464	    }
   465	    return MemoryPlatformSample(
   466	      physicalFootprint: currentSample,
   467	      physicalFootprintPeak: peakSample,
   468	      advisoryAvailableMemory: advisorySample)
   469	  }
   470	
   471	  private func sanitizeProvenance(
   472	    _ sample: MemoryByteSample, expected: MemoryObservationProvenance
   473	  ) -> MemoryByteSample {
   474	    switch sample {
   475	    case .available(let bytes, let provenance) where provenance == expected:
   476	      return .available(bytes: bytes, provenance: provenance)
   477	    case .unavailable(let reason, let provenance) where provenance == expected:
   478	      return .unavailable(reason: reason, provenance: provenance)
   479	    case .available, .unavailable:
   480	      return .unavailable(reason: .malformed, provenance: expected)
   481	    }
   482	  }
   483	
   484	  private func sanitize(
   485	    _ ledger: MemoryLedgerAvailability, at now: ContinuousClock.Instant
   486	  ) -> MemoryLedgerAvailability {
   487	    guard case .available(let snapshot) = ledger else { return ledger }
   488	    guard snapshot.capturedAt <= now else { return .unavailable(.malformed) }
   489	    if snapshot.capturedAt.duration(to: now) > configuration.maximumEvidenceAge {
   490	      staleLedgerSampleCount = incrementSaturating(staleLedgerSampleCount)
   491	      return .unavailable(.stale)
   492	    }
   493	    let (total, overflow) = snapshot.currentBytes.addingReportingOverflow(snapshot.reservedBytes)
   494	    guard !overflow, snapshot.peakBytes >= snapshot.committedBytes,
   495	      snapshot.committedBytes >= snapshot.currentBytes,
   496	      snapshot.committedBytes >= snapshot.reservedBytes,
   497	      snapshot.committedBytes <= total
   498	    else { return .unavailable(.malformed) }
   499	    return ledger
   500	  }
   501	
   502	  private func nextState(
   503	    platform: MemoryPlatformSample,
   504	    ledger: MemoryLedgerAvailability,
   505	    warning: Bool,
   506	    actionsAcknowledged: Bool,
   507	    now: ContinuousClock.Instant
   508	  ) -> (MemoryWatermarkState, MemoryTransitionReason?) {
   509	    let entry = entrySeverity(platform: platform, ledger: ledger, warning: warning)
   510	    if entry.state > state {
   511	      recoveryEligibleSince = nil
   512	      return (entry.state, entry.reason)
   513	    }
   514	    guard state != .normal,
   515	      actionsAcknowledged,
   516	      allSignalsPermitRecovery(platform: platform, ledger: ledger, from: state)
   517	    else {
   518	      recoveryEligibleSince = nil
   519	      return (state, nil)
   520	    }
   521	    if recoveryEligibleSince == nil { recoveryEligibleSince = now }
   522	    guard recoveryEligibleSince!.duration(to: now) >= configuration.recoveryDwell else {
   523	      return (state, nil)
   524	    }
   525	    recoveryEligibleSince = now
   526	    let recovered = MemoryWatermarkState(rawValue: state.rawValue - 1)!
   527	    let next = max(recovered, entry.state)
   528	    return (next, next == state ? nil : .recovery)
   529	  }
   530	
   531	  private func entrySeverity(
   532	    platform: MemoryPlatformSample,
   533	    ledger: MemoryLedgerAvailability,
   534	    warning: Bool
   535	  ) -> (state: MemoryWatermarkState, reason: MemoryTransitionReason?) {
   536	    var result: (MemoryWatermarkState, MemoryTransitionReason?) =
   537	      warning ? (.pressure, .memoryWarning) : (.normal, nil)
   538	    func include(
   539	      _ bytes: UInt64?, _ thresholds: MemorySignalThresholds, _ reason: MemoryTransitionReason
   540	    ) {
   541	      guard let bytes else { return }
   542	      let candidate: MemoryWatermarkState
   543	      if bytes <= thresholds.criticalEnterBytes {
   544	        candidate = .critical
   545	      } else if bytes <= thresholds.pressureEnterBytes {
   546	        candidate = .pressure
   547	      } else if bytes <= thresholds.softEnterBytes {
   548	        candidate = .soft
   549	      } else {
   550	        candidate = .normal
   551	      }
   552	      if candidate > result.0 { result = (candidate, reason) }
   553	    }
   554	    if case .available(let snapshot) = ledger {
   555	      include(
   556	        headroom(limit: configuration.globalLedgerCeilingBytes, used: snapshot.committedBytes),
   557	        configuration.ledgerHeadroom, .ledgerHeadroom)
   558	    }
   559	    include(
   560	      platform.physicalFootprint.bytes.map {
   561	        headroom(limit: configuration.deviceBaselineBytes, used: $0)
   562	      }, configuration.physicalHeadroom, .physicalHeadroom)
   563	    include(
   564	      platform.advisoryAvailableMemory.bytes,
   565	      configuration.advisoryAvailable, .advisoryAvailable)
   566	    return result
   567	  }
   568	
   569	  private func allSignalsPermitRecovery(
   570	    platform: MemoryPlatformSample,
   571	    ledger: MemoryLedgerAvailability,
   572	    from state: MemoryWatermarkState
   573	  ) -> Bool {
   574	    guard case .available(let ledgerSnapshot) = ledger,
   575	      let footprint = platform.physicalFootprint.bytes,
   576	      platform.physicalFootprintPeak.bytes != nil,
   577	      let advisory = platform.advisoryAvailableMemory.bytes
   578	    else { return false }
   579	    return aboveExit(
   580	      headroom(limit: configuration.globalLedgerCeilingBytes, used: ledgerSnapshot.committedBytes),
   581	      configuration.ledgerHeadroom, state: state)
   582	      && aboveExit(
   583	        headroom(limit: configuration.deviceBaselineBytes, used: footprint),
   584	        configuration.physicalHeadroom, state: state)
   585	      && aboveExit(advisory, configuration.advisoryAvailable, state: state)
   586	  }
   587	
   588	  private func aboveExit(
   589	    _ value: UInt64, _ thresholds: MemorySignalThresholds, state: MemoryWatermarkState
   590	  ) -> Bool {
   591	    switch state {
   592	    case .critical: value > thresholds.criticalExitBytes
   593	    case .pressure: value > thresholds.pressureExitBytes
   594	    case .soft: value > thresholds.softExitBytes
   595	    case .normal: true
   596	    }
   597	  }
   598	
   599	  private func unavailableCount(_ sample: MemoryPlatformSample) -> UInt64 {
   600	    [sample.physicalFootprint, sample.physicalFootprintPeak, sample.advisoryAvailableMemory]
   601	      .reduce(0) { count, value in
   602	        if case .unavailable = value { return count + 1 }
   603	        return count
   604	      }
   605	  }
   606	
   607	  private func unavailableCount(_ ledger: MemoryLedgerAvailability) -> UInt64 {
   608	    if case .unavailable = ledger { return 1 }
   609	    return 0
   610	  }
   611	}
