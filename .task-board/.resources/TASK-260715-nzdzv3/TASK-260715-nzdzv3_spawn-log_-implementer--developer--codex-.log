+
+extension UInt64 {
+    fileprivate func addingWithoutOverflow(_ other: UInt64) -> UInt64 {
+        let (result, overflow) = self.addingReportingOverflow(other)
+        return overflow ? .max : result
     }
 }
 
diff --git a/Dependencies/ReluxNIOSSH/Sources/NIOSSH/ReluxPolicies.swift b/Dependencies/ReluxNIOSSH/Sources/NIOSSH/ReluxPolicies.swift
