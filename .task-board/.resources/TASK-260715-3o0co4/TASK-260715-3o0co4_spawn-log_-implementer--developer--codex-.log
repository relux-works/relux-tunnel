+    fixture.readinessFactory.latest?.signal(.readable)
+
+    #expect(await eventually { await flow.writtenPackets.count == 2 })
+    #expect(
+      await flow.writtenPackets == [
+        TunnelPacket(payload: ipv4, addressFamily: .ipv4),
