+    if(context->hold_reads)
+        return -EAGAIN;
+
+    count = recv(socket, buffer, length, flags);
+    if(count < 0) {
+        if(errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)
+            return -EAGAIN;
+        return -errno;
+    }
+    return count;
+}
