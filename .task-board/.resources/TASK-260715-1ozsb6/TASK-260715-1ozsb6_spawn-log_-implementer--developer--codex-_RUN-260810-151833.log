+  func waitForReadiness(_ interests: Set<SSHTCPReadiness>) async throws
+    -> Set<SSHTCPReadiness>
+  {
+    if controller.consume() { throw POSIXFixtureError.system(ECONNRESET) }
+    return try await base.waitForReadiness(interests)
