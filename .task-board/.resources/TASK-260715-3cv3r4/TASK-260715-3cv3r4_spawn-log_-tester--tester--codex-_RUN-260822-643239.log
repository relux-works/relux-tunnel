+) throws -> Data {
+  var object = try #require(JSONSerialization.jsonObject(with: data) as? [String: Any])
+  try mutation(&object)
+  return try JSONSerialization.data(
+    withJSONObject: object,
+    options: [.sortedKeys, .withoutEscapingSlashes]
+  )
+}
