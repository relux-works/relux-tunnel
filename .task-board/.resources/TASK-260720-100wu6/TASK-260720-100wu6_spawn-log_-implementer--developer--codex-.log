+    self.activeKeyExchange = activeKeyExchange
+    self.consecutiveKeepaliveMisses = consecutiveKeepaliveMisses
+    self.lastKeepaliveRTTNanoseconds = lastKeepaliveRTTNanoseconds
   }
 }
 
