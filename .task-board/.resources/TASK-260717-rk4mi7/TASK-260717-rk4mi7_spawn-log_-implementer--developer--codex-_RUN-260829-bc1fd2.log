+import AppKit
+import Foundation
+import Observation
+import Sparkle
+import SwiftUI
+
+enum ReluxUpdateChannel: String, CaseIterable, Equatable {
+  case stable
+  case preRelease
+
+  var title: LocalizedStringResource {
