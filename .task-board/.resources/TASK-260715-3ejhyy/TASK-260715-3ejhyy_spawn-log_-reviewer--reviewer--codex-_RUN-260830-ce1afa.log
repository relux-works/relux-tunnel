   486	/// macOS-only production factory entry point.
   487	///
   488	/// Manifest validation completes before any component factory closure runs.
   489	/// Every `makeRuntime` call then creates one fresh coordinator dependency graph
   490	/// and one monotonically increasing runtime generation.
   491	public actor MacOSProductionDependencyFactory: TunnelRuntimeFactory {
   492	  public typealias BindingManifestSource = @Sendable () throws -> Data?
   493	
   494	  private let bindingManifestSource: BindingManifestSource
   495	  private let runtimeInputs: MacOSProductionRuntimeInputs
   496	  private let componentFactories: MacOSProductionComponentFactories
   497	  private var latestGeneration: UInt64
   498	
   499	  public init(
   500	    bindingManifestSource: @escaping BindingManifestSource,
   501	    runtimeInputs: MacOSProductionRuntimeInputs,
   502	    componentFactories: MacOSProductionComponentFactories,
   503	    initialGeneration: UInt64 = 0
   504	  ) {
   505	    self.bindingManifestSource = bindingManifestSource
   506	    self.runtimeInputs = runtimeInputs
   507	    self.componentFactories = componentFactories
   508	    latestGeneration = initialGeneration
   509	  }
   510	
   511	  public func makeRuntime(
   512	    context: TunnelRuntimeContext
   513	  ) async throws -> any TunnelRuntime {
   514	    let manifest: Data
   515	    do {
   516	      guard let loaded = try bindingManifestSource() else {
   517	        throw MacOSProductionBindingError.manifestAbsent
   518	      }
   519	      manifest = loaded
   520	    } catch let error as MacOSProductionBindingError {
   521	      throw error
   522	    } catch {
   523	      throw MacOSProductionBindingError.manifestUnreadable
   524	    }
   525	    let bindings = try MacOSProductionBindingManifestValidator.validate(
   526	      manifest,
   527	      diagnosticsWindow: runtimeInputs.diagnosticsWindow
   528	    )
   529	    guard runtimeInputs.maximumPendingPrivateConnections > 0,
   530	      runtimeInputs.privateAuthenticationTimeoutMilliseconds > 0,
   531	      !runtimeInputs.virtualDNSEndpoints.isEmpty
   532	    else {
   533	      throw MacOSProductionBindingError.incompatibleBinding("runtimeInputs")
   534	    }
   535	    guard latestGeneration < UInt64.max else {
   536	      throw TunnelRuntimeCoordinatorError.generationExhausted
   537	    }
   538	
   539	    // Selected concrete dependencies are created only after the manifest gate.
   540	    let selectedTransport = MacOSProviderSSHConfiguration.makeTransportFactory(
   541	      maximumTransportBufferBytes: bindings.sshTransportBufferBytes
   542	    )
   543	    let credentialProvider = MacOSProviderSSHConfiguration.makeCredentialProvider()
   544	    let configurationSource = try componentFactories.makeConfigurationSource()
   545	    let sshBootstrap = try componentFactories.makeSSHBootstrap(
   546	      MacOSProductionSSHBootstrapInputs(
   547	        transportFactory: selectedTransport,
   548	        credentialProvider: credentialProvider,
   549	        acceptedTransportBufferBytes: bindings.sshTransportBufferBytes,
   550	        acceptedInitialReceiveWindowBytes: bindings.sshInitialReceiveWindowBytes
   551	      )
   552	    )
   553	    let tcpFactory = try componentFactories.makeTCPFactory()
   554	    let dnsFactory = try componentFactories.makeDNSFactory()
   555	    let settingsPlanBuilder = try componentFactories.makeSettingsPlanBuilder()
   556	    let settingsApplier = try componentFactories.makeSettingsApplier()
   557	    let snapshotStore = try componentFactories.makeSnapshotStore()
   558	    let environment = context.dependencies
   559	    let privateIngressAdapter = componentFactories.makePrivateIngressAdapter
   560	    let inputs = runtimeInputs
   561	    let packetPlaneFactory = BridgeBackedM1PacketPlaneFactory(
   562	      configuration: bindings.packetBridgeConfiguration,
   563	      virtualDNSEndpoints: inputs.virtualDNSEndpoints
   564	    ) { ingress, _ in
   565	      let adapter = try privateIngressAdapter(ingress)
   566	      let boundaryFactory = HEVLoopbackSOCKSBoundaryFactory(
   567	        adapter: adapter,
   568	        maximumPendingConnections: inputs.maximumPendingPrivateConnections,
   569	        authenticationTimeoutMilliseconds: inputs.privateAuthenticationTimeoutMilliseconds
   570	      )
   571	      let descriptorConsumer = HEVDescriptorBorrowConsumer(
   572	        configuration: bindings.internalSOCKSConfiguration,
   573	        boundaryFactory: boundaryFactory,
   574	        logger: environment.logger,
   575	        metrics: environment.metrics
   576	      )
   577	      return PacketFlowBridge(
   578	        descriptorConsumer: descriptorConsumer,
   579	        clock: environment.clock,
   580	        logger: environment.logger,
   581	        metrics: environment.metrics
   582	      )
   583	    }
   584	
   585	    latestGeneration += 1
   586	    return TunnelRuntimeCoordinator(
   587	      runtimeGeneration: latestGeneration,
   588	      context: context,
   589	      dependencies: TunnelRuntimeCoordinatorDependencies(
   590	        configurationSource: configurationSource,
   591	        sshBootstrap: sshBootstrap,
   592	        tcpFactory: tcpFactory,
   593	        dnsFactory: dnsFactory,
   594	        packetPlaneFactory: packetPlaneFactory,
   595	        settingsPlanBuilder: settingsPlanBuilder,
   596	        settingsApplier: settingsApplier,
   597	        snapshotStore: snapshotStore
   598	      )
   599	    )
   600	  }
   601	}

