   285	  public func openDirectTCPIP(
   286	    destination: TunnelEndpoint,
   287	    originator: TunnelEndpoint,
   288	    policy: SSHChannelPolicy
   289	  ) async throws -> any SSHByteChannel {
   290	    guard let configuration else {
   291	      throw transportError(code: .invalidState, phase: .channelOpen)
   292	    }
   293	    let deadline = dependencies.clock.now().advanced(by: configuration.timeouts.channelOpen)
   294	    let permit = try await beginChannelOpen(until: deadline)
   295	    do {
   296	      let channel = try await performOpenDirectTCPIP(
   297	        destination: destination,
   298	        originator: originator,
   299	        policy: policy,
   300	        deadline: deadline
   301	      )
   302	      await endChannelOpen(permit)
   303	      return channel
   304	    } catch {
   305	      await endChannelOpen(permit)
   306	      throw error
   307	    }
   308	  }
