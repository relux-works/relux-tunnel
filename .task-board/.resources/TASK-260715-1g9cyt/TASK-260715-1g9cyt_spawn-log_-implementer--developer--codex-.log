diff --git a/NativeDependencies/Fixtures/ReluxNativeFixture/include/relux_native_fixture.h b/NativeDependencies/Fixtures/ReluxNativeFixture/include/relux_native_fixture.h
new file mode 100644
index 0000000000000000000000000000000000000000..13fe7e684aedc973f8e4298796b0c77a8b21d401
--- /dev/null
+++ b/NativeDependencies/Fixtures/ReluxNativeFixture/include/relux_native_fixture.h
@@ -0,0 +1,17 @@
+#ifndef RELUX_NATIVE_FIXTURE_H
+#define RELUX_NATIVE_FIXTURE_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+uint32_t relux_native_fixture_schema_version(void);
+uint32_t relux_native_fixture_mix(uint32_t value);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/NativeDependencies/manifest.json b/NativeDependencies/manifest.json
new file mode 100644
index 0000000000000000000000000000000000000000..1e3ea9f8e54e0d0a847efa233e0a58afad7d8b86
--- /dev/null
+++ b/NativeDependencies/manifest.json
@@ -0,0 +1,157 @@
+{
