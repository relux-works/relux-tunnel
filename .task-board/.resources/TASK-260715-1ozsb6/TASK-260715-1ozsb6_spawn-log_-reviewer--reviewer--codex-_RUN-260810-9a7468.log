  1915	  private func tearDown() async {
  1916	    let task = startTearDownIfNeeded()
  1917	    await task.value
  1918	    if teardownTask != nil { teardownTask = nil }
  1919	  }
  1920	
  1921	  private func startTearDownIfNeeded() -> Task<Void, Never> {
  1922	    if let teardownTask { return teardownTask }
  1923	    let task = Task { [weak self] in
  1924	      guard let self else { return }
  1925	      await self.performTearDown()
  1926	    }
  1927	    teardownTask = task
  1928	    return task
  1929	  }
