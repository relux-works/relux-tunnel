+            elif character == ")":
+                if stop_at_closing_paren and paren_depth == 0:
+                    return tokens, index + 1
+                paren_depth = max(0, paren_depth - 1)
+            tokens.append(("symbol", character))
+            index += 1
+        return tokens, index
+
+    return tokenize(0, stop_at_closing_paren=False)[0]
