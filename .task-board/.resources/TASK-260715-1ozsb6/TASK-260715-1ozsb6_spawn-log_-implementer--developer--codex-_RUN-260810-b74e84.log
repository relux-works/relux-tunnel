+private actor CancellationIgnoringResolver: SSHNetworkResolver {
+  private var continuation: CheckedContinuation<[SSHResolvedEndpoint], Never>?
+  private(set) var wasReleased = false
+
+  var isWaiting: Bool { continuation != nil }
