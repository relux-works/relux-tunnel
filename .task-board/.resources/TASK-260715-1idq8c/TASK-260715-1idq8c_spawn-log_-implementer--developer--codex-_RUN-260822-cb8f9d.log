### 2240 — Apple UI fixture infrastructure is safe; native unsigned XCUITest cannot bootstrap (TASK-260715-1idq8c)
- IMPLEMENTATION: One Swift package target owns BEM-like identifiers, typed launch keys, fail-closed non-networked configuration, and 18 deterministic profile/trust/capability/failure/diagnostic/onboarding/migration/privacy fixtures. Two isolated fixture hosts and two shared-source UI-test targets provide Page Objects, condition waits, step screenshots, xcresult extraction, and controlled snapshot diff packets without importing NetworkExtension or either production adapter.
- VERIFICATION: The iPhone 17 Pro iOS 26.5 Simulator smoke passed unsigned, emitted two step screenshots, and produced an xcresult; mandatory visual inspection passed orientation, layout, content, and black-screen checks for both images. The controlled mismatch exited `1` as designed and emitted `reference.png`, `failed.png`, and `diff.png`. Focused contracts, strict Swift formatting, Python/shell syntax, deterministic workspace validation, unsigned macOS host/provider validation, all 455 Swift tests, and `swift build` passed.
- BLOCKER: The native macOS UI-test bundle compiled, but the runner exited before bootstrap with signal kill and xcodebuild exit `65`. Strict read-only signature verification reports that the assembled runner's resources do not satisfy its retained signature. Repair requires re-signing the assembled test runner/app in an authorized lane, while the binding execution brief forbids any signing on this workstation. No provider/system extension was built by the UI-test scheme; no app/provider installation, VPN preference, tunnel, route, interface, packet-filter, or DNS operation ran.
#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
task_root="$repo_root/.temp/TASK-260715-1idq8c/apple-ui-test"
mkdir -p "$task_root"
run_root=$(mktemp -d "$task_root/run.XXXXXX")
derived_data="$run_root/DerivedData"
cd "$repo_root"

./scripts/generate-workspace.sh --clean

run_ui_test() {
  scheme=$1
  destination=$2
  result_name=$3
  test_target=$4
  result_bundle="$run_root/$result_name.xcresult"
  log="$run_root/$result_name-xcodebuild.log"

  if xcodebuild \
    -workspace ReluxTunnel.xcworkspace \
    -scheme "$scheme" \
    -configuration Debug \
    -destination "$destination" \
    -derivedDataPath "$derived_data" \
    -resultBundlePath "$result_bundle" \
    -only-testing:"$test_target/ReluxUITestSmokeTests/testDiagnosticFixtureProducesStepScreenshots" \
    CODE_SIGNING_ALLOWED=NO \
    CODE_SIGNING_REQUIRED=NO \
    test > "$log" 2>&1; then
    row_status=0
  else
    row_status=$?
  fi

  if [ "$row_status" -eq 0 ]; then
    python3 scripts/extract_apple_ui_test_artifacts.py \
      "$result_bundle" "$run_root/$result_name-artifacts"
  fi
  return "$row_status"
}

if run_ui_test \
  ReluxProxyMacUITests \
  'platform=macOS' \
  macos \
  ReluxProxyMacUITests; then
  macos_status=0
else
  macos_status=$?
fi

simulator_id=$(
  xcrun simctl list devices available -j | python3 -c '
import json, sys
devices = json.load(sys.stdin)["devices"]
for runtime in sorted(devices, reverse=True):
    for device in devices[runtime]:
        if device.get("isAvailable") and device.get("name", "").startswith("iPhone"):
            print(device["udid"])
            raise SystemExit(0)
raise SystemExit("no available iPhone Simulator")
'
)
if run_ui_test \
  ReluxProxyIOSUITests \
  "platform=iOS Simulator,id=$simulator_id" \
  ios-simulator \
  ReluxProxyIOSUITests; then
  ios_status=0
else
  ios_status=$?
fi

snapshot_inputs="$run_root/snapshot-inputs"
snapshot_artifacts="$run_root/snapshot-diff-artifacts/controlled-mismatch"
swift scripts/generate-snapshot-diff-fixtures.swift "$snapshot_inputs"
set +e
swift run relux-snapshot-diff \
  "$snapshot_inputs/reference-input.png" \
  "$snapshot_inputs/failed-input.png" \
  "$snapshot_artifacts" > "$run_root/snapshot-diff.log" 2>&1
snapshot_status=$?
set -e
if [ "$snapshot_status" -ne 1 ]; then
  echo "error: controlled snapshot mismatch returned $snapshot_status, expected 1" >&2
  exit 1
fi
for artifact in reference.png failed.png diff.png; do
  test -f "$snapshot_artifacts/$artifact"
done

printf 'macos_xcodebuild_exit=%s\nios_simulator_xcodebuild_exit=%s\nsnapshot_diff_exit=%s\n' \
  "$macos_status" "$ios_status" "$snapshot_status" > "$run_root/summary.txt"
printf '%s\n' "$run_root"

if [ "$macos_status" -ne 0 ] || [ "$ios_status" -ne 0 ]; then
  exit 1
fi
#!/usr/bin/env python3
"""Static safety and single-source checks for Apple UI-test infrastructure."""

from __future__ import annotations

import re
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
SHARED = ROOT / "Sources/ReluxAppleUITestShared"
FIXTURE_HOST = ROOT / "App/ReluxUITestFixtureHost"
UI_TESTS = ROOT / "Tests/ReluxAppleUITestsShared"
LAUNCH_KEYS = SHARED / "ReluxUITestLaunchConfiguration.swift"


def fail(message: str) -> None:
    raise SystemExit(f"error: {message}")


def swift_files(*roots: Path) -> list[Path]:
    return sorted(path for root in roots for path in root.rglob("*.swift"))


def main() -> int:
    files = swift_files(SHARED, FIXTURE_HOST, UI_TESTS)
    if not files:
        fail("Apple UI-test sources are missing")

    forbidden_waits = re.compile(r"\b(Thread\.sleep|sleep|usleep)\s*\(")
    for path in files:
        text = path.read_text(encoding="utf-8")
        if forbidden_waits.search(text):
            fail(f"fixed wall-clock wait found in {path.relative_to(ROOT)}")
        if path != LAUNCH_KEYS and "RELUX_UI_TEST_" in text:
            fail(f"raw launch key duplicated outside shared authority: {path.relative_to(ROOT)}")

    project = (ROOT / "Project.swift").read_text(encoding="utf-8")
    for name in (
        "ReluxProxyMacUITestFixtureHost",
        "ReluxProxyMacUITests",
        "ReluxProxyIOSUITestFixtureHost",
        "ReluxProxyIOSUITests",
    ):
        if name not in project:
            fail(f"missing generated target definition: {name}")
    infrastructure = project[project.index("private let appleUITestInfrastructureTargets") :]
    infrastructure = infrastructure[: infrastructure.index("private var generatedSchemeNames")]
    for forbidden in ("NetworkExtension", "ReluxTunnelIOSAdapter", "ReluxTunnelMacOSAdapter"):
        if forbidden in infrastructure:
            fail(f"fixture graph contains prohibited production dependency: {forbidden}")

    fixtures = (SHARED / "ReluxUITestFixture.swift").read_text(encoding="utf-8")
    for category in (
        "profile",
        "trust",
        "capability",
        "failure",
        "diagnostic",
        "onboarding",
        "migration",
        "privacy",
    ):
        if f"case {category}" not in fixtures:
            fail(f"fixture category missing: {category}")

    print("Apple UI-test source, synchronization, fixture, and safety contracts passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

