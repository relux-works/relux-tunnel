    try checkCancellationAndOwnership()
    guard configurationSnapshot?.profileIdentifier == reference.profileIdentifier,
      configurationSnapshot?.routeMode == .compatible
    else {
      throw TunnelRuntimeCoordinatorError.startupFailed(
