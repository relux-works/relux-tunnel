    83	## How to Use
    84	
    85	### Config
    86	
    87	```yaml
    88	tunnel:
    89	  # Interface name
    90	  name: tun0
    91	  # Interface MTU
    92	  mtu: 8500
    93	  # Multi-queue
    94	  multi-queue: false
    95	  # IPv4 address
    96	  ipv4: 198.18.0.1
    97	  # IPv6 address
    98	  ipv6: 'fc00::1'
    99	  # ICMP Echo mode (off|reply)
   100	  icmp: 'off'
   101	  # Post up script
   102	# post-up-script: up.sh
   103	  # Pre down script
   104	# pre-down-script: down.sh
   105	
   106	socks5:
   107	  # Socks5 server port
   108	  port: 1080
   109	  # Socks5 server address (ipv4/ipv6)
   110	  address: 127.0.0.1
   111	  # Socks5 UDP relay mode (tcp|udp)
   112	  udp: 'udp'
   113	  # Override the UDP address provided by the Socks5 server (ipv4/ipv6)
   114	# udp-address: ''
   115	  # Socks5 handshake using pipeline mode
   116	# pipeline: false
   117	  # Socks5 server username
   118	# username: 'username'
   119	  # Socks5 server password
   120	# password: 'password'
   121	  # Socket mark
   122	# mark: 0
   123	  # TCP fastopen
   124	# tcp-fastopen: false
   125	
   126	#mapdns:
   127	  # Mapped DNS address
   128	# address: 198.18.0.2
   129	  # Mapped DNS port
   130	# port: 53
   131	  # Mapped IP network base
   132	# network: 100.64.0.0
   133	  # Mapped IP network mask
   134	# netmask: 255.192.0.0
   135	  # Mapped DNS cache size
   136	# cache-size: 10000
   137	
   138	#misc:
   139	  # task stack size (bytes)
   140	# task-stack-size: 86016
   141	  # tcp buffer size (bytes)
   142	# tcp-buffer-size: 65536
   143	  # udp socket recv buffer (SO_RCVBUF) size (bytes)
   144	# udp-recv-buffer-size: 524288
   145	  # number of udp buffers in splice, 1500 bytes per buffer.
   146	# udp-copy-buffer-nums: 10
   147	  # maximum session count (0: unlimited)
   148	# max-session-count: 0
   149	  # connect timeout (ms)
   150	# connect-timeout: 10000
   151	  # TCP read-write timeout (ms)
   152	# tcp-read-write-timeout: 300000
   153	  # UDP read-write timeout (ms)
   154	# udp-read-write-timeout: 60000
   155	  # stdout, stderr or file-path
   156	# log-file: stderr
   157	  # debug, info, warn or error
   158	# log-level: warn
   159	  # If present, run as a daemon with this pid file
   160	# pid-file: /run/hev-socks5-tunnel.pid
   161	  # If present, set rlimit nofile; else use default value
   162	# limit-nofile: 65535
