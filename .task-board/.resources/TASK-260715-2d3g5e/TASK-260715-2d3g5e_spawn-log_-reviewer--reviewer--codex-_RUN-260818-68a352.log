293.6694,184.7373 L328.37,180.7373 L293.6694,176.7373 L293.6694,169.9473 L283.6694,159.9473 L11,159.9473 A0,0 0 0 0 11,159.9473" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><path d="M283.6694,159.9473 L283.6694,169.9473 L293.6694,169.9473 L283.6694,159.9473" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="261.6694" x="17" y="178.0171">Boundary transfers the exclusive socket</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="230.5024" x="17" y="193.8164">at the first CONNECT-request byte.</text></g><g class="entity" data-qualified-name="GMN35" data-source-line="37" id="ent0036"><path d="M725.88,524.9473 L725.88,541.7373 L690.87,545.7373 L725.88,549.7373 L725.88,566.5459 A0,0 0 0 0 725.88,566.5459 L1016.7887,566.5459 A0,0 0 0 0 1016.7887,566.5459 L1016.7887,534.9473 L1006.7887,524.9473 L725.88,524.9473 A0,0 0 0 0 725.88,524.9473" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><path d="M1006.7887,524.9473 L1006.7887,534.9473 L1016.7887,534.9473 L1006.7887,524.9473" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="256.4707" x="731.88" y="543.0171">One open attempt. A late channel after</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="269.9087" x="731.88" y="558.8164">rejection, timeout, or cancellation closes.</text></g><g class="entity" data-qualified-name="GMN38" data-source-line="42" id="ent0039"><path d="M1089.14,774.7373 L1089.14,799.4373 L1053.95,803.4373 L1089.14,807.4373 L1089.14,832.1353 A0,0 0 0 0 1089.14,832.1353 L1355.5213,832.1353 A0,0 0 0 0 1355.5213,832.1353 L1355.5213,784.7373 L1345.5213,774.7373 L1089.14,774.7373 A0,0 0 0 0 1089.14,774.7373" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><path d="M1345.5213,774.7373 L1345.5213,784.7373 L1355.5213,784.7373 L1345.5213,774.7373" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="165.1533" x="1095.14" y="792.8071">Two independent pumps.</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="222.2886" x="1095.14" y="808.6064">One bounded buffer per direction.</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="245.3813" x="1095.14" y="824.4058">No side queue and no flow migration.</text></g><g class="entity" data-qualified-name="GMN41" data-source-line="48" id="ent0042"><path d="M1054.27,1040.3373 L1054.27,1057.1373 L1020.01,1061.1373 L1054.27,1065.1373 L1054.27,1081.9359 A0,0 0 0 0 1054.27,1081.9359 L1386.394,1081.9359 A0,0 0 0 0 1386.394,1081.9359 L1386.394,1050.3373 L1376.394,1040.3373 L1054.27,1040.3373 A0,0 0 0 0 1054.27,1040.3373" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><path d="M1376.394,1040.3373 L1376.394,1050.3373 L1386.394,1050.3373 L1376.394,1040.3373" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="223.2471" x="1060.27" y="1058.4071">Local EOF calls finishWriting once.</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="311.124" x="1060.27" y="1074.2064">SSH EOF calls local shutdown(SHUT_WR) once.</text></g><g class="entity" data-qualified-name="GMN44" data-source-line="53" id="ent0045"><path d="M853.98,1163.1373 L853.98,1195.7373 L819.21,1199.7373 L853.98,1203.7373 L853.98,1236.3346 A0,0 0 0 0 853.98,1236.3346 L1162.6812,1236.3346 A0,0 0 0 0 1162.6812,1236.3346 L1162.6812,1173.1373 L1152.6812,1163.1373 L853.98,1163.1373 A0,0 0 0 0 853.98,1163.1373" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><path d="M1152.6812,1163.1373 L1152.6812,1173.1373 L1162.6812,1173.1373 L1152.6812,1163.1373"