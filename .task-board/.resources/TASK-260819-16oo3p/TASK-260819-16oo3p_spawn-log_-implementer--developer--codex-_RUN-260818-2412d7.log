+done
+for target in 127.0.0.1 127.2.3.4 ::1 0:0:0:0:0:0:0:1; do
+  expect_preflight_failure \
+    "$REQUIRED_PHYSICAL_OPT_IN" "$target" "$target" "$remote_fingerprint" "$denylist"
+done
+expect_preflight_failure \
