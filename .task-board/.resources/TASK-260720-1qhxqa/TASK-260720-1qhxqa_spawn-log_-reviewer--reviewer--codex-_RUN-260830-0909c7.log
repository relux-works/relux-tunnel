def target_block(text: str, name: str) -> str:
    row = "REPOSITORY-GRAPH"
    visible, code = swift_lexical_view(text, row)
    declarations = [
        match
        for match in re.finditer(
            rf"\.target\s*\(\s*name:\s*\"{re.escape(name)}\"\s*,", visible
        )
        if code[match.start()]
