+#!/usr/bin/env python3
+"""Native/emulated runtime-boundary gate for one manifest-selected relay asset."""
+
+from __future__ import annotations
+
+import argparse
+import errno
+import hashlib
+import json
+import os
+import platform
+import selectors
+import shutil
+import signal
+import stat
