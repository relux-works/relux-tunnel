    ],
    dependencies: [.package(product: "ReluxTunnelCore")],
    settings: testTargetSettings
  ),
  .target(
    name: "ReluxProxyMacTunnelTests",
    destinations: [.mac],
    product: .unitTests,
    bundleId: "$(RELUX_MACOS_PROVIDER_BUNDLE_ID).tests",
    deploymentTargets: macOSDeploymentTargets,
