    20	    }
    21	
    22	    func launch() {
    23	      app.launch()
    24	    }
    25	
    26	    func terminate() {
    27	      app.terminate()
    28	    }
    29	
    30	    func capture(step: Int, name: String) {
    31	      let attachment = XCTAttachment(screenshot: app.screenshot())
    32	      let attachmentName = String(format: "Step_%02d__%@", step, Self.safeName(name))
    33	      attachment.name = attachmentName
    34	      attachment.lifetime = .keepAlways
    35	      XCTContext.runActivity(named: attachmentName) { activity in
    36	        activity.add(attachment)
    37	      }
    38	    }
    39	
    40	    private static func safeName(_ value: String) -> String {
    41	      value.map { character in
    42	        character.isLetter || character.isNumber ? character : "_"
    43	      }.reduce(into: "") { $0.append($1) }
    44	    }
    45	  }
    46	}

