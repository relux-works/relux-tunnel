// recordAndReport fsyncs the refusal together with the advance to
// transition_refused and THEN returns the typed error.
//
// The ordering is the whole point: a refusal that disappears on retry is not a
// refusal.
func (s *session) recordAndReport(txn *Txn, refusal Refusal) error {
	if refusal.Code == "" {
		refusal.Code = ErrorIntegrationIndeterminate
	}
	// A refusal reached while one is already recorded does NOT overwrite it —
	// the first is the one every automatic path re-reports. It is still reported
	// as itself, because this attempt refused for this reason, and telling the
	// caller the older code would misname what just happened. Design matrix row
	// 2ab's forged-phase case is exactly this shape: a hand-written
	// board_state_pending is re-classified, refuses txn_transition_not_in_place,
	// and is put back at transition_refused with the ORIGINAL refusal still on
	// the record.
	superseded := txn.Refusal != nil && txn.Refusal.Code != refusal.Code
	if err := s.txnStore.RecordRefusal(txn, refusal); err != nil {
		return err
	}
	if superseded {
		return newError(refusal.Code, fmt.Sprintf(
			"%s refused %s on re-evaluation; the transaction is back at %s and its recorded refusal %s remains authoritative",
			txn.StoryID, refusal.Code, txn.Phase, txn.Refusal.Code),
			map[string]string{
				"story_id":         txn.StoryID,
				"txn_id":           txn.TxnID(),
				"phase":            string(txn.Phase),
				"refusal_code":     string(txn.Refusal.Code),
				"reevaluated_code": string(refusal.Code),
				"refusal_sha256":   RefusalDigest(txn.Refusal),
			})
	}
	return s.reportRecordedRefusal(txn)
}

