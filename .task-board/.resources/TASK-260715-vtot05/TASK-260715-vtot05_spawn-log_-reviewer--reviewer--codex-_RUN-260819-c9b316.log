   812	                "version": component["version"],
   813	                "revision": component["revision"],
   814	                "contentSHA256": component["contentSHA256"],
   815	                "source": component["source"],
   816	                "license": component["license"],
   817	                "noticeObligation": component["noticeObligation"],
   818	                "byteAffecting": component["byteAffecting"],
   819	                "distribution": component["distribution"],
   820	                "vulnerabilityReview": {
   821	                    "identifier": component["id"],
   822	                    "version": component["version"],
   823	                },
   824	            }
   825	        )
   826	    return stable_json(
   827	        {
   828	            "schemaVersion": 1,
   829	            "kind": "relay-scoped-dependency-inventory",
   830	            "manifestLinkageSHA256": link,
   831	            "dependencyLock": config["dependencyLock"],
   832	            "components": components,
