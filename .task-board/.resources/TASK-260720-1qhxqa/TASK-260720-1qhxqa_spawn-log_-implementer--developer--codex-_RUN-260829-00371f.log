+        "static HEV and libssh2 linkage with system-only dynamic dependencies",
+        "verified relay resource bundled by the provider",
+        "legacy v0.1.0 isolation and preservation"
+      ],
+      "bindings": {
+        "platformScope": "macOS-only; iOS production targets remain deferred",
+        "providerTarget": "ReluxProxyMacTunnel",
+        "providerDirectDependencies": [
+          "ReluxTunnelMacOSAdapter"
+        ],
+        "providerResources": [
+          ".build/relay/relay-assets-v1"
