   780	
   781	  private func sendKeepalive(
   782	    deferBehindRekey: Bool
   783	  ) async throws -> SSHDeferredSemanticReport<Duration> {
   784	    guard let configuration else {
   785	      throw transportError(code: .invalidState, phase: .keepalive)
   786	    }
   787	    guard !keepaliveInFlight else {
   788	      throw transportError(code: .operationInProgress, phase: .keepalive, scope: .operation)
   789	    }
   790	    keepaliveInFlight = true
   791	    let timeout = min(
   792	      configuration.timeouts.keepaliveReply,
   793	      configuration.keepalive.replyTimeout
   794	    )
   795	    let now = dependencies.clock.now()
   796	    let admissionDeadline =
   797	      if deferBehindRekey, state == .rekeying {
   798	        rekeyFlightDeadline ?? now.advanced(by: configuration.rekey.timeout)
   799	      } else {
   800	        now.advanced(by: timeout)
   801	      }
   802	    let permit: LibSSH2SessionOperationPermit
   803	    do {
   804	      permit = try await beginSessionOperation(
   805	        phase: .keepalive,
   806	        until: admissionDeadline,
   807	        allowsRekeying: true,
   808	        scope: .operation
   809	      )
   810	    } catch {
   811	      keepaliveInFlight = false
   812	      throw error
   813	    }
   814	    do {
   815	      let replyDeadline = dependencies.clock.now().advanced(by: timeout)
   816	      let result = try await performSendKeepalive(until: replyDeadline)
   817	      finishSessionOperation(permit)
   818	      keepaliveInFlight = false
   819	      return result
   820	    } catch {
   821	      finishSessionOperation(permit)
   822	      keepaliveInFlight = false
   823	      let mapped = await handleOperationFailure(
   824	        error,
   825	        phase: .keepalive,
   826	        fallback: .keepaliveFailed,
   827	        scope: .operation
   828	      )
   829	      throw mapped
   830	    }
   831	  }
