   299	@MainActor
   300	final class ReluxSparkleUpdaterDelegate: NSObject, SPUUpdaterDelegate {
   301	  private let presentationModel: ReluxUpdatePresentationModel
   302	  private let preReleaseChannel: String?
   303	  var selectedChannel: ReluxUpdateChannel = .stable
   304	
   305	  init(
   306	    presentationModel: ReluxUpdatePresentationModel,
   307	    preReleaseChannel: String?
   308	  ) {
   309	    self.presentationModel = presentationModel
   310	    self.preReleaseChannel = preReleaseChannel
   311	  }
   312	
   313	  func allowedChannels(for updater: SPUUpdater) -> Set<String> {
   314	    guard selectedChannel == .preRelease, let preReleaseChannel else { return [] }
   315	    return [preReleaseChannel]
   316	  }
   317	
   318	  func updater(_ updater: SPUUpdater, didFindValidUpdate item: SUAppcastItem) {
   319	    presentationModel.receive(.updateAvailable)
   320	  }
   321	
   322	  func updater(_ updater: SPUUpdater, didFinishLoading appcast: SUAppcast) {
   323	    presentationModel.receive(.checkStarted)
   324	  }
   325	
   326	  func updaterDidNotFindUpdate(_ updater: SPUUpdater, error: any Error) {
   327	    presentationModel.receive(.upToDate)
   328	  }
   329	
   330	  func updater(
   331	    _ updater: SPUUpdater,
   332	    willDownloadUpdate item: SUAppcastItem,
   333	    with request: NSMutableURLRequest
   334	  ) {
   335	    presentationModel.receive(.downloadStarted)
   336	  }
   337	
   338	  func updaterWillRelaunchApplication(_ updater: SPUUpdater) {
   339	    presentationModel.receive(.readyToRelaunch)
   340	  }
   341	
   342	  func updater(
   343	    _ updater: SPUUpdater,
   344	    didFinishUpdateCycleFor updateCheck: SPUUpdateCheck,
   345	    error: (any Error)?
   346	  ) {
   347	    guard let error else { return }
   348	    let cocoaError = error as NSError
   349	    if cocoaError.domain == SUSparkleErrorDomain && cocoaError.code == 1001 {
   350	      presentationModel.receive(.upToDate)
   351	    } else if cocoaError.domain == SUSparkleErrorDomain && cocoaError.code == 4007 {
   352	      presentationModel.receive(.reset)
   353	    } else {
   354	      presentationModel.receiveFailure(error)
   355	    }
   356	  }
   357	
   358	}
