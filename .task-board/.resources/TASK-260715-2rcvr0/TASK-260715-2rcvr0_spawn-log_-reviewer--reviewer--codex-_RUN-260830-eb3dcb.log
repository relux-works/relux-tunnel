   646	  private func transitionDuringStartup(to phase: TunnelRuntimeStartupPhase) async throws {
   647	    try checkCancellationAndOwnership()
   648	    state = .starting(phase)
   649	    await publishCurrentState()
   650	    try checkCancellationAndOwnership()
   651	  }
   652	
   653	  private func requireMandatoryHealth() async throws {
   654	    let checks: [(TunnelRuntimeMandatoryComponent, any TunnelRuntimeHealthProviding)] = [
   655	      (.ssh, requireResource(sshSession)),
   656	      (.tcp, requireResource(tcpConsumer)),
   657	      (.dns, requireResource(dnsConsumer)),
   658	      (.packetPlane, requireResource(packetPlane)),
   659	    ]
   660	    for (component, provider) in checks {
   661	      let health = await provider.health()
   662	      try checkCancellationAndOwnership()
   663	      guard health == .healthy else {
   664	        throw TunnelRuntimeCoordinatorError.startupFailed(Self.healthFailure(for: component))
   665	      }
   666	    }
   667	  }
   668	
   669	  private func requireResource<T>(_ resource: T?) -> T {
   670	    guard let resource else {
   671	      preconditionFailure("Coordinator health check requested before acquisition")
   672	    }
   673	    return resource
   674	  }
   675	
   676	  private func registerCleanupControl<T>(_ resource: T?) {
   677	    guard let controllable = resource as? any ProviderCleanupControllable else { return }
   678	    cleanupRegistry.register(controllable)
   679	  }
   680	
   681	  private func mapped<T>(
   682	    fallback: RedactedRuntimeError,
   683	    operation: () async throws -> T
   684	  ) async throws -> T {
   685	    try checkCancellationAndOwnership()
   686	    do {
   687	      return try await operation()
   688	    } catch {
   689	      throw map(error, fallback: fallback)
   690	    }
   691	  }
   692	
   693	  private func map(_ error: any Error, fallback: RedactedRuntimeError) -> any Error {
   694	    if error is CancellationError {
   695	      return CancellationError()
   696	    }
   697	    if let error = error as? TunnelRuntimeCoordinatorError {
   698	      return error
   699	    }
   700	    return TunnelRuntimeCoordinatorError.startupFailed(fallback)
   701	  }
   702	
   703	  private func checkCancellationAndOwnership(allowUsable: Bool = false) throws {
   704	    try Task<Never, Never>.checkCancellation()
   705	    try environment.cancellation.checkCancellation()
   706	    let isOwnedState: Bool
   707	    switch state {
   708	    case .starting:
   709	      isOwnedState = true
   710	    case .usableTCPDNS:
   711	      isOwnedState = allowUsable
   712	    case .disconnected, .stopping, .failed:
   713	      isOwnedState = false
   714	    }
   715	    guard isOwnedState, termination == nil else {
   716	      throw CancellationError()
   717	    }
   718	  }
   719	
   720	  private func classifyStartupError(_ error: any Error) -> any Error {
   721	    if error is CancellationError {
   722	      if case .failed(let failure) = termination {
   723	        return TunnelRuntimeCoordinatorError.startupFailed(failure)
   724	      }
   725	      if termination == nil {
   726	        termination = .cancelled
   727	      }
   728	      return CancellationError()
   729	    }
   730	    if case .startupFailed(let failure) = error as? TunnelRuntimeCoordinatorError {
   731	      setFailure(failure)
   732	      return error
   733	    }
   734	    let fallback = Self.error(domain: .runtimeInvariant, code: "startup_failed")
   735	    setFailure(fallback)
   736	    return TunnelRuntimeCoordinatorError.startupFailed(fallback)
   737	  }
   738	
   739	  private func setFailure(_ failure: RedactedRuntimeError) {
   740	    if primaryFailure == nil {
   741	      primaryFailure = failure
   742	    }
   743	    if termination == nil {
   744	      termination = .failed(failure)
   745	    }
   746	  }
   747	
   748	  private func transitionToStopping() async {
   749	    guard state != .stopping, state != .disconnected, state != .failed else { return }
   750	    state = .stopping
   751	    await publishCurrentState()
   752	  }
   753	
   754	  @discardableResult
   755	  private func beginCleanup() -> Task<Void, Never> {
   756	    if let cleanupTask {
   757	      return cleanupTask
   758	    }
   759	    let task = Task { [weak self] in
   760	      guard let self else { return }
   761	      await self.performCleanup()
   762	    }
   763	    cleanupTask = task
   764	    return task
   765	  }
   766	
   767	  private func joinCleanup() async {
   768	    if let cleanupTask {
   769	      await cleanupTask.value
   770	      return
   771	    }
   772	    guard state != .disconnected, state != .failed else { return }
   773	    if state != .stopping {
   774	      await transitionToStopping()
   775	    }
   776	    let task = beginCleanup()
   777	    await task.value
   778	  }
   779	
   780	  private func performCleanup() async {
   781	    await tcpConsumer?.closeAdmission()
   782	    await dnsConsumer?.closeAdmission()
   783	
   784	    if let packetPlane {
   785	      await packetPlane.stop()
   786	      self.packetPlane = nil
   787	    }
   788	
   789	    if settingsState.requiresClear {
   790	      do {
   791	        try await dependencies.settingsApplier.clear(runtimeGeneration: runtimeGeneration)
   792	        settingsState = .notRequested
   793	      } catch {
   794	        settingsState = .clearFailed
   795	        let clearFailure = Self.error(
   796	          domain: .networkSettings,
   797	          code: "network_settings_clear_failed"
   798	        )
   799	        if primaryFailure == nil {
   800	          primaryFailure = clearFailure
   801	        }
   802	      }
   803	    }
   804	
   805	    if let dnsConsumer {
   806	      await dnsConsumer.stop()
   807	      self.dnsConsumer = nil
   808	    }
   809	    if let tcpConsumer {
   810	      await tcpConsumer.stop()
   811	      self.tcpConsumer = nil
   812	    }
   813	    if let sshSession {
   814	      await sshSession.close()
   815	      self.sshSession = nil
   816	    }
   817	
   818	    configurationSnapshot = nil
   819	    configurationReference = nil
   820	    startupTask = nil
   821	
   822	    if settingsState == .clearFailed || isFailureTermination {
   823	      state = .failed
   824	    } else {
   825	      state = .disconnected
   826	      primaryFailure = nil
   827	    }
   828	    await publishCurrentState()
   829	    cleanupTask = nil
   830	  }
   831	
   832	  private var isFailureTermination: Bool {
   833	    switch termination {
   834	    case .failed:
   835	      true
   836	    case .cancelled, .stopped, nil:
   837	      false
   838	    }
   839	  }
