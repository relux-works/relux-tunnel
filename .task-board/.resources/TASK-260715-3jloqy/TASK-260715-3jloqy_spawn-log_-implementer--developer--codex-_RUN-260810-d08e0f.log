exec
/bin/zsh -lc "python3 - <<'PY'
import hashlib
import json
import plistlib
import re
import subprocess
from pathlib import Path

with Path('.inspection/host.plist').open('rb') as stream:
    profile = plistlib.load(stream)
current_output = subprocess.check_output(['/usr/sbin/ioreg', '-rd1', '-c', 'IOPlatformExpertDevice'], text=True)
match = re.search(r'\"IOPlatformUUID\" = \"(["'^"]+)"'"', current_output)
if not match:
    raise SystemExit('current Mac provisioning identifier unavailable')
current = match.group(1)
entitlements = profile.get('Entitlements', {})
result = {
    'name': profile.get('Name'),
    'uuid': profile.get('UUID'),
    'platform': profile.get('Platform'),
    'teamIdentifier': profile.get('TeamIdentifier'),
    'applicationIdentifierPrefix': profile.get('ApplicationIdentifierPrefix'),
    'applicationIdentifier': entitlements.get('com.apple.application-identifier'),
    'networkExtension': entitlements.get('com.apple.developer.networking.networkextension'),
    'appGroupsPresent': 'com.apple.security.application-groups' in entitlements,
    'keychainAccessGroups': entitlements.get('keychain-access-groups'),
    'provisionedDeviceCount': len(profile.get('ProvisionedDevices', [])),
    'containsCurrentMac': current in profile.get('ProvisionedDevices', []),
    'currentMacRef': 'sha256:' + hashlib.sha256(current.encode()).hexdigest()[:12],
    'creationDate': profile.get('CreationDate').isoformat(),
    'expirationDate': profile.get('ExpirationDate').isoformat(),
    'getTaskAllow': entitlements.get('get-task-allow'),
    'developerCertificateCount': len(profile.get('DeveloperCertificates', [])),
}
print(json.dumps(result, indent=2))
