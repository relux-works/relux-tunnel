rue,\\\"id\\\":\\\"BUG-260916-2764p8\\\",\\\"item\\\":4,\\\"text\\\":\\\"Code written per task description and AC\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"BUG-260916-2764p8\\\",\\\"item\\\":5,\\\"text\\\":\\\"Relevant tests written for new or changed behavior and passing\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"BUG-260916-2764p8\\\",\\\"item\\\":6,\\\"text\\\":\\\"In a managed Story worktree the candidate is left UNCOMMITTED in the worktree for the handoff to snapshot — never commit on the Story branch. A producer commit moves the branch tip off the recorded checkpoint and the handoff refuses with change_request_candidate_committed_past_checkpoint; repair with `git reset --soft \\\\u003ccheckpoint_oid\\\\u003e` before completing again.\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"BUG-260916-2764p8\\\",\\\"item\\\":7,\\\"text\\\":\\\"Every command, message, state, or refusal named in the AC is driven through the production entry point by a named committed test, or is declared a stated bound. Report coverage as a ratio — `n of m AC rows driven` — and name the production call site for each. Prose in place of the ratio is not evidence.\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"BUG-260916-2764p8\\\",\\\"item\\\":8,\\\"text\\\":\\\"Gating, refusing, validating, authorizing, or attesting behavior covered by negative tests that fail when the gate admits what it must reject, with the production call site named\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"BUG-260916-2764p8\\\",\\\"item\\\":9,\\\"text\\\":\\\"Every gate ships at least one NARROWING mutant — the gate stays present and is weakened to admit exactly one member of the class it must reject, and a named test must fail. A delete-only mutant proves only that the gate exists and is not accepted as evidence.\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"BUG-260916-2764p8\\\",\\\"item\\\":10,\\\"text\\\":\\\"A gate that inspects source text is additionally attacked by a mutant that PRESERVES the searched-for token and changes behavior, and the mutant harness executes the behavioral suite, not only the static checker.\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"BUG-260916-2764p8\\\",\\\"item\\\":11,\\\"text\\\":\\\"Lint clean\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"BUG-260916-2764p8\\\",\\\"item\\\":12,\\\"text\\\":\\\"Relevant build/validation commands run after changes and build not broken\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"BUG-260916-2764p8\\\",\\\"item\\\":13,\\\"text\\\":\\\"New outcome artifact attached on the board with a task-scoped name when the work produces notes, logs, screenshots, or other deliverables\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"BUG-260916-2764p8\\\",\\\"item\\\":14,\\\"text\\\":\\\"Important findings, decisions, anomalies, or regressions recorded in logbook when relevant\\\"}}\\n\",\n  \"original_output_bytes\": 3418,\n  \"original_output_tokens\": 855,\n  \"truncated\": false\n}","final_result":true}}}
