  1191	  public static func hostDecisionFailure(
  1192	    _ decision: SSHHostKeyDecision,
  1193	    lane: SSHLaneIdentity
  1194	  ) -> SSHTransportError? {
  1195	    let code: SSHTransportErrorCode
  1196	    switch decision {
  1197	    case .acceptFirstUse, .acceptMatch:
  1198	      return nil
  1199	    case .rejectUnknown:
  1200	      code = .hostKeyUnknown
  1201	    case .rejectChanged:
  1202	      code = .hostKeyChanged
  1203	    case .rejectAlgorithm:
  1204	      code = .hostKeyAlgorithmRejected
  1205	    case .rejectPolicy:
  1206	      code = .hostKeyRejected
  1207	    }
  1208	    return SSHTransportError(
  1209	      code: code,
  1210	      phase: .hostDecision,
  1211	      scope: .lane(lane),
  1212	      retryDisposition: .afterConfigurationChange,
  1213	      requiresTeardown: true
  1214	    )
  1215	  }
