+    context->hold_reads = 0;
+    rc = run_global_request(
+        session, socket_fd, keepalive_name, NULL, 0, &reply, &eagain_count);
+    libssh2_session_set_read_timeout(session, 60);
+    if(rc || reply == LIBSSH2_GLOBAL_REQUEST_REPLY_NONE || misses != 1)
+        return 1;
