   594	def count_new_matches(window: bytes, previous_tail_size: int, pattern: bytes) -> int:
   595	    count = 0
   596	    start = 0
   597	    while True:
   598	        match = window.find(pattern, start)
   599	        if match < 0:
   600	            return count
   601	        if match + len(pattern) > previous_tail_size:
   602	            count += 1
   603	        start = match + 1
