  1207	  mutating func parseDocument() throws -> StrictJSONValidator.ValidationResult {
  1208	    skipWhitespace()
  1209	    guard peek == UInt8(ascii: "{") else { throw RuntimeMessageCodecError.corruptPayload }
  1210	    let keys = try parseObject(depth: 1)
  1211	    skipWhitespace()
  1212	    guard index == bytes.count else { throw RuntimeMessageCodecError.corruptPayload }
  1213	    guard allowsInsignificantWhitespace || !sawInsignificantWhitespace else {
  1214	      throw RuntimeMessageCodecError.corruptPayload
  1215	    }
  1216	    return StrictJSONValidator.ValidationResult(
  1217	      topLevelKeys: keys,
  1218	      allObjectKeys: allObjectKeys
  1219	    )
  1220	  }
