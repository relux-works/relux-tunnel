   290	def split_swift_array(value: str, row: str) -> list[str]:
   291	    entries: list[str] = []
   292	    start = 0
   293	    depths = {"(": 0, "[": 0, "{": 0}
   294	    closing = {")": "(", "]": "[", "}": "{"}
   295	    in_string = False
   296	    escaped = False
   297	    for index, character in enumerate(value):
   298	        if in_string:
   299	            if escaped:
   300	                escaped = False
   301	            elif character == "\\":
   302	                escaped = True
   303	            elif character == '"':
   304	                in_string = False
   305	            continue
   306	        if character == '"':
   307	            in_string = True
   308	        elif character in depths:
   309	            depths[character] += 1
   310	        elif character in closing:
   311	            opening = closing[character]
   312	            depths[opening] -= 1
   313	            if depths[opening] < 0:
   314	                raise BindingError(row, "malformed Swift array entry")
   315	        elif character == "," and not any(depths.values()):
   316	            entry = value[start:index].strip()
   317	            if entry:
   318	                entries.append(entry)
   319	            start = index + 1
   320	    if in_string or any(depths.values()):
   321	        raise BindingError(row, "malformed Swift array entry")
   322	    final = value[start:].strip()
   323	    if final:
   324	        entries.append(final)
   325	    return entries
