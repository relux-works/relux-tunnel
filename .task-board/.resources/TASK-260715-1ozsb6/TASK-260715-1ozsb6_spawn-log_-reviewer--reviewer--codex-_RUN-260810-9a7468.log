   947	    }
   948	    let deadline = dependencies.clock.now().advanced(by: timeout)
   949	    while true {
   950	      try checkCancellation(phase: .authentication)
   951	      var abstract = sessionContextPointer
   952	      let result = username.withCString { user in
   953	        publicKey.withUnsafeBytes { bytes in
   954	          libssh2_userauth_publickey(
   955	            engineSession,
   956	            user,
   957	            bytes.bindMemory(to: UInt8.self).baseAddress,
   958	            bytes.count,
   959	            reluxLibSSH2SignCallback,
   960	            &abstract
