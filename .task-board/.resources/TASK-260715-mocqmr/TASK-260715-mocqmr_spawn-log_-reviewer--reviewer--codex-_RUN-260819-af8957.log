   605	def run_gate(arguments: argparse.Namespace) -> int:
   606	    gate = SmokeGate(
   607	        target=arguments.target,
   608	        runner_kind=arguments.runner_kind,
   609	        runner_name=arguments.runner_name,
   610	        runner_owner=arguments.runner_owner,
   135	            --output ".temp/relay-tools/$go_archive" "$go_url"
   136	          printf '%s  %s\n' "$go_sha" ".temp/relay-tools/$go_archive" | sha256sum --check --strict
   137	          make relay-provision-go RELAY_GO_ARCHIVE=".temp/relay-tools/$go_archive"
   138	
   139	      - name: Test, vet, license-extract, and clean-build all four targets offline
   140	        run: |
   141	          source_date_epoch=$(git show -s --format=%ct HEAD)
   142	          make relay-toolchain-ci \
   143	            RELAY_VERSION=0.0.0 \
   144	            SOURCE_COMMIT="$GITHUB_SHA" \
   145	            SOURCE_DATE_EPOCH="$source_date_epoch" \
   146	            RELAY_BUILD_CLEAN_FLAG=--require-clean
   147	
   148	  relay-portable-runtime:
   149	    name: portable runtime ${{ matrix.target }} on ${{ matrix.runner }}
   150	    strategy:
   151	      fail-fast: false
   152	      matrix:
   153	        include:
   154	          - target: darwin/amd64
   155	            slug: darwin-amd64
   156	            runner: macos-15-intel
   157	          - target: darwin/arm64
   158	            slug: darwin-arm64
   159	            runner: macos-15
   160	          - target: linux/amd64
   161	            slug: linux-amd64
   162	            runner: ubuntu-24.04
   163	          - target: linux/arm64
   164	            slug: linux-arm64
   165	            runner: ubuntu-24.04-arm
   166	    runs-on: ${{ matrix.runner }}
   167	    steps:
   168	      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
   169	        with:
   170	          fetch-depth: 0
   171	          persist-credentials: false
   172	
   173	      - name: Verify checked-in pins and runtime-gate tests
   174	        run: make relay-toolchain-check relay-toolchain-negative-test
   175	
   176	      - name: Fetch the approved checksum-pinned host tools
   177	        env:
   178	          RELAY_HOST_TARGET: ${{ matrix.target }}
   179	        run: |
   180	          mkdir -p .temp/relay-tools
   181	          read -r go_archive go_sha go_url syft_archive syft_sha syft_url <<EOF
   182	          $(python3 -c 'import json,os; d=json.load(open("relay/toolchain-manifest-v1.json")); h=os.environ["RELAY_HOST_TARGET"]; g=next(v for v in d["hostToolArchives"] if v["host"] == h); s=next(v for v in d["buildOnlyTools"][0]["hostArchives"] if v["host"] == h); print(g["artifact"], g["sha256"], g["source"], s["artifact"], s["sha256"], s["source"])')
   183	          EOF
   184	          curl --fail --location --proto '=https' --tlsv1.2 \
   185	            --output ".temp/relay-tools/$go_archive" "$go_url"
   186	          curl --fail --location --proto '=https' --tlsv1.2 \
   187	            --output ".temp/relay-tools/$syft_archive" "$syft_url"
   188	          python3 - "$go_sha" ".temp/relay-tools/$go_archive" "$syft_sha" ".temp/relay-tools/$syft_archive" <<'PY'
   189	          import hashlib, pathlib, sys
   190	          for expected, name in zip(sys.argv[1::2], sys.argv[2::2], strict=True):
   191	              actual = hashlib.sha256(pathlib.Path(name).read_bytes()).hexdigest()
   192	              if actual != expected:
   193	                  raise SystemExit("checksum-pinned host tool mismatch")
   194	          PY
   195	          make relay-provision-tools \
   196	            RELAY_GO_ARCHIVE=".temp/relay-tools/$go_archive" \
   197	            RELAY_SYFT_ARCHIVE=".temp/relay-tools/$syft_archive"
   198	
   199	      - name: Clean-build the exact four-asset manifest offline
   200	        run: |
   201	          source_date_epoch=$(git show -s --format=%ct HEAD)
   202	          make relay-shell-release \
   203	            RELAY_VERSION=0.0.0 \
   204	            SOURCE_COMMIT="$GITHUB_SHA" \
   205	            SOURCE_DATE_EPOCH="$source_date_epoch"
   206	
   207	      - name: Gate native rootless stdio and runtime boundaries
   208	        run: |
   209	          mkdir -p ".build/relay/runtime-evidence/${{ matrix.slug }}"
   210	          python3 scripts/relay_asset_smoke.py \
   211	            --target "${{ matrix.target }}" \
   212	            --runner-kind native \
   213	            --runner-name "${{ matrix.runner }}" \
   214	            --runner-owner TASK-260715-36gq4m \
   215	            --require-native \
   216	            --manifest .build/relay/apple-bundle-input/relux-relay-manifest-v1.json \
   217	            --executable ".build/relay/apple-bundle-input/relux-relay-${{ matrix.slug }}" \
   218	            --evidence ".build/relay/runtime-evidence/${{ matrix.slug }}/report.json"
   219	
   220	      - name: Retain exact gated asset and privacy-safe runner evidence
   221	        if: always()
   222	        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
   223	        with:
   224	          name: runtime-evidence-${{ matrix.slug }}-${{ github.run_id }}
   225	          path: |
   226	            .build/relay/apple-bundle-input/relux-relay-${{ matrix.slug }}
   227	            .build/relay/apple-bundle-input/relux-relay-${{ matrix.slug }}.spdx.json
   228	            .build/relay/apple-bundle-input/relux-relay-manifest-v1.json
   229	            .build/relay/apple-bundle-input/relux-relay-SHA256SUMS
   230	            .build/relay/runtime-evidence/${{ matrix.slug }}/report.json
   231	          if-no-files-found: warn
   232	          retention-days: 14
   130	                sys.stderr.write("relux-relay: unsupported invocation\\n")
   131	                raise SystemExit(64)
   132	                """
   133	            ),
   134	            encoding="utf-8",
   135	        )
   136	        fixture.chmod(0o755)
   137	        return fixture
