+}
+
+private struct ExecRequest: Equatable, Sendable {
+  let request: SSHExecRequest
+  let policy: SSHChannelPolicy
+
+  init(_ request: SSHExecRequest, _ policy: SSHChannelPolicy) {
+    self.request = request
+    self.policy = policy
+  }
+}
