private enum LibSSH2SignatureState {
  case idle
  case pending(Data)
  case ready(payload: Data, signature: Data)
  case failed(Data)
}

final class LibSSH2SessionContext: @unchecked Sendable {
  let network: LibSSH2NetworkBridge
  private let lock = NSLock()
