   326	    lock.withLock { ingress }
   327	  }
   328	
   329	  func setSSHSession(_ session: M1HarnessSSHSession) {
   330	    lock.withLock { sshSession = session }
   331	  }
   332	
   333	  func capturedSSHSession() -> M1HarnessSSHSession? {
   334	    lock.withLock { sshSession }
   335	  }
   336	
   337	  func setDNSConsumer(_ consumer: M1HarnessDNSConsumer) {
   338	    lock.withLock { dnsConsumer = consumer }
   339	  }
   340	
   341	  func capturedDNSConsumer() -> M1HarnessDNSConsumer? {
   342	    lock.withLock { dnsConsumer }
   343	  }
   344	
   345	  func opened(_ pair: PacketBridgeSocketPair) {
   346	    lock.withLock {
   347	      openDescriptors.insert(pair.bridgeDescriptor)
   348	      openDescriptors.insert(pair.hevDescriptor)
   349	    }
   350	  }
   351	
   352	  func closed(_ descriptor: Int32) {
   353	    _ = lock.withLock { openDescriptors.remove(descriptor) }
   354	  }
   355	
   356	  func channelOpened() {
   357	    lock.withLock { liveChannels += 1 }
   358	  }
   359	
   360	  func channelClosed() {
   361	    lock.withLock { liveChannels -= 1 }
   362	  }
   363	
   364	  func nativeRuntimeStarted() {
   365	    lock.withLock { liveNativeRuntimes += 1 }
   366	  }
   367	
   368	  func nativeRuntimeStopped() {
   369	    lock.withLock { liveNativeRuntimes -= 1 }
   370	  }
   371	
   372	  func hasBalancedResources(activePacketReads: Int) -> Bool {
   373	    lock.withLock {
   374	      openDescriptors.isEmpty && liveChannels == 0 && liveNativeRuntimes == 0
   375	        && activePacketReads == 0
   376	    }
   377	  }
   378	}
