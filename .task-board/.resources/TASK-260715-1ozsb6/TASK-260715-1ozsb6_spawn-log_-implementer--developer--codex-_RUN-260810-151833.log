  1370	      return result
  1371	    } catch {
  1372	      await endChannelWrite(identity: identity, byteCount: acceptedPrefix, permit: permit)
  1373	      let mapped = map(error, phase: .channelWrite)
  1374	      await recordTerminalOperation(mapped)
  1375	      throw mapped
  1376	    }
  1377	  }
