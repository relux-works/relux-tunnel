hev_socks5_name_resolve_ipv6 (const char *name, struct sockaddr_in6 *saddr)
{
    int res;

    res = inet_pton (AF_INET6, name, &saddr->sin6_addr);
    if (res == 0)
        return -1;

    return 0;
}

