   320	def validate_supply_chain(value: Any) -> dict[str, str]:
   321	    if not isinstance(value, dict) or set(value) != SUPPLY_CHAIN_KEYS:
   322	        raise AssetManifestError("supply-chain provenance field set changed")
   323	    if (
   324	        value.get("kind") != "repositoryGenerated"
   325	        or value.get("taskID") != "TASK-260715-vtot05"
   326	    ):
   327	        raise AssetManifestError("supply-chain provenance identity is invalid")
   328	    for key in (
   329	        "manifestLinkageSHA256",
   330	        "provenanceSHA256",
   331	        "inventorySHA256",
   332	        "noticesSHA256",
   333	    ):
   334	        if (
   335	            not isinstance(value.get(key), str)
   336	            or SHA256_PATTERN.fullmatch(value[key]) is None
   337	        ):
   338	            raise AssetManifestError("supply-chain provenance digest is invalid")
   339	    expected_files = {
   340	        "provenanceFile": "relay/source-build-provenance-v1.json",
   341	        "inventoryFile": "relay/dependency-inventory-v1.json",
   342	        "noticesFile": "relay/PRODUCT_NOTICES.txt",
   343	    }
   344	    if any(value.get(key) != expected for key, expected in expected_files.items()):
   345	        raise AssetManifestError("supply-chain provenance file reference is invalid")
   346	    return value
