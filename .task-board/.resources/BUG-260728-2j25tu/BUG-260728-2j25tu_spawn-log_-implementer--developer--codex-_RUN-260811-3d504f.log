The failure is a different pre-snapshot anomaly in the same suite: the oversized datagram callback lost its active association at the 10-second idle boundary, before the new seam was reached. Both named race tests passed. I’m preserving this as an anomaly, resetting the streak, and restarting the full 20-run gate; if it recurs, I’ll investigate rather than mask it.
exec
/bin/zsh -lc 'task_evidence_dir=$(mktemp -d /tmp/BUG-260728-2j25tu.after.XXXXXX)
for task_run in $(seq 1 20); do
  task_started=$(date +%s)
  swift test > "$task_evidence_dir/full-swift-test-$task_run.log" 2>&1
  task_code=$?
  task_elapsed=$(($(date +%s) - task_started))
  task_summary=$(rg '"'Test run with .* passed|Test run with .* failed' \""'$task_evidence_dir/full-swift-test-$task_run.log" | tail -n 1)
  printf '"'run=%02d exit=%d elapsed_seconds=%d summary=%s\\n' \""'$task_run" "$task_code" "$task_elapsed" "$task_summary"
  if [ "$task_code" -ne 0 ]; then
    printf '"'failure_log=%s\\n' \""'$task_evidence_dir/full-swift-test-$task_run.log"
    exit "$task_code"
  fi
done
