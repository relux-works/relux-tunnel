+        let parsed = try timestamp(value, field: .trustRecords)
+        return SSHProfileTimestamp(parsed.rawValue)
+      }
+      let revokedAt = try record.revokedAt.map { value in
+        let parsed = try timestamp(value, field: .trustRecords)
+        return SSHProfileTimestamp(parsed.rawValue)
+      }
