+      name: "truncated port",
+      record: Data([high, low, 0x0A, 0x01, 192, 0, 2, 1, 0]),
+      code: .truncatedPort
+    ),
+    MalformedStructuralRecord(
+      name: "zero port",
+      record: Data([high, low, 0x0A, 0x01, 192, 0, 2, 1, 0, 0]),
