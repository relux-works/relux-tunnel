+			failure,
+			DatagramMessageLengthExceedsProtocolLimit,
+			"association",
+			"closeAssociation",
+		)
+		if codec.Metrics().DecodedMaterializedBytes != 0 {
+			t.Fatal("protocol violation materialized bytes")
