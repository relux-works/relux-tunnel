  1112	private struct StrictJSONParser {
  1113	  private let bytes: [UInt8]
  1114	  private var index = 0
  1115	
  1116	  init(bytes: [UInt8]) {
  1117	    self.bytes = bytes
  1118	  }
  1119	
  1120	  mutating func parseDocument() throws -> Set<String> {
  1121	    skipWhitespace()
  1122	    guard peek == UInt8(ascii: "{") else { throw RuntimeMessageCodecError.corruptPayload }
