 public final class MacOSPacketFlowAdapter: PacketFlow, @unchecked Sendable {
diff --git a/Tests/ReluxTunnelCoreTests/ProviderAdapterContractTests.swift b/Tests/ReluxTunnelCoreTests/ProviderAdapterContractTests.swift
index f02f8fbe35820e416910b771abe3a6cd732146a6..4f52761b9664f182721b115687e5c127ff3c883e
--- a/Tests/ReluxTunnelCoreTests/ProviderAdapterContractTests.swift
+++ b/Tests/ReluxTunnelCoreTests/ProviderAdapterContractTests.swift
@@ -6,6 +6,15 @@
 
 @Suite("Provider adapter contracts")
 struct ProviderAdapterContractTests {
+  @Test("macOS provider configuration selects the pinned libssh2 candidate")
+  func macOSLibSSH2Configuration() {
+    let capabilities = MacOSProviderSSHConfiguration.makeTransportFactory().capabilities
