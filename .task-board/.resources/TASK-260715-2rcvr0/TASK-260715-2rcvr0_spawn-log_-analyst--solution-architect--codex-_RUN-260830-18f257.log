   903	  fileprivate func rejectUpdate(
   904	    generation: UInt64,
   905	    droppedUpdates: RuntimeDiagnosticsDroppedUpdateCounter
   906	  ) {
   907	    enqueue(.rejected(generation), droppedUpdates: droppedUpdates)
   908	  }
