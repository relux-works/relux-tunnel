+        if expected_size is not None and status.st_size != expected_size:
+            raise AssetManifestError(f"{label} size does not match the manifest")
+
+        chunks: list[bytes] = []
+        total = 0
+        while True:
+            chunk = os.read(descriptor, min(READ_CHUNK_BYTES, maximum_size + 1 - total))
