private final class SocketFailureController: @unchecked Sendable {
  private let armed = Mutex(false)

  func arm() {
    armed.withLock { $0 = true }
  }

  func consume() -> Bool {
    armed.withLock { value in
      defer { value = false }
      return value
    }
  }
}

