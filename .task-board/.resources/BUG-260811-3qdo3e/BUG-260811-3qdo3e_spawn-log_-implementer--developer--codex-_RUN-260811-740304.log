   292	/// FIFO gate for libssh2 state machines stored on the shared session object.
   293	/// Channel payload I/O remains independently interleavable; channel opens,
   294	/// rekeys, and reply-requiring global requests hold one permit across EAGAIN.
   295	final class LibSSH2SessionOperationGate: @unchecked Sendable {
   296	  private struct Waiter {
   297	    let identifier: UUID
   298	    let continuation: CheckedContinuation<LibSSH2SessionOperationPermit, Error>
   299	  }
   300	
   301	  private let lock = NSLock()
   302	  private let maximumWaiters: Int
   303	  private var activeIdentifier: UUID?
   304	  private var waiters: [Waiter] = []
   305	  private var shutDown = false
   306	
   307	  init(maximumWaiters: Int) {
   308	    precondition(maximumWaiters > 0)
   309	    self.maximumWaiters = maximumWaiters
   310	  }
   311	
   312	  var pendingCount: Int {
   313	    lock.withLock { waiters.count + (activeIdentifier == nil ? 0 : 1) }
   314	  }
   315	
   316	  func acquire() async throws -> LibSSH2SessionOperationPermit {
   317	    let identifier = UUID()
   318	    return try await withTaskCancellationHandler {
   319	      try Task.checkCancellation()
   320	      let permit = try await withCheckedThrowingContinuation { continuation in
   321	        let immediate: Result<LibSSH2SessionOperationPermit, Error>? = lock.withLock {
   322	          if Task.isCancelled { return .failure(CancellationError()) }
   323	          if shutDown { return .failure(LibSSH2SessionOperationGateError.shutDown) }
   324	          if activeIdentifier == nil {
   325	            activeIdentifier = identifier
   326	            return .success(LibSSH2SessionOperationPermit(identifier: identifier))
   327	          }
   328	          guard waiters.count < maximumWaiters else {
   329	            return .failure(LibSSH2SessionOperationGateError.resourceLimitExceeded)
   330	          }
   331	          waiters.append(Waiter(identifier: identifier, continuation: continuation))
   332	          return nil
   333	        }
   334	        if let immediate { continuation.resume(with: immediate) }
   335	      }
   336	      try Task.checkCancellation()
   337	      return permit
   338	    } onCancel: {
   339	      self.cancelAcquisition(identifier: identifier)
   340	    }
   341	  }
   342	
   343	  func release(_ permit: LibSSH2SessionOperationPermit) {
   344	    let next: Waiter? = lock.withLock {
   345	      guard activeIdentifier == permit.identifier else { return nil }
   346	      guard !waiters.isEmpty, !shutDown else {
   347	        activeIdentifier = nil
   348	        return nil
   349	      }
   350	      let next = waiters.removeFirst()
   351	      activeIdentifier = next.identifier
   352	      return next
   353	    }
   354	    if let next {
   355	      next.continuation.resume(
   356	        returning: LibSSH2SessionOperationPermit(identifier: next.identifier))
   357	    }
   358	  }
   359	
   360	  func cancelPending() {
   361	    let cancelled: [Waiter] = lock.withLock {
   362	      shutDown = true
   363	      let cancelled = waiters
   364	      waiters.removeAll(keepingCapacity: false)
   365	      return cancelled
   366	    }
   367	    for waiter in cancelled {
   368	      waiter.continuation.resume(throwing: LibSSH2SessionOperationGateError.shutDown)
   369	    }
   370	  }
   371	
   372	  private func cancelAcquisition(identifier: UUID) {
   373	    let action: (cancelled: Waiter?, promoted: Waiter?) = lock.withLock {
   374	      if let index = waiters.firstIndex(where: { $0.identifier == identifier }) {
   375	        return (waiters.remove(at: index), nil)
   376	      }
   377	      guard activeIdentifier == identifier else { return (nil, nil) }
   378	      guard !waiters.isEmpty, !shutDown else {
   379	        activeIdentifier = nil
   380	        return (nil, nil)
   381	      }
   382	      let promoted = waiters.removeFirst()
   383	      activeIdentifier = promoted.identifier
   384	      return (nil, promoted)
   385	    }
   386	    action.cancelled?.continuation.resume(throwing: CancellationError())
   387	    if let promoted = action.promoted {
   388	      promoted.continuation.resume(
   389	        returning: LibSSH2SessionOperationPermit(identifier: promoted.identifier))
   390	    }
   391	  }
   392	}
