   736	  @discardableResult
   737	  private func beginCleanup() -> Task<Void, Never> {
   738	    if let cleanupTask {
   739	      return cleanupTask
   740	    }
   741	    let task = Task { [weak self] in
   742	      guard let self else { return }
   743	      await self.performCleanup()
   744	    }
   745	    cleanupTask = task
   746	    return task
   747	  }
   748	
   749	  private func joinCleanup() async {
   750	    if let cleanupTask {
   751	      await cleanupTask.value
   752	      return
   753	    }
   754	    guard state != .disconnected, state != .failed else { return }
   755	    if state != .stopping {
   756	      await transitionToStopping()
   757	    }
   758	    let task = beginCleanup()
   759	    await task.value
   760	  }
