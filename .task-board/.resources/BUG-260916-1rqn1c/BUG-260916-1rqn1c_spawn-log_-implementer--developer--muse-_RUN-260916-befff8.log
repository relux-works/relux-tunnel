      sha256: c7a0eb1035de974b42d36b69c4b55b836c06b455b990dd6ac530aaf05d4a8a17 # mise-v2026.3.10-macos-arm64\\n          install: false\\n          cache: false\\n\\n      - name: Exercise validation boundary narrowing mutants\\n        working-directory: relux-tunnel\\n        run: python3 scripts/tests/test_pr6_boundary_mutants.py\\n\\n      - name: Run the local credential-free gate\\n        working-directory: relux-tunnel\\n        run: make credential-free-validate LEGACY_ROOT=\\\"$GITHUB_WORKSPACE/relux-proxy\\\"\\n\\n      - name: Upload privacy-safe validation evidence\\n        if: always()\\n        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\\n        with:\\n          name: credential-free-generated-project-${{ github.run_id }}\\n          path: |\\n            relux-tunnel/.temp/TASK-260715-sbrrp7/credential-free-validation/summary.log\\n            relux-tunnel/.temp/TASK-260715-sbrrp7/credential-free-validation/environment.log\\n            relux-tunnel/.temp/TASK-260715-sbrrp7/credential-free-validation/logs\\n          if-no-files-found: error\\n          retention-days: 14\\n\\n  validate:\\n    name: board + spec validation\\n    runs-on: ubuntu-latest\\n    steps:\\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\\n        with:\\n          persist-credentials: false\\n\\n      - name: Validate workflow YAML\\n        run: |\\n          python3 - <<'PY'\\n          import glob, sys, yaml\\n          bad = False\\n          for f in glob.glob(\\\".github/workflows/*.yml\\\"):\\n              try:\\n                  yaml.safe_load(open(f))\\n                  print(f\\\"ok   {f}\\\")\\n              except Exception as e:\\n                  print(f\\\"FAIL {f}: {e}\\\"); bad = True\\n          sys.exit(1 if bad else 0)\\n          PY\\n\\n      - name: Check spec presence\\n        run: |\\n          missing=0\\n          for f in architecture decisions platform-distribution product \\\\\\n                   routing-dns-lifecycle security-privacy ssh-transport \\\\\\n                   relay-protocol packet-plane threat-model validation delivery; do\\n            if [ ! -f \\\".spec/$f.md\\\" ]; then echo \\\"MISSING .spec/$f.md\\\"; missing=1; fi\\n          done\\n          [ \\\"$missing\\\" = 0 ] && echo \\\"all required specs present\\\"\\n          exit $missing\\n\\n      - name: Check board structure\\n        run: |\\n          python3 -m unittest scripts/tests/test_check_board_structure.py\\n          python3 scripts/check_board_structure.py\\n\\n  relay-toolchain:\\n    name: pinned offline relay toolchain\\n    runs-on: ubuntu-24.04\\n    steps:\\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\\n        with:\\n          fetch-depth: 0\\n          persist-credentials: false\\n\\n      - name: Verify checked-in pins and missing-input failure\\n        run: |\\n          make relay-supply-chain-audit relay-supply-chain-test relay-toolchain-check relay-toolchain-negative-test\\n          python3 -W error::ResourceWarning -m unittest scripts/tests/test_relay_asset_smoke.py\\n\\n      - name: Fetch the approved checksum-pinned Go input\\n        run: |\\n          mkdir -p .temp/relay-tools\\n          read -r go_archive go_sha go_url <<EOF\\n          $(python3 -c 'import json; d=json.load(open(\\\"relay/toolchain-manifest-v1.json\\\")); x=next(v for v in d[\\\"hostToolArchives\\\"] if v[\\\"host\\\"] == \\\"linux/amd64\\\"); print(x[\\\"artifact\\\"], x[\\\"sha256\\\"], x[\\\"source\\\"])')\\n          EOF\\n          curl --fail --location --proto '=https' --tlsv1.2 \\\\\\n            --output \\\".temp/relay-tools/$go_archive\\\" \\\"$go_url\\\"\\n          printf '%s  %s\\\\n' \\\"$go_sha\\\" \\\".temp/relay-tools/$go_archive\\\" | sha256sum --check --strict\\n          make relay-provision-go RELAY_GO_ARCHIVE=\\\".temp/relay-tools/$go_archive\\\"\\n\\n      - name: Test, vet, license-extract, and clean-build all four targets offline\\n        run: |\\n          source_date_epoch=$(git show -s --format=%ct HEAD)\\n          make relay-toolchain-ci \\\\\\n            RELAY_VERSION=0.0.0 \\\\\\n            SOURCE_COMMIT=\\\"$GITHUB_SHA\\\" \\\\\\n            SOURCE_DATE_EPOCH=\\\"$source_date_epoch\\\" \\\\\\n            RELAY_BUILD_CLEAN_FLAG=--require-clean\\n\\n  relay-portable-runtime:\\n    name: portable runtime ${{ matrix.target }} on ${{ matrix.runner }}\\n    strategy:\\n      fail-fast: false\\n      matrix:\\n        include:\\n          - target: darwin/amd64\\n            slug: darwin-amd64\\n            runner: macos-15-intel\\n          - target: darwin/arm64\\n            slug: darwin-arm64\\n            runner: macos-15\\n          - target: linux/amd64\\n            slug: linux-amd64\\n            runner: ubuntu-24.04\\n          - target: linux/arm64\\n            slug: linux-arm64\\n            runner: ubuntu-24.04-arm\\n    runs-on: ${{ matrix.runner }}\\n    steps:\\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\\n        with:\\n          fetch-depth: 0\\n          persist-credentials: false\\n\\n      - name: Verify checked-in pins and runtime-gate tests\\n        run: make relay-toolchain-check relay-toolchain-negative-test\\n\\n      - name: Fetch the approved checksum-pinned host tools\\n        env:\\n          RELAY_HOST_TARGET: ${{ matrix.target }}\\n        run: |\\n          mkdir -p .temp/relay-tools\\n          read -r go_archive go_sha go_url syft_archive syft_sha syft_url <<EOF\\n          $(python3 -c 'import json,os; d=json.load(open(\\\"relay/toolchain-manifest-v1.json\\\")); h=os.environ[\\\"RELAY_HOST_TARGET\\\"]; g=next(v for v in d[\\\"hostToolArchives\\\"] if v[\\\"host\\\"] == h); s=next(v for v in d[\\\"buildOnlyTools\\\"][0][\\\"hostArchives\\\"] if v[\\\"host\\\"] == h); print(g[\\\"artifact\\\"], g[\\\"sha256\\\"], g[\\\"source\\\"], s[\\\"artifact\\\"], s[\\\"sha256\\\"], s[\\\"source\\\"])')\\n          EOF\\n          curl --fail --location --proto '=https' --tlsv1.2 \\\\\\n            --output \\\".temp/relay-tools/$go_archive\\\" \\\"$go_url\\\"\\n          curl --fail --location --proto '=https' --tlsv1.2 \\\\\\n            --output \\\".temp/relay-tools/$syft_archive\\\" \\\"$syft_url\\\"\\n          python3 - \\\"$go_sha\\\" \\\".temp/relay-tools/$go_archive\\\" \\\"$syft_sha\\\" \\\".temp/relay-tools/$syft_archive\\\" <<'PY'\\n          import hashlib, pathlib, sys\\n          for expected, name in zip(sys.argv[1::2], sys.argv[2::2], strict=True):\\n              actual = hashlib.sha256(pathlib.Path(name).read_bytes()).hexdigest()\\n              if actual != expected:\\n                  raise SystemExit(\\\"checksum-pinned host tool mismatch\\\")\\n          PY\\n          make relay-provision-tools \\\\\\n            RELAY_GO_ARCHIVE=\\\".temp/relay-tools/$go_archive\\\" \\\\\\n            RELAY_SYFT_ARCHIVE=\\\".temp/relay-tools/$syft_archive\\\"\\n\\n      - name: Clean-build the exact four-asset manifest offline\\n        run: |\\n          source_date_epoch=$(git show -s --format=%ct HEAD)\\n          make relay-shell-release \\\\\\n            RELAY_VERSION=0.0.0 \\\\\\n            SOURCE_COMMIT=\\\"$GITHUB_SHA\\\" \\\\\\n            SOURCE_DATE_EPOCH=\\\"$source_date_epoch\\\"\\n\\n      - name: Gate native rootless stdio and runtime boundaries\\n        run: |\\n          mkdir -p \\\".build/relay/runtime-evidence/${{ matrix.slug }}\\\"\\n          python3 scripts/relay_asset_smoke.py \\\\\\n            --target \\\"${{ matrix.target }}\\\" \\\\\\n            --runner-kind native \\\\\\n            --runner-name \\\"${{ matrix.runner }}\\\" \\\\\\n            --runner-owner TASK-260715-36gq4m \\\\\\n            --require-native \\\\\\n            --manifest .build/relay/apple-bundle-input/relux-relay-manifest-v1.json \\\\\\n            --executable \\\".build/relay/apple-bundle-input/relux-relay-${{ matrix.slug }}\\\" \\\\\\n            --evidence \\\".build/relay/runtime-evidence/${{ matrix.slug }}/report.json\\\"\\n\\n      - name: Retain exact gated asset and privacy-safe runner evidence\\n        if: always()\\n        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\\n        with:\\n          name: runtime-evidence-${{ matrix.slug }}-${{ github.run_id }}\\n          path: |\\n            .build/relay/apple-bundle-input/relux-relay-${{ matrix.slug }}\\n            .build/relay/apple-bundle-input/relux-relay-${{ matrix.slug }}.spdx.json\\n            .build/relay/apple-bundle-input/relux-relay-manifest-v1.json\\n            .build/relay/apple-bundle-input/relux-relay-SHA256SUMS\\n            .build/relay/runtime-evidence/${{ matrix.slug }}/report.json\\n          if-no-files-found: warn\\n          retention-days: 14\\n===== total lines =====\\n     218\\n\",\n  \"original_output_bytes\": 9118,\n  \"original_output_tokens\": 2280,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
