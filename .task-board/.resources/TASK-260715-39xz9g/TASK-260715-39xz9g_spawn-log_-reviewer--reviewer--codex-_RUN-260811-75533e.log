   587	class EnvironmentCommandInvoker:
   588	    """Runs provider/driver commands named by environment, never recording secrets."""
   589	
   590	    def __init__(self, environment: Mapping[str, str] | None = None):
   591	        self.environment = dict(os.environ if environment is None else environment)
   592	
   593	    def __call__(self, reference: str, request: Mapping[str, object]) -> dict:
   594	        name = command_environment_name(reference)
   595	        command = self.environment.get(name)
   596	        if not command:
   597	            raise FixtureError(f"external command reference {name} is unavailable")
   598	        arguments = shlex.split(command)
   599	        if not arguments:
   600	            raise FixtureError(f"external command reference {name} is empty")
   601	        try:
   602	            completed = subprocess.run(
   603	                arguments,
   604	                input=canonical_json(dict(request)),
   605	                stdout=subprocess.PIPE,
   606	                stderr=subprocess.PIPE,
   607	                timeout=120,
   608	                check=False,
   609	                env=self.environment,
   610	            )
   611	        except (OSError, subprocess.TimeoutExpired) as error:
   612	            raise FixtureError(f"external command reference {name} failed safely") from error
   613	        if completed.returncode != 0:
   614	            raise FixtureError(
   615	                f"external command reference {name} exited {completed.returncode}; output redacted"
   616	            )
   617	        try:
   618	            response = json.loads(completed.stdout)
   619	        except json.JSONDecodeError as error:
   620	            raise FixtureError(f"external command reference {name} returned invalid JSON") from error
   621	        if not isinstance(response, dict):
   622	            raise FixtureError(f"external command reference {name} must return an object")
   623	        return response
