+
+    report = {
+        "candidates": list(REQUIRED_CANDIDATES),
+        "lifecycleObservations": lifecycle_observations,
+        "matrixObservations": matrix_observations,
+        "payloadRetention": "none",
+        "schemaVersion": 1,
+        "serverObservations": server_observations,
+        "taskId": TASK_ID,
