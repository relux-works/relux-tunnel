   497	      value == value.lowercased(),
   498	      !value.hasSuffix("."),
   499	      canonicalNumericAddress(value, family: AF_INET) == nil,
   500	      canonicalNumericAddress(value, family: AF_INET6) == nil
   501	    else { return false }
   502	
   503	    let labels = value.split(separator: ".", omittingEmptySubsequences: false)
   504	    guard !labels.isEmpty else { return false }
   505	    if labels.count == 4,
   506	      labels.allSatisfy({ label in
   507	        !label.isEmpty && label.allSatisfy(\.isNumber)
   508	      })
   509	    {
   510	      return false
   511	    }
   512	    for label in labels {
   513	      guard (1...63).contains(label.utf8.count),
   514	        label.first != "-", label.last != "-",
   515	        label.allSatisfy({ $0.isASCII && ($0.isLetter || $0.isNumber || $0 == "-") })
   516	      else { return false }
   517	      if label.count >= 4,
   518	        label[label.index(label.startIndex, offsetBy: 2)] == "-",
   519	        label[label.index(label.startIndex, offsetBy: 3)] == "-",
   520	        !label.hasPrefix("xn--")
   521	      {
   522	        return false
   523	      }
   524	    }
   525	
   526	    var components = URLComponents()
   527	    components.scheme = "ssh"
   528	    components.host = value
   529	    guard let unicodeHost = components.host,
   530	      let encodedHost = components.url?.host()?.lowercased(),
   531	      encodedHost == value
   532	    else { return false }
   533	    var roundTrip = URLComponents()
   534	    roundTrip.scheme = "ssh"
   535	    roundTrip.host = unicodeHost
   536	    return roundTrip.url?.host()?.lowercased() == value
   537	  }
   538	
   539	  private static func canonicalNumericAddress(_ value: String, family: Int32) -> String? {
   540	    if family == AF_INET {
   541	      var address = in_addr()
   542	      guard value.withCString({ inet_pton(AF_INET, $0, &address) }) == 1 else { return nil }
   543	      var buffer = [CChar](repeating: 0, count: Int(INET_ADDRSTRLEN))
   544	      guard inet_ntop(AF_INET, &address, &buffer, socklen_t(buffer.count)) != nil else {
   545	        return nil
   546	      }
   547	      return String(
   548	        decoding: buffer.prefix(while: { $0 != 0 }).map { UInt8(bitPattern: $0) },
   549	        as: UTF8.self
   550	      )
   551	    }
   552	    var address = in6_addr()
   553	    guard value.withCString({ inet_pton(AF_INET6, $0, &address) }) == 1 else { return nil }
   554	    var buffer = [CChar](repeating: 0, count: Int(INET6_ADDRSTRLEN))
   555	    guard inet_ntop(AF_INET6, &address, &buffer, socklen_t(buffer.count)) != nil else {
   556	      return nil
   557	    }
   558	    return String(
   559	      decoding: buffer.prefix(while: { $0 != 0 }).map { UInt8(bitPattern: $0) },
   560	      as: UTF8.self
   561	    )
   562	  }
   563	
   564	  private static func canonicalUUID(
   565	    _ value: String,
   566	    field: SSHProfileSnapshotField
   567	  ) throws -> UUID {
   568	    guard let uuid = UUID(uuidString: value), uuid.uuidString.lowercased() == value else {
   569	      throw SSHProfileSnapshotLoaderError.profileInvalidField(field)
   570	    }
   571	    return uuid
   572	  }
   573	
   574	  private static func timestamp(
   575	    _ value: String,
   576	    field: SSHProfileSnapshotField
   577	  ) throws -> (rawValue: String, date: Date) {
   578	    let bytes = Array(value.utf8)
   579	    guard bytes.count == 24,
   580	      bytes[4] == UInt8(ascii: "-"), bytes[7] == UInt8(ascii: "-"),
   581	      bytes[10] == UInt8(ascii: "T"), bytes[13] == UInt8(ascii: ":"),
   582	      bytes[16] == UInt8(ascii: ":"), bytes[19] == UInt8(ascii: "."),
   583	      bytes[23] == UInt8(ascii: "Z"),
   584	      bytes.enumerated().allSatisfy({ index, byte in
   585	        [4, 7, 10, 13, 16, 19, 23].contains(index)
   586	          || (UInt8(ascii: "0")...UInt8(ascii: "9")).contains(byte)
   587	      })
   588	    else {
   589	      throw SSHProfileSnapshotLoaderError.profileInvalidField(field)
   590	    }
   591	    let formatter = ISO8601DateFormatter()
   592	    formatter.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
   593	    formatter.timeZone = TimeZone(secondsFromGMT: 0)
   594	    guard let date = formatter.date(from: value), formatter.string(from: date) == value else {
   595	      throw SSHProfileSnapshotLoaderError.profileInvalidField(field)
   596	    }
   597	    return (value, date)
   598	  }
   599	
   600	  private static func fingerprint(
   601	    _ value: String
   602	  ) throws -> (rawValue: String, digest: Data) {
   603	    guard let digest = fingerprintDigest(value) else {
   604	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   605	    }
   606	    return (value, digest)
   607	  }
   608	
   609	  private static func fingerprintDigest(_ value: String) -> Data? {
   610	    guard value.hasPrefix("SHA256:"), value.utf8.count == 50 else { return nil }
   611	    let encoded = String(value.dropFirst(7))
   612	    guard encoded.utf8.count == 43,
   613	      encoded.unicodeScalars.allSatisfy({ scalar in
   614	        scalar.isASCII
   615	          && (("A"..."Z").contains(Character(scalar))
   616	            || ("a"..."z").contains(Character(scalar))
   617	            || ("0"..."9").contains(Character(scalar))
   618	            || scalar == "+" || scalar == "/")
   619	      }),
   620	      let data = Data(base64Encoded: encoded + "="), data.count == 32,
   621	      data.base64EncodedString().dropLast() == encoded
   622	    else { return nil }
   623	    return data
   624	  }
   625	
   626	  private static func isRejectedDisplayScalar(_ scalar: Unicode.Scalar) -> Bool {
   627	    CharacterSet.controlCharacters.contains(scalar)
   628	      || scalar.value == 0x2028 || scalar.value == 0x2029
   629	      || (0x202A...0x202E).contains(scalar.value)
   630	      || (0x2066...0x2069).contains(scalar.value)
   631	  }
   632	
   633	  private static func isRejectedAccountScalar(_ scalar: Unicode.Scalar) -> Bool {
   634	    scalar.value == 0 || CharacterSet.controlCharacters.contains(scalar)
   635	      || scalar.value == 0x2028 || scalar.value == 0x2029
   636	  }
   637	
   638	  private static func isProhibitedFieldName(_ name: String) -> Bool {
   639	    let normalized = name.lowercased().unicodeScalars.filter {
   640	      CharacterSet.alphanumerics.contains($0)
   641	    }.map(String.init).joined()
   642	    return [
   643	      "privatekey", "privatekeybytes", "passphrase", "decryptedkey", "keybytes",
   644	      "rawhostkey", "password", "seed", "stagingcredential",
   645	    ].contains(normalized)
   646	  }
   647	}
