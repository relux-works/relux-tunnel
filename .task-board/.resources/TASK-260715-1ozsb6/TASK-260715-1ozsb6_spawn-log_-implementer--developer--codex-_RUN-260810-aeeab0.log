-      try await clock.sleep(for: timeout)
-      throw LibSSH2TimeoutError.elapsed
+  let race = LibSSH2TimeoutRace<Value>()
+  return try await withTaskCancellationHandler {
+    try await withCheckedThrowingContinuation { continuation in
+      race.start(
+        continuation: continuation,
+        timeout: timeout,
+        clock: clock,
+        operation: operation
+      )
     }
-    guard let result = try await group.next() else { throw LibSSH2TimeoutError.elapsed }
-    group.cancelAll()
-    return result
+  } onCancel: {
+    race.cancel()
   }
 }
 

