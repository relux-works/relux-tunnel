  'workflow_run: completed' \
  'github.workflow_sha' \
  'full-reviewed-commit-SHA' \
  'relative or candidate/tag-ref reusable workflow'
do
  grep -Fq "$phrase" "$doc"
done

if grep -Fq 'Triggers: a `v*` tag push or explicit `workflow_dispatch`' "$doc"; then
  exit 1
fi

printf 'inventory_rows=%s required_checks=%s trace_rows=%s trusted_entry=pass threats=pass\n' \
  "$inventory_rows" "$required_checks" "$trace_rows"

