    35	    def _write_fixture_resources_and_rebind_digests(self) -> None:
    36	        bindings: list[tuple[str, dict[str, object]]] = []
    37	        runtime = self.data["runtimeContract"]
    38	        bindings.append((runtime["taskId"], runtime))
    39	        bindings.append((runtime["taskId"], runtime["reviewerVerdict"]))
    40	        for item in self.data["acceptedInputs"]:
    41	            bindings.append((item["taskId"], item["acceptedOutcome"]))
    42	            bindings.append((item["taskId"], item["reviewerVerdict"]))
    43	        for task_id, resource in bindings:
    44	            path = self.resources / task_id / resource["resourceName"]
    45	            path.parent.mkdir(parents=True, exist_ok=True)
    46	            payload = f"fixture authority for {task_id}/{resource['resourceName']}\n".encode()
    47	            path.write_bytes(payload)
    48	            resource["sha256"] = hashlib.sha256(payload).hexdigest()
