    } catch {
      throw map(error, fallback: Self.error(domain: .networkSettings, code: "settings_invalid"))
    }

    try await transitionDuringStartup(to: .networkSettings)
    settingsState = .uncertain
    do {
      try await dependencies.settingsApplier.apply(
