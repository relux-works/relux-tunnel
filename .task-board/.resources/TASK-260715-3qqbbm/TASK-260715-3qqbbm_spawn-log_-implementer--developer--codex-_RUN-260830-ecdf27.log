   130	def pbx_object(text: str, object_id: str) -> str:
   131	    """Return one generated PBX object body, including its outer braces."""
   132	    declaration = re.search(
   133	        rf"(?m)^\s*{re.escape(object_id)}(?:\s+/\*.*?\*/)?\s*=\s*\{{", text
   134	    )
   135	    if declaration is None:
   136	        raise ContractError(
   137	            f"generated project references missing PBX object {object_id}"
   138	        )
   139	
   140	    opening = text.find("{", declaration.start())
   141	    depth = 0
   142	    in_string = False
   143	    escaped = False
   144	    for index in range(opening, len(text)):
   145	        character = text[index]
   146	        if in_string:
   147	            if escaped:
   148	                escaped = False
   149	            elif character == "\\":
   150	                escaped = True
   151	            elif character == '"':
   152	                in_string = False
   153	            continue
   154	        if character == '"':
   155	            in_string = True
   156	        elif character == "{":
   157	            depth += 1
   158	        elif character == "}":
   159	            depth -= 1
   160	            if depth == 0:
   161	                return text[opening : index + 1]
   162	    raise ContractError(f"unterminated generated PBX object {object_id}")
   163	
   164	
   165	def pbx_list_ids(block: str, key: str) -> list[str]:
   166	    match = re.search(rf"\b{re.escape(key)}\s*=\s*\((.*?)\);", block, re.DOTALL)
   167	    if match is None:
   168	        raise ContractError(f"generated PBX object is missing inspectable {key}")
   169	    return re.findall(r"(?m)^\s*([0-9A-F]{24})(?:\s+/\*.*?\*/)?\s*,", match.group(1))
   170	
   171	
   172	def named_native_target(text: str, name: str) -> str:
   173	    candidates: list[str] = []
   174	    for match in re.finditer(r"(?m)^\s*([0-9A-F]{24})(?:\s+/\*.*?\*/)?\s*=\s*\{", text):
   175	        block = pbx_object(text, match.group(1))
   176	        if "isa = PBXNativeTarget;" not in block:
   177	            continue
   178	        target_name = re.search(r"(?m)^\s*name\s*=\s*\"?([^\";]+)\"?;", block)
   179	        if target_name is not None and target_name.group(1) == name:
   180	            candidates.append(block)
   181	    if len(candidates) != 1:
   182	        raise ContractError(
   183	            f"generated project must contain exactly one PBXNativeTarget named {name}"
   184	        )
   185	    return candidates[0]
   186	
   187	
   188	def target_phase(text: str, target: str, isa: str) -> str:
   189	    phases = [
   190	        pbx_object(text, phase_id) for phase_id in pbx_list_ids(target, "buildPhases")
   191	    ]
   192	    matches = [phase for phase in phases if f"isa = {isa};" in phase]
   193	    if len(matches) != 1:
   194	        raise ContractError(
   195	            f"ReluxProxyMacTunnel must reference exactly one {isa} build phase"
   196	        )
   197	    return matches[0]
   198	
   199	
   200	def require_phase_edge(
   201	    text: str, phase: str, reference_key: str, expected_name: str, phase_name: str
   202	) -> None:
   203	    matched_edges = 0
   204	    for build_file_id in pbx_list_ids(phase, "files"):
   205	        build_file = pbx_object(text, build_file_id)
   206	        reference = re.search(
   207	            rf"\b{re.escape(reference_key)}\s*=\s*([0-9A-F]{{24}})", build_file
   208	        )
   209	        if reference is None:
   210	            continue
   211	        referenced_object = pbx_object(text, reference.group(1))
   212	        product_name = re.search(
   213	            r"\bproductName\s*=\s*\"?([^\";]+)\"?;", referenced_object
   214	        )
   215	        path = re.search(r"\bpath\s*=\s*\"?([^\";]+)\"?;", referenced_object)
   216	        resolved_name = product_name.group(1) if product_name is not None else None
   217	        if resolved_name is None and path is not None:
   218	            resolved_name = path.group(1)
   219	        if resolved_name == expected_name:
   220	            matched_edges += 1
   221	    if matched_edges != 1:
   222	        raise ContractError(
   223	            f"ReluxProxyMacTunnel {phase_name} phase must contain exactly one "
   224	            f"{expected_name} build-file edge"
   225	        )
   226	
