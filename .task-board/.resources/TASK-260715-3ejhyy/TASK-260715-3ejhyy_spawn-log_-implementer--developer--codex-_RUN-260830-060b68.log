    47	public final class StreamHarnessCancellationSource: HarnessCancellationSource, @unchecked Sendable {
    48	  private let stream: AsyncStream<HarnessCancellationReason>
    49	  private let continuation: AsyncStream<HarnessCancellationReason>.Continuation
    50	
    51	  public init() {
    52	    let pair = AsyncStream<HarnessCancellationReason>.makeStream()
    53	    stream = pair.stream
    54	    continuation = pair.continuation
    55	  }
    56	
    57	  public func cancel(reason: HarnessCancellationReason) {
    58	    continuation.yield(reason)
    59	    continuation.finish()
    60	  }
    61	
    62	  public func waitForCancellation() async -> HarnessCancellationReason {
    63	    for await reason in stream {
    64	      return reason
    65	    }
    66	    return .task
    67	  }
    68	}
