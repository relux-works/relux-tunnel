func (s *session) transitionAlreadyDone(txn *Txn) (bool, error) {
	b, err := s.req.Store.LoadBoard()
	if err != nil {
		return false, wrapError(ErrorIntegrationIndeterminate, "loading the board", err, nil)
	}
	elem := b.FindByID(txn.TransitionElementID)
	if elem == nil {
		return false, newError(ErrorIntegrationIndeterminate,
			fmt.Sprintf("%s is not on the board", txn.TransitionElementID), nil)
	}
	return elem.Status == pkgboard.StatusDone, nil
}

