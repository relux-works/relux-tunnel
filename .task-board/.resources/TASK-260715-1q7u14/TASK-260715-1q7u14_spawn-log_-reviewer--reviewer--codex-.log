   480	          throw RelayVectorHarnessFailure(vectorID: vector.id, reason: "invalid chunk plan")
   481	        }
   482	      }
   483	      for reference in vector.limitRefs {
   484	        _ = try resolvedLimit(reference, vectorID: vector.id)
   485	      }
   486	      guard Set(vector.features).isSubset(of: ["dnsPriorityHint"]) else {
   487	        throw RelayVectorHarnessFailure(vectorID: vector.id, reason: "unknown feature")
   488	      }
   489	      coverage.formUnion(vector.covers)
   490	    }
   491	    let missing = requiredCoverage().subtracting(coverage)
   492	    guard missing.isEmpty else {
   493	      throw RelayVectorHarnessFailure(vectorID: "<corpus>", reason: "required coverage missing")
   494	    }
   495	  }
