   588	  private func exerciseRepeatedConcurrentCancellation(transport: LibSSH2Transport) async throws {
   589	    for iteration in 0..<5 {
   590	      let channel = try await transport.openExecChannel(
   591	        request: SSHExecRequest(command: "sleep 2"),
   592	        policy: fixtureChannelPolicy()
   593	      )
   594	      let pendingRead = Task { try await channel.read(maximumBytes: 1) }
   595	      for _ in 0..<200 {
   596	        if await transport.snapshot().gauges.pendingReads == 1 { break }
   597	        await Task.yield()
   598	      }
   599	      #expect(await transport.snapshot().gauges.pendingReads == 1, "iteration \(iteration)")
   600	      await channel.cancel()
   601	      do {
   602	        _ = try await pendingRead.value
   603	        Issue.record(
   604	          "concurrent channel read unexpectedly completed", sourceLocation: #_sourceLocation)
   605	      } catch let error as SSHTransportError {
   606	        #expect(error.code == .cancelled, "iteration \(iteration)")
   607	        #expect(error.phase == .channelRead, "iteration \(iteration)")
   608	      }
   609	      #expect(await transport.snapshot().gauges.pendingReads == 0, "iteration \(iteration)")
   610	    }
   611	  }
   612	
   613	  private func readAll(_ channel: any SSHExecChannel) async throws -> Data {
   614	    var result = Data()
   615	    while let bytes = try await channel.read(maximumBytes: 16 * 1_024) {
   616	      result.append(bytes)
   617	    }
   618	    return result
   619	  }
   620	
   621	  private func waitForPendingReads(_ count: Int64, transport: LibSSH2Transport) async {
   622	    for _ in 0..<200 {
   623	      if await transport.snapshot().gauges.pendingReads == count { return }
   624	      await Task.yield()
   625	    }
   626	  }
   627	}
