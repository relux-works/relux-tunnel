      guard result == LIBSSH2_ERROR_EAGAIN else {
        throw engineError(result, phase: .initialKeyExchange, fallback: .algorithmNegotiationFailed)
      }
      try await progress(until: deadline, phase: .initialKeyExchange)
    }
  }

