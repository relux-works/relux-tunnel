  1222	  private mutating func parseValue(depth: Int) throws {
  1223	    guard depth <= maximumDepth else {
  1224	      throw RuntimeMessageCodecError.excessiveNesting(
  1225	        maximumDepth: maximumDepth
  1226	      )
  1227	    }
  1228	    guard let current = peek else { throw RuntimeMessageCodecError.corruptPayload }
  1229	    switch current {
  1230	    case UInt8(ascii: "{"):
  1231	      _ = try parseObject(depth: depth)
  1232	    case UInt8(ascii: "["):
  1233	      try parseArray(depth: depth)
  1234	    case UInt8(ascii: "\""):
  1235	      _ = try parseString()
  1236	    case UInt8(ascii: "t"):
  1237	      try consumeLiteral("true")
  1238	    case UInt8(ascii: "f"):
  1239	      try consumeLiteral("false")
  1240	    case UInt8(ascii: "n"):
  1241	      try consumeLiteral("null")
  1242	    case UInt8(ascii: "-"), UInt8(ascii: "0")...UInt8(ascii: "9"):
  1243	      try parseNumber()
  1244	    default:
  1245	      throw RuntimeMessageCodecError.corruptPayload
  1246	    }
  1247	  }
  1248	
  1249	  private mutating func parseObject(depth: Int) throws -> Set<String> {
  1250	    guard depth <= maximumDepth else {
  1251	      throw RuntimeMessageCodecError.excessiveNesting(
  1252	        maximumDepth: maximumDepth
  1253	      )
  1254	    }
  1255	    try consume(UInt8(ascii: "{"))
  1256	    skipWhitespace()
  1257	    var keys: Set<String> = []
  1258	    var previousKey: String?
  1259	    if consumeIf(UInt8(ascii: "}")) { return keys }
  1260	
  1261	    while true {
  1262	      guard peek == UInt8(ascii: "\"") else { throw RuntimeMessageCodecError.corruptPayload }
  1263	      let key = try parseString()
  1264	      guard keys.insert(key).inserted else { throw RuntimeMessageCodecError.duplicateKey }
  1265	      allObjectKeys.insert(key)
  1266	      if requiresSortedKeys, let previousKey,
  1267	        !previousKey.utf8.lexicographicallyPrecedes(key.utf8)
  1268	      {
  1269	        throw RuntimeMessageCodecError.corruptPayload
  1270	      }
  1271	      previousKey = key
  1272	      skipWhitespace()
  1273	      try consume(UInt8(ascii: ":"))
  1274	      skipWhitespace()
  1275	      try parseValue(depth: depth + 1)
  1276	      skipWhitespace()
  1277	      if consumeIf(UInt8(ascii: "}")) { return keys }
  1278	      try consume(UInt8(ascii: ","))
  1279	      skipWhitespace()
  1280	    }
  1281	  }
  1282	
  1283	  private mutating func parseArray(depth: Int) throws {
  1284	    guard depth <= maximumDepth else {
  1285	      throw RuntimeMessageCodecError.excessiveNesting(
  1286	        maximumDepth: maximumDepth
  1287	      )
  1288	    }
  1289	    try consume(UInt8(ascii: "["))
  1290	    skipWhitespace()
  1291	    if consumeIf(UInt8(ascii: "]")) { return }
  1292	    while true {
  1293	      try parseValue(depth: depth + 1)
  1294	      skipWhitespace()
  1295	      if consumeIf(UInt8(ascii: "]")) { return }
  1296	      try consume(UInt8(ascii: ","))
  1297	      skipWhitespace()
  1298	    }
  1299	  }
