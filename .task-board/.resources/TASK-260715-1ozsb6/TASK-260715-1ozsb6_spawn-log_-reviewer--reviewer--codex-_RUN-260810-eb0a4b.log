  1513	  private func checkCancellation(phase: SSHTransportPhase) throws {
  1514	    do {
  1515	      if closeRequested { throw CancellationError() }
  1516	      try dependencies.cancellation.checkCancellation()
  1517	      try Task.checkCancellation()
  1518	    } catch {
  1519	      throw transportError(code: .cancelled, phase: phase)
  1520	    }
  1521	  }
  1522	
  1523	  private func emit(_ kind: SSHTransportEventKind) async {
  1524	    await reconcileProtectedMetrics()
  1525	    let event = SSHTransportEvent(timestamp: dependencies.clock.now(), kind: kind)
  1526	    await dependencies.observer.observe(event)
  1527	    await dependencies.logger.log(level: .info, event: event)
  1528	    await dependencies.experimentRecorder?.record(.event(event))
  1529	  }
  1530	
  1531	  private func metric(_ update: SSHMetricUpdate) async {
  1532	    await dependencies.metrics.record(update)
  1533	  }
  1534	
  1535	  private func reconcileProtectedMetrics() async {
  1536	    guard let baseline = protectedNetworkBaseline else { return }
  1537	    let current = context.network.engineByteCounts
  1538	    let sent = current.sent - baseline.sent
  1539	    let received = current.received - baseline.received
  1540	    if sent > counters.protectedBytesSent {
  1541	      await metric(.increment(.protectedBytesSent, by: sent - counters.protectedBytesSent))
  1542	      counters.protectedBytesSent = sent
  1543	    }
  1544	    if received > counters.protectedBytesReceived {
  1545	      await metric(
  1546	        .increment(.protectedBytesReceived, by: received - counters.protectedBytesReceived))
  1547	      counters.protectedBytesReceived = received
  1548	    }
  1549	  }
  1550	
  1551	  private func phase(for state: SSHConnectionState) -> SSHTransportPhase {
  1552	    switch state {
  1553	    case .idle: .configuration
  1554	    case .resolving: .resolution
  1555	    case .tcpConnecting: .tcpConnect
  1556	    case .keyExchange: .initialKeyExchange
  1557	    case .awaitingHostDecision: .hostDecision
  1558	    case .authenticating: .authentication
  1559	    case .ready: .protocolProcessing
  1560	    case .rekeying: .rekey
  1561	    case .failed: .protocolProcessing
  1562	    case .closing, .closed: .transportClose
  1563	    }
  1564	  }
  1565	
  1566	  private func engineError(
  1567	    _ engineCode: Int32,
  1568	    phase: SSHTransportPhase,
  1569	    fallback: SSHTransportErrorCode
  1570	  ) -> SSHTransportError {
  1571	    let code: SSHTransportErrorCode
  1572	    switch engineCode {
  1573	    case LIBSSH2_ERROR_AUTHENTICATION_FAILED: code = .authenticationRejected
  1574	    case LIBSSH2_ERROR_PUBLICKEY_UNVERIFIED, LIBSSH2_ERROR_PUBLICKEY_PROTOCOL:
  1575	      code = .signatureFailed
  1576	    case LIBSSH2_ERROR_CHANNEL_FAILURE: code = .channelOpenRejected
  1577	    case LIBSSH2_ERROR_CHANNEL_REQUEST_DENIED: code = .execRejected
  1578	    case LIBSSH2_ERROR_CHANNEL_CLOSED, LIBSSH2_ERROR_CHANNEL_EOF_SENT: code = .channelClosed
  1579	    case LIBSSH2_ERROR_ALLOC: code = .resourceLimitExceeded
  1580	    case LIBSSH2_ERROR_SOCKET_SEND, LIBSSH2_ERROR_SOCKET_RECV,
  1581	      LIBSSH2_ERROR_SOCKET_DISCONNECT:
  1582	      code = .connectionLost
  1583	    case LIBSSH2_ERROR_TIMEOUT, LIBSSH2_ERROR_SOCKET_TIMEOUT: code = .timedOut
  1584	    default: code = fallback
  1585	    }
  1586	    return transportError(code: code, phase: phase)
  1587	  }
  1588	
  1589	  private func map(
  1590	    _ error: Error,
  1591	    phase: SSHTransportPhase,
  1592	    fallback: SSHTransportErrorCode = .adapterFailure
  1593	  ) -> SSHTransportError {
  1594	    if let error = error as? SSHTransportError { return error }
  1595	    if error is CancellationError { return transportError(code: .cancelled, phase: phase) }
  1596	    if error is LibSSH2TimeoutError { return transportError(code: .timedOut, phase: phase) }
  1597	    return transportError(code: fallback, phase: phase)
  1598	  }
  1599	
  1600	  private func recordTerminalOperation(_ error: SSHTransportError) async {
  1601	    if error.code == .timedOut {
  1602	      await metric(.increment(.operationsTimedOut, by: 1))
  1603	    } else if error.code == .cancelled {
  1604	      await metric(.increment(.operationsCancelled, by: 1))
  1605	    }
  1606	  }
  1607	
  1608	  private func transportError(
  1609	    code: SSHTransportErrorCode,
  1610	    phase: SSHTransportPhase,
  1611	    scope: SSHTransportErrorScope? = nil
  1612	  ) -> SSHTransportError {
  1613	    if code == .timedOut {
  1614	      counters.operationsTimedOut += 1
  1615	    } else if code == .cancelled {
  1616	      counters.operationsCancelled += 1
