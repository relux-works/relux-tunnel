sed -n '1,220p' Sources/ReluxTunnelCore/PacketContracts.swift
sed -n '1,180p' Sources/ReluxTunnelCore/ComponentContracts.swift
sed -n '1,180p' Sources/ReluxTunnelMacOSAdapter/MacOSProviderCompositionRoot.swift
sed -n '1,180p' Sources/ReluxTunnelIOSAdapter/IOSProviderCompositionRoot.swift
sed -n '1,260p' Tests/ReluxTunnelCoreTests/PacketFlowBridgeTests.swift" in /Users/iv/Developer/relux-tunnel
