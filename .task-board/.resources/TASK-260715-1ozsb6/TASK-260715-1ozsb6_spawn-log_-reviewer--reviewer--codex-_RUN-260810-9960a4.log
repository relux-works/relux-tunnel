   342	  private func exerciseServerAndClientRekey(transport: LibSSH2Transport) async throws {
   343	    let channel = try await transport.openExecChannel(
   344	      request: SSHExecRequest(command: "yes r | head -c 131072"),
   345	      policy: fixtureChannelPolicy()
   346	    )
   347	    let bytes = try await readAll(channel)
   348	    #expect(bytes.count == 131_072)
   349	    _ = try await channel.waitForExit()
