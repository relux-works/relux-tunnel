+    """.utf8
+  )
+}
+
+private func isLowercaseHex(_ value: String, count: Int) -> Bool {
+  value.count == count
+    && value.allSatisfy { character in
+      character.isNumber || ("a"..."f").contains(character)
+    }
+}
