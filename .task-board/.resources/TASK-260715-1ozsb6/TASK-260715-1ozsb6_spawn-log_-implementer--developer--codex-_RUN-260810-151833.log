   387	  private func performOpenExecChannel(
   388	    request: SSHExecRequest,
   389	    policy: SSHChannelPolicy,
   390	    deadline: ContinuousClock.Instant
   391	  ) async throws -> any SSHExecChannel {
   392	    guard state == .ready else {
   393	      throw transportError(code: .invalidState, phase: .channelOpen)
   394	    }
   395	    let identity = dependencies.identityGenerator.makeChannelIdentity()
   396	    let pointer: OpaquePointer
   397	    while true {
   398	      try checkCancellation(phase: .channelOpen, scope: .operation)
   399	      guard state == .ready, let engineSession else {
   400	        throw transportError(code: .cancelled, phase: .channelOpen)
   401	      }
   402	      if let opened = libssh2_channel_open_ex(
   403	        engineSession,
   404	        "session",
   405	        UInt32("session".utf8.count),
   406	        UInt32(clamping: policy.initialReceiveWindowBytes),
   407	        UInt32(clamping: min(policy.maximumWriteCallBytes, Int(LIBSSH2_CHANNEL_PACKET_DEFAULT))),
   408	        nil,
   409	        0
   410	      ) {
   411	        pointer = opened
   412	        break
   413	      }
   414	      let code = libssh2_session_last_errno(engineSession)
   415	      guard code == LIBSSH2_ERROR_EAGAIN else {
   416	        counters.channelOpenFailed += 1
   417	        await metric(.increment(.channelOpenFailed, by: 1))
   418	        throw engineError(
   419	          code,
   420	          phase: .channelOpen,
   421	          fallback: .channelOpenRejected,
   422	          scope: .operation
   423	        )
   424	      }
   425	      try await progress(until: deadline, phase: .channelOpen, scope: .operation)
   426	    }
   427	
   428	    do {
   429	      while true {
   430	        try checkCancellation(phase: .execRequest, scope: .channel(identity))
   431	        guard state == .ready, engineSession != nil else {
   432	          throw transportError(code: .cancelled, phase: .execRequest)
   433	        }
   434	        let result = request.command.utf8CString.withUnsafeBytes { command in
   435	          libssh2_channel_process_startup(
   436	            pointer,
   437	            "exec",
   438	            UInt32("exec".utf8.count),
   439	            command.bindMemory(to: CChar.self).baseAddress,
   440	            UInt32(max(0, command.count - 1))
   441	          )
   442	        }
   443	        if result == 0 { break }
   444	        guard result == LIBSSH2_ERROR_EAGAIN else {
   445	          throw engineError(
   446	            result,
   447	            phase: .execRequest,
   448	            fallback: .execRejected,
   449	            scope: .operation
   450	          )
   451	        }
   452	        try await progress(
   453	          until: deadline,
   454	          phase: .execRequest,
   455	          scope: .channel(identity)
   456	        )
   457	      }
   458	    } catch {
   459	      _ = libssh2_channel_free(pointer)
   460	      throw error
   461	    }
   462	    channels[identity] = LibSSH2ChannelRecord(pointer: pointer, kind: .exec, policy: policy)
   463	    channelWriteGates[identity] = LibSSH2SessionOperationGate(maximumWaiters: 1_024)
   464	    counters.execChannelsOpened += 1
   465	    await metric(.increment(.execChannelsOpened, by: 1))
   466	    await emit(.channelOpened(channel: identity, kind: .exec))
   467	    return LibSSH2ExecChannel(identity: identity, owner: self)
   468	  }
