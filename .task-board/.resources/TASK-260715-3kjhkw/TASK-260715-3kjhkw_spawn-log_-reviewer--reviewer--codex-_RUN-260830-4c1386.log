   458	  var callCount: Int { state.withLock(\.index) }
   459	
   460	  func sampleCurrentProcessMemory() -> MemoryPlatformSample {
   461	    onSample()
   462	    return state.withLock { state in
   463	      let sample = state.samples[min(state.index, state.samples.count - 1)]
