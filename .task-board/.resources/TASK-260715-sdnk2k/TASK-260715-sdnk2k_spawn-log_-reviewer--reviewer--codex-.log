   565	      channelWrite = .accept
   566	      scheduler = nil
   567	    case .localWritable:
   568	      readBehavior = .eof
   569	      writeBehavior = .wouldBlockStall
   570	      channelRead = .oneChunkThenEOF(Data([1]))
   571	      channelWrite = .accept
   572	      scheduler = nil
   573	    case .sshRead:
   574	      readBehavior = .eof
   575	      writeBehavior = .accept
   576	      channelRead = .stall
   577	      channelWrite = .accept
   578	      scheduler = nil
   579	    case .sshWrite:
