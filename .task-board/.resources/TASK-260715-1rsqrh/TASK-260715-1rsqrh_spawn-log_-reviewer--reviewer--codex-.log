  private func stopOperationCompleted(
    identifier: UInt64,
    result: Result<StopExecution, any Error>,
    sessionBox: FreshSessionBox
  ) async {
    guard clearStop(identifier) else { return }
    guard !retired else { return }
    switch result {
    case .success(let execution):
