  private func finishRekeyFlight(with result: Result<Void, Error>) {
    let waiters = Array(rekeyWaiters.values)
    rekeyWaiters.removeAll(keepingCapacity: false)
    rekeyReasons.removeAll(keepingCapacity: false)
