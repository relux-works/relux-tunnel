+  private func channelError(
+    code: SSHTransportErrorCode,
+    phase: SSHTransportPhase
+  ) -> SSHTransportError {
+    SSHTransportError(
+      code: code,
+      phase: phase,
+      scope: .channel(identity),
+      retryDisposition: .never,
+      requiresTeardown: false
+    )
+  }
