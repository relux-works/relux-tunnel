+  case .unsupported: .unsupported
+  }
+}
+
+private func deferredExecExit(
+  _ availability: SSHDeferredSemanticAvailability
+) -> SSHExecExit {
+  switch availability {
+  case .reported: .status(0)
+  case .notReported: .notReported
+  case .unsupported: .unsupported
+  }
+}
