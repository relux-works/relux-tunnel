+      ),
+      timeouts: try ownershipTimeouts(),
+      rekey: SSHRekeyPolicy(
+        protectedByteThresholdPerDirection: 4_096,
+        elapsedTimeThreshold: .milliseconds(100),
+        timeout: .seconds(10)
+      ),
