ile(ROOT / relative, root / relative)\n26|            helper = root / 'scripts/logged-command.sh'\n27|            source = helper.read_text()\n28|            assert source.count(before) == 1\n29|            helper.write_text(source.replace(before, after))\n30|            result = subprocess.run(\n31|                ['python3', 'scripts/tests/test_macos_build_diagnostics.py',\n32|                 ('MacOSBuildDiagnosticsTests.test_exit_one_stops_each_build_and_test_with_exact_status'\n33|                  if name == 'admit-exit-1-only' else\n34|                  'MacOSBuildDiagnosticsTests.test_each_failing_build_and_test_retains_status_and_context')],\n35|                cwd=root, capture_output=True, text=True)\n36|            print(f'{name}: behavioral suite exit {result.returncode}')\n37|            print(result.stdout + result.stderr)\n38|            if result.returncode != 1 or 'AssertionError' not in result.stderr:\n39|                raise SystemExit(f'mutant survived or test infrastructure failed: {name}')\n40|    print(f'All {len(MUTANTS)} narrowing mutants killed by production-entry behavioral tests')\n41|\n42|\n43|if __name__ == '__main__':\n44|    main()","final_result":true}}}
