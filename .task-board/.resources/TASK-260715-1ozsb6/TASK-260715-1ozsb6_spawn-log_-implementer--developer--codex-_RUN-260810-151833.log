  1903	  private func phase(for state: SSHConnectionState) -> SSHTransportPhase {
  1904	    switch state {
  1905	    case .idle: .configuration
  1906	    case .resolving: .resolution
  1907	    case .tcpConnecting: .tcpConnect
  1908	    case .keyExchange: .initialKeyExchange
  1909	    case .awaitingHostDecision: .hostDecision
  1910	    case .authenticating: .authentication
  1911	    case .ready: .protocolProcessing
  1912	    case .rekeying: .rekey
  1913	    case .failed: .protocolProcessing
  1914	    case .closing, .closed: .transportClose
  1915	    }
  1916	  }
