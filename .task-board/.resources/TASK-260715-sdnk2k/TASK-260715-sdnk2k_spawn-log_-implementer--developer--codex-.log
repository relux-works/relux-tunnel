+  func yield() async throws {
+    let shouldWait = lock.withLock { () -> Bool in
+      guard !firstReached else { return false }
+      firstReached = true
+      return !firstReleased
+    }
+    guard shouldWait else {
+      try Task<Never, Never>.checkCancellation()
+      await Task.yield()
