+private func pumpEventually(
+  iterations: Int = 10_000,
+  _ condition: @escaping @Sendable () -> Bool
+) async -> Bool {
+  for _ in 0..<iterations {
+    if condition() { return true }
+    await Task.yield()
+  }
+  return condition()
