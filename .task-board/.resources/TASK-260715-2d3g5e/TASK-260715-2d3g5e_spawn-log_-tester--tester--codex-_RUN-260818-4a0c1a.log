+private actor PrivacySurfaceRecorder: SSHTransportLogger, SSHTransportObserver,
+  SSHTransportMetricsSink
+{
+  private var logs: [(TunnelLogLevel, SSHTransportEvent)] = []
+  private var observerEvents: [SSHTransportEvent] = []
