+private enum ConformanceCancellationSite: CaseIterable, Sendable {
+  case resolution
+  case connect
+  case keyExchange
+  case hostDecision
+  case credentialLookup
+  case authentication
+  case channelOpen
+  case read
+  case write
+  case eof
+  case exec
+  case upload
+  case rekey
+  case keepalive
+  case close
