+        )
+        .replacingOccurrences(
+          of: #""value":"example.com"}"#,
+          with: #""value":"example.com"},"account":"fixture-account""#
+        ).utf8
+    )
+    #expect(throws: SSHProfileSnapshotLoaderError.profileCorrupt) {
+      try SSHProfileSnapshotCodec.decode(unsorted)
