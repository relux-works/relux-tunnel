   117	static void
   118	udp_client_entry (void *data)
   119	{
   120	    HevSocks5ClientUDP *udp;
   121	
   122	    udp = hev_socks5_client_udp_new (HEV_SOCKS5_TYPE_UDP_IN_TCP);
   123	    hev_socks5_client_connect (HEV_SOCKS5_CLIENT (udp), "127.0.0.1", 1080);
   124	    hev_socks5_client_handshake (HEV_SOCKS5_CLIENT (udp));
   125	
   126	    /*
   127	     * HevSocks5UDPMsg msgv[num];
   128	     *
   129	     * send udp packets:
   130	     *     hev_socks5_udp_sendmmsg (HEV_SOCKS5_UDP (udp), msgv, num);
   131	     *
   132	     * recv udp packets:
   133	     *     hev_socks5_udp_recvmmsg (HEV_SOCKS5_UDP (udp), msgv, num, 0);
   134	     */
   135	
