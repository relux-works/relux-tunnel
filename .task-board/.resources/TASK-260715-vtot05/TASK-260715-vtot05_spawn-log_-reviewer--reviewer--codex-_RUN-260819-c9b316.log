  1324	def scan_runtime(config: dict[str, Any], root: Path = ROOT) -> None:
  1325	    policy = config["runtimePolicy"]
  1326	    validate_runtime_policy(policy)
  1327	    extensions = set(policy["scanExtensions"])
  1328	    excluded_suffixes = tuple(policy["excludedFileSuffixes"])
  1329	    excluded_paths = set(policy["excludedPaths"])
  1330	    scanned_files = 0
  1331	    for relative_root in policy["scanRoots"]:
  1332	        scan_root = root / relative_root
  1333	        if not scan_root.is_dir() or scan_root.is_symlink():
  1334	            raise SupplyChainError(
  1335	                f"runtime audit root is unavailable: {relative_root}"
  1336	            )
  1337	        resolved_scan_root = scan_root.resolve(strict=True)
  1338	        for path in sorted(scan_root.rglob("*")):
  1339	            if path.is_symlink():
  1340	                raise SupplyChainError(
  1341	                    f"runtime audit scope contains a symlink: {path.relative_to(root)}"
  1342	                )
  1343	            if path.is_dir():
  1344	                continue
  1345	            relative_path = path.relative_to(root).as_posix()
  1346	            if not path.is_file():
  1347	                raise SupplyChainError(
  1348	                    f"runtime audit scope contains an unclassified entry: {relative_path}"
  1349	                )
  1350	            if relative_path in excluded_paths:
  1351	                continue
  1352	            if path.suffix == ".go" and path.name.endswith(excluded_suffixes):
  1353	                continue
  1354	            if path.suffix not in extensions:
  1355	                raise SupplyChainError(
  1356	                    f"runtime audit scope contains an unclassified file: {relative_path}"
  1357	                )
  1358	            resolved_path = path.resolve(strict=True)
  1359	            if not resolved_path.is_relative_to(resolved_scan_root):
  1360	                raise SupplyChainError(
  1361	                    f"runtime audit source escapes its root: {path.relative_to(root)}"
  1362	                )
  1363	            try:
  1364	                text = path.read_text(encoding="utf-8")
  1365	            except (OSError, UnicodeDecodeError) as error:
  1366	                raise SupplyChainError(
  1367	                    f"runtime audit source is unreadable: {path.relative_to(root)}"
  1368	                ) from error
  1369	            scanned_files += 1
  1370	            label = forbidden_runtime_surface(path.suffix, text)
  1371	            if label is not None:
  1372	                raise SupplyChainError(
  1373	                    "application runtime code-download surface found "
