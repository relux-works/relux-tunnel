diff --git a/Probes/macOSPacketTunnelProbe/Config/Host.entitlements b/Probes/macOSPacketTunnelProbe/Config/Host.entitlements
new file mode 100644
index 0000000000000000000000000000000000000000..ffab33e018622f633b6a4c8e94fd68c7acbf9fee
--- /dev/null
+++ b/Probes/macOSPacketTunnelProbe/Config/Host.entitlements
@@ -0,0 +1,10 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
