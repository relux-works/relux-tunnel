            channels: 0,
            socketOwned: false,
            sessionOwned: false,
            automaticTasks: 0,
            customAllocations: 0,
            bufferedBytes: 0
          ), "iteration \(index)")
      #expect((await transport.snapshot()).connectionState == .closed)
    }
  }

