{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4b3","stream":{"kind":"session","id":"01a0aa7a-9815-7302-a96f-7a8fde67c84b"},"sequence":180,"recorded_at":1780531400000355,"record_type":"event","durability":"durable","causation_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","run_stream":{"kind":"run","id":"7cb39f37-e5ea-43fc-a612-eaf97474622d"},"task_stream":{"kind":"task","id":"01a0aa7a-fcd6-7aa0-a37a-1075187b4d82"},"task_id":"01a0aa7a-fcd6-7aa0-a37a-1075187b4d82","event":{"kind":"output","task_id":"01a0aa7a-fcd6-7aa0-a37a-1075187b4d82","chunk":"Read text file `Sources/ReluxTunnelMacOSAdapter/MacOSProviderCompositionRoot.swift`.\n1|import Foundation\n2|import NetworkExtension\n3|import ReluxTunnelCore\n4|import ReluxTunnelLibSSH2Adapter\n5|\n6|/// The packet-tunnel extension's pinned, extension-safe SSH provider graph.\n7|public enum MacOSProviderSSHConfiguration {\n8|  public static func makeTransportFactory(\n9|    maximumTransportBufferBytes: Int = 256 * 1_024\n10|  ) -> any SSHTransportFactory {\n11|    LibSSH2TransportFactory(maximumTransportBufferBytes: maximumTransportBufferBytes)\n12|  }\n13|\n14|  /// Provider-owned read-only credential source. Concrete format identifiers\n15|  /// remain fail-closed until the separately reviewed key-format registry lands.\n16|  public static func makeCredentialProvider() -> any SSHCredentialProvider {\n17|    MacOSSystemKeychainCredentialResolver()\n18|  }\n19|\n20|  /// The sole production host-key policy composition. It is always bound to\n21|  /// one immutable validated snapshot and the selected adapter capabilities.\n22|  public static func makeHostKeyPolicy(\n23|    snapshot: SSHProfileSnapshotV1\n24|  ) throws -> any SSHHostKeyPolicy {\n25|    let capabilities = LibSSH2TransportFactory().capabilities\n26|    return try SSHApprovedHostIdentityPolicy(\n27|      snapshot: snapshot,\n28|      adapterHostKeyAlgorithms: capabilities.hostKeyAlgorithms\n29|    )\n30|  }\n31|\n32|  static func makeCredentialProvider(\n33|    securityClient: any MacOSSystemKeychainSecurityClient,\n34|    formatRegistry: any MacOSCredentialFormatRegistry,\n35|    lifecycleObserver: any MacOSCredentialSecretLifecycleObserver =\n36|      NullMacOSCredentialSecretLifecycleObserver()\n37|  ) -> any SSHCredentialProvider {\n38|    MacOSSystemKeychainCredentialResolver(\n39|      securityClient: securityClient,\n40|      formatRegistry: formatRegistry,\n41|      lifecycleObserver: lifecycleObserver\n42|    )\n43|  }\n44|}\n45|\n46|/// Public-API adapter for the macOS provider's `NEPacketTunnelFlow`.\n47|public final class MacOSPacketFlowAdapter: PacketFlow, @unchecked Sendable {\n48|  private let boundary: PacketFlowAdapterBoundary\n49|\n50|  public init(packetFlow: NEPacketTunnelFlow) {\n51|    boundary = PacketFlowAdapterBoundary(\n52|      driver: MacOSNEPacketFlowDriver(packetFlow: packetFlow)\n53|    )\n54|  }\n55|\n56|  public init(driver: any PacketFlowPlatformDriver) {\n57|    boundary = PacketFlowAdapterBoundary(driver: driver)\n58|  }\n59|\n60|  public func readPackets() async throws -> PacketReadBatch {\n61|    try await boundary.readPackets()\n62|  }\n63|\n64|  public func writePackets(_ packets: [TunnelPacket]) async throws {\n65|    try boundary.writePackets(packets)\n66|  }\n67|\n68|  public func shutdown() async {\n69|    boundary.shutDown()\n70|  }\n71|}\n72|\n73|private final class MacOSNEPacketFlowDriver: PacketFlowPlatformDriver, @unchecked Sendable {\n74|  private let packetFlow: NEPacketTunnelFlow\n75|\n76|  init(packetFlow: NEPacketTunnelFlow) {\n77|    self.packetFlow = packetFlow\n78|  }\n79|\n80|  func registerRead(\n81|    _ callback: @escaping @Sendable ([Data], [Int32]) -> Void\n82|  ) {\n83|    packetFlow.readPackets { packets, protocols in\n84|      callback(packets, protocols.map(\\.int32Value))\n85|    }\n86|  }\n87|\n88|  func writePackets(_ packets: [Data], protocols: [Int32]) -> Bool {\n89|    packetFlow.writePackets(\n90|      packets,\n91|      withProtocols: protocols.map { NSNumber(value: $0) }\n92|    )\n93|  }\n94|}\n95|\n96|/// Thin macOS composition root. The concrete provider subclass is a later task.\n97|public struct MacOSProviderCompositionRoot: TunnelProviderLifecycle {\n98|  private let adapter: TunnelProviderAdapter\n99|\n100|  public init(\n101|    packetFlow: any PacketFlow,\n102|    runtimeFactory: any TunnelRuntimeFactory,\n103|    dependencies: TunnelRuntimeDependencies\n104|  ) {\n105|    adapter = TunnelProviderAdapter(\n106|      packetFlow: packetFlow,\n107|      runtimeFactory: runtimeFactory,\n108|      dependencies: dependencies\n109|    )\n110|  }\n111|\n112|  public init(\n113|    packetFlow: any PacketFlow,\n114|    runtimeFactory: any TunnelRuntimeFactory,\n115|    dependencies: TunnelRuntimeDependencies,\n116|    snapshotSource: any ProviderRuntimeSnapshotSource,\n117|    diagnosticsSource: any ProviderDiagnosticsSnapshotSource,\n118|    lifecycleDiagnostics: (any ProviderLifecycleDiagnosticsSink)? = nil,\n119|    startBudget: Duration = .seconds(60),\n120|    cleanupBudget: Duration = .seconds(10)\n121|  ) {\n122|    adapter = TunnelProviderAdapter(\n123|      packetFlow: packetFlow,\n124|      runtimeFactory: runtimeFactory,\n125|      dependencies: dependencies,\n126|      snapshotSource: snapshotSource,\n127|      diagnosticsSource: diagnosticsSource,\n128|      lifecycleDiagnostics: lifecycleDiagnostics,\n129|      startBudget: startBudget,\n130|      cleanupBudget: cleanupBudget\n131|    )\n132|  }\n133|\n134|  public init(\n135|    packetTunnelFlow: NEPacketTunnelFlow,\n136|    runtimeFactory: any TunnelRuntimeFactory,\n137|    dependencies: TunnelRuntimeDependencies\n138|  ) {\n139|    self.init(\n140|      packetFlow: MacOSPacketFlowAdapter(packetFlow: packetTunnelFlow),\n141|      runtimeFactory: runtimeFactory,\n142|      dependencies: dependencies\n143|    )\n144|  }\n145|\n146|  public func start(configuration: TunnelConfiguration) async throws {\n147|    try await adapter.start(configuration: configuration)\n148|  }\n149|\n150|  public func stop(reason: ProviderStopReason) async {\n151|    await adapter.stop(reason: reason)\n152|  }\n153|\n154|  public func handleAppMessage(_ message: Data) async throws -> Data {\n155|    try await adapter.handleAppMessage(message)\n156|  }\n157|\n158|  public func lifecyclePhase() async -> ProviderLifecyclePhase {\n159|    await adapter.lifecyclePhase()\n160|  }\n161|\n162|  public func start(\n163|    configuration: TunnelConfiguration,\n164|    completionHandler: @escaping ProviderStartCompletionHandler\n165|  ) {\n166|    adapter.start(configuration: configuration, completionHandler: completionHandler)\n167|  }\n168|\n169|  public func stop(\n170|    rawReason: Int,\n171|    completionHandler: @escaping ProviderStopCompletionHandler\n172|  ) {\n173|    adapter.stop(rawReason: rawReason, completionHandler: completionHandler)\n174|  }\n175|\n176|  public func handleAppMessage(\n177|    _ message: Data,\n178|    responseHandler: ProviderMessageResponseHandler?\n179|  ) {\n180|    adapter.handleAppMessage(message, responseHandler: responseHandler)\n181|  }\n182|\n183|  public func providerDidFail(\n184|    _ errorCode: ProviderNSErrorCode,\n185|    cancelTunnelWithError: @escaping ProviderCancelTunnelHandler\n186|  ) {\n187|    adapter.providerDidFail(errorCode, cancelTunnelWithError: cancelTunnelWithError)\n188|  }\n189|}","final_result":true}}}
