   856	  private func handleAutomaticKeepaliveFailure(
   857	    _ error: Error,
   858	    policy: SSHKeepalivePolicy
   859	  ) async -> Bool {
   860	    guard state == .ready else { return false }
   861	    consecutiveKeepaliveFailures += 1
