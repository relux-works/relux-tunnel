   533	  private func setPreference(_ method: Int32, _ values: [String]) throws {
   534	    guard let engineSession else { return }
   535	    let preference = values.joined(separator: ",")
   536	    let result = preference.withCString { libssh2_session_method_pref(engineSession, method, $0) }
   537	    guard result == 0 else {
   538	      throw engineError(result, phase: .configuration, fallback: .algorithmNegotiationFailed)
   539	    }
