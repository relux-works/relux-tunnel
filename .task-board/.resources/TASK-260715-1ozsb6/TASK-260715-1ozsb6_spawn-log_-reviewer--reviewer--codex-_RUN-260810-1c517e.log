  2224	  private func recordHostDecision(_ decision: SSHHostKeyDecision) async {
  2225	    switch decision.outcome {
  2226	    case .firstUseAccepted:
  2227	      counters.hostFirstUseAccepted += 1
  2228	      await metric(.increment(.hostFirstUseAccepted, by: 1))
  2229	    case .matchAccepted:
  2230	      counters.hostMatchAccepted += 1
  2231	      await metric(.increment(.hostMatchAccepted, by: 1))
  2232	    case .unknownRejected:
  2233	      counters.hostUnknownRejected += 1
  2234	      await metric(.increment(.hostUnknownRejected, by: 1))
  2235	    case .changedRejected:
  2236	      counters.hostChangedRejected += 1
  2237	      await metric(.increment(.hostChangedRejected, by: 1))
  2238	    case .algorithmRejected:
  2239	      counters.hostAlgorithmRejected += 1
  2240	      await metric(.increment(.hostAlgorithmRejected, by: 1))
  2241	    case .policyRejected:
  2242	      break
  2243	    }
  2244	    await emit(.hostDecision(decision.outcome))
  2245	  }
  2435	    }
  2436	  }
