+    )
+    #expect(report.rows.count == 36)
+    #expect(Set(report.rows.map(\.mtu)) == [1_500, 4_096, 8_500])
+    #expect(Set(report.rows.map(\.family)) == Set(MTUMatrixFamily.allCases))
+    #expect(Set(report.rows.map(\.pressure)) == Set(MTUMatrixPressure.allCases))
+    #expect(report.rows.filter { $0.pressure == .nominal || $0.pressure == .mixed }.allSatisfy { $0.drops == 0 })
+    #expect(report.rows.filter { $0.pressure == .constrainedBuffer || $0.pressure == .receiverStall }.allSatisfy { $0.drops > 0 })
+    #expect(report.rows.allSatisfy { $0.recoveryProbeSucceeded })
+    #expect(report.rows.allSatisfy { $0.descriptorDelta == 0 && $0.taskDelta == 0 })
+    #expect(report.gaps.contains { $0.row == "NAT64" && $0.status == "unavailable" })
+    #expect(report.gaps.contains { $0.row == "iPhone physical matrix" && $0.status == "deferred-unavailable" })
+  }
