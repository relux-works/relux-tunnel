      return RuntimeDiagnosticsSnapshot(
        requestID: requestID,
        runtimeGeneration: state.runtimeGeneration,
        snapshotSequence: sequence,
        counters: state.counters,
        gauges: state.gauges,
        histograms: [
          "dns_latency_milliseconds": RuntimeDiagnosticHistogram(
