+        except OSError as error:
+            raise AssetManifestError("relay asset bundle publication failed") from error
+        if event_hook is not None:
+            event_hook("after_publish", bundle)
+        return
+    if not stat.S_ISDIR(existing_status.st_mode) or stat.S_ISLNK(
+        existing_status.st_mode
+    ):
+        raise AssetManifestError("relay asset bundle destination is unsafe")
+
+    displaced_identity = (existing_status.st_dev, existing_status.st_ino)
+    atomic_exchange(staging, bundle)
+    try:
+        fsync_directory(parent)
+        if event_hook is not None:
+            event_hook("after_exchange", bundle)
+    finally:
+        remove_owned_directory(staging, displaced_identity)
+        fsync_directory(parent)
+
+
