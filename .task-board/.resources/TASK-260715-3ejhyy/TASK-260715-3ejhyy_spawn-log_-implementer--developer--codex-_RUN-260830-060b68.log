    70	public final class SignalHarnessCancellationSource: HarnessCancellationSource, @unchecked Sendable {
    71	  private let source: StreamHarnessCancellationSource
    72	  private let signalSources: [DispatchSourceSignal]
    73	
    74	  public init() {
    75	    source = StreamHarnessCancellationSource()
    76	    Darwin.signal(SIGINT, SIG_IGN)
    77	    Darwin.signal(SIGTERM, SIG_IGN)
    78	
    79	    let interrupt = DispatchSource.makeSignalSource(signal: SIGINT, queue: .global())
    80	    let terminate = DispatchSource.makeSignalSource(signal: SIGTERM, queue: .global())
    81	    interrupt.setEventHandler { [source] in
    82	      source.cancel(reason: .interrupt)
    83	    }
    84	    terminate.setEventHandler { [source] in
    85	      source.cancel(reason: .terminate)
    86	    }
    87	    interrupt.resume()
    88	    terminate.resume()
    89	    signalSources = [interrupt, terminate]
    90	  }
    91	
    92	  deinit {
    93	    for signalSource in signalSources {
    94	      signalSource.cancel()
    95	    }
    96	  }
    97	
    98	  public func waitForCancellation() async -> HarnessCancellationReason {
    99	    await source.waitForCancellation()
   100	  }
   101	}
