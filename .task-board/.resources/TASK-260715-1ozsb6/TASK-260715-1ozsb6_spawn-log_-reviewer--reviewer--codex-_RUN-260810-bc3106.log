  2461	private final class LibSSH2TimeoutRace<Value: Sendable>: LibSSH2OwnedAsyncOperation,
  2462	  @unchecked Sendable
  2463	{
  2464	  enum Child {
  2465	    case operation
  2466	    case timer
  2467	  }
  2468	
  2469	  let identifier = UUID()
  2470	
  2471	  private let lock = NSLock()
  2472	  private weak var registry: LibSSH2OwnedAsyncOperationRegistry?
  2473	  private let timeout: Duration
  2474	  private let clock: any TunnelClock
  2475	  private let operation: @Sendable () async throws -> Value
  2476	  private var operationTask: Task<Void, Never>?
  2477	  private var timerTask: Task<Void, Never>?
  2478	  private var continuation: CheckedContinuation<Value, Error>?
  2479	  private var result: Result<Value, Error>?
  2480	  private var completedChildren = 0
  2481	  private var started = false
  2482	
  2483	  init(
  2484	    timeout: Duration,
  2485	    clock: any TunnelClock,
  2486	    registry: LibSSH2OwnedAsyncOperationRegistry,
  2487	    operation: @escaping @Sendable () async throws -> Value
  2488	  ) {
  2489	    self.timeout = timeout
  2490	    self.clock = clock
  2491	    self.registry = registry
  2492	    self.operation = operation
  2493	  }
  2494	
  2495	  func start() {
  2496	    let cancellationRequested = lock.withLock { () -> Bool in
  2497	      precondition(!started)
  2498	      started = true
  2499	      operationTask = Task {
  2500	        let outcome: Result<Value, Error>
  2501	        do {
  2502	          outcome = .success(try await self.operation())
  2503	        } catch {
  2504	          outcome = .failure(error)
  2505	        }
  2506	        self.childCompleted(.operation, outcome: outcome)
  2507	      }
  2508	      timerTask = Task {
  2509	        let outcome: Result<Value, Error>
  2510	        do {
  2511	          try await self.clock.sleep(for: self.timeout)
  2512	          outcome = .failure(LibSSH2TimeoutError.elapsed)
  2513	        } catch {
  2514	          outcome = .failure(error)
  2515	        }
  2516	        self.childCompleted(.timer, outcome: outcome)
  2517	      }
  2518	      return result != nil
  2519	    }
  2520	    if cancellationRequested { cancelTasks() }
  2521	  }
  2522	
  2523	  func wait() async throws -> Value {
  2524	    try await withTaskCancellationHandler {
  2525	      try Task.checkCancellation()
  2526	      return try await withCheckedThrowingContinuation { continuation in
  2527	        let immediate: Result<Value, Error>? = lock.withLock {
  2528	          if Task.isCancelled { return .failure(CancellationError()) }
  2529	          if let result { return result }
  2530	          self.continuation = continuation
  2531	          return nil
  2532	        }
  2533	        if let immediate { continuation.resume(with: immediate) }
  2534	      }
  2535	    } onCancel: {
  2536	      self.cancel()
  2537	    }
  2538	  }
  2539	
  2540	  func cancel() {
  2541	    completeCallerIfNeeded(with: .failure(CancellationError()))
  2542	    cancelTasks()
  2543	  }
  2544	
  2545	  private func childCompleted(_ child: Child, outcome: Result<Value, Error>) {
  2546	    let action = lock.withLock {
  2547	      completedChildren += 1
  2548	      let continuation: CheckedContinuation<Value, Error>?
  2549	      let won = result == nil
  2550	      if won {
  2551	        result = outcome
  2552	        continuation = self.continuation
  2553	        self.continuation = nil
  2554	      } else {
  2555	        continuation = nil
  2556	      }
  2557	      return (continuation, won, completedChildren == 2)
  2558	    }
  2559	    action.0?.resume(with: outcome)
  2560	    if action.1 {
  2561	      switch child {
  2562	      case .operation: timerTask?.cancel()
  2563	      case .timer: operationTask?.cancel()
  2564	      }
  2565	    }
  2566	    if action.2 { registry?.remove(identifier: identifier) }
  2567	  }
  2568	
  2569	  private func completeCallerIfNeeded(with outcome: Result<Value, Error>) {
  2570	    let continuation: CheckedContinuation<Value, Error>? = lock.withLock {
  2571	      guard result == nil else { return nil }
  2572	      result = outcome
  2573	      defer { self.continuation = nil }
  2574	      return self.continuation
  2575	    }
  2576	    continuation?.resume(with: outcome)
  2577	  }
  2578	
  2579	  private func cancelTasks() {
  2580	    let tasks = lock.withLock { (operationTask, timerTask) }
  2581	    tasks.0?.cancel()
  2582	    tasks.1?.cancel()
  2583	  }
  2584	}
  2585	
  2586	private func withTimeout<Value: Sendable>(
  2587	  _ timeout: Duration,
  2588	  clock: any TunnelClock,
  2589	  registry: LibSSH2OwnedAsyncOperationRegistry,
  2590	  operation: @escaping @Sendable () async throws -> Value
  2591	) async throws -> Value {
  2592	  let race = LibSSH2TimeoutRace(
  2593	    timeout: timeout,
  2594	    clock: clock,
  2595	    registry: registry,
  2596	    operation: operation
  2597	  )
  2598	  try registry.register(race)
  2599	  race.start()
  2600	  return try await race.wait()
  2601	}
