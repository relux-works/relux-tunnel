new file mode 100644
index 0000000..acb10b7
--- /dev/null
+++ b/docs/macos-self-update-integration.md
@@ -0,0 +1,42 @@
+# macOS self-update integration
+
+`ReluxProxyMac` embeds exact Sparkle 2.9.4 through the official remote Swift
+Package Manager product. `.package.resolved` pins tag `2.9.4` to commit
+`b6496a74a087257ef5e6da1c5b29a447a60f5bd7`. Sparkle is not a dependency of
+the packet-tunnel system extension, shared core, harness, or any iOS target.
+
+The host retains one `SPUStandardUpdaterController` for the application
+lifetime. Its production initializer validates that `SUFeedURL` is an HTTPS URL
+without credentials, query parameters, or a fragment before constructing the
+controller. Tests construct the real controller with `startingUpdater: false`;
+the smoke does not start a network check or install an update.
+
+The plist requires signed feed and pre-extraction payload verification, never
+expires signed-feed failures, disables automatic installation and profiling,
+and enables only Sparkle's Installer launcher service. The sandboxed host keeps
+the approved `-spks` and `-spki` Mach lookup exceptions and network-client
+entitlement. Downloader, Installer Connection, and Installer Status services
+remain disabled. Sparkle does not alter the packet-tunnel provider entitlements.
+Hardened Runtime remains enabled for the host and provider targets.
+
+Run the deterministic credential-free build and lifecycle smoke with:
+
+```bash
+make sparkle-integration-validate
+```
+
+The gate performs an unsigned Release build, checks the resolved dependency,
+embedded framework/helper layout, plist, license, linkage, target boundary,
+entitlements, and Release build settings, then ad-hoc signs the built host and
+provider with Hardened Runtime for structural `codesign --verify --deep
+--strict` evidence. Ad-hoc signing proves the credential-free nested-code shape;
+it is not Developer ID, notarization, stapling, or physical installation
+evidence.
+
+Before a physical update installation, the host must request an orderly tunnel
+stop and wait for the system-authoritative inactive state. After Sparkle replaces
+and relaunches the host, the app must separately request activation or
+replacement of the embedded Network Extension system extension, surface pending
+approval/failure/restart-required state, and avoid automatic VPN reconnect.
+Those behaviors were not exercised by this integration smoke and remain owned
+by the downstream physical-validation tasks.
diff --git a/scripts/validate-sparkle-integration.sh b/scripts/validate-sparkle-integration.sh
new file mode 100755
index 0000000..0809346
--- /dev/null
+++ b/scripts/validate-sparkle-integration.sh
@@ -0,0 +1,146 @@
+#!/bin/sh
+set -eu
+
+repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
+output=${1:-"$repo_root/.temp/TASK-260717-xempiv/sparkle-smoke"}
+
+case "$output" in
+  /*) ;;
+  *) output="$repo_root/$output" ;;
+esac
+
+if [ -e "$output" ]; then
+  printf 'error: output already exists: %s\n' "$output" >&2
+  exit 2
+fi
+
+mkdir -p "$output/Products" "$output/Intermediates" "$output/DerivedData"
+cd "$repo_root"
+
+./scripts/generate-workspace.sh --clean > "$output/workspace-generate.log" 2>&1
+
+xcodebuild \
+  -workspace ReluxTunnel.xcworkspace \
+  -scheme ReluxProxyMac \
+  -configuration Release \
+  -destination 'generic/platform=macOS' \
+  -derivedDataPath "$output/DerivedData" \
+  CODE_SIGNING_ALLOWED=NO \
+  CODE_SIGNING_REQUIRED=NO \
+  SYMROOT="$output/Products" \
+  OBJROOT="$output/Intermediates" \
+  build > "$output/release-build.log" 2>&1
+
+app="$output/Products/Release/ReluxProxyMac.app"
+host_binary="$app/Contents/MacOS/ReluxProxyMac"
+provider="$app/Contents/Library/SystemExtensions/works.relux.tunnel.mac.tunnel.systemextension"
+provider_binary="$provider/Contents/MacOS/works.relux.tunnel.mac.tunnel"
+sparkle="$app/Contents/Frameworks/Sparkle.framework"
+installer="$sparkle/Versions/B/XPCServices/Installer.xpc"
+downloader="$sparkle/Versions/B/XPCServices/Downloader.xpc"
+info="$app/Contents/Info.plist"
+
+test -x "$host_binary"
+test -x "$provider_binary"
+test -d "$sparkle"
+test -d "$installer"
+test -d "$downloader"
+test -f "$app/Contents/Resources/LICENSE"
+
+test "$(plutil -extract SUFeedURL raw "$info")" = \
+  'https://updates.relux.works/macos/appcast.xml'
+public_key=$(plutil -extract SUPublicEDKey raw "$info")
+test "$public_key" = 'tx8SLAmqME/ldUthxRV5PFQiUt1MX65blT29cA8My1U='
+test "$(printf '%s' "$public_key" | base64 --decode | wc -c | tr -d ' ')" -eq 32
+test "$(plutil -extract SURequireSignedFeed raw "$info")" = true
+test "$(plutil -extract SUVerifyUpdateBeforeExtraction raw "$info")" = true
+test "$(plutil -extract SUSignedFeedFailureExpirationInterval raw "$info")" = 0
+test "$(plutil -extract SUEnableInstallerLauncherService raw "$info")" = true
+for key in \
+  SUEnableDownloaderService \
+  SUEnableInstallerConnectionService \
+  SUEnableInstallerStatusService \
+  SUAllowsAutomaticUpdates \
+  SUAutomaticallyUpdate \
+  SUEnableSystemProfiling \
+  SUEnableJavaScript; do
+  test "$(plutil -extract "$key" raw "$info")" = false
+done
+
+test "$(shasum -a 256 "$app/Contents/Resources/LICENSE" | awk '{print $1}')" = \
+  '389a4e4e9a32f059775b13a06e25a591445ba229d2838d26dd3e7c0c45127cfe'
+test "$(plutil -extract pins.0.state.version raw .package.resolved)" = '2.9.4'
+test "$(plutil -extract pins.0.state.revision raw .package.resolved)" = \
+  'b6496a74a087257ef5e6da1c5b29a447a60f5bd7'
+
+otool -L "$host_binary" > "$output/host-linkage.log"
+grep -F '@rpath/Sparkle.framework/Versions/B/Sparkle' "$output/host-linkage.log" >/dev/null
+otool -L "$provider_binary" > "$output/provider-linkage.log"
+if grep -F 'Sparkle.framework' "$output/provider-linkage.log" >/dev/null; then
+  printf 'error: Sparkle leaked into the Installer XPC-isolated provider boundary\n' >&2
+  exit 1
+fi
+if find "$provider" -iname '*sparkle*' -o -iname '*installer.xpc' -o -iname '*downloader.xpc' | grep -q .; then
+  printf 'error: updater code leaked into the packet-tunnel system extension\n' >&2
+  exit 1
+fi
+
+xcodebuild \
+  -workspace ReluxTunnel.xcworkspace \
+  -scheme ReluxProxyMac \
+  -configuration Release \
+  -destination 'generic/platform=macOS' \
+  -showBuildSettings > "$output/release-build-settings.log" 2>&1
+grep -F 'ENABLE_HARDENED_RUNTIME = YES' "$output/release-build-settings.log" >/dev/null
+grep -F \
+  'CODE_SIGN_ENTITLEMENTS = Configuration/Entitlements/ReluxProxyMac-Development.entitlements' \
+  "$output/release-build-settings.log" >/dev/null
+
+expanded_host_entitlements="$output/ReluxProxyMac-expanded.entitlements"
+cp Configuration/Entitlements/ReluxProxyMac-Development.entitlements \
+  "$expanded_host_entitlements"
+/usr/libexec/PlistBuddy -c \
+  'Set :com.apple.security.temporary-exception.mach-lookup.global-name:0 works.relux.tunnel.mac-spks' \
+  "$expanded_host_entitlements"
+/usr/libexec/PlistBuddy -c \
+  'Set :com.apple.security.temporary-exception.mach-lookup.global-name:1 works.relux.tunnel.mac-spki' \
+  "$expanded_host_entitlements"
+
+updater="$sparkle/Versions/B/Updater.app"
+autoupdate="$sparkle/Versions/B/Autoupdate"
+for component in installer downloader updater; do
+  case "$component" in
+    installer) component_path=$installer ;;
+    downloader) component_path=$downloader ;;
+    updater) component_path=$updater ;;
+  esac
+  component_entitlements="$output/Sparkle-$component.entitlements"
+  codesign -d --entitlements :- "$component_path" > "$component_entitlements" 2>/dev/null
+  plutil -lint "$component_entitlements" >/dev/null
+  codesign --force --sign - --options runtime --timestamp=none \
+    --entitlements "$component_entitlements" "$component_path" \
+    > "$output/Sparkle-$component-adhoc-sign.log" 2>&1
+done
+codesign --force --sign - --options runtime --timestamp=none "$autoupdate" \
+  > "$output/Sparkle-autoupdate-adhoc-sign.log" 2>&1
+codesign --force --sign - --options runtime --timestamp=none "$sparkle" \
+  > "$output/Sparkle-framework-adhoc-sign.log" 2>&1
+
+codesign --force --sign - --options runtime --timestamp=none \
+  --entitlements Configuration/Entitlements/ReluxProxyMacTunnel-Development.entitlements \
+  "$provider" > "$output/provider-adhoc-sign.log" 2>&1
+codesign --force --sign - --options runtime --timestamp=none \
+  --entitlements "$expanded_host_entitlements" \
+  "$app" > "$output/host-adhoc-sign.log" 2>&1
+codesign --verify --deep --strict --verbose=4 "$app" \
+  > "$output/codesign-verify.log" 2>&1
+codesign -dv --verbose=4 "$app" > "$output/host-signature.log" 2>&1
+codesign -dv --verbose=4 "$provider" > "$output/provider-signature.log" 2>&1
+grep -E 'flags=.*runtime' "$output/host-signature.log" >/dev/null
+grep -E 'flags=.*runtime' "$output/provider-signature.log" >/dev/null
+
+codesign -d --entitlements :- "$app" > "$output/host-entitlements.plist" 2>/dev/null
+codesign -d --entitlements :- "$provider" > "$output/provider-entitlements.plist" 2>/dev/null
+plutil -lint "$output/host-entitlements.plist" "$output/provider-entitlements.plist" >/dev/null
+
+printf 'Sparkle integration validation passed: %s\n' "$output"
