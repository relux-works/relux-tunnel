   209	def sha256_file(path: Path) -> str:
   210	    digest = hashlib.sha256()
   211	    try:
   212	        with path.open("rb") as stream:
   213	            for chunk in iter(lambda: stream.read(1024 * 1024), b""):
   214	                digest.update(chunk)
   215	    except OSError as error:
   216	        raise SupplyChainError(f"required file is unavailable: {path.name}") from error
   217	    return digest.hexdigest()
