            "SHA256:/Users/alice/.ssh/id_ed25519",
            "SHA256:192.0.2.10",
            "SHA256:credential-reference-private",
        )
        for fingerprint in invalid_fingerprints:
            with self.subTest(fingerprint=fingerprint):
                observation = RecordingMatrixInvoker(
