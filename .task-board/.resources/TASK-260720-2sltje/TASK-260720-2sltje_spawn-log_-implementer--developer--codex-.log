+    elapsed = monotonic_milliseconds() - started;
+    if(rc || reply == LIBSSH2_GLOBAL_REQUEST_REPLY_NONE || elapsed < 20 ||
+       elapsed > 5000)
+        return 1;
+
+    rc = run_global_request(
+        session, socket_fd, other_name, payload, sizeof(payload),
