+  private struct Sleep {
+    let deadline: ContinuousClock.Instant
+    let continuation: CheckedContinuation<Void, any Error>
+  }
+
+  private struct State {
+    var instant = ContinuousClock().now
+    var sleeps: [UUID: Sleep] = [:]
+  }
