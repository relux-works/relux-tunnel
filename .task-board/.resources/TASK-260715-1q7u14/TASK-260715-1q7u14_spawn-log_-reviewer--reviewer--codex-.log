   578	private func resolvedLimit(_ reference: String, vectorID: String) throws -> UInt64 {
   579	  let parts = reference.split(separator: ".", maxSplits: 1).map(String.init)
   580	  guard
   581	    parts.count == 2,
   582	    let spec = RelayProtocolV1.limits.first(where: { $0.name == parts[0] })
   583	  else {
   584	    throw RelayVectorHarnessFailure(vectorID: vectorID, reason: "invalid limit reference")
   585	  }
   586	  switch parts[1] {
   587	  case "floor": return spec.floor
   588	  case "clientDefault": return spec.clientDefault
   589	  case "relayDefault": return spec.relayDefault
   590	  case "clientHardCeiling": return spec.clientHardCeiling
   591	  case "relayHardCeiling": return spec.relayHardCeiling
   592	  default:
   593	    throw RelayVectorHarnessFailure(vectorID: vectorID, reason: "invalid limit selector")
   594	  }
   595	}
