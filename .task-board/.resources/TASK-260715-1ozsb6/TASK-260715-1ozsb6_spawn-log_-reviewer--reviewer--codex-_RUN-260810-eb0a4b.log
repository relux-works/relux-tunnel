   688	  private func setPreference(_ method: Int32, _ values: [String]) throws {
   689	    guard let engineSession else { return }
   690	    let preference = values.joined(separator: ",")
   691	    let result = preference.withCString { libssh2_session_method_pref(engineSession, method, $0) }
   692	    guard result == 0 else {
   693	      throw engineError(result, phase: .configuration, fallback: .algorithmNegotiationFailed)
   694	    }
