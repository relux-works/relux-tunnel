+    let userSentinel = "user-sentinel"
+    var publicErrors: [SSHTransportError] = []
+    var snapshots: [SSHTransportSnapshot] = []
+    let rejectedUserTransport =
+      try await LibSSH2TransportFactory(maximumTransportBufferBytes: 64 * 1_024)
