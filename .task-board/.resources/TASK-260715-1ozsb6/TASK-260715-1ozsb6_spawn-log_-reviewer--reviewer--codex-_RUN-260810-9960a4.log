   313	      policy: fixtureChannelPolicy()
   314	    )
   315	    async let second = transport.openExecChannel(
   316	      request: SSHExecRequest(command: "printf second"),
   317	      policy: fixtureChannelPolicy()
   318	    )
   319	    let (firstChannel, secondChannel) = try await (first, second)
   320	    async let firstOutput = readAll(firstChannel)
   321	    async let secondOutput = readAll(secondChannel)
   322	    let outputs = try await (firstOutput, secondOutput)
   323	    #expect(outputs.0 == Data("first".utf8))
   324	    #expect(outputs.1 == Data("second".utf8))
   325	    #expect(try await firstChannel.waitForExit() == .notReported)
   326	    #expect(try await secondChannel.waitForExit() == .notReported)
   327	    await firstChannel.close()
   328	    await secondChannel.close()
