   274	def stream_source(
   275	    output: BinaryIO, total_bytes: int, seed: str, block_bytes: int = DEFAULT_BLOCK_BYTES
   276	) -> tuple[int, str]:
   277	    block = deterministic_block(seed, block_bytes)
   278	    digest = hashlib.sha256()
   279	    written = 0
   280	    while written < total_bytes:
   281	        chunk = block[: min(total_bytes - written, len(block))]
   282	        output.write(chunk)
   283	        digest.update(chunk)
   284	        written += len(chunk)
   285	    return written, f"SHA256:{digest.hexdigest()}"
