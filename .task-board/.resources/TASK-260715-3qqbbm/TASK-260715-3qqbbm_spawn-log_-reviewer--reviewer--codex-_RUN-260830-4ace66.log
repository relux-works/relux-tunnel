 apple-ui-test-contract:
 	python3 scripts/check-apple-ui-test-contract.py
 	python3 -m unittest -v scripts.tests.test_extract_apple_ui_test_artifacts scripts.tests.test_validate_apple_ui_test_artifacts
 	./scripts/tests/test-apple-ui-test-smoke-extractor-failure.sh
 	swift test --filter ReluxAppleUITestSharedTests
 	swift test --filter SnapshotDiffSupportTests
 
 apple-ui-test-smoke:
 	./scripts/run-apple-ui-test-smoke.sh
 
 check-legacy:
 	./scripts/check-legacy-preservation.sh --legacy-root "$(LEGACY_ROOT)"
 
 test-legacy-guard:
 	./scripts/tests/test-legacy-preservation-guard.sh --legacy-root "$(LEGACY_ROOT)"
 
+check-migration-isolation: check-legacy
+	python3 scripts/check-migration-isolation.py \
+		--legacy-root "$(LEGACY_ROOT)" \
+		--workspace-root .
+
+test-migration-isolation:
+	./scripts/tests/test-migration-isolation-guard.sh --legacy-root "$(LEGACY_ROOT)"
+
 check-core-boundaries:
 	./scripts/check-core-boundaries.sh
 
 core-build:
 	swift build
 
 core-test:
 	swift test
 
 check-native-dependencies:
 	./scripts/native-dependency-tool.py verify --dependency relux-native-fixture
 	python3 scripts/libssh2-fork-tool.py verify
 
 test-native-dependencies:
 	./scripts/tests/test-native-dependencies.sh
 
 native-apple-matrix:
 	./scripts/build-native-apple-matrix.sh
 
 validate-core: check-core-boundaries check-native-dependencies core-test core-build
     1	#!/bin/bash
     2	
     3	set -u
     4	
     5	SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
     6	PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd -P)"
     7	GUARD="$PROJECT_ROOT/scripts/check-migration-isolation.py"
     8	LEGACY_ROOT="${LEGACY_ROOT:-$PROJECT_ROOT/../relux-proxy}"
     9	FAILURES=0
    10	
    11	usage() {
    12	    echo "Usage: scripts/tests/test-migration-isolation-guard.sh [--legacy-root PATH]"
    13	}
    14	
    15	while [ "$#" -gt 0 ]; do
    16	    case "$1" in
    17	        --legacy-root)
    18	            [ "$#" -ge 2 ] || { echo "error: --legacy-root requires a path" >&2; exit 2; }
    19	            LEGACY_ROOT="$2"
    20	            shift 2
    21	            ;;
    22	        -h|--help)
    23	            usage
    24	            exit 0
    25	            ;;
    26	        *)
    27	            echo "error: unknown option: $1" >&2
    28	            usage >&2
    29	            exit 2
    30	            ;;
    31	    esac
    32	done
    33	
    34	if [ ! -d "$LEGACY_ROOT/.git" ]; then
    35	    echo "error: expected a legacy Git checkout at $LEGACY_ROOT" >&2
    36	    exit 2
    37	fi
    38	
    39	TEST_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/relux-migration-isolation.XXXXXX")"
    40	
    41	cleanup() {
    42	    case "$TEST_ROOT" in
    43	        "${TMPDIR:-/tmp}"/relux-migration-isolation.*)
    44	            chmod -R u+w "$TEST_ROOT" 2>/dev/null || true
    45	            rm -rf "$TEST_ROOT"
    46	            ;;
    47	        *)
    48	            echo "refusing to clean unexpected test path: $TEST_ROOT" >&2
    49	            ;;
    50	    esac
    51	}
    52	trap cleanup EXIT INT TERM
    53	
    54	legacy="$TEST_ROOT/legacy-v0.1.0"
    55	git clone --quiet --local --no-hardlinks "$LEGACY_ROOT" "$legacy"
    56	git -C "$legacy" checkout --quiet v0.1.0
    57	
    58	copy_workspace() {
    59	    destination="$1"
    60	    mkdir -p "$destination"
    61	    for relative in App config Configuration Sources .github scripts; do
    62	        cp -R "$PROJECT_ROOT/$relative" "$destination/$relative"
    63	    done
    64	    cp "$PROJECT_ROOT/Makefile" "$PROJECT_ROOT/Package.swift" \
    65	        "$PROJECT_ROOT/Project.swift" "$destination/"
    66	}
    67	
    68	expect_pass() {
    69	    name="$1"
    70	    legacy_root="$2"
    71	    workspace_root="$3"
    72	    log="$TEST_ROOT/$name.log"
    73	    if python3 "$GUARD" --legacy-root "$legacy_root" \
    74	        --workspace-root "$workspace_root" >"$log" 2>&1; then
    75	        echo "PASS: $name"
    76	    else
    77	        echo "FAIL: $name (expected success)" >&2
    78	        sed -n '1,220p' "$log" >&2
    79	        FAILURES=$((FAILURES + 1))
    80	    fi
    81	}
    82	
    83	expect_failure() {
    84	    name="$1"
    85	    expected="$2"
    86	    legacy_root="$3"
    87	    workspace_root="$4"
    88	    shift 4
    89	    log="$TEST_ROOT/$name.log"
    90	    if python3 "$GUARD" --legacy-root "$legacy_root" \
    91	        --workspace-root "$workspace_root" "$@" >"$log" 2>&1; then
    92	        echo "FAIL: $name (guard unexpectedly admitted the mutation)" >&2
    93	        FAILURES=$((FAILURES + 1))
    94	    elif ! grep -Fq -- "$expected" "$log"; then
    95	        echo "FAIL: $name rejected for the wrong reason" >&2
    96	        sed -n '1,220p' "$log" >&2
    97	        FAILURES=$((FAILURES + 1))
    98	    else
    99	        echo "PASS: $name rejected at the production isolation gate"
   100	    fi
   101	}
   102	
   103	baseline="$TEST_ROOT/workspace-baseline"
   104	copy_workspace "$baseline"
   105	expect_pass "baseline" "$legacy" "$baseline"
   106	
   107	cross_link="$TEST_ROOT/workspace-cross-link"
   108	copy_workspace "$cross_link"
   109	perl -0pi -e 's/\.package\(product: "ReluxTunnelCore"\)/.package(product: "ReluxProxy")/' \
   110	    "$cross_link/Project.swift"
   111	expect_failure "generated-cross-link" \
   112	    "generated target graph cross-links the legacy ReluxProxy product" \
   113	    "$legacy" "$cross_link"
   114	
   115	legacy_cross_link="$TEST_ROOT/legacy-cross-link"
   116	cp -R "$legacy" "$legacy_cross_link"
   117	perl -0pi -e 's/import PackageDescription/import PackageDescription\n\/\/ ReluxTunnelCore/' \
   118	    "$legacy_cross_link/Package.swift"
   119	expect_failure "legacy-cross-link" \
   120	    "legacy SwiftPM path cross-links generated runtime token ReluxTunnelCore" \
   121	    "$legacy_cross_link" "$baseline"
   122	
   123	identifier_collision="$TEST_ROOT/workspace-identifier-collision"
   124	copy_workspace "$identifier_collision"
   125	perl -0pi -e 's/works\.relux\.tunnel\.mac$/works.relux.proxy/m' \
   126	    "$identifier_collision/Configuration/Identity.xcconfig"
   127	expect_failure "identifier-collision" \
   128	    "generated identity drifted: RELUX_MACOS_HOST_BUNDLE_ID" \
   129	    "$legacy" "$identifier_collision"
   130	
   131	defaults_collision="$TEST_ROOT/workspace-defaults-collision"
   132	copy_workspace "$defaults_collision"
   133	perl -0pi -e 's/application\.run\(\)/\/\/ \@AppStorage("sshHost")\napplication.run()/' \
   134	    "$defaults_collision/App/ReluxProxyMac/Sources/main.swift"
   135	expect_failure "defaults-key-collision" \
   136	    "generated production source reuses legacy defaults key sshHost" \
   137	    "$legacy" "$defaults_collision"
   138	
   139	keychain_collision="$TEST_ROOT/workspace-keychain-collision"
   140	copy_workspace "$keychain_collision"
   141	perl -0pi -e 's/works\.relux\.tunnel\.credential\.v1/works.relux.proxy/' \
   142	    "$keychain_collision/Sources/ReluxTunnelMacOSAdapter/MacOSSystemKeychainCredentialResolver.swift"
   143	expect_failure "keychain-namespace-collision" \
   144	    "generated Keychain service namespace drifted" \
   145	    "$legacy" "$keychain_collision"
   146	
   147	release_substitution="$TEST_ROOT/workspace-release-substitution"
   148	copy_workspace "$release_substitution"
   149	perl -0pi -e 's/run: make credential-free-validate[^\n]*/run: cp candidate.dmg dist\/ReluxProxy.dmg/' \
   150	    "$release_substitution/.github/workflows/ci.yml"
   151	expect_failure "release-script-substitution" \
   152	    "generated release entry substitutes legacy artifact ReluxProxy.dmg" \
   153	    "$legacy" "$release_substitution"
   154	
   155	product_collision="$TEST_ROOT/generated-product-collision"
   156	mkdir -p "$product_collision/Debug/ReluxProxy.app"
   157	expect_failure "build-product-collision" \
   158	    "generated build products collide with legacy artifacts" \
   159	    "$legacy" "$baseline" --products-root "$product_collision"
   160	
   161	if [ "$FAILURES" -ne 0 ]; then
   162	    echo "Migration isolation guard tests failed: $FAILURES" >&2
   163	    exit 1
   164	fi
   165	
   166	echo "Migration isolation guard tests passed"

