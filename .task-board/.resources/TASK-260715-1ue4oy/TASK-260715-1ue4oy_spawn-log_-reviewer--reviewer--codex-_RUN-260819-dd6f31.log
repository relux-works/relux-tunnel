    59	    def write_archive(
    60	        self,
    61	        *,
    62	        names: list[str] | None = None,
    63	        contents: list[bytes] | None = None,
    64	        modes: list[int] | None = None,
    65	    ) -> None:
    66	        canonical_names = [
    67	            manifest_tool.canonical_archive_path(*target)
    68	            for target in manifest_tool.TARGETS
    69	        ]
    70	        payloads = [self.assets[target] for target in manifest_tool.TARGETS]
    71	        names = canonical_names if names is None else names
    72	        contents = payloads if contents is None else contents
    73	        modes = [0o755] * len(names) if modes is None else modes
    74	        tar_buffer = io.BytesIO()
    75	        with tarfile.open(
    76	            fileobj=tar_buffer, mode="w", format=tarfile.USTAR_FORMAT
    77	        ) as archive:
    78	            for name, content, mode in zip(names, contents, modes, strict=True):
    79	                member = tarfile.TarInfo(name)
    80	                member.size = len(content)
    81	                member.mode = mode
    82	                member.mtime = 0
    83	                archive.addfile(member, io.BytesIO(content))
    84	        with self.archive.open("wb") as destination:
    85	            with gzip.GzipFile(fileobj=destination, mode="wb", mtime=0) as compressed:
    86	                compressed.write(tar_buffer.getvalue())
    87
    88	    def write_pax_archive(self) -> None:
    89	        tar_buffer = io.BytesIO()
    90	        with tarfile.open(
    91	            fileobj=tar_buffer, mode="w", format=tarfile.PAX_FORMAT
    92	        ) as archive:
    93	            for index, target in enumerate(manifest_tool.TARGETS):
    94	                content = self.assets[target]
    95	                member = tarfile.TarInfo(manifest_tool.canonical_archive_path(*target))
    96	                member.size = len(content)
    97	                member.mode = 0o755
    98	                member.mtime = 0
    99	                if index == 0:
   100	                    member.pax_headers = {
   101	                        "comment": "x" * (manifest_tool.MAX_ARCHIVE_TRAILER_BYTES + 1)
   102	                    }
   103	                archive.addfile(member, io.BytesIO(content))
   104	        with self.archive.open("wb") as destination:
   105	            with gzip.GzipFile(fileobj=destination, mode="wb", mtime=0) as compressed:
   106	                compressed.write(tar_buffer.getvalue())
