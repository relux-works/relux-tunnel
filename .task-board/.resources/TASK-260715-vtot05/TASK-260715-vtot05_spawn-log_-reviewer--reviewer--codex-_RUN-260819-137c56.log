   420	def verify_schema(path: Path = DEFAULT_SCHEMA) -> None:
   421	    schema, _ = load_json(path, "relay asset manifest schema")
   422	    if (
   423	        schema.get("type") != "object"
   424	        or schema.get("additionalProperties") is not False
   425	        or set(schema.get("required", [])) != MANIFEST_KEYS
   426	        or set(schema.get("properties", {})) != MANIFEST_KEYS
   427	        or schema["properties"]["schemaVersion"].get("const") != SCHEMA_VERSION
   428	        or schema["properties"]["relayProtocolVersion"].get("const") != PROTOCOL_VERSION
   429	    ):
   430	        raise AssetManifestError("relay asset manifest schema root contract changed")
   431	    definitions = schema.get("$defs")
   432	    if not isinstance(definitions, dict) or set(definitions) != {
   433	        "asset",
   434	        "buildIdentity",
   435	        "buildProvenance",
   436	        "supplyChain",
   437	    }:
   438	        raise AssetManifestError("relay asset manifest schema definitions changed")
   439	    expected = {
   440	        "asset": MANIFEST_ASSET_KEYS,
   441	        "buildIdentity": IDENTITY_KEYS,
   442	        "buildProvenance": PROVENANCE_KEYS,
   443	        "supplyChain": SUPPLY_CHAIN_KEYS,
   444	    }
   445	    for name, keys in expected.items():
   446	        definition = definitions[name]
   447	        if (
   448	            definition.get("type") != "object"
   449	            or definition.get("additionalProperties") is not False
   450	            or set(definition.get("required", [])) != keys
   451	            or set(definition.get("properties", {})) != keys
   452	        ):
   453	            raise AssetManifestError(
   454	                f"relay asset manifest schema {name} contract changed"
   455	            )
