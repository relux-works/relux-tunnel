+  func armClose(closeEAGAINCount: Int, freeEAGAINCount: Int) {
+    state.withLock {
+      $0.closeEAGAINRemaining = closeEAGAINCount
+      $0.freeEAGAINRemaining = freeEAGAINCount
+    }
+  }
