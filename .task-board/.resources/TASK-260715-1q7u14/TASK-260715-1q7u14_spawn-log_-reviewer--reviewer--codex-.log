   659	  _ condition: @autoclosure () throws -> Bool,
   660	  _ vector: RelayProtocolVector,
   661	  _ reason: String
   662	) throws {
   663	  guard try condition() else {
   664	    throw RelayVectorHarnessFailure(vectorID: vector.id, reason: reason)
   665	  }
   666	}

