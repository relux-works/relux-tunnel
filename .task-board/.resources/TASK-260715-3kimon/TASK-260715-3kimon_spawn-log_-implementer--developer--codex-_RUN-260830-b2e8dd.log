+  ) -> MemoryLedgerAvailability {
+    guard case .available(let snapshot) = ledger else { return ledger }
+    guard snapshot.capturedAt <= now else { return .unavailable(.malformed) }
+    if snapshot.capturedAt.duration(to: now) > configuration.maximumEvidenceAge {
+      staleLedgerSampleCount = incrementSaturating(staleLedgerSampleCount)
+      return .unavailable(.stale)
+    }
+    let (total, overflow) = snapshot.currentBytes.addingReportingOverflow(snapshot.reservedBytes)
+    guard !overflow, snapshot.peakBytes >= snapshot.committedBytes,
+      snapshot.committedBytes >= snapshot.currentBytes,
+      snapshot.committedBytes >= snapshot.reservedBytes,
+      snapshot.committedBytes <= total
+    else { return .unavailable(.malformed) }
+    return ledger
+  }
+
+  private func nextState(
+    platform: MemoryPlatformSample,
+    ledger: MemoryLedgerAvailability,
+    warning: Bool,
+    actionsAcknowledged: Bool,
