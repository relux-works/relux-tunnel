    try await owner.channelRead(
      identity: identity,
      maximumBytes: maximumBytes,
      stream: Int32(SSH_EXTENDED_DATA_STDERR)
    )
  }

  public func waitForExit() async throws -> SSHExecExit {
    try await owner.channelExit(identity: identity)
  }
}

