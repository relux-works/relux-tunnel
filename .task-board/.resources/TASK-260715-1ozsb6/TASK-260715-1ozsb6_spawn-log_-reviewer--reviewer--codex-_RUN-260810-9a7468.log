  1931	  private func performTearDown() async {
  1932	    let ownedTasks = [
  1933	      automaticRekeyTask,
  1934	      automaticKeepaliveTask,
  1935	      byteRekeyTask,
  1936	      rekeyFlightTask,
  1937	    ].compactMap { $0 }
  1938	    for task in ownedTasks { task.cancel() }
  1939	    sessionOperationGate.cancelPending()
  1940	    context.network.beginShutdown()
  1941	    await connection?.close()
  1942	    for task in ownedTasks { await task.value }
  1943	    automaticRekeyTask = nil
  1944	    automaticKeepaliveTask = nil
  1945	    byteRekeyTask = nil
  1946	    rekeyFlightTask = nil
  1947	    rekeyFlightInProgress = false
  1948	    await waitForConnectToDrain()
  1949	    await context.network.drainServices()
  1950	    await context.cancelSignatureAndWait()
  1951	    // Once the socket is closed, consume only libssh2's retained callback
