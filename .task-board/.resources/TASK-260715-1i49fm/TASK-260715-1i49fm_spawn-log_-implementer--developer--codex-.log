   222	  @Test("generation reset rejects stale handles and preserves monotonic counters")
   223	  func generationsAndMonotonicity() async throws {
   224	    let store = RuntimeDiagnosticsStore(runtimeGeneration: 7)
   225	    let oldRecorder = store.recorder()
   226	    await oldRecorder.incrementCounter(named: "packet_bridge_start_total", by: 3)
   227	    await oldRecorder.incrementCounter(named: "packet_bridge_start_total", by: UInt64.max)
   228	    let oldSnapshot = try store.snapshot()
   229	    #expect(oldSnapshot.runtimeGeneration == 7)
   230	    #expect(oldSnapshot.snapshotSequence == 1)
   231	    #expect(oldSnapshot.counters["packet_bridge_start_total"] == UInt64.max)
   232	
   233	    let newRecorder = try store.beginGeneration(8)
   234	    await oldRecorder.incrementCounter(named: "packet_bridge_start_total", by: 100)
   235	    await newRecorder.incrementCounter(named: "packet_bridge_start_total", by: 2)
   236	    let first = try store.snapshot()
   237	    let second = try store.snapshot()
   238	    #expect(first.runtimeGeneration == 8)
   239	    #expect(first.snapshotSequence == 1)
   240	    #expect(second.snapshotSequence == 2)
   241	    #expect(first.counters["packet_bridge_start_total"] == 2)
   242	    #expect(second.counters["packet_bridge_start_total"] == 2)
   243	    #expect(throws: RuntimeDiagnosticsStoreError.generationMustIncrease(current: 8, proposed: 8)) {
   244	      try store.beginGeneration(8)
   245	    }
   246	    #expect(throws: RuntimeDiagnosticsStoreError.generationMustIncrease(current: 8, proposed: 7)) {
   247	      try store.beginGeneration(7)
   248	    }
   249	  }
