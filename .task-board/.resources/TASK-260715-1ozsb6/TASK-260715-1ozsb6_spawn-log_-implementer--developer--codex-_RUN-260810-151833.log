+      if (await transport.snapshot()).counters.keepalivesSent == 1 { break }
+      await Task.yield()
+    }
+    #expect((await transport.snapshot()).counters.keepalivesSent == 1)
+
+    clock.advance(by: .milliseconds(100))
+    for _ in 0..<500 {
