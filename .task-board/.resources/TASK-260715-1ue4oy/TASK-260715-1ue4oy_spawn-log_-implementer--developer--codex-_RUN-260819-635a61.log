work_root=$(mktemp -d "${TMPDIR:-/tmp}/relux-provider-graph.XXXXXX")
cleanup() {
  case "$work_root" in
    "${TMPDIR:-/tmp}"/relux-provider-graph.*) rm -rf "$work_root" ;;
