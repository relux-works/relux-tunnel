===== Sources/ReluxSnapshotDiffSupport/SnapshotDiff.swift =====
     1	import AppKit
     2	import Foundation
     3	
     4	public enum SnapshotDiffError: Error {
     5	  case unreadableImage(URL)
     6	  case incompatibleDimensions
     7	  case cannotCreateBitmap
     8	  case cannotEncodePNG
     9	}
    10	
    11	public enum SnapshotDiff {
    12	  /// Writes a review packet and returns `true` when every pixel matches.
    13	  public static func compare(
    14	    reference referenceURL: URL,
    15	    failed failedURL: URL,
    16	    outputDirectory: URL
    17	  ) throws -> Bool {
    18	    guard
    19	      let referenceData = try? Data(contentsOf: referenceURL),
    20	      let reference = NSBitmapImageRep(data: referenceData)
    21	    else {
    22	      throw SnapshotDiffError.unreadableImage(referenceURL)
    23	    }
    24	    guard
    25	      let failedData = try? Data(contentsOf: failedURL),
    26	      let failed = NSBitmapImageRep(data: failedData)
    27	    else {
    28	      throw SnapshotDiffError.unreadableImage(failedURL)
    29	    }
    30	    guard reference.pixelsWide == failed.pixelsWide, reference.pixelsHigh == failed.pixelsHigh
    31	    else {
    32	      throw SnapshotDiffError.incompatibleDimensions
    33	    }
    34	    guard
    35	      let diff = NSBitmapImageRep(
    36	        bitmapDataPlanes: nil,
    37	        pixelsWide: reference.pixelsWide,
    38	        pixelsHigh: reference.pixelsHigh,
    39	        bitsPerSample: 8,
    40	        samplesPerPixel: 4,
    41	        hasAlpha: true,
    42	        isPlanar: false,
    43	        colorSpaceName: .deviceRGB,
    44	        bytesPerRow: 0,
    45	        bitsPerPixel: 0
    46	      )
    47	    else {
    48	      throw SnapshotDiffError.cannotCreateBitmap
    49	    }
    50	
    51	    var matches = true
    52	    for y in 0..<reference.pixelsHigh {
    53	      for x in 0..<reference.pixelsWide {
    54	        let expected = reference.colorAt(x: x, y: y) ?? .clear
    55	        let actual = failed.colorAt(x: x, y: y) ?? .clear
    56	        let equal =
    57	          expected.usingColorSpace(NSColorSpace.deviceRGB)
    58	          == actual.usingColorSpace(NSColorSpace.deviceRGB)
    59	        matches = matches && equal
    60	        diff.setColor(equal ? dimmed(expected) : highlighted(actual), atX: x, y: y)
    61	      }
    62	    }
    63	
    64	    try FileManager.default.createDirectory(
    65	      at: outputDirectory,
    66	      withIntermediateDirectories: true
    67	    )
    68	    try FileManager.default.copyReplacingItem(
    69	      at: referenceURL,
    70	      to: outputDirectory.appendingPathComponent("reference.png")
    71	    )
    72	    try FileManager.default.copyReplacingItem(
    73	      at: failedURL,
    74	      to: outputDirectory.appendingPathComponent("failed.png")
    75	    )
    76	    guard
    77	      let data = diff.representation(using: NSBitmapImageRep.FileType.png, properties: [:])
    78	    else {
    79	      throw SnapshotDiffError.cannotEncodePNG
    80	    }
    81	    try data.write(
    82	      to: outputDirectory.appendingPathComponent("diff.png"),
    83	      options: Data.WritingOptions.atomic
    84	    )
    85	    return matches
    86	  }
    87	
    88	  private static func dimmed(_ color: NSColor) -> NSColor {
    89	    let rgb = color.usingColorSpace(.deviceRGB) ?? .clear
    90	    let luminance = (rgb.redComponent + rgb.greenComponent + rgb.blueComponent) / 3
    91	    return NSColor(deviceWhite: luminance * 0.35, alpha: 0.65)
    92	  }
    93	
    94	  private static func highlighted(_ color: NSColor) -> NSColor {
    95	    let rgb = color.usingColorSpace(.deviceRGB) ?? .clear
    96	    return NSColor(
    97	      deviceRed: min(1, rgb.redComponent + 0.65),
    98	      green: rgb.greenComponent * 0.2,
    99	      blue: rgb.blueComponent * 0.2,
   100	      alpha: 1
   101	    )
   102	  }
   103	}
   104	
   105	extension FileManager {
   106	  fileprivate func copyReplacingItem(at source: URL, to destination: URL) throws {
   107	    if fileExists(atPath: destination.path) {
   108	      try removeItem(at: destination)
   109	    }
   110	    try copyItem(at: source, to: destination)
   111	  }
   112	}

