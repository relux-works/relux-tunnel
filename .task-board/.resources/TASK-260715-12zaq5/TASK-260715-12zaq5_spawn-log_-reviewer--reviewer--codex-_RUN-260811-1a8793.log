  case publicKeyAuthentication
  case directTCPIP
  case exec
  case execStdinUpload
  case boundedPartialWrites
  case boundedReceiveBuffers
  case clientByteRekey
  case clientTimeRekey
  case explicitRekey
  case serverRekey
  case keepalive
}

