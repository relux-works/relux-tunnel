+def directory_identity(path: Path, label: str) -> tuple[int, int]:
+    try:
+        status = os.lstat(path)
+    except OSError as error:
+        raise AssetManifestError(f"{label} is unavailable") from error
+    if not stat.S_ISDIR(status.st_mode) or stat.S_ISLNK(status.st_mode):
+        raise AssetManifestError(f"{label} is not a safe directory")
+    return status.st_dev, status.st_ino
+
+
+def remove_owned_directory(path: Path, identity: tuple[int, int]) -> None:
+    try:
+        status = os.lstat(path)
+    except FileNotFoundError:
+        return
+    except OSError as error:
+        raise AssetManifestError("relay asset staging cleanup failed") from error
+    if (
+        not stat.S_ISDIR(status.st_mode)
+        or stat.S_ISLNK(status.st_mode)
+        or (status.st_dev, status.st_ino) != identity
+    ):
+        raise AssetManifestError(
+            "relay asset staging ownership changed; refusing unsafe cleanup"
+        )
+    if not shutil.rmtree.avoids_symlink_attacks:
+        raise AssetManifestError("safe relay asset staging cleanup is unavailable")
+    try:
+        shutil.rmtree(path)
+    except OSError as error:
+        raise AssetManifestError("relay asset staging cleanup failed") from error
+
+
+def fsync_directory(path: Path) -> None:
+    descriptor = open_bundle_directory(path)
+    try:
+        os.fsync(descriptor)
+    except OSError as error:
+        raise AssetManifestError("relay asset directory sync failed") from error
+    finally:
+        os.close(descriptor)
+
