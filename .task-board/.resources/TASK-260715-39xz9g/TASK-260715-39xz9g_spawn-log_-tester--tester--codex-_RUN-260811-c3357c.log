+{"algorithmProfiles":{"fallback":{"cipher":"aes128-ctr","hostKey":"ecdsa-sha2-nistp256","keyExchange":"diffie-hellman-group14-sha256","mac":"hmac-sha2-512","userKey":"ecdsa-sha2-nistp256"},"primary":{"cipher":"aes256-ctr","hostKey":"ssh-ed25519","keyExchange":"curve25519-sha256","mac":"hmac-sha2-256","userKey":"ssh-ed25519"}},"endpoints":[{"behavior":"read until EOF and discard after incremental byte/hash accounting","id":"sink","listen":"numeric IPv4 loopback with an ephemeral port"},{"behavior":"read and return exact bytes","id":"echo","listen":"numeric IPv4 loopback with an ephemeral port"},{"behavior":"accept then close before payload","id":"early-close","listen":"numeric IPv4 loopback with an ephemeral port"},{"behavior":"echo one read, close the write half, and continue draining the read half","id":"half-close","listen":"numeric IPv4 loopback with an ephemeral port"},{"behavior":"accept then close with SO_LINGER zero","id":"reset","listen":"numeric IPv4 loopback with an ephemeral port"},{"behavior":"read one bounded chunk then close the connection","id":"disconnect","listen":"numeric IPv4 loopback with an ephemeral port"}],"generatedAt":"2026-08-11T19:30:00Z","networkProfiles":[{"deterministicDropEvery":0,"id":"baseline","latencyMilliseconds":0},{"deterministicDropEvery":0,"id":"latency-75ms","latencyMilliseconds":75},{"deterministicDropEvery":10,"id":"loss-10-percent","latencyMilliseconds":0}],"payloadRetention":"none","reproduction":{"commands":["python3 scripts/ssh_matrix_fixture.py verify-manifest","swift test --filter approvedAlgorithmCompatibilityMatrix","swift test --filter everyUntrustedHostStopsBeforeCredentialsAndDestinationChannels","python3 scripts/ssh_matrix_fixture.py traffic-source --bytes 5368709120 --seed TASK-260715-39xz9g | python3 scripts/ssh_matrix_fixture.py traffic-sink --expected-bytes 5368709120 --expected-sha256 SHA256:fc01cfd7aebf90ff9491f8556131b6ef575c3e1fa33a0277ba28920bbaee7f54"],"ordering":"capture raw public host key before resolving any secret reference; pin that key for authentication; create endpoints; run matrix; tear down"},"scenarios":[{"expected":"approved raw host key, public-key authentication, and channel operations succeed","id":"success","reproduction":"run primary and fallback rows against echo and sink"},{"expected":"onboardingRequired and zero secret-resolution calls","id":"host-key-first-use","reproduction":"present a generated public host key with no approved record"},{"expected":"changedKeyRejected and zero secret-resolution calls","id":"host-key-change","reproduction":"replace the ephemeral host key while preserving the approved fingerprint"},{"expected":"authenticationRejected without password or interactive fallback","id":"auth-rejection","reproduction":"authorize a different ephemeral public user key"},{"expected":"operation-scoped channelOpenRejected while the sibling channel remains usable","id":"channel-rejection","reproduction":"open direct-tcpip to a closed numeric-loopback port"},{"expected":"EOF before payload and deterministic cleanup","id":"early-close","reproduction":"route direct-tcpip to endpoint early-close"},{"expected":"independent read/write halves and exact echoed prefix","id":"half-close","reproduction":"route direct-tcpip to endpoint half-close"},{"expected":"connection reset classification and zero residual resources","id":"reset","reproduction":"route direct-tcpip to endpoint reset"},{"expected":"traffic remains byte exact across a server-initiated key exchange","id":"server-rekey","reproduction":"run sink traffic through OpenSSH RekeyLimit 32K 0"},{"expected":"added delay is exactly 75 milliseconds at each configured boundary","id":"latency","reproduction":"apply network profile latency-75ms"},{"expected":"connections 10, 20, and subsequent multiples are deterministically blackholed","id":"loss","reproduction":"apply network profile loss-10-percent"},{"expected":"connectionLost and bounded teardown after the first forwarded chunk","id":"disconn