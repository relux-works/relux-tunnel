   325	/// Stable bootstrap mapping. It classifies only; it never schedules a retry.
   326	public enum SSHBootstrapErrorMapper {
   327	  public static func profile(
   328	    _ error: SSHProfileSnapshotLoaderError,
   329	    configurationGeneration: UInt64 = 0
   330	  ) -> SSHBootstrapProviderError {
   331	    map(.profile(error), configurationGeneration: configurationGeneration).providerError
   332	  }
   333	
   334	  public static func transport(
   335	    _ error: SSHTransportError,
   336	    configurationGeneration: UInt64,
   337	    context: SSHBootstrapDiagnosticContext = .none
   338	  ) -> SSHBootstrapProviderError {
   339	    map(transportCause(error), configurationGeneration: configurationGeneration, context: context)
   340	      .providerError
   341	  }
   342	
   343	  /// Maps an untrusted platform error without retaining its domain, userInfo, or description.
   344	  public static func transport(
   345	    _ error: any Error,
   346	    stage: SSHBootstrapStage,
   347	    configurationGeneration: UInt64,
   348	    context: SSHBootstrapDiagnosticContext = .none
   349	  ) -> SSHBootstrapProviderError {
   350	    let normalized: SSHBootstrapTransportCause
   351	    if error is CancellationError {
   352	      normalized = .cancelled
   353	    } else {
   354	      let nsError = error as NSError
   355	      if nsError.domain == NSPOSIXErrorDomain {
   356	        normalized = posixCause(Int32(clamping: nsError.code))
   357	      } else if nsError.domain == NSURLErrorDomain {
   358	        normalized = urlCause(nsError.code)
   359	      } else {
   360	        normalized = .unexpected
   361	      }
   362	    }
   363	    return transport(
   364	      normalized,
   365	      stage: stage,
   366	      configurationGeneration: configurationGeneration,
   367	      context: context
   368	    )
   369	  }
   370	
   371	  public static func transport(
   372	    posixCode: Int32,
   373	    stage: SSHBootstrapStage,
   374	    configurationGeneration: UInt64,
   375	    context: SSHBootstrapDiagnosticContext = .none
   376	  ) -> SSHBootstrapProviderError {
   377	    transport(
   378	      posixCause(posixCode),
   379	      stage: stage,
   380	      configurationGeneration: configurationGeneration,
   381	      context: context
   382	    )
   383	  }
   384	
   385	  public static func transport(
   386	    _ cause: SSHBootstrapTransportCause,
   387	    stage: SSHBootstrapStage,
   388	    configurationGeneration: UInt64,
   389	    context: SSHBootstrapDiagnosticContext = .none
   390	  ) -> SSHBootstrapProviderError {
   391	    let internalCause: SSHBootstrapInternalCause
   392	    switch stage {
   393	    case .physicalPathResolution:
   394	      internalCause = .physicalPath(cause)
   395	    case .endpointConnect:
   396	      internalCause = .endpointConnect(cause)
   397	    case .algorithmNegotiation:
   398	      internalCause = .negotiation(cause)
   399	    case .cancellation:
   400	      internalCause = .cancellation(.taskCancelled)
   401	    default:
   402	      internalCause = .invariantViolation(stage)
   403	    }
   404	    return map(
   405	      internalCause,
   406	      configurationGeneration: configurationGeneration,
   407	      context: context
   408	    ).providerError
   409	  }
