  @Test("table vectors select every class including 32 KiB, 64 KiB, BDP, and relay burst")
  func classVectors() throws {
    let configuration = try fixtureConfiguration()
    let cases: [(SSHReceiveWindowClass, SSHBulkPathMeasurement?, Int)] = [
      (.control, nil, 32 * 1_024),
      (.ordinary, nil, 64 * 1_024),
      (
        .bulk,
        SSHBulkPathMeasurement(
          bandwidthBitsPerSecond: 8_000_000,
          roundTripTimeNanoseconds: 64_000_000),
        64_000
      ),
      (.relay, nil, 32 * 1_024 + 4 * (4 + 1_472)),
    ]

    for (channelClass, measurement, expected) in cases {
      #expect(
        try SSHReceiveWindowBudgetLedger.initialCandidate(
          for: channelClass,
