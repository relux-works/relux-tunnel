Release engineers updating or rolling back the four relay assets must follow
the [relay asset release runbook](docs/relay-asset-release-runbook.md). It is
the authoritative ordered procedure for the split source/recipe pins, exact
archive and manifest verification, native runtime rows, bundle integration,
downstream bootstrap gates, incident response, and M2/M5 ownership boundary.

## Security

This product hides tunneled destinations, DNS, and payloads from the on-path
network — but the exit host you choose sees your post-exit traffic, and a
long-lived SSH session is fingerprintable as SSH. It is **not** an anonymity or
DPI-evasion tool. Read [`.spec/threat-model.md`](.spec/threat-model.md) for the
full does-hide / does-not-hide matrix and residual-risk register.
name: ci

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  generated-project-credential-free:
    name: generated project credential-free validation
    # macos-15 is the arm64 image; keep this label paired with the arm64 Mise checksum.
    runs-on: macos-15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          path: relux-tunnel

      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: relux-works/relux-proxy
          ref: 2557aba1c030d0643d76e0bc3b185f6d5fd172e1
          fetch-depth: 0
          persist-credentials: false
          path: relux-proxy

      - uses: jdx/mise-action@3c2e0cf82a5b2e5249f0d3635a4d83d0ae861518 # v4.2.5
        with:
          version: 2026.3.10
          sha256: c7a0eb1035de974b42d36b69c4b55b836c06b455b990dd6ac530aaf05d4a8a17 # mise-v2026.3.10-macos-arm64
          install: false
          cache: false

      - name: Run the local credential-free gate
        working-directory: relux-tunnel
        run: make credential-free-validate LEGACY_ROOT="$GITHUB_WORKSPACE/relux-proxy"

      - name: Upload privacy-safe validation evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: credential-free-generated-project-${{ github.run_id }}
          path: |
            relux-tunnel/.temp/TASK-260715-sbrrp7/credential-free-validation/summary.log
            relux-tunnel/.temp/TASK-260715-sbrrp7/credential-free-validation/environment.log
            relux-tunnel/.temp/TASK-260715-sbrrp7/credential-free-validation/logs
          if-no-files-found: error
          retention-days: 14

  validate:
    name: board + spec validation
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Validate workflow YAML
        run: |
          python3 - <<'PY'
          import glob, sys, yaml
          bad = False
          for f in glob.glob(".github/workflows/*.yml"):
              try:
                  yaml.safe_load(open(f))
                  print(f"ok   {f}")
              except Exception as e:
                  print(f"FAIL {f}: {e}"); bad = True
          sys.exit(1 if bad else 0)
          PY

      - name: Check spec presence
        run: |
          missing=0
          for f in architecture decisions platform-distribution product \
                   routing-dns-lifecycle security-privacy ssh-transport \
                   relay-protocol packet-plane threat-model validation delivery; do
            if [ ! -f ".spec/$f.md" ]; then echo "MISSING .spec/$f.md"; missing=1; fi
          done
          [ "$missing" = 0 ] && echo "all required specs present"
          exit $missing

      - name: Check board structure
        run: |
          python3 - <<'PY'
          import os, sys
          root = ".task-board"
          bad = False
          if not os.path.isdir(root):
              print("no .task-board directory"); sys.exit(1)
          n = 0
          for dirpath, dirnames, filenames in os.walk(root):
              # .resources/ holds resource payloads keyed by element id, not board elements
              if ".resources" in dirnames:
                  dirnames.remove(".resources")
              base = os.path.basename(dirpath)
              if base.split("-")[0] in ("EPIC", "STORY", "TASK", "BUG"):
                  n += 1
                  for req in ("README.md", "progress.md"):
                      if req not in filenames:
                          print(f"FAIL {dirpath}: missing {req}"); bad = True
          print(f"checked {n} board elements")
          sys.exit(1 if bad or n == 0 else 0)
          PY

  relay-toolchain:
    name: pinned offline relay toolchain
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Verify checked-in pins and missing-input failure
        run: |
          make relay-supply-chain-audit relay-supply-chain-test relay-toolchain-check relay-toolchain-negative-test
          python3 -W error::ResourceWarning -m unittest scripts/tests/test_relay_asset_smoke.py

      - name: Fetch the approved checksum-pinned Go input
        run: |
          mkdir -p .temp/relay-tools
          read -r go_archive go_sha go_url <<EOF
          $(python3 -c 'import json; d=json.load(open("relay/toolchain-manifest-v1.json")); x=next(v for v in d["hostToolArchives"] if v["host"] == "linux/amd64"); print(x["artifact"], x["sha256"], x["source"])')
          EOF
          curl --fail --location --proto '=https' --tlsv1.2 \
            --output ".temp/relay-tools/$go_archive" "$go_url"
          printf '%s  %s\n' "$go_sha" ".temp/relay-tools/$go_archive" | sha256sum --check --strict
          make relay-provision-go RELAY_GO_ARCHIVE=".temp/relay-tools/$go_archive"

      - name: Test, vet, license-extract, and clean-build all four targets offline
        run: |
          source_date_epoch=$(git show -s --format=%ct HEAD)
          make relay-toolchain-ci \
            RELAY_VERSION=0.0.0 \
            SOURCE_COMMIT="$GITHUB_SHA" \
            SOURCE_DATE_EPOCH="$source_date_epoch" \
            RELAY_BUILD_CLEAN_FLAG=--require-clean

  relay-portable-runtime:
    name: portable runtime ${{ matrix.target }} on ${{ matrix.runner }}
    strategy:
      fail-fast: false
      matrix:
        include:
          - target: darwin/amd64
            slug: darwin-amd64
            runner: macos-15-intel
          - target: darwin/arm64
            slug: darwin-arm64
            runner: macos-15
          - target: linux/amd64
            slug: linux-amd64
            runner: ubuntu-24.04
          - target: linux/arm64
            slug: linux-arm64
            runner: ubuntu-24.04-arm
    runs-on: ${{ matrix.runner }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Verify checked-in pins and runtime-gate tests
        run: make relay-toolchain-check relay-toolchain-negative-test

      - name: Fetch the approved checksum-pinned host tools
        env:
          RELAY_HOST_TARGET: ${{ matrix.target }}
        run: |
          mkdir -p .temp/relay-tools
          read -r go_archive go_sha go_url syft_archive syft_sha syft_url <<EOF
          $(python3 -c 'import json,os; d=json.load(open("relay/toolchain-manifest-v1.json")); h=os.environ["RELAY_HOST_TARGET"]; g=next(v for v in d["hostToolArchives"] if v["host"] == h); s=next(v for v in d["buildOnlyTools"][0]["hostArchives"] if v["host"] == h); print(g["artifact"], g["sha256"], g["source"], s["artifact"], s["sha256"], s["source"])')
          EOF
          curl --fail --location --proto '=https' --tlsv1.2 \
            --output ".temp/relay-tools/$go_archive" "$go_url"
          curl --fail --location --proto '=https' --tlsv1.2 \
            --output ".temp/relay-tools/$syft_archive" "$syft_url"
          python3 - "$go_sha" ".temp/relay-tools/$go_archive" "$syft_sha" ".temp/relay-tools/$syft_archive" <<'PY'
          import hashlib, pathlib, sys
          for expected, name in zip(sys.argv[1::2], sys.argv[2::2], strict=True):
              actual = hashlib.sha256(pathlib.Path(name).read_bytes()).hexdigest()
              if actual != expected:
                  raise SystemExit("checksum-pinned host tool mismatch")
          PY
          make relay-provision-tools \
            RELAY_GO_ARCHIVE=".temp/relay-tools/$go_archive" \
            RELAY_SYFT_ARCHIVE=".temp/relay-tools/$syft_archive"

      - name: Clean-build the exact four-asset manifest offline
        run: |
          source_date_epoch=$(git show -s --format=%ct HEAD)
          make relay-shell-release \
            RELAY_VERSION=0.0.0 \
            SOURCE_COMMIT="$GITHUB_SHA" \
            SOURCE_DATE_EPOCH="$source_date_epoch"

      - name: Gate native rootless stdio and runtime boundaries
        run: |
          mkdir -p ".build/relay/runtime-evidence/${{ matrix.slug }}"
          python3 scripts/relay_asset_smoke.py \
            --target "${{ matrix.target }}" \
            --runner-kind native \
            --runner-name "${{ matrix.runner }}" \
            --runner-owner TASK-260715-36gq4m \
            --require-native \
            --manifest .build/relay/apple-bundle-input/relux-relay-manifest-v1.json \
            --executable ".build/relay/apple-bundle-input/relux-relay-${{ matrix.slug }}" \
            --evidence ".build/relay/runtime-evidence/${{ matrix.slug }}/report.json"

      - name: Retain exact gated asset and privacy-safe runner evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: runtime-evidence-${{ matrix.slug }}-${{ github.run_id }}
          path: |
            .build/relay/apple-bundle-input/relux-relay-${{ matrix.slug }}
            .build/relay/apple-bundle-input/relux-relay-${{ matrix.slug }}.spdx.json
            .build/relay/apple-bundle-input/relux-relay-manifest-v1.json
            .build/relay/apple-bundle-input/relux-relay-SHA256SUMS
            .build/relay/runtime-evidence/${{ matrix.slug }}/report.json
          if-no-files-found: warn
          retention-days: 14
#!/bin/bash
set -u

repo_root="$(cd "$(dirname "$0")/.." && pwd -P)"
legacy_root="$repo_root/../relux-proxy"
task_output="$repo_root/.temp/TASK-260715-sbrrp7/credential-free-validation"
logs="$task_output/logs"
summary="$task_output/summary.log"
metadata="$task_output/environment.log"
expected_legacy_commit=2557aba1c030d0643d76e0bc3b185f6d5fd172e1

usage() {
  cat <<'USAGE'
Usage: scripts/validate-credential-free.sh [--legacy-root PATH]

Runs every credential-free generated-project foundation check. The legacy root
must be a Git checkout containing signed tag v0.1.0.
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --legacy-root)
      [ "$#" -ge 2 ] || { echo "error: --legacy-root requires a path" >&2; exit 2; }
      legacy_root=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

mkdir -p "$logs"
: > "$summary"
cd "$repo_root" || exit

legacy_work_root=$(mktemp -d "${TMPDIR:-/tmp}/relux-credential-free-legacy.XXXXXX")
legacy_fixture="$legacy_work_root/legacy-v0.1.0"
cleanup() {
  case "$legacy_work_root" in
    "${TMPDIR:-/tmp}"/relux-credential-free-legacy.*)
      chmod -R u+w "$legacy_work_root" 2>/dev/null || true
      rm -rf "$legacy_work_root"
      ;;
    *)
      echo "warning: refusing to clean unexpected legacy work path: $legacy_work_root" >&2
      ;;
  esac
}
trap cleanup EXIT INT TERM

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "error: required command is unavailable: $1" >&2
    exit 2
  fi
}

for command in curl git make mise plutil python3 shasum swift xcodebuild xcrun; do
  require_command "$command"
done
if [ "$(uname -s)" != Darwin ]; then
  echo "error: credential-free generated-project validation requires macOS" >&2
  exit 2
fi
if [ ! -d "$legacy_root/.git" ]; then
  echo "error: expected a legacy Git checkout at $legacy_root" >&2
  echo "Clone relux-works/relux-proxy with tags, or pass --legacy-root PATH." >&2
  exit 2
fi

run_step() {
  name=$1
  shift
  log="$logs/$name.log"
  printf 'RUN: %s\n' "$name" | tee -a "$summary"
  if "$@" >"$log" 2>&1; then
    printf 'PASS: %s (log: %s)\n' "$name" "${log#"$repo_root"/}" | tee -a "$summary"
  else
    status=$?
    printf 'FAIL: %s (exit %s; log: %s)\n' \
      "$name" "$status" "${log#"$repo_root"/}" | tee -a "$summary" >&2
    tail -n 80 "$log" >&2
    exit "$status"
  fi
}

source_revision=$(git rev-parse HEAD)
source_date_epoch=$(git show -s --format=%ct HEAD)
marketing_version=$(sed -n 's/^MARKETING_VERSION = //p' Configuration/Versions.xcconfig)
if [ -n "$(git status --porcelain=v1 --untracked-files=normal -- . ':!.task-board' ':!.temp')" ]; then
  source_worktree_state=dirty
else
  source_worktree_state=clean
fi

run_step relay-tool-bootstrap ./scripts/bootstrap-relay-tools.sh

relay_go="$repo_root/.build/relay/toolchains/go1.26.5-$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m | sed -e 's/^x86_64$/amd64/' -e 's/^aarch64$/arm64/')/go/bin/go"
relay_syft="$repo_root/.build/relay/toolchains/syft1.48.0-$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m | sed -e 's/^x86_64$/amd64/' -e 's/^aarch64$/arm64/')/syft"

{
  echo "source_revision=$source_revision"
  echo "source_date_epoch=$source_date_epoch"
  echo "source_worktree_state=$source_worktree_state"
  echo "host=$(sw_vers -productName) $(sw_vers -productVersion) ($(uname -m))"
  echo "xcode=$(xcodebuild -version | tr '\n' ';' | sed 's/;$//')"
  echo "swift=$(swift --version 2>&1 | head -n 1)"
  echo "mise=$(mise --version | head -n 1)"
  echo "tuist=$(mise exec -- tuist version | head -n 1)"
  echo "go=$($relay_go version)"
  echo "syft=$($relay_syft version | sed -n 's/^Version:[[:space:]]*//p')"
  echo "macos_deployment_target=$(sed -n 's/^MACOSX_DEPLOYMENT_TARGET = //p' Configuration/Base.xcconfig)"
  echo "ios_deployment_target=$(sed -n 's/^IPHONEOS_DEPLOYMENT_TARGET = //p' Configuration/Base.xcconfig)"
  echo "invoked_schemes=ReluxProxyMac(Debug,Release,test),ReluxProxyMacTunnel(Debug,Release)"
  echo "sdk_inventory_begin"
  xcodebuild -showsdks
  echo "sdk_inventory_end"
} > "$metadata"

run_step relay-packaging env \
  RELAY_VERSION="$marketing_version" \
  SOURCE_COMMIT="$source_revision" \
  SOURCE_DATE_EPOCH="$source_date_epoch" \
  make relay-shell-validate
run_step validation-contract-tests ./scripts/tests/test-credential-free-validation.sh
run_step deterministic-generation ./scripts/validate-workspace-foundation.sh
run_step macos-target-builds-and-contracts ./scripts/validate-macos-targets.sh
run_step core-boundaries ./scripts/check-core-boundaries.sh
run_step swift-testing swift test
run_step swift-release-build swift build -c release
run_step native-packaging make check-native-dependencies test-native-dependencies

run_step legacy-clone git clone --quiet --local --no-hardlinks "$legacy_root" "$legacy_fixture"
run_step legacy-checkout git -C "$legacy_fixture" checkout --quiet "$expected_legacy_commit"
run_step legacy-preservation ./scripts/check-legacy-preservation.sh \
  --legacy-root "$legacy_fixture" --workspace-root "$repo_root"
run_step legacy-guard-tests ./scripts/tests/test-legacy-preservation-guard.sh \
  --legacy-root "$legacy_fixture"
run_step legacy-swift-test swift test --package-path "$legacy_fixture"
run_step legacy-swift-release-build swift build -c release --package-path "$legacy_fixture"

{
  echo "NOT RUN: production signing, physical Gate P0, Developer ID archive, notarization, and DMG publication require credentials or belong to downstream release gates."
  echo "NOT RUN: ReluxProxyIOS and ReluxProxyIOSTunnel are deferred by ADR-024/ADR-027 and must remain absent from the macOS-only graph."
  echo "PASS: credential-free generated-project validation"
  echo "metadata: ${metadata#"$repo_root"/}"
  echo "logs: ${logs#"$repo_root"/}"
} | tee -a "$summary"

