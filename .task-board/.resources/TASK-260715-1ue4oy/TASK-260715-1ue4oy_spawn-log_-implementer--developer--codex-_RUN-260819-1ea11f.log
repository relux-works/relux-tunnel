   877	def publish_staged_bundle(
   878	    staging: Path,
   879	    bundle: Path,
   880	    event_hook: Callable[[str, Path], None] | None,
   881	) -> None:
   882	    parent = bundle.parent
   883	    try:
   884	        existing_status = os.lstat(bundle)
   885	    except FileNotFoundError:
   886	        existing_status = None
   887	    except OSError as error:
   888	        raise AssetManifestError("relay asset bundle destination is unavailable") from error
   889
   890	    if existing_status is None:
   891	        try:
   892	            os.replace(staging, bundle)
   893	            fsync_directory(parent)
   894	        except OSError as error:
   895	            raise AssetManifestError("relay asset bundle publication failed") from error
   896	        if event_hook is not None:
   897	            event_hook("after_publish", bundle)
   898	        return
   899	    if not stat.S_ISDIR(existing_status.st_mode) or stat.S_ISLNK(
   900	        existing_status.st_mode
   901	    ):
   902	        raise AssetManifestError("relay asset bundle destination is unsafe")
   903
   904	    displaced_identity = (existing_status.st_dev, existing_status.st_ino)
   905	    atomic_exchange(staging, bundle)
   906	    try:
   907	        fsync_directory(parent)
   908	        if event_hook is not None:
   909	            event_hook("after_exchange", bundle)
   910	    finally:
   911	        remove_owned_directory(staging, displaced_identity)
   912	        fsync_directory(parent)
