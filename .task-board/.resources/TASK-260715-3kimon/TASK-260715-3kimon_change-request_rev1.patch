+      let charged = ledger.snapshot().ledgerCommittedBytes
+      let release = ledger.release(channel: channel, cause: cause)
+      let duplicate = ledger.release(channel: channel, cause: .lateCallback)
+      #expect(release.releasedLedgerBytes == initial.ledgerChargeBytes + 32 * 1_024)
+      #expect(release.releasedLedgerBytes == charged)
+      #expect(!release.wasAlreadyReleased)
