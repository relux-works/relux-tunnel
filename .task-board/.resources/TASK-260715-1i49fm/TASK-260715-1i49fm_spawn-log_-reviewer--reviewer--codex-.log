   678	        try container.decode([String: Int64].self, forKey: .gauges)
   679	      } else {
   680	        [:]
   681	      }
   682	    histograms =
   683	      if container.contains(.histograms) {
   684	        try container.decode([String: RuntimeDiagnosticHistogram].self, forKey: .histograms)
   685	      } else {
   686	        [:]
   687	      }
   688	    errors =
   689	      if container.contains(.errors) {
   690	        try container.decode([RedactedRuntimeError].self, forKey: .errors)
   691	      } else {
   692	        []
   693	      }
   694	    try Self.validateMetricNames(counters.keys)
   695	    try Self.validateMetricNames(gauges.keys)
   696	    try Self.validateMetricNames(histograms.keys)
   697	  }
   698	
   699	  public func encode(to encoder: any Encoder) throws {
   700	    try Self.validateMetricNames(counters.keys)
   701	    try Self.validateMetricNames(gauges.keys)
   702	    try Self.validateMetricNames(histograms.keys)
   703	    var container = encoder.container(keyedBy: CodingKeys.self)
   704	    try container.encode(protocolVersion, forKey: .protocolVersion)
   705	    try container.encode(kind, forKey: .kind)
   706	    try container.encode(schemaVersion, forKey: .schemaVersion)
   707	    try container.encodeIfPresent(requestID, forKey: .requestID)
   708	    try container.encode(runtimeGeneration, forKey: .runtimeGeneration)
   709	    try container.encode(snapshotSequence, forKey: .snapshotSequence)
   710	    try container.encode(counters, forKey: .counters)
   711	    try container.encode(gauges, forKey: .gauges)
   712	    try container.encode(histograms, forKey: .histograms)
   713	    try container.encode(errors, forKey: .errors)
   714	  }
   715	
   716	  public var position: RuntimeSnapshotPosition {
   717	    RuntimeSnapshotPosition(
   718	      runtimeGeneration: runtimeGeneration,
   719	      snapshotSequence: snapshotSequence
   720	    )
   721	  }
   722	
   723	  private static func validateMetricNames<S: Sequence>(_ names: S) throws
   724	  where S.Element == String {
   725	    for name in names {
   726	      guard !name.isEmpty, name.utf8.count <= maximumMetricNameUTF8Bytes,
   727	        name.utf8.allSatisfy({
   728	          (UInt8(ascii: "a")...UInt8(ascii: "z")).contains($0)
   729	            || (UInt8(ascii: "0")...UInt8(ascii: "9")).contains($0)
   730	            || $0 == UInt8(ascii: "_")
   731	        })
   732	      else {
   733	        throw RuntimeMessageCodecError.unsupportedValue
   734	      }
   735	    }
   736	  }
   737	
   738	  private enum CodingKeys: String, CodingKey {
   739	    case protocolVersion
   740	    case kind
   741	    case schemaVersion
   742	    case requestID
   743	    case runtimeGeneration
   744	    case snapshotSequence
   745	    case counters
   746	    case gauges
   747	    case histograms
   748	    case errors
   749	  }
   750	}
   751	
   752	public enum RuntimeProtocolErrorCode: String, Codable, Sendable {
   753	  case payloadTooLarge
   754	  case invalidUTF8
   755	  case corruptPayload
   756	  case excessiveNesting
   757	  case duplicateKey
   758	  case unsupportedProtocolVersion
   759	  case unsupportedSchemaVersion
   760	  case unsupportedKind

