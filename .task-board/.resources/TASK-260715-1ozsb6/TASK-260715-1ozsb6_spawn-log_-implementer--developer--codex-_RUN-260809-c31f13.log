   872	public struct SSHChannelPolicy: Equatable, Sendable {
   873	  public let initialReceiveWindowBytes: Int
   874	  public let consumerReceiveWindowCredit: SSHDeferredSemanticReport<SSHConsumerReceiveWindowPolicy>
   875	  public let maximumBufferedReadBytes: Int
   876	  public let maximumQueuedWriteBytes: Int
   877	  public let maximumWriteCallBytes: Int
