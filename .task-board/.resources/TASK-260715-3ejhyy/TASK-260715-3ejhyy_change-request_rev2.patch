+  private var recorded: [String] = []
+
+  var events: [String] { lock.withLock { recorded } }
+
+  var resourceAcquisitionCount: Int {
+    lock.withLock {
+      recorded.count {
+        $0 == "packet.descriptor" || $0 == "packet.hev-lease"
+          || $0 == "packet.hev-thread" || $0 == "packet.private-listener"
+          || $0 == "packet.read"
