+    initialReceiveWindowBytes: 1,
+    maximumAdvertisedReceiveWindowBytes: 1,
+    remainingProtocolCreditBytes: 1,
+    bufferedUnreadBytes: 0,
+    deliveredButNotYetReturnedCreditBytes: 0,
+    adjustmentCount: 0,
+    cumulativeAdjustmentBytes: 0
+  )
+}
