    42	
    43	final class TunnelController: ObservableObject {
    44	    static let shared = TunnelController()
    45	
    46	    @Published private(set) var status: TunnelStatus = .disconnected
    47	    @Published private(set) var diagnostic = ""
    48	
    49	    private var process: Process?
    50	    private var errorPipe: Pipe?
    51	    private var requestedStop = false
    52	
    53	    private init() {}
    54	
    55	    func connect(configuration: TunnelConfiguration) {
    56	        guard process == nil else { return }
    57	
    58	        do {
    59	            let arguments = try SSHCommandBuilder.arguments(for: configuration)
    60	            guard Self.isLocalPortAvailable(configuration.localPort) else {
    61	                throw TunnelLaunchError.localPortInUse(configuration.localEndpoint)
    62	            }
    63	            let process = Process()
    64	            let pipe = Pipe()
    65	
    66	            process.executableURL = SSHCommandBuilder.executableURL
    67	            process.arguments = arguments
    68	            process.standardInput = FileHandle.nullDevice
    69	            process.standardOutput = FileHandle.nullDevice
    70	            process.standardError = pipe
    71	
    72	            pipe.fileHandleForReading.readabilityHandler = { [weak self] handle in
    73	                let data = handle.availableData
    74	                guard !data.isEmpty, let text = String(data: data, encoding: .utf8) else {
    75	                    return
    76	                }
    77	                DispatchQueue.main.async {
    78	                    self?.appendDiagnostic(text)
    79	                }
    80	            }
    81	
    82	            process.terminationHandler = { [weak self] terminatedProcess in
    83	                DispatchQueue.main.async {
    84	                    self?.handleTermination(of: terminatedProcess)
    85	                }
    86	            }
    87	
    88	            requestedStop = false
    89	            diagnostic = ""
    90	            status = .connecting
    91	            self.process = process
    92	            errorPipe = pipe
    93	
    94	            try process.run()
    95	            monitorReadiness(of: process, port: configuration.localPort)
    96	        } catch {
    97	            clearProcess()
    98	            let message = (error as? LocalizedError)?.errorDescription ?? error.localizedDescription
    99	            diagnostic = message
   100	            status = .failed(message)
   101	        }
   102	    }
   103	
   104	    func disconnect() {
   105	        guard let process else {
   106	            status = .disconnected
   107	            return
   108	        }
   109	
   110	        requestedStop = true
   111	        status = .disconnecting
   112	        process.terminate()
   113	
   114	        let processIdentifier = process.processIdentifier
   115	        DispatchQueue.global(qos: .utility).asyncAfter(deadline: .now() + 2) {
   116	            if process.isRunning {
   117	                kill(processIdentifier, SIGKILL)
   118	            }
   119	        }
   120	    }
   121	
   122	    func shutdown() {
   123	        guard let process else { return }
   124	        requestedStop = true
   125	        kill(process.processIdentifier, SIGTERM)
   126	    }
   127	
   128	    private func monitorReadiness(of monitoredProcess: Process, port: Int) {
   129	        DispatchQueue.global(qos: .utility).async { [weak self] in
   130	            for _ in 0..<100 {
   131	                usleep(200_000)
   132	                guard monitoredProcess.isRunning else { return }
   133	
   134	                if Self.canConnect(toLocalPort: port) {
   135	                    DispatchQueue.main.async {
   136	                        guard let self, self.process === monitoredProcess else { return }
   137	                        self.status = .connected
   138	                    }
   139	                    return
   140	                }
   141	            }
   142	
   143	            DispatchQueue.main.async {
   144	                guard let self, self.process === monitoredProcess else { return }
   145	                self.appendDiagnostic("Timed out waiting for the local SOCKS port to open.")
   146	                monitoredProcess.terminate()
   147	            }
   148	        }
   149	    }
   150	
   151	    private static func canConnect(toLocalPort port: Int) -> Bool {
   152	        let descriptor = socket(AF_INET, SOCK_STREAM, 0)
   153	        guard descriptor >= 0 else { return false }
   154	        defer { close(descriptor) }
   155	
   156	        var address = sockaddr_in()
   157	        address.sin_len = UInt8(MemoryLayout<sockaddr_in>.size)
   158	        address.sin_family = sa_family_t(AF_INET)
   159	        address.sin_port = in_port_t(UInt16(port).bigEndian)
   160	        address.sin_addr = in_addr(s_addr: inet_addr("127.0.0.1"))
   161	
   162	        return withUnsafePointer(to: &address) { pointer in
   163	            pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) { socketAddress in
   164	                Darwin.connect(
   165	                    descriptor,
   166	                    socketAddress,
   167	                    socklen_t(MemoryLayout<sockaddr_in>.size)
   168	                ) == 0
   169	            }
   170	        }
   171	    }
   172	
   173	    private static func isLocalPortAvailable(_ port: Int) -> Bool {
   174	        let descriptor = socket(AF_INET, SOCK_STREAM, 0)
   175	        guard descriptor >= 0 else { return false }
   176	        defer { close(descriptor) }
   177	
   178	        var address = sockaddr_in()
   179	        address.sin_len = UInt8(MemoryLayout<sockaddr_in>.size)
   180	        address.sin_family = sa_family_t(AF_INET)
   181	        address.sin_port = in_port_t(UInt16(port).bigEndian)
   182	        address.sin_addr = in_addr(s_addr: inet_addr("127.0.0.1"))
   183	
   184	        return withUnsafePointer(to: &address) { pointer in
   185	            pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) { socketAddress in
   186	                Darwin.bind(
   187	                    descriptor,
   188	                    socketAddress,
   189	                    socklen_t(MemoryLayout<sockaddr_in>.size)
   190	                ) == 0
   191	            }
   192	        }
   193	    }
   194	
   195	    private func appendDiagnostic(_ text: String) {
   196	        diagnostic += text
   197	        if diagnostic.count > 4_000 {
   198	            diagnostic = String(diagnostic.suffix(4_000))
   199	        }
   200	    }
   201	
   202	    private func handleTermination(of terminatedProcess: Process) {
   203	        guard process === terminatedProcess else { return }
   204	
   205	        let stoppedByUser = requestedStop
   206	        let exitCode = terminatedProcess.terminationStatus
   207	        let message = diagnostic
   208	            .split(whereSeparator: \Character.isNewline)
   209	            .last
   210	            .map(String.init)
   211	            ?? "SSH exited with status \(exitCode)."
   212	
   213	        clearProcess()
   214	        if stoppedByUser {
   215	            diagnostic = ""
   216	            status = .disconnected
   217	        } else {
   218	            diagnostic = message
   219	            status = .failed(message)
   220	        }
   221	    }
   222	
   223	    private func clearProcess() {
   224	        errorPipe?.fileHandleForReading.readabilityHandler = nil
   225	        errorPipe = nil
   226	        process = nil
   227	        requestedStop = false
   228	    }
   229	}
   230	
   231	private enum TunnelLaunchError: LocalizedError {
   232	    case localPortInUse(String)
   233	
   234	    var errorDescription: String? {
   235	        switch self {
   236	        case let .localPortInUse(endpoint):
   237	            return "Local port \(endpoint) is already in use. Stop the existing tunnel or choose another port."
   238	        }
   239	    }
   240	}

