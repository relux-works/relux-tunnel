  1284	    strings = [value for kind, value in tokens if kind == "string"]
  1285	
  1286	    if identifiers & FOUNDATION_NETWORK_SYMBOLS or any(
  1287	        any(symbol in value for symbol in FOUNDATION_NETWORK_SYMBOLS)
  1288	        for value in strings
  1289	    ):
  1290	        return "Foundation network loader"
