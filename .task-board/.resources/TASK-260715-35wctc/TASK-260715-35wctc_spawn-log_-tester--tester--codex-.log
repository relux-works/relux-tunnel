+    let ipv4Outbound = Data("small-ipv4".utf8)
+    let ipv6Outbound = Data(repeating: 0x6a, count: 1_024)
+    try harness.driver.deliver(ipv4.dataPacket(ipv4Outbound))
+    try harness.driver.deliver(ipv6.dataPacket(ipv6Outbound))
