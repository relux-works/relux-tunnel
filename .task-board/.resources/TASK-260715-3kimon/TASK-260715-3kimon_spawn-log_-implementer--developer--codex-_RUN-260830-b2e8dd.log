+      return MemoryPlatformSample(
+        physicalFootprint: .unavailable(
+          reason: .executionTimeExceeded, provenance: .taskVMPhysicalFootprint),
+        physicalFootprintPeak: .unavailable(
+          reason: .executionTimeExceeded, provenance: .taskVMPhysicalFootprint),
+        advisoryAvailableMemory: .unavailable(
+          reason: .executionTimeExceeded, provenance: .osProcessAvailableMemory))
+    }
+    let currentSample = sanitizeProvenance(
+      sample.physicalFootprint, expected: .taskVMPhysicalFootprint)
+    let peakSample = sanitizeProvenance(
+      sample.physicalFootprintPeak, expected: .taskVMPhysicalFootprint)
+    let advisorySample = sanitizeProvenance(
+      sample.advisoryAvailableMemory, expected: .osProcessAvailableMemory)
+    if let current = currentSample.bytes, let peak = peakSample.bytes, peak < current {
+      return MemoryPlatformSample(
+        physicalFootprint: .unavailable(
+          reason: .malformed, provenance: .taskVMPhysicalFootprint),
+        physicalFootprintPeak: .unavailable(
+          reason: .malformed, provenance: .taskVMPhysicalFootprint),
+        advisoryAvailableMemory: advisorySample)
+    }
+    return MemoryPlatformSample(
+      physicalFootprint: currentSample,
+      physicalFootprintPeak: peakSample,
+      advisoryAvailableMemory: advisorySample)
