+    let handle = try systemKeychainHandle()
+    let cases: [(OSStatus, MacOSCredentialResolverError)] = [
+      (errSecItemNotFound, .credentialNotProvisioned),
+      (errSecAuthFailed, .credentialAccessDenied),
