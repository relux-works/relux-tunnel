   549	def open_bundle_directory(bundle: Path) -> int:
   550	    no_follow = getattr(os, "O_NOFOLLOW", None)
   551	    directory_flag = getattr(os, "O_DIRECTORY", None)
   552	    if no_follow is None or directory_flag is None:
   553	        raise AssetManifestError(
   554	            "trusted relay directory no-follow opens are unavailable"
   555	        )
   556	    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | no_follow | directory_flag
   557	    descriptor: int | None = None
   558	    try:
   559	        descriptor = os.open(bundle, flags)
   560	        status = os.fstat(descriptor)
   561	    except OSError as error:
   562	        if descriptor is not None:
   563	            os.close(descriptor)
   564	        raise AssetManifestError("relay asset bundle is missing or unsafe") from error
   565	    if not stat.S_ISDIR(status.st_mode):
   566	        os.close(descriptor)
   567	        raise AssetManifestError("relay asset bundle is missing or unsafe")
   568	    return descriptor
