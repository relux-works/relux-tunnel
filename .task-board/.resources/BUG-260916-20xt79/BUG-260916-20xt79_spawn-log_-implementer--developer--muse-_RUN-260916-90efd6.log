{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c437","stream":{"kind":"session","id":"01a0a9c6-18e8-73c2-87df-807f8e977157"},"sequence":118,"recorded_at":1780531400000231,"record_type":"event","durability":"durable","causation_id":"7f8b7742-5a98-412e-8203-1d9787ac5c82","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"7f8b7742-5a98-412e-8203-1d9787ac5c82","run_stream":{"kind":"run","id":"7f8b7742-5a98-412e-8203-1d9787ac5c82"},"call_id":"call_01a0a9c6600972cda4e7220c11d99008","text":"Read text file `Sources/ReluxTunnelMacOSAdapter/MacOSSSHBootstrapErrorMapper.swift`.\n1|import Foundation\n2|import Network\n3|import ReluxTunnelCore\n4|import Security\n5|\n6|/// macOS normalization layer for Network.framework and Security.framework failures.\n7|/// Platform values are consumed for classification and are never copied into diagnostics.\n8|public enum MacOSSSHBootstrapErrorMapper {\n9|  public static func network(\n10|    _ error: NWError,\n11|    stage: SSHBootstrapStage,\n12|    configurationGeneration: UInt64,\n13|    context: SSHBootstrapDiagnosticContext = .none\n14|  ) -> SSHBootstrapProviderError {\n15|    switch error {\n16|    case .posix(let code):\n17|      return SSHBootstrapErrorMapper.transport(\n18|        posixCode: Int32(code.rawValue),\n19|        stage: stage,\n20|        configurationGeneration: configurationGeneration,\n21|        context: context\n22|      )\n23|    case .dns:\n24|      return SSHBootstrapErrorMapper.transport(\n25|        .unavailable,\n26|        stage: stage,\n27|        configurationGeneration: configurationGeneration,\n28|        context: context\n29|      )\n30|    case .tls:\n31|      return SSHBootstrapErrorMapper.transport(\n32|        .unexpected,\n33|        stage: stage,\n34|        configurationGeneration: configurationGeneration,\n35|        context: context\n36|      )\n37|    // NWError.wifiAware exists only in the macOS 26 SDK (Swift 6.2+ toolchain).\n38|    #if compiler(>=6.2)\n39|      case .wifiAware:\n40|        return SSHBootstrapErrorMapper.transport(\n41|          .unavailable,\n42|          stage: stage,\n43|          configurationGeneration: configurationGeneration,\n44|          context: context\n45|        )\n46|    #endif\n47|    @unknown default:\n48|      return SSHBootstrapErrorMapper.transport(\n49|        .unexpected,\n50|        stage: stage,\n51|        configurationGeneration: configurationGeneration,\n52|        context: context\n53|      )\n54|    }\n55|  }\n56|\n57|  public static func credential(\n58|    _ error: MacOSCredentialResolverError,\n59|    configurationGeneration: UInt64\n60|  ) -> SSHBootstrapProviderError {\n61|    switch error {\n62|    case .credentialNotProvisioned:\n63|      SSHBootstrapErrorMapper.credential(\n64|        .notProvisioned,\n65|        configurationGeneration: configurationGeneration\n66|      )\n67|    case .credentialAccessDenied:\n68|      SSHBootstrapErrorMapper.credential(\n69|        .accessDenied,\n70|        configurationGeneration: configurationGeneration\n71|      )\n72|    case .credentialWrongClass, .credentialMalformed:\n73|      SSHBootstrapErrorMapper.credential(\n74|        .malformed,\n75|        configurationGeneration: configurationGeneration\n76|      )\n77|    case .credentialGenerationMismatch:\n78|      SSHBootstrapErrorMapper.credential(\n79|        .generationMismatch,\n80|        configurationGeneration: configurationGeneration\n81|      )\n82|    case .credentialPassphraseRequired:\n83|      SSHBootstrapErrorMapper.credential(\n84|        .passphraseRequired,\n85|        configurationGeneration: configurationGeneration\n86|      )\n87|    case .credentialPassphraseInvalid:\n88|      SSHBootstrapErrorMapper.credential(\n89|        .passphraseInvalid,\n90|        configurationGeneration: configurationGeneration\n91|      )\n92|    case .credentialKeyUnsupported:\n93|      SSHBootstrapErrorMapper.credential(\n94|        .keyUnsupported,\n95|        configurationGeneration: configurationGeneration\n96|      )\n97|    case .operationCancelled:\n98|      SSHBootstrapErrorMapper.cancellation(\n99|        .taskCancelled,\n100|        configurationGeneration: configurationGeneration\n101|      )\n102|    }\n103|  }\n104|\n105|  static func credential(\n106|    status: OSStatus,\n107|    itemLookup: Bool,\n108|    configurationGeneration: UInt64\n109|  ) -> SSHBootstrapProviderError {\n110|    credential(\n111|      MacOSCredentialResolverError(status: status, itemLookup: itemLookup),\n112|      configurationGeneration: configurationGeneration\n113|    )\n114|  }\n115|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
