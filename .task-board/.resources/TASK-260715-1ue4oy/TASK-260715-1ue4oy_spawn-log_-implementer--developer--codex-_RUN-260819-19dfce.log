+def read_exact_stream(stream: Any, size: int, label: str) -> bytes:
+    chunks: list[bytes] = []
+    remaining = size
+    while remaining:
+        chunk = stream.read(min(remaining, READ_CHUNK_BYTES))
+        if not chunk:
+            raise AssetManifestError(f"trusted relay archive {label} is truncated")
+        chunks.append(chunk)
+        remaining -= len(chunk)
