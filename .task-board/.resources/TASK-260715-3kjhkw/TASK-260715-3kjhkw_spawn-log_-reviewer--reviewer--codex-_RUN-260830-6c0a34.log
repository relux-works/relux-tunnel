private func observed(_ disposition: MemoryObservationDisposition) throws -> MemoryObservation {
  guard case .observed(let observation) = disposition else {
    Issue.record("Expected an accepted observation")
    throw MemoryWatermarkTestError.rateLimited
  }
  return observation
}

private enum MemoryWatermarkTestError: Error { case rateLimited }

private func thresholds() throws -> MemorySignalThresholds {
  try MemorySignalThresholds(
    criticalEnterBytes: 10,
    pressureEnterBytes: 20,
    softEnterBytes: 30,
    criticalExitBytes: 15,
    pressureExitBytes: 25,
    softExitBytes: 35)
}

private func configuration(
  generation: UInt64 = 1,
  cadence: Duration = .seconds(1),
  minimumEventInterval: Duration = .milliseconds(5),
  maximumEvidenceAge: Duration = .seconds(30),
  maximumSamplingDuration: Duration = .milliseconds(5),
  recoveryDwell: Duration = .zero,
  historyLimit: Int = 16
) throws -> MemoryWatermarkConfiguration {
  try MemoryWatermarkConfiguration(
    generation: generation,
    deviceBaselineBytes: 1_000,
    globalLedgerCeilingBytes: 1_000,
    ledgerHeadroom: thresholds(),
    physicalHeadroom: thresholds(),
    advisoryAvailable: thresholds(),
    cadence: cadence,
    minimumEventInterval: minimumEventInterval,
    maximumEvidenceAge: maximumEvidenceAge,
    maximumSamplingDuration: maximumSamplingDuration,
    recoveryDwell: recoveryDwell,
    historyLimit: historyLimit)
}

private func ledger(
  clock: ManualMemoryClock,
  current: UInt64 = 50,
  reserved: UInt64? = nil,
  committed: UInt64 = 50,
  peak: UInt64 = 60
) -> MemoryLedgerAvailability {
  .available(
    MemoryLedgerSnapshot(
      capturedAt: clock.now(),
      currentBytes: current,
      reservedBytes: reserved ?? committed,
      committedBytes: committed,
      peakBytes: max(peak, max(current, committed))))
}

private func sample(
  footprint: UInt64 = 100,
  peak: UInt64 = 120,
  advisory: UInt64? = 900
) -> MemoryPlatformSample {
  MemoryPlatformSample(
    physicalFootprint: .available(
      bytes: footprint, provenance: .taskVMPhysicalFootprint),
    physicalFootprintPeak: .available(
      bytes: peak, provenance: .taskVMPhysicalFootprint),
    advisoryAvailableMemory: advisory.map {
      .available(bytes: $0, provenance: .osProcessAvailableMemory)
    }
      ?? .unavailable(
        reason: .systemCallFailed, provenance: .osProcessAvailableMemory))
}

private final class ScriptedMemoryService: MemoryPlatformSamplingService, @unchecked Sendable {
  private struct State {
    var samples: [MemoryPlatformSample]
    var index = 0
  }

  private let state: Mutex<State>
  private let onSample: @Sendable () -> Void

  init(
    _ samples: [MemoryPlatformSample],
    onSample: @escaping @Sendable () -> Void = {}
  ) {
    precondition(!samples.isEmpty)
    self.state = Mutex(State(samples: samples))
    self.onSample = onSample
  }

  var callCount: Int { state.withLock(\.index) }

  func sampleCurrentProcessMemory() -> MemoryPlatformSample {
    onSample()
    return state.withLock { state in
      let sample = state.samples[min(state.index, state.samples.count - 1)]
      state.index += 1
      return sample
    }
  }
}

private final class ManualMemoryClock: TunnelClock, @unchecked Sendable {
  private let instant = Mutex(ContinuousClock().now)

  func now() -> ContinuousClock.Instant { instant.withLock { $0 } }

  func sleep(for duration: Duration) async throws {
    instant.withLock { $0 = $0.advanced(by: duration) }
  }

  func advance(by duration: Duration) {
    instant.withLock { $0 = $0.advanced(by: duration) }
  }
}

