{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c66f","stream":{"kind":"session","id":"01a0a9f3-0aae-7543-b404-eee867114d41"},"sequence":402,"recorded_at":1780531400000799,"record_type":"event","durability":"durable","causation_id":"a55aec8e-a7e3-4a93-bd48-0c1f165c8ec5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a55aec8e-a7e3-4a93-bd48-0c1f165c8ec5","run_stream":{"kind":"run","id":"a55aec8e-a7e3-4a93-bd48-0c1f165c8ec5"},"call_id":"call_01a0a9f468a17749ad46492684347d23","text":"Read text file `Tests/ReluxTunnelHarnessTests/M1RuntimeHarnessTests.swift`.\n1|import Foundation\n2|import ReluxTunnelCore\n3|import Testing\n4|\n5|@testable import ReluxTunnelHarnessSupport\n6|\n7|@Suite(\"M1 composed runtime harness\", .serialized)\n8|struct M1RuntimeHarnessTests {\n9|  @Test(\"production command completes traffic, diagnostics, host-loss, stop, and repeated cleanup\")\n10|  func successfulComposedGenerations() async throws {\n11|    let response = await runM1(scenario: .success, repetitions: 3)\n12|\n13|    #expect(response.exitCode == .success)\n14|    #expect(response.standardError.isEmpty)\n15|    let result = try JSONDecoder().decode(\n16|      HarnessResultDocument.self,\n17|      from: response.standardOutput\n18|    )\n19|    #expect(result.command == \"m1-runtime\")\n20|    #expect(result.status == \"succeeded\")\n21|    #expect(result.configuration.profileReference == \"<redacted>\")\n22|    #expect(result.metrics.counters[\"harness.m1.generations_total\"] == 3)\n23|    #expect(result.metrics.counters[\"harness.m1.tcp_fixture_exchanges_total\"] == 3)\n24|    #expect(result.metrics.counters[\"harness.m1.dns_fixture_exchanges_total\"] == 3)\n25|    #expect(result.metrics.gauges[\"harness.m1.descriptor_growth\"] == 0)\n26|    #expect(result.metrics.gauges[\"harness.m1.task_growth\"] == 0)\n27|    #expect(result.metrics.gauges[\"harness.m1.channel_growth\"] == 0)\n28|    #expect(result.metrics.gauges[\"harness.m1.socket_growth\"] == 0)\n29|    #expect(result.metrics.gauges[\"harness.m1.native_runtime_growth\"] == 0)\n30|    #expect(result.metrics.gauges[\"harness.m1.host_owner_retained\"] == 0)\n31|    #expect(!String(decoding: response.standardOutput, as: UTF8.self).contains(profileUUID))\n32|  }\n33|\n34|  @Test(\"production command emits stable codes for every mandatory failure scenario\")\n35|  func stableFailureExitCodes() async {\n36|    let cases: [(M1RuntimeHarnessScenario, HarnessExitCode)] = [\n37|      (.authenticationFailure, .m1AuthenticationFailure),\n38|      (.packetFailure, .m1PacketFailure),\n39|      (.dnsFailure, .m1DNSFailure),\n40|      (.routeApplyFailure, .m1RouteApplyFailure),\n41|      (.midSessionSSHFailure, .m1MandatoryFailure),\n42|      (.midSessionDNSFailure, .m1MandatoryFailure),\n43|    ]\n44|\n45|    for (scenario, exitCode) in cases {\n46|      let response = await runM1(scenario: scenario, repetitions: 1)\n47|      #expect(response.exitCode == exitCode, \"scenario: \\(scenario.rawValue)\")\n48|      #expect(response.standardOutput.isEmpty)\n49|      #expect(response.standardError == \"m1-runtime injected \\(scenario.rawValue)\\n\")\n50|      #expect(!response.standardError.contains(profileUUID))\n51|    }\n52|  }\n53|\n54|  @Test(\n55|    \"HarnessApplication.run requires coordinator-observed SSH loss before mandatory exit\"\n56|  )\n57|  func productionEntryRequiresSSHHealthDelivery() async {\n58|    let response = await runM1(scenario: .midSessionSSHFailure, repetitions: 1)\n59|\n60|    #expect(response.exitCode == .m1MandatoryFailure)\n61|    #expect(response.standardError == \"m1-runtime injected mid-session-ssh-failure\\n\")\n62|  }\n63|\n64|  @Test(\n65|    \"HarnessApplication.run requires coordinator-observed DNS loss before mandatory exit\"\n66|  )\n67|  func productionEntryRequiresDNSHealthDelivery() async {\n68|    let response = await runM1(scenario: .midSessionDNSFailure, repetitions: 1)\n69|\n70|    #expect(response.exitCode == .m1MandatoryFailure)\n71|    #expect(response.standardError == \"m1-runtime injected mid-session-dns-failure\\n\")\n72|  }\n73|\n74|  @Test(\n75|    \"HarnessApplication.run forwards after releasing its real composition bootstrap owner\"\n76|  )\n77|  func productionEntryDoesNotRetainOrConsultHostOwner() async throws {\n78|    let response = await runM1(scenario: .success, repetitions: 1)\n79|\n80|    #expect(response.exitCode == .success)\n81|    let result = try JSONDecoder().decode(\n82|      HarnessResultDocument.self,\n83|      from: response.standardOutput\n84|    )\n85|    #expect(result.metrics.counters[\"harness.m1.tcp_fixture_exchanges_total\"] == 1)\n86|    #expect(result.metrics.counters[\"harness.m1.dns_fixture_exchanges_total\"] == 1)\n87|    #expect(result.metrics.gauges[\"harness.m1.host_owner_retained\"] == 0)\n88|  }\n89|\n90|  @Test(\n91|    \"HarnessApplication.run production gate admits exact repetition bound and rejects narrower violations\"\n92|  )\n93|  func productionConfigurationGate() async {\n94|    let maximum = await runM1(scenario: .success, repetitions: 8)\n95|    #expect(maximum.exitCode == .success)\n96|\n97|    let aboveMaximum = await runM1(\n98|      scenario: .success,\n99|      repetitions: 9\n100|    )\n101|    #expect(aboveMaximum.exitCode == .usage)\n102|    #expect(aboveMaximum.standardError == \"m1-runtime repetitions must be in 1...8\\n\")\n103|\n104|    let unknown = await runM1(\n105|      configuration: configuration(scenarioValue: \"general-udp\", repetitions: 1)\n106|    )\n107|    #expect(unknown.exitCode == .usage)\n108|    #expect(unknown.standardError == \"m1-runtime unsupported scenario\\n\")\n109|\n110|    let hiddenControl = await runM1(\n111|      configuration: configuration(\n112|        scenarioValue: M1RuntimeHarnessScenario.success.rawValue,\n113|        repetitions: 1,\n114|        scenarioPrivacy: .sensitive\n115|      )\n116|    )\n117|    #expect(hiddenControl.exitCode == .usage)\n118|    #expect(hiddenControl.standardError == \"m1-runtime control parameters must be public\\n\")\n119|\n120|    let exposedProfile = await runM1(\n121|      configuration: configuration(\n122|        scenarioValue: M1RuntimeHarnessScenario.success.rawValue,\n123|        repetitions: 1,\n124|        profilePrivacy: .public\n125|      )\n126|    )\n127|    #expect(exposedProfile.exitCode == .usage)\n128|    #expect(exposedProfile.standardError == \"m1-runtime profile reference must be sensitive\\n\")\n129|\n130|    let repeatedFault = await runM1(scenario: .dnsFailure, repetitions: 2)\n131|    #expect(repeatedFault.exitCode == .usage)\n132|    #expect(repeatedFault.standardError == \"m1-runtime failure scenarios require repetitions=1\\n\")\n133|\n134|    let missingRevision = await runM1(\n135|      configuration: configuration(\n136|        scenarioValue: M1RuntimeHarnessScenario.success.rawValue,\n137|        repetitions: 1,\n138|        dependencyRevisions: [\"runtime-contract\": \"m1-v1\"]\n139|      )\n140|    )\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
