  1079	        scheduleByteRekeyIfNeeded()
  1080	        return data
  1081	      }
  1082	      if result == 0, libssh2_channel_eof(record.pointer) != 0 {
  1083	        await emit(.channelEOF(channel: identity, direction: .remoteRead))
  1084	        return nil
  1085	      }
  1086	      guard result == LIBSSH2_ERROR_EAGAIN || result == 0 else {
  1087	        throw engineError(
  1088	          Int32(result),
  1089	          phase: .channelRead,
  1090	          fallback: .connectionLost
  1091	        )
  1092	      }
  1093	      try await progress(until: deadline, phase: .channelRead)
  1094	    }
  1095	  }
