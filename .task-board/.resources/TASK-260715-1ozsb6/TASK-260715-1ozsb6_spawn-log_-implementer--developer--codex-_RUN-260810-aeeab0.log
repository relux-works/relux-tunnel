   847	  func channelCancel(identity: SSHChannelIdentity) async {
   848	    guard channels[identity] != nil else { return }
   849	    counters.channelsCancelled += 1
   850	    await metric(.increment(.channelsCancelled, by: 1))
   851	    await emit(.channelCancelled(identity))
   852	    await channelDispose(identity: identity, terminalEvent: nil)
   853	  }
   854	
   855	  func channelReset(identity: SSHChannelIdentity) async {
   856	    guard channels[identity] != nil else { return }
   857	    counters.channelsReset += 1
   858	    await metric(.increment(.channelsReset, by: 1))
   859	    await emit(.channelReset(identity))
   860	    await channelDispose(identity: identity, terminalEvent: nil)
   861	  }
   862	
   863	  func channelClose(identity: SSHChannelIdentity) async {
   864	    guard let record = channels[identity] else { return }
   865	    if let configuration {
   866	      let deadline = dependencies.clock.now().advanced(by: configuration.timeouts.channelClose)
   867	      while true {
   868	        let result = libssh2_channel_close(record.pointer)
   869	        if result == 0 { break }
   870	        if result != LIBSSH2_ERROR_EAGAIN { break }
   871	        do { try await cleanupProgress(until: deadline) } catch { break }
   872	      }
   873	    }
   874	    counters.channelsClosedGracefully += 1
   875	    await metric(.increment(.channelsClosedGracefully, by: 1))
   876	    await channelDispose(identity: identity, terminalEvent: .channelClosed(identity))
   877	  }
   878	
   879	  private func channelDispose(
   880	    identity: SSHChannelIdentity,
   881	    terminalEvent: SSHTransportEventKind?
   882	  ) async {
   883	    guard let record = channels.removeValue(forKey: identity) else { return }
   884	    let deadline = dependencies.clock.now().advanced(
   885	      by: configuration?.timeouts.channelClose ?? .seconds(1)
   886	    )
   887	    while libssh2_channel_free(record.pointer) == LIBSSH2_ERROR_EAGAIN {
   888	      do { try await cleanupProgress(until: deadline) } catch { break }
   889	    }
   890	    if let terminalEvent { await emit(terminalEvent) }
   891	  }
   892	
   893	  private func scheduleByteRekeyIfNeeded() {
   894	    guard let configuration, !byteRekeyScheduled else { return }
   895	    let threshold = configuration.rekey.protectedByteThresholdPerDirection
   896	    guard
   897	      counters.protectedBytesSent - rekeySentBytesBaseline >= threshold
   898	        || counters.protectedBytesReceived - rekeyReceivedBytesBaseline >= threshold
   899	    else { return }
   900	    byteRekeyScheduled = true
   901	    Task { [weak self] in
   902	      try? await self?.requestRekey(reason: .byteThreshold)
   903	      await self?.clearByteRekeySchedule()
   904	    }
   905	  }
   906	
   907	  private func clearByteRekeySchedule() {
   908	    byteRekeyScheduled = false
   909	  }
   910	
   911	  private func directTCPIPMessage(
   912	    destination: TunnelEndpoint,
   913	    originator: TunnelEndpoint
   914	  ) -> Data {
   915	    var data = Data()
   916	    appendSSHString(destination.host, to: &data)
   917	    appendUInt32(UInt32(destination.port), to: &data)
   918	    appendSSHString(originator.host, to: &data)
   919	    appendUInt32(UInt32(originator.port), to: &data)
   920	    return data
   921	  }
   922	
   923	  private func appendSSHString(_ value: String, to data: inout Data) {
   924	    let bytes = Data(value.utf8)
   925	    appendUInt32(UInt32(clamping: bytes.count), to: &data)
   926	    data.append(bytes)
   927	  }
   928	
   929	  private func appendUInt32(_ value: UInt32, to data: inout Data) {
   930	    var bigEndian = value.bigEndian
   931	    withUnsafeBytes(of: &bigEndian) { data.append(contentsOf: $0) }
   932	  }
   933	
   934	  private func execSignalName(_ value: String) -> SSHExecSignalName {
   935	    switch value.uppercased() {
   936	    case "HUP": .hangup
   937	    case "INT": .interrupt
   938	    case "QUIT": .quit
   939	    case "ILL": .illegalInstruction
   940	    case "ABRT": .abort
   941	    case "FPE": .floatingPointException
   942	    case "KILL": .kill
   943	    case "SEGV": .segmentationFault
   944	    case "PIPE": .pipe
   945	    case "ALRM": .alarm
   946	    case "TERM": .terminate
   947	    default: .other(value)
   948	    }
   949	  }
   950	
   951	  private func tearDown() async {
   952	    automaticRekeyTask?.cancel()
   953	    automaticKeepaliveTask?.cancel()
   954	    automaticRekeyTask = nil
   955	    automaticKeepaliveTask = nil
   956	    let deadline = dependencies.clock.now().advanced(
   957	      by: configuration?.timeouts.transportClose ?? .seconds(1)
   958	    )
   959	    for identity in Array(channels.keys) {
   960	      await channelDispose(identity: identity, terminalEvent: .channelClosed(identity))
   961	    }
   962	    if let engineSession {
   963	      while libssh2_session_disconnect_ex(
   964	        engineSession,
   965	        Int32(SSH_DISCONNECT_BY_APPLICATION),
   966	        "closed",
   967	        ""
   968	      ) == LIBSSH2_ERROR_EAGAIN {
   969	        do { try await cleanupProgress(until: deadline) } catch { break }
   970	      }
   971	      var freeResult = libssh2_session_free(engineSession)
   972	      while freeResult == LIBSSH2_ERROR_EAGAIN {
   973	        do { try await cleanupProgress(until: deadline) } catch { break }
   974	        freeResult = libssh2_session_free(engineSession)
   975	      }
   976	      if freeResult == LIBSSH2_ERROR_EAGAIN {
   977	        context.network.fail()
   978	        _ = libssh2_session_free(engineSession)
   979	      }
   980	      self.engineSession = nil
   981	    }
   982	    context.network.discard()
   983	    await connection?.close()
   984	    connection = nil
   985	    negotiatedAlgorithms = nil
   986	    if state != .closed {
   987	      if state != .closing { try? await transition(to: .closing) }
   988	      try? await transition(to: .closed)
   989	    }
   990	  }
   991	
   992	  private func cleanupProgress(until deadline: ContinuousClock.Instant) async throws {
   993	    let now = dependencies.clock.now()
   994	    guard now < deadline else { throw LibSSH2TimeoutError.elapsed }
   995	    guard let connection, let engineSession else { return }
   996	    let directions = libssh2_session_block_directions(engineSession)
   997	    var interests = Set<SSHTCPReadiness>()
   998	    if directions & LIBSSH2_SESSION_BLOCK_INBOUND != 0 { interests.insert(.readable) }
   999	    if directions & LIBSSH2_SESSION_BLOCK_OUTBOUND != 0 { interests.insert(.writable) }
  1000	    if interests.isEmpty { interests = [.readable, .writable] }
  1001	    let requestedInterests = interests
  1002	    try await withTimeout(now.duration(to: deadline), clock: dependencies.clock) {
  1003	      try await self.context.network.service(
  1004	        connection: connection,
  1005	        interests: requestedInterests
  1006	      )
  1007	    }
  1008	  }
  1009	
  1010	  private func transition(to next: SSHConnectionState) async throws {
  1011	    guard state.permitsTransition(to: next) else {
  1012	      throw transportError(code: .invalidState, phase: phase(for: state))
  1013	    }
  1014	    let previous = state
  1015	    state = next
  1016	    await emit(.connectionTransition(from: previous, to: next))
  1017	  }
  1018	
  1019	  private func recordHostDecision(_ decision: SSHHostKeyDecision) async {
  1020	    switch decision.outcome {
  1021	    case .firstUseAccepted:
  1022	      counters.hostFirstUseAccepted += 1
  1023	      await metric(.increment(.hostFirstUseAccepted, by: 1))
  1024	    case .matchAccepted:
  1025	      counters.hostMatchAccepted += 1
  1026	      await metric(.increment(.hostMatchAccepted, by: 1))
  1027	    case .unknownRejected:
  1028	      counters.hostUnknownRejected += 1
  1029	      await metric(.increment(.hostUnknownRejected, by: 1))
  1030	    case .changedRejected:
  1031	      counters.hostChangedRejected += 1
  1032	      await metric(.increment(.hostChangedRejected, by: 1))
  1033	    case .algorithmRejected:
  1034	      counters.hostAlgorithmRejected += 1
  1035	      await metric(.increment(.hostAlgorithmRejected, by: 1))
  1036	    case .policyRejected:
  1037	      break
  1038	    }
  1039	    await emit(.hostDecision(decision.outcome))
  1040	  }
  1041	
  1042	  private func incrementRekeyCounter(_ reason: SSHClientRekeyReason) {
  1043	    switch reason {
  1044	    case .byteThreshold: counters.clientByteRekeys += 1
  1045	    case .timeThreshold: counters.clientTimeRekeys += 1
  1046	    case .test, .manual: counters.explicitRekeys += 1
  1047	    }
  1048	  }
  1049	
  1050	  private func checkCancellation(phase: SSHTransportPhase) throws {
  1051	    do {
  1052	      try dependencies.cancellation.checkCancellation()
  1053	      try Task.checkCancellation()
  1054	    } catch {
  1055	      counters.operationsCancelled += 1
  1056	      throw transportError(code: .cancelled, phase: phase)
  1057	    }
  1058	  }
  1059	
  1060	  private func emit(_ kind: SSHTransportEventKind) async {
  1061	    await reconcileProtectedMetrics()
  1062	    let event = SSHTransportEvent(timestamp: dependencies.clock.now(), kind: kind)
  1063	    await dependencies.observer.observe(event)
  1064	    await dependencies.logger.log(level: .info, event: event)
  1065	    await dependencies.experimentRecorder?.record(.event(event))
  1066	  }
  1067	
  1068	  private func metric(_ update: SSHMetricUpdate) async {
  1069	    await dependencies.metrics.record(update)
  1070	  }
  1071	
  1072	  private func reconcileProtectedMetrics() async {
  1073	    guard let baseline = protectedNetworkBaseline else { return }
  1074	    let current = context.network.engineByteCounts
  1075	    let sent = current.sent - baseline.sent
  1076	    let received = current.received - baseline.received
  1077	    if sent > counters.protectedBytesSent {
  1078	      await metric(.increment(.protectedBytesSent, by: sent - counters.protectedBytesSent))
  1079	      counters.protectedBytesSent = sent
  1080	    }
  1081	    if received > counters.protectedBytesReceived {
  1082	      await metric(
  1083	        .increment(.protectedBytesReceived, by: received - counters.protectedBytesReceived))
  1084	      counters.protectedBytesReceived = received
  1085	    }
  1086	  }
  1087	
  1088	  private func phase(for state: SSHConnectionState) -> SSHTransportPhase {
  1089	    switch state {
  1090	    case .idle: .configuration
  1091	    case .resolving: .resolution
  1092	    case .tcpConnecting: .tcpConnect
  1093	    case .keyExchange: .initialKeyExchange
  1094	    case .awaitingHostDecision: .hostDecision
  1095	    case .authenticating: .authentication
  1096	    case .ready: .protocolProcessing
  1097	    case .rekeying: .rekey
  1098	    case .failed: .protocolProcessing
  1099	    case .closing, .closed: .transportClose
  1100	    }
  1101	  }
  1102	
  1103	  private func engineError(
  1104	    _ engineCode: Int32,
  1105	    phase: SSHTransportPhase,
  1106	    fallback: SSHTransportErrorCode
  1107	  ) -> SSHTransportError {
  1108	    let code: SSHTransportErrorCode
  1109	    switch engineCode {
  1110	    case LIBSSH2_ERROR_AUTHENTICATION_FAILED: code = .authenticationRejected
  1111	    case LIBSSH2_ERROR_PUBLICKEY_UNVERIFIED, LIBSSH2_ERROR_PUBLICKEY_PROTOCOL:
  1112	      code = .signatureFailed
  1113	    case LIBSSH2_ERROR_CHANNEL_FAILURE: code = .channelOpenRejected
  1114	    case LIBSSH2_ERROR_CHANNEL_REQUEST_DENIED: code = .execRejected
  1115	    case LIBSSH2_ERROR_CHANNEL_CLOSED, LIBSSH2_ERROR_CHANNEL_EOF_SENT: code = .channelClosed
  1116	    case LIBSSH2_ERROR_ALLOC: code = .resourceLimitExceeded
  1117	    case LIBSSH2_ERROR_SOCKET_SEND, LIBSSH2_ERROR_SOCKET_RECV,
  1118	      LIBSSH2_ERROR_SOCKET_DISCONNECT:
  1119	      code = .connectionLost
  1120	    case LIBSSH2_ERROR_TIMEOUT, LIBSSH2_ERROR_SOCKET_TIMEOUT: code = .timedOut
  1121	    default: code = fallback
  1122	    }
  1123	    return transportError(code: code, phase: phase)
  1124	  }
  1125	
  1126	  private func map(
  1127	    _ error: Error,
  1128	    phase: SSHTransportPhase,
  1129	    fallback: SSHTransportErrorCode = .adapterFailure
  1130	  ) -> SSHTransportError {
  1131	    if let error = error as? SSHTransportError { return error }
  1132	    if error is CancellationError { return transportError(code: .cancelled, phase: phase) }
  1133	    if error is LibSSH2TimeoutError { return transportError(code: .timedOut, phase: phase) }
  1134	    return transportError(code: fallback, phase: phase)
  1135	  }
  1136	
  1137	  private func transportError(
  1138	    code: SSHTransportErrorCode,
  1139	    phase: SSHTransportPhase,
  1140	    scope: SSHTransportErrorScope? = nil
  1141	  ) -> SSHTransportError {
  1142	    try! SSHTransportError(
  1143	      code: code,
  1144	      phase: phase,
  1145	      scope: scope ?? .lane(lane),
  1146	      retryDisposition: code == .cancelled || code == .timedOut ? .newConnection : .never,
  1147	      requiresTeardown: scope == nil,
  1148	      channelOpenReason: code == .channelOpenRejected ? .unsupported : .notApplicable
  1149	    )
  1150	  }
  1151	}
  1152	
  1153	private enum LibSSH2TimeoutError: Error {
  1154	  case elapsed
  1155	}
  1156	
  1157	private func withTimeout<Value: Sendable>(
  1158	  _ timeout: Duration,
  1159	  clock: any TunnelClock,
  1160	  operation: @escaping @Sendable () async throws -> Value
  1161	) async throws -> Value {
  1162	  try await withThrowingTaskGroup(of: Value.self) { group in
  1163	    group.addTask { try await operation() }
  1164	    group.addTask {
  1165	      try await clock.sleep(for: timeout)
  1166	      throw LibSSH2TimeoutError.elapsed
  1167	    }
  1168	    guard let result = try await group.next() else { throw LibSSH2TimeoutError.elapsed }
  1169	    group.cancelAll()
  1170	    return result
  1171	  }
  1172	}
  1173	
  1174	extension Duration {
  1175	  fileprivate var wholeSeconds: Int64 {
  1176	    let components = components
  1177	    let fractional = components.attoseconds == 0 ? 0 : 1
  1178	    return max(1, components.seconds + Int64(fractional))
  1179	  }
