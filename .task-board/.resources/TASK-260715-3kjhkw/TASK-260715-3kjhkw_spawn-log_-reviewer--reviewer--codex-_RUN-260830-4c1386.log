   421	  public mutating func reserveInitial(
   422	    channel: SSHChannelIdentity,
   423	    lane: SSHLaneIdentity,
   424	    channelClass: SSHReceiveWindowClass,
   425	    generation: UInt64,
   426	    bulkMeasurement: SSHBulkPathMeasurement? = nil
   427	  ) throws -> SSHReceiveWindowInitialDecision {
   428	    do {
   429	      guard reservations[channel] == nil, !releasedChannels.contains(channel) else {
   430	        throw SSHReceiveWindowRefusal.duplicateChannel
   431	      }
   432	      let currentLane = try availableLane(lane, generation: generation)
   433	      try permitInitial(channelClass)
   434	      let limits = configuration.classLimits[channelClass]!
   435	      var initial = try Self.initialCandidate(
   436	        for: channelClass, measurement: bulkMeasurement, configuration: configuration)
   437	      if pressure == .soft {
   438	        initial = min(initial, configuration.softInitialWindowCapBytes)
   439	      }
   440	      guard initial <= limits.maximumAdvertisedWindowBytes,
   441	        initial <= configuration.perChannelWindowCeilingBytes
   442	      else { throw SSHReceiveWindowRefusal.perChannelCeiling }
   443	      let fixed = try SSHReceiveWindowBudgetConfiguration.checkedSum(
   444	        [
   445	          limits.readBufferCapacityBytes,
   446	          limits.writeCapacityBytes,
   447	          limits.metadataCapacityBytes,
   448	        ], field: "channelFixedCapacity")
   449	      let charge = try SSHReceiveWindowBudgetConfiguration.checkedSum(
   450	        [initial, fixed], field: "channelInitialCapacity")
   451	      guard
   452	        fits(
   453	          used: laneReservedBytes(currentLane.identity), adding: initial,
   454	          ceiling: configuration.perLaneWindowCeilingBytes)
   455	      else { throw SSHReceiveWindowRefusal.perLaneCeiling }
   456	      guard
   457	        fits(
   458	          used: globalWindowReservedBytes, adding: initial,
   459	          ceiling: configuration.globalWindowCeilingBytes)
   460	      else { throw SSHReceiveWindowRefusal.globalWindowCeiling }
   461	      guard
   462	        fits(
   463	          used: ledgerCommittedBytes, adding: charge,
   464	          ceiling: configuration.globalLedgerCeilingBytes)
   465	      else { throw SSHReceiveWindowRefusal.globalLedgerCeiling }
   466	
   467	      reservations[channel] = SSHReceiveWindowReservation(
   468	        channel: channel,
   469	        lane: lane,
   470	        channelClass: channelClass,
   471	        generation: generation,
   472	        capBytes: limits.maximumAdvertisedWindowBytes,
   473	        lowWaterBytes: limits.lowWaterBytes,
   474	        fixedCapacityBytes: fixed,
   475	        reservedWindowBytes: initial)
   476	      metrics.initialReservations += 1
   477	      return SSHReceiveWindowInitialDecision(
   478	        channel: channel,
   479	        lane: lane,
   480	        channelClass: channelClass,
   481	        generation: generation,
   482	        initialWindowBytes: initial,
   483	        maximumAdvertisedWindowBytes: limits.maximumAdvertisedWindowBytes,
   484	        lowWaterBytes: limits.lowWaterBytes,
   485	        readBufferCapacityBytes: limits.readBufferCapacityBytes,
   486	        writeCapacityBytes: limits.writeCapacityBytes,
   487	        maximumWriteCallBytes: min(initial, limits.writeCapacityBytes),
   488	        ledgerChargeBytes: charge)
   489	    } catch let refusal as SSHReceiveWindowRefusal {
   490	      recordRefusal(refusal)
   491	      throw refusal
   492	    }
   493	  }
   494	
   495	  public mutating func reserveAdjustment(
   496	    channel: SSHChannelIdentity,
   497	    generation: UInt64,
   498	    outstandingAdvertisedCreditBytes: Int
   499	  ) throws -> SSHReceiveWindowAdjustmentDecision {
   500	    do {
   501	      guard generation == self.generation else { throw SSHReceiveWindowRefusal.staleGeneration }
   502	      guard var reservation = reservations[channel] else {
   503	        throw releasedChannels.contains(channel)
   504	          ? SSHReceiveWindowRefusal.staleGeneration : SSHReceiveWindowRefusal.unknownChannel
   505	      }
   506	      _ = try availableLane(reservation.lane, generation: generation)
   507	      guard pressure == .normal || pressure == .soft else {
   508	        throw SSHReceiveWindowRefusal.memoryPressure
   509	      }
   510	      guard outstandingAdvertisedCreditBytes >= 0,
   511	        outstandingAdvertisedCreditBytes <= reservation.capBytes
   512	      else { throw SSHReceiveWindowRefusal.invalidOutstandingCredit }
   513	      guard outstandingAdvertisedCreditBytes <= reservation.lowWaterBytes else {
   514	        throw SSHReceiveWindowRefusal.aboveLowWater
   515	      }
   516	
   517	      let advertisedHeadroom = reservation.capBytes - outstandingAdvertisedCreditBytes
   518	      let reservationHeadroom = reservation.capBytes - reservation.reservedWindowBytes
   519	      let laneHeadroom =
   520	        configuration.perLaneWindowCeilingBytes - laneReservedBytes(reservation.lane)
   521	      let globalHeadroom = configuration.globalWindowCeilingBytes - globalWindowReservedBytes
   522	      let ledgerHeadroom = configuration.globalLedgerCeilingBytes - ledgerCommittedBytes
   523	      let delta = min(
   524	        advertisedHeadroom, reservationHeadroom, laneHeadroom, globalHeadroom, ledgerHeadroom)
   525	      guard delta > 0 else {
   526	        throw reservationHeadroom == 0
   527	          ? SSHReceiveWindowRefusal.noCreditNeeded : SSHReceiveWindowRefusal.insufficientReservation
   528	      }
   529	      let (after, overflow) = outstandingAdvertisedCreditBytes.addingReportingOverflow(delta)
   530	      guard !overflow, after <= reservation.capBytes else {
   531	        throw SSHReceiveWindowRefusal.immutableChannelCap
   532	      }
   533	      reservation.reservedWindowBytes += delta
   534	      reservations[channel] = reservation
   535	      metrics.adjustmentReservations += 1
   536	      metrics.adjustmentBytes = metrics.adjustmentBytes.saturatingAdd(UInt64(delta))
   537	      return SSHReceiveWindowAdjustmentDecision(
   538	        channel: channel,
   539	        beforeOutstandingCreditBytes: outstandingAdvertisedCreditBytes,
   540	        adjustmentBytes: delta,
   541	        afterOutstandingCreditBytes: after,
   542	        newlyReservedBytes: delta)
   543	    } catch let refusal as SSHReceiveWindowRefusal {
   544	      recordRefusal(refusal)
   545	      throw refusal
   546	    }
   547	  }
   548	
   549	  @discardableResult
   550	  public mutating func release(
   551	    channel: SSHChannelIdentity,
   552	    cause: SSHReceiveWindowReleaseCause
   553	  ) -> SSHReceiveWindowRelease {
   554	    guard let reservation = reservations.removeValue(forKey: channel) else {
   555	      releasedChannels.insert(channel)
   556	      metrics.duplicateReleases += 1
   557	      return SSHReceiveWindowRelease(
   558	        channel: channel,
   559	        cause: cause,
   560	        releasedWindowBytes: 0,
   561	        releasedLedgerBytes: 0,
   562	        wasAlreadyReleased: true)
   563	    }
   564	    releasedChannels.insert(channel)
   565	    metrics.releases += 1
   566	    metrics.releasedLedgerBytes = metrics.releasedLedgerBytes.saturatingAdd(
   567	      UInt64(reservation.ledgerChargeBytes))
   568	    return SSHReceiveWindowRelease(
   569	      channel: channel,
   570	      cause: cause,
   571	      releasedWindowBytes: reservation.reservedWindowBytes,
   572	      releasedLedgerBytes: reservation.ledgerChargeBytes,
   573	      wasAlreadyReleased: false)
   574	  }
   575	
   576	  @discardableResult
   577	  public mutating func releaseLane(
   578	    _ lane: SSHLaneIdentity,
   579	    cause: SSHReceiveWindowReleaseCause = .laneFailure
   580	  ) -> [SSHReceiveWindowRelease] {
   581	    reservations.values
   582	      .filter { $0.lane == lane }
   583	      .map(\.channel)
   584	      .sorted { $0.rawValue.uuidString < $1.rawValue.uuidString }
   585	      .map { release(channel: $0, cause: cause) }
   586	  }
   587	
   588	  public func snapshot() -> SSHReceiveWindowBudgetSnapshot {
   589	    SSHReceiveWindowBudgetSnapshot(
   590	      generation: generation,
   591	      reservedChannelCount: reservations.count,
   592	      managedWindowReservedBytes: managedWindowReservedBytes,
   593	      globalWindowReservedBytes: globalWindowReservedBytes,
   594	      ledgerCommittedBytes: ledgerCommittedBytes,
   595	      laneWindowReservedBytes: Dictionary(
   596	        uniqueKeysWithValues: lanes.keys.map { ($0, laneReservedBytes($0)) }),
   597	      metrics: metrics)
   598	  }
   599	
   600	  public static func initialCandidate(
   601	    for channelClass: SSHReceiveWindowClass,
   602	    measurement: SSHBulkPathMeasurement?,
   603	    configuration: SSHReceiveWindowBudgetConfiguration
   604	  ) throws -> Int {
   605	    switch channelClass {
   606	    case .control:
   607	      return configuration.controlInitialWindowBytes
   608	    case .ordinary:
   609	      return configuration.ordinaryInitialWindowBytes
   610	    case .bulk:
   611	      guard let measurement,
   612	        measurement.bandwidthBitsPerSecond > 0,
   613	        measurement.roundTripTimeNanoseconds > 0
   614	      else { throw SSHReceiveWindowRefusal.invalidMeasurement }
   615	      let bandwidth = min(
   616	        measurement.bandwidthBitsPerSecond,
   617	        configuration.maximumMeasuredBandwidthBitsPerSecond)
   618	      let rtt = min(
   619	        measurement.roundTripTimeNanoseconds,
   620	        configuration.maximumMeasuredRTTNanoseconds)
   621	      let bytes = ceilMultiplyDivide(bandwidth, rtt, by: 8_000_000_000)
   622	      let bounded = min(
   623	        UInt64(configuration.bulkMaximumWindowBytes),
   624	        max(UInt64(configuration.bulkMinimumWindowBytes), bytes))
   625	      return Int(bounded)
   626	    case .relay:
   627	      let framed = max(saturatingAdd(4, configuration.relayMaximumFrameBodyBytes), 64)
   628	      let burst = saturatingMultiply(configuration.relayBurstDatagramCount, framed)
   629	      return min(
   630	        configuration.relayMaximumWindowBytes,
   631	        saturatingAdd(configuration.relayControlWindowBytes, burst))
   632	    }
   633	  }
   634	
   635	  private var managedWindowReservedBytes: Int {
   636	    reservations.values.reduce(0) { $0 + $1.reservedWindowBytes }
   637	  }
   638	
   639	  private var globalWindowReservedBytes: Int {
   640	    otherGlobalWindowReservedBytes + managedWindowReservedBytes
   641	  }
   642	
   643	  private var ledgerCommittedBytes: Int {
   644	    otherLedgerCommittedBytes + reservations.values.reduce(0) { $0 + $1.ledgerChargeBytes }
   645	  }
   646	
   647	  private func laneReservedBytes(_ lane: SSHLaneIdentity) -> Int {
   648	    let external = lanes[lane]?.externallyReservedWindowBytes ?? 0
   649	    return external
   650	      + reservations.values.lazy.filter { $0.lane == lane }
   651	      .reduce(0) { $0 + $1.reservedWindowBytes }
   652	  }
   653	
   654	  private func availableLane(
   655	    _ lane: SSHLaneIdentity,
   656	    generation: UInt64
   657	  ) throws -> SSHReceiveWindowLane {
   658	    guard generation == self.generation else { throw SSHReceiveWindowRefusal.staleGeneration }
   659	    guard let lane = lanes[lane] else { throw SSHReceiveWindowRefusal.unknownLane }
   660	    guard lane.generation == generation else { throw SSHReceiveWindowRefusal.staleGeneration }
   661	    guard lane.state == .ready else { throw SSHReceiveWindowRefusal.laneUnavailable }
   662	    return lane
   663	  }
   664	
   665	  private func permitInitial(_ channelClass: SSHReceiveWindowClass) throws {
   666	    switch pressure {
   667	    case .normal, .soft:
   668	      return
   669	    case .pressure:
   670	      guard channelClass == .control || channelClass == .relay else {
   671	        throw SSHReceiveWindowRefusal.memoryPressure
   672	      }
   673	    case .critical:
   674	      throw SSHReceiveWindowRefusal.memoryPressure
   675	    }
   676	  }
   677	
   678	  private func fits(used: Int, adding: Int, ceiling: Int) -> Bool {
   679	    let (candidate, overflow) = used.addingReportingOverflow(adding)
   680	    return !overflow && candidate <= ceiling
   681	  }
   682	
   683	  private mutating func recordRefusal(_ refusal: SSHReceiveWindowRefusal) {
   684	    metrics.refusals[refusal, default: 0] = metrics.refusals[refusal, default: 0]
   685	      .saturatingAdd(1)
   686	  }
   687	}
   688	
   689	private func saturatingAdd(_ lhs: Int, _ rhs: Int) -> Int {
   690	  let (result, overflow) = lhs.addingReportingOverflow(rhs)
   691	  return overflow ? Int.max : result
   692	}
   693	
   694	private func saturatingMultiply(_ lhs: Int, _ rhs: Int) -> Int {
   695	  let (result, overflow) = lhs.multipliedReportingOverflow(by: rhs)
   696	  return overflow ? Int.max : result
   697	}
   698	
   699	private func ceilMultiplyDivide(_ lhs: UInt64, _ rhs: UInt64, by divisor: UInt64) -> UInt64 {
   700	  let quotient = lhs / divisor
   701	  let remainder = lhs % divisor
   702	  let (base, baseOverflow) = quotient.multipliedReportingOverflow(by: rhs)
   703	  if baseOverflow { return .max }
   704	  let product = remainder.multipliedFullWidth(by: rhs)
   705	  let division = divisor.dividingFullWidth(product)
   706	  let roundedFraction =
   707	    division.remainder == 0
   708	    ? division.quotient : division.quotient.saturatingAdd(1)
   709	  return base.saturatingAdd(roundedFraction)
   710	}
   711	
   712	extension UInt64 {
   713	  fileprivate func saturatingAdd(_ other: UInt64) -> UInt64 {
   714	    let (result, overflow) = addingReportingOverflow(other)
   715	    return overflow ? .max : result
   716	  }
   717	}

