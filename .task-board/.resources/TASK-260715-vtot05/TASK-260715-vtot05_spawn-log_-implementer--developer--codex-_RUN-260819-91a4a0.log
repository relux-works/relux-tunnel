+      "version": "go1.26.5",
+      "revision": "go1.26.5",
+      "contentSHA256": "efb87ff28af9a188d0536ef5d42e63dd52ba8263cd7344a993cc48dd11dedb6a",
+      "source": "https://go.dev/dl/go1.26.5.darwin-arm64.tar.gz",
+      "license": "BSD-3-Clause",
+      "licenseTextPath": "relay/licenses/Go-BSD-3-Clause.txt",
+      "licenseTextSHA256": "911f8f5782931320f5b8d1160a76365b83aea6447ee6c04fa6d5591467db9dad",
+      "noticeObligation": "include-full-license",
+      "approved": true,
+      "byteAffecting": true,
+      "distribution": "statically-linked"
+    }
+  ],
+  "metadataTools": [
+    {
+      "id": "syft",
+      "version": "1.48.0",
+      "revision": "3e2bc6ed095f7ec1a415fb38cfe1c319e95dfed6",
+      "contentSHA256": "fef3e6d5df336a0a4c3e421e503119d1e221cf82a3ef5e426a791fcd81667e87",
+      "license": "Apache-2.0",
+      "purpose": "build-time SPDX inspection; does not affect relay executable bytes"
+    }
+  ],
+  "artifactManifest": {
+    "sourceContract": "relay/asset-bundle-source-v1.json",
+    "schema": "relay/asset-manifest-v1.schema.json",
+    "manifestName": "relux-relay-assets-v1.json",
+    "archiveTaskID": "TASK-260715-24icoz",
+    "archiveResourceName": "TASK-260715-24icoz_portable-relay-assets.tar.gz",
+    "archiveSHA256": "1f0ba226ed591d1baf5f9464b33e45b7658a33bf5a1a114e77b6d22d3d9eef4e"
+  },
+  "runtimePolicy": {
+    "applicationCodeDownloadAllowed": false,
+    "relayExecutionSource": "application-bundled-hash-verified-assets-only",
+    "scanRoots": ["App", "Sources", "relay"],
+    "scanExtensions": [".go", ".swift"]
+  },
+  "boundary": [
+    {"control": "source pinning", "milestone": "M2", "owner": "relay build", "evidence": "source revision, tree and file SHA-256 inventory"},
+    {"control": "build reproducibility", "milestone": "M2", "owner": "relay build", "evidence": "pinned compiler, recipe, target matrix and deterministic command"},
+    {"control": "asset integrity", "milestone": "M2", "owner": "relay asset packaging", "evidence": "archive and four executable SHA-256 values plus manifest linkage"},
+    {"control": "license notices", "milestone": "M2", "owner": "relay supply-chain audit", "evidence": "generated product notice input with fail-closed coverage"},
+    {"control": "application signing", "milestone": "M5", "owner": "Apple release pipeline", "evidence": "signed app/archive verification"},
+    {"control": "notarization", "milestone": "M5", "owner": "Apple release pipeline", "evidence": "notarization submission and staple verification"},
+    {"control": "release attestation", "milestone": "M5", "owner": "release engineering", "evidence": "release-level attestation binding signed deliverables"},
+    {"control": "distribution approval", "milestone": "M5", "owner": "release approver", "evidence": "explicit release-channel approval"}
+  ],
+  "outputs": {
+    "inventory": "relay/dependency-inventory-v1.json",
+    "provenance": "relay/source-build-provenance-v1.json",
+    "notices": "relay/PRODUCT_NOTICES.txt"
+  }
+}
