   573	def generate_bundle(
   574	    archive: Path, bundle: Path, contract: dict[str, Any]
   575	) -> dict[str, Any]:
   576	    contents = read_archive_assets(archive, contract)
   577	    manifest = build_manifest(contract, contents)
   578	    validate_manifest(manifest, contract)
   579	    if bundle.exists() or bundle.is_symlink():
   580	        existing = validate_bundle(bundle, contract)
   581	        if existing != manifest:
   582	            raise AssetManifestError("existing relay asset bundle is stale")
   583	        return manifest
   584	    try:
   585	        bundle.mkdir(parents=True, mode=0o755)
   586	        for source, binary in zip(contract["assets"], contents, strict=True):
   587	            write_new_file(bundle / source["fileName"], binary, 0o755)
   588	        write_new_file(bundle / MANIFEST_NAME, stable_json(manifest), 0o644)
   589	    except Exception:
   590	        # Do not recursively remove an unexpected path. Only clean invocation-owned files.
   591	        for source in contract["assets"]:
   592	            candidate = bundle / source["fileName"]
   593	            if candidate.is_file() and not candidate.is_symlink():
   594	                candidate.unlink()
   595	        manifest_path = bundle / MANIFEST_NAME
   596	        if manifest_path.is_file() and not manifest_path.is_symlink():
   597	            manifest_path.unlink()
   598	        try:
   599	            bundle.rmdir()
   600	        except OSError:
   601	            pass
   602	        raise
   603	    validate_bundle(bundle, contract)
   604	    return manifest
   605
   606
   607	def verify_swift(path: Path, manifest: dict[str, Any]) -> None:
   608	    expected = render_swift(manifest)
   609	    actual = read_regular_file(path, "generated Swift relay asset lookup")
   610	    if actual != expected:
   611	        raise AssetManifestError("generated Swift relay asset lookup is stale")
   612
   613
   614	def parse_args() -> argparse.Namespace:
   615	    parser = argparse.ArgumentParser()
   616	    parser.add_argument(
   617	        "command", choices=("generate", "validate", "check", "render-swift")
   618	    )
   619	    parser.add_argument("--contract", type=Path, default=DEFAULT_CONTRACT)
   620	    parser.add_argument("--schema", type=Path, default=DEFAULT_SCHEMA)
   621	    parser.add_argument("--archive", type=Path, default=DEFAULT_ARCHIVE)
   622	    parser.add_argument("--bundle", type=Path, default=DEFAULT_BUNDLE)
   623	    parser.add_argument("--swift-output", type=Path, default=DEFAULT_SWIFT)
   624	    return parser.parse_args()
   625
   626
   627	def main() -> int:
   628	    arguments = parse_args()
   629	    try:
   630	        verify_schema(arguments.schema)
   631	        contract = load_source_contract(arguments.contract)
   632	        if arguments.command == "generate":
   633	            manifest = generate_bundle(arguments.archive, arguments.bundle, contract)
   634	            verify_swift(arguments.swift_output, manifest)
   635	        elif arguments.command == "validate":
   636	            validate_bundle(arguments.bundle, contract)
   637	        elif arguments.command == "check":
   638	            archive_contents = read_archive_assets(arguments.archive, contract)
   639	            expected = build_manifest(contract, archive_contents)
   640	            actual = validate_bundle(arguments.bundle, contract)
   641	            if actual != expected:
   642	                raise AssetManifestError("relay asset bundle regeneration drift")
   643	            verify_swift(arguments.swift_output, expected)
   644	        else:
   645	            contents = read_archive_assets(arguments.archive, contract)
   646	            sys.stdout.buffer.write(render_swift(build_manifest(contract, contents)))
   647	    except AssetManifestError as error:
   648	        print(f"error: {error}", file=sys.stderr)
   649	        return 1
   650	    if arguments.command != "render-swift":
   651	        print(f"relay asset manifest {arguments.command} passed")
   652	    return 0
   653
   654
   655	if __name__ == "__main__":
   656	    raise SystemExit(main())

