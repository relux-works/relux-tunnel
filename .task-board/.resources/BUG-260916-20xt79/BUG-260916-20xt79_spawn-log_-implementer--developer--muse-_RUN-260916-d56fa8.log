, .temporaryResourceExhaustion,\n607|      ]\n608|      let retry: SSHBootstrapRetryDisposition =\n609|        retryable.contains(cause) ? .retryableLater : .terminal\n610|      return (\n611|        .endpointConnectFailed,\n612|        stage,\n613|        retry.isRetryable ? .checkNetwork : .reviewProfile,\n614|        retry\n615|      )\n616|    case .algorithmNegotiation:\n617|      let retryable: Set<SSHBootstrapTransportCause> = [\n618|        .unavailable, .connectionReset, .connectionAborted,\n619|      ]\n620|      let retry: SSHBootstrapRetryDisposition =\n621|        retryable.contains(cause) ? .retryableLater : .terminal\n622|      return (\n623|        .negotiationFailed,\n624|        stage,\n625|        retry.isRetryable ? .retryLater : .reviewProfile,\n626|        retry\n627|      )\n628|    default:\n629|      return (.internalInvariant, stage, .contactSupport, .terminal)\n630|    }\n631|  }\n632|\n633|  private static func transportCause(_ error: SSHTransportError) -> SSHBootstrapInternalCause {\n634|    if error.code == .cancelled {\n635|      return .cancellation(.taskCancelled)\n636|    }\n637|    if error.code == .timedOut {\n638|      return .operationTimedOut(bootstrapStage(for: error.phase))\n639|    }\n640|    if [.connectionLost, .connectionClosed, .networkUnavailable, .peerReset].contains(error.code),\n641|      ![.resolution, .tcpConnect, .initialKeyExchange, .transportClose].contains(error.phase)\n642|    {\n643|      return .transportInterrupted(\n644|        bootstrapStage(for: error.phase), normalizedTransportCause(error.code))\n645|    }\n646|    switch error.phase {\n647|    case .resolution:\n648|      return .physicalPath(normalizedTransportCause(error.code))\n649|    case .tcpConnect:\n650|      return .endpointConnect(normalizedTransportCause(error.code))\n651|    case .configuration, .initialKeyExchange:\n652|      return .negotiation(normalizedTransportCause(error.code))\n653|    case .hostDecision:\n654|      return .host(hostCause(error.code))\n(more lines below)","final_result":true}}}
