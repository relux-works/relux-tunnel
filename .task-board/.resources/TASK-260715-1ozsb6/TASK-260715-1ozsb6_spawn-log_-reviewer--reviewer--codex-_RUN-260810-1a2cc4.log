  1981	private final class LoopbackSSHD {
  1982	  let port: UInt16
  1983	  private let directory: URL
  1984	  private let process: Process
  1985	
  1986	  init(publicKey: String) throws {
  1987	    guard FileManager.default.fileExists(atPath: "/usr/sbin/sshd") else {
  1988	      throw POSIXFixtureError.system(ENOENT)
  1989	    }
  1990	    directory = FileManager.default.temporaryDirectory.appendingPathComponent(
  1991	      "relux-libssh2-adapter-\(UUID().uuidString)",
  1992	      isDirectory: true
  1993	    )
  1994	    try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
  1995	    let hostKey = directory.appendingPathComponent("host-key")
  1996	    let authorizedKeys = directory.appendingPathComponent("authorized_keys")
  1997	    let configuration = directory.appendingPathComponent("sshd_config")
  1998	    let log = directory.appendingPathComponent("sshd.log")
  1999	    try Data("\(publicKey)\n".utf8).write(to: authorizedKeys, options: .atomic)
  2000	    try FileManager.default.setAttributes(
  2001	      [.posixPermissions: 0o600], ofItemAtPath: authorizedKeys.path)
  2002	    try runProcess(
  2003	      "/usr/bin/ssh-keygen",
  2004	      arguments: ["-q", "-t", "ed25519", "-N", "", "-f", hostKey.path]
  2005	    )
  2006	    port = try unusedLoopbackPort()
  2007	    let text = [
  2008	      "Port \(port)",
  2009	      "ListenAddress 127.0.0.1",
  2010	      "Protocol 2",
  2011	      "HostKey \(hostKey.path)",
  2012	      "PidFile \(directory.appendingPathComponent("sshd.pid").path)",
  2013	      "AuthorizedKeysFile \(authorizedKeys.path)",
  2014	      "StrictModes no",
  2015	      "PasswordAuthentication no",
  2016	      "KbdInteractiveAuthentication no",
  2017	      "PubkeyAuthentication yes",
  2018	      "UsePAM no",
  2019	      "PermitRootLogin no",
  2020	      "AllowUsers \(NSUserName())",
  2021	      "AllowTcpForwarding yes",
  2022	      "RekeyLimit 32K 0",
  2023	      "LogLevel DEBUG3",
  2024	      "",
  2025	    ].joined(separator: "\n")
  2026	    try Data(text.utf8).write(to: configuration, options: .atomic)
  2027	    try runProcess("/usr/sbin/sshd", arguments: ["-t", "-f", configuration.path])
  2028	
  2029	    process = Process()
  2030	    process.executableURL = URL(fileURLWithPath: "/usr/sbin/sshd")
  2031	    process.arguments = ["-D", "-E", log.path, "-f", configuration.path]
  2032	    try process.run()
  2033	    let deadline = ContinuousClock.now.advanced(by: .seconds(5))
  2034	    while ContinuousClock.now < deadline {
  2035	      if process.isRunning, let contents = try? String(contentsOf: log, encoding: .utf8),
  2036	        contents.contains("Server listening")
  2037	      {
  2038	        return
  2039	      }
  2040	      if !process.isRunning { break }
  2041	      Thread.sleep(forTimeInterval: 0.02)
  2042	    }
  2043	    stop()
  2044	    throw POSIXFixtureError.system(ECONNREFUSED)
  2045	  }
  2046	
  2047	  func stop() {
  2048	    if process.isRunning {
  2049	      process.terminate()
  2050	      let deadline = ContinuousClock.now.advanced(by: .milliseconds(500))
  2051	      while process.isRunning, ContinuousClock.now < deadline {
  2052	        Thread.sleep(forTimeInterval: 0.01)
  2053	      }
  2054	      if process.isRunning {
  2055	        Darwin.kill(process.processIdentifier, SIGKILL)
  2056	      }
  2057	    }
  2058	    try? FileManager.default.removeItem(at: directory)
  2059	  }
  2060	}
