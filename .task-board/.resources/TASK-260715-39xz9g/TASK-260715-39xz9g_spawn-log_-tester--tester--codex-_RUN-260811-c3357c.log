+{"algorithmProfiles":{"fallback":{"cipher":"aes128-ctr","hostKey":"ecdsa-sha2-nistp256","keyExchange":"diffie-hellman-group14-sha256","mac":"hmac-sha2-512","userKey":"ecdsa-sha2-nistp256"},"primary":{"cipher":"aes256-ctr","hostKey":"ssh-ed25519","keyExchange":"curve25519-sha256","mac":"hmac-sha2-256","userKey":"ssh-ed25519"}},"endpoints":[{"behavior":"read until EOF and discard after incremental byte/hash accounting","id":"sink","listen":"numeric IPv4 loopback with an ephemeral port"},{"behavior":"read and return exact bytes","id":"echo","listen":"numeric IPv4 loopback with an ephemeral port"},{"behavior":"accept then close before payload","id":"early-close","listen":"numeric IPv4 loopback with an ephemeral port"},{"behavior":"echo one read, close the write half, and continue draining the read half","id":"half-close","listen":"numeric IPv4 loopback with an ephemeral port"},{"behavior":"accept then close with SO_LINGER zero","id":"reset","listen":"numeric IPv4 loopback with an ephemeral port"},{"behavior":"read one bounded chunk then close the connection","id":"disconnect","listen":"numeric IPv4 loopback with an ephemeral port"}],"generatedAt":"2026-08-11T19:30:00Z","networkProfiles":[{"deterministicDropEvery":0,"id":"baseline","latencyMilliseconds":0},{"deterministicDropEvery":0,"id":"latency-75ms","latencyMilliseconds":75},{"deterministicDropEvery":10,"id":"loss-10-percent","latencyMilliseconds":0}],"payloadRetention":"none","reproduction":{"commands":["python3 scripts/ssh_matrix_fixture.py verify-manifest","swift test --filter approvedAlgorithmCompatibilityMatrix","swift test --filter everyUntrustedHostStopsBeforeCredentialsAndDestinationChannels","python3 scripts/ssh_matrix_fixture.py traffic-source --bytes 5368709120 --seed TASK-260715-39xz9g | python3 scripts/ssh_matrix_fixture.py traffic-sink --expected-bytes 5368709120 --expected-sha256 SHA256:fc01cfd7aebf90ff9491f8556131b6ef575c3e1fa33a0277ba28920bbaee7f54"],"ordering":"capture raw public host key before re