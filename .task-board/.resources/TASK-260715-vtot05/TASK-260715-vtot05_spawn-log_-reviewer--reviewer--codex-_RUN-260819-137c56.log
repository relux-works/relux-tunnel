   960	def c_or_go_lexical_tokens(text: str, *, language: str) -> list[tuple[str, str]]:
   961	    """Return comment-free C-family or Go tokens for the bounded audit."""
   962	    if language == "c-family":
   963	        text = re.sub(r"\\\r?\n", "", text)
   964	    tokens: list[tuple[str, str]] = []
   965	    index = 0
   966	    while index < len(text):
   967	        character = text[index]
   968	        if character.isspace():
   969	            index += 1
   970	            continue
   971	        if text.startswith("//", index):
   972	            newline = text.find("\n", index + 2)
   973	            index = len(text) if newline < 0 else newline + 1
   974	            continue
   975	        if text.startswith("/*", index):
   976	            index += 2
   977	            end = text.find("*/", index)
   978	            index = len(text) if end < 0 else end + 2
   979	            continue
   980	        if character in {'"', "'"} or (language == "go" and character == "`"):
   981	            quote = character
   982	            raw = quote == "`"
   983	            index += 1
   984	            content: list[str] = []
   985	            while index < len(text):
   986	                character = text[index]
   987	                if character == quote:
   988	                    index += 1
   989	                    break
   990	                if character == "\\" and not raw and index + 1 < len(text):
   991	                    content.extend((character, text[index + 1]))
   992	                    index += 2
   993	                    continue
   994	                content.append(character)
   995	                index += 1
   996	            tokens.append(("string", "".join(content)))
   997	            continue
   998	        identifier = re.match(r"[A-Za-z_][A-Za-z0-9_]*", text[index:])
   999	        if identifier is not None:
  1000	            value = identifier.group(0)
  1001	            tokens.append(("identifier", value))
  1002	            index += len(value)
  1003	            continue
  1004	        if language == "c-family" and (
  1005	            text.startswith("##", index) or text.startswith("%:%:", index)
  1006	        ):
  1007	            tokens.append(("symbol", "##"))
  1008	            index += 2 if text.startswith("##", index) else 4
  1009	            continue
  1010	        tokens.append(("symbol", character))
  1011	        index += 1
  1012	    return tokens
