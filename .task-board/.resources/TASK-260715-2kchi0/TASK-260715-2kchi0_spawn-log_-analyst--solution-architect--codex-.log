+}
+
+reject() {
+  if check-jsonschema --schemafile "$schema" "$2" >"$output_dir/$1.reject.log" 2>&1; then
+    echo "unexpected schema acceptance: $1" >&2
+    exit 1
+  fi
+}
+
+merge() {
+  jq -s '.[0] * .[1]' "$1" "$2" >"$3"
+}
+
+check-jsonschema --check-metaschema "$schema" >"$output_dir/metaschema.log"
+accept base "$base"
+
+merge "$base" "$fixtures/TASK-260715-2kchi0_equality-boundary-valid.overlay.json" "$output_dir/equality.json"
