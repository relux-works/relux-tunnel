MAX_ASSET_BYTES = 16 * 1024 * 1024
MAX_ARCHIVE_BYTES = 32 * 1024 * 1024
MAX_ARCHIVE_TRAILER_BYTES = 64 * 1024
READ_CHUNK_BYTES = 1024 * 1024
TARGETS = (
