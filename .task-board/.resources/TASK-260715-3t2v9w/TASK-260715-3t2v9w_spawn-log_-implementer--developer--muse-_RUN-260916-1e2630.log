{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c45b","stream":{"kind":"session","id":"01a0aa7a-9815-7302-a96f-7a8fde67c84b"},"sequence":136,"recorded_at":1780531400000267,"record_type":"event","durability":"durable","causation_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","run_stream":{"kind":"run","id":"7cb39f37-e5ea-43fc-a612-eaf97474622d"},"task_stream":{"kind":"task","id":"01a0aa7a-e7da-7733-a88b-6a43603e4136"},"task_id":"01a0aa7a-e7da-7733-a88b-6a43603e4136","event":{"kind":"output","task_id":"01a0aa7a-e7da-7733-a88b-6a43603e4136","chunk":"Read text file `Sources/ReluxTunnelMacOSAdapter/MacOSProductionSSHBootstrap.swift`.\n1|import Foundation\n2|import ReluxTunnelCore\n3|\n4|/// Immutable profile lookup captured by the provider before runtime startup.\n5|/// Live provider objects and callbacks never cross this boundary.\n6|public protocol MacOSProductionSSHProfileSource: Sendable {\n7|  func loadProfile(\n8|    for configuration: RuntimeConfigurationSnapshot\n9|  ) async throws -> SSHProfileSnapshotV1\n10|}\n11|\n12|/// Builds non-secret connection policy from an immutable validated profile.\n13|/// The production root separately owns transport, host policy, and credentials.\n14|public protocol MacOSProductionSSHConnectionConfigurationBuilding: Sendable {\n15|  func makeConnectionConfiguration(\n16|    profile: SSHProfileSnapshotV1,\n17|    runtimeConfiguration: RuntimeConfigurationSnapshot,\n18|    capabilities: SSHAdapterCapabilities\n19|  ) throws -> SSHConnectionConfiguration\n20|}\n21|\n22|/// Candidate-neutral platform services required by the selected SSH adapter.\n23|/// Security-critical host-policy and credential dependencies are deliberately\n24|/// absent: the production root supplies those itself.\n25|public struct MacOSProductionSSHRuntimeServices: Sendable {\n26|  public let profileSource: any MacOSProductionSSHProfileSource\n27|  public let configurationBuilder: any MacOSProductionSSHConnectionConfigurationBuilding\n28|  public let resolver: any SSHNetworkResolver\n29|  public let connector: any SSHTCPConnector\n30|  public let logger: any SSHTransportLogger\n31|  public let observer: any SSHTransportObserver\n32|  public let metrics: any SSHTransportMetricsSink\n33|  public let identityGenerator: any SSHIdentityGenerator\n34|\n35|  public init(\n36|    profileSource: any MacOSProductionSSHProfileSource,\n37|    configurationBuilder: any MacOSProductionSSHConnectionConfigurationBuilding,\n38|    resolver: any SSHNetworkResolver,\n39|    connector: any SSHTCPConnector,\n40|    logger: any SSHTransportLogger,\n41|    observer: any SSHTransportObserver,\n42|    metrics: any SSHTransportMetricsSink,\n43|    identityGenerator: any SSHIdentityGenerator\n44|  ) {\n45|    self.profileSource = profileSource\n46|    self.configurationBuilder = configurationBuilder\n47|    self.resolver = resolver\n48|    self.connector = connector\n49|    self.logger = logger\n50|    self.observer = observer\n51|    self.metrics = metrics\n52|    self.identityGenerator = identityGenerator\n53|  }\n54|}\n55|\n56|struct MacOSSelectedSSHDependencies: Sendable {\n57|  let transportFactory: any SSHTransportFactory\n58|  let credentialProvider: any SSHCredentialProvider\n59|  let makeHostKeyPolicy: @Sendable (SSHProfileSnapshotV1) throws -> any SSHHostKeyPolicy\n60|  let mapCredentialError:\n61|    @Sendable (MacOSCredentialResolverError, UInt64) -> SSHBootstrapProviderError\n62|}\n63|\n64|struct MacOSProductionSSHBootstrap: SSHBootstrap {\n65|  let selected: MacOSSelectedSSHDependencies\n66|  let services: MacOSProductionSSHRuntimeServices\n67|  let environment: TunnelRuntimeDependencies\n68|  let channelPolicy: SSHChannelPolicy\n69|\n70|  func authenticate(\n71|    configuration: RuntimeConfigurationSnapshot,\n72|    runtimeGeneration: UInt64,\n73|    healthSink: any TunnelRuntimeHealthEventSink\n74|  ) async throws -> any SSHBootstrapSession {\n75|    let profile: SSHProfileSnapshotV1\n76|    do {\n77|      profile = try await services.profileSource.loadProfile(for: configuration)\n78|      try Self.validate(profile: profile, runtimeConfiguration: configuration)\n79|    } catch let error as SSHProfileSnapshotLoaderError {\n80|      throw SSHBootstrapErrorMapper.profile(\n81|        error,\n82|        configurationGeneration: configuration.configurationGeneration\n83|      )\n84|    } catch let error as SSHBootstrapProviderError {\n85|      throw error\n86|    } catch {\n87|      throw SSHBootstrapErrorMapper.profile(\n88|        .profileCorrupt,\n89|        configurationGeneration: configuration.configurationGeneration\n90|      )\n91|    }\n92|\n93|    let hostPolicy: any SSHHostKeyPolicy\n94|    let connectionConfiguration: SSHConnectionConfiguration\n95|    do {\n96|      hostPolicy = try selected.makeHostKeyPolicy(profile)\n97|      connectionConfiguration = try services.configurationBuilder.makeConnectionConfiguration(\n98|        profile: profile,\n99|        runtimeConfiguration: configuration,\n100|        capabilities: selected.transportFactory.capabilities\n101|      )\n102|      try Self.validate(\n103|        connectionConfiguration: connectionConfiguration,\n104|        profile: profile,\n105|        runtimeConfiguration: configuration,\n106|        capabilities: selected.transportFactory.capabilities\n107|      )\n108|    } catch let error as SSHBootstrapProviderError {\n109|      throw error\n110|    } catch {\n111|      throw SSHBootstrapErrorMapper.profile(\n112|        .profileInvalidField(.providerConfiguration),\n113|        configurationGeneration: configuration.configurationGeneration\n114|      )\n115|    }\n116|\n117|    let lane = services.identityGenerator.makeLaneIdentity()\n118|    let dependencies = SSHTransportDependencies(\n119|      resolver: services.resolver,\n120|      connector: services.connector,\n121|      hostKeyPolicy: hostPolicy,\n122|      credentialProvider: selected.credentialProvider,\n123|      clock: environment.clock,\n124|      cancellation: environment.cancellation,\n125|      logger: services.logger,\n126|      observer: services.observer,\n127|      metrics: services.metrics,\n128|      identityGenerator: services.identityGenerator\n129|    )\n130|\n131|    let transport: any SSHTransport\n132|    do {\n133|      transport = try await selected.transportFactory.makeTransport(\n134|        lane: lane,\n135|        dependencies: dependencies\n136|      )\n137|    } catch {\n138|      throw Self.map(\n139|        error,\n140|        configurationGeneration: configuration.configurationGeneration,\n141|        selected: selected\n142|      )\n143|    }\n144|\n145|    do {\n146|      _ = try await transport.connect(configuration: connectionConfiguration)\n147|      return MacOSProductionSSHBootstrapSession(\n148|        transport: transport,\n149|        connectedEndpoint: connectionConfiguration.endpoint,\n150|        channelPolicy: channelPolicy,\n151|        runtimeGeneration: runtimeGeneration,\n152|        healthSink: healthSink\n153|      )\n154|    } catch {\n155|      await transport.close()\n156|      throw Self.map(\n157|        error,\n158|        configurationGeneration: configuration.configurationGeneration,\n159|        selected: selected\n160|      )\n161|    }\n162|  }\n163|\n164|  private static func validate(\n165|    profile: SSHProfileSnapshotV1,\n166|    runtimeConfiguration: RuntimeConfigurationSnapshot\n167|  ) throws {\n168|    guard profile.configurationGeneration == runtimeConfiguration.configurationGeneration else {\n169|      throw SSHProfileSnapshotLoaderError.profileGenerationMismatch\n170|    }\n171|    guard profile.profileID == runtimeConfiguration.profileIdentifier else {\n172|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.profileID)\n173|    }\n174|    guard profile.credential.reference == runtimeConfiguration.credentialReference else {\n175|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.credentialReference)\n176|    }\n177|  }\n178|\n179|  private static func validate(\n180|    connectionConfiguration: SSHConnectionConfiguration,\n181|    profile: SSHProfileSnapshotV1,\n182|    runtimeConfiguration: RuntimeConfigurationSnapshot,\n183|    capabilities: SSHAdapterCapabilities\n184|  ) throws {\n185|    let algorithms = connectionConfiguration.algorithms\n186|    guard\n187|      connectionConfiguration.canonicalHostname == profile.canonicalHost.value,\n188|      connectionConfiguration.endpoint\n189|        == TunnelEndpoint(host: profile.canonicalHost.value, port: profile.port),\n190|      connectionConfiguration.username == profile.account,\n191|      connectionConfiguration.profileReference.profileIdentifier\n192|        == runtimeConfiguration.profileIdentifier,\n193|      connectionConfiguration.credentialReference.rawValue\n194|        == profile.credential.reference.rawValue.uuidString.lowercased(),\n195|      connectionConfiguration.credentialGeneration == profile.credential.generation,\n196|      connectionConfiguration.trustRecordReference?.rawValue\n197|        == runtimeConfiguration.trustReference.rawValue.uuidString.lowercased(),\n198|      Set(algorithms.keyExchange).isSubset(of: capabilities.keyExchangeAlgorithms),\n199|      Set(algorithms.hostKey).isSubset(of: capabilities.hostKeyAlgorithms),\n200|      Set(algorithms.cipher).isSubset(of: capabilities.cipherAlgorithms),\n201|      Set(algorithms.mac).isSubset(of: capabilities.macAlgorithms),\n202|      Set(algorithms.hostKey)\n203|        == Set(profile.hostPolicy.allowedAlgorithms.map(\\.rawValue))\n204|    else {\n205|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.providerConfiguration)\n206|    }\n207|  }\n208|\n209|  private static func map(\n210|    _ error: any Error,\n211|    configurationGeneration: UInt64,\n212|    selected: MacOSSelectedSSHDependencies\n213|  ) -> SSHBootstrapProviderError {\n214|    if let error = error as? SSHBootstrapProviderError {\n215|      return error\n216|    }\n217|    if let error = error as? MacOSCredentialResolverError {\n218|      return selected.mapCredentialError(error, configurationGeneration)\n219|    }\n220|    if let error = error as? SSHTransportError {\n221|      return SSHBootstrapErrorMapper.transport(\n222|        error,\n223|        configurationGeneration: configurationGeneration\n224|      )\n225|    }\n226|    return SSHBootstrapErrorMapper.transport(\n227|      error,\n228|      stage: .algorithmNegotiation,\n229|      configurationGeneration: configurationGeneration\n230|    )\n231|  }\n232|}\n233|\n234|private actor MacOSProductionSSHBootstrapSession: M1SSHChannelSession {\n235|  nonisolated let connectedEndpoint: TunnelEndpoint\n236|\n237|  private let transport: any SSHTransport\n238|  private let channelPolicy: SSHChannelPolicy\n239|  private let runtimeGeneration: UInt64\n240|  private weak var healthSink: (any TunnelRuntimeHealthEventSink)?\n241|  private var isClosed = false\n242|\n243|  init(\n244|    transport: any SSHTransport,\n245|    connectedEndpoint: TunnelEndpoint,\n246|    channelPolicy: SSHChannelPolicy,\n247|    runtimeGeneration: UInt64,\n248|    healthSink: any TunnelRuntimeHealthEventSink\n249|  ) {\n250|    self.transport = transport\n251|    self.connectedEndpoint = connectedEndpoint\n252|    self.channelPolicy = channelPolicy\n253|    self.runtimeGeneration = runtimeGeneration\n254|    self.healthSink = healthSink\n255|  }\n256|\n257|  func openTCP(\n258|    destination: TunnelEndpoint,\n259|    originator: TunnelEndpoint\n260|  ) async throws -> any SSHByteChannel {\n261|    guard !isClosed else {\n262|      throw SSHBootstrapErrorMapper.sessionClose(\n263|        .transportFailure,\n264|        configurationGeneration: 0\n265|      )\n266|    }\n267|    return try await transport.openDirectTCPIP(\n268|      destination: destination,\n269|      originator: originator,\n270|      policy: channelPolicy\n271|    )\n272|  }\n273|\n274|  func close() async {\n275|    guard !isClosed else { return }\n276|    isClosed = true\n277|    await transport.close()\n278|    await healthSink?.receive(\n279|      TunnelRuntimeHealthEvent(\n280|        runtimeGeneration: runtimeGeneration,\n281|        component: .ssh,\n282|        health: .unhealthy\n283|      )\n284|    )\n285|  }\n286|\n287|  func health() async -> TunnelRuntimeComponentHealth {\n288|    isClosed ? .unhealthy : .healthy\n289|  }\n290|}","final_result":true}}}
