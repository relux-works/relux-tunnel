+import Foundation
+import ReluxTunnelCore
+
+let limits = SSHReceiveWindowClassLimits(
+  maximumAdvertisedWindowBytes: 64 * 1_024,
+  lowWaterBytes: 16 * 1_024,
+  readBufferCapacityBytes: 16 * 1_024,
+  writeCapacityBytes: 16 * 1_024,
+  metadataCapacityBytes: 1 * 1_024
+)
+let configuration = try SSHReceiveWindowBudgetConfiguration(
+  controlInitialWindowBytes: 32 * 1_024,
+  ordinaryInitialWindowBytes: 64 * 1_024,
+  bulkMinimumWindowBytes: 32 * 1_024,
+  bulkMaximumWindowBytes: 64 * 1_024,
+  maximumMeasuredBandwidthBitsPerSecond: 1_000_000_000,
+  maximumMeasuredRTTNanoseconds: 1_000_000_000,
+  relayControlWindowBytes: 32 * 1_024,
+  relayBurstDatagramCount: 1,
+  relayMaximumFrameBodyBytes: 1_472,
+  relayMaximumWindowBytes: 64 * 1_024,
+  softInitialWindowCapBytes: 32 * 1_024,
+  perChannelWindowCeilingBytes: 64 * 1_024,
+  perLaneWindowCeilingBytes: 256 * 1_024,
+  globalWindowCeilingBytes: 1_024 * 1_024,
+  globalLedgerCeilingBytes: 2 * 1_024 * 1_024,
+  classLimits: Dictionary(
+    uniqueKeysWithValues: SSHReceiveWindowClass.allCases.map { ($0, limits) })
+)
+let laneID = SSHLaneIdentity(rawValue: UUID())
+let channelID = SSHChannelIdentity(rawValue: UUID())
+var ledger = try SSHReceiveWindowBudgetLedger(
+  configuration: configuration,
+  generation: 1,
+  lanes: [SSHReceiveWindowLane(identity: laneID, generation: 1, state: .ready)]
+)
+_ = try ledger.reserveInitial(
+  channel: channelID,
+  lane: laneID,
+  channelClass: .control,
+  generation: 1
+)
+_ = try ledger.reserveAdjustment(
+  channel: channelID,
+  generation: 1,
+  outstandingAdvertisedCreditBytes: 16 * 1_024
+)
+
+do {
+  let second = try ledger.reserveAdjustment(
+    channel: channelID,
+    generation: 1,
+    outstandingAdvertisedCreditBytes: 0
+  )
+  print("second_adjustment=\(second.adjustmentBytes) newly_reserved=\(second.newlyReservedBytes)")
+} catch {
+  print("second_adjustment_refused=\(error)")
+  exit(1)
+}

