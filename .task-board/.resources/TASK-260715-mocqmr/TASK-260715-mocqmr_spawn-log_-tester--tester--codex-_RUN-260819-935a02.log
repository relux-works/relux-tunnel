+            self.assertEqual(exits, [130] * 8)
+
+    def test_stdout_stderr_and_unsupported_contamination_fail_closed(self) -> None:
+        if os.geteuid() == 0:
+            self.skipTest("runtime contract intentionally rejects root")
+        for fault, expected in (
