   409	  public mutating func setLaneState(
   410	    _ state: SSHReceiveWindowLaneState,
   411	    lane: SSHLaneIdentity,
   412	    generation: UInt64
   413	  ) throws {
   414	    guard generation == self.generation else { throw SSHReceiveWindowRefusal.staleGeneration }
   415	    guard var current = lanes[lane] else { throw SSHReceiveWindowRefusal.unknownLane }
   416	    guard current.generation == generation else { throw SSHReceiveWindowRefusal.staleGeneration }
   417	    current.state = state
   418	    lanes[lane] = current
   419	  }
