   405	  private func constantTimeEquals(_ lhs: [UInt8], _ rhs: [UInt8]) -> Bool {
   406	    var difference = UInt8(truncatingIfNeeded: lhs.count ^ rhs.count)
   407	    let count = max(lhs.count, rhs.count)
   408	    for index in 0..<count {
   409	      let left = index < lhs.count ? lhs[index] : 0
   410	      let right = index < rhs.count ? rhs[index] : 0
   411	      difference |= left ^ right
   412	    }
   413	    return difference == 0
   414	  }
