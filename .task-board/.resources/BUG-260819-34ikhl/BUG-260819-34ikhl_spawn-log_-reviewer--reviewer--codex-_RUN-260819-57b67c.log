codex
The implementation is test-only and the root cause is correctly narrowed: the old 10,000-yield scheduler deadline could expire before resource ownership publication. The rework now adds terminal readiness plus cancellation-aware waiter removal; I’m stress-testing all normal, pre-readiness failure, and cancellation paths under four CPU-load workers, while preserving the exact exit/cleanup assertions.
exec
/bin/zsh -lc 'set -o pipefail
load_pids=()
cleanup_load() {
  for load_pid in "${load_pids[@]}"; do
    kill "$load_pid" 2>/dev/null || true
    wait "$load_pid" 2>/dev/null || true
  done
}
trap cleanup_load EXIT INT TERM
for _ in 1 2 3 4; do
  yes >/dev/null &
  load_pids+=("$!")
done
