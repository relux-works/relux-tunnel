{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7b7","stream":{"kind":"session","id":"01a0a9eb-d8c0-74d1-b394-64cb248a951b"},"sequence":566,"recorded_at":1780531400001127,"record_type":"event","durability":"durable","causation_id":"a3fdabb1-ccbe-4a5e-91a4-121d521ff754","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a3fdabb1-ccbe-4a5e-91a4-121d521ff754","run_stream":{"kind":"run","id":"a3fdabb1-ccbe-4a5e-91a4-121d521ff754"},"task_stream":{"kind":"task","id":"01a0a9ed-e936-7860-8cfe-71b0e4eda678"},"task_id":"01a0a9ed-e936-7860-8cfe-71b0e4eda678","event":{"kind":"output","task_id":"01a0a9ed-e936-7860-8cfe-71b0e4eda678","chunk":"{\n  \"chunk_id\": \"exec-23-1\",\n  \"command\": \"grep -n \\\"macos\\\\|swift build\\\\|swift test\\\\|xcodebuild\\\\|runs-on\\\" .github/workflows/ci.yml | head -n 30; echo ===; sed -n '135,230p' .github/workflows/ci.yml\",\n  \"description\": \"Find macOS SwiftPM CI job\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"19:    # macos-15 is the arm64 image; keep this label paired with the arm64 Mise checksum.\\n20:    runs-on: macos-15\\n38:          sha256: c7a0eb1035de974b42d36b69c4b55b836c06b455b990dd6ac530aaf05d4a8a17 # mise-v2026.3.10-macos-arm64\\n64:    runs-on: ubuntu-latest\\n102:    runs-on: ubuntu-24.04\\n142:            runner: macos-15-intel\\n145:            runner: macos-15\\n152:    runs-on: ${{ matrix.runner }}\\n===\\n    name: portable runtime ${{ matrix.target }} on ${{ matrix.runner }}\\n    strategy:\\n      fail-fast: false\\n      matrix:\\n        include:\\n          - target: darwin/amd64\\n            slug: darwin-amd64\\n            runner: macos-15-intel\\n          - target: darwin/arm64\\n            slug: darwin-arm64\\n            runner: macos-15\\n          - target: linux/amd64\\n            slug: linux-amd64\\n            runner: ubuntu-24.04\\n          - target: linux/arm64\\n            slug: linux-arm64\\n            runner: ubuntu-24.04-arm\\n    runs-on: ${{ matrix.runner }}\\n    steps:\\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\\n        with:\\n          fetch-depth: 0\\n          persist-credentials: false\\n\\n      - name: Verify checked-in pins and runtime-gate tests\\n        run: make relay-toolchain-check relay-toolchain-negative-test\\n\\n      - name: Fetch the approved checksum-pinned host tools\\n        env:\\n          RELAY_HOST_TARGET: ${{ matrix.target }}\\n        run: |\\n          mkdir -p .temp/relay-tools\\n          read -r go_archive go_sha go_url syft_archive syft_sha syft_url <<EOF\\n          $(python3 -c 'import json,os; d=json.load(open(\\\"relay/toolchain-manifest-v1.json\\\")); h=os.environ[\\\"RELAY_HOST_TARGET\\\"]; g=next(v for v in d[\\\"hostToolArchives\\\"] if v[\\\"host\\\"] == h); s=next(v for v in d[\\\"buildOnlyTools\\\"][0][\\\"hostArchives\\\"] if v[\\\"host\\\"] == h); print(g[\\\"artifact\\\"], g[\\\"sha256\\\"], g[\\\"source\\\"], s[\\\"artifact\\\"], s[\\\"sha256\\\"], s[\\\"source\\\"])')\\n          EOF\\n          curl --fail --location --proto '=https' --tlsv1.2 \\\\\\n            --output \\\".temp/relay-tools/$go_archive\\\" \\\"$go_url\\\"\\n          curl --fail --location --proto '=https' --tlsv1.2 \\\\\\n            --output \\\".temp/relay-tools/$syft_archive\\\" \\\"$syft_url\\\"\\n          python3 - \\\"$go_sha\\\" \\\".temp/relay-tools/$go_archive\\\" \\\"$syft_sha\\\" \\\".temp/relay-tools/$syft_archive\\\" <<'PY'\\n          import hashlib, pathlib, sys\\n          for expected, name in zip(sys.argv[1::2], sys.argv[2::2], strict=True):\\n              actual = hashlib.sha256(pathlib.Path(name).read_bytes()).hexdigest()\\n              if actual != expected:\\n                  raise SystemExit(\\\"checksum-pinned host tool mismatch\\\")\\n          PY\\n          make relay-provision-tools \\\\\\n            RELAY_GO_ARCHIVE=\\\".temp/relay-tools/$go_archive\\\" \\\\\\n            RELAY_SYFT_ARCHIVE=\\\".temp/relay-tools/$syft_archive\\\"\\n\\n      - name: Clean-build the exact four-asset manifest offline\\n        run: |\\n          source_date_epoch=$(git show -s --format=%ct HEAD)\\n          make relay-shell-release \\\\\\n            RELAY_VERSION=0.0.0 \\\\\\n            SOURCE_COMMIT=\\\"$GITHUB_SHA\\\" \\\\\\n            SOURCE_DATE_EPOCH=\\\"$source_date_epoch\\\"\\n\\n      - name: Gate native rootless stdio and runtime boundaries\\n        run: |\\n          mkdir -p \\\".build/relay/runtime-evidence/${{ matrix.slug }}\\\"\\n          python3 scripts/relay_asset_smoke.py \\\\\\n            --target \\\"${{ matrix.target }}\\\" \\\\\\n            --runner-kind native \\\\\\n            --runner-name \\\"${{ matrix.runner }}\\\" \\\\\\n            --runner-owner TASK-260715-36gq4m \\\\\\n            --require-native \\\\\\n            --manifest .build/relay/apple-bundle-input/relux-relay-manifest-v1.json \\\\\\n            --executable \\\".build/relay/apple-bundle-input/relux-relay-${{ matrix.slug }}\\\" \\\\\\n            --evidence \\\".build/relay/runtime-evidence/${{ matrix.slug }}/report.json\\\"\\n\\n      - name: Retain exact gated asset and privacy-safe runner evidence\\n        if: always()\\n        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\\n        with:\\n          name: runtime-evidence-${{ matrix.slug }}-${{ github.run_id }}\\n          path: |\\n            .build/relay/apple-bundle-input/relux-relay-${{ matrix.slug }}\\n            .build/relay/apple-bundle-input/relux-relay-${{ matrix.slug }}.spdx.json\\n            .build/relay/apple-bundle-input/relux-relay-manifest-v1.json\\n            .build/relay/apple-bundle-input/relux-relay-SHA256SUMS\\n            .build/relay/runtime-evidence/${{ matrix.slug }}/report.json\\n          if-no-files-found: warn\\n          retention-days: 14\\n\",\n  \"original_output_bytes\": 4457,\n  \"original_output_tokens\": 1115,\n  \"truncated\": false\n}","final_result":true}}}
