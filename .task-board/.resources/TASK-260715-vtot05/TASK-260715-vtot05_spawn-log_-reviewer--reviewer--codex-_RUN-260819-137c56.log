   510	def validate_archive_trailer(stream: Any) -> None:
   511	    chunks: list[bytes] = []
   512	    total = 0
   513	    while True:
   514	        chunk = stream.read(
   515	            min(READ_CHUNK_BYTES, MAX_ARCHIVE_TRAILER_BYTES + 1 - total)
   516	        )
   517	        if not chunk:
   518	            break
   519	        chunks.append(chunk)
   520	        total += len(chunk)
   520	        total += len(chunk)
   521	        if total > MAX_ARCHIVE_TRAILER_BYTES:
   522	            raise AssetManifestError(
   523	                "trusted relay archive metadata exceeds its size limit"
   524	            )
   525	    trailer = b"".join(chunks)
   526	    if len(trailer) < 1024 or any(trailer):
   527	        raise AssetManifestError("trusted relay archive trailer is invalid")
   528	
