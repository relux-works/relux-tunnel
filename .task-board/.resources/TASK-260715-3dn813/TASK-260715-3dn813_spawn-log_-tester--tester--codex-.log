+    let oversized = TunnelPacket(payload: Data([0x45, 1, 2, 3, 4]), addressFamily: .ipv4)
+    await flow.enqueue(PacketReadBatch(results: [.packet(oversized)]))
+
+    await #expect(
+      throws: PacketFlowBridgeError.messageTooLarge(
+        direction: .forward,
+        datagramBytes: 9,
+        configuredMaximumBytes: 8
+      )
