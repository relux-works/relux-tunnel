+  #expect(snapshot.parsingFlows == 0, sourceLocation: sourceLocation)
+  #expect(snapshot.openingFlows == 0, sourceLocation: sourceLocation)
+  #expect(snapshot.streamingFlows == 0, sourceLocation: sourceLocation)
