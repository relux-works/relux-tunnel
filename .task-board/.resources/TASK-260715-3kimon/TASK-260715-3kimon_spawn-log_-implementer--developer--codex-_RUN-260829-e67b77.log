	--go "$(RELAY_GO)" \
	--go-toolchain "$(RELAY_GO_TOOLCHAIN)" \
	--syft "$(RELAY_SYFT)" \
	--relay-version "$(RELAY_VERSION)" \
	--source-commit "$(SOURCE_COMMIT)" \
