{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c739","stream":{"kind":"session","id":"01a0aa7a-9815-7302-a96f-7a8fde67c84b"},"sequence":503,"recorded_at":1780531400001001,"record_type":"event","durability":"durable","causation_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","run_stream":{"kind":"run","id":"7cb39f37-e5ea-43fc-a612-eaf97474622d"},"task_stream":{"kind":"task","id":"01a0aa7b-e6b7-79b2-a450-1984fd83aa26"},"task_id":"01a0aa7b-e6b7-79b2-a450-1984fd83aa26","event":{"kind":"output","task_id":"01a0aa7b-e6b7-79b2-a450-1984fd83aa26","chunk":"Read text file `Sources/ReluxTunnelMacOSAdapter/MacOSSSHProfileSnapshotLoader.swift`.\n1|import Foundation\n2|@preconcurrency import NetworkExtension\n3|import ReluxTunnelCore\n4|\n5|/// macOS provider integration for the complete profile snapshot stored by\n6|/// `NETunnelProviderProtocol`. This adapter has no App Group or Keychain path.\n7|public final class MacOSSSHProfileSnapshotLoader: @unchecked Sendable {\n8|  private let loader: SSHProfileRuntimeSnapshotLoader\n9|\n10|  public init(loader: SSHProfileRuntimeSnapshotLoader = SSHProfileRuntimeSnapshotLoader()) {\n11|    self.loader = loader\n12|  }\n13|\n14|  public func capture(\n15|    from protocolConfiguration: NEVPNProtocol?,\n16|    startRequest: RuntimeStartRequest? = nil\n17|  ) throws -> SSHProfileSnapshotV1 {\n18|    guard let tunnelProtocol = protocolConfiguration as? NETunnelProviderProtocol else {\n19|      throw SSHProfileSnapshotLoaderError.profileCorrupt\n20|    }\n21|    return try capture(from: tunnelProtocol, startRequest: startRequest)\n22|  }\n23|\n24|  public func capture(\n25|    from tunnelProtocol: NETunnelProviderProtocol,\n26|    startRequest: RuntimeStartRequest? = nil\n27|  ) throws -> SSHProfileSnapshotV1 {\n28|    let configuration = tunnelProtocol.providerConfiguration?.mapValues(\n29|      MacOSVPNProviderConfigurationCodec.decode\n30|    )\n31|    return try loader.capture(from: configuration, startRequest: startRequest)\n32|  }\n33|}","final_result":true}}}
