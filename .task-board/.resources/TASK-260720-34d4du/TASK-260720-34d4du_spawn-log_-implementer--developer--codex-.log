   260	                wasKeyExchangeInProgress: wasKeyExchangeInProgress,
   261	                context: context
   262	            )
   263	            self.pendingWrite = true
   264	        }
   265	
   266	        self.recordProtectedOutboundBytes(self.outboundFrameBuffer.readableBytes)
   267	        context.write(self.wrapOutboundOut(self.outboundFrameBuffer), promise: promise)
   268	        self.evaluateAutomaticRekey(context: context)
   269	    }
