   783	      (.resolving, .tcpConnecting),
   784	      (.tcpConnecting, .keyExchange),
   785	      (.keyExchange, .awaitingHostDecision),
   786	      (.awaitingHostDecision, .authenticating),
   787	      (.authenticating, .ready),
   788	      (.ready, .rekeying),
   789	      (.rekeying, .ready),
   790	      (.failed, .closing),
   791	      (.closing, .closed):
   792	      true
   793	    default:
   794	      false
   795	    }
   796	  }
   797	}
