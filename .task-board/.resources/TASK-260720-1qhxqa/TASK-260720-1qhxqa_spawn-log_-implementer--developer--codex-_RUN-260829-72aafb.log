   243	def target_block(text: str, name: str) -> str:
   244	    declaration = re.search(
   245	        rf"\.target\s*\(\s*name:\s*\"{re.escape(name)}\"\s*,", text
   246	    )
   247	    if declaration is None:
   248	        raise BindingError("REPOSITORY-GRAPH", f"missing target {name}")
   249	    opening = declaration.start()
   250	    depth = 0
   251	    for index in range(text.find("(", opening), len(text)):
   252	        if text[index] == "(":
   253	            depth += 1
   254	        elif text[index] == ")":
   255	            depth -= 1
   256	            if depth == 0:
   257	                return text[opening : index + 1]
   258	    raise BindingError("REPOSITORY-GRAPH", f"unterminated target block {name}")
   259	
   260	
   261	def require_tokens(block: str, expected: set[str], row: str) -> None:
   262	    for token in sorted(expected):
   263	        if token not in block:
   264	            raise BindingError(row, f"missing repository binding token: {token}")
   265	
