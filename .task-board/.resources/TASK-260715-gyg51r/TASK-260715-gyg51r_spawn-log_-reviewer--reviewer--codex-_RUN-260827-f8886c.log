{
  "schemaVersion": 1,
  "seed": 42,
  "sourceRevision": "replace-with-git-revision",
  "dependencyRevisions": {},
  "profileReference": {"value": "11111111-1111-1111-1111-111111111111", "privacy": "sensitive"},
  "parameters": {
