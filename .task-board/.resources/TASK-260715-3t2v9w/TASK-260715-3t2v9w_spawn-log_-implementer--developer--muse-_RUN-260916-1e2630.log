{ NSNumber(value: $0) }\n92|    )\n93|  }\n94|}\n95|\n96|/// Thin macOS composition root. The concrete provider subclass is a later task.\n97|public struct MacOSProviderCompositionRoot: TunnelProviderLifecycle {\n98|  private let adapter: TunnelProviderAdapter\n99|\n100|  public init(\n101|    packetFlow: any PacketFlow,\n102|    runtimeFactory: any TunnelRuntimeFactory,\n103|    dependencies: TunnelRuntimeDependencies\n104|  ) {\n105|    adapter = TunnelProviderAdapter(\n106|      packetFlow: packetFlow,\n107|      runtimeFactory: runtimeFactory,\n108|      dependencies: dependencies\n109|    )\n110|  }\n111|\n112|  public init(\n113|    packetFlow: any PacketFlow,\n114|    runtimeFactory: any TunnelRuntimeFactory,\n115|    dependencies: TunnelRuntimeDependencies,\n116|    snapshotSource: any ProviderRuntimeSnapshotSource,\n117|    diagnosticsSource: any ProviderDiagnosticsSnapshotSource,\n118|    lifecycleDiagnostics: (any ProviderLifecycleDiagnosticsSink)? = nil,\n119|    startBudget: Duration = .seconds(60),\n120|    cleanupBudget: Duration = .seconds(10)\n121|  ) {\n122|    adapter = TunnelProviderAdapter(\n123|      packetFlow: packetFlow,\n124|      runtimeFactory: runtimeFactory,\n125|      dependencies: dependencies,\n126|      snapshotSource: snapshotSource,\n127|      diagnosticsSource: diagnosticsSource,\n128|      lifecycleDiagnostics: lifecycleDiagnostics,\n129|      startBudget: startBudget,\n130|      cleanupBudget: cleanupBudget\n131|    )\n132|  }\n133|\n134|  public init(\n135|    packetTunnelFlow: NEPacketTunnelFlow,\n136|    runtimeFactory: any TunnelRuntimeFactory,\n137|    dependencies: TunnelRuntimeDependencies\n138|  ) {\n139|    self.init(\n140|      packetFlow: MacOSPacketFlowAdapter(packetFlow: packetTunnelFlow),\n141|      runtimeFactory: runtimeFactory,\n142|      dependencies: dependencies\n143|    )\n144|  }\n145|\n146|  public func start(configuration: TunnelConfiguration) async throws {\n147|    try await adapter.start(configuration