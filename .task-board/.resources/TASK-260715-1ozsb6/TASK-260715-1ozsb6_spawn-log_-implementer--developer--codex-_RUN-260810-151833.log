   712	private actor DataUploadSource: SSHUploadSource {
   713	  private let data: Data
   714	  private var offset = 0
   715	
   716	  init(_ data: Data) {
   717	    self.data = data
   718	  }
   719	
   720	  func read(maximumBytes: Int) async throws -> Data? {
   721	    guard offset < data.count else { return nil }
   722	    let count = min(maximumBytes, data.count - offset)
   723	    defer { offset += count }
   724	    return Data(data[offset..<(offset + count)])
   725	  }
   726	}
