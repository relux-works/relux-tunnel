   471	    def _install_linux_identity(self, generation: str) -> dict:
   472	        directory = self._server_dir("linux-current")
   473	        key = directory / f"user-key-{generation}"
   474	        self._generate_key(key, "ed25519", f"{fixture.TASK_ID}-linux-current")
   475	        public_key = key.with_suffix(".pub").read_text(encoding="utf-8").strip()
   476	        cleanup = (
   477	            "set -eu; umask 077; mkdir -p ~/.ssh; touch ~/.ssh/authorized_keys; "
   478	            f"grep -v {shlex.quote(fixture.TASK_ID + '-linux-current')} ~/.ssh/authorized_keys > ~/.ssh/authorized_keys.tmp || true; "
   479	            f"printf '%s\\n' {shlex.quote(public_key)} >> ~/.ssh/authorized_keys.tmp; "
   480	            "mv ~/.ssh/authorized_keys.tmp ~/.ssh/authorized_keys"
   481	        )
   482	        _run(["limactl", "shell", LIMA_INSTANCE, "--", "bash", "-lc", cleanup])
   483	        config, alias = self._lima_config()
   484	        values = self._ssh_config_values(config, alias)
   485	        return {
   486	            "account": values["user"],
   487	            "host": values["hostname"],
   488	            "identityReference": f"ephemeral-file://{key}",
   489	            "port": int(values["port"]),
   490	        }
   491	
   492	    def _prepare_relux(self) -> dict:
   493	        values = self._ssh_config_values(None, RELUX_ALIAS)
   494	        endpoints, endpoint_process = self._start_endpoint_supervisor(
   495	            "relux-real",
   496	            [
   497	                "/usr/bin/ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
   498	                RELUX_ALIAS,
   499	            ],
   500	        )
   501	        runtime = {
   502	            "account": values["user"],
   503	            "destinationEndpoints": endpoints,
   504	            "host": values["hostname"],
   505	            "identityReference": "ssh-config://relux",
   506	            "port": int(values["port"]),
   507	            "stdioExec": REMOTE_STDIO,
   508	        }
   509	        return {
   510	            "processes": [endpoint_process],
   511	            "runtime": runtime,
   512	            "serverId": "relux-real",
   513	        }
   514	
   515	    def _rotate(self, server_id: str) -> dict:
   516	        state = self._load_state(server_id)
   517	        if server_id == "relux-real":
   518	            return {
   519	                "disposition": "external-owner-managed",
   520	                "runtime": state["runtime"],
   521	                "status": "ok",
   522	            }
   523	        if server_id == "linux-current":
   524	            previous = Path(state["userKey"])
   525	            runtime = self._install_linux_identity("rotated")
   526	            runtime["destinationEndpoints"] = state["runtime"]["destinationEndpoints"]
   527	            runtime["stdioExec"] = REMOTE_STDIO
   528	            previous.unlink(missing_ok=True)
   529	            previous.with_suffix(".pub").unlink(missing_ok=True)
   530	            state["runtime"] = runtime
   531	            state["userKey"] = runtime["identityReference"].removeprefix("ephemeral-file://")
   532	        else:
   533	            previous = Path(state["userKey"])
   534	            rotated = self._server_dir(server_id) / "user-key-rotated"
   535	            key_type = "ecdsa" if server_id == "macos-approved-older-profile" else "ed25519"
   536	            self._generate_key(rotated, key_type, f"{fixture.TASK_ID}-{server_id}-user")
   537	            authorized = self._server_dir(server_id) / "authorized_keys"
   538	            authorized.write_text(rotated.with_suffix(".pub").read_text(encoding="utf-8"), encoding="utf-8")
   539	            os.chmod(authorized, 0o600)
   540	            previous.unlink(missing_ok=True)
   541	            previous.with_suffix(".pub").unlink(missing_ok=True)
   542	            state["userKey"] = str(rotated)
   543	            state["runtime"]["identityReference"] = f"ephemeral-file://{rotated}"
   544	        self._save_state(server_id, state)
   545	        self._prove_reachability(server_id, state)
   546	        return {"disposition": "rotated", "runtime": state["runtime"], "status": "ok"}
   547	
   548	    def _identity_path(self, runtime: dict) -> Path:
   549	        reference = runtime["identityReference"]
   550	        if not reference.startswith("ephemeral-file://"):
   551	            raise ProviderError("runtime identity is not a task-owned ephemeral key")
   552	        return Path(reference.removeprefix("ephemeral-file://"))
   553	
   554	    def _prove_reachability(self, server_id: str, state: dict) -> dict[str, str]:
   555	        runtime = state["runtime"]
   556	        remote_probe = (
   557	            "set -eu; test \"$(id -u)\" -ne 0; "
   558	            "printf 'reachable=1\\nprivilege=non-root\\nos='; uname -s; "
   559	            "printf 'arch='; uname -m; "
   560	            "printf 'openssh='; ssh -V 2>&1 | sed -E 's/[ ,].*//'"
   561	        )
   562	        if server_id == "relux-real":
   563	            completed = _run(
   564	                [
   565	                    "/usr/bin/ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
   566	                    RELUX_ALIAS, remote_probe,
   567	                ]
   568	            )
   569	        else:
   570	            key = self._identity_path(runtime)
   571	            completed = _run(
   572	                [
   573	                    "/usr/bin/ssh", "-F", "/dev/null", "-o", "BatchMode=yes",
   574	                    "-o", "IdentitiesOnly=yes", "-o", "StrictHostKeyChecking=no",
   575	                    "-o", "UserKnownHostsFile=/dev/null", "-i", str(key),
   576	                    "-p", str(runtime["port"]),
   577	                    f"{runtime['account']}@{runtime['host']}", remote_probe,
   578	                ]
   579	            )
   580	        facts = _parse_key_values(completed.stdout)
   581	        if facts.get("reachable") != "1" or facts.get("privilege") != "non-root":
   582	            raise ProviderError(f"{server_id} did not prove least-privilege reachability")
   583	        return facts
