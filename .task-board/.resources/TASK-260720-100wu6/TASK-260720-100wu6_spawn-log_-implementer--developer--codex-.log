+    stderr.removeAll()
+    closed = true
+  }
+
+  func close() async {
+    guard !closed else { return }
+    closeCount += 1
+    closed = true
+  }
+
+  func waitForExit() async throws -> SSHExecExit {
+    exit
+  }
+
