   528	  public mutating func endOfStream(
   529	    generation callbackGeneration: UInt64
   530	  ) -> RelayClientHandshakeProgress {
   531	    terminalEvent(
   532	      generation: callbackGeneration,
   533	      code: .unexpectedEOF,
   534	      phase: .serverHelloRead
   535	    )
   536	  }
