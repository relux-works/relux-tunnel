     9	
    10	#ifndef __HEV_MEMORY_ALLOCATOR_H__
    11	#define __HEV_MEMORY_ALLOCATOR_H__
    12	
    13	#include <stddef.h>
    14	
    15	typedef struct _HevMemoryAllocator HevMemoryAllocator;
    16	
    17	typedef void *(*HevMemoryAllocatorAlloc) (HevMemoryAllocator *self,
    18	                                          size_t size);
    19	typedef void *(*HevMemoryAllocatorRealloc) (HevMemoryAllocator *self, void *ptr,
    20	                                            size_t size);
    21	typedef void (*HevMemoryAllocatorFree) (HevMemoryAllocator *self, void *ptr);
    22	typedef void (*HevMemoryAllocatorDestroy) (HevMemoryAllocator *self);
    23	
    24	struct _HevMemoryAllocator
    25	{
    26	    HevMemoryAllocatorAlloc alloc;
    27	    HevMemoryAllocatorRealloc realloc;
    28	    HevMemoryAllocatorFree free;
    29	    HevMemoryAllocatorDestroy destroy;
    30	
    31	    unsigned int ref_count;
    32	};
    33	
    34	/**
    35	 * hev_memory_allocator_default:
    36	 *
    37	 * Get the default memory allocator.
    38	 *
    39	 * Returns: a #HevMemoryAllocator
    40	 *
    41	 * Since: 1.0
    42	 */
    43	HevMemoryAllocator *hev_memory_allocator_default (void);
    44	
    45	/**
    46	 * hev_memory_allocator_set_default:
    47	 * @allocator: a #HevMemoryAllocator
    48	 *
    49	 * Set the default memory allocator.
    50	 *
    51	 * Returns: The old #HevMemoryAllocator
    52	 *
    53	 * Since: 1.0
    54	 */
    55	HevMemoryAllocator *
    56	hev_memory_allocator_set_default (HevMemoryAllocator *allocator);
    57	
    58	/**
    59	 * hev_memory_allocator_ref:
    60	 * @self: a #HevMemoryAllocator
    61	 *
    62	 * Increases the reference count of the @self by one.
    63	 *
    64	 * Returns: a #HevMemoryAllocator
    65	 *
    66	 * Since: 1.0
    67	 */
    68	HevMemoryAllocator *hev_memory_allocator_ref (HevMemoryAllocator *self);
    69	
    70	/**
    71	 * hev_memory_allocator_unref:
    72	 * @self: a #HevMemoryAllocator
    73	 *
    74	 * Decreases the reference count of @self. When its reference count
    75	 * drops to 0, the object is finalized (i.e. its memory is freed).
    76	 *
    77	 * Since: 1.0
    78	 */
    79	void hev_memory_allocator_unref (HevMemoryAllocator *self);
    80	
    81	/**
    82	 * hev_memory_allocator_alloc:
    83	 * @self: a #HevMemoryAllocator
    84	 * @size: bytes
    85	 *
    86	 * Allocate @size bytes memory from the default memory allocator.
    87	 *
    88	 * Returns: memory address
    89	 *
    90	 * Since: 1.0
    91	 */
    92	void *hev_memory_allocator_alloc (HevMemoryAllocator *self, size_t size);
    93	
    94	/**
    95	 * hev_memory_allocator_realloc:
    96	 * @self: a #HevMemoryAllocator
    97	 * @ptr: memory address
    98	 * @size: bytes
    99	 *
   100	 * Changes the size of the memory block pointed to by @ptr to @size bytes.
   101	 *
   102	 * Returns: memory address
   103	 *
   104	 * Since: 3.2
   105	 */
   106	void *hev_memory_allocator_realloc (HevMemoryAllocator *self, void *ptr,
   107	                                    size_t size);
   108	
   109	/**
   110	 * hev_memory_allocator_free:
   111	 * @self: a #HevMemoryAllocator
   112	 * @ptr: memory address
   113	 *
   114	 * Free the memory from memory allocator.
   115	 *
   116	 * Since: 1.0
   117	 */
   118	void hev_memory_allocator_free (HevMemoryAllocator *self, void *ptr);
   119	
   120	#endif /* __HEV_MEMORY_ALLOCATOR_H__ */
     1	/*
     2	 ============================================================================
     3	 Name        : hev-memory-allocator.c
     4	 Author      : Heiher <r@hev.cc>
     5	 Copyright   : Copyright (c) 2013 - 2024 everyone.
     6	 Description : Memory allocator
     7	 ============================================================================
     8	 */
     9	
    10	#include <stdlib.h>
    11	#include <string.h>
    12	#include <pthread.h>
    13	
    14	#include "lib/misc/hev-compiler.h"
    15	#include "mem/simple/hev-memory-allocator-simple.h"
    16	
    17	#include "hev-memory-allocator.h"
    18	
    19	static pthread_key_t key;
    20	static pthread_once_t key_once = PTHREAD_ONCE_INIT;
    21	
    22	static void
    23	pthread_key_creator (void)
    24	{
    25	    pthread_key_create (&key, NULL);
    26	}
    27	
    28	EXPORT_SYMBOL HevMemoryAllocator *
    29	hev_memory_allocator_default (void)
    30	{
    31	    HevMemoryAllocator *allocator;
    32	
    33	    pthread_once (&key_once, pthread_key_creator);
    34	
    35	    allocator = pthread_getspecific (key);
    36	    if (!allocator) {
    37	        allocator = hev_memory_allocator_simple_new ();
    38	        pthread_setspecific (key, allocator);
    39	    }
    40	
    41	    return allocator;
    42	}
    43	
    44	EXPORT_SYMBOL HevMemoryAllocator *
    45	hev_memory_allocator_set_default (HevMemoryAllocator *allocator)
    46	{
    47	    HevMemoryAllocator *old_allocator;
    48	
    49	    pthread_once (&key_once, pthread_key_creator);
    50	
    51	    old_allocator = pthread_getspecific (key);
    52	    pthread_setspecific (key, allocator);
    53	
    54	    return old_allocator;
    55	}
    56	
    57	EXPORT_SYMBOL HevMemoryAllocator *
    58	hev_memory_allocator_ref (HevMemoryAllocator *self)
    59	{
    60	    self->ref_count++;
    61	    return self;
    62	}
    63	
    64	EXPORT_SYMBOL void
    65	hev_memory_allocator_unref (HevMemoryAllocator *self)
    66	{
    67	    self->ref_count--;
    68	    if (0 < self->ref_count)
    69	        return;
    70	
    71	    if (self->destroy)
    72	        self->destroy (self);
    73	    free (self);
    74	}
    75	
    76	EXPORT_SYMBOL void *
    77	hev_memory_allocator_alloc (HevMemoryAllocator *self, size_t size)
    78	{
    79	    return self->alloc (self, size);
    80	}
    81	
    82	EXPORT_SYMBOL void *
    83	hev_memory_allocator_realloc (HevMemoryAllocator *self, void *ptr, size_t size)
    84	{
    85	    return self->realloc (self, ptr, size);
    86	}
    87	
    88	EXPORT_SYMBOL void
    89	hev_memory_allocator_free (HevMemoryAllocator *self, void *ptr)
    90	{
    91	    return self->free (self, ptr);
    92	}
