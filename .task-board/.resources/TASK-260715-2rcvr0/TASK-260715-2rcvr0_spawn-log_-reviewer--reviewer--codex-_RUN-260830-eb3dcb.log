   906	  ) {
   907	    guard failureAdmission.claim() else { return }
   908	    Task { [weak self] in
   909	      await self?.handleProviderFailure(
   910	        errorCode,
  1060	    } catch let error as RuntimeMessageCodecError {
  1061	      finishRequest(requestID.rawValue, generation: generation)
  1062	      return Self.protocolErrorResponse(requestID: requestID, code: error.protocolErrorCode)
  1063	    } catch {
  1064	      finishRequest(requestID.rawValue, generation: generation)
  1065	      return Self.protocolErrorResponse(requestID: requestID, code: .corruptPayload)
  1066	    }
  1067	
  1068	    guard phase == .running, activeGeneration?.identifier == generation else {
  1069	      finishRequest(requestID.rawValue, generation: generation)
  1070	      return Self.protocolErrorResponse(requestID: requestID, code: .unsupportedValue)
  1071	    }
  1072	    finishRequest(requestID.rawValue, generation: generation)
