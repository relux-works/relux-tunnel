+#!/usr/bin/env python3
+"""Reviewer-only adversarial reproductions for TASK-260715-mocqmr."""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+from unittest import mock
+
+ROOT = Path(__file__).resolve().parents[3]
+SCRIPTS = ROOT / "scripts"
+sys.path.insert(0, str(SCRIPTS))
+
+import relay_asset_smoke  # noqa: E402
+from tests.test_relay_asset_smoke import RelayAssetSmokeTests  # noqa: E402
+
+
+REVIEW_ROOT = ROOT / ".temp" / "TASK-260715-mocqmr" / "review" / "adversarial"
+ASSET = ROOT / ".build" / "relay" / "apple-bundle-input" / "relux-relay-darwin-arm64"
+MISMATCH_MANIFEST = REVIEW_ROOT / "identity-mismatch-manifest.json"
+
+
+def gate_for(evidence: Path) -> relay_asset_smoke.SmokeGate:
+    return relay_asset_smoke.SmokeGate(
+        target="darwin/arm64",
+        runner_kind="native",
+        runner_name="reviewer-darwin-arm64",
+        runner_owner="TASK-260715-36gq4m",
+        evidence_path=evidence,
+        require_native=True,
+    )
+
+
+def assert_failed_process_check(
+    gate: relay_asset_smoke.SmokeGate,
+    name: str,
+    *,
+    started: bool,
+    exit_is_none: bool,
+) -> None:
+    check = next(
+        item
+        for item in gate.report["checks"]
+        if item["name"] == name and item["status"] == "fail"
+    )
+    assert check["processStarted"] is started, check
+    assert (check["exitCode"] is None) is exit_is_none, check
+
+
+def timeout_case() -> dict[str, object]:
+    case_root = REVIEW_ROOT / "timeout"
+    case_root.mkdir(parents=True, exist_ok=True)
+    for name in ("cwd", "home", "tmp"):
+        (case_root / name).mkdir(exist_ok=True)
+    gate = gate_for(case_root / "report.json")
+    environment = gate.runtime_environment(case_root / "home", case_root / "tmp")
+    try:
+        gate.expect_process(
+            "review-timeout",
+            [sys.executable, "-c", "import time; time.sleep(30)"],
+            b"",
+            case_root / "cwd",
+            environment,
+            0,
+            b"",
+            b"",
+        )
+    except relay_asset_smoke.GateFailure as error:
+        assert error.code == "process_timeout", error.code
+        assert error.process_started
+        assert error.exit_code is not None
+        gate.finish("fail", error.code)
+    else:
+        raise AssertionError("timeout case unexpectedly passed")
+    assert_failed_process_check(
+        gate, "review-timeout", started=True, exit_is_none=False
+    )
+    return json.loads(gate.evidence_path.read_text(encoding="utf-8"))
+
+
+def launch_case() -> dict[str, object]:
+    case_root = REVIEW_ROOT / "launch"
+    case_root.mkdir(parents=True, exist_ok=True)
+    for name in ("cwd", "home", "tmp"):
+        (case_root / name).mkdir(exist_ok=True)
+    gate = gate_for(case_root / "report.json")
+    environment = gate.runtime_environment(case_root / "home", case_root / "tmp")
+    with mock.patch.object(
+        relay_asset_smoke,
+        "contained_process_options",
+        return_value=(["/reviewer/definitely-missing-launcher"], {}),
+    ):
+        try:
+            gate.expect_process(
+                "review-launch",
+                ["relay", "--identity", "--protocol", "1"],
+                b"",
+                case_root / "cwd",
+                environment,
+                0,
+                b"",
+                b"",
+            )
+        except relay_asset_smoke.GateFailure as error:
+            assert error.code == "process_start_failed", error.code
+            assert not error.process_started
+            assert error.exit_code is None
+            gate.finish("fail", error.code)
+        else:
+            raise AssertionError("launch case unexpectedly passed")
+    assert_failed_process_check(gate, "review-launch", started=False, exit_is_none=True)
+    report_text = gate.evidence_path.read_text(encoding="utf-8")
+    assert "/reviewer/" not in report_text
+    return json.loads(report_text)
+
+
+def identity_mismatch_case() -> dict[str, object]:
+    case_root = REVIEW_ROOT / "identity"
+    case_root.mkdir(parents=True, exist_ok=True)
+    gate = gate_for(case_root / "report.json")
+    gate.validate_runner()
+    try:
+        gate.exercise_runtime(ASSET, MISMATCH_MANIFEST)
+    except relay_asset_smoke.GateFailure as error:
+        assert error.code == "identity_manifest_mismatch", error.code
+        gate.finish("fail", error.code)
+    else:
+        raise AssertionError("identity mismatch unexpectedly passed")
+    assert_failed_process_check(
+        gate, "identity-and-self-hash", started=True, exit_is_none=False
+    )
+    check = next(
+        item
+        for item in gate.report["checks"]
+        if item["name"] == "identity-and-self-hash" and item["status"] == "fail"
+    )
+    assert check["exitCode"] == 0, check
+    return json.loads(gate.evidence_path.read_text(encoding="utf-8"))
+
+
+def containment_escape_cases() -> list[dict[str, object]]:
+    helper = RelayAssetSmokeTests()
+    results: list[dict[str, object]] = []
+    for fault in ("detached", "external-file"):
+        with tempfile.TemporaryDirectory(dir=REVIEW_ROOT) as temporary:
+            case_root = Path(temporary)
+            executable = helper.write_runtime_fixture(case_root, fault)
+            gate = gate_for(case_root / "report.json")
+            with mock.patch.object(
+                relay_asset_smoke.relay_release,
+                "verify_identity_against_manifest",
+            ):
+                try:
+                    gate.exercise_runtime(executable, case_root / "manifest.json")
+                except relay_asset_smoke.GateFailure as error:
+                    assert error.code.endswith("contract_mismatch"), error.code
+                    gate.finish("fail", error.code)
+                else:
+                    raise AssertionError(f"{fault} escape unexpectedly passed")
+            check = next(
+                item
+                for item in gate.report["checks"]
+                if item["name"] == "stdio-eof-and-stdout-framing"
+                and item["status"] == "fail"
+            )
+            assert check["processStarted"]
+            assert check["exitCode"] is not None
+            assert not any(case_root.glob("runtime-*-outside-write"))
+            process_table = subprocess.run(
+                ["/bin/ps", "-Ao", "command="],
+                check=True,
+                stdout=subprocess.PIPE,
+                text=True,
+                env={"PATH": "/usr/bin:/bin", "LC_ALL": "C", "LANG": "C"},
+            ).stdout
+            assert "relux-smoke-detached-fixture" not in process_table
+            results.append(
+                {
+                    "fault": fault,
+                    "errorCode": gate.report["errorCode"],
+                    "exitCode": check["exitCode"],
+                    "processStarted": check["processStarted"],
+                    "outsideWrite": False,
+                    "processResidue": False,
+                }
+            )
+    return results
+
+
+def main() -> None:
+    REVIEW_ROOT.mkdir(parents=True, exist_ok=True)
+    results = {
+        "timeout": timeout_case(),
+        "launch": launch_case(),
+        "identityMismatch": identity_mismatch_case(),
+        "containmentEscapes": containment_escape_cases(),
+    }
+    print(json.dumps(results, sort_keys=True, separators=(",", ":")))
+
+
+if __name__ == "__main__":
+    main()

