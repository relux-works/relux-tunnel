+        f"-DCMAKE_OSX_ARCHITECTURES={architecture}",
+        f"-DCMAKE_OSX_DEPLOYMENT_TARGET={build['target_triple'].split('ios')[-1].split('-')[0] if 'ios' in build['target_triple'] else build['target_triple'].split('macos')[-1]}",
