python3 - "$SMOKE_ROOT/$NATIVE_SLUG.json" "$NATIVE_TARGET" <<'PY'
import json, sys
report = json.load(open(sys.argv[1], encoding="utf-8"))
assert report["status"] == "pass"
assert report["target"] == sys.argv[2]
