  1777	  @discardableResult
  1778	  private func channelDispose(
  1779	    identity: SSHChannelIdentity,
  1780	    disposition: SSHTransportErrorCode,
  1781	    graceful: Bool,
  1782	    terminalEvent: SSHTransportEventKind?,
  1783	    triggersTeardownOnFailure: Bool = true
  1784	  ) async -> Bool {
  1785	    guard channels[identity] != nil else { return true }
  1786	    let task: Task<Bool, Never>
