   352	/// Value-semantic ledger. Copying the value copies a complete policy state, which keeps
   353	/// evaluation deterministic and lets a serialized owner install each returned transition atomically.
   354	public struct SSHReceiveWindowBudgetLedger: Sendable {
   355	  public let configuration: SSHReceiveWindowBudgetConfiguration
   356	  public private(set) var generation: UInt64
   357	  public private(set) var pressure: SSHReceiveWindowPressure
   358	  public private(set) var lanes: [SSHLaneIdentity: SSHReceiveWindowLane]
   359	
   360	  private let otherLedgerCommittedBytes: Int
   361	  private let otherGlobalWindowReservedBytes: Int
   362	  private var reservations: [SSHChannelIdentity: SSHReceiveWindowReservation] = [:]
   363	  private var releasedChannels: Set<SSHChannelIdentity> = []
   364	  private var metrics = SSHReceiveWindowMetrics()
   365	
   366	  public init(
   367	    configuration: SSHReceiveWindowBudgetConfiguration,
   368	    generation: UInt64,
   369	    pressure: SSHReceiveWindowPressure = .normal,
   370	    lanes: [SSHReceiveWindowLane],
   371	    otherLedgerCommittedBytes: Int = 0,
   372	    otherGlobalWindowReservedBytes: Int = 0
   373	  ) throws {
   374	    guard generation > 0 else {
   375	      throw SSHReceiveWindowConfigurationError.invalidValue("generation")
   376	    }
   377	    guard otherLedgerCommittedBytes >= 0,
   378	      otherLedgerCommittedBytes <= configuration.globalLedgerCeilingBytes
   379	    else {
   380	      throw SSHReceiveWindowConfigurationError.inconsistentBounds("otherLedgerCommittedBytes")
   381	    }
   382	    guard otherGlobalWindowReservedBytes >= 0,
   383	      otherGlobalWindowReservedBytes <= configuration.globalWindowCeilingBytes
   384	    else {
   385	      throw SSHReceiveWindowConfigurationError.inconsistentBounds(
   386	        "otherGlobalWindowReservedBytes")
   387	    }
   388	    var laneMap: [SSHLaneIdentity: SSHReceiveWindowLane] = [:]
   389	    for lane in lanes {
   390	      guard lane.generation > 0, lane.externallyReservedWindowBytes >= 0,
   391	        lane.externallyReservedWindowBytes <= configuration.perLaneWindowCeilingBytes,
   392	        laneMap.updateValue(lane, forKey: lane.identity) == nil
   393	      else {
   394	        throw SSHReceiveWindowConfigurationError.inconsistentBounds("lanes")
   395	      }
   396	    }
   397	    self.configuration = configuration
   398	    self.generation = generation
   399	    self.pressure = pressure
   400	    self.lanes = laneMap
   401	    self.otherLedgerCommittedBytes = otherLedgerCommittedBytes
   402	    self.otherGlobalWindowReservedBytes = otherGlobalWindowReservedBytes
   403	  }
