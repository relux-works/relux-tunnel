{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a7","stream":{"kind":"session","id":"01a0aa23-c753-7e20-ba14-a3c953f652a1"},"sequence":430,"recorded_at":1780531400000855,"record_type":"event","durability":"durable","causation_id":"60ee70b2-d33d-438c-9a26-1cd548916052","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"60ee70b2-d33d-438c-9a26-1cd548916052","run_stream":{"kind":"run","id":"60ee70b2-d33d-438c-9a26-1cd548916052"},"task_stream":{"kind":"task","id":"01a0aa25-48ee-78a1-b6e1-dae4dec1f0d0"},"task_id":"01a0aa25-48ee-78a1-b6e1-dae4dec1f0d0","event":{"kind":"output","task_id":"01a0aa25-48ee-78a1-b6e1-dae4dec1f0d0","chunk":"Read text file `scripts/tests/test_native_toolchain_mutants.py`.\n1|\"\"\"Require behavioral tests to kill narrowed native-toolchain regressions.\n2|\n3|Run: python3 scripts/tests/test_native_toolchain_mutants.py\n4|Each mutant runs in a disposable fixture, never edits the active checkout.\n5|The token-preserving mutant runs the full behavioral suite, not only the\n6|static contract checks.\n7|\"\"\"\n8|from pathlib import Path\n9|import shutil\n10|import subprocess\n11|import tempfile\n12|\n13|ROOT = Path(__file__).resolve().parents[2]\n14|COPIED = (\n15|    \"scripts/select-native-xcode.sh\",\n16|    \"scripts/tests/test_native_toolchain_alignment.py\",\n17|    \".github/workflows/ci.yml\",\n18|    \"NativeDependencies/manifest.json\",\n19|)\n20|MUTANTS = {\n21|    # Gate stays present; it additionally admits the macos-26 default build.\n22|    \"admit-macos26-default-only\": (\n23|        '''  *)\n24|    echo \"select-native-xcode: Xcode build mismatch''',\n25|        '''  *\"Build version 17F113\"*) ;;\n26|  *)\n27|    echo \"select-native-xcode: Xcode build mismatch''',\n28|        [\"NativeToolchainAlignmentTests.test_selection_rejects_macos26_default_build\"],\n29|    ),\n30|    # The 17F42 token is preserved everywhere; only the selected app changes.\n31|    \"select-wrong-app-preserves-token\": (\n32|        '17F42) xcode_app=\"$xcode_root/Xcode_26.5.app\" ;;',\n33|        '17F42) xcode_app=\"$xcode_root/Xcode_26.6.app\" ;;',\n34|        [],\n35|    ),\n36|}\n37|\n38|\n39|def stage(root):\n40|    for relative in COPIED:\n41|        target = root / relative\n42|        target.parent.mkdir(parents=True, exist_ok=True)\n43|        shutil.copyfile(ROOT / relative, target)\n44|\n45|\n46|def run_suite(root, extra):\n47|    return subprocess.run(\n48|        [\"python3\", \"scripts/tests/test_native_toolchain_alignment.py\", *extra],\n49|        cwd=root, capture_output=True, text=True)\n50|\n51|\n52|def main():\n53|    with tempfile.TemporaryDirectory(prefix=\"native-toolchain-baseline-\") as directory:\n54|        root = Path(directory)\n55|        stage(root)\n56|        baseline = run_suite(root, [])\n57|        print(f\"baseline: behavioral suite exit {baseline.returncode}\")\n58|        print(baseline.stdout + baseline.stderr)\n59|        if baseline.returncode != 0:\n60|            raise SystemExit(\"mutant proof failed: baseline is not green\")\n61|    for name, (before, after, extra) in MUTANTS.items():\n62|        with tempfile.TemporaryDirectory(prefix=\"native-toolchain-mutant-\") as directory:\n63|            root = Path(directory)\n64|            stage(root)\n65|            script = root / \"scripts/select-native-xcode.sh\"\n66|            source = script.read_text()\n67|            assert source.count(before) == 1, f\"mutant anchor is not unique: {name}\"\n68|            script.write_text(source.replace(before, after))\n69|            result = run_suite(root, extra)\n70|            scope = \"named test\" if extra else \"full behavioral suite\"\n71|            print(f\"{name}: {scope} exit {result.returncode}\")\n72|            print(result.stdout + result.stderr)\n73|            if result.returncode == 0 or \"AssertionError\" not in result.stderr:\n74|                raise SystemExit(f\"mutant survived or test infrastructure failed: {name}\")\n75|    print(f\"All {len(MUTANTS)} narrowing mutants killed by production-entry behavioral tests\")\n76|\n77|\n78|if __name__ == \"__main__\":\n79|    main()","final_result":true}}}
