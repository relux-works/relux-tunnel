   709	  private func runRekeyFlight(until deadline: ContinuousClock.Instant) async {
   710	    var permit: LibSSH2SessionOperationPermit?
   711	    do {
   712	      permit = try await beginSessionOperation(phase: .rekey, until: deadline)
   713	      try await performRequestRekey(until: deadline)
   714	      if let permit { finishSessionOperation(permit) }
   715	      finishRekeyFlight(with: .success(()))
   716	    } catch {
   717	      if let permit { finishSessionOperation(permit) }
   718	      let mapped = map(error, phase: .rekey, fallback: .rekeyFailed)
   719	      await recordTerminalOperation(mapped)
   720	      if state != .failed, state != .closing, state != .closed {
   721	        try? await transition(to: .failed)
   722	      }
   723	      finishRekeyFlight(with: .failure(mapped))
   724	      _ = startTearDownIfNeeded()
   725	    }
   726	  }
   727	
   728	  private func finishRekeyFlight(with result: Result<Void, Error>) {
   729	    let waiters = Array(rekeyWaiters.values)
   730	    rekeyWaiters.removeAll(keepingCapacity: false)
   731	    rekeyReasons.removeAll(keepingCapacity: false)
   732	    rekeyFlightInProgress = false
   733	    rekeyFlightDeadline = nil
   734	    for waiter in waiters { waiter.complete(with: result) }
   735	  }
