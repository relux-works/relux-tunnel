   605	def count_new_matches(window: bytes, previous_tail_size: int, pattern: bytes) -> int:
   606	    count = 0
   607	    start = 0
   608	    while True:
   609	        match = window.find(pattern, start)
   610	        if match < 0:
   611	            return count
   612	        if match + len(pattern) > previous_tail_size:
   613	            count += 1
   614	        start = match + 1
