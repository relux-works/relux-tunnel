  1711	    try await withCheckedThrowingContinuation { continuation in
  1712	      race.start(
  1713	        continuation: continuation,
  1714	        timeout: timeout,
  1715	        clock: clock,
  1716	        operation: operation
  1717	      )
  1718	    }
  1719	  } onCancel: {
  1720	    race.cancel()
  1721	  }
  1722	}
