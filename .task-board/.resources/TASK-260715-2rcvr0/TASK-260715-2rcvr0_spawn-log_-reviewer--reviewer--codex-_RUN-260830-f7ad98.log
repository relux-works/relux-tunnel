   582	  public func start(configuration: TunnelConfiguration) async throws {
   583	    try await startGeneration(configuration: configuration)
   584	  }
   585	
   586	  public nonisolated func start(
   587	    configuration: TunnelConfiguration,
   588	    completionHandler: @escaping ProviderStartCompletionHandler
   589	  ) {
   590	    let gate = ProviderOnceGate<NSError?>(completionHandler)
   591	    Task { [weak self] in
   592	      guard let self else {
   593	        gate.complete(ProviderNSErrorCode.internalInvariant.nsError)
   594	        return
   595	      }
   596	      await self.startWithGate(configuration: configuration, gate: gate)
   597	    }
   598	  }
   599	
   600	  private func startWithGate(
   601	    configuration: TunnelConfiguration,
   602	    gate: ProviderOnceGate<NSError?>
   603	  ) async {
   604	    guard pendingStartGate == nil else {
   605	      gate.complete(ProviderNSErrorCode.lifecycleBusy.nsError)
   606	      return
   607	    }
   608	    pendingStartGate = gate
   609	    do {
   610	      try await startGeneration(configuration: configuration)
   611	      gate.complete(nil)
   612	    } catch let error as ProviderAdapterError {
   613	      gate.complete(error.nsError)
   614	    } catch {
   615	      gate.complete(ProviderNSErrorCode.runtimeStartupFailed.nsError)
   616	    }
   617	    if pendingStartGate === gate {
   618	      pendingStartGate = nil
   619	    }
   620	  }
   621	
   622	  private func startGeneration(configuration: TunnelConfiguration) async throws {
   623	    guard phase == .idle, !awaitingSystemStopAfterProviderFailure else {
   624	      throw ProviderAdapterError.lifecycleBusy(phase)
   625	    }
   626	    guard latestGeneration < UInt64.max else {
   627	      throw ProviderAdapterError.generationExhausted
   628	    }
   629	
   630	    latestGeneration += 1
   631	    let generation = latestGeneration
   632	    failureAdmission.releaseForNewGeneration()
   633	    let registry = ProviderCleanupRegistry()
   634	    if let controllable = packetFlow as? any ProviderCleanupControllable {
   635	      registry.register(controllable)
   636	    }
   637	    activeGeneration = ActiveGeneration(
   638	      identifier: generation,
   639	      cleanupRegistry: registry,
   640	      retirementSignal: ProviderRetirementSignal(),
   641	      runtime: nil
   642	    )
   643	    resetRequestLedger(for: generation)
   644	    phase = .starting
   645	
   646	    let context = TunnelRuntimeContext(
   647	      configuration: configuration,
   648	      packetFlow: packetFlow,
   649	      dependencies: dependencies,
   650	      cleanupRegistry: registry
   651	    )
   652	    let operation = Task { [runtimeFactory, weak self] () -> StartRaceResult in
   653	      do {
   654	        let runtime = try await runtimeFactory.makeRuntime(context: context)
   655	        guard self != nil else {
   656	          if let controllable = runtime as? any ProviderCleanupControllable {
   657	            registry.register(controllable)
   658	          }
   659	          registry.forceCloseAll()
   660	          Task { await runtime.stop(reason: .startupFailure) }
   661	          return .failed(.startCancelled)
   662	        }
   663	        guard
   664	          await self?.install(
   665	            runtime: runtime,
   666	            generation: generation,
   667	            registry: registry
   668	          ) == true
   669	        else {
   670	          Task { await runtime.stop(reason: .startupFailure) }
   671	          return .failed(.startCancelled)
   672	        }
   673	        try await runtime.start()
   674	        return .succeeded
   675	      } catch is CancellationError {
   676	        return .failed(.startCancelled)
   677	      } catch let error as ProviderAdapterError {
   678	        return .failed(error)
   679	      } catch {
   680	        return .failed(.runtimeStartupFailed)
   681	      }
   682	    }
   683	
   684	    let outcome = await raceStart(operation)
   685	    switch outcome {
   686	    case .succeeded:
   687	      guard phase == .starting, activeGeneration?.identifier == generation else {
   688	        await joinCleanupIfPresent(generation: generation)
   689	        throw ProviderAdapterError.startCancelled
   690	      }
   691	      phase = .running
   692	    case .failed(let error):
   693	      await stopAndJoin(
   694	        reason: error == .startCancelled ? .system : .startupFailure,
   695	        generation: generation,
   696	        keepStoppingAfterCleanup: false
   697	      )
   698	      throw error
   699	    case .deadline:
   700	      operation.cancel()
   701	      await stopAndJoin(
   702	        reason: .startupFailure,
   703	        generation: generation,
   704	        keepStoppingAfterCleanup: false
   705	      )
   706	      throw ProviderAdapterError.startupTimedOut
   707	    }
   708	  }
   709	
   710	  private func install(
   711	    runtime: any TunnelRuntime,
   712	    generation: UInt64,
   713	    registry: ProviderCleanupRegistry
   714	  ) -> Bool {
   715	    guard phase == .starting, activeGeneration?.identifier == generation else {
   716	      if let controllable = runtime as? any ProviderCleanupControllable {
   717	        registry.register(controllable)
   718	      }
   719	      return false
   720	    }
   721	    if let controllable = runtime as? any ProviderCleanupControllable {
   722	      activeGeneration?.cleanupRegistry.register(controllable)
   723	    }
   724	    activeGeneration?.runtime = runtime
   725	    return true
   726	  }
   727	
   728	  private func raceStart(_ operation: Task<StartRaceResult, Never>) async -> StartRaceResult {
   729	    let first = ProviderFirstResult<StartRaceResult>()
   730	    Task {
   731	      first.resolve(await operation.value)
   732	    }
   733	    let deadline = Task { [clock = dependencies.clock, startBudget] in
   734	      do {
   735	        try await clock.sleep(for: startBudget)
   736	        first.resolve(.deadline)
   737	      } catch {
   738	        // Cancellation means startup won the race.
   739	      }
   740	    }
   741	    let result = await first.wait()
   742	    if case .deadline = result {
   743	      operation.cancel()
   744	    } else {
   745	      deadline.cancel()
   746	    }
   747	    return result
   748	  }
   749	
   750	  public func stop(reason: ProviderStopReason) async {
   751	    await performStop(reason: reason, gate: nil)
   752	  }
   753	
   754	  public nonisolated func stop(
   755	    rawReason: Int,
   756	    completionHandler: @escaping ProviderStopCompletionHandler
   757	  ) {
   758	    let gate = ProviderOnceGate<Void> { _ in completionHandler() }
   759	    Task { [weak self] in
   760	      guard let self else {
   761	        gate.complete(())
   762	        return
   763	      }
   764	      await self.stopWithRawReason(rawReason, gate: gate)
   765	    }
   766	  }
   767	
   768	  private func stopWithRawReason(
   769	    _ rawReason: Int,
   770	    gate: ProviderOnceGate<Void>
   771	  ) async {
   772	    lifecycleDiagnostics?.recordProviderStopReason(rawValue: rawReason)
   773	    let reason = ProviderStopReason.apple(rawValue: rawReason, duringStartup: phase == .starting)
   774	    await performStop(reason: reason, gate: gate)
   775	  }
   776	
   777	  private func performStop(
   778	    reason: ProviderStopReason,
   779	    gate: ProviderOnceGate<Void>?
   780	  ) async {
   781	    if awaitingSystemStopAfterProviderFailure {
   782	      if let cleanupTask {
   783	        _ = await cleanupTask.value
   784	        finalizeCleanup(
   785	          generation: cleanupGeneration,
   786	          keepStoppingAfterCleanup: true
   787	        )
   788	      }
   789	      pendingStartGate?.complete(ProviderNSErrorCode.startCancelled.nsError)
   790	      pendingStartGate = nil
   791	      awaitingSystemStopAfterProviderFailure = false
   792	      phase = .idle
   793	      gate?.complete(())
   794	      return
   795	    }
   796	
   797	    guard let generation = activeGeneration?.identifier else {
   798	      phase = .idle
   799	      pendingStartGate?.complete(ProviderNSErrorCode.startCancelled.nsError)
   800	      pendingStartGate = nil
   801	      gate?.complete(())
   802	      return
   803	    }
   804	
   805	    await stopAndJoin(
   806	      reason: reason,
   807	      generation: generation,
   808	      keepStoppingAfterCleanup: false
   809	    )
   810	    pendingStartGate?.complete(ProviderNSErrorCode.startCancelled.nsError)
   811	    pendingStartGate = nil
   812	    gate?.complete(())
   813	  }
   814	
   815	  private func stopAndJoin(
   816	    reason: ProviderStopReason,
   817	    generation: UInt64,
   818	    keepStoppingAfterCleanup: Bool
   819	  ) async {
   820	    guard activeGeneration?.identifier == generation || cleanupGeneration == generation else {
   821	      return
   822	    }
   823	    let operation = beginCleanup(reason: reason, generation: generation)
   824	    _ = await operation.value
   825	    finalizeCleanup(
   826	      generation: generation,
   827	      keepStoppingAfterCleanup: keepStoppingAfterCleanup
   828	    )
   829	  }
   830	
   831	  private func joinCleanupIfPresent(generation: UInt64) async {
   832	    guard cleanupGeneration == generation, let cleanupTask else { return }
   833	    _ = await cleanupTask.value
   834	    finalizeCleanup(generation: generation, keepStoppingAfterCleanup: false)
   835	  }
   836	
   837	  private func beginCleanup(
   838	    reason: ProviderStopReason,
   839	    generation: UInt64
   840	  ) -> Task<CleanupRaceResult, Never> {
   841	    if cleanupGeneration == generation, let cleanupTask {
   842	      return cleanupTask
   843	    }
   844	
   845	    phase = .stopping
   846	    retireRequestLedger(generation: generation)
   847	    activeGeneration?.retirementSignal.retire()
   848	    let runtime = activeGeneration?.identifier == generation ? activeGeneration?.runtime : nil
   849	    let registry =
   850	      activeGeneration?.identifier == generation
   851	      ? activeGeneration?.cleanupRegistry : nil
   852	    registry?.cancelAll()
   853	
   854	    let operation = Task { [clock = dependencies.clock, cleanupBudget, lifecycleDiagnostics] in
   855	      guard let registry else { return CleanupRaceResult.graceful }
   856	      guard let runtime else {
   857	        registry.retireAfterGracefulCleanup()
   858	        return .graceful
   859	      }
   860	
   861	      let first = ProviderFirstResult<CleanupRaceResult>()
   862	      let graceful = Task {
   863	        await runtime.stop(reason: reason)
   864	        first.resolve(.graceful)
   865	      }
   866	      let deadline = Task {
   867	        do {
   868	          try await clock.sleep(for: cleanupBudget)
   869	          first.resolve(.deadline)
   870	        } catch {
   871	          // Cancellation means graceful cleanup won the race.
   872	        }
   873	      }
   874	
   875	      let result = await first.wait()
   876	      switch result {
   877	      case .graceful:
   878	        deadline.cancel()
   879	        registry.retireAfterGracefulCleanup()
   880	      case .deadline:
   881	        graceful.cancel()
   882	        registry.forceCloseAll()
   883	        lifecycleDiagnostics?.recordProviderCleanupDeadlineExceeded()
   884	      }
   885	      return result
   886	    }
   887	    cleanupGeneration = generation
   888	    cleanupTask = operation
   889	    return operation
   890	  }
   891	
   892	  private func finalizeCleanup(
   893	    generation: UInt64?,
   894	    keepStoppingAfterCleanup: Bool
   895	  ) {
   896	    guard let generation, cleanupGeneration == generation else { return }
   897	    activeGeneration = nil
   898	    cleanupTask = nil
   899	    cleanupGeneration = nil
   900	    phase = keepStoppingAfterCleanup ? .stopping : .idle
   901	  }
