   893	    case "FPE": .floatingPointException
   894	    case "KILL": .kill
   895	    case "SEGV": .segmentationFault
   896	    case "PIPE": .pipe
   897	    case "ALRM": .alarm
   898	    case "TERM": .terminate
   899	    default: .other(value)
   900	    }
   901	  }
   902	
   903	  private func tearDown() async {
   904	    automaticRekeyTask?.cancel()
   905	    automaticKeepaliveTask?.cancel()
   906	    automaticRekeyTask = nil
   907	    automaticKeepaliveTask = nil
   908	    for record in channels.values {
   909	      _ = libssh2_channel_free(record.pointer)
   910	    }
   911	    channels.removeAll(keepingCapacity: false)
   912	    if let engineSession {
   913	      _ = libssh2_session_disconnect_ex(
   914	        engineSession,
   915	        Int32(SSH_DISCONNECT_BY_APPLICATION),
   916	        "closed",
   917	        ""
   918	      )
   919	      _ = libssh2_session_free(engineSession)
   920	      self.engineSession = nil
   921	    }
   922	    context.network.discard()
   923	    await connection?.close()
   924	    connection = nil
   925	    negotiatedAlgorithms = nil
   926	    if state != .closed {
   927	      if state != .closing { try? await transition(to: .closing) }
   928	      try? await transition(to: .closed)
   929	    }
   930	  }
   931	
   932	  private func transition(to next: SSHConnectionState) async throws {
   933	    guard state.permitsTransition(to: next) else {
   934	      throw transportError(code: .invalidState, phase: phase(for: state))
   935	    }
   936	    let previous = state
   937	    state = next
   938	    await emit(.connectionTransition(from: previous, to: next))
   939	  }
   940	

