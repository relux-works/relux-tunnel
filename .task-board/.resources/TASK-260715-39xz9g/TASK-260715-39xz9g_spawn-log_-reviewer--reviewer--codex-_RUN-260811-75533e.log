   771	def run_orchestration(manifest: dict, invoke: ExternalInvoker) -> dict:
   772	    """Run the public matrix contract while keeping runtime credentials in memory."""
   773	
   774	    validate_manifest(manifest)
   775	    servers = {server["id"]: server for server in manifest["servers"]}
   776	    prepared: list[tuple[dict, str]] = []
   777	    runtimes: dict[str, dict] = {}
   778	    server_observations = []
   779	    lifecycle_observations = []
   780	    matrix_observations = []
   781	    failure: Exception | None = None
   782	    try:
   783	        for server_id in sorted(REQUIRED_SERVERS):
   784	            server = servers[server_id]
   785	            reference = _provider_reference(server_id)
   786	            prepared.append((server, reference))
   787	            prepare = invoke(
   788	                reference,
   789	                {
   790	                    "protocol": "relux-ssh-matrix-provider-v1",
   791	                    "action": "prepare",
   792	                    "serverId": server_id,
   793	                    "secretReference": server["identity"]["secretReference"],
   794	                },
   795	            )
   796	            runtime = _validate_runtime(server_id, prepare)
   797	            runtimes[server_id] = runtime
   798	            rotation = invoke(
   799	                reference,
   800	                {
   801	                    "protocol": "relux-ssh-matrix-provider-v1",
   802	                    "action": "rotate",
   803	                    "serverId": server_id,
   804	                    "runtime": runtime,
   805	                },
   806	            )
   807	            disposition = rotation.get("disposition")
   808	            allowed = {"rotated", "external-owner-managed"}
