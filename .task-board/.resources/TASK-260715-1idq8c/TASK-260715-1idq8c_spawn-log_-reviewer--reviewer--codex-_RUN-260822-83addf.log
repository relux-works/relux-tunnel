+#!/bin/sh
+set -eu
+
+root=$(mktemp -d "${TMPDIR:-/tmp}/relux-review-artifacts.XXXXXX")
+trap 'rm -rf "$root"' EXIT HUP INT TERM
+stubs="$root/stubs"
+mkdir -p "$stubs"
+
+cat > "$stubs/workspace-generator" <<'EOF'
+#!/bin/sh
+exit 0
+EOF
+
+cat > "$stubs/xcodebuild" <<'EOF'
+#!/bin/sh
+set -eu
+derived=
+result=
+while [ "$#" -gt 0 ]; do
+  case "$1" in
+    -derivedDataPath) shift; derived=$1 ;;
+    -resultBundlePath) shift; result=$1 ;;
+  esac
+  shift
+done
+if [ -n "$result" ]; then
+  mkdir -p "$result"
+else
+  mkdir -p "$derived/Build/Products"
+  : > "$derived/Build/Products/ReluxProxyMacUITests_review.xctestrun"
+fi
+EOF
+
+cat > "$stubs/xcrun" <<'EOF'
+#!/bin/sh
+printf '%s\n' '{"devices":{"runtime":[{"isAvailable":true,"name":"iPhone Review","udid":"review-sim"}]}}'
+EOF
+
+cat > "$stubs/swift" <<'EOF'
+#!/bin/sh
+set -eu
+if [ "$1" = run ]; then
+  mkdir -p "$5"
+  : > "$5/reference.png"
+  : > "$5/failed.png"
+  : > "$5/diff.png"
+  exit 1
+fi
+mkdir -p "$2"
+EOF
+
+cat > "$stubs/extractor" <<'EOF'
+#!/bin/sh
+set -eu
+output=$2
+mkdir -p "$output/screenshots/test"
+case "$CASE_MODE" in
+  missing_manifest) ;;
+  malformed_manifest) printf '%s\n' 'not-json' > "$output/screenshots.json" ;;
+  empty_png)
+    image="$output/screenshots/test/Step_01__diagnostic_fixture_ready.png"
+    : > "$image"
+    printf '{"schemaVersion":1,"stepScreenshotCount":1,"screenshots":[{"path":"%s"}]}\n' "$image" > "$output/screenshots.json"
+    ;;
+  outside_png)
+    image="$output/../outside.png"
+    printf x > "$image"
+    printf '{"schemaVersion":1,"stepScreenshotCount":1,"screenshots":[{"path":"%s"}]}\n' "$image" > "$output/screenshots.json"
+    ;;
+  missing_step)
+    image="$output/screenshots/test/Step_01__diagnostic_fixture_ready.png"
+    printf x > "$image"
+    printf '{"schemaVersion":1,"stepScreenshotCount":1,"screenshots":[{"path":"%s"}]}\n' "$image" > "$output/screenshots.json"
+    ;;
+  duplicate_step)
+    one="$output/screenshots/test/Step_01__diagnostic_fixture_ready_a.png"
+    two="$output/screenshots/test/Step_01__diagnostic_fixture_ready_b.png"
+    confirmed="$output/screenshots/test/Step_02__diagnostic_fixture_confirmed.png"
+    printf x > "$one"; printf x > "$two"; printf x > "$confirmed"
+    printf '{"schemaVersion":1,"stepScreenshotCount":3,"screenshots":[{"path":"%s"},{"path":"%s"},{"path":"%s"}]}\n' "$one" "$two" "$confirmed" > "$output/screenshots.json"
+    ;;
+  *) exit 99 ;;
+esac
+exit 0
+EOF
+
+chmod +x "$stubs"/*
+
+for mode in missing_manifest malformed_manifest empty_png outside_png missing_step duplicate_step; do
+  output="$root/output-$mode"
+  set +e
+  CASE_MODE=$mode \
+  RELUX_APPLE_UI_TEST_OUTPUT_ROOT="$output" \
+  RELUX_APPLE_UI_TEST_WORKSPACE_GENERATOR="$stubs/workspace-generator" \
+  RELUX_APPLE_UI_TEST_XCODEBUILD="$stubs/xcodebuild" \
+  RELUX_APPLE_UI_TEST_XCRUN="$stubs/xcrun" \
+  RELUX_APPLE_UI_TEST_EXTRACTOR="$stubs/extractor" \
+  RELUX_APPLE_UI_TEST_SWIFT="$stubs/swift" \
+    ./scripts/run-apple-ui-test-smoke.sh > "$root/$mode.log" 2>&1
+  status=$?
+  set -e
+  summary=$(find "$output" -name summary.txt -type f -print -quit)
+  test "$status" -ne 0
+  test -n "$summary"
+  grep -q '^macos_build_for_testing_exit=0$' "$summary"
+  grep -q '^macos_runtime_status=deferred$' "$summary"
+  grep -q '^ios_simulator_xcodebuild_exit=0$' "$summary"
+  grep -q '^ios_simulator_artifact_exit=2$' "$summary"
+  grep -q '^ios_simulator_row_exit=2$' "$summary"
+  grep -q '^aggregate_build_host_exit=1$' "$summary"
+  printf '%s: smoke=%s artifact=2 row=2 aggregate=1\n' "$mode" "$status"
+done

