   258	def verify_board_state(board_state_path: Path, manifest: dict[str, Any]) -> None:
   259	    board_state = json.loads(board_state_path.read_text(encoding="utf-8"))
   260	    if not isinstance(board_state, list) or len(board_state) != 4:
   261	        raise BindingError("BOARD-STATE", "exactly four authority rows are required")
   262	    rows: dict[str, dict[str, Any]] = {}
   263	    for raw_row in board_state:
   264	        row = require_object(raw_row, "BOARD-STATE")
   265	        require_exact_keys(row, {"id", "status", "outcomeResources"}, "BOARD-STATE-FIELDS")
   266	        task_id = row["id"]
   267	        if task_id in rows:
   268	            raise BindingError("BOARD-STATE", f"duplicate task {task_id}")
   269	        rows[task_id] = row
   270	
   271	    required: dict[str, set[str]] = {}
   272	    runtime = manifest["runtimeContract"]
   273	    required[runtime["taskId"]] = {
   274	        runtime["resourceName"], runtime["reviewerVerdict"]["resourceName"]
   275	    }
   276	    for item in manifest["acceptedInputs"]:
   277	        required[item["taskId"]] = {
   278	            item["acceptedOutcome"]["resourceName"],
   279	            item["reviewerVerdict"]["resourceName"],
   280	        }
   281	    if set(rows) != set(required):
   282	        raise BindingError("BOARD-STATE", "authority task set drift")
   283	    for task_id, names in required.items():
   284	        row = rows[task_id]
   285	        if row["status"] != "done":
   286	            raise BindingError("BOARD-STATE", f"{task_id} is not reviewer-terminal done")
   287	        resources = row["outcomeResources"]
   288	        if not isinstance(resources, list):
   289	            raise BindingError("BOARD-STATE", f"{task_id} outcome resource declaration unreadable")
   290	        declared = {
   291	            item.get("name") for item in resources if isinstance(item, dict)
   292	        }
   293	        missing = sorted(names - declared)
   294	        if missing:
   295	            raise BindingError(
   296	                "BOARD-STATE", f"{task_id} accepted resources are no longer declared: {missing}"
   297	            )
   298	
