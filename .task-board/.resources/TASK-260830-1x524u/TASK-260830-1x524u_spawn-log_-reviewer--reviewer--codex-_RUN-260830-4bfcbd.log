RELAY_GOROOT ?= $(RELAY_GO_INSTALL)/go
RELAY_GO_TOOLCHAIN ?= local
RELAY_SYFT ?= $(RELAY_SYFT_INSTALL)/syft
RELAY_GO_ARCHIVE ?=
RELAY_SYFT_ARCHIVE ?=
