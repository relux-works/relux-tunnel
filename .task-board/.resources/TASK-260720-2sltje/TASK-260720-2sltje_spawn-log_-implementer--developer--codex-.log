+               session, &context, first_failure_event,
+               LIBSSH2_SERVER_KEX_FAILED))
+            return 1;
+    }
+
     printf("client rekey completed after %d EAGAIN result(s); post-rekey "
-           "channels succeeded\n",
-           eagain_count);
-    libssh2_session_disconnect(session, "test complete");
+           "channels succeeded; %zu server-KEX transitions observed\n",
+           eagain_count, context.event_count);
     libssh2_session_free(session);
     close(socket_fd);
     libssh2_exit();
diff --git a/Dependencies/ReluxLibSSH2/patches/0001-public-client-rekey.patch b/Dependencies/ReluxLibSSH2/patches/0001-public-client-rekey.patch
