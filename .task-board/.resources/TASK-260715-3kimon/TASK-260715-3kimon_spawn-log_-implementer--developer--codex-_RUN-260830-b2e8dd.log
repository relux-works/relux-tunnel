   657	    _ lane: SSHLaneIdentity,
   658	    generation: UInt64
   659	  ) throws -> SSHReceiveWindowLane {
   660	    guard generation == self.generation else { throw SSHReceiveWindowRefusal.staleGeneration }
   661	    guard let lane = lanes[lane] else { throw SSHReceiveWindowRefusal.unknownLane }
   662	    guard lane.generation == generation else { throw SSHReceiveWindowRefusal.staleGeneration }
   663	    guard lane.state == .ready else { throw SSHReceiveWindowRefusal.laneUnavailable }
