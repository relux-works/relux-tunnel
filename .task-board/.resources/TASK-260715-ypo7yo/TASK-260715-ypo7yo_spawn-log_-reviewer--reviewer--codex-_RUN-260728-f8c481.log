/bin/zsh -lc "jq -r 'paths(strings) as "'$p | (getpath($p)) as $v | select(($v|test("probe App Group|group.works.relux.tunnel.probe|probe.*group|App Group.*probe";"i"))) | [($p|map(tostring)|join(".")),$v] | @tsv'"' .temp/resources/TASK-260715-ypo7yo/TASK-260715-ypo7yo_apple-identifier-entitlement-matrix.json" in /Users/iv/Developer/relux-tunnel
