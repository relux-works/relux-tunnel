import Foundation

/// Logical receive-window classes. These are policy classes, not SSH engine channel kinds.
public enum SSHReceiveWindowClass: String, CaseIterable, Hashable, Sendable {
  case control
  case ordinary
  case bulk
  case relay
}

public enum SSHReceiveWindowPressure: String, CaseIterable, Sendable {
  case normal
  case soft
  case pressure
  case critical
}

public enum SSHReceiveWindowLaneState: String, CaseIterable, Sendable {
  case ready
  case rekeying
  case failed
  case closing
  case closed
}

public struct SSHBulkPathMeasurement: Equatable, Sendable {
  /// Integer bits per second.
  public let bandwidthBitsPerSecond: UInt64
  /// Integer nanoseconds.
  public let roundTripTimeNanoseconds: UInt64

  public init(bandwidthBitsPerSecond: UInt64, roundTripTimeNanoseconds: UInt64) {
    self.bandwidthBitsPerSecond = bandwidthBitsPerSecond
    self.roundTripTimeNanoseconds = roundTripTimeNanoseconds
  }
}

public struct SSHReceiveWindowClassLimits: Equatable, Sendable {
  public let maximumAdvertisedWindowBytes: Int
  public let lowWaterBytes: Int
  public let readBufferCapacityBytes: Int
  public let writeCapacityBytes: Int
  public let metadataCapacityBytes: Int

  public init(
    maximumAdvertisedWindowBytes: Int,
    lowWaterBytes: Int,
    readBufferCapacityBytes: Int,
    writeCapacityBytes: Int,
    metadataCapacityBytes: Int
  ) {
    self.maximumAdvertisedWindowBytes = maximumAdvertisedWindowBytes
    self.lowWaterBytes = lowWaterBytes
    self.readBufferCapacityBytes = readBufferCapacityBytes
    self.writeCapacityBytes = writeCapacityBytes
    self.metadataCapacityBytes = metadataCapacityBytes
  }
}

public enum SSHReceiveWindowConfigurationError: Error, Equatable, Sendable {
  case missingClass(SSHReceiveWindowClass)
  case invalidValue(String)
  case invalidCandidate(String)
  case inconsistentBounds(String)
  case arithmeticOverflow(String)
}

/// All byte values use binary bytes (`KiB = 1024 B`). Bandwidth is bits/s and RTT is ns.
/// The two measurement caps are applied before any multiplication.
public struct SSHReceiveWindowBudgetConfiguration: Equatable, Sendable {
  public static let window32KiB = 32 * 1_024
  public static let window64KiB = 64 * 1_024

  public let controlInitialWindowBytes: Int
  public let ordinaryInitialWindowBytes: Int
  public let bulkMinimumWindowBytes: Int
  public let bulkMaximumWindowBytes: Int
  public let maximumMeasuredBandwidthBitsPerSecond: UInt64
  public let maximumMeasuredRTTNanoseconds: UInt64
  public let relayControlWindowBytes: Int
  public let relayBurstDatagramCount: Int
  public let relayMaximumFrameBodyBytes: Int
  public let relayMaximumWindowBytes: Int
  public let softInitialWindowCapBytes: Int
  public let perChannelWindowCeilingBytes: Int
  public let perLaneWindowCeilingBytes: Int
  public let globalWindowCeilingBytes: Int
  public let globalLedgerCeilingBytes: Int
  public let classLimits: [SSHReceiveWindowClass: SSHReceiveWindowClassLimits]

  public init(
    controlInitialWindowBytes: Int,
    ordinaryInitialWindowBytes: Int,
    bulkMinimumWindowBytes: Int,
    bulkMaximumWindowBytes: Int,
    maximumMeasuredBandwidthBitsPerSecond: UInt64,
    maximumMeasuredRTTNanoseconds: UInt64,
    relayControlWindowBytes: Int,
    relayBurstDatagramCount: Int,
    relayMaximumFrameBodyBytes: Int,
    relayMaximumWindowBytes: Int,
    softInitialWindowCapBytes: Int,
    perChannelWindowCeilingBytes: Int,
    perLaneWindowCeilingBytes: Int,
    globalWindowCeilingBytes: Int,
    globalLedgerCeilingBytes: Int,
    classLimits: [SSHReceiveWindowClass: SSHReceiveWindowClassLimits]
  ) throws {
    let candidates = [Self.window32KiB, Self.window64KiB]
    guard candidates.contains(controlInitialWindowBytes) else {
      throw SSHReceiveWindowConfigurationError.invalidCandidate("controlInitialWindowBytes")
    }
    guard candidates.contains(ordinaryInitialWindowBytes) else {
      throw SSHReceiveWindowConfigurationError.invalidCandidate("ordinaryInitialWindowBytes")
    }
    guard candidates.contains(softInitialWindowCapBytes) else {
      throw SSHReceiveWindowConfigurationError.invalidCandidate("softInitialWindowCapBytes")
    }
    let positiveValues: [(Int, String)] = [
      (bulkMinimumWindowBytes, "bulkMinimumWindowBytes"),
      (bulkMaximumWindowBytes, "bulkMaximumWindowBytes"),
      (relayControlWindowBytes, "relayControlWindowBytes"),
      (relayBurstDatagramCount, "relayBurstDatagramCount"),
      (relayMaximumFrameBodyBytes, "relayMaximumFrameBodyBytes"),
      (relayMaximumWindowBytes, "relayMaximumWindowBytes"),
      (perChannelWindowCeilingBytes, "perChannelWindowCeilingBytes"),
      (perLaneWindowCeilingBytes, "perLaneWindowCeilingBytes"),
      (globalWindowCeilingBytes, "globalWindowCeilingBytes"),
      (globalLedgerCeilingBytes, "globalLedgerCeilingBytes"),
    ]
    for (value, field) in positiveValues where value <= 0 {
      throw SSHReceiveWindowConfigurationError.invalidValue(field)
    }
    guard maximumMeasuredBandwidthBitsPerSecond > 0 else {
      throw SSHReceiveWindowConfigurationError.invalidValue(
        "maximumMeasuredBandwidthBitsPerSecond")
    }
    guard maximumMeasuredRTTNanoseconds > 0 else {
      throw SSHReceiveWindowConfigurationError.invalidValue("maximumMeasuredRTTNanoseconds")
    }
    guard bulkMinimumWindowBytes <= bulkMaximumWindowBytes else {
      throw SSHReceiveWindowConfigurationError.inconsistentBounds("bulkWindowBounds")
    }
    guard perChannelWindowCeilingBytes <= perLaneWindowCeilingBytes,
      perLaneWindowCeilingBytes <= globalWindowCeilingBytes,
      globalWindowCeilingBytes <= globalLedgerCeilingBytes
    else {
      throw SSHReceiveWindowConfigurationError.inconsistentBounds("ledgerCeilings")
    }
    guard perChannelWindowCeilingBytes <= Int(UInt32.max) else {
      throw SSHReceiveWindowConfigurationError.inconsistentBounds("protocolWindowCeiling")
    }
    for channelClass in SSHReceiveWindowClass.allCases {
      guard let limits = classLimits[channelClass] else {
        throw SSHReceiveWindowConfigurationError.missingClass(channelClass)
      }
      guard limits.maximumAdvertisedWindowBytes > 0,
        limits.lowWaterBytes > 0,
        limits.lowWaterBytes <= limits.maximumAdvertisedWindowBytes,
        limits.readBufferCapacityBytes > 0,
        limits.writeCapacityBytes > 0,
        limits.metadataCapacityBytes >= 0
      else {
        throw SSHReceiveWindowConfigurationError.inconsistentBounds(
          "classLimits.\(channelClass.rawValue)")
      }
      guard limits.maximumAdvertisedWindowBytes <= perChannelWindowCeilingBytes else {
        throw SSHReceiveWindowConfigurationError.inconsistentBounds(
          "classMaximum.\(channelClass.rawValue)")
      }
      _ = try Self.checkedSum(
        [
          limits.maximumAdvertisedWindowBytes,
          limits.readBufferCapacityBytes,
          limits.writeCapacityBytes,
          limits.metadataCapacityBytes,
        ], field: "classCapacity.\(channelClass.rawValue)")
    }
    guard controlInitialWindowBytes <= classLimits[.control]!.maximumAdvertisedWindowBytes,
      ordinaryInitialWindowBytes <= classLimits[.ordinary]!.maximumAdvertisedWindowBytes,
      bulkMaximumWindowBytes <= classLimits[.bulk]!.maximumAdvertisedWindowBytes,
      relayMaximumWindowBytes <= classLimits[.relay]!.maximumAdvertisedWindowBytes
    else {
      throw SSHReceiveWindowConfigurationError.inconsistentBounds("initialAndClassMaximum")
    }

    self.controlInitialWindowBytes = controlInitialWindowBytes
    self.ordinaryInitialWindowBytes = ordinaryInitialWindowBytes
    self.bulkMinimumWindowBytes = bulkMinimumWindowBytes
    self.bulkMaximumWindowBytes = bulkMaximumWindowBytes
    self.maximumMeasuredBandwidthBitsPerSecond = maximumMeasuredBandwidthBitsPerSecond
    self.maximumMeasuredRTTNanoseconds = maximumMeasuredRTTNanoseconds
    self.relayControlWindowBytes = relayControlWindowBytes
    self.relayBurstDatagramCount = relayBurstDatagramCount
    self.relayMaximumFrameBodyBytes = relayMaximumFrameBodyBytes
    self.relayMaximumWindowBytes = relayMaximumWindowBytes
    self.softInitialWindowCapBytes = softInitialWindowCapBytes
    self.perChannelWindowCeilingBytes = perChannelWindowCeilingBytes
    self.perLaneWindowCeilingBytes = perLaneWindowCeilingBytes
    self.globalWindowCeilingBytes = globalWindowCeilingBytes
    self.globalLedgerCeilingBytes = globalLedgerCeilingBytes
    self.classLimits = classLimits
  }

  fileprivate static func checkedSum(_ values: [Int], field: String) throws -> Int {
    try values.reduce(0) { partial, value in
      let (sum, overflow) = partial.addingReportingOverflow(value)
      guard !overflow else {
        throw SSHReceiveWindowConfigurationError.arithmeticOverflow(field)
      }
      return sum
    }
  }
}

public struct SSHReceiveWindowLane: Equatable, Sendable {
  public let identity: SSHLaneIdentity
  public var generation: UInt64
  public var state: SSHReceiveWindowLaneState
  public var externallyReservedWindowBytes: Int

  public init(
    identity: SSHLaneIdentity,
    generation: UInt64,
    state: SSHReceiveWindowLaneState,
    externallyReservedWindowBytes: Int = 0
  ) {
    self.identity = identity
    self.generation = generation
    self.state = state
    self.externallyReservedWindowBytes = externallyReservedWindowBytes
  }
}

public enum SSHReceiveWindowRefusal: Error, Equatable, Hashable, Sendable {
  case duplicateChannel
  case unknownChannel
  case unknownLane
  case staleGeneration
  case laneUnavailable
  case memoryPressure
  case invalidMeasurement
  case invalidOutstandingCredit
  case aboveLowWater
  case perChannelCeiling
  case perLaneCeiling
  case globalWindowCeiling
  case globalLedgerCeiling
  case immutableChannelCap
  case insufficientReservation
  case noCreditNeeded
}

public struct SSHReceiveWindowInitialDecision: Equatable, Sendable {
  public let channel: SSHChannelIdentity
  public let lane: SSHLaneIdentity
  public let channelClass: SSHReceiveWindowClass
  public let generation: UInt64
  public let initialWindowBytes: Int
  public let maximumAdvertisedWindowBytes: Int
  public let lowWaterBytes: Int
  public let readBufferCapacityBytes: Int
  public let writeCapacityBytes: Int
  public let maximumWriteCallBytes: Int
  public let ledgerChargeBytes: Int

  public func channelPolicy(
    consumerCreditAvailability: SSHDeferredSemanticAvailability = .reported
  ) throws -> SSHChannelPolicy {
    let limits = try SSHConsumerReceiveWindowPolicy(
      initialReceiveWindowBytes: initialWindowBytes,
      maximumAdvertisedReceiveWindowBytes: maximumAdvertisedWindowBytes,
      windowAdjustThresholdBytes: max(1, lowWaterBytes)
    )
    let report: SSHDeferredSemanticReport<SSHConsumerReceiveWindowPolicy>
    switch consumerCreditAvailability {
    case .reported:
      report = .reported(limits)
    case .notReported:
      report = .notReported
    case .unsupported:
      report = .unsupported
    }
    return try SSHChannelPolicy(
      initialReceiveWindowBytes: initialWindowBytes,
      consumerReceiveWindowCredit: report,
      maximumBufferedReadBytes: readBufferCapacityBytes,
      maximumQueuedWriteBytes: writeCapacityBytes,
      maximumWriteCallBytes: maximumWriteCallBytes
    )
  }
}

public struct SSHReceiveWindowAdjustmentDecision: Equatable, Sendable {
  public let channel: SSHChannelIdentity
  public let beforeOutstandingCreditBytes: Int
  public let adjustmentBytes: Int
  public let afterOutstandingCreditBytes: Int
  public let newlyReservedBytes: Int
}

public enum SSHReceiveWindowReleaseCause: String, CaseIterable, Sendable {
  case openFailure
  case normalClose
  case reset
  case cancellation
  case laneFailure
  case lateCallback
}

public struct SSHReceiveWindowRelease: Equatable, Sendable {
  public let channel: SSHChannelIdentity
  public let cause: SSHReceiveWindowReleaseCause
  public let releasedWindowBytes: Int
  public let releasedLedgerBytes: Int
  public let wasAlreadyReleased: Bool
}

public struct SSHReceiveWindowMetrics: Equatable, Sendable {
  public fileprivate(set) var initialReservations = 0
  public fileprivate(set) var adjustmentReservations = 0
  public fileprivate(set) var adjustmentBytes: UInt64 = 0
  public fileprivate(set) var releases = 0
  public fileprivate(set) var duplicateReleases = 0
  public fileprivate(set) var releasedLedgerBytes: UInt64 = 0
  public fileprivate(set) var refusals: [SSHReceiveWindowRefusal: UInt64] = [:]
}

public struct SSHReceiveWindowBudgetSnapshot: Equatable, Sendable {
  public let generation: UInt64
  public let reservedChannelCount: Int
  public let managedWindowReservedBytes: Int
  public let globalWindowReservedBytes: Int
  public let ledgerCommittedBytes: Int
  public let laneWindowReservedBytes: [SSHLaneIdentity: Int]
  public let metrics: SSHReceiveWindowMetrics
}

private struct SSHReceiveWindowReservation: Equatable, Sendable {
  let channel: SSHChannelIdentity
  let lane: SSHLaneIdentity
  let channelClass: SSHReceiveWindowClass
  let generation: UInt64
  let capBytes: Int
  let lowWaterBytes: Int
  let fixedCapacityBytes: Int
  var reservedWindowBytes: Int

  var ledgerChargeBytes: Int { fixedCapacityBytes + reservedWindowBytes }
}

/// Value-semantic ledger. Copying the value copies a complete policy state, which keeps
/// evaluation deterministic and lets a serialized owner install each returned transition atomically.
public struct SSHReceiveWindowBudgetLedger: Sendable {
  public let configuration: SSHReceiveWindowBudgetConfiguration
  public private(set) var generation: UInt64
  public private(set) var pressure: SSHReceiveWindowPressure
  public private(set) var lanes: [SSHLaneIdentity: SSHReceiveWindowLane]

  private let otherLedgerCommittedBytes: Int
  private let otherGlobalWindowReservedBytes: Int
  private var reservations: [SSHChannelIdentity: SSHReceiveWindowReservation] = [:]
  private var releasedChannels: Set<SSHChannelIdentity> = []
  private var metrics = SSHReceiveWindowMetrics()

  public init(
    configuration: SSHReceiveWindowBudgetConfiguration,
    generation: UInt64,
    pressure: SSHReceiveWindowPressure = .normal,
    lanes: [SSHReceiveWindowLane],
    otherLedgerCommittedBytes: Int = 0,
    otherGlobalWindowReservedBytes: Int = 0
  ) throws {
    guard generation > 0 else {
      throw SSHReceiveWindowConfigurationError.invalidValue("generation")
    }
    guard otherLedgerCommittedBytes >= 0,
      otherLedgerCommittedBytes <= configuration.globalLedgerCeilingBytes
    else {
      throw SSHReceiveWindowConfigurationError.inconsistentBounds("otherLedgerCommittedBytes")
    }
    guard otherGlobalWindowReservedBytes >= 0,
      otherGlobalWindowReservedBytes <= configuration.globalWindowCeilingBytes
    else {
      throw SSHReceiveWindowConfigurationError.inconsistentBounds(
        "otherGlobalWindowReservedBytes")
    }
    var laneMap: [SSHLaneIdentity: SSHReceiveWindowLane] = [:]
    for lane in lanes {
      guard lane.generation > 0, lane.externallyReservedWindowBytes >= 0,
        lane.externallyReservedWindowBytes <= configuration.perLaneWindowCeilingBytes,
        laneMap.updateValue(lane, forKey: lane.identity) == nil
      else {
        throw SSHReceiveWindowConfigurationError.inconsistentBounds("lanes")
      }
    }
    self.configuration = configuration
    self.generation = generation
    self.pressure = pressure
    self.lanes = laneMap
    self.otherLedgerCommittedBytes = otherLedgerCommittedBytes
    self.otherGlobalWindowReservedBytes = otherGlobalWindowReservedBytes
  }

  public mutating func setPressure(_ pressure: SSHReceiveWindowPressure) {
    self.pressure = pressure
  }

  public mutating func setLaneState(
    _ state: SSHReceiveWindowLaneState,
    lane: SSHLaneIdentity,
    generation: UInt64
  ) throws {
    guard generation == self.generation else { throw SSHReceiveWindowRefusal.staleGeneration }
    guard var current = lanes[lane] else { throw SSHReceiveWindowRefusal.unknownLane }
    guard current.generation == generation else { throw SSHReceiveWindowRefusal.staleGeneration }
    current.state = state
    lanes[lane] = current
  }

  public mutating func reserveInitial(
    channel: SSHChannelIdentity,
    lane: SSHLaneIdentity,
    channelClass: SSHReceiveWindowClass,
    generation: UInt64,
    bulkMeasurement: SSHBulkPathMeasurement? = nil
  ) throws -> SSHReceiveWindowInitialDecision {
    do {
      guard reservations[channel] == nil, !releasedChannels.contains(channel) else {
        throw SSHReceiveWindowRefusal.duplicateChannel
      }
      let currentLane = try availableLane(lane, generation: generation)
      try permitInitial(channelClass)
      let limits = configuration.classLimits[channelClass]!
      var initial = try Self.initialCandidate(
        for: channelClass, measurement: bulkMeasurement, configuration: configuration)
      if pressure == .soft {
        initial = min(initial, configuration.softInitialWindowCapBytes)
      }
      guard initial <= limits.maximumAdvertisedWindowBytes,
        initial <= configuration.perChannelWindowCeilingBytes
      else { throw SSHReceiveWindowRefusal.perChannelCeiling }
      let fixed = try SSHReceiveWindowBudgetConfiguration.checkedSum(
        [
          limits.readBufferCapacityBytes,
          limits.writeCapacityBytes,
          limits.metadataCapacityBytes,
        ], field: "channelFixedCapacity")
      let charge = try SSHReceiveWindowBudgetConfiguration.checkedSum(
        [initial, fixed], field: "channelInitialCapacity")
      guard
        fits(
          used: laneReservedBytes(currentLane.identity), adding: initial,
          ceiling: configuration.perLaneWindowCeilingBytes)
      else { throw SSHReceiveWindowRefusal.perLaneCeiling }
      guard
        fits(
          used: globalWindowReservedBytes, adding: initial,
          ceiling: configuration.globalWindowCeilingBytes)
      else { throw SSHReceiveWindowRefusal.globalWindowCeiling }
      guard
        fits(
          used: ledgerCommittedBytes, adding: charge,
          ceiling: configuration.globalLedgerCeilingBytes)
      else { throw SSHReceiveWindowRefusal.globalLedgerCeiling }

      reservations[channel] = SSHReceiveWindowReservation(
        channel: channel,
        lane: lane,
        channelClass: channelClass,
        generation: generation,
        capBytes: limits.maximumAdvertisedWindowBytes,
        lowWaterBytes: limits.lowWaterBytes,
        fixedCapacityBytes: fixed,
        reservedWindowBytes: initial)
      metrics.initialReservations += 1
      return SSHReceiveWindowInitialDecision(
        channel: channel,
        lane: lane,
        channelClass: channelClass,
        generation: generation,
        initialWindowBytes: initial,
        maximumAdvertisedWindowBytes: limits.maximumAdvertisedWindowBytes,
        lowWaterBytes: limits.lowWaterBytes,
        readBufferCapacityBytes: limits.readBufferCapacityBytes,
        writeCapacityBytes: limits.writeCapacityBytes,
        maximumWriteCallBytes: min(initial, limits.writeCapacityBytes),
        ledgerChargeBytes: charge)
    } catch let refusal as SSHReceiveWindowRefusal {
      recordRefusal(refusal)
      throw refusal
    }
  }

  public mutating func reserveAdjustment(
    channel: SSHChannelIdentity,
    generation: UInt64,
    outstandingAdvertisedCreditBytes: Int
  ) throws -> SSHReceiveWindowAdjustmentDecision {
    do {
      guard generation == self.generation else { throw SSHReceiveWindowRefusal.staleGeneration }
      guard var reservation = reservations[channel] else {
        throw releasedChannels.contains(channel)
          ? SSHReceiveWindowRefusal.staleGeneration : SSHReceiveWindowRefusal.unknownChannel
      }
      _ = try availableLane(reservation.lane, generation: generation)
      guard pressure == .normal || pressure == .soft else {
        throw SSHReceiveWindowRefusal.memoryPressure
      }
      guard outstandingAdvertisedCreditBytes >= 0,
        outstandingAdvertisedCreditBytes <= reservation.capBytes
      else { throw SSHReceiveWindowRefusal.invalidOutstandingCredit }
      guard outstandingAdvertisedCreditBytes <= reservation.lowWaterBytes else {
        throw SSHReceiveWindowRefusal.aboveLowWater
      }

      let advertisedHeadroom = reservation.capBytes - outstandingAdvertisedCreditBytes
      let reservationHeadroom = reservation.capBytes - reservation.reservedWindowBytes
      let laneHeadroom =
        configuration.perLaneWindowCeilingBytes - laneReservedBytes(reservation.lane)
      let globalHeadroom = configuration.globalWindowCeilingBytes - globalWindowReservedBytes
      let ledgerHeadroom = configuration.globalLedgerCeilingBytes - ledgerCommittedBytes
      let delta = min(
        advertisedHeadroom, reservationHeadroom, laneHeadroom, globalHeadroom, ledgerHeadroom)
      guard delta > 0 else {
        throw reservationHeadroom == 0
          ? SSHReceiveWindowRefusal.noCreditNeeded : SSHReceiveWindowRefusal.insufficientReservation
      }
      let (after, overflow) = outstandingAdvertisedCreditBytes.addingReportingOverflow(delta)
      guard !overflow, after <= reservation.capBytes else {
        throw SSHReceiveWindowRefusal.immutableChannelCap
      }
      reservation.reservedWindowBytes += delta
      reservations[channel] = reservation
      metrics.adjustmentReservations += 1
      metrics.adjustmentBytes = metrics.adjustmentBytes.saturatingAdd(UInt64(delta))
      return SSHReceiveWindowAdjustmentDecision(
        channel: channel,
        beforeOutstandingCreditBytes: outstandingAdvertisedCreditBytes,
        adjustmentBytes: delta,
        afterOutstandingCreditBytes: after,
        newlyReservedBytes: delta)
    } catch let refusal as SSHReceiveWindowRefusal {
      recordRefusal(refusal)
      throw refusal
    }
  }

  @discardableResult
  public mutating func release(
    channel: SSHChannelIdentity,
    cause: SSHReceiveWindowReleaseCause
  ) -> SSHReceiveWindowRelease {
    guard let reservation = reservations.removeValue(forKey: channel) else {
      releasedChannels.insert(channel)
      metrics.duplicateReleases += 1
      return SSHReceiveWindowRelease(
        channel: channel,
        cause: cause,
        releasedWindowBytes: 0,
        releasedLedgerBytes: 0,
        wasAlreadyReleased: true)
    }
    releasedChannels.insert(channel)
    metrics.releases += 1
    metrics.releasedLedgerBytes = metrics.releasedLedgerBytes.saturatingAdd(
      UInt64(reservation.ledgerChargeBytes))
    return SSHReceiveWindowRelease(
      channel: channel,
      cause: cause,
      releasedWindowBytes: reservation.reservedWindowBytes,
      releasedLedgerBytes: reservation.ledgerChargeBytes,
      wasAlreadyReleased: false)
  }

  @discardableResult
  public mutating func releaseLane(
    _ lane: SSHLaneIdentity,
    cause: SSHReceiveWindowReleaseCause = .laneFailure
  ) -> [SSHReceiveWindowRelease] {
    reservations.values
      .filter { $0.lane == lane }
      .map(\.channel)
      .sorted { $0.rawValue.uuidString < $1.rawValue.uuidString }
      .map { release(channel: $0, cause: cause) }
  }

  public func snapshot() -> SSHReceiveWindowBudgetSnapshot {
    SSHReceiveWindowBudgetSnapshot(
      generation: generation,
      reservedChannelCount: reservations.count,
      managedWindowReservedBytes: managedWindowReservedBytes,
      globalWindowReservedBytes: globalWindowReservedBytes,
      ledgerCommittedBytes: ledgerCommittedBytes,
      laneWindowReservedBytes: Dictionary(
        uniqueKeysWithValues: lanes.keys.map { ($0, laneReservedBytes($0)) }),
      metrics: metrics)
  }

  public static func initialCandidate(
    for channelClass: SSHReceiveWindowClass,
    measurement: SSHBulkPathMeasurement?,
    configuration: SSHReceiveWindowBudgetConfiguration
  ) throws -> Int {
    switch channelClass {
    case .control:
      return configuration.controlInitialWindowBytes
    case .ordinary:
      return configuration.ordinaryInitialWindowBytes
    case .bulk:
      guard let measurement,
        measurement.bandwidthBitsPerSecond > 0,
        measurement.roundTripTimeNanoseconds > 0
      else { throw SSHReceiveWindowRefusal.invalidMeasurement }
      let bandwidth = min(
        measurement.bandwidthBitsPerSecond,
        configuration.maximumMeasuredBandwidthBitsPerSecond)
      let rtt = min(
        measurement.roundTripTimeNanoseconds,
        configuration.maximumMeasuredRTTNanoseconds)
      let bytes = ceilMultiplyDivide(bandwidth, rtt, by: 8_000_000_000)
      let bounded = min(
        UInt64(configuration.bulkMaximumWindowBytes),
        max(UInt64(configuration.bulkMinimumWindowBytes), bytes))
      return Int(bounded)
    case .relay:
      let framed = max(saturatingAdd(4, configuration.relayMaximumFrameBodyBytes), 64)
      let burst = saturatingMultiply(configuration.relayBurstDatagramCount, framed)
      return min(
        configuration.relayMaximumWindowBytes,
        saturatingAdd(configuration.relayControlWindowBytes, burst))
    }
  }

  private var managedWindowReservedBytes: Int {
    reservations.values.reduce(0) { $0 + $1.reservedWindowBytes }
  }

  private var globalWindowReservedBytes: Int {
    otherGlobalWindowReservedBytes + managedWindowReservedBytes
  }

  private var ledgerCommittedBytes: Int {
    otherLedgerCommittedBytes + reservations.values.reduce(0) { $0 + $1.ledgerChargeBytes }
  }

  private func laneReservedBytes(_ lane: SSHLaneIdentity) -> Int {
    let external = lanes[lane]?.externallyReservedWindowBytes ?? 0
    return external
      + reservations.values.lazy.filter { $0.lane == lane }
      .reduce(0) { $0 + $1.reservedWindowBytes }
  }

  private func availableLane(
    _ lane: SSHLaneIdentity,
    generation: UInt64
  ) throws -> SSHReceiveWindowLane {
    guard generation == self.generation else { throw SSHReceiveWindowRefusal.staleGeneration }
    guard let lane = lanes[lane] else { throw SSHReceiveWindowRefusal.unknownLane }
    guard lane.generation == generation else { throw SSHReceiveWindowRefusal.staleGeneration }
    guard lane.state == .ready else { throw SSHReceiveWindowRefusal.laneUnavailable }
    return lane
  }

  private func permitInitial(_ channelClass: SSHReceiveWindowClass) throws {
    switch pressure {
    case .normal, .soft:
      return
    case .pressure:
      guard channelClass == .control || channelClass == .relay else {
        throw SSHReceiveWindowRefusal.memoryPressure
      }
    case .critical:
      throw SSHReceiveWindowRefusal.memoryPressure
    }
  }

  private func fits(used: Int, adding: Int, ceiling: Int) -> Bool {
    let (candidate, overflow) = used.addingReportingOverflow(adding)
    return !overflow && candidate <= ceiling
  }

  private mutating func recordRefusal(_ refusal: SSHReceiveWindowRefusal) {
    metrics.refusals[refusal, default: 0] = metrics.refusals[refusal, default: 0]
      .saturatingAdd(1)
  }
}

private func saturatingAdd(_ lhs: Int, _ rhs: Int) -> Int {
  let (result, overflow) = lhs.addingReportingOverflow(rhs)
  return overflow ? Int.max : result
}

private func saturatingMultiply(_ lhs: Int, _ rhs: Int) -> Int {
  let (result, overflow) = lhs.multipliedReportingOverflow(by: rhs)
  return overflow ? Int.max : result
}

private func ceilMultiplyDivide(_ lhs: UInt64, _ rhs: UInt64, by divisor: UInt64) -> UInt64 {
  let quotient = lhs / divisor
  let remainder = lhs % divisor
  let (base, baseOverflow) = quotient.multipliedReportingOverflow(by: rhs)
  if baseOverflow { return .max }
  let product = remainder.multipliedFullWidth(by: rhs)
  let division = divisor.dividingFullWidth(product)
  let roundedFraction =
    division.remainder == 0
    ? division.quotient : division.quotient.saturatingAdd(1)
  return base.saturatingAdd(roundedFraction)
}

extension UInt64 {
  fileprivate func saturatingAdd(_ other: UInt64) -> UInt64 {
    let (result, overflow) = addingReportingOverflow(other)
    return overflow ? .max : result
  }
}
import Foundation
import Testing

@testable import ReluxTunnelCore

@Suite("Per-channel receive-window and budget policy")
struct SSHReceiveWindowBudgetPolicyTests {
  @Test("table vectors select every class including 32 KiB, 64 KiB, BDP, and relay burst")
  func classVectors() throws {
    let configuration = try fixtureConfiguration()
    let cases: [(SSHReceiveWindowClass, SSHBulkPathMeasurement?, Int)] = [
      (.control, nil, 32 * 1_024),
      (.ordinary, nil, 64 * 1_024),
      (
        .bulk,
        SSHBulkPathMeasurement(
          bandwidthBitsPerSecond: 8_000_000,
          roundTripTimeNanoseconds: 64_000_000),
        64_000
      ),
      (.relay, nil, 32 * 1_024 + 4 * (4 + 1_472)),
    ]

    for (channelClass, measurement, expected) in cases {
      #expect(
        try SSHReceiveWindowBudgetLedger.initialCandidate(
          for: channelClass,
          measurement: measurement,
          configuration: configuration) == expected)
    }
  }

  @Test("BDP caps inputs before saturating arithmetic and applies inclusive bounds")
  func bdpBoundaryAndOverflow() throws {
    let configuration = try fixtureConfiguration(
      maximumMeasuredBandwidthBitsPerSecond: .max,
      maximumMeasuredRTTNanoseconds: .max)
    #expect(
      try SSHReceiveWindowBudgetLedger.initialCandidate(
        for: .bulk,
        measurement: SSHBulkPathMeasurement(
          bandwidthBitsPerSecond: 1,
          roundTripTimeNanoseconds: 1),
        configuration: configuration) == 32 * 1_024)
    #expect(
      try SSHReceiveWindowBudgetLedger.initialCandidate(
        for: .bulk,
        measurement: SSHBulkPathMeasurement(
          bandwidthBitsPerSecond: .max,
          roundTripTimeNanoseconds: .max),
        configuration: configuration) == 256 * 1_024)

    let capped = try fixtureConfiguration(
      maximumMeasuredBandwidthBitsPerSecond: 8_000_000,
      maximumMeasuredRTTNanoseconds: 64_000_000)
    let uncappedMaximum = try SSHReceiveWindowBudgetLedger.initialCandidate(
      for: .bulk,
      measurement: SSHBulkPathMeasurement(
        bandwidthBitsPerSecond: .max,
        roundTripTimeNanoseconds: .max),
      configuration: capped)
    let explicitCaps = try SSHReceiveWindowBudgetLedger.initialCandidate(
      for: .bulk,
      measurement: SSHBulkPathMeasurement(
        bandwidthBitsPerSecond: 8_000_000,
        roundTripTimeNanoseconds: 64_000_000),
      configuration: capped)
    #expect(uncappedMaximum == explicitCaps)
  }

  @Test("initial reservations fit channel, lane, global-window, and global-ledger ceilings")
  func reservationCeilings() throws {
    let lane = fixtureLane()
    var ledger = try fixtureLedger(lane: lane)
    let decision = try ledger.reserveInitial(
      channel: fixtureChannel(1), lane: lane.identity, channelClass: .ordinary,
      generation: 7)
    let snapshot = ledger.snapshot()
    #expect(decision.initialWindowBytes == 64 * 1_024)
    #expect(snapshot.managedWindowReservedBytes == decision.initialWindowBytes)
    #expect(snapshot.globalWindowReservedBytes <= ledger.configuration.globalWindowCeilingBytes)
    #expect(snapshot.ledgerCommittedBytes <= ledger.configuration.globalLedgerCeilingBytes)
    #expect(
      snapshot.laneWindowReservedBytes[lane.identity, default: .max]
        <= ledger.configuration.perLaneWindowCeilingBytes)

    var laneLimited = try fixtureLedger(
      lane: SSHReceiveWindowLane(
        identity: lane.identity,
        generation: 7,
        state: .ready,
        externallyReservedWindowBytes: 256 * 1_024 - 32 * 1_024))
    #expect(throws: SSHReceiveWindowRefusal.perLaneCeiling) {
      _ = try laneLimited.reserveInitial(
        channel: fixtureChannel(2), lane: lane.identity, channelClass: .ordinary,
        generation: 7)
    }
    #expect(laneLimited.snapshot().reservedChannelCount == 0)

    var globalLimited = try fixtureLedger(
      lane: lane,
      otherGlobalWindowReservedBytes: 1_024 * 1_024 - 32 * 1_024)
    #expect(throws: SSHReceiveWindowRefusal.globalWindowCeiling) {
      _ = try globalLimited.reserveInitial(
        channel: fixtureChannel(3), lane: lane.identity, channelClass: .ordinary,
        generation: 7)
    }

    var ledgerLimited = try fixtureLedger(
      lane: lane,
      otherLedgerCommittedBytes: 2 * 1_024 * 1_024 - 64 * 1_024)
    #expect(throws: SSHReceiveWindowRefusal.globalLedgerCeiling) {
      _ = try ledgerLimited.reserveInitial(
        channel: fixtureChannel(4), lane: lane.identity, channelClass: .ordinary,
        generation: 7)
    }
  }

  @Test("adjustment requires low water and atomically reserves all available bounded credit")
  func adjustmentPolicy() throws {
    let lane = fixtureLane()
    var ledger = try fixtureLedger(lane: lane)
    let channel = fixtureChannel(10)
    let initial = try ledger.reserveInitial(
      channel: channel, lane: lane.identity, channelClass: .control, generation: 7)
    #expect(throws: SSHReceiveWindowRefusal.aboveLowWater) {
      _ = try ledger.reserveAdjustment(
        channel: channel, generation: 7, outstandingAdvertisedCreditBytes: 16 * 1_024 + 1)
    }

    let adjustment = try ledger.reserveAdjustment(
      channel: channel, generation: 7, outstandingAdvertisedCreditBytes: 16 * 1_024)
    #expect(adjustment.adjustmentBytes == 32 * 1_024)
    #expect(adjustment.afterOutstandingCreditBytes == 48 * 1_024)
    #expect(ledger.snapshot().managedWindowReservedBytes == 64 * 1_024)
    #expect(initial.maximumAdvertisedWindowBytes == 64 * 1_024)
    #expect(throws: SSHReceiveWindowRefusal.noCreditNeeded) {
      _ = try ledger.reserveAdjustment(
        channel: channel, generation: 7, outstandingAdvertisedCreditBytes: 0)
    }
    #expect(ledger.snapshot().managedWindowReservedBytes == 64 * 1_024)
  }

  @Test("insufficient window reservation withholds adjustment without a side queue")
  func insufficientAdjustmentReservation() throws {
    let lane = fixtureLane()
    var ledger = try fixtureLedger(
      lane: lane,
      otherGlobalWindowReservedBytes: 1_024 * 1_024 - 32 * 1_024)
    let channel = fixtureChannel(15)
    _ = try ledger.reserveInitial(
      channel: channel, lane: lane.identity, channelClass: .control, generation: 7)
    let before = ledger.snapshot()
    #expect(throws: SSHReceiveWindowRefusal.insufficientReservation) {
      _ = try ledger.reserveAdjustment(
        channel: channel, generation: 7, outstandingAdvertisedCreditBytes: 0)
    }
    let after = ledger.snapshot()
    #expect(after.managedWindowReservedBytes == before.managedWindowReservedBytes)
    #expect(after.metrics.adjustmentReservations == 0)
    #expect(after.metrics.refusals[.insufficientReservation] == 1)
  }

  @Test("pressure, rekey, failure, closing, stale generation, and late callbacks reject credit")
  func negativeGates() throws {
    let lane = fixtureLane()
    var ledger = try fixtureLedger(lane: lane)
    let channel = fixtureChannel(20)
    _ = try ledger.reserveInitial(
      channel: channel, lane: lane.identity, channelClass: .control, generation: 7)

    ledger.setPressure(.pressure)
    #expect(throws: SSHReceiveWindowRefusal.memoryPressure) {
      _ = try ledger.reserveAdjustment(
        channel: channel, generation: 7, outstandingAdvertisedCreditBytes: 0)
    }
    #expect(throws: SSHReceiveWindowRefusal.memoryPressure) {
      _ = try ledger.reserveInitial(
        channel: fixtureChannel(21), lane: lane.identity, channelClass: .ordinary,
        generation: 7)
    }
    _ = try ledger.reserveInitial(
      channel: fixtureChannel(22), lane: lane.identity, channelClass: .relay,
      generation: 7)

    ledger.setPressure(.normal)
    try ledger.setLaneState(.rekeying, lane: lane.identity, generation: 7)
    #expect(throws: SSHReceiveWindowRefusal.laneUnavailable) {
      _ = try ledger.reserveAdjustment(
        channel: channel, generation: 7, outstandingAdvertisedCreditBytes: 0)
    }
    for (index, state) in [
      SSHReceiveWindowLaneState.failed, .closing, .closed,
    ].enumerated() {
      try ledger.setLaneState(state, lane: lane.identity, generation: 7)
      #expect(throws: SSHReceiveWindowRefusal.laneUnavailable) {
        _ = try ledger.reserveInitial(
          channel: fixtureChannel(30 + index), lane: lane.identity,
          channelClass: .control, generation: 7)
      }
    }
    #expect(throws: SSHReceiveWindowRefusal.staleGeneration) {
      _ = try ledger.reserveAdjustment(
        channel: channel, generation: 6, outstandingAdvertisedCreditBytes: 0)
    }
    _ = ledger.release(channel: channel, cause: .normalClose)
    #expect(throws: SSHReceiveWindowRefusal.staleGeneration) {
      _ = try ledger.reserveAdjustment(
        channel: channel, generation: 7, outstandingAdvertisedCreditBytes: 0)
    }
  }

  @Test("soft pressure caps only new windows and never revokes existing credit")
  func softPressureDoesNotRevoke() throws {
    let lane = fixtureLane()
    var ledger = try fixtureLedger(lane: lane)
    let existing = fixtureChannel(40)
    _ = try ledger.reserveInitial(
      channel: existing,
      lane: lane.identity,
      channelClass: .ordinary,
      generation: 7)
    let before = ledger.snapshot().managedWindowReservedBytes
    ledger.setPressure(.soft)
    let new = try ledger.reserveInitial(
      channel: fixtureChannel(41), lane: lane.identity, channelClass: .ordinary,
      generation: 7)
    #expect(new.initialWindowBytes == 32 * 1_024)
    #expect(ledger.snapshot().managedWindowReservedBytes == before + 32 * 1_024)
  }

  @Test("release is exact and idempotent for every lifecycle cause")
  func lifecycleReconciliation() throws {
    for (index, cause) in SSHReceiveWindowReleaseCause.allCases.enumerated() {
      let lane = fixtureLane()
      var ledger = try fixtureLedger(lane: lane)
      let channel = fixtureChannel(100 + index)
      let initial = try ledger.reserveInitial(
        channel: channel, lane: lane.identity, channelClass: .control,
        generation: 7)
      _ = try ledger.reserveAdjustment(
        channel: channel, generation: 7, outstandingAdvertisedCreditBytes: 0)
      let charged = ledger.snapshot().ledgerCommittedBytes
      let release = ledger.release(channel: channel, cause: cause)
      let duplicate = ledger.release(channel: channel, cause: .lateCallback)
      #expect(release.releasedLedgerBytes == initial.ledgerChargeBytes + 32 * 1_024)
      #expect(release.releasedLedgerBytes == charged)
      #expect(!release.wasAlreadyReleased)
      #expect(duplicate.wasAlreadyReleased)
      #expect(duplicate.releasedLedgerBytes == 0)
      #expect(ledger.snapshot().ledgerCommittedBytes == 0)
      #expect(ledger.snapshot().managedWindowReservedBytes == 0)
    }
  }

  @Test("rekey preserves reservations and lane failure releases them exactly once")
  func rekeyAndLaneFailureReconciliation() throws {
    let lane = fixtureLane()
    var ledger = try fixtureLedger(lane: lane)
    for index in 0..<3 {
      _ = try ledger.reserveInitial(
        channel: fixtureChannel(500 + index),
        lane: lane.identity,
        channelClass: .control,
        generation: 7)
    }
    let beforeRekey = ledger.snapshot()
    try ledger.setLaneState(.rekeying, lane: lane.identity, generation: 7)
    #expect(ledger.snapshot().ledgerCommittedBytes == beforeRekey.ledgerCommittedBytes)
    #expect(ledger.snapshot().managedWindowReservedBytes == beforeRekey.managedWindowReservedBytes)
    try ledger.setLaneState(.failed, lane: lane.identity, generation: 7)
    let releases = ledger.releaseLane(lane.identity)
    #expect(releases.count == 3)
    #expect(releases.reduce(0) { $0 + $1.releasedLedgerBytes } == beforeRekey.ledgerCommittedBytes)
    #expect(ledger.releaseLane(lane.identity).isEmpty)
    #expect(ledger.snapshot().ledgerCommittedBytes == 0)
  }

  @Test("randomized opens, adjustments, and releases preserve every ledger invariant")
  func randomizedLedgerInvariant() throws {
    let lane = fixtureLane()
    var ledger = try fixtureLedger(lane: lane)
    var random = LCG(state: 0x3A71_2607_15)
    var live: [SSHChannelIdentity] = []
    for iteration in 0..<2_000 {
      if live.isEmpty || (random.next() % 3 == 0 && live.count < 12) {
        let channel = fixtureChannel(1_000 + iteration)
        if (try? ledger.reserveInitial(
          channel: channel,
          lane: lane.identity,
          channelClass: SSHReceiveWindowClass.allCases[Int(random.next() % 4)],
          generation: 7,
          bulkMeasurement: SSHBulkPathMeasurement(
            bandwidthBitsPerSecond: random.next(),
            roundTripTimeNanoseconds: random.next()))) != nil
        {
          live.append(channel)
        }
      } else if random.next() % 2 == 0 {
        let index = Int(random.next() % UInt64(live.count))
        _ = try? ledger.reserveAdjustment(
          channel: live[index], generation: 7,
          outstandingAdvertisedCreditBytes: Int(random.next() % UInt64(16 * 1_024 + 1)))
      } else {
        let index = Int(random.next() % UInt64(live.count))
        _ = ledger.release(channel: live.remove(at: index), cause: .normalClose)
      }
      let snapshot = ledger.snapshot()
      #expect(snapshot.globalWindowReservedBytes <= ledger.configuration.globalWindowCeilingBytes)
      #expect(snapshot.ledgerCommittedBytes <= ledger.configuration.globalLedgerCeilingBytes)
      #expect(
        snapshot.laneWindowReservedBytes[lane.identity, default: .max]
          <= ledger.configuration.perLaneWindowCeilingBytes)
    }
  }

  @Test("configuration rejects invalid candidates, missing classes, and overflow")
  func configurationNegativeEvidence() throws {
    #expect(
      throws: SSHReceiveWindowConfigurationError.invalidCandidate("controlInitialWindowBytes")
    ) {
      _ = try fixtureConfiguration(controlInitialWindowBytes: 48 * 1_024)
    }
    var limits = fixtureClassLimits()
    limits.removeValue(forKey: .relay)
    #expect(throws: SSHReceiveWindowConfigurationError.missingClass(.relay)) {
      _ = try fixtureConfiguration(classLimits: limits)
    }
    limits = fixtureClassLimits()
    limits[.bulk] = SSHReceiveWindowClassLimits(
      maximumAdvertisedWindowBytes: 256 * 1_024,
      lowWaterBytes: 16 * 1_024,
      readBufferCapacityBytes: Int.max,
      writeCapacityBytes: 1,
      metadataCapacityBytes: 1)
    #expect(
      throws: SSHReceiveWindowConfigurationError.arithmeticOverflow("classCapacity.bulk")
    ) {
      _ = try fixtureConfiguration(classLimits: limits)
    }
    let oversized = Int(UInt32.max) + 1
    #expect(
      throws: SSHReceiveWindowConfigurationError.inconsistentBounds("protocolWindowCeiling")
    ) {
      _ = try SSHReceiveWindowBudgetConfiguration(
        controlInitialWindowBytes: 32 * 1_024,
        ordinaryInitialWindowBytes: 64 * 1_024,
        bulkMinimumWindowBytes: 32 * 1_024,
        bulkMaximumWindowBytes: 256 * 1_024,
        maximumMeasuredBandwidthBitsPerSecond: 1,
        maximumMeasuredRTTNanoseconds: 1,
        relayControlWindowBytes: 32 * 1_024,
        relayBurstDatagramCount: 1,
        relayMaximumFrameBodyBytes: 1,
        relayMaximumWindowBytes: 64 * 1_024,
        softInitialWindowCapBytes: 32 * 1_024,
        perChannelWindowCeilingBytes: oversized,
        perLaneWindowCeilingBytes: oversized,
        globalWindowCeilingBytes: oversized,
        globalLedgerCeilingBytes: oversized,
        classLimits: fixtureClassLimits())
    }
  }
}

private struct LCG {
  var state: UInt64

  mutating func next() -> UInt64 {
    state = state &* 6_364_136_223_846_793_005 &+ 1_442_695_040_888_963_407
    return state
  }
}

private func fixtureLane() -> SSHReceiveWindowLane {
  SSHReceiveWindowLane(
    identity: SSHLaneIdentity(
      rawValue: UUID(uuidString: "00000000-0000-0000-0000-000000000007")!),
    generation: 7,
    state: .ready)
}

private func fixtureChannel(_ value: Int) -> SSHChannelIdentity {
  SSHChannelIdentity(
    rawValue: UUID(uuidString: String(format: "00000000-0000-0000-0000-%012x", value))!)
}

private func fixtureClassLimits() -> [SSHReceiveWindowClass: SSHReceiveWindowClassLimits] {
  [
    .control: SSHReceiveWindowClassLimits(
      maximumAdvertisedWindowBytes: 64 * 1_024,
      lowWaterBytes: 16 * 1_024,
      readBufferCapacityBytes: 16 * 1_024,
      writeCapacityBytes: 16 * 1_024,
      metadataCapacityBytes: 1 * 1_024),
    .ordinary: SSHReceiveWindowClassLimits(
      maximumAdvertisedWindowBytes: 64 * 1_024,
      lowWaterBytes: 16 * 1_024,
      readBufferCapacityBytes: 16 * 1_024,
      writeCapacityBytes: 16 * 1_024,
      metadataCapacityBytes: 1 * 1_024),
    .bulk: SSHReceiveWindowClassLimits(
      maximumAdvertisedWindowBytes: 256 * 1_024,
      lowWaterBytes: 16 * 1_024,
      readBufferCapacityBytes: 32 * 1_024,
      writeCapacityBytes: 32 * 1_024,
      metadataCapacityBytes: 1 * 1_024),
    .relay: SSHReceiveWindowClassLimits(
      maximumAdvertisedWindowBytes: 128 * 1_024,
      lowWaterBytes: 16 * 1_024,
      readBufferCapacityBytes: 32 * 1_024,
      writeCapacityBytes: 32 * 1_024,
      metadataCapacityBytes: 1 * 1_024),
  ]
}

private func fixtureConfiguration(
  controlInitialWindowBytes: Int = 32 * 1_024,
  maximumMeasuredBandwidthBitsPerSecond: UInt64 = 1_000_000_000,
  maximumMeasuredRTTNanoseconds: UInt64 = 1_000_000_000,
  classLimits: [SSHReceiveWindowClass: SSHReceiveWindowClassLimits] = fixtureClassLimits()
) throws -> SSHReceiveWindowBudgetConfiguration {
  try SSHReceiveWindowBudgetConfiguration(
    controlInitialWindowBytes: controlInitialWindowBytes,
    ordinaryInitialWindowBytes: 64 * 1_024,
    bulkMinimumWindowBytes: 32 * 1_024,
    bulkMaximumWindowBytes: 256 * 1_024,
    maximumMeasuredBandwidthBitsPerSecond: maximumMeasuredBandwidthBitsPerSecond,
    maximumMeasuredRTTNanoseconds: maximumMeasuredRTTNanoseconds,
    relayControlWindowBytes: 32 * 1_024,
    relayBurstDatagramCount: 4,
    relayMaximumFrameBodyBytes: 1_472,
    relayMaximumWindowBytes: 128 * 1_024,
    softInitialWindowCapBytes: 32 * 1_024,
    perChannelWindowCeilingBytes: 256 * 1_024,
    perLaneWindowCeilingBytes: 256 * 1_024,
    globalWindowCeilingBytes: 1_024 * 1_024,
    globalLedgerCeilingBytes: 2 * 1_024 * 1_024,
    classLimits: classLimits)
}

private func fixtureLedger(
  lane: SSHReceiveWindowLane,
  otherLedgerCommittedBytes: Int = 0,
  otherGlobalWindowReservedBytes: Int = 0
) throws -> SSHReceiveWindowBudgetLedger {
  try SSHReceiveWindowBudgetLedger(
    configuration: fixtureConfiguration(),
    generation: 7,
    lanes: [lane],
    otherLedgerCommittedBytes: otherLedgerCommittedBytes,
    otherGlobalWindowReservedBytes: otherGlobalWindowReservedBytes)
}
import Foundation
import ReluxTunnelCore
import Testing

@testable import ReluxTunnelLibSSH2Adapter

@Suite("Selected libssh2 receive-window adapter")
struct LibSSH2WindowPolicyAdapterTests {
  @Test("channel-open conversion preserves every bounded class initial window")
  func selectedAdapterInitialWindows() throws {
    let configuration = try adapterWindowConfiguration()
    let lane = SSHReceiveWindowLane(
      identity: SSHLaneIdentity(
        rawValue: UUID(uuidString: "00000000-0000-0000-0000-000000000099")!),
      generation: 9,
      state: .ready)
    var ledger = try SSHReceiveWindowBudgetLedger(
      configuration: configuration, generation: 9, lanes: [lane])
    let vectors: [(SSHReceiveWindowClass, SSHBulkPathMeasurement?)] = [
      (.control, nil),
      (.ordinary, nil),
      (
        .bulk,
        SSHBulkPathMeasurement(
          bandwidthBitsPerSecond: 8_000_000,
          roundTripTimeNanoseconds: 64_000_000)
      ),
      (.relay, nil),
    ]

    for (index, vector) in vectors.enumerated() {
      let decision = try ledger.reserveInitial(
        channel: SSHChannelIdentity(
          rawValue: UUID(
            uuidString: String(format: "00000000-0000-0000-0001-%012x", index))!),
        lane: lane.identity,
        channelClass: vector.0,
        generation: 9,
        bulkMeasurement: vector.1)
      let policy = try decision.channelPolicy(consumerCreditAvailability: .unsupported)
      #expect(
        LibSSH2ChannelWindowAdapter.initialReceiveWindow(policy)
          == UInt32(decision.initialWindowBytes))
      #expect(policy.consumerReceiveWindowCredit == .unsupported)
    }
    #expect(
      LibSSH2TransportFactory().capabilities.deferredSemantics.consumerDrivenReceiveWindowCredit
        == .unsupported)
  }
}

private func adapterWindowConfiguration() throws -> SSHReceiveWindowBudgetConfiguration {
  let common = SSHReceiveWindowClassLimits(
    maximumAdvertisedWindowBytes: 256 * 1_024,
    lowWaterBytes: 16 * 1_024,
    readBufferCapacityBytes: 16 * 1_024,
    writeCapacityBytes: 16 * 1_024,
    metadataCapacityBytes: 1 * 1_024)
  return try SSHReceiveWindowBudgetConfiguration(
    controlInitialWindowBytes: 32 * 1_024,
    ordinaryInitialWindowBytes: 64 * 1_024,
    bulkMinimumWindowBytes: 32 * 1_024,
    bulkMaximumWindowBytes: 256 * 1_024,
    maximumMeasuredBandwidthBitsPerSecond: 1_000_000_000,
    maximumMeasuredRTTNanoseconds: 1_000_000_000,
    relayControlWindowBytes: 32 * 1_024,
    relayBurstDatagramCount: 4,
    relayMaximumFrameBodyBytes: 1_472,
    relayMaximumWindowBytes: 128 * 1_024,
    softInitialWindowCapBytes: 32 * 1_024,
    perChannelWindowCeilingBytes: 256 * 1_024,
    perLaneWindowCeilingBytes: 1_024 * 1_024,
    globalWindowCeilingBytes: 2 * 1_024 * 1_024,
    globalLedgerCeilingBytes: 4 * 1_024 * 1_024,
    classLimits: Dictionary(
      uniqueKeysWithValues: SSHReceiveWindowClass.allCases.map { ($0, common) }))
