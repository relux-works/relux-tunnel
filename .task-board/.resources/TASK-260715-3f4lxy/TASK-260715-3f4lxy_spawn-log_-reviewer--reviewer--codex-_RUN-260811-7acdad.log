     5	/// macOS provider integration for the complete profile snapshot stored by
     6	/// `NETunnelProviderProtocol`. This adapter has no App Group or Keychain path.
     7	public final class MacOSSSHProfileSnapshotLoader: @unchecked Sendable {
     8	  private let loader: SSHProfileRuntimeSnapshotLoader
     9	
    10	  public init(loader: SSHProfileRuntimeSnapshotLoader = SSHProfileRuntimeSnapshotLoader()) {
    11	    self.loader = loader
    12	  }
    13	
    14	  public func capture(
    15	    from protocolConfiguration: NEVPNProtocol?,
    16	    expectation: SSHProfileSnapshotExpectation? = nil
    17	  ) throws -> SSHProfileSnapshotV1 {
    18	    guard let tunnelProtocol = protocolConfiguration as? NETunnelProviderProtocol else {
    19	      throw SSHProfileSnapshotLoaderError.profileCorrupt
    20	    }
    21	    return try capture(from: tunnelProtocol, expectation: expectation)
    22	  }
    23	
    24	  public func capture(
    25	    from tunnelProtocol: NETunnelProviderProtocol,
    26	    expectation: SSHProfileSnapshotExpectation? = nil
    27	  ) throws -> SSHProfileSnapshotV1 {
    28	    let configuration = tunnelProtocol.providerConfiguration?.mapValues(
    29	      MacOSVPNProviderConfigurationCodec.decode
    30	    )
    31	    return try loader.capture(from: configuration, expectation: expectation)
    32	  }
    33	}
