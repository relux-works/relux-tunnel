+            udp: snapshot.lifecycle.udp,
+            routeMode: snapshot.lifecycle.routeMode,
+            routesInstalled: snapshot.lifecycle.routesInstalled,
+            healthy: snapshot.lifecycle.healthy,
+            error: snapshot.lifecycle.error
