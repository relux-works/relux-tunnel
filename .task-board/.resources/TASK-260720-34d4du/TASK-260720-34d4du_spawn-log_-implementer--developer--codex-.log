    98	    @Test("Unread bytes suppress credit return and explicit policy can suppress adjustment")
    99	    func adjustmentSuppression() throws {
   100	        var manager = ChildChannelWindowManager(
   101	            configuration: .init(
   102	                initialWindowSize: 64 * 1024,
   103	                maximumWindowSize: 64 * 1024,
   104	                windowAdjustmentThreshold: nil
   105	            )
   106	        )
   107	
   108	        try manager.bufferFlowControlledBytes(32 * 1024)
   109	        var snapshot = manager.snapshot
   110	        #expect(snapshot.remainingWindowSize == 32 * 1024)
   111	        #expect(snapshot.bufferedBytes == 32 * 1024)
   112	        #expect(snapshot.adjustmentCount == 0)
   113	
   114	        #expect(manager.unbufferBytes(32 * 1024) == nil)
   115	        snapshot = manager.snapshot
   116	        #expect(snapshot.remainingWindowSize == 32 * 1024)
   117	        #expect(snapshot.bufferedBytes == 0)
   118	        #expect(snapshot.deliveredButUnadjustedBytes == 32 * 1024)
