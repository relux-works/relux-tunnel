  1610	  private func engineError(
  1611	    _ engineCode: Int32,
  1612	    phase: SSHTransportPhase,
  1613	    fallback: SSHTransportErrorCode
  1614	  ) -> SSHTransportError {
  1615	    let code: SSHTransportErrorCode
  1616	    switch engineCode {
  1617	    case LIBSSH2_ERROR_AUTHENTICATION_FAILED: code = .authenticationRejected
  1618	    case LIBSSH2_ERROR_PUBLICKEY_UNVERIFIED, LIBSSH2_ERROR_PUBLICKEY_PROTOCOL:
  1619	      code = .signatureFailed
  1620	    case LIBSSH2_ERROR_CHANNEL_FAILURE: code = .channelOpenRejected
  1621	    case LIBSSH2_ERROR_CHANNEL_REQUEST_DENIED: code = .execRejected
  1622	    case LIBSSH2_ERROR_CHANNEL_CLOSED, LIBSSH2_ERROR_CHANNEL_EOF_SENT: code = .channelClosed
  1623	    case LIBSSH2_ERROR_ALLOC: code = .resourceLimitExceeded
  1624	    case LIBSSH2_ERROR_SOCKET_SEND, LIBSSH2_ERROR_SOCKET_RECV,
  1625	      LIBSSH2_ERROR_SOCKET_DISCONNECT:
  1626	      code = .connectionLost
  1627	    case LIBSSH2_ERROR_TIMEOUT, LIBSSH2_ERROR_SOCKET_TIMEOUT: code = .timedOut
  1628	    default: code = fallback
  1629	    }
  1630	    return transportError(code: code, phase: phase)
  1631	  }
  1632	
  1633	  private func map(
  1634	    _ error: Error,
  1635	    phase: SSHTransportPhase,
  1636	    fallback: SSHTransportErrorCode = .adapterFailure
  1637	  ) -> SSHTransportError {
  1638	    if let error = error as? SSHTransportError { return error }
  1639	    if error is CancellationError { return transportError(code: .cancelled, phase: phase) }
  1640	    if error is LibSSH2TimeoutError { return transportError(code: .timedOut, phase: phase) }
  1641	    return transportError(code: fallback, phase: phase)
  1642	  }
  1643	
  1644	  private func recordTerminalOperation(_ error: SSHTransportError) async {
  1645	    if error.code == .timedOut {
  1646	      await metric(.increment(.operationsTimedOut, by: 1))
  1647	    } else if error.code == .cancelled {
  1648	      await metric(.increment(.operationsCancelled, by: 1))
  1649	    }
  1650	  }
  1651	
  1652	  private func transportError(
  1653	    code: SSHTransportErrorCode,
  1654	    phase: SSHTransportPhase,
  1655	    scope: SSHTransportErrorScope? = nil
  1656	  ) -> SSHTransportError {
  1657	    if code == .timedOut {
  1658	      counters.operationsTimedOut += 1
  1659	    } else if code == .cancelled {
  1660	      counters.operationsCancelled += 1
  1661	    }
  1662	    return try! SSHTransportError(
  1663	      code: code,
  1664	      phase: phase,
  1665	      scope: scope ?? .lane(lane),
  1666	      retryDisposition: code == .cancelled || code == .timedOut ? .newConnection : .never,
  1667	      requiresTeardown: scope == nil,
  1668	      channelOpenReason: code == .channelOpenRejected ? .unsupported : .notApplicable
  1669	    )
  1670	  }
  1671	}
