   288	def stream_sink(
   289	    source: BinaryIO, expected_bytes: int, expected_hash: str, read_bytes: int = 1024 * 1024
   290	) -> tuple[int, str]:
   291	    if expected_bytes < 0 or read_bytes <= 0:
   292	        raise FixtureError("sink counts must be non-negative and reads must be positive")
   293	    digest = hashlib.sha256()
   294	    received = 0
   295	    while True:
   296	        chunk = source.read(read_bytes)
   297	        if not chunk:
   298	            break
   299	        received += len(chunk)
   300	        if received > expected_bytes:
   301	            raise FixtureError("sink received more bytes than expected")
   302	        digest.update(chunk)
   303	    observed = f"SHA256:{digest.hexdigest()}"
   304	    if received != expected_bytes or observed != expected_hash:
   305	        raise FixtureError(
   306	            f"sink mismatch: bytes={received}/{expected_bytes}, hash={observed}/{expected_hash}"
   307	        )
   308	    return received, observed
