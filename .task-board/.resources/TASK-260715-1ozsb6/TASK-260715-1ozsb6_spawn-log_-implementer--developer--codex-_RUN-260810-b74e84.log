+private protocol LibSSH2OwnedAsyncOperation: AnyObject, Sendable {
+  var identifier: UUID { get }
+  func cancel()
+}
+
+private enum LibSSH2OwnedAsyncOperationRegistryError: Error {
+  case resourceLimitExceeded
