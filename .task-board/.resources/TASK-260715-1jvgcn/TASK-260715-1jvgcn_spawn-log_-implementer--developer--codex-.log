+  private func udpErrorCode(
+    for failure: RelayDatagramFailure
+  ) -> RelayProtocolV1.UDPErrorCode {
+    switch failure.code {
+    case .messageLengthExceedsProtocolMaximum,
+      .messageLengthExceedsLocalMaximum:
+      .datagramTooLarge
+    case .unknownAddressType:
+      .unsupportedAddress
