+    targets: [
+        .target(name: "ReluxTunnelCore"),
+        .target(name: "ReluxTunnelIOSAdapter", dependencies: ["ReluxTunnelCore"]),
+        .target(name: "ReluxTunnelMacOSAdapter", dependencies: ["ReluxTunnelCore"]),
