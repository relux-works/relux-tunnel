   458	def verify_binary_header(contents: bytes, os_name: str, architecture: str) -> None:
   459	    if os_name == "darwin":
   460	        if len(contents) < 8 or contents[:4] != b"\xcf\xfa\xed\xfe":
   461	            raise AssetManifestError(
   462	                "relay asset has an unparseable Darwin executable header"
   463	            )
   464	        machine = struct.unpack_from("<I", contents, 4)[0]
   465	        expected = 0x01000007 if architecture == "amd64" else 0x0100000C
   466	    else:
   467	        if (
   468	            len(contents) < 20
   469	            or contents[:4] != b"\x7fELF"
   470	            or contents[4] != 2
   471	            or contents[5] != 1
   472	        ):
   473	            raise AssetManifestError(
   474	                "relay asset has an unparseable Linux executable header"
   475	            )
   476	        machine = struct.unpack_from("<H", contents, 18)[0]
   477	        expected = 62 if architecture == "amd64" else 183
   478	    if machine != expected:
   479	        raise AssetManifestError(
   480	            "relay asset executable platform does not match its tuple"
   481	        )
