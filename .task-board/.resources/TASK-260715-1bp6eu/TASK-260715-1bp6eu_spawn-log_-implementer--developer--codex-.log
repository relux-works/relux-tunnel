+    guard phase == .running, activeGeneration?.identifier == generation else {
+      finishRequest(requestID.rawValue, generation: generation)
+      return Self.protocolErrorResponse(requestID: requestID, code: .unsupportedValue)
+    }
+    finishRequest(requestID.rawValue, generation: generation)
