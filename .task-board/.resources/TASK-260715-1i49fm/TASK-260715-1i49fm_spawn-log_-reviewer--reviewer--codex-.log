   316	    await withTaskGroup(of: [RuntimeDiagnosticsSnapshot].self) { group in
   317	      for _ in 0..<workerCount {
   318	        group.addTask {
   319	          for _ in 0..<updatesPerWorker {
   320	            recorder.recordQueueDrop(.tcpAdmissionLimit)
