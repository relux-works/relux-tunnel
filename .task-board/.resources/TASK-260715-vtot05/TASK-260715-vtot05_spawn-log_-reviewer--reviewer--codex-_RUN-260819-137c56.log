    54	            ("relux-relay-source", "contentSHA256", "0" * 64),
    55	            ("relay-build-recipe", "revision", "0" * 40),
    56	            ("relay-build-recipe", "contentSHA256", "0" * 64),
    57	            ("go-compiler-linker", "version", "go1.26.4"),
    58	            ("go-compiler-linker", "revision", "go1.26.4"),
