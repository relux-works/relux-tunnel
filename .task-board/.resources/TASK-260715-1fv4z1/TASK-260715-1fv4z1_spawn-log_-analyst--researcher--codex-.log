===== Sources/ReluxProxy/TunnelConfiguration.swift =====
     1	import Foundation
     2	
     3	struct TunnelConfiguration: Equatable {
     4	    let host: String
     5	    let account: String
     6	    let localPort: Int
     7	
     8	    var normalizedHost: String {
     9	        host.trimmingCharacters(in: .whitespacesAndNewlines)
    10	    }
    11	
    12	    var normalizedAccount: String {
    13	        account.trimmingCharacters(in: .whitespacesAndNewlines)
    14	    }
    15	
    16	    var target: String {
    17	        normalizedAccount.isEmpty
    18	            ? normalizedHost
    19	            : "\(normalizedAccount)@\(normalizedHost)"
    20	    }
    21	
    22	    var localEndpoint: String {
    23	        "127.0.0.1:\(localPort)"
    24	    }
    25	
    26	    var validationError: String? {
    27	        if normalizedHost.isEmpty {
    28	            return "Enter an SSH host or an alias from ~/.ssh/config."
    29	        }
    30	        if normalizedHost.contains(where: \Character.isWhitespace) {
    31	            return "The SSH host cannot contain whitespace."
    32	        }
    33	        if normalizedAccount.contains(where: \Character.isWhitespace)
    34	            || normalizedAccount.contains("@") {
    35	            return "The SSH account must not contain whitespace or @."
    36	        }
    37	        if !(1...65_535).contains(localPort) {
    38	            return "The local port must be between 1 and 65535."
    39	        }
    40	        return nil
    41	    }
    42	}

