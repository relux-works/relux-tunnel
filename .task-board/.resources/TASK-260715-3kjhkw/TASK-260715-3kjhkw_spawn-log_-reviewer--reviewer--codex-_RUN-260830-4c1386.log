   613	public enum MemoryWatermarkControllerError: Error, Equatable, Sendable {
   614	  case sequenceExhausted
   615	}
   616	
   617	private func headroom(limit: UInt64, used: UInt64) -> UInt64 {
   618	  used >= limit ? 0 : limit - used
   619	}
   620	
   621	private func incrementSaturating(_ value: UInt64, by amount: UInt64 = 1) -> UInt64 {
   622	  let (result, overflow) = value.addingReportingOverflow(amount)
   623	  return overflow ? UInt64.max : result
   624	}
   625	
   626	private struct RingHistory: Sendable {
   627	  private var storage: [MemoryObservation?]
   628	  private var next = 0
   629	  private var count = 0
   630	  private(set) var limit: Int
   631	
   632	  init(limit: Int) {
   633	    self.limit = limit
   634	    self.storage = Array(repeating: nil, count: limit)
   635	  }
   636	
   637	  mutating func append(_ value: MemoryObservation) {
   638	    storage[next] = value
   639	    next = (next + 1) % limit
   640	    count = min(count + 1, limit)
   641	  }
   642	
   643	  mutating func resize(to newLimit: Int) {
   644	    let retained = Array(values.suffix(newLimit))
   645	    self = RingHistory(limit: newLimit)
   646	    for value in retained { append(value) }
   647	  }
   648	
   649	  var values: [MemoryObservation] {
   650	    guard count > 0 else { return [] }
   651	    let start = count == limit ? next : 0
   652	    return (0..<count).compactMap { storage[(start + $0) % limit] }
   653	  }
   654	}

