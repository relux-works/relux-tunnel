+      if Darwin.mkdirat(directoryDescriptor, component, S_IRWXU) != 0, errno != EEXIST {
+        throw MTUMatrixError.outputWriteFailure(operation: "mkdirat output directory", code: errno)
+      }
+      let nextDescriptor = Darwin.openat(
+        directoryDescriptor, component, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC
+      )
+      guard nextDescriptor >= 0 else { throw MTUMatrixError.unsafeOutputPath }
+      _ = Darwin.close(directoryDescriptor)
+      directoryDescriptor = nextDescriptor
+    }
+
+    var existing = stat()
+    if Darwin.fstatat(directoryDescriptor, fileName, &existing, AT_SYMLINK_NOFOLLOW) == 0 {
+      guard existing.st_mode & S_IFMT != S_IFLNK else {
+        throw MTUMatrixError.unsafeOutputPath
+      }
+    } else if errno != ENOENT {
+      throw MTUMatrixError.outputWriteFailure(operation: "fstatat output file", code: errno)
+    }
+
+    let temporaryName = ".\(fileName).\(UUID().uuidString).tmp"
