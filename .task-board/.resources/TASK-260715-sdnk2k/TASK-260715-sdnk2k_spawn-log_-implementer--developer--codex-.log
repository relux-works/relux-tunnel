+      bufferBudget: budget
+    )
+
+    let run = Task { try await pump.run() }
+    #expect(await pumpEventually { channel.pendingReadCount == 1 && channel.pendingWriteCount == 1 })
+    let readCalls = local.readCallCount
+    let writeCalls = channel.writeCallCount
