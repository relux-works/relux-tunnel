    66	    case cancelling
    67	    case retired
    68	  }
    69	
    70	  private let lock = NSLock()
    71	  private var state = State.accepting
    72	  private var handles: [ObjectIdentifier: any ProviderCleanupControllable] = [:]
    73	
    74	  public init() {}
    75	
    76	  @discardableResult
    77	  public func register(_ handle: any ProviderCleanupControllable) -> Bool {
    78	    let action: RegistrationAction = lock.withLock {
    79	      switch state {
    80	      case .accepting where handles.count < Self.maximumHandles:
    81	        handles[ObjectIdentifier(handle)] = handle
    82	        return .accepted
    83	      case .accepting, .cancelling:
    84	        return .cancelAndForceClose
    85	      case .retired:
    86	        return .cancelAndForceClose
    87	      }
