    90	def collect_process(
    91	    process: subprocess.Popen[bytes], timeout: float = PROCESS_TIMEOUT_SECONDS
    92	) -> tuple[int, bytes, bytes]:
    93	    selector = selectors.DefaultSelector()
    94	    buffers = {"stdout": bytearray(), "stderr": bytearray()}
    95	    assert process.stdout is not None
    96	    assert process.stderr is not None
    97	    selector.register(process.stdout, selectors.EVENT_READ, "stdout")
    98	    selector.register(process.stderr, selectors.EVENT_READ, "stderr")
    99	    deadline = time.monotonic() + timeout
   100	    try:
   101	        while selector.get_map():
   102	            remaining = deadline - time.monotonic()
   103	            if remaining <= 0:
   104	                raise GateFailure("process_timeout")
   105	            for key, _ in selector.select(min(remaining, 0.1)):
   106	                chunk = os.read(key.fileobj.fileno(), 4096)
   107	                if not chunk:
   108	                    selector.unregister(key.fileobj)
   109	                    continue
   110	                buffer = buffers[key.data]
   111	                buffer.extend(chunk)
   112	                if len(buffer) > MAX_CAPTURE_BYTES:
   113	                    raise GateFailure(f"{key.data}_limit_exceeded")
   114	        remaining = deadline - time.monotonic()
   115	        if remaining <= 0:
   116	            raise GateFailure("process_timeout")
   117	        return_code = process.wait(timeout=remaining)
   118	        return return_code, bytes(buffers["stdout"]), bytes(buffers["stderr"])
   119	    except (subprocess.TimeoutExpired, GateFailure):
   120	        terminate_process_group(process)
   121	        raise GateFailure("process_timeout_or_output_limit") from None
   122	    finally:
   123	        selector.close()
   124	        close_process_pipes(process)
