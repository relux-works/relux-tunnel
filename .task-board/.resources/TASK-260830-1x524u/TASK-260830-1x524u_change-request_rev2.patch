+      tcpBufferBytes == 4_096,
+      let udpCopyBufferCount = int(packetBindings["hevUDPCopyBufferCount"]),
+      udpCopyBufferCount == 2,
+      let maximumSessionCount = int(packetBindings["hevMaximumSessionCount"]),
+      maximumSessionCount == 500
+    else {
