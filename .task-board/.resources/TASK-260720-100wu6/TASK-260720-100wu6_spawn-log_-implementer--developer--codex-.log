+
+  public init(
+    channel: SSHChannelIdentity,
+    before: Int,
+    amount: Int,
+    after: Int,
+    cap: Int
+  ) throws {
+    guard before >= 0, amount > 0, after == before + amount, after <= cap else {
+      throw SSHContractValidationError.invalidWindowAdjustment
+    }
+    self.channel = channel
+    self.before = before
+    self.amount = amount
+    self.after = after
+    self.cap = cap
+  }
+}
