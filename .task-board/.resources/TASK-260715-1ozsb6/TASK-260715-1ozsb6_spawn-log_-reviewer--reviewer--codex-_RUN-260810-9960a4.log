   289	private actor BridgeConnection: SSHTCPConnection {
   290	  private var reads: [Data?]
   291	  private let maximumWriteBytes: Int
   292	  private var written = Data()
   293	
   294	  init(reads: [Data?] = [], maximumWriteBytes: Int = .max) {
   295	    self.reads = reads
   296	    self.maximumWriteBytes = maximumWriteBytes
   297	  }
   298	
   299	  func waitForReadiness(_ interests: Set<SSHTCPReadiness>) async throws
   300	    -> Set<SSHTCPReadiness>
   301	  {
   302	    interests
   303	  }
   304	
   305	  func readSome(maximumBytes: Int) async throws -> Data? {
   306	    guard !reads.isEmpty else { return Data() }
   307	    return reads.removeFirst()
   308	  }
   309	
   310	  func writeSome(_ bytes: Data) async throws -> Int {
   311	    let count = min(bytes.count, maximumWriteBytes)
   312	    written.append(bytes.prefix(count))
   313	    return count
   314	  }
   315	
   316	  func close() async {}
   317	
   318	  func writtenBytes() -> Data { written }
   319	}
   320	
   321	private actor SuspendingWriteConnection: SSHTCPConnection {
   322	  private let maximumWriteBytes: Int
   323	  private var written = Data()
   324	  private var activeWrites = 0
   325	  private var maximumActiveWrites = 0
   326	  private var firstWriteStarted = false
   327	  private var firstWriteStartWaiters: [CheckedContinuation<Void, Never>] = []
   328	  private var firstWriteRelease: CheckedContinuation<Void, Never>?
   329	
   330	  init(maximumWriteBytes: Int) {
   331	    self.maximumWriteBytes = maximumWriteBytes
   332	  }
   333	
   334	  func waitForReadiness(_ interests: Set<SSHTCPReadiness>) async throws
   335	    -> Set<SSHTCPReadiness>
   336	  {
   337	    interests
   338	  }
   339	
   340	  func readSome(maximumBytes: Int) async throws -> Data? { Data() }
   341	
   342	  func writeSome(_ bytes: Data) async throws -> Int {
   343	    activeWrites += 1
   344	    maximumActiveWrites = max(maximumActiveWrites, activeWrites)
   345	    if !firstWriteStarted {
   346	      firstWriteStarted = true
   347	      let waiters = firstWriteStartWaiters
   348	      firstWriteStartWaiters.removeAll()
   349	      for waiter in waiters { waiter.resume() }
   350	      await withCheckedContinuation { continuation in
