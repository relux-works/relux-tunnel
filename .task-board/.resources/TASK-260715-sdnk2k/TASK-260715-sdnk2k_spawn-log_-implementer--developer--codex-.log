+    #expect(await budget.tryReserve(bytes: 16))
+    #expect(await budget.tryReserve(bytes: 16))
+    #expect(!(await budget.tryReserve(bytes: 1)))
+    await budget.release(bytes: 16)
+    await budget.release(bytes: 16)
