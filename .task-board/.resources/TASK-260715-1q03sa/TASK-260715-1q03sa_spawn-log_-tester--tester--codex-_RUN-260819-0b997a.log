+    )
+    creation_info["created"] = normalized_spdx_timestamp(source_date_epoch)
+    sbom.write_bytes(
+        (json.dumps(document, ensure_ascii=False, indent=2, sort_keys=True) + "\n").encode(
+            "utf-8"
+        )
+    )
