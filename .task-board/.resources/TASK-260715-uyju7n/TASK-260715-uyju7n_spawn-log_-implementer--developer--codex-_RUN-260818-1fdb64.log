+    destinations: [.mac],
+    product: .systemExtension,
+    bundleId: "$(RELUX_MACOS_PROVIDER_BUNDLE_ID)",
+    deploymentTargets: macOSDeploymentTargets,
+    infoPlist: "App/ReluxProxyMacTunnel/Info.plist",
+    sources: [
+      "App/ReluxProxyMacTunnel/Sources/**",
+      "App/Shared/**",
+    ],
+    dependencies: [
