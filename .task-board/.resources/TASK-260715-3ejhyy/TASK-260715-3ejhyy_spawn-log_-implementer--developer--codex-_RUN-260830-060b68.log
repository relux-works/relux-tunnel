   293	    reviewDigest: String
   294	  ) throws {
   295	    guard string(evidence["taskId"]) == taskID else {
   296	      throw MacOSProductionBindingError.incompatibleBinding(label)
   297	    }
   298	    if let digest = string(evidence["sha256"]) {
   299	      guard digest == outcomeDigest else {
   300	        throw MacOSProductionBindingError.resourceDigestMismatch(label)
   330	    guard let input = inputs[kind] else {
   331	      throw MacOSProductionBindingError.incompatibleBinding(kind)
   332	    }
