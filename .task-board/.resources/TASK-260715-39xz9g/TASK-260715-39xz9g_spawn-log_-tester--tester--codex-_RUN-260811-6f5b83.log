   674	    def _terminate_owned_process(self, pid: int, marker: str) -> None:
   675	        if not isinstance(pid, int) or pid <= 1:
   676	            raise ProviderError("refusing to terminate an invalid process ID")
   677	        inspected = subprocess.run(
   678	            ["/bin/ps", "-p", str(pid), "-o", "command="],
   679	            stdout=subprocess.PIPE,
   680	            stderr=subprocess.PIPE,
   681	            check=False,
   682	        )
   683	        if inspected.returncode != 0:
   684	            return
   685	        command = inspected.stdout.decode("utf-8", errors="replace")
   686	        if marker not in command and fixture.TASK_ID not in command:
   687	            raise ProviderError("refusing to terminate a process outside task ownership")
   688	        os.kill(pid, signal.SIGTERM)
   689	        deadline = time.monotonic() + 2
   690	        while time.monotonic() < deadline:
   691	            tracked = self._processes.get(pid)
   692	            if tracked is not None and tracked.poll() is not None:
   693	                tracked.wait()
   694	                self._processes.pop(pid, None)
   695	                return
   696	            try:
   697	                os.kill(pid, 0)
   698	            except ProcessLookupError:
   699	                self._processes.pop(pid, None)
   700	                return
   701	            time.sleep(0.05)
   702	        os.kill(pid, signal.SIGKILL)
   703	        tracked = self._processes.pop(pid, None)
   704	        if tracked is not None:
   705	            tracked.wait(timeout=2)
   706	
   707	    def _lima_instance_exists(self) -> bool:
   708	        completed = _run(["limactl", "list", "--json"], timeout=30)
   709	        try:
   710	            encoded = completed.stdout.decode("utf-8", errors="strict")
   711	            decoder = json.JSONDecoder()
   712	            offset = 0
   713	            records = []
   714	            while offset < len(encoded):
   715	                while offset < len(encoded) and encoded[offset].isspace():
   716	                    offset += 1
   717	                if offset == len(encoded):
   718	                    break
   719	                value, offset = decoder.raw_decode(encoded, offset)
   720	                records.extend(value if isinstance(value, list) else [value])
   721	        except (UnicodeDecodeError, json.JSONDecodeError) as error:
   722	            raise ProviderError("unable to verify Lima fixture absence") from error
   723	        if not all(isinstance(record, dict) and isinstance(record.get("name"), str) for record in records):
   724	            raise ProviderError("unable to verify Lima fixture absence")
   725	        return any(record["name"] == LIMA_INSTANCE for record in records)
   726	
   727	    def _teardown(self, server_id: str) -> dict:
   728	        path = self._state_path(server_id)
   729	        state = None
   730	        if path.exists():
   731	            state = self._load_state(server_id)
   732	        if state is not None:
   733	            for process in reversed(state.get("processes", [])):
   734	                self._terminate_owned_process(process["pid"], process["marker"])
   735	        if server_id == "linux-current":
   736	            if self._lima_instance_exists():
   737	                _run(["limactl", "delete", "-f", LIMA_INSTANCE], timeout=60)
   738	            if self._lima_instance_exists():
   739	                raise ProviderError("Lima fixture instance remains after delete")
   740	        directory = self._server_dir(server_id)
   741	        if directory.exists():
   742	            shutil.rmtree(directory)
   743	        residual = int(directory.exists())
   744	        return {"residualResources": residual, "status": "ok" if residual == 0 else "fail"}
   745	
   746	
   747	def _tag_process_kinds(state_root: Path, server_id: str) -> None:
   748	    path = state_root / server_id / "state.json"
   749	    state = json.loads(path.read_text(encoding="utf-8"))
   750	    if server_id.startswith("macos-") and len(state.get("processes", [])) == 2:
   751	        state["processes"][0]["kind"] = "endpoints"
   752	        state["processes"][1]["kind"] = "sshd"
   753	    elif state.get("processes"):
   754	        state["processes"][0]["kind"] = "endpoints"
   755	    path.write_bytes(fixture.canonical_json(state))
   756	    os.chmod(path, 0o600)
