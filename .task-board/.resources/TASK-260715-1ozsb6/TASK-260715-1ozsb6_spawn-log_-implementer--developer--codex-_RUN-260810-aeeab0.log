   841	  func channelDeferredWindow(
   842	    identity: SSHChannelIdentity
   843	  ) -> SSHDeferredSemanticReport<SSHReceiveWindowSnapshot> {
   844	    channels[identity] == nil ? .notReported : .unsupported
   845	  }
