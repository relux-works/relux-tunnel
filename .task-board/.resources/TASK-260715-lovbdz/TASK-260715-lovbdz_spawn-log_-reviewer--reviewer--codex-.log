  1032	    encoder.outputFormatting = [.sortedKeys, .withoutEscapingSlashes]
  1033	    do {
  1034	      let data = try encoder.encode(value)
  1035	      guard data.count <= maximumBytes else {
  1036	        throw RuntimeMessageCodecError.payloadTooLarge(
  1037	          maximumBytes: maximumBytes,
  1038	          actualBytes: data.count
  1039	        )
  1040	      }
  1041	      return data
  1042	    } catch let error as RuntimeMessageCodecError {
  1043	      throw error
  1044	    } catch {
  1045	      throw RuntimeMessageCodecError.corruptPayload
  1046	    }
  1047	  }
