   895	def render_provenance(config: dict[str, Any]) -> bytes:
   896	    subject = manifest_linkage_subject(config)
   897	    return stable_json(
   898	        {
   899	            "_type": "https://in-toto.io/Statement/v1",
   900	            "subject": [
   901	                {"name": item["fileName"], "digest": {"sha256": item["sha256"]}}
   902	                for item in subject["assets"]
   903	            ],
   904	            "predicateType": "https://slsa.dev/provenance/v1",
   905	            "predicate": {
   906	                "buildDefinition": {
   907	                    "buildType": "https://relux.works/build-types/relay-portable-v1",
   908	                    "externalParameters": {
   909	                        "command": config["build"]["command"],
   910	                        "targets": config["build"]["targets"],
   911	                        "sourceDateEpoch": config["source"]["sourceDateEpoch"],
   912	                    },
   913	                    "resolvedDependencies": [
   914	                        {
   915	                            "name": item["id"],
   916	                            "uri": item["source"],
   917	                            "digest": {"sha256": item["contentSHA256"]},
   918	                            "revision": item["revision"],
   919	                        }
   920	                        for item in config["components"]
   921	                    ],
   922	                },
   923	                "runDetails": {
   924	                    "builder": {"id": "repository-local-darwin-arm64-no-container"},
   925	                    "metadata": {
   926	                        "invocationId": config["artifactManifest"]["archiveTaskID"]
   927	                    },
   928	                    "byproducts": [
   929	                        {
   930	                            "name": "assetArchive",
   931	                            "digest": {
   932	                                "sha256": config["artifactManifest"]["archiveSHA256"]
   933	                            },
   934	                        },
   935	                        {
   936	                            "name": "assetManifestLinkage",
   937	                            "digest": {"sha256": linkage_id(config)},
   938	                        },
   939	                    ],
   940	                },
   941	                "source": config["source"],
   942	                "buildRecipe": config["build"],
   943	                "artifactManifest": subject,
   944	                "supplyChainBoundary": config["boundary"],
   945	                "runtimePolicy": config["runtimePolicy"],
   946	            },
   947	        }
   948	    )
