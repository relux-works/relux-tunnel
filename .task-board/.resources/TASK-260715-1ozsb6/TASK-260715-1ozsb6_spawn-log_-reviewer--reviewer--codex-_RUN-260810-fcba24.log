  1583	      String(decoding: $0.bindMemory(to: UInt8.self), as: UTF8.self)
  1584	    }
  1585	    if let engineSession { libssh2_free(engineSession, signal) }
  1586	    return .signal(
  1587	      SSHExecSignal(name: execSignalName(name), coreDumped: .unsupported)
  1588	    )
  1589	  }
