+private struct HarnessFactorySettingsApplier: NetworkSettingsApplier {
+  func apply(_ plan: any NetworkSettingsPlan, runtimeGeneration: UInt64) async throws {}
+  func clear(runtimeGeneration: UInt64) async throws {}
+}
