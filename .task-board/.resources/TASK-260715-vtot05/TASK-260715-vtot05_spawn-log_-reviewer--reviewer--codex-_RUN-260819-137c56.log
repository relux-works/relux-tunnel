   642	def validate_manifest(manifest: dict[str, Any], contract: dict[str, Any]) -> None:
   643	    if set(manifest) != MANIFEST_KEYS:
   644	        raise AssetManifestError("relay asset manifest field set changed")
   645	    if (
   646	        manifest.get("schemaVersion") != SCHEMA_VERSION
   647	        or manifest.get("relayProtocolVersion") != PROTOCOL_VERSION
   648	    ):
   649	        raise AssetManifestError("relay asset manifest version mismatch")
   650	    if (
   651	        validate_provenance(manifest.get("buildProvenance"))
   652	        != contract["buildProvenance"]
   653	    ):
   654	        raise AssetManifestError("relay asset manifest provenance mismatch")
   655	    if validate_supply_chain(manifest.get("supplyChain")) != contract["supplyChain"]:
   656	        raise AssetManifestError("relay asset manifest supply-chain mismatch")
   657	    assets = manifest.get("assets")
   658	    if not isinstance(assets, list) or len(assets) != len(TARGETS):
   659	        raise AssetManifestError(
   660	            "relay asset manifest must contain exactly four assets"
   661	        )
   662	    tuples: set[tuple[str, str]] = set()
   663	    names: set[str] = set()
   664	    locations: set[str] = set()
   665	    for asset, source, expected_target in zip(
   666	        assets, contract["assets"], TARGETS, strict=True
   667	    ):
   668	        if not isinstance(asset, dict) or set(asset) != MANIFEST_ASSET_KEYS:
   669	            raise AssetManifestError("relay asset manifest entry field set changed")
   670	        target = (asset.get("os"), asset.get("arch"))
   671	        if target != expected_target or target in tuples:
   672	            raise AssetManifestError(
   673	                "relay asset manifest target order or uniqueness changed"
   674	            )
   675	        expected_location = f"{contract['bundleSubdirectory']}/{source['fileName']}"
   676	        if (
   677	            asset.get("fileName") != source["fileName"]
   678	            or asset.get("bundleLocation") != expected_location
   679	            or asset.get("byteSize") != source["byteSize"]
   680	            or asset.get("sha256") != source["sha256"]
   681	            or asset.get("relayProtocolVersion") != PROTOCOL_VERSION
   682	            or asset.get("buildProvenanceReference") != "#/buildProvenance"
   683	            or asset.get("sourceProvenanceReference") != "#/supplyChain"
   684	        ):
   685	            raise AssetManifestError(
   686	                "relay asset manifest entry does not match trusted source"
   687	            )
   688	        identity = asset.get("buildIdentity")
   689	        expected_identity = {
   690	            "schemaVersion": IDENTITY_SCHEMA_VERSION,
   691	            "relayProtocolVersion": PROTOCOL_VERSION,
   692	            "relayVersion": contract["relayVersion"],
   693	            "sourceCommit": contract["sourceCommit"],
   694	            "os": source["os"],
   695	            "arch": source["arch"],
   696	            "selfSha256": source["sha256"],
   697	        }
   698	        if not isinstance(identity, dict) or set(identity) != IDENTITY_KEYS:
   699	            raise AssetManifestError(
   700	                "relay asset manifest build identity field set changed"
   701	            )
   702	        if identity != expected_identity:
   703	            raise AssetManifestError("relay asset manifest build identity mismatch")
   704	        tuples.add(target)
   705	        names.add(asset["fileName"])
   706	        locations.add(asset["bundleLocation"])
   707	    if len(tuples) != 4 or len(names) != 4 or len(locations) != 4:
   708	        raise AssetManifestError("relay asset manifest contains duplicate assets")
