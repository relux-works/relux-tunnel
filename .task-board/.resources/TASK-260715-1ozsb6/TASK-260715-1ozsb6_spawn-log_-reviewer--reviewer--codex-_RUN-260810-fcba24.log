  1674	  private func scheduleByteRekeyIfNeeded() {
  1675	    guard let configuration, !byteRekeyScheduled else { return }
  1676	    let threshold = configuration.rekey.protectedByteThresholdPerDirection
  1677	    guard
  1678	      counters.protectedBytesSent - rekeySentBytesBaseline >= threshold
  1679	        || counters.protectedBytesReceived - rekeyReceivedBytesBaseline >= threshold
