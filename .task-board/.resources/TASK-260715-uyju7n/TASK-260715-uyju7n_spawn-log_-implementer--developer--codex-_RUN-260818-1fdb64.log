grep -Fx 'APPLICATION_EXTENSION_API_ONLY = YES' \
  Configuration/Provider-Release.xcconfig >/dev/null
grep -Ex 'MARKETING_VERSION = [0-9]+\.[0-9]+\.[0-9]+' \
