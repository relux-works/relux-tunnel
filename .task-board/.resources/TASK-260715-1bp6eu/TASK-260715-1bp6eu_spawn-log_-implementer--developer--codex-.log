+  private func finalizeCleanup(
+    generation: UInt64?,
+    keepStoppingAfterCleanup: Bool
+  ) {
+    guard let generation, cleanupGeneration == generation else { return }
+    activeGeneration = nil
+    cleanupTask = nil
