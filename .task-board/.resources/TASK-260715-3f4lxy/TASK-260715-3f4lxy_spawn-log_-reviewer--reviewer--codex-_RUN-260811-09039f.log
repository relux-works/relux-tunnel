   411	      guard let algorithm = SSHHostKeyAlgorithm(rawValue: record.algorithm),
   412	        algorithms.contains(algorithm),
   413	        let state = SSHHostIdentityState(rawValue: record.state),
   414	        let provenance = SSHHostIdentityProvenance(rawValue: record.provenance)
   415	      else {
   416	        throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   417	      }
   418	      let fingerprint = try fingerprint(record.fingerprintSHA256)
   419	      let tuple = SSHHostIdentityTuple(algorithm: algorithm, digest: fingerprint.digest)
   420	      guard tuples.insert(tuple).inserted else {
   421	        throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   422	      }
   423	      let firstSeenAt = try timestamp(record.firstSeenAt, field: .trustRecords)
   424	      let lastSeenAt = try timestamp(record.lastSeenAt, field: .trustRecords)
   425	      guard firstSeenAt.date <= lastSeenAt.date else {
   426	        throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   427	      }
   428	      let approvedAt = try record.approvedAt.map { value in
   429	        let parsed = try timestamp(value, field: .trustRecords)
   430	        return SSHProfileTimestamp(parsed.rawValue)
   431	      }
   432	      let revokedAt = try record.revokedAt.map { value in
   433	        let parsed = try timestamp(value, field: .trustRecords)
   434	        return SSHProfileTimestamp(parsed.rawValue)
   435	      }
   436	      let revocationReason = record.revocationReason.flatMap(
   437	        SSHHostIdentityRevocationReason.init(rawValue:)
   438	      )
   439	
   440	      switch state {
   441	      case .approved:
   442	        approvedCount += 1
   443	        guard approvedAt != nil, revokedAt == nil, record.revocationReason == nil else {
   444	          throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   445	        }
   446	      case .revoked:
   447	        guard revokedAt != nil, revocationReason != nil else {
   448	          throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   449	        }
   450	      }
   451	      if record.revocationReason != nil, revocationReason == nil {
   452	        throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   453	      }
   454	
   455	      records.append(
   456	        SSHHostIdentityRecordV1(
   457	          algorithm: algorithm,
   458	          fingerprintSHA256: SSHHostKeyFingerprint(fingerprint.rawValue),
   459	          state: state,
   460	          provenance: provenance,
   461	          firstSeenAt: SSHProfileTimestamp(firstSeenAt.rawValue),
   462	          lastSeenAt: SSHProfileTimestamp(lastSeenAt.rawValue),
   463	          approvedAt: approvedAt,
   464	          revokedAt: revokedAt,
   465	          revocationReason: revocationReason
   466	        )
   467	      )
   468	    }
   469	    guard approvedCount <= 1 else {
   470	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   471	    }
   472	
   473	    let sortedTuples = tuples.sorted(by: SSHHostIdentityTuple.isOrderedBefore)
   474	    let actualTuples = records.map {
   475	      SSHHostIdentityTuple(
   476	        algorithm: $0.algorithm,
   477	        digest: fingerprintDigest($0.fingerprintSHA256.rawValue)!
   478	      )
   479	    }
   480	    guard actualTuples == sortedTuples else {
   481	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   482	    }
   483	    return SSHHostPolicyV1(allowedAlgorithms: algorithms, records: records)
   484	  }
   485	
   486	  private static func validateDisplayName(_ value: String) throws {
   487	    guard value.utf8.elementsEqual(value.precomposedStringWithCanonicalMapping.utf8),
   488	      value == value.trimmingCharacters(in: .whitespacesAndNewlines),
   489	      (1...128).contains(value.unicodeScalars.count),
   490	      !value.unicodeScalars.contains(where: isRejectedDisplayScalar)
   491	    else {
   492	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.displayName)
   493	    }
   494	  }
   495	
   496	  private static func validateAccount(_ value: String) throws {
   497	    guard value.utf8.elementsEqual(value.precomposedStringWithCanonicalMapping.utf8),
   498	      value == value.trimmingCharacters(in: .whitespacesAndNewlines),
   499	      (1...64).contains(value.utf8.count),
   500	      !value.unicodeScalars.contains(where: isRejectedAccountScalar)
   501	    else {
   502	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.account)
   503	    }
   504	  }
   505	
   506	  private static func validateHost(
   507	    _ wire: SSHProfileCanonicalHostWire
   508	  ) throws -> SSHProfileCanonicalHost {
   509	    guard let kind = SSHProfileHostKind(rawValue: wire.kind) else {
   510	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.canonicalHost)
   511	    }
   512	    let value = wire.value
   513	    guard !value.isEmpty,
   514	      value == value.trimmingCharacters(in: CharacterSet(charactersIn: " \t\r\n")),
   515	      !value.unicodeScalars.contains(where: { $0.value < 0x20 || $0.value == 0x7F }),
   516	      !value.contains(where: { $0.isWhitespace }),
   517	      !value.contains("@"), !value.contains("/"), !value.contains("?"),
   518	      !value.contains("#"), !value.contains("["), !value.contains("]"),
   519	      !value.contains("%"), !value.contains("://")
   520	    else {
   521	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.canonicalHost)
   522	    }
   523	
   524	    let isCanonical: Bool
   525	    switch kind {
   526	    case .dns:
   527	      isCanonical = isCanonicalDNS(value)
   528	    case .ipv4:
   529	      isCanonical = canonicalNumericAddress(value, family: AF_INET) == value
   530	    case .ipv6:
   531	      isCanonical = canonicalNumericAddress(value, family: AF_INET6) == value
   532	    }
   533	    guard isCanonical else {
   534	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.canonicalHost)
   535	    }
   536	    return SSHProfileCanonicalHost(kind: kind, value: value)
   537	  }
   538	
   539	  private static func isCanonicalDNS(_ value: String) -> Bool {
   540	    guard value.utf8.count <= 253,
   541	      value.unicodeScalars.allSatisfy({ $0.isASCII }),
   542	      value == value.lowercased(),
   543	      !value.hasSuffix("."),
   544	      canonicalNumericAddress(value, family: AF_INET) == nil,
   545	      canonicalNumericAddress(value, family: AF_INET6) == nil
   546	    else { return false }
   547	
   548	    let labels = value.split(separator: ".", omittingEmptySubsequences: false)
   549	    guard !labels.isEmpty else { return false }
   550	    if labels.count == 4,
   551	      labels.allSatisfy({ label in
   552	        !label.isEmpty && label.allSatisfy(\.isNumber)
   553	      })
   554	    {
   555	      return false
   556	    }
   557	    for label in labels {
   558	      guard (1...63).contains(label.utf8.count),
   559	        label.first != "-", label.last != "-",
   560	        label.allSatisfy({ $0.isASCII && ($0.isLetter || $0.isNumber || $0 == "-") })
   561	      else { return false }
   562	      if label.count >= 4,
   563	        label[label.index(label.startIndex, offsetBy: 2)] == "-",
   564	        label[label.index(label.startIndex, offsetBy: 3)] == "-",
   565	        !label.hasPrefix("xn--")
   566	      {
   567	        return false
   568	      }
   569	    }
   570	
   571	    var components = URLComponents()
   572	    components.scheme = "ssh"
   573	    components.host = value
   574	    guard let unicodeHost = components.host,
   575	      let encodedHost = components.url?.host()?.lowercased(),
   576	      encodedHost == value
   577	    else { return false }
   578	    var roundTrip = URLComponents()
   579	    roundTrip.scheme = "ssh"
   580	    roundTrip.host = unicodeHost
   581	    return roundTrip.url?.host()?.lowercased() == value
   582	  }
   583	
   584	  private static func canonicalNumericAddress(_ value: String, family: Int32) -> String? {
   585	    if family == AF_INET {
   586	      var address = in_addr()
   587	      guard value.withCString({ inet_pton(AF_INET, $0, &address) }) == 1 else { return nil }
   588	      var buffer = [CChar](repeating: 0, count: Int(INET_ADDRSTRLEN))
   589	      guard inet_ntop(AF_INET, &address, &buffer, socklen_t(buffer.count)) != nil else {
   590	        return nil
   591	      }
   592	      return String(
   593	        decoding: buffer.prefix(while: { $0 != 0 }).map { UInt8(bitPattern: $0) },
   594	        as: UTF8.self
   595	      )
   596	    }
   597	    var address = in6_addr()
   598	    guard value.withCString({ inet_pton(AF_INET6, $0, &address) }) == 1 else { return nil }
   599	    var buffer = [CChar](repeating: 0, count: Int(INET6_ADDRSTRLEN))
   600	    guard inet_ntop(AF_INET6, &address, &buffer, socklen_t(buffer.count)) != nil else {
   601	      return nil
   602	    }
   603	    return String(
   604	      decoding: buffer.prefix(while: { $0 != 0 }).map { UInt8(bitPattern: $0) },
   605	      as: UTF8.self
   606	    )
   607	  }
   608	
   609	  private static func canonicalUUID(
   610	    _ value: String,
   611	    field: SSHProfileSnapshotField
   612	  ) throws -> UUID {
   613	    guard let uuid = UUID(uuidString: value), uuid.uuidString.lowercased() == value else {
   614	      throw SSHProfileSnapshotLoaderError.profileInvalidField(field)
   615	    }
   616	    return uuid
   617	  }
   618	
   619	  private static func timestamp(
   620	    _ value: String,
   621	    field: SSHProfileSnapshotField
   622	  ) throws -> (rawValue: String, date: Date) {
   623	    let bytes = Array(value.utf8)
   624	    guard bytes.count == 24,
   625	      bytes[4] == UInt8(ascii: "-"), bytes[7] == UInt8(ascii: "-"),
   626	      bytes[10] == UInt8(ascii: "T"), bytes[13] == UInt8(ascii: ":"),
   627	      bytes[16] == UInt8(ascii: ":"), bytes[19] == UInt8(ascii: "."),
   628	      bytes[23] == UInt8(ascii: "Z"),
   629	      bytes.enumerated().allSatisfy({ index, byte in
   630	        [4, 7, 10, 13, 16, 19, 23].contains(index)
   631	          || (UInt8(ascii: "0")...UInt8(ascii: "9")).contains(byte)
   632	      })
   633	    else {
   634	      throw SSHProfileSnapshotLoaderError.profileInvalidField(field)
   635	    }
   636	    let formatter = ISO8601DateFormatter()
   637	    formatter.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
   638	    formatter.timeZone = TimeZone(secondsFromGMT: 0)
   639	    guard let date = formatter.date(from: value), formatter.string(from: date) == value else {
   640	      throw SSHProfileSnapshotLoaderError.profileInvalidField(field)
   641	    }
   642	    return (value, date)
   643	  }
   644	
   645	  private static func fingerprint(
   646	    _ value: String
   647	  ) throws -> (rawValue: String, digest: Data) {
   648	    guard let digest = fingerprintDigest(value) else {
   649	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   650	    }
   651	    return (value, digest)
   652	  }
   653	
   654	  private static func fingerprintDigest(_ value: String) -> Data? {
   655	    guard value.hasPrefix("SHA256:"), value.utf8.count == 50 else { return nil }
   656	    let encoded = String(value.dropFirst(7))
   657	    guard encoded.utf8.count == 43,
   658	      encoded.unicodeScalars.allSatisfy({ scalar in
   659	        scalar.isASCII
   660	          && (("A"..."Z").contains(Character(scalar))
   661	            || ("a"..."z").contains(Character(scalar))
   662	            || ("0"..."9").contains(Character(scalar))
   663	            || scalar == "+" || scalar == "/")
   664	      }),
   665	      let data = Data(base64Encoded: encoded + "="), data.count == 32,
   666	      data.base64EncodedString().dropLast() == encoded
   667	    else { return nil }
   668	    return data
   669	  }
   670	
   671	  private static func isRejectedDisplayScalar(_ scalar: Unicode.Scalar) -> Bool {
   672	    CharacterSet.controlCharacters.contains(scalar)
   673	      || scalar.value == 0x2028 || scalar.value == 0x2029
   674	      || (0x202A...0x202E).contains(scalar.value)
   675	      || (0x2066...0x2069).contains(scalar.value)
   676	  }
   677	
   678	  private static func isRejectedAccountScalar(_ scalar: Unicode.Scalar) -> Bool {
   679	    scalar.value == 0 || CharacterSet.controlCharacters.contains(scalar)
   680	      || scalar.value == 0x2028 || scalar.value == 0x2029
   681	  }
   682	
   683	  private static func isProhibitedFieldName(_ name: String) -> Bool {
   684	    let normalized = name.lowercased().unicodeScalars.filter {
   685	      CharacterSet.alphanumerics.contains($0)
   686	    }.map(String.init).joined()
   687	    let prohibitedRoots = [
   688	      "privatekey", "seed", "passphrase", "decryptedkey", "decryptedprivatekey",
   689	      "keybyte", "keybytes", "rawhostkey", "password", "stagingcredential",
   690	    ]
   691	    let prohibitedSuffixes: Set<String> = [
   692	      "", "byte", "bytes", "content", "data", "material", "payload", "value",
   693	    ]
   694	    return prohibitedRoots.contains { root in
   695	      guard normalized.hasPrefix(root) else { return false }
   696	      return prohibitedSuffixes.contains(String(normalized.dropFirst(root.count)))
   697	    }
   698	  }
   699	
   700	  fileprivate static func digestOfValidatedBytes(
   701	    _ data: Data
   702	  ) -> SSHProfileSnapshotDigestSHA256 {
   703	    let value = SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
   704	    return SSHProfileSnapshotDigestSHA256(validatedRawValue: value)
   705	  }
   706	}
   707	
   708	public enum SSHProfileProviderConfigurationCodec {
   709	  public static let maximumEnvelopeBytes = RuntimeMessageSizeLimit.providerConfiguration
   710	
   711	  public static func encode(
   712	    _ snapshot: SSHProfileSnapshotV1
   713	  ) throws -> [String: VPNProviderConfigurationValue] {
   714	    let data = try SSHProfileSnapshotCodec.encode(snapshot)
   715	    let configuration: [String: VPNProviderConfigurationValue] = [
   716	      OwnedVPNManagerRepository.ownerKey: .string(OwnedVPNManagerRepository.ownerValue),
   717	      OwnedVPNManagerRepository.managerContractKey: .integer(
   718	        OwnedVPNManagerRepository.managerContractVersion
   719	      ),
   720	      OwnedVPNManagerRepository.configurationReferenceKey: .data(data),
   721	    ]
   722	    guard try envelopeSize(configuration) <= maximumEnvelopeBytes else {
   723	      throw SSHProfileSnapshotLoaderError.profileOversize
   724	    }
   725	    return configuration
   726	  }
   727	
   728	  public static func decode(
   729	    _ configuration: [String: VPNProviderConfigurationValue]?
   730	  ) throws -> SSHProfileSnapshotV1 {
   731	    try decodeCapture(configuration).snapshot
   732	  }
   733	
   734	  public static func startRequest(
   735	    for configuration: [String: VPNProviderConfigurationValue]?
   736	  ) throws -> RuntimeStartRequest {
   737	    let candidate = try decodeCapture(configuration)
   738	    return RuntimeStartRequest(
   739	      configurationGeneration: candidate.snapshot.configurationGeneration,
   740	      snapshotDigestSHA256: SSHProfileSnapshotCodec.digestOfValidatedBytes(candidate.data)
   741	    )
   742	  }
   743	
   744	  public static func envelopeSize(
   745	    _ configuration: [String: VPNProviderConfigurationValue]
   746	  ) throws -> Int {
   747	    let propertyList = try exactPropertyList(configuration)
   748	    do {
   749	      return try PropertyListSerialization.data(
   750	        fromPropertyList: propertyList,
   751	        format: .binary,
   752	        options: 0
   753	      ).count
   754	    } catch {
   755	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   756	    }
   757	  }
   758	
   759	  static func decodeCapture(
   760	    _ configuration: [String: VPNProviderConfigurationValue]?
   761	  ) throws -> (snapshot: SSHProfileSnapshotV1, data: Data) {
   762	    guard let configuration else {
   763	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   764	    }
   765	    let propertyList = try exactPropertyList(configuration)
   766	    guard
   767	      case .data(let data) = configuration[
   768	        OwnedVPNManagerRepository.configurationReferenceKey
   769	      ]
   770	    else {
   771	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   772	    }
   773	    guard data.count <= maximumEnvelopeBytes else {
   774	      throw SSHProfileSnapshotLoaderError.profileOversize
   775	    }
   776	    do {
   777	      let envelope = try PropertyListSerialization.data(
   778	        fromPropertyList: propertyList,
   779	        format: .binary,
   780	        options: 0
   781	      )
   782	      guard envelope.count <= maximumEnvelopeBytes else {
   783	        throw SSHProfileSnapshotLoaderError.profileOversize
   784	      }
   785	    } catch let error as SSHProfileSnapshotLoaderError {
   786	      throw error
   787	    } catch {
   788	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   789	    }
   790	    return (try SSHProfileSnapshotCodec.decode(data), data)
   791	  }
   792	
   793	  private static func exactPropertyList(
   794	    _ configuration: [String: VPNProviderConfigurationValue]
   795	  ) throws -> [String: Any] {
   796	    let requiredKeys: Set<String> = [
   797	      OwnedVPNManagerRepository.ownerKey,
   798	      OwnedVPNManagerRepository.managerContractKey,
   799	      OwnedVPNManagerRepository.configurationReferenceKey,
   800	    ]
   801	    guard Set(configuration.keys) == requiredKeys,
   802	      configuration[OwnedVPNManagerRepository.ownerKey]
   803	        == .string(OwnedVPNManagerRepository.ownerValue)
   804	    else {
   805	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   806	    }
   807	    guard
   808	      case .integer(let managerVersion)? = configuration[
   809	        OwnedVPNManagerRepository.managerContractKey
   810	      ]
   811	    else {
   812	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   813	    }
   814	    guard managerVersion == OwnedVPNManagerRepository.managerContractVersion else {
   815	      throw SSHProfileSnapshotLoaderError.profileVersionUnsupported
   816	    }
   817	    guard
   818	      case .data(let data)? = configuration[
   819	        OwnedVPNManagerRepository.configurationReferenceKey
   820	      ]
   821	    else {
   822	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   823	    }
   824	    return [
   825	      OwnedVPNManagerRepository.ownerKey: OwnedVPNManagerRepository.ownerValue,
   826	      OwnedVPNManagerRepository.managerContractKey: NSNumber(
   827	        value: OwnedVPNManagerRepository.managerContractVersion
   828	      ),
   829	      OwnedVPNManagerRepository.configurationReferenceKey: data,
   830	    ]
   831	  }
   832	}
   833	
   834	/// A once-only, thread-safe capture for one provider runtime start.
   835	///
   836	/// Construct a fresh loader for each start. It never consults storage, performs
   837	/// credential work, or mutates a profile. Concurrent candidates race only for
   838	/// the first complete validated capture; all differing candidates fail closed.
   839	public final class SSHProfileRuntimeSnapshotLoader: @unchecked Sendable {
   840	  private struct Capture {
   841	    let data: Data
   842	    let snapshot: SSHProfileSnapshotV1
   843	  }
   844	
   845	  private let lock = NSLock()
   846	  private var capture: Capture?
   847	
   848	  public init() {}
   849	
   850	  public func capture(
   851	    from providerConfiguration: [String: VPNProviderConfigurationValue]?,
   852	    startRequest: RuntimeStartRequest? = nil
   853	  ) throws -> SSHProfileSnapshotV1 {
   854	    let candidate = try SSHProfileProviderConfigurationCodec.decodeCapture(
   855	      providerConfiguration
   856	    )
   857	    if let startRequest {
   858	      guard candidate.snapshot.configurationGeneration == startRequest.configurationGeneration,
   859	        SSHProfileSnapshotCodec.digestOfValidatedBytes(candidate.data)
   860	          == startRequest.snapshotDigestSHA256
   861	      else {
   862	        throw SSHProfileSnapshotLoaderError.profileGenerationMismatch
   863	      }
   864	    }
   865	
   866	    return try lock.withLock {
   867	      if let capture {
   868	        guard capture.data == candidate.data else {
   869	          throw SSHProfileSnapshotLoaderError.profileGenerationMismatch
   870	        }
   871	        return capture.snapshot
   872	      }
   873	      let immutableCapture = Capture(data: candidate.data, snapshot: candidate.snapshot)
   874	      capture = immutableCapture
   875	      return immutableCapture.snapshot
   876	    }
   877	  }
   878	}
