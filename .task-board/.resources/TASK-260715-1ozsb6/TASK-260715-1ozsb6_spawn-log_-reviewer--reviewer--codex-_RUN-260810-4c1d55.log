   795	  private func progress(until deadline: ContinuousClock.Instant, phase: SSHTransportPhase)
   796	    async throws
   797	  {
   798	    try checkCancellation(phase: phase)
   799	    let now = dependencies.clock.now()
   800	    guard now < deadline else { throw transportError(code: .timedOut, phase: phase) }
   801	    let remaining = now.duration(to: deadline)
   802	    if context.signatureIsPending() {
   803	      try await withTimeout(remaining, clock: dependencies.clock) {
