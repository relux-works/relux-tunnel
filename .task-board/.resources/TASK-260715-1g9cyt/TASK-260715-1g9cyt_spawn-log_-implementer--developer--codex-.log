+          {"library_identifier": "ios-arm64_x86_64-simulator", "platform": "ios", "variant": "simulator", "minimum": "15.0", "architectures": ["arm64", "x86_64"]},
+          {"library_identifier": "macos-arm64_x86_64", "platform": "macos", "minimum": "10.14", "architectures": ["arm64", "x86_64"]}
+        ]
+      },
+      "license": {
+        "components": [
+          {"name": "hev-socks5-tunnel", "spdx": "MIT", "path": "LICENSE"},
+          {"name": "hev-socks5-core", "spdx": "MIT", "path": "src/core/LICENSE"},
+          {"name": "hev-task-system", "spdx": "MIT", "path": "third-part/hev-task-system/LICENSE"},
+          {"name": "lwIP", "spdx": "BSD-3-Clause", "path": "third-part/lwip/LICENSE"},
+          {"name": "yaml", "spdx": "MIT", "path": "third-part/yaml/License"}
+        ],
+        "notices_output": "NativeDependencies/Generated/HEV_THIRD_PARTY_NOTICES.txt"
+      },
+      "rebuild": {
+        "command": "./scripts/native-dependency-tool.py build-hev --source-dir <pinned-recursive-checkout> --output NativeDependencies/Artifacts/HevSocks5Tunnel.xcframework --notices NativeDependencies/Generated/HEV_THIRD_PARTY_NOTICES.txt",
+        "upstream_command": "./build-apple.sh",
+        "xcode_build": "17F42"
+      }
+    }
+  }
+}
