  1037	      let now = dependencies.clock.now()
  1038	      guard now < deadline else { throw LibSSH2TimeoutError.elapsed }
  1039	      return try await withTimeout(now.duration(to: deadline), clock: dependencies.clock) {
  1040	        try await self.sessionOperationGate.acquire()
