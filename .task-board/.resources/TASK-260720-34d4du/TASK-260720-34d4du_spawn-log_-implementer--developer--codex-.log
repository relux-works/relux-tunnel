   146	    mutating func handle(keyExchange message: SSHMessage.KeyExchangeMessage) throws -> SSHMultiMessage? {
   147	        switch self.state {
   148	        case .keyExchangeSent(message: let ourMessage):
   149	            switch self.role {
   150	            case .client:
   151	                self.addKeyExchangeInitMessagesToExchangeBytes(clientsMessage: ourMessage, serversMessage: message)
   152	
   153	                // verify algorithms
   154	                let negotiated = try self.negotiatedAlgorithms(message)
   155	                let exchanger = try self.exchangerForAlgorithm(negotiated.negotiatedKeyExchangeAlgorithm)
   156	
   157	                // Ok, we need to send the key exchange message.
   158	                let message = SSHMessage.keyExchangeInit(
   159	                    exchanger.initiateKeyExchangeClientSide(allocator: self.allocator)
   160	                )
   161	                self.state = .awaitingKeyExchangeInit(exchange: exchanger, negotiated: negotiated)
   162	                return SSHMultiMessage(message)
   163	            case .server:
   164	                // Write their message in first, then ours.
   165	                self.addKeyExchangeInitMessagesToExchangeBytes(clientsMessage: message, serversMessage: ourMessage)
   166	
   167	                let negotiated = try self.negotiatedAlgorithms(message)
   168	                let exchanger = try self.exchangerForAlgorithm(negotiated.negotiatedKeyExchangeAlgorithm)
   169	
   170	                // Ok, we're waiting for them to go. They might be sending a wrong guess, which we want to ignore.
   171	                if self.expectingIncorrectGuess(message) {
   172	                    self.state = .awaitingKeyExchangeInitInvalidGuess(exchange: exchanger, negotiated: negotiated)
   173	                } else {
   174	                    self.state = .awaitingKeyExchangeInit(exchange: exchanger, negotiated: negotiated)
   175	                }
   176	                return nil
   177	            }
   178	        case .idle:
   179	            // We received a key exchange message while idle. We will need to send our own key exchange message back,
   180	            // and also follow immediately up with our own key exchange init message.
   370	            return protection
   371	        case .newKeysReceived(let result, let protection, _):
   372	            self.state = .complete(result: result)
   373	            return protection
   374	        case .idle, .keyExchangeSent, .keyExchangeReceived, .awaitingKeyExchangeInit,
   375	            .awaitingKeyExchangeInitInvalidGuess, .keyExchangeInitSent, .keyExchangeInitReceived, .newKeysSent,
   376	            .complete:
   377	            // This is a precondition not a throw because we control the sending of this message.
   378	            preconditionFailure("Cannot send ECDH key exchange message in state \(self.state)")
   379	        }
   380	    }
