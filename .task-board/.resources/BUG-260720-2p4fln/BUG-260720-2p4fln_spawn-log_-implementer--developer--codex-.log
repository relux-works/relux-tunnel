   371	private struct OwnedResourceSnapshot: Sendable, CustomStringConvertible {
   372	  let boundaryStarts: Int
   373	  let boundaryStops: Int
   374	  let liveSOCKSChannels: Int
   375	  let queuedPacketBatches: Int
   376	  let outstandingPacketReads: Int
   377	  let reachedHEVDescriptorClosed: Bool
   378	  let reachedBridgeDescriptorClosed: Bool
   379	  let cleanupCloseErrors: UInt64
   380	
   381	  var allReleased: Bool {
   382	    boundaryStarts == 1 && boundaryStops == 1 && liveSOCKSChannels == 0
   383	      && queuedPacketBatches == 0 && outstandingPacketReads == 0
   384	      && reachedHEVDescriptorClosed && reachedBridgeDescriptorClosed
   385	      && cleanupCloseErrors == 0
   386	  }
   387	
   388	  var description: String {
   389	    "boundary starts/stops=\(boundaryStarts)/\(boundaryStops), "
   390	      + "live SOCKS channels=\(liveSOCKSChannels), "
   391	      + "queued packet batches=\(queuedPacketBatches), "
   392	      + "outstanding packet reads=\(outstandingPacketReads), "
   393	      + "HEV/bridge descriptor-close stages="
   394	      + "\(reachedHEVDescriptorClosed)/\(reachedBridgeDescriptorClosed), "
   395	      + "cleanup close errors=\(cleanupCloseErrors)"
   396	  }
   397	}
