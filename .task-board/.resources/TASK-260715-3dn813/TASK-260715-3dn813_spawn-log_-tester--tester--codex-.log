+      })
+    fixture.readinessFactory.latest?.signal(.readable)
+    #expect(
+      await eventually {
+        let snapshot = await fixture.bridge.metrics()
+        return snapshot.counters["packet_bridge_reverse_receive_no_buffer_total"] == 1
