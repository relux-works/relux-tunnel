{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c637","stream":{"kind":"session","id":"01a0aa02-0e9f-7751-a41d-23a76571a699"},"sequence":374,"recorded_at":1780531400000743,"record_type":"event","durability":"durable","causation_id":"f9142673-9da0-4160-b580-0bb7491ba0d7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f9142673-9da0-4160-b580-0bb7491ba0d7","run_stream":{"kind":"run","id":"f9142673-9da0-4160-b580-0bb7491ba0d7"},"call_id":"call_01a0aa02d3f5704d9348ab660ed53ccb","text":"Read text file `/Users/iv/Developer/relux-tunnel/.task-board/.resources/BUG-260916-2764p8/BUG-260916-2764p8_change-request_rev2.patch`.\n(1246 line(s) above)\n1247|diff --git a/Sources/ReluxTunnelHarnessSupport/M1RuntimeCommand.swift b/Sources/ReluxTunnelHarnessSupport/M1RuntimeCommand.swift\n1248|new file mode 100644\n1249|index 0000000..d868eb7\n1250|--- /dev/null\n1251|+++ b/Sources/ReluxTunnelHarnessSupport/M1RuntimeCommand.swift\n1252|@@ -0,0 +1,1099 @@\n1253|+import Darwin\n1254|+import Foundation\n1255|+import ReluxTunnelCore\n1256|+\n1257|+public enum M1RuntimeHarnessScenario: String, CaseIterable, Sendable {\n1258|+  case success\n1259|+  case authenticationFailure = \"authentication-failure\"\n1260|+  case packetFailure = \"packet-failure\"\n1261|+  case dnsFailure = \"dns-failure\"\n1262|+  case routeApplyFailure = \"route-apply-failure\"\n1263|+  case midSessionSSHFailure = \"mid-session-ssh-failure\"\n1264|+  case midSessionDNSFailure = \"mid-session-dns-failure\"\n1265|+\n1266|+  fileprivate var isStartupFailure: Bool {\n1267|+    switch self {\n1268|+    case .authenticationFailure, .packetFailure, .dnsFailure, .routeApplyFailure:\n1269|+      true\n1270|+    case .success, .midSessionSSHFailure, .midSessionDNSFailure:\n1271|+      false\n1272|+    }\n1273|+  }\n1274|+\n1275|+  fileprivate var exitCode: HarnessExitCode {\n1276|+    switch self {\n1277|+    case .success:\n1278|+      .success\n1279|+    case .authenticationFailure:\n1280|+      .m1AuthenticationFailure\n1281|+    case .packetFailure:\n1282|+      .m1PacketFailure\n1283|+    case .dnsFailure:\n1284|+      .m1DNSFailure\n1285|+    case .routeApplyFailure:\n1286|+      .m1RouteApplyFailure\n1287|+    case .midSessionSSHFailure, .midSessionDNSFailure:\n1288|+      .m1MandatoryFailure\n1289|+    }\n1290|+  }\n1291|+}\n1292|+\n1293|+public enum M1RuntimeHarnessError: Error, Equatable, CustomStringConvertible,\n1294|+  HarnessExitCodeProvidingError\n1295|+{\n1296|+  case invalidFixture\n1297|+  case unsupportedScenario\n1298|+  case invalidRepetitionCount\n1299|+  case faultScenarioMustRunOnce\n1300|+  case sensitiveControlParameter\n1301|+  case profileReferenceMustBeSensitive\n1302|+  case missingDependencyRevision\n1303|+  case injected(M1RuntimeHarnessScenario)\n1304|+  case injectionNotObserved\n1305|+  case runtimeInvariant\n1306|+  case trafficInvariant\n1307|+  case diagnosticsInvariant\n1308|+  case resourceGrowth\n1309|+  case privacyInvariant\n1310|+  case hostLifetimeInvariant\n1311|+\n1312|+  public var harnessExitCode: HarnessExitCode {\n1313|+    switch self {\n1314|+    case .unsupportedScenario, .invalidRepetitionCount, .faultScenarioMustRunOnce,\n1315|+      .sensitiveControlParameter, .profileReferenceMustBeSensitive,\n1316|+      .missingDependencyRevision, .invalidFixture:\n1317|+      .usage\n1318|+    case .injected(let scenario):\n1319|+      scenario.exitCode\n1320|+    case .injectionNotObserved, .runtimeInvariant, .trafficInvariant,\n1321|+      .diagnosticsInvariant, .resourceGrowth, .privacyInvariant,\n1322|+      .hostLifetimeInvariant:\n1323|+      .failure\n1324|+    }\n1325|+  }\n1326|+\n1327|+  public var description: String {\n1328|+    switch self {\n1329|+    case .invalidFixture:\n1330|+      \"m1-runtime invalid fixture\"\n1331|+    case .unsupportedScenario:\n1332|+      \"m1-runtime unsupported scenario\"\n1333|+    case .invalidRepetitionCount:\n1334|+      \"m1-runtime repetitions must be in 1...8\"\n1335|+    case .faultScenarioMustRunOnce:\n1336|+      \"m1-runtime failure scenarios require repetitions=1\"\n1337|+    case .sensitiveControlParameter:\n1338|+      \"m1-runtime control parameters must be public\"\n1339|+    case .profileReferenceMustBeSensitive:\n1340|+      \"m1-runtime profile reference must be sensitive\"\n1341|+    case .missingDependencyRevision:\n1342|+      \"m1-runtime required dependency revision is missing\"\n1343|+    case .injected(let scenario):\n1344|+      \"m1-runtime injected \\(scenario.rawValue)\"\n1345|+    case .injectionNotObserved:\n1346|+      \"m1-runtime configured injection was not observed\"\n1347|+    case .runtimeInvariant:\n1348|+      \"m1-runtime lifecycle invariant failed\"\n1349|+    case .trafficInvariant:\n1350|+      \"m1-runtime traffic invariant failed\"\n1351|+    case .diagnosticsInvariant:\n1352|+      \"m1-runtime diagnostics invariant failed\"\n1353|+    case .resourceGrowth:\n1354|+      \"m1-runtime resource growth detected\"\n1355|+    case .privacyInvariant:\n1356|+      \"m1-runtime privacy invariant failed\"\n1357|+    case .hostLifetimeInvariant:\n1358|+      \"m1-runtime retained simulated host owner\"\n1359|+    }\n1360|+  }\n1361|+}\n1362|+\n1363|+public struct M1RuntimeHarnessCommand: HarnessCommand {\n1364|+  public static let maximumRepetitions = 8\n1365|+  public let name = \"m1-runtime\"\n1366|+\n1367|+  public init() {}\n1368|+\n1369|+  public func run(context: HarnessCommandContext) async throws {\n1370|+    let fixture = try M1HarnessFixture(configuration: context.configuration)\n1371|+    let sessionFactory = DeterministicHarnessSessionFactory { runtimeContext, generation in\n1372|+      guard let packetFlow = runtimeContext.packetFlow as? M1HarnessPacketFlow else {\n1373|+        throw M1RuntimeHarnessError.runtimeInvariant\n1374|+      }\n1375|+      let generationFixture = M1HarnessGeneration(\n1376|+        scenario: fixture.scenario,\n1377|+        generation: generation,\n1378|+        profileIdentifier: runtimeContext.configuration.profileReference.profileIdentifier,\n1379|+        packetFlow: packetFlow,\n1380|+        environment: runtimeContext.dependencies\n1381|+      )\n1382|+      fixture.registry.insert(generationFixture)\n1383|+      return generationFixture.dependencies()\n1384|+    }\n1385|+    for expectedGeneration in 1...fixture.repetitions {\n1386|+      var hostOwner: M1HarnessHostOwner? = M1HarnessHostOwner(\n1387|+        dependencies: context.dependencies,\n1388|+        sessionFactory: sessionFactory\n1389|+      )\n1390|+      weak var weakHostOwner = hostOwner\n1391|+\n1392|+      let runtime = try await hostOwner!.makeRuntime(\n1393|+        configuration: try context.configuration.tunnelConfiguration(),\n1394|+      )\n1395|+      guard\n1396|+        let coordinator = runtime as? TunnelRuntimeCoordinator,\n1397|+        coordinator.runtimeGeneration == UInt64(expectedGeneration),\n1398|+        let generationFixture = fixture.registry.generation(UInt64(expectedGeneration))\n1399|+      else {\n1400|+        throw M1RuntimeHarnessError.runtimeInvariant\n1401|+      }\n1402|+\n1403|+      do {\n1404|+        try await runtime.start()\n1405|+      } catch {\n1406|+        guard fixture.scenario.isStartupFailure,\n1407|+          generationFixture.injectionWasObserved()\n1408|+        else {\n1409|+          throw error\n1410|+        }\n1411|+        try await generationFixture.verifyAfterStop(runtime: runtime)\n1412|+        throw M1RuntimeHarnessError.injected(fixture.scenario)\n1413|+      }\n1414|+\n1415|+      guard !fixture.scenario.isStartupFailure else {\n1416|+        await runtime.stop(reason: .startupFailure)\n1417|+        throw M1RuntimeHarnessError.injectionNotObserved\n1418|+      }\n1419|+      try await generationFixture.verifyReady(runtime: runtime)\n1420|+\n1421|+      hostOwner = nil\n1422|+      guard weakHostOwner == nil else {\n1423|+        await runtime.stop(reason: .providerFailure)\n1424|+        throw M1RuntimeHarnessError.hostLifetimeInvariant\n1425|+      }\n1426|+\n1427|+      try await generationFixture.exchangeRepresentativeTraffic()\n1428|+      try generationFixture.requestAndVerifyDiagnostics()\n1429|+\n1430|+      switch fixture.scenario {\n1431|+      case .midSessionSSHFailure, .midSessionDNSFailure:\n1432|+        try await generationFixture.injectMandatoryLoss()\n1433|+        try await generationFixture.awaitMandatoryFailure(runtime: runtime)\n1434|+        await runtime.stop(reason: .providerFailure)\n1435|+        try await generationFixture.verifyAfterStop(runtime: runtime)\n1436|+        throw M1RuntimeHarnessError.injected(fixture.scenario)\n1437|+      case .success:\n1438|+        await runtime.stop(reason: .userInitiated)\n1439|+        try await generationFixture.verifyAfterStop(runtime: runtime)\n1440|+      case .authenticationFailure, .packetFailure, .dnsFailure, .routeApplyFailure:\n1441|+        throw M1RuntimeHarnessError.injectionNotObserved\n1442|+      }\n1443|+    }\n1444|+\n1445|+    let metrics = context.dependencies.runtime.metrics\n1446|+    await metrics.incrementCounter(\n1447|+      named: \"harness.m1.generations_total\",\n1448|+      by: UInt64(fixture.repetitions)\n1449|+    )\n1450|+    await metrics.incrementCounter(\n1451|+      named: \"harness.m1.tcp_fixture_exchanges_total\",\n1452|+      by: UInt64(fixture.repetitions)\n1453|+    )\n1454|+    await metrics.incrementCounter(\n1455|+      named: \"harness.m1.dns_fixture_exchanges_total\",\n1456|+      by: UInt64(fixture.repetitions)\n1457|+    )\n1458|+    for resource in [\"descriptor\", \"task\", \"channel\", \"socket\", \"native_runtime\"] {\n1459|+      await metrics.setGauge(named: \"harness.m1.\\(resource)_growth\", to: 0)\n1460|+    }\n1461|+    await metrics.setGauge(named: \"harness.m1.host_owner_retained\", to: 0)\n1462|+  }\n1463|+}\n1464|+\n1465|+public struct M1RuntimeHarnessPacketEndpointFactory: HarnessPacketEndpointFactory {\n1466|+  public init() {}\n1467|+\n1468|+  public func makePacketFlow() async throws -> any PacketFlow {\n1469|+    M1HarnessPacketFlow()\n1470|+  }\n1471|+}\n1472|+\n1473|+private let m1DNSFixtureEndpoint = TunnelEndpoint(host: \"192.0.2.53\", port: 53)\n1474|+private let m1TCPFixtureEndpoint = TunnelEndpoint(host: \"198.51.100.80\", port: 443)\n1475|+private let m1OriginatorFixtureEndpoint = TunnelEndpoint(host: \"192.0.2.2\", port: 49_152)\n1476|+private let m1TCPRequest = Data(\"GET /fixture HTTP/1.0\\r\\n\\r\\n\".utf8)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
