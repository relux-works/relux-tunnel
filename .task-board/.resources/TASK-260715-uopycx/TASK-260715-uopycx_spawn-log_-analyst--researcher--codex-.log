     9	
    10	#ifndef __HEV_TUNNEL_MACOS_H__
    11	#define __HEV_TUNNEL_MACOS_H__
    12	
    13	#include <sys/socket.h>
    14	
    15	static inline struct pbuf *
    16	hev_tunnel_read (int fd, int mtu, HevTaskIOYielder yielder, void *yielder_data)
    17	{
    18	    struct iovec iov[2];
    19	    struct pbuf *buf;
    20	    uint32_t type;
    21	    ssize_t s;
    22	
    23	    buf = pbuf_alloc (PBUF_RAW, mtu, PBUF_RAM);
    24	    if (!buf)
    25	        return NULL;
    26	
    27	    iov[0].iov_base = &type;
    28	    iov[0].iov_len = sizeof (type);
    29	    iov[1].iov_base = buf->payload;
    30	    iov[1].iov_len = buf->len;
    31	
    32	    s = hev_task_io_readv (fd, iov, 2, yielder, yielder_data);
    33	    if (s <= (ssize_t)sizeof (type)) {
    34	        pbuf_free (buf);
    35	        return NULL;
    36	    }
    37	
    38	    buf->tot_len = s - sizeof (type);
    39	    buf->len = s - sizeof (type);
    40	
    41	    return buf;
    42	}
    43	
    44	static inline ssize_t
    45	hev_tunnel_write (int fd, struct pbuf *buf)
    46	{
    47	    struct iovec iov[512];
    48	    struct pbuf *p = buf;
    49	    uint32_t type = 0;
    50	    ssize_t res;
    51	    int i;
    52	
    53	    iov[0].iov_base = &type;
    54	    iov[0].iov_len = sizeof (type);
    55	
    56	    for (i = 1; p && (i < 512); p = p->next) {
    57	        iov[i].iov_base = p->payload;
    58	        iov[i].iov_len = p->len;
    59	        i++;
    60	
    61	        if (!type && p->len) {
    62	            if (((*(uint8_t *)p->payload >> 4) & 0xF) == 4)
    63	                type = htonl (AF_INET);
    64	            else
    65	                type = htonl (AF_INET6);
    66	        }
    67	    }
    68	
    69	    res = writev (fd, iov, i);
    70	    if (res <= (ssize_t)sizeof (type))
    71	        return -1;
    72	
    73	    return res;
    74	}
    75	
    76	#endif /* __HEV_TUNNEL_MACOS_H__ */
