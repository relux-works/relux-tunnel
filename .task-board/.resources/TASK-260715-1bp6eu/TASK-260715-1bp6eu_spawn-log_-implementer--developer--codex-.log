+    let response: Data
+    do {
+      switch command.kind {
+      case .getProtocolCapabilities:
+        response = try RuntimeMessageCodec.encode(
+          RuntimeProtocolCapabilitiesSnapshot(
+            requestID: requestID,
+            kinds: Self.readOnlyCapabilities
