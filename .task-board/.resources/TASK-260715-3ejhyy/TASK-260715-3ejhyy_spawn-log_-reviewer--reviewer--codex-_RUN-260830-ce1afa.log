   247	/// Creates exactly one coordinator object for each monotonically increasing
   248	/// provider runtime generation.
   249	public actor TunnelRuntimeCoordinatorFactory: TunnelRuntimeFactory {
   250	  private let coordinatorDependencies: TunnelRuntimeCoordinatorDependencies
   251	  private var latestGeneration: UInt64
   252	
   253	  public init(
   254	    dependencies: TunnelRuntimeCoordinatorDependencies,
   255	    initialGeneration: UInt64 = 0
   256	  ) {
   257	    coordinatorDependencies = dependencies
   258	    latestGeneration = initialGeneration
   259	  }
   260	
   261	  public func makeRuntime(context: TunnelRuntimeContext) throws -> any TunnelRuntime {
   262	    guard latestGeneration < UInt64.max else {
   263	      throw TunnelRuntimeCoordinatorError.generationExhausted
   264	    }
   265	    latestGeneration += 1
   266	    return TunnelRuntimeCoordinator(
   267	      runtimeGeneration: latestGeneration,
   268	      context: context,
   269	      dependencies: coordinatorDependencies
   270	    )
   271	  }
