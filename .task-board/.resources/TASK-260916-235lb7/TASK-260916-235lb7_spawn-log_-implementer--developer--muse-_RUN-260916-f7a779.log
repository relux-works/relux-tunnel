     fetch-depth: 0\\n          persist-credentials: false\\n          path: relux-proxy\\n\\n      - uses: jdx/mise-action@3c2e0cf82a5b2e5249f0d3635a4d83d0ae861518 # v4.2.5\\n        with:\\n          version: 2026.3.10\\n          sha256: c7a0eb1035de974b42d36b69c4b55b836c06b455b990dd6ac530aaf05d4a8a17 # mise-v2026.3.10-macos-arm64\\n          install: false\\n          cache: false\\n\\n      - name: Run the local credential-free gate\\n        working-directory: relux-tunnel\\n        run: make credential-free-validate LEGACY_ROOT=\\\"$GITHUB_WORKSPACE/relux-proxy\\\"\\n\\n      - name: Upload privacy-safe validation evidence\\n        if: always()\\n        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\\n        with:\\n          name: credential-free-generated-project-${{ github.run_id }}\\n          path: |\\n            relux-tunnel/.temp/TASK-260715-sbrrp7/credential-free-validation/summary.log\\n            relux-tunnel/.temp/TASK-260715-sbrrp7/credential-free-validation/environment.log\\n            relux-tunnel/.temp/TASK-260715-sbrrp7/credential-free-validation/logs\\n          if-no-files-found: error\\n          retention-days: 14\\n\\n  validate:\\n    name: board + spec validation\\n    runs-on: ubuntu-latest\\n===MAKEFILE TOOLCHAIN PINS===\\n\",\n  \"original_output_bytes\": 2012,\n  \"original_output_tokens\": 503,\n  \"truncated\": false\n}","final_result":true}}}
