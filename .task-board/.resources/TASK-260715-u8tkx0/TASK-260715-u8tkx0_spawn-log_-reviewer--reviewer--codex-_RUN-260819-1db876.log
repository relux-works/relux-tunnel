   127	class AssetManifestError(RuntimeError):
   128	    pass
   129	
   130	
   131	class BundlePublicationMode(Enum):
   132	    INITIAL_NO_REPLACE = "initial-no-replace"
   133	    REPLACE_EXISTING = "replace-existing"
   134	
   135	
   136	@dataclass(frozen=True)
   137	class BundlePublicationIntent:
   138	    mode: BundlePublicationMode
   139	    existing_identity: tuple[int, int] | None = None
   140	
   141	    def __post_init__(self) -> None:
   142	        if self.mode is BundlePublicationMode.INITIAL_NO_REPLACE:
   143	            if self.existing_identity is not None:
   144	                raise ValueError("initial publication cannot have an existing identity")
   145	        elif self.existing_identity is None:
   146	            raise ValueError("replacement publication requires an existing identity")
   147	
   148	
   149	def stable_json(value: Any) -> bytes:
   150	    return (
   151	        json.dumps(value, ensure_ascii=True, separators=(",", ":"), sort_keys=True)
   152	        + "\n"
   153	    ).encode("ascii")
   154	
   155	
   156	def sha256_bytes(contents: bytes) -> str:
   157	    return hashlib.sha256(contents).hexdigest()
   158	
   159	
   160	def sha256_stream(stream: Any) -> str:
   161	    digest = hashlib.sha256()
   162	    for chunk in iter(lambda: stream.read(READ_CHUNK_BYTES), b""):
   163	        digest.update(chunk)
   164	    return digest.hexdigest()
   165	
   166	
   167	def close_descriptor_after_fdopen_failure(descriptor: int) -> None:
   168	    try:
   169	        os.close(descriptor)
   170	    except OSError:
   171	        # Some file-object implementations may consume the descriptor before
   172	        # reporting an initialization failure. Either way, ownership ends here.
   173	        pass
   174	
   175	
   176	def sha256_file(path: Path) -> str:
   177	    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
   178	    no_follow = getattr(os, "O_NOFOLLOW", None)
   179	    if no_follow is None:
   180	        raise AssetManifestError("trusted relay input no-follow reads are unavailable")
   181	    descriptor: int | None = None
   182	    try:
   183	        descriptor = os.open(path, flags | no_follow)
   184	        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
   185	            raise AssetManifestError("trusted relay input is not a regular file")
   186	        try:
   187	            stream = os.fdopen(descriptor, "rb")
   188	        except BaseException:
   189	            close_descriptor_after_fdopen_failure(descriptor)
   190	            descriptor = None
   191	            raise
   192	        descriptor = None
   193	        with stream:
   194	            return sha256_stream(stream)
   195	    except OSError as error:
   196	        raise AssetManifestError("trusted relay input is unavailable") from error
   197	    finally:
   198	        if descriptor is not None:
   199	            os.close(descriptor)
   200	
   201	
   202	def read_bounded_descriptor(
   203	    descriptor: int, *, label: str, maximum_size: int, expected_size: int | None = None
   204	) -> bytes:
   205	    try:
   206	        status = os.fstat(descriptor)
   207	        if not stat.S_ISREG(status.st_mode):
   208	            raise AssetManifestError(f"{label} is not a regular file")
   209	        if status.st_size > maximum_size:
   210	            raise AssetManifestError(f"{label} exceeds its size limit")
   211	        if expected_size is not None and status.st_size != expected_size:
   212	            raise AssetManifestError(f"{label} size does not match the manifest")
   213	
   214	        chunks: list[bytes] = []
   215	        total = 0
   216	        while True:
   217	            chunk = os.read(descriptor, min(READ_CHUNK_BYTES, maximum_size + 1 - total))
   218	            if not chunk:
   219	                break
   220	            total += len(chunk)

