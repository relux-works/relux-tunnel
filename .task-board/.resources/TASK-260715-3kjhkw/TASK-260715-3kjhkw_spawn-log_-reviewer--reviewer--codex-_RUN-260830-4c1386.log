   363	private func observed(_ disposition: MemoryObservationDisposition) throws -> MemoryObservation {
   364	  guard case .observed(let observation) = disposition else {
   365	    Issue.record("Expected an accepted observation")
   366	    throw MemoryWatermarkTestError.rateLimited
   367	  }
   368	  return observation
