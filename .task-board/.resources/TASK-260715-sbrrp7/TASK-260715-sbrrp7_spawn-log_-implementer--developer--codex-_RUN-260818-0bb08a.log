+    echo "error: provider entitlement file must not install system extensions: $entitlements" >&2
+    exit 1
+  fi
+done
+
+for scheme in ReluxProxyMac ReluxProxyMacTunnel; do
+  xcodebuild \
+    -workspace ReluxTunnel.xcworkspace \
