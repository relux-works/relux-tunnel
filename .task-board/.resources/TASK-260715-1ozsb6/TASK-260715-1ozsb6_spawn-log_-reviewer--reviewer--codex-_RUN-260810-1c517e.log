   668	      let explicitDeadline = now.advanced(by: configuration.timeouts.explicitRekey)
   669	      let rekeyDeadline = now.advanced(by: configuration.rekey.timeout)
   670	      let deadline = min(explicitDeadline, rekeyDeadline)
