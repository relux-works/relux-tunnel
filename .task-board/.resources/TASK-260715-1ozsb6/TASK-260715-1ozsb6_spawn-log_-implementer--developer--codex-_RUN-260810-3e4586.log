+private final class RetainedOwnedOperation: LibSSH2OwnedAsyncOperation, @unchecked Sendable {
+  let identifier = UUID()
+
+  private let lock = NSLock()
+  private var cancellations = 0
+
+  var cancelCount: Int { lock.withLock { cancellations } }
