    if directions & LIBSSH2_SESSION_BLOCK_INBOUND != 0 { interests.insert(.readable) }
    if directions & LIBSSH2_SESSION_BLOCK_OUTBOUND != 0 { interests.insert(.writable) }
    if interests.isEmpty { interests = [.readable, .writable] }
