  1898	  private func execSignalName(_ value: String) -> SSHExecSignalName {
  1899	    switch value.uppercased() {
  1900	    case "HUP": .hangup
  1901	    case "INT": .interrupt
  1902	    case "QUIT": .quit
  1903	    case "ILL": .illegalInstruction
  1904	    case "ABRT": .abort
  1905	    case "FPE": .floatingPointException
  1906	    case "KILL": .kill
  1907	    case "SEGV": .segmentationFault
  1908	    case "PIPE": .pipe
  1909	    case "ALRM": .alarm
  1910	    case "TERM": .terminate
  1911	    default: .other(value)
  1912	    }
  1913	  }
