   841	  private func publishCurrentState() async {
   842	    guard let sequence = nextSnapshotSequence else { return }
   843	    nextSnapshotSequence = sequence == UInt64.max ? nil : sequence + 1
   844	
   845	    let lifecycleState = lifecycleState()
   846	    let routesInstalled = settingsState.routesInstalled
   847	    let routeState: RuntimeRouteState
   848	    switch settingsState {
   849	    case .notRequested:
   850	      routeState = .notInstalled
   851	    case .uncertain, .committed:
   852	      routeState = .installed
   853	    case .clearFailed:
   854	      routeState = .clearFailed
   855	    }
   856	    let usable = state == .usableTCPDNS
   857	    let healthy = usable
   858	    let error = state == .failed ? primaryFailure : nil
   859	
   860	    let lifecycle = RuntimeLifecycleSnapshot(
   861	      runtimeGeneration: runtimeGeneration,
   862	      snapshotSequence: sequence,
   863	      lifecycleState: lifecycleState,
   864	      routeState: routeState,
   865	      tcp: usable,
   866	      safeDNS: usable,
   867	      udp: false,
   868	      routeMode: .compatible,
   869	      routesInstalled: routesInstalled,
   870	      healthy: healthy,
   871	      error: error
   872	    )
   873	    let capabilities = RuntimeCapabilitySnapshot(
   874	      runtimeGeneration: runtimeGeneration,
   875	      snapshotSequence: sequence,
   876	      tcp: usable,
   877	      safeDNS: usable,
   878	      udp: false,
   879	      routeMode: .compatible,
   880	      routesInstalled: routesInstalled,
   881	      healthy: healthy
   882	    )
   883	    let snapshot = TunnelRuntimePublishedSnapshot(
   884	      lifecycle: lifecycle,
   885	      capabilities: capabilities
   886	    )
   887	    lastSnapshot = snapshot
   888	    await dependencies.snapshotStore.publish(snapshot)
   889	  }
