{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c579","stream":{"kind":"session","id":"01a0a9b7-1be4-70c3-9f65-33dc9d5961ad"},"sequence":279,"recorded_at":1780531400000553,"record_type":"event","durability":"durable","causation_id":"f764a614-f959-4acf-aa23-1fc534b9bf47","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f764a614-f959-4acf-aa23-1fc534b9bf47","run_stream":{"kind":"run","id":"f764a614-f959-4acf-aa23-1fc534b9bf47"},"task_stream":{"kind":"task","id":"01a0a9b7-f51c-77d2-86fd-3fb7db2ce3cd"},"task_id":"01a0a9b7-f51c-77d2-86fd-3fb7db2ce3cd","event":{"kind":"output","task_id":"01a0a9b7-f51c-77d2-86fd-3fb7db2ce3cd","chunk":"Read text file `Tests/ReluxTunnelCoreTests/MacOSSystemKeychainCredentialResolverTests.swift`.\n1|import CryptoKit\n2|import Foundation\n3|import Network\n4|import ReluxTunnelCore\n5|import Security\n6|import Testing\n7|\n8|@testable import ReluxTunnelMacOSAdapter\n9|\n10|@Suite(\"macOS system-domain Keychain credential resolver\")\n11|struct MacOSSystemKeychainCredentialResolverTests {\n12|  @Test(\"exact opaque reference and fixed service shape the only lookup\")\n13|  func exactQueryShapeAndSuccess() async throws {\n14|    let reference = UUID(uuidString: \"aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa\")!\n15|    let handle = fixtureKeychainHandle()\n16|    let security = FixtureSystemKeychainClient(\n17|      keychain: handle,\n18|      item: fixtureItem(reference: reference, generation: 7, format: 1)\n19|    )\n20|    let provider = MacOSProviderSSHConfiguration.makeCredentialProvider(\n21|      securityClient: security,\n22|      formatRegistry: FixtureFormatRegistry()\n23|    )\n24|\n25|    let credential = try await provider.credential(for: try request(reference, generation: 7))\n26|    #expect(credential.algorithm == \"ssh-ed25519\")\n27|    #expect(try await credential.sign(Data([1, 2, 3])) == Data([3, 2, 1]))\n28|\n29|    let query = try #require(await security.recordedQuery())\n30|    let dictionary = query.dictionary\n31|    #expect(query.keychain === handle)\n32|    #expect(query.service == MacOSSystemKeychainCredentialResolver.service)\n33|    #expect(query.account == reference.uuidString.lowercased())\n34|    #expect(dictionary[kSecClass as String] as? String == kSecClassGenericPassword as String)\n35|    #expect(dictionary[kSecAttrService as String] as? String == Self.service)\n36|    #expect(dictionary[kSecAttrAccount as String] as? String == reference.uuidString.lowercased())\n37|    #expect(dictionary[kSecUseDataProtectionKeychain as String] as? Bool == false)\n38|    #expect((dictionary[kSecMatchSearchList as String] as? [AnyObject])?.count == 1)\n39|    #expect(dictionary[kSecMatchLimit as String] as? String == kSecMatchLimitOne as String)\n40|    #expect(dictionary[kSecReturnAttributes as String] as? Bool == true)\n41|    #expect(dictionary[kSecReturnData as String] as? Bool == true)\n42|    #expect(dictionary[kSecUseKeychain as String] == nil)\n43|    #expect(dictionary[kSecAttrAccessGroup as String] == nil)\n44|    #expect(dictionary[kSecAttrAccessible as String] == nil)\n45|    #expect(Set(dictionary.keys) == Self.expectedQueryKeys)\n46|  }\n47|\n48|  @Test(\"wrong class and mismatched identity fail distinctly\")\n49|  func identityAndClassValidation() async throws {\n50|    let reference = UUID(uuidString: \"bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb\")!\n51|    let handle = fixtureKeychainHandle()\n52|\n53|    let wrongClass = FixtureSystemKeychainClient(\n54|      keychain: handle,\n55|      item: fixtureItem(\n56|        reference: reference,\n57|        generation: 2,\n58|        itemClass: kSecClassInternetPassword as String\n59|      )\n60|    )\n61|    await #expect(throws: MacOSCredentialResolverError.credentialWrongClass) {\n62|      try await resolver(security: wrongClass).credential(for: request(reference, generation: 2))\n63|    }\n64|\n65|    let wrongIdentity = FixtureSystemKeychainClient(\n66|      keychain: handle,\n67|      item: fixtureItem(reference: reference, generation: 2, account: \"not-the-reference\")\n68|    )\n69|    await #expect(throws: MacOSCredentialResolverError.credentialMalformed) {\n70|      try await resolver(security: wrongIdentity).credential(for: request(reference, generation: 2))\n71|    }\n72|  }\n73|\n74|  @Test(\"not found inaccessible malformed and platform cancellation remain distinct\")\n75|  func statusMapping() async throws {\n76|    let reference = UUID(uuidString: \"cccccccc-cccc-cccc-cccc-cccccccccccc\")!\n77|    let handle = fixtureKeychainHandle()\n78|    let cases: [(OSStatus, MacOSCredentialResolverError)] = [\n79|      (errSecItemNotFound, .credentialNotProvisioned),\n80|      (errSecAuthFailed, .credentialAccessDenied),\n81|      (errSecDecode, .credentialMalformed),\n82|      (errSecUserCanceled, .operationCancelled),\n83|    ]\n84|\n85|    for (status, expected) in cases {\n86|      let security = FixtureSystemKeychainClient(keychain: handle, status: status)\n87|      await #expect(throws: expected) {\n88|        try await resolver(security: security).credential(\n89|          for: request(reference, generation: 1)\n90|        )\n91|      }\n92|    }\n93|  }\n94|\n95|  @Test(\"OSStatus bootstrap projection is stable and contains no platform status\")\n96|  func osStatusBootstrapProjection() {\n97|    let cases: [(OSStatus, Bool, SSHBootstrapErrorCode, SSHBootstrapRetryDisposition)] = [\n98|      (errSecItemNotFound, true, .credentialNotProvisioned, .terminal),\n99|      (errSecAuthFailed, true, .credentialAccessDenied, .terminal),\n100|      (errSecDecode, true, .credentialMalformed, .terminal),\n101|      (errSecUserCanceled, true, .operationCancelled, .cancelled),\n102|    ]\n103|\n104|    for (status, itemLookup, code, retry) in cases {\n105|      let error = MacOSSSHBootstrapErrorMapper.credential(\n106|        status: status,\n107|        itemLookup: itemLookup,\n108|        configurationGeneration: 12\n109|      )\n110|      #expect(error.diagnostic.code == code)\n111|      #expect(error.diagnostic.retryDisposition == retry)\n112|      #expect(error.diagnostic.configurationGeneration == 12)\n113|      #expect(\n114|        !(error as NSError).userInfo.values.contains { String(describing: $0) == \"\\(status)\" })\n115|    }\n116|  }\n117|\n118|  @Test(\"every credential resolver error has one bounded bootstrap projection\")\n119|  func credentialBootstrapProjectionCoverage() {\n120|    let cases: [(MacOSCredentialResolverError, SSHBootstrapErrorCode)] = [\n121|      (.credentialNotProvisioned, .credentialNotProvisioned),\n122|      (.credentialAccessDenied, .credentialAccessDenied),\n123|      (.credentialWrongClass, .credentialMalformed),\n124|      (.credentialGenerationMismatch, .credentialGenerationMismatch),\n125|      (.credentialMalformed, .credentialMalformed),\n126|      (.credentialPassphraseRequired, .credentialPassphraseRequired),\n127|      (.credentialPassphraseInvalid, .credentialPassphraseInvalid),\n128|      (.credentialKeyUnsupported, .credentialKeyUnsupported),\n129|      (.operationCancelled, .operationCancelled),\n130|    ]\n131|\n132|    #expect(Set(cases.map(\\.0)) == Set(MacOSCredentialResolverError.allCases))\n133|    for (source, expectedCode) in cases {\n134|      let error = MacOSSSHBootstrapErrorMapper.credential(\n135|        source,\n136|        configurationGeneration: 13\n137|      )\n138|      #expect(error.diagnostic.code == expectedCode)\n139|      #expect(error.diagnostic.configurationGeneration == 13)\n140|      #expect(\n141|        error.diagnostic.retryDisposition\n142|          == (source == .operationCancelled ? .cancelled : .terminal)\n143|      )\n144|    }\n145|  }\n146|\n147|  @Test(\"NW and POSIX classes map without endpoint or underlying prose\")\n148|  func networkFrameworkBootstrapProjection() {\n149|    let context = SSHBootstrapDiagnosticContext(endpointFamily: .ipv6)\n150|    let unavailable = MacOSSSHBootstrapErrorMapper.network(\n151|      NWError.posix(.ENETUNREACH),\n152|      stage: .physicalPathResolution,\n153|      configurationGeneration: 5,\n154|      context: context\n155|    )\n156|    let reset = MacOSSSHBootstrapErrorMapper.network(\n157|      NWError.posix(.ECONNRESET),\n158|      stage: .endpointConnect,\n159|      configurationGeneration: 5,\n160|      context: context\n161|    )\n162|    let dns = MacOSSSHBootstrapErrorMapper.network(\n163|      NWError.dns(-65_537),\n164|      stage: .endpointConnect,\n165|      configurationGeneration: 5,\n166|      context: context\n167|    )\n168|    let tls = MacOSSSHBootstrapErrorMapper.network(\n169|      NWError.tls(-9_800),\n170|      stage: .algorithmNegotiation,\n171|      configurationGeneration: 5,\n172|      context: context\n173|    )\n174|\n175|    #expect(unavailable.diagnostic.code == .pathUnavailable)\n176|    #expect(unavailable.diagnostic.retryDisposition == .retryableLater)\n177|    #expect(reset.diagnostic.code == .endpointConnectFailed)\n178|    #expect(reset.diagnostic.retryDisposition == .retryableLater)\n179|    #expect(reset.diagnostic.context.endpointFamily == .ipv6)\n180|    #expect(dns.diagnostic.code == .endpointConnectFailed)\n181|    #expect(dns.diagnostic.retryDisposition == .retryableLater)\n182|    #expect(tls.diagnostic.code == .negotiationFailed)\n183|    #expect(tls.diagnostic.retryDisposition == .terminal)\n184|  }\n185|\n186|  @Test(\"record generation digest truncation and trailing bytes fail closed\")\n187|  func strictRecordFormat() async throws {\n188|    let reference = UUID(uuidString: \"dddddddd-dddd-dddd-dddd-dddddddddddd\")!\n189|    let handle = fixtureKeychainHandle()\n190|    var records = [\n191|      credentialRecord(reference: reference, generation: 7, format: 1),\n192|      credentialRecord(reference: reference, generation: 7, format: 1) + [0],\n193|    ]\n194|    records[0][records[0].count - 1] ^= 0xFF\n195|\n196|    for record in records {\n197|      let security = FixtureSystemKeychainClient(\n198|        keychain: handle,\n199|        item: fixtureItem(reference: reference, generation: 7, data: record)\n200|      )\n201|      await #expect(throws: MacOSCredentialResolverError.credentialMalformed) {\n202|        try await resolver(security: security).credential(\n203|          for: request(reference, generation: 7)\n204|        )\n205|      }\n206|    }\n207|\n208|    let generationMismatch = FixtureSystemKeychainClient(\n209|      keychain: handle,\n210|      item: fixtureItem(reference: reference, generation: 8)\n211|    )\n212|    await #expect(throws: MacOSCredentialResolverError.credentialGenerationMismatch) {\n213|      try await resolver(security: generationMismatch).credential(\n214|        for: request(reference, generation: 7)\n215|      )\n216|    }\n217|  }\n218|\n219|  @Test(\n220|    \"imported and generated registry representations produce libssh2 credentials\",\n221|    arguments: [UInt16(1), UInt16(2)]\n222|  )\n223|  func importedAndGeneratedRepresentations(format: UInt16) async throws {\n224|    let reference = UUID(uuidString: \"eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee\")!\n225|    let security = FixtureSystemKeychainClient(\n226|      keychain: fixtureKeychainHandle(),\n227|      item: fixtureItem(reference: reference, generation: 3, format: format)\n228|    )\n229|    let credential = try await resolver(security: security).credential(\n230|      for: request(reference, generation: 3)\n231|    )\n232|    #expect([\"ssh-ed25519\", \"ecdsa-sha2-nistp256\"].contains(credential.algorithm))\n233|  }\n234|\n235|  @Test(\n236|    \"optional passphrase preserves absent empty and present states\",\n237|    arguments: [\n238|      PassphraseCase(bytes: nil, expectedCount: nil, label: \"absent\"),\n239|      PassphraseCase(bytes: [], expectedCount: 0, label: \"empty\"),\n240|      PassphraseCase(bytes: [7, 8], expectedCount: 2, label: \"present\"),\n241|    ]\n242|  )\n243|  func optionalPassphrase(testCase: PassphraseCase) async throws {\n244|    let reference = UUID(uuidString: \"abababab-abab-abab-abab-abababababab\")!\n245|    let registry = PassphraseObservingRegistry()\n246|    let security = FixtureSystemKeychainClient(\n247|      keychain: fixtureKeychainHandle(),\n248|      item: fixtureItem(\n249|        reference: reference,\n250|        generation: 9,\n251|        passphrase: testCase.bytes\n252|      )\n253|    )\n254|    _ = try await MacOSSystemKeychainCredentialResolver(\n255|      securityClient: security,\n256|      formatRegistry: registry\n257|    ).credential(for: request(reference, generation: 9))\n258|    #expect(registry.observedCount == testCase.expectedCount)\n259|  }\n260|\n261|  @Test(\n262|    \"passphrase and key-format outcomes stay stable\",\n263|    arguments: [\n264|      FormatFailureCase(error: .passphraseRequired, expected: .credentialPassphraseRequired),\n265|      FormatFailureCase(error: .passphraseInvalid, expected: .credentialPassphraseInvalid),\n266|      FormatFailureCase(error: .unsupportedKey, expected: .credentialKeyUnsupported),\n267|      FormatFailureCase(error: .malformed, expected: .credentialMalformed),\n268|    ]\n269|  )\n270|  func formatErrors(testCase: FormatFailureCase) async throws {\n271|    let reference = UUID(uuidString: \"ffffffff-ffff-ffff-ffff-ffffffffffff\")!\n272|    let security = FixtureSystemKeychainClient(\n273|      keychain: fixtureKeychainHandle(),\n274|      item: fixtureItem(reference: reference, generation: 4, format: 9, passphrase: [4, 5])\n275|    )\n276|    await #expect(throws: testCase.expected) {\n277|      try await MacOSSystemKeychainCredentialResolver(\n278|        securityClient: security,\n279|        formatRegistry: FixtureFormatRegistry(failure: testCase.error)\n280|      ).credential(for: request(reference, generation: 4))\n281|    }\n282|  }\n283|\n284|  @Test(\"cancellation after a Security call clears and releases returned bytes\")\n285|  func cancellationClearsReturnedSecret() async throws {\n286|    let reference = UUID(uuidString: \"11111111-2222-3333-4444-555555555555\")!\n287|    let lifecycle = SecretLifecycleProbe()\n288|    let gate = ResolverTestGate()\n289|    let item = fixtureItem(\n290|      reference: reference,\n291|      generation: 5,\n292|      observer: lifecycle\n293|    )\n294|    let security = FixtureSystemKeychainClient(\n295|      keychain: fixtureKeychainHandle(),\n296|      item: item,\n297|      gate: gate\n298|    )\n299|    let candidate = MacOSSystemKeychainCredentialResolver(\n300|      securityClient: security,\n301|      formatRegistry: FixtureFormatRegistry(),\n302|      lifecycleObserver: lifecycle\n303|    )\n304|    let task = Task {\n305|      try await candidate.credential(for: request(reference, generation: 5))\n306|    }\n307|    await gate.waitUntilEntered()\n308|    task.cancel()\n309|    await gate.open()\n310|\n311|    await #expect(throws: MacOSCredentialResolverError.operationCancelled) {\n312|      try await task.value\n313|    }\n314|    #expect(lifecycle.activeSecretCount == 0)\n315|    #expect(lifecycle.clearedSecretCount == 1)\n316|    #expect(item.secretData.count == 0)\n317|  }\n318|\n319|  @Test(\"decoded buffers clear before return and signer retirement releases parsed state\")\n320|  func boundedCredentialLifetime() async throws {\n321|    let reference = UUID(uuidString: \"22222222-3333-4444-5555-666666666666\")!\n322|    let lifecycle = SecretLifecycleProbe()\n323|    let retirement = RetirementProbe()\n324|    let security = FixtureSystemKeychainClient(\n325|      keychain: fixtureKeychainHandle(),\n326|      item: fixtureItem(reference: reference, generation: 10, passphrase: [1])\n327|    )\n328|    let credential = try await MacOSSystemKeychainCredentialResolver(\n329|      securityClient: security,\n330|      formatRegistry: RetiringFormatRegistry(probe: retirement),\n331|      lifecycleObserver: lifecycle\n332|    ).credential(for: request(reference, generation: 10))\n333|\n334|    #expect(lifecycle.activeSecretCount == 0)\n335|    #expect(lifecycle.clearedSecretCount == 2)\n336|    #expect(!retirement.isRetired)\n337|    credential.retire()\n338|    #expect(retirement.isRetired)\n339|  }\n340|\n341|  @Test(\"errors and credential reflection are redacted\")\n342|  func redaction() async throws {\n343|    let referenceText = \"99999999-8888-7777-6666-555555555555\"\n344|    let reference = UUID(uuidString: referenceText)!\n345|    let marker = \"fixture-sensitive-marker\"\n346|    let security = FixtureSystemKeychainClient(\n347|      keychain: fixtureKeychainHandle(),\n348|      item: fixtureItem(\n349|        reference: reference,\n350|        generation: 1,\n351|        data: Array(marker.utf8)\n352|      )\n353|    )\n354|    let error = await #expect(throws: MacOSCredentialResolverError.self) {\n355|      try await resolver(security: security).credential(for: request(reference, generation: 1))\n356|    }\n357|    let rendered = String(describing: error)\n358|    #expect(!rendered.contains(referenceText))\n359|    #expect(!rendered.contains(marker))\n360|\n361|    let success = FixtureSystemKeychainClient(\n362|      keychain: fixtureKeychainHandle(),\n363|      item: fixtureItem(reference: reference, generation: 1)\n364|    )\n365|    let credential = try await resolver(security: success).credential(\n366|      for: request(reference, generation: 1)\n367|    )\n368|    let reflected = String(reflecting: credential)\n369|    #expect(reflected.contains(\"redacted\"))\n370|    #expect(!reflected.contains(referenceText))\n371|    #expect(!reflected.contains(marker))\n372|  }\n373|\n374|  @Test(\"one fake-only scoped query performs no enumeration or fallback\")\n375|  func scopedQueryHasNoEnumerationOrFallback() async throws {\n376|    let reference = UUID(uuidString: \"12345678-1234-1234-1234-123456789abc\")!\n377|    let handle = fixtureKeychainHandle()\n378|    let security = FixtureSystemKeychainClient(\n379|      keychain: handle,\n380|      status: errSecItemNotFound\n381|    )\n382|    await #expect(throws: MacOSCredentialResolverError.credentialNotProvisioned) {\n383|      try await resolver(security: security).credential(\n384|        for: request(reference, generation: 6)\n385|      )\n386|    }\n387|    #expect(await security.domainResolutionCount() == 1)\n388|    #expect(await security.matchingQueryCount() == 1)\n389|    let query = try #require(await security.recordedQuery())\n390|    #expect(query.keychain === handle)\n391|    #expect(query.account == reference.uuidString.lowercased())\n392|    #expect(query.service == Self.service)\n393|  }\n394|\n395|  @Test(\"live client rejects fixture query before the Security matcher\")\n396|  func liveClientRejectsFixtureBeforeMatcher() async throws {\n397|    let matcher = SecurityMatcherSpy()\n398|    let client = LiveMacOSSystemKeychainSecurityClient(\n399|      domainResolver: {\n400|        MacOSSystemKeychainResolution(\n401|          status: errSecSuccess,\n402|          keychain: fixtureKeychainHandle()\n403|        )\n404|      },\n405|      itemMatcher: matcher.copyMatching\n406|    )\n407|\n408|    await #expect(throws: MacOSCredentialResolverError.credentialAccessDenied) {\n409|      try await resolver(security: client).credential(\n410|        for: request(\n411|          UUID(uuidString: \"22345678-1234-1234-1234-123456789abc\")!,\n412|          generation: 1\n413|        )\n414|      )\n415|    }\n416|    #expect(matcher.callCount == 0)\n417|  }\n418|\n419|  @Test(\"malformed references stop before any Keychain client call\")\n420|  func malformedReferenceStopsBeforeKeychain() async throws {\n421|    let security = FixtureSystemKeychainClient(keychain: fixtureKeychainHandle())\n422|    let valid = try request(\n423|      UUID(uuidString: \"23456789-2345-2345-2345-23456789abcd\")!,\n424|      generation: 1\n425|    )\n426|    let malformed = SSHCredentialRequest(\n427|      credentialReference: SSHCredentialReference(rawValue: \"not-a-canonical-reference\"),\n428|      credentialGeneration: valid.credentialGeneration,\n429|      username: valid.username,\n430|      allowedPublicKeyAlgorithms: valid.allowedPublicKeyAlgorithms,\n431|      acceptedHost: valid.acceptedHost\n432|    )\n433|\n434|    await #expect(throws: MacOSCredentialResolverError.credentialMalformed) {\n435|      try await resolver(security: security).credential(for: malformed)\n436|    }\n437|    #expect(await security.domainResolutionCount() == 0)\n438|    #expect(await security.matchingQueryCount() == 0)\n439|  }\n440|\n441|  @Test(\"bounded repetitions leave no secret or query-count growth\")\n442|  func repeatedResolutionReturnsToBaseline() async throws {\n443|    let reference = UUID(uuidString: \"34567890-3456-3456-3456-34567890abcd\")!\n444|    let lifecycle = SecretLifecycleProbe()\n445|    let iterations = 16\n446|\n447|    for iteration in 0..<iterations {\n448|      let security = FixtureSystemKeychainClient(\n449|        keychain: fixtureKeychainHandle(iteration),\n450|        item: fixtureItem(\n451|          reference: reference,\n452|          generation: UInt64(iteration + 1),\n453|          passphrase: [0xA5],\n454|          observer: lifecycle\n455|        )\n456|      )\n457|      let credential = try await MacOSSystemKeychainCredentialResolver(\n458|        securityClient: security,\n459|        formatRegistry: FixtureFormatRegistry(),\n460|        lifecycleObserver: lifecycle\n461|      ).credential(for: request(reference, generation: UInt64(iteration + 1)))\n462|      credential.retire()\n463|\n464|      #expect(lifecycle.activeSecretCount == 0, \"iteration \\(iteration)\")\n465|      #expect(await security.domainResolutionCount() == 1, \"iteration \\(iteration)\")\n466|      #expect(await security.matchingQueryCount() == 1, \"iteration \\(iteration)\")\n467|    }\n468|  }\n469|\n470|  private static let service = MacOSSystemKeychainCredentialResolver.service\n471|  private static let expectedQueryKeys: Set<String> = [\n472|    kSecClass as String,\n473|    kSecAttrService as String,\n474|    kSecAttrAccount as String,\n475|    kSecUseDataProtectionKeychain as String,\n476|    kSecMatchSearchList as String,\n477|    kSecReturnAttributes as String,\n478|    kSecReturnData as String,\n479|    kSecMatchLimit as String,\n480|  ]\n481|}\n482|\n483|struct FormatFailureCase: Sendable, CustomTestStringConvertible {\n484|  let error: MacOSCredentialFormatError\n485|  let expected: MacOSCredentialResolverError\n486|  var testDescription: String { expected.rawValue }\n487|}\n488|\n489|struct PassphraseCase: Sendable, CustomTestStringConvertible {\n490|  let bytes: [UInt8]?\n491|  let expectedCount: Int?\n492|  let label: String\n493|  var testDescription: String { label }\n494|}\n495|\n496|private actor FixtureSystemKeychainClient: MacOSSystemKeychainSecurityClient {\n497|  let keychain: MacOSSystemKeychainHandle\n498|  let status: OSStatus\n499|  let item: MacOSKeychainLookupItem?\n500|  let gate: ResolverTestGate?\n(more lines below)","final_result":true}}}
