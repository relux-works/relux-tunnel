+    let metrics = await fixture.bridge.metrics()
+    #expect(metrics.counters["packet_bridge_fatal_socket_error_total"] == 1)
+    #expect(metrics.counters["packet_bridge_forward_datagrams_sent_total"] == 0)
+  }
