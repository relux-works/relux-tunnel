  1206	  private func handleAutomaticKeepaliveFailure(
  1207	    _ error: Error,
  1208	    policy: SSHKeepalivePolicy
  1209	  ) async -> Bool {
  1210	    let mapped = map(error, phase: .keepalive, fallback: .keepaliveFailed)
  1211	    if state == .rekeying, mapped.code == .timedOut || mapped.code == .invalidState {
  1212	      return true
  1213	    }
  1214	    guard state == .ready else { return false }
  1215	    consecutiveKeepaliveFailures += 1
  1216	    guard consecutiveKeepaliveFailures > policy.allowedConsecutiveMisses else {
  1217	      return true
  1218	    }
