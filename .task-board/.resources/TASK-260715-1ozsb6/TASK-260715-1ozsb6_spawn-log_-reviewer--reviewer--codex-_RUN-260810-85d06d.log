+  @convention(c) (
+    UnsafeMutableRawPointer?, Int, UnsafeMutablePointer<UnsafeMutableRawPointer?>?
+  ) -> UnsafeMutableRawPointer? = {
+    pointer, byteCount, abstract in
+    context(from: abstract)?.reallocate(pointer, byteCount: byteCount)
