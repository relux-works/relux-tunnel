.PHONY: check-legacy test-legacy-guard check-core-boundaries core-build core-test \
	check-native-dependencies test-native-dependencies native-apple-matrix validate-core validate-native \
	check-reluxniossh test-reluxniossh build-reluxniossh validate-reluxniossh \
	check-libssh2 test-libssh2 test-libssh2-source-gates validate-libssh2 build-libssh2 \
	relay-protocol-generate relay-protocol-vectors-generate \
	relay-protocol-vectors-check relay-protocol-conformance-check \
	relay-protocol-hostile-diagnostics relay-protocol-check

LEGACY_ROOT ?= ../relux-proxy

check-legacy:
	./scripts/check-legacy-preservation.sh --legacy-root "$(LEGACY_ROOT)"

test-legacy-guard:
	./scripts/tests/test-legacy-preservation-guard.sh --legacy-root "$(LEGACY_ROOT)"

check-core-boundaries:
	./scripts/check-core-boundaries.sh

core-build:
	swift build

core-test:
	swift test

check-native-dependencies:
	./scripts/native-dependency-tool.py verify --dependency relux-native-fixture
	python3 scripts/libssh2-fork-tool.py verify

test-native-dependencies:
	./scripts/tests/test-native-dependencies.sh

native-apple-matrix:
	./scripts/build-native-apple-matrix.sh

validate-core: check-core-boundaries check-native-dependencies core-test core-build

validate-native: check-core-boundaries check-native-dependencies test-native-dependencies native-apple-matrix core-test core-build

check-reluxniossh:
	python3 scripts/reluxniossh-fork-tool.py verify

test-reluxniossh:
	cd Dependencies/ReluxNIOSSH && swift test

build-reluxniossh:
	cd Dependencies/ReluxNIOSSH && swift build

validate-reluxniossh: check-reluxniossh test-reluxniossh build-reluxniossh

LIBSSH2_SOURCE_ARCHIVE ?= .temp/TASK-260720-3vwls7/libssh2-a343024.tar.gz
OPENSSL_SOURCE_ARCHIVE ?= .temp/TASK-260715-28ok1k/openssl-3.5.7.tar.gz

check-libssh2:
	python3 scripts/libssh2-fork-tool.py verify

test-libssh2:
	python3 scripts/libssh2-fork-tool.py test-rekey

test-libssh2-source-gates:
	python3 scripts/libssh2-fork-tool.py test-source-gates \
		--libssh2-archive "$(LIBSSH2_SOURCE_ARCHIVE)" \
		--openssl-archive "$(OPENSSL_SOURCE_ARCHIVE)"

build-libssh2:
	python3 scripts/libssh2-fork-tool.py build-xcframework \
		--libssh2-archive "$(LIBSSH2_SOURCE_ARCHIVE)" \
		--openssl-archive "$(OPENSSL_SOURCE_ARCHIVE)" \
		--output NativeDependencies/Artifacts/ReluxLibSSH2.xcframework

RELAY_PROTOCOL_ENV = LC_ALL=C LANG=C TZ=UTC PYTHONHASHSEED=0

relay-protocol-generate:
	env $(RELAY_PROTOCOL_ENV) python3 scripts/relay-protocol-tool.py generate

relay-protocol-vectors-generate:
	env $(RELAY_PROTOCOL_ENV) python3 scripts/relay-protocol-vectors.py generate

relay-protocol-vectors-check:
	env $(RELAY_PROTOCOL_ENV) python3 scripts/relay-protocol-vectors.py check

relay-protocol-conformance-check: relay-protocol-vectors-check
	./scripts/tests/test-relay-protocol-go.sh -v
	swift test --filter RelayProtocol

relay-protocol-hostile-diagnostics:
	./scripts/tests/test-relay-protocol-go.sh -run TestHostileInputCorpus -count=1 -gcflags=all=-d=checkptr=2
	swift test --sanitize=address --filter RelayProtocolHostileInputTests

relay-protocol-check: relay-protocol-conformance-check
	env $(RELAY_PROTOCOL_ENV) python3 scripts/relay-protocol-tool.py check
	swift build

validate-libssh2: check-libssh2 test-libssh2
# TASK-260715-zfg9ap implementation evidence

## Delivered

- Added one generation-scoped mutex registry with non-waiting handshake, authenticated-flow, channel-open, channel, fixed queued-byte, live-buffer, phase, byte-total, peak, pressure, and terminal accounting.
- All physical ceilings remain caller-injected. The configured flow ceiling is validated under both measuredSafeMaximumFlows and hevMaximumSessionCount. Pump reservations can be derived directly from BoundedFullDuplexBytePumpConfiguration.
- Every pressure rejection is immediate, has no side queue, maps to SOCKS5 REP 01, and sets shouldOpenSSHChannel false. Existing admitted flows retain progress under new-work pressure.
- Once-only handshake, flow, and opening tokens release explicitly or roll back on destruction. Terminal-during-open releases the open slot once; a later completion is a bounded late event.
- Extended bounded RuntimeDiagnostics schema v1 with finite TCP counters, gauges, pressure and terminal reasons, and fixed channel-open latency buckets. No API accepts destination, hostname, address, port, payload, credential, flow ID, channel ID, or free-form label.

## Measured capacity evidence

- Concurrent global-flow test: maximum 16 admitted from 256 requests, peak reserved flows 16, peak reserved queued bytes 128, all 240 excess requests rejected deterministically, exact zero baseline after release.
- Concurrent opening test: maximum 4 openings across 16 admitted flows, all 12 excess attempts rejected deterministically, peak openings 4, exact zero baseline after release.
- Independent handshake test: maximum 8 reservations across 128 requests, all 120 excess requests rejected as handshake capacity, exact zero baseline.
- Independent queued-byte test: 32-byte ceiling with 8 bytes per flow admits exactly 4 of 128 and rejects 124 as queued-byte capacity, exact zero baseline.
- Terminal churn: all 16 finite reasons exercised for 20 cycles each, 320 lifecycles total; flow, opening, channel, queued-byte, and live-buffer gauges return to zero after every lifecycle with zero release violations.
- Diagnostics schema: 138 counters, 75 gauges, 2 fixed 12-bucket histograms, 11 finite error codes; maximum populated encoded snapshot 13499 bytes of 65536.

## Exact verification commands

- swift test --filter TCPAdmissionRegistryTests: PASS, 8 tests.
- swift test --filter RuntimeDiagnosticsTests: PASS, 9 tests.
- swift test --sanitize=thread --filter TCPAdmissionRegistryTests: PASS, 8 tests, no TSan report.
- swift test --sanitize=thread --filter RuntimeDiagnosticsTests: PASS, 9 tests, no TSan report.
- make validate-core: PASS, boundary and native dependency gates, 296 tests in 27 suites, then swift build.
- swift format lint --strict --recursive Sources Tests Package.swift: PASS.
- git diff --check: PASS.
- engine import guard on TCPAdmissionRegistry.swift: PASS.
- task-board validate: PASS.

Logs are attached as TASK-260715-zfg9ap_validate-core.log, TASK-260715-zfg9ap_tsan-admission.log, and TASK-260715-zfg9ap_tsan-diagnostics.log.
diff --git a/Sources/ReluxTunnelCore/RuntimeDiagnostics.swift b/Sources/ReluxTunnelCore/RuntimeDiagnostics.swift
index 044d289c4da853a3517fc84c8f42d0adbc92adeb..999bd45e533980dbdcafbf456a17b9856efe9de4
--- a/Sources/ReluxTunnelCore/RuntimeDiagnostics.swift
+++ b/Sources/ReluxTunnelCore/RuntimeDiagnostics.swift
@@ -209,6 +209,92 @@
   fileprivate static let gaugeNameSet = Set(gaugeNames)
 }
 
+/// A generation-scoped, fixed-size coalescing cell for authoritative TCP gauges.
+///
+/// The registry is the single writer for a generation. Publications use only
+/// atomics and never wait for the bounded diagnostics queue. Snapshot readers
+/// use the sequence as a seqlock so they never export a mixture of two registry
+/// states. A stale recorder owns a different cell and therefore cannot affect a
+/// later generation.
+private final class RuntimeTCPAdmissionGaugeReconciler: Sendable {
+  private let sequence = Atomic<UInt64>(0)
+  private let published = Atomic(false)
