+  case rejectChanged
+  case rejectAlgorithm
+  case rejectPolicy
+}
+
+public enum SSHHostDecisionOutcome: String, Equatable, Sendable {
+  case firstUseAccepted
+  case matchAccepted
+  case unknownRejected
+  case changedRejected
+  case algorithmRejected
+  case policyRejected
+}
