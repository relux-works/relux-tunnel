  1139	        await Task.yield()
  1140	      }
  1141	      #expect(await transport.snapshot().gauges.pendingReads == 1, "iteration \(iteration)")
  1142	      await channel.cancel()
  1143	      do {
  1144	        _ = try await pendingRead.value
  1145	        Issue.record(
  1146	          "concurrent channel read unexpectedly completed", sourceLocation: #_sourceLocation)
  1147	      } catch let error as SSHTransportError {
  1148	        #expect(error.code == .cancelled, "iteration \(iteration)")
  1149	        #expect(error.phase == .channelRead, "iteration \(iteration)")
  1150	      }
  1151	      #expect(await transport.snapshot().gauges.pendingReads == 0, "iteration \(iteration)")
  1152	    }
  1153	  }
