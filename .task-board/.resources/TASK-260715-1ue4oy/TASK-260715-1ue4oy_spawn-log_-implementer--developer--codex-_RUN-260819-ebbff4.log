RELAY_PROTOCOL_ENV = LC_ALL=C LANG=C TZ=UTC PYTHONHASHSEED=0

RELAY_HOST_OS ?= $(shell uname -s | tr '[:upper:]' '[:lower:]')
RELAY_HOST_ARCH ?= $(shell uname -m | sed -e 's/^x86_64$$/amd64/' -e 's/^aarch64$$/arm64/')
