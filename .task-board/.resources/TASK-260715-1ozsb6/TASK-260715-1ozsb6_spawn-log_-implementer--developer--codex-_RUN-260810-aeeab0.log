   577	  private func authenticate(username: String, publicKey: Data, timeout: Duration) async throws {
   578	    guard let engineSession else {
   579	      throw transportError(code: .invalidState, phase: .authentication)
   580	    }
   581	    let deadline = dependencies.clock.now().advanced(by: timeout)
   582	    while true {
   583	      try checkCancellation(phase: .authentication)
   584	      var abstract = sessionContextPointer
   585	      let result = username.withCString { user in
   586	        publicKey.withUnsafeBytes { bytes in
   587	          libssh2_userauth_publickey(
   588	            engineSession,
   589	            user,
   590	            bytes.bindMemory(to: UInt8.self).baseAddress,
   591	            bytes.count,
   592	            reluxLibSSH2SignCallback,
   593	            &abstract
   594	          )
   595	        }
   596	      }
   597	      if result == 0 { return }
   598	      guard result == LIBSSH2_ERROR_EAGAIN else {
   599	        counters.authenticationRejected += 1
   600	        await metric(.increment(.authenticationRejected, by: 1))
   601	        throw engineError(result, phase: .authentication, fallback: .authenticationRejected)
   602	      }
   603	      try await progress(until: deadline, phase: .authentication)
   604	    }
   605	  }
