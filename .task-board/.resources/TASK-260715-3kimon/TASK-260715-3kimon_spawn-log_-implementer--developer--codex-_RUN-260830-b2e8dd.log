+  ) -> (MemoryWatermarkState, MemoryTransitionReason?) {
+    let entry = entrySeverity(platform: platform, ledger: ledger, warning: warning)
+    if entry.state > state {
+      recoveryEligibleSince = nil
+      return (entry.state, entry.reason)
+    }
+    guard state != .normal,
+      actionsAcknowledged,
+      allSignalsPermitRecovery(platform: platform, ledger: ledger, from: state)
+    else {
+      recoveryEligibleSince = nil
+      return (state, nil)
+    }
+    if recoveryEligibleSince == nil { recoveryEligibleSince = now }
+    guard recoveryEligibleSince!.duration(to: now) >= configuration.recoveryDwell else {
+      return (state, nil)
+    }
+    recoveryEligibleSince = now
+    return (MemoryWatermarkState(rawValue: state.rawValue - 1)!, .recovery)
+  }
+
+  private func entrySeverity(
+    platform: MemoryPlatformSample,
+    ledger: MemoryLedgerAvailability,
+    warning: Bool
+  ) -> (state: MemoryWatermarkState, reason: MemoryTransitionReason?) {
+    var result: (MemoryWatermarkState, MemoryTransitionReason?) =
+      warning ? (.pressure, .memoryWarning) : (.normal, nil)
+    func include(
+      _ bytes: UInt64?, _ thresholds: MemorySignalThresholds, _ reason: MemoryTransitionReason
+    ) {
+      guard let bytes else { return }
+      let candidate: MemoryWatermarkState
+      if bytes <= thresholds.criticalEnterBytes {
+        candidate = .critical
+      } else if bytes <= thresholds.pressureEnterBytes {
+        candidate = .pressure
+      } else if bytes <= thresholds.softEnterBytes {
+        candidate = .soft
+      } else {
+        candidate = .normal
+      }
+      if candidate > result.0 { result = (candidate, reason) }
+    }
+    if case .available(let snapshot) = ledger {
+      include(
+        headroom(limit: configuration.globalLedgerCeilingBytes, used: snapshot.committedBytes),
+        configuration.ledgerHeadroom, .ledgerHeadroom)
+    }
+    include(
+      platform.physicalFootprint.bytes.map {
+        headroom(limit: configuration.deviceBaselineBytes, used: $0)
+      }, configuration.physicalHeadroom, .physicalHeadroom)
+    include(
+      platform.advisoryAvailableMemory.bytes,
+      configuration.advisoryAvailable, .advisoryAvailable)
+    return result
+  }
+
+  private func allSignalsPermitRecovery(
+    platform: MemoryPlatformSample,
+    ledger: MemoryLedgerAvailability,
+    from state: MemoryWatermarkState
+  ) -> Bool {
+    guard case .available(let ledgerSnapshot) = ledger,
+      let footprint = platform.physicalFootprint.bytes,
+      platform.physicalFootprintPeak.bytes != nil,
+      let advisory = platform.advisoryAvailableMemory.bytes
+    else { return false }
+    return aboveExit(
+      headroom(limit: configuration.globalLedgerCeilingBytes, used: ledgerSnapshot.committedBytes),
+      configuration.ledgerHeadroom, state: state)
+      && aboveExit(
+        headroom(limit: configuration.deviceBaselineBytes, used: footprint),
+        configuration.physicalHeadroom, state: state)
+      && aboveExit(advisory, configuration.advisoryAvailable, state: state)
+  }
+
+  private func aboveExit(
+    _ value: UInt64, _ thresholds: MemorySignalThresholds, state: MemoryWatermarkState
+  ) -> Bool {
+    switch state {
+    case .critical: value > thresholds.criticalExitBytes
+    case .pressure: value > thresholds.pressureExitBytes
+    case .soft: value > thresholds.softExitBytes
+    case .normal: true
+    }
+  }
+
+  private func unavailableCount(_ sample: MemoryPlatformSample) -> UInt64 {
+    [sample.physicalFootprint, sample.physicalFootprintPeak, sample.advisoryAvailableMemory]
+      .reduce(0) { count, value in
+        if case .unavailable = value { return count + 1 }
+        return count
+      }
+  }
+
+  private func unavailableCount(_ ledger: MemoryLedgerAvailability) -> UInt64 {
+    if case .unavailable = ledger { return 1 }
+    return 0
+  }
+}
+
+public enum MemoryWatermarkControllerError: Error, Equatable, Sendable {
+  case sequenceExhausted
+}
+
+private func headroom(limit: UInt64, used: UInt64) -> UInt64 {
+  used >= limit ? 0 : limit - used
+}
+
+private func incrementSaturating(_ value: UInt64, by amount: UInt64 = 1) -> UInt64 {
+  let (result, overflow) = value.addingReportingOverflow(amount)
+  return overflow ? UInt64.max : result
+}
+
+private struct RingHistory: Sendable {
+  private var storage: [MemoryObservation?]
+  private var next = 0
+  private var count = 0
+  private(set) var limit: Int
+
+  init(limit: Int) {
+    self.limit = limit
+    self.storage = Array(repeating: nil, count: limit)
+  }
+
+  mutating func append(_ value: MemoryObservation) {
+    storage[next] = value
+    next = (next + 1) % limit
+    count = min(count + 1, limit)
+  }
+
+  mutating func resize(to newLimit: Int) {
+    let retained = Array(values.suffix(newLimit))
+    self = RingHistory(limit: newLimit)
+    for value in retained { append(value) }
+  }
+
+  var values: [MemoryObservation] {
+    guard count > 0 else { return [] }
+    let start = count == limit ? next : 0
+    return (0..<count).compactMap { storage[(start + $0) % limit] }
+  }
+}
