   602	  public static func initialCandidate(
   603	    for channelClass: SSHReceiveWindowClass,
   604	    measurement: SSHBulkPathMeasurement?,
   605	    configuration: SSHReceiveWindowBudgetConfiguration
   606	  ) throws -> Int {
   607	    switch channelClass {
   608	    case .control:
   609	      return configuration.controlInitialWindowBytes
   610	    case .ordinary:
   611	      return configuration.ordinaryInitialWindowBytes
   612	    case .bulk:
   613	      guard let measurement,
   614	        measurement.bandwidthBitsPerSecond > 0,
   615	        measurement.roundTripTimeNanoseconds > 0
   616	      else { throw SSHReceiveWindowRefusal.invalidMeasurement }
   617	      let bandwidth = min(
   618	        measurement.bandwidthBitsPerSecond,
   619	        configuration.maximumMeasuredBandwidthBitsPerSecond)
   620	      let rtt = min(
   621	        measurement.roundTripTimeNanoseconds,
   622	        configuration.maximumMeasuredRTTNanoseconds)
   623	      let bytes = ceilMultiplyDivide(bandwidth, rtt, by: 8_000_000_000)
   624	      let bounded = min(
   625	        UInt64(configuration.bulkMaximumWindowBytes),
   626	        max(UInt64(configuration.bulkMinimumWindowBytes), bytes))
   627	      return Int(bounded)
   628	    case .relay:
   629	      let framed = max(saturatingAdd(4, configuration.relayMaximumFrameBodyBytes), 64)
   630	      let burst = saturatingMultiply(configuration.relayBurstDatagramCount, framed)
   631	      return min(
   632	        configuration.relayMaximumWindowBytes,
   633	        saturatingAdd(configuration.relayControlWindowBytes, burst))
   634	    }
   635	  }
