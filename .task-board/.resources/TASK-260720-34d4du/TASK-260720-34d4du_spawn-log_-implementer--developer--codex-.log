   122	    @Test("Adjustments follow delivered bytes and never exceed the immutable cap")
   123	    func adjustmentAccountingAndCap() throws {
   124	        var manager = ChildChannelWindowManager(
   125	            configuration: .init(
   126	                initialWindowSize: 64 * 1024,
   127	                maximumWindowSize: 96 * 1024,
   128	                windowAdjustmentThreshold: 32 * 1024
   129	            )
   130	        )
   131	
   132	        try manager.bufferFlowControlledBytes(48 * 1024)
   133	        #expect(manager.unbufferBytes(31 * 1024) == nil)
   134	
   135	        let possibleIncrement = manager.unbufferBytes(1024)
   136	        let increment = try #require(possibleIncrement)
   137	        #expect(increment.rawValue == 32 * 1024)
   138	        #expect(increment.remainingWindowBefore == 16 * 1024)
   139	        #expect(increment.remainingWindowAfter == 48 * 1024)
   140	        #expect(increment.remainingWindowAfter <= increment.maximumWindowSize)
   141	
   142	        let snapshot = manager.snapshot
   143	        #expect(snapshot.bufferedBytes == 16 * 1024)
   144	        #expect(snapshot.deliveredButUnadjustedBytes == 0)
   145	        #expect(snapshot.adjustmentCount == 1)
   146	        #expect(snapshot.adjustmentBytes == 32 * 1024)
   147	    }
