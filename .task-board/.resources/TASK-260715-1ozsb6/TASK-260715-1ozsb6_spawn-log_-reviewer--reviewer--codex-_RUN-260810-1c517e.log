  2458	private enum LibSSH2OwnedAsyncOperationRegistryError: Error {
  2459	  case resourceLimitExceeded
  2460	}
  2461	
  2462	/// Retains timeout-raced work after its caller detaches. A dependency that
  2463	/// ignores cancellation can no longer hold the public operation or close past
  2464	/// its deadline, but remains visible as owned work until it actually returns.
  2465	private final class LibSSH2OwnedAsyncOperationRegistry: @unchecked Sendable {
  2466	  private let lock = NSLock()
  2467	  private let maximumOperations: Int
  2468	  private var operations: [UUID: any LibSSH2OwnedAsyncOperation] = [:]
  2469	  private var drainWaiters: [UUID: LibSSH2OperationWaiter] = [:]
  2470	
  2471	  init(maximumOperations: Int) {
  2472	    precondition(maximumOperations > 0)
  2473	    self.maximumOperations = maximumOperations
  2474	  }
  2475	
  2476	  var outstandingCount: Int {
  2477	    lock.withLock { operations.count }
  2478	  }
  2479	
  2480	  func register(_ operation: any LibSSH2OwnedAsyncOperation) throws {
  2481	    try lock.withLock {
  2482	      guard operations.count < maximumOperations else {
  2483	        throw LibSSH2OwnedAsyncOperationRegistryError.resourceLimitExceeded
  2484	      }
  2485	      operations[operation.identifier] = operation
  2486	    }
  2487	  }
  2488	
  2489	  func remove(identifier: UUID) {
  2490	    let waiters: [LibSSH2OperationWaiter] = lock.withLock {
  2491	      operations.removeValue(forKey: identifier)
  2492	      guard operations.isEmpty else { return [] }
  2493	      defer { drainWaiters.removeAll() }
  2494	      return Array(drainWaiters.values)
  2495	    }
  2496	    for waiter in waiters { waiter.complete(with: .success(())) }
  2497	  }
  2498	
  2499	  func cancelAll() {
  2500	    let snapshot = lock.withLock { Array(operations.values) }
  2501	    for operation in snapshot { operation.cancel() }
  2502	  }
  2503	
  2504	  func waitForAll(
  2505	    until deadline: ContinuousClock.Instant,
  2506	    clock: any TunnelClock
  2507	  ) async -> Bool {
  2508	    let waiter = LibSSH2OperationWaiter()
  2509	    let waiterIdentifier = waiter.identifier
  2510	    let registered = lock.withLock {
  2511	      guard !operations.isEmpty else { return false }
  2512	      drainWaiters[waiterIdentifier] = waiter
  2513	      return true
  2514	    }
  2515	    guard registered else { return true }
  2516	    let now = clock.now()
  2517	    guard now < deadline else {
  2518	      _ = lock.withLock { drainWaiters.removeValue(forKey: waiterIdentifier) }
  2519	      return false
  2520	    }
  2521	    let timer = Task {
  2522	      do {
  2523	        try await clock.sleep(for: now.duration(to: deadline))
  2524	        waiter.complete(with: .failure(LibSSH2TimeoutError.elapsed))
  2525	      } catch {
  2526	        waiter.complete(with: .failure(error))
  2527	      }
  2528	    }
  2529	    defer {
  2530	      timer.cancel()
  2531	      _ = lock.withLock { drainWaiters.removeValue(forKey: waiterIdentifier) }
  2532	    }
  2533	    do {
  2534	      try await waiter.wait()
  2535	      return true
  2536	    } catch {
  2537	      return false
  2538	    }
  2539	  }
  2540	}
