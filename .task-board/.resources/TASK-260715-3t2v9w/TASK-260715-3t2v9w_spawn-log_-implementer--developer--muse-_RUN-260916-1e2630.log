 @escaping @Sendable () -> Date\n132|  ) throws {\n133|    guard Self.isCanonical(snapshot.hostPolicy.allowedAlgorithms),\n134|      Self.hasCanonicalRecords(snapshot.hostPolicy.records)\n135|    else {\n136|      throw SSHApprovedHostIdentityPolicyError.invalidProfilePolicy\n137|    }\n138|    canonicalHost = snapshot.canonicalHost\n139|    port = snapshot.port\n140|    allowedAlgorithms = snapshot.hostPolicy.allowedAlgorithms\n141|    records = snapshot.hostPolicy.records\n142|    self.adapterHostKeyAlgorithms = adapterHostKeyAlgorithms\n143|    self.now = now\n144|  }\n145|\n146|  public func evaluate(_ input: SSHHostKeyPolicyInput) async throws -> SSHHostKeyDecision {\n147|    guard let algorithm = SSHHostKeyAlgorithm(rawValue: input.evidence.algorithm),\n148|      allowedAlgorithms.contains(algorithm),\n149|      adapterHostKeyAlgorithms.contains(algorithm.rawValue)\n150|    else {\n151|      return .rejectAlgorithm\n152|    }\n153|\n154|    guard input.canonicalHostname == canonicalHost.value,\n155|      input.connectedEndpoint.port == port\n156|    else {\n157|      return .rejectHostMismatch\n158|    }\n159|\n160|    guard SSHWireHostKeyValidator.isValid(input.evidence.keyBytes, for: algorithm) else {\n161|      return .rejectMalformed\n162|    }\n163|\n164|    let observedDigest = Data(SHA256.hash(data: input.evidence.keyBytes))\n165|    let observedAt = Self.timestamp(now())\n166|    let matchingRecords = records.enumerated().filter { _, record in\n167|      guard record.algorithm == algorithm,\n168|        let approvedDigest = Self.fingerprintDigest(record.fingerprintSHA256.rawValue)\n169|      else { return false }\n170|      return Self.constantTimeEqual(observedDigest, approvedDigest)\n171|    }\n172|\n173|    if let (_, record) = matchingRecords.first(where: { $0.element.state == .revoked }) {\n174|      return .rejectRevoked(Self.auditMetadata(for: record, observedAt: observedAt))\n175|    }\n176|\n177|    if let (index, record) = matchingRecords.first(where: { $0.element.state == .approved }) {\n178|      return .acceptApproved(\n179|        SSHApprovedHostIdentityMatch(\n180|          identity: SSHVerifiedHostIdentity(\n181|            algorithm: algorithm.rawValue,\n182|            fingerprintSHA256: input.evidence.fingerprint\n183|          ),\n184|          trustRecordReference: input.trustRecordReference\n185|            ?? SSHTrustRecordReference(rawValue: \"snapshot-record-\\(index)\"),\n186|          recordIndex: index,\n187|          auditMetadata: Self.auditMetadata(for: record, observedAt: observedAt)\n188|        )\n189|      )\n190|    }\n191|\n192|    guard records.isEmpty else { return .rejectChanged }\n193|    return .trustRequired(\n194|      SSHHostTrustRequiredEvidence(\n195|        canonicalHost: canonicalHost,\n196|        port: port,\n197|        algorithm: algorithm,\n198|        fingerprintSHA256: SSHHostKeyFingerprint(input.evidence.fingerprint),\n199|        observedAt: observedAt\n200|      )\n201|    )\n202|  }\n203|\n204|  private static func auditMetadata(\n205|    for record: SSHHostIdentityRecordV1,\n206|    observedAt: SSHProfileTimestamp\n207|  ) -> SSHHostIdentityAuditMetadata {\n208|    SSHHostIdentityAuditMetadata(\n209|      provenance: record.provenance,\n210|      firstSeenAt: record.firstSeenAt,\n211|      previousLastSeenAt: record.lastSeenAt,\n212|      observedAt: observedAt\n213|    )\n214|  }\n215|\n216|  private static func isCanonical(_ algorithms: [SSHHostKeyAlgorithm]) -> Bool {\n217|    guard !algorithms.isEmpty else { return false }\n218|    let indexes = algorithms.compactMap(SSHHostKeyAlgorithm.canonicalPreferenceOrder.firstIndex)\n219|    return indexes.count == algorithms.count\n(more lines below)","final_result":true}}}
