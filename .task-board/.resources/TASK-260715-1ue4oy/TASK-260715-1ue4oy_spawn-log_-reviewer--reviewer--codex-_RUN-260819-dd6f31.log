    arguments: [
      ("Darwin", "x86_64", "relux-relay-darwin-amd64"),
      ("macOS", "amd64", "relux-relay-darwin-amd64"),
      ("darwin\n", "aarch64\n", "relux-relay-darwin-arm64"),
