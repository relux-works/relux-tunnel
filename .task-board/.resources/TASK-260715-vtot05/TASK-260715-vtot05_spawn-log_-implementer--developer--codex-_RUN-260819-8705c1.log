+                return chr(int(escape[1:], 16))
+            if escape[0] in "01234567":
+                return chr(int(escape, 8))
+            return {
+                "a": "\a",
+                "b": "\b",
+                "f": "\f",
+                "n": "\n",
+                "r": "\r",
+                "t": "\t",
+                "v": "\v",
+                "\\": "\\",
+                '"': '"',
