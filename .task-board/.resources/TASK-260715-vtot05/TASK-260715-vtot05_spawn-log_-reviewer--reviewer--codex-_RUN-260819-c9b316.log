   839	def render_notices(config: dict[str, Any]) -> bytes:
   840	    lines = [
   841	        "Relux Relay product notice input\n",
   842	        "Generated by scripts/relay_supply_chain.py from relay/supply-chain-source-v1.json.\n",
   843	        "Do not edit this generated file.\n",
   844	    ]
   845	    groups: dict[tuple[str, str], list[dict[str, Any]]] = {}
   846	    for component in config["components"]:
   847	        if component["noticeObligation"] != "include-full-license":
   848	            continue
   849	        key = (component["license"], component["licenseTextSHA256"])
   850	        groups.setdefault(key, []).append(component)
   851	    for components in groups.values():
   852	        component = components[0]
   853	        text = (
   854	            (ROOT / component["licenseTextPath"]).read_text(encoding="utf-8").rstrip()
   855	        )
   856	        covered = ", ".join(item["name"] for item in components)
   857	        revisions = ", ".join(f"{item['id']}={item['revision']}" for item in components)
   858	        lines.extend(
   859	            [
   860	                "\n",
   861	                "=" * 72 + "\n",
   862	                f"{covered} ({component['license']})\n",
   863	                f"Revisions: {revisions}\n",
   864	                f"License SHA-256: {component['licenseTextSHA256']}\n",
   865	                "=" * 72 + "\n",
   866	                text + "\n",
   867	            ]
   868	        )
   869	    return "".join(lines).encode("utf-8")
