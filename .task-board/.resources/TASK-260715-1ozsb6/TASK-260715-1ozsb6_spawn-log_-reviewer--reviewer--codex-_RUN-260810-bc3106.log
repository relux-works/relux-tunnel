  2425	/// Retains timeout-raced work after its caller detaches. A dependency that
  2426	/// ignores cancellation can no longer hold the public operation or close past
  2427	/// its deadline, but remains visible as owned work until it actually returns.
  2428	private final class LibSSH2OwnedAsyncOperationRegistry: @unchecked Sendable {
  2429	  private let lock = NSLock()
  2430	  private let maximumOperations: Int
  2431	  private var operations: [UUID: any LibSSH2OwnedAsyncOperation] = [:]
  2432	
  2433	  init(maximumOperations: Int) {
  2434	    precondition(maximumOperations > 0)
  2435	    self.maximumOperations = maximumOperations
  2436	  }
  2437	
  2438	  var outstandingCount: Int {
  2439	    lock.withLock { operations.count }
  2440	  }
  2441	
  2442	  func register(_ operation: any LibSSH2OwnedAsyncOperation) throws {
  2443	    try lock.withLock {
  2444	      guard operations.count < maximumOperations else {
  2445	        throw LibSSH2OwnedAsyncOperationRegistryError.resourceLimitExceeded
  2446	      }
  2447	      operations[operation.identifier] = operation
  2448	    }
  2449	  }
  2450	
  2451	  func remove(identifier: UUID) {
  2452	    _ = lock.withLock { operations.removeValue(forKey: identifier) }
  2453	  }
  2454	
  2455	  func cancelAll() {
  2456	    let snapshot = lock.withLock { Array(operations.values) }
  2457	    for operation in snapshot { operation.cancel() }
  2458	  }
  2459	}
