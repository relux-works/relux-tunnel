   667	  private func permitInitial(_ channelClass: SSHReceiveWindowClass) throws {
   668	    switch pressure {
   669	    case .normal, .soft:
   670	      return
   671	    case .pressure:
   672	      guard channelClass == .control || channelClass == .relay else {
   673	        throw SSHReceiveWindowRefusal.memoryPressure
   674	      }
   675	    case .critical:
   676	      throw SSHReceiveWindowRefusal.memoryPressure
   677	    }
   678	  }
