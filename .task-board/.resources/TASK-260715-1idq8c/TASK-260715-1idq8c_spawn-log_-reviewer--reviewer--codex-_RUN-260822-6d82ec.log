     1	import Foundation
     2	
     3	extension ReluxUITest {
     4	  public enum LaunchKey {
     5	    public static let enabled = "RELUX_UI_TEST_MODE"
     6	    public static let fixture = "RELUX_UI_TEST_FIXTURE"
     7	    public static let schemaVersion = "RELUX_UI_TEST_SCHEMA_VERSION"
     8	    public static let networkMode = "RELUX_UI_TEST_NETWORK_MODE"
     9	  }
    10	
    11	  public struct LaunchConfiguration: Equatable, Sendable {
    12	    public static let currentSchemaVersion = 1
    13	    public static let requiredNetworkMode = "disabled"
    14	
    15	    public let fixture: ReluxUITestFixture
    16	
    17	    public init(fixture: ReluxUITestFixture) {
    18	      self.fixture = fixture
    19	    }
    20	
    21	    public var arguments: [String] {
    22	      Self.argumentPairs([
    23	        (LaunchKey.enabled, "true"),
    24	        (LaunchKey.fixture, fixture.rawValue),
    25	        (LaunchKey.schemaVersion, String(Self.currentSchemaVersion)),
    26	      ])
    27	    }
    28	
    29	    public var environment: [String: String] {
    30	      [LaunchKey.networkMode: Self.requiredNetworkMode]
    31	    }
    32	
    33	    public static func parse(
    34	      arguments: [String],
    35	      environment: [String: String]
    36	    ) throws -> LaunchConfiguration {
    37	      let values = argumentValues(arguments)
    38	      guard values[LaunchKey.enabled] == "true" else {
    39	        throw LaunchConfigurationError.fixtureModeRequired
    40	      }
    41	      guard environment[LaunchKey.networkMode] == requiredNetworkMode else {
    42	        throw LaunchConfigurationError.networkBoundaryRequired
    43	      }
    44	      guard values[LaunchKey.schemaVersion] == String(currentSchemaVersion) else {
    45	        throw LaunchConfigurationError.unsupportedSchema
    46	      }
    47	      guard
    48	        let rawFixture = values[LaunchKey.fixture],
    49	        let fixture = ReluxUITestFixture(rawValue: rawFixture)
    50	      else {
    51	        throw LaunchConfigurationError.unknownFixture
    52	      }
    53	      return LaunchConfiguration(fixture: fixture)
    54	    }
    55	
    56	    private static func argumentPairs(_ pairs: [(String, String)]) -> [String] {
    57	      pairs.flatMap { key, value in ["-\(key)", value] }
    58	    }
    59	
    60	    private static func argumentValues(_ arguments: [String]) -> [String: String] {
    61	      var values: [String: String] = [:]
    62	      var index = arguments.startIndex
    63	      while index < arguments.endIndex {
    64	        let argument = arguments[index]
    65	        let next = arguments.index(after: index)
    66	        if argument.hasPrefix("-"), next < arguments.endIndex {
    67	          values[String(argument.dropFirst())] = arguments[next]
    68	          index = arguments.index(after: next)
    69	        } else {
    70	          index = next
    71	        }
    72	      }
    73	      return values
    74	    }
    75	  }
    76	
    77	  public enum LaunchConfigurationError: Error, Equatable {
    78	    case fixtureModeRequired
    79	    case networkBoundaryRequired
    80	    case unsupportedSchema
    81	    case unknownFixture
    82	  }
    83	}

