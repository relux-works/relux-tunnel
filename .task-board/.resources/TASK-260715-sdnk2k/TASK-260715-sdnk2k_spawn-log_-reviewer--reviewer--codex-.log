   581	      writeBehavior = .accept
   582	      channelRead = .eof
   583	      channelWrite = .stall
   584	      scheduler = nil
   585	    case .fairnessYield:
   586	      readBehavior = .oneChunkThenEOF(Data([1, 2]))
   587	      writeBehavior = .accept
   588	      channelRead = .eof
