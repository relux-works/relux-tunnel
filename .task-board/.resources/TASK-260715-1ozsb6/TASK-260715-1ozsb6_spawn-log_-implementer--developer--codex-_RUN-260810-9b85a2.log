+private struct FixtureConnector: SSHTCPConnector {
+  let port: UInt16
+
+  func connect(to endpoint: SSHResolvedEndpoint) async throws -> any SSHTCPConnection {
+    try await Task.detached { try POSIXFixtureConnection.connect(port: port) }.value
