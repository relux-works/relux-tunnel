eInputs,\n517|    componentFactories: MacOSProductionComponentFactories,\n518|    initialGeneration: UInt64 = 0\n519|  ) {\n520|    self.bindingManifestSource = bindingManifestSource\n521|    self.runtimeInputs = runtimeInputs\n522|    self.componentFactories = componentFactories\n523|    makeSelectedSSH = { bindings in\n524|      MacOSSelectedSSHDependencies(\n525|        transportFactory: MacOSProviderSSHConfiguration.makeTransportFactory(\n526|          maximumTransportBufferBytes: bindings.sshTransportBufferBytes\n527|        ),\n528|        credentialProvider: MacOSProviderSSHConfiguration.makeCredentialProvider(),\n529|        makeHostKeyPolicy: {\n530|          try MacOSProviderSSHConfiguration.makeHostKeyPolicy(snapshot: $0)\n531|        },\n532|        mapCredentialError: {\n533|          MacOSSSHBootstrapErrorMapper.credential($0, configurationGeneration: $1)\n534|        }\n535|      )\n536|    }\n537|    makePacketBridge = Self.productionPacketBridge\n538|    latestGeneration = initialGeneration\n539|  }\n540|\n541|  init(\n542|    bindingManifestSource: @escaping BindingManifestSource,\n543|    runtimeInputs: MacOSProductionRuntimeInputs,\n544|    componentFactories: MacOSProductionComponentFactories,\n545|    initialGeneration: UInt64 = 0,\n546|    makeSelectedSSH: @escaping SelectedSSHBuilder,\n547|    makePacketBridge: @escaping PacketBridgeBuilder\n548|  ) {\n549|    self.bindingManifestSource = bindingManifestSource\n550|    self.runtimeInputs = runtimeInputs\n551|    self.componentFactories = componentFactories\n552|    self.makeSelectedSSH = makeSelectedSSH\n553|    self.makePacketBridge = makePacketBridge\n554|    latestGeneration = initialGeneration\n555|  }\n556|\n557|  public func makeRuntime(\n558|    context: TunnelRuntimeContext\n559|  ) async throws -> any TunnelRuntime {\n560|    let manifest: Data\n561|    do {\n562|      guard let loaded = try bindingManifestSource() else {\n563|        throw MacOSProductionBindingError.manifestAbsent\n564|      }\n565|      manifest = loaded\n566|    } catch let error as MacOSProductionBindingError {\n567|      throw error\n568|    } catch {\n569|      throw MacOSProductionBindingError.manifestUnreadable\n570|    }\n571|    let bindings = try MacOSProductionBindingManifestValidator.validate(\n572|      manifest,\n573|      diagnosticsWindow: runtimeInputs.diagnosticsWindow\n574|    )\n575|    guard runtimeInputs.maximumPendingPrivateConnections > 0,\n576|      runtimeInputs.privateAuthenticationTimeoutMilliseconds > 0,\n577|      !runtimeInputs.virtualDNSEndpoints.isEmpty\n578|    else {\n579|      throw MacOSProductionBindingError.incompatibleBinding(\"runtimeInputs\")\n580|    }\n581|    guard latestGeneration < UInt64.max else {\n582|      throw TunnelRuntimeCoordinatorError.generationExhausted\n583|    }\n584|    let generation = latestGeneration + 1\n585|\n586|    let channelPolicy: SSHChannelPolicy\n587|    do {\n588|      channelPolicy = try SSHChannelPolicy(\n589|        initialReceiveWindowBytes: bindings.sshInitialReceiveWindowBytes,\n590|        consumerReceiveWindowCredit: .unsupported,\n591|        maximumBufferedReadBytes: bindings.sshReadBufferBytes,\n592|        maximumQueuedWriteBytes: bindings.sshQueuedWriteBytes,\n593|        maximumWriteCallBytes: bindings.sshWriteCallBytes\n594|      )\n595|    } catch {\n596|      throw MacOSProductionBindingError.incompatibleBinding(\"sshChannelPolicy\")\n597|    }\n598|\n599|    // Selected security dependencies are root-owned and created only after the\n600|    // manifest gate. Public component factories cannot replace or omit them.\n601|    let selectedSSH = makeSelectedSSH(bindings)\n602|    let configurationSource = try componentFactories.makeConfigurationSource()\n603|    let sshServices = try componentFactories.makeSSHRuntimeServices()\n604|    let sshBootstrap = MacOSProductionSSHBootstrap(\n605|      selected: selectedSSH,\n606|      services: sshServices,\n607|      environment: context.dependencies,\n608|      channelPolicy: channelPolicy\n609|    )\n610|    let tcpFactory = try componentFactories.makeTCPFactory()\n611|    let dnsFactory = try componentFactories.makeDNSFactory()\n612|    let settingsPlanBuilder = try componentFactories.makeSettingsPlanBuilder()\n613|    let settingsApplier = try componentFactories.makeSettingsApplier()\n614|    let snapshotStore = try componentFactories.makeSnapshotStore()\n615|    let privateIngressHandler = try componentFactories.makePrivateIngressHandler()\n616|    let environment = context.dependencies\n617|    let inputs = runtimeInputs\n618|    let bridgeBuilder = makePacketBridge\n619|    let packetPlaneFactory = BridgeBackedM1PacketPlaneFactory(\n620|      configuration: bindings.packetBridgeConfiguration,\n621|      virtualDNSEndpoints: inputs.virtualDNSEndpoints\n622|    ) { ingress, _ in\n623|      try bridgeBuilder(\n624|        ingress,\n625|        generation,\n626|        bindings,\n627|        inputs,\n628|        privateIngressHandler,\n629|        environment\n630|      )\n631|    }\n632|\n633|    latestGeneration = generation\n634|    return TunnelRuntimeCoordinator(\n635|      runtimeGeneration: generation,\n636|      context: context,\n637|      dependencies: TunnelRuntimeCoordinatorDependencies(\n638|        configurationSource: configurationSource,\n639|        sshBootstrap: sshBootstrap,\n640|        tcpFactory: tcpFactory,\n641|        dnsFactory: dnsFactory,\n642|        packetPlaneFactory: packetPlaneFactory,\n643|        settingsPlanBuilder: settingsPlanBuilder,\n644|        settingsApplier: settingsApplier,\n645|        snapshotStore: snapshotStore\n646|      )\n647|    )\n648|  }\n649|\n650|  private static func productionPacketBridge(\n651|    ingress: any M1PrivateIngressDispatching,\n652|    runtimeGeneration: UInt64,\n653|    bindings: MacOSAcceptedM0Bindings,\n654|    inputs: MacOSProductionRuntimeInputs,\n655|    handler: any M1HEVAuthenticatedConnectionHandler,\n656|    environment: TunnelRuntimeDependencies\n657|  ) throws -> any PacketBridge {\n658|    let adapter = M1HEVSOCKSConnectionAdapter(ingress: ingress, handler: handler)\n659|    let boundaryFactory = HEVLoopbackSOCKSBoundaryFactory(\n660|      adapter: adapter,\n661|      maximumPendingConnections: inputs.maximumPendingPrivateConnections,\n662|      authenticationTimeoutMilliseconds: inputs.privateAuthenticationTimeoutMilliseconds\n663|    )\n664|    let descriptorConsumer = HEVDescriptorBorrowConsumer(\n665|      configuration: bindings.internalSOCKSConfiguration,\n666|      boundaryFactory: boundaryFactory,\n667|      logger: environment.logger,\n668|      metrics: environment.metrics\n669|    )\n670|    _ = runtimeGeneration\n671|    return PacketFlowBridge(\n672|      descriptorConsumer: descriptorConsumer,\n673|      clock: environment.clock,\n674|      logger: environment.logger,\n675|      metrics: environment.metrics\n676|    )\n677|  }\n678|}","final_result":true}}}
