+
+  @Test("ports account names timestamps IDs and generations validate exhaustively")
+  func scalarFieldValidation() throws {
+    let validData = try SSHProfileSnapshotCodec.encode(fixture())
+
+    for port: UInt64 in [0, 65_536] {
