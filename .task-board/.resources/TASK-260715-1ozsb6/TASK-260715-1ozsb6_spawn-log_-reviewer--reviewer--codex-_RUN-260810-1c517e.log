  2542	private final class LibSSH2TimeoutRace<Value: Sendable>: LibSSH2OwnedAsyncOperation,
  2543	  @unchecked Sendable
  2544	{
  2545	  enum Child {
  2546	    case operation
  2547	    case timer
  2548	  }
  2549	
  2550	  let identifier = UUID()
  2551	
  2552	  private let lock = NSLock()
  2553	  private weak var registry: LibSSH2OwnedAsyncOperationRegistry?
  2554	  private let timeout: Duration
  2555	  private let clock: any TunnelClock
  2556	  private let operation: @Sendable () async throws -> Value
  2557	  private let cleanupAbandonedResult: (@Sendable (Value) async -> Void)?
  2558	  private var operationTask: Task<Void, Never>?
  2559	  private var timerTask: Task<Void, Never>?
