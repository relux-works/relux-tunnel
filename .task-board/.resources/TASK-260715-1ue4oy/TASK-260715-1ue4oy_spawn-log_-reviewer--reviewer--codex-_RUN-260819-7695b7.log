   367	def verify_binary_header(contents: bytes, os_name: str, architecture: str) -> None:
   368	    if os_name == "darwin":
   369	        if len(contents) < 8 or contents[:4] != b"\xcf\xfa\xed\xfe":
   370	            raise AssetManifestError(
   371	                "relay asset has an unparseable Darwin executable header"
   372	            )
   373	        machine = struct.unpack_from("<I", contents, 4)[0]
   374	        expected = 0x01000007 if architecture == "amd64" else 0x0100000C
   375	    else:
   376	        if (
   377	            len(contents) < 20
   378	            or contents[:4] != b"\x7fELF"
   379	            or contents[4] != 2
   380	            or contents[5] != 1
   381	        ):
   382	            raise AssetManifestError(
   383	                "relay asset has an unparseable Linux executable header"
   384	            )
   385	        machine = struct.unpack_from("<H", contents, 18)[0]
   386	        expected = 62 if architecture == "amd64" else 183
   387	    if machine != expected:
   388	        raise AssetManifestError(
   389	            "relay asset executable platform does not match its tuple"
   390	        )
