    70	  @Test("response encoding preserves the relay-observed source endpoint")
    71	  func responseSourceEndpointIsPreserved() throws {
    72	    let originalDestination = RelayDatagramEndpoint(
    73	      address: .ipv4(Data([192, 0, 2, 44])),
