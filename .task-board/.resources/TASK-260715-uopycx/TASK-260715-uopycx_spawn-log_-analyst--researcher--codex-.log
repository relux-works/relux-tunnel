    51	static int
    52	hev_config_parse_tunnel_ipv4 (yaml_document_t *doc, yaml_node_t *base)
    53	{
    54	    yaml_node_pair_t *pair;
    55	
    56	    if (!base || YAML_MAPPING_NODE != base->type)
    57	        return -1;
    58	
    59	    for (pair = base->data.mapping.pairs.start;
    60	         pair < base->data.mapping.pairs.top; pair++) {
    61	        yaml_node_t *node;
    62	        const char *key, *value;
    63	
    64	        if (!pair->key || !pair->value)
    65	            break;
    66	
    67	        node = yaml_document_get_node (doc, pair->key);
    68	        if (!node || YAML_SCALAR_NODE != node->type)
    69	            break;
    70	        key = (const char *)node->data.scalar.value;
    71	
    72	        node = yaml_document_get_node (doc, pair->value);
    73	        if (!node || YAML_SCALAR_NODE != node->type)
    74	            break;
    75	        value = (const char *)node->data.scalar.value;
    76	
    77	        if (0 == strcmp (key, "address"))
    78	            strncpy (tun_ipv4_address, value, 16 - 1);
    79	    }
    80	
   120	    yaml_node_pair_t *pair;
   121	
   122	    if (!base || YAML_MAPPING_NODE != base->type)
   123	        return -1;
   124	
   125	    for (pair = base->data.mapping.pairs.start;
   126	         pair < base->data.mapping.pairs.top; pair++) {
   127	        yaml_node_t *node;
   128	        const char *key;
   129	
   130	        if (!pair->key || !pair->value)
   131	            break;
   132	
   133	        node = yaml_document_get_node (doc, pair->key);
   134	        if (!node || YAML_SCALAR_NODE != node->type)
   135	            break;
   136	        key = (const char *)node->data.scalar.value;
   137	
   138	        node = yaml_document_get_node (doc, pair->value);
   139	        if (!node)
   140	            break;
   141	
   142	        if (YAML_SCALAR_NODE == node->type) {
   143	            const char *value = (const char *)node->data.scalar.value;
   144	
   145	            if (0 == strcmp (key, "name"))
   146	                strncpy (tun_name, value, 64 - 1);
   147	            else if (0 == strcmp (key, "mtu"))
   148	                tun_mtu = strtoul (value, NULL, 10);
   149	            else if (0 == strcmp (key, "multi-queue"))
   150	                multi_queue = strcasecmp (value, "false");
   151	            else if (0 == strcmp (key, "ipv4"))
   152	                strncpy (tun_ipv4_address, value, 16 - 1);
   153	            else if (0 == strcmp (key, "ipv6"))
   154	                strncpy (tun_ipv6_address, value, 64 - 1);
   155	            else if (0 == strcmp (key, "post-up-script"))
   156	                strncpy (tun_post_up_script, value, 64 - 1);
   157	            else if (0 == strcmp (key, "pre-down-script"))
   158	                strncpy (tun_pre_down_script, value, 64 - 1);
   159	        } else {
   160	            if (0 == strcmp (key, "ipv4"))
   161	                hev_config_parse_tunnel_ipv4 (doc, node);
   162	            else if (0 == strcmp (key, "ipv6"))
   163	                hev_config_parse_tunnel_ipv6 (doc, node);
   164	        }
   165	    }
   166	
   167	    return 0;
   168	}
