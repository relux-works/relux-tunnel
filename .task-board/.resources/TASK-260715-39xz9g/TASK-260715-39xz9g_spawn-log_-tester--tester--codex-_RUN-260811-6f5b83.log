+class PartialPrepareCleanupTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory(
+            prefix=f"{fixture.TASK_ID}-partial-prepare-test-"
+        )
+        self.state_root = Path(self.temporary.name)
