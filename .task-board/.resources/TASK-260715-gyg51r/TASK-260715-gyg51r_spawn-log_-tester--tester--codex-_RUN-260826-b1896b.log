+    var existingAncestor = candidate.deletingLastPathComponent()
+    var missingComponents: [String] = []
+    while !FileManager.default.fileExists(atPath: existingAncestor.path) {
+      let component = existingAncestor.lastPathComponent
+      guard !component.isEmpty else { throw MTUMatrixError.unsafeOutputPath }
+      missingComponents.append(component)
+      existingAncestor.deleteLastPathComponent()
+    }
+    var resolvedParent = existingAncestor.resolvingSymlinksInPath()
+    for component in missingComponents.reversed() {
+      resolvedParent.appendPathComponent(component, isDirectory: true)
+    }
+    return resolvedParent.appendingPathComponent(candidate.lastPathComponent)
+  }
