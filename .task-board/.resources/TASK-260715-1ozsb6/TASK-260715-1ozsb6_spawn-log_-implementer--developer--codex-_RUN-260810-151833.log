   641	  public func sendKeepalive() async throws -> SSHDeferredSemanticReport<Duration> {
   642	    guard let configuration else {
   643	      throw transportError(code: .invalidState, phase: .keepalive)
   644	    }
   645	    guard !keepaliveInFlight else {
   646	      throw transportError(code: .operationInProgress, phase: .keepalive, scope: .operation)
   647	    }
   648	    keepaliveInFlight = true
   649	    let timeout = min(
   650	      configuration.timeouts.keepaliveReply,
   651	      configuration.keepalive.replyTimeout
   652	    )
   653	    let deadline = dependencies.clock.now().advanced(by: timeout)
   654	    let permit: LibSSH2SessionOperationPermit
   655	    do {
   656	      permit = try await beginSessionOperation(
   657	        phase: .keepalive,
   658	        until: deadline,
   659	        allowsRekeying: true,
   660	        scope: .operation
   661	      )
   662	    } catch {
   663	      keepaliveInFlight = false
   664	      throw error
   665	    }
   666	    do {
   667	      let result = try await performSendKeepalive(until: deadline)
   668	      finishSessionOperation(permit)
   669	      keepaliveInFlight = false
   670	      return result
   671	    } catch {
   672	      finishSessionOperation(permit)
   673	      keepaliveInFlight = false
   674	      let mapped = map(error, phase: .keepalive, fallback: .keepaliveFailed)
   675	      await recordTerminalOperation(mapped)
   676	      throw mapped
   677	    }
   678	  }
   679	
   680	  private func performSendKeepalive(
   681	    until deadline: ContinuousClock.Instant
   682	  ) async throws -> SSHDeferredSemanticReport<Duration> {
   683	    guard state == .ready else {
   684	      throw transportError(code: .invalidState, phase: .keepalive)
   685	    }
   686	    while true {
   687	      try checkCancellation(phase: .keepalive)
   688	      guard state == .ready, let engineSession else {
   689	        throw transportError(code: .cancelled, phase: .keepalive)
   690	      }
   691	      var reply = LIBSSH2_GLOBAL_REQUEST_REPLY_NONE
   692	      let result = libssh2_session_global_request(
   693	        engineSession,
   694	        "keepalive@openssh.com",
   695	        "keepalive@openssh.com".utf8.count,
   696	        nil,
   697	        0,
   698	        &reply
   699	      )
   700	      if result == 0 {
   701	        consecutiveKeepaliveFailures = 0
   702	        counters.keepalivesSent += 1
   703	        await metric(.increment(.keepalivesSent, by: 1))
   704	        await emit(.keepaliveSent)
   705	        return .unsupported
   706	      }
   707	      guard result == LIBSSH2_ERROR_EAGAIN else {
   708	        throw engineError(result, phase: .keepalive, fallback: .keepaliveFailed)
   709	      }
   710	      try await progress(until: deadline, phase: .keepalive)
   711	    }
   712	  }
