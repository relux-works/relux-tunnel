+  case notReported
+  case unsupported
+}
+
+extension SSHDeferredSemanticReport: Equatable where Value: Equatable {}
+
+public enum SSHDeferredSemanticAvailability: String, Equatable, Sendable {
+  case reported
+  case notReported
+  case unsupported
+}
