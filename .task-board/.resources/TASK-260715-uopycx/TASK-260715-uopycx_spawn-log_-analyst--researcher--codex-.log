   270	static int
   327	static int
   328	hev_config_parse_misc (yaml_document_t *doc, yaml_node_t *base)
   329	{
   330	    yaml_node_pair_t *pair;
   331	    int tcp_rw_timeout = -1;
   332	    int udp_rw_timeout = -1;
   333	    int rw_timeout = -1;
   334	
   335	    if (!base || YAML_MAPPING_NODE != base->type)
   336	        return -1;
   337	
   338	    for (pair = base->data.mapping.pairs.start;
   339	         pair < base->data.mapping.pairs.top; pair++) {
   340	        yaml_node_t *node;
   341	        const char *key, *value;
   342	
   343	        if (!pair->key || !pair->value)
   344	            break;
   345	
   346	        node = yaml_document_get_node (doc, pair->key);
   347	        if (!node || YAML_SCALAR_NODE != node->type)
   348	            break;
   349	        key = (const char *)node->data.scalar.value;
   350	
   351	        node = yaml_document_get_node (doc, pair->value);
   352	        if (!node || YAML_SCALAR_NODE != node->type)
   353	            break;
   354	        value = (const char *)node->data.scalar.value;
   355	
   356	        if (0 == strcmp (key, "task-stack-size"))
   357	            task_stack_size = strtoul (value, NULL, 10);
   358	        else if (0 == strcmp (key, "tcp-buffer-size"))
   359	            tcp_buffer_size = strtoul (value, NULL, 10);
   360	        else if (0 == strcmp (key, "udp-recv-buffer-size"))
   361	            udp_recv_buffer_size = strtoul (value, NULL, 10);
   362	        else if (0 == strcmp (key, "udp-copy-buffer-nums"))
   363	            udp_copy_buffer_nums = strtoul (value, NULL, 10);
   364	        else if (0 == strcmp (key, "max-session-count"))
   365	            max_session_count = strtoul (value, NULL, 10);
   366	        else if (0 == strcmp (key, "connect-timeout"))
   367	            connect_timeout = strtoul (value, NULL, 10);
   368	        else if (0 == strcmp (key, "read-write-timeout"))
   369	            rw_timeout = strtoul (value, NULL, 10);
   370	        else if (0 == strcmp (key, "tcp-read-write-timeout"))
   371	            tcp_rw_timeout = strtoul (value, NULL, 10);
   372	        else if (0 == strcmp (key, "udp-read-write-timeout"))
   373	            udp_rw_timeout = strtoul (value, NULL, 10);
   374	        else if (0 == strcmp (key, "pid-file"))
   375	            strncpy (pid_file, value, 1024 - 1);
   376	        else if (0 == strcmp (key, "log-file"))
   377	            strncpy (log_file, value, 1024 - 1);
   378	        else if (0 == strcmp (key, "log-level"))
   379	            log_level = hev_config_parse_log_level (value);
   380	        else if (0 == strcmp (key, "limit-nofile"))
   381	            limit_nofile = strtol (value, NULL, 10);
   382	    }
   383	
   384	    if (tcp_rw_timeout <= 0)
   385	        tcp_rw_timeout = rw_timeout;
   386	    if (udp_rw_timeout <= 0)
   387	        udp_rw_timeout = rw_timeout;
   388	
   389	    if (tcp_rw_timeout > 0)
   390	        tcp_read_write_timeout = tcp_rw_timeout;
   391	    if (udp_rw_timeout > 0)
   392	        udp_read_write_timeout = udp_rw_timeout;
   393	
   394	    return 0;
   395	}
   396	
   397	static int
   398	hev_config_parse_doc (yaml_document_t *doc)
   399	{
   400	    yaml_node_t *root;
   401	    yaml_node_pair_t *pair;
   402	    int min_task_stack_size;
   403	    int udp_buffer_size;
   404	
   405	    root = yaml_document_get_root_node (doc);
   405	    root = yaml_document_get_root_node (doc);
   406	    if (!root || YAML_MAPPING_NODE != root->type)
   407	        return -1;
   408	
   409	    for (pair = root->data.mapping.pairs.start;
   410	         pair < root->data.mapping.pairs.top; pair++) {
   411	        yaml_node_t *node;
   412	        const char *key;
   413	        int res = 0;
   414	
   415	        if (!pair->key || !pair->value)
   416	            break;
   417	
   418	        node = yaml_document_get_node (doc, pair->key);
   419	        if (!node || YAML_SCALAR_NODE != node->type)
   420	            break;
   421	
   422	        key = (const char *)node->data.scalar.value;
   423	        node = yaml_document_get_node (doc, pair->value);
   424	
   425	        if (0 == strcmp (key, "tunnel"))
   426	            res = hev_config_parse_tunnel (doc, node);
   427	        else if (0 == strcmp (key, "socks5"))
   428	            res = hev_config_parse_socks5 (doc, node);
   429	        else if (0 == strcmp (key, "mapdns"))
   430	            res = hev_config_parse_mapdns (doc, node);
   431	        else if (0 == strcmp (key, "misc"))
   432	            res = hev_config_parse_misc (doc, node);
   433	
   434	        if (res < 0)
   435	            return -1;
   436	    }
   437	
   438	    if (tcp_buffer_size > TCP_SND_BUF)
   439	        tcp_buffer_size = TCP_SND_BUF;
   440	
   441	    udp_buffer_size = UDP_BUF_SIZE * udp_copy_buffer_nums;
   442	
   443	    if (tcp_buffer_size > udp_buffer_size)
   444	        min_task_stack_size = TASK_STACK_SIZE + tcp_buffer_size;
   445	    else
   446	        min_task_stack_size = TASK_STACK_SIZE + udp_buffer_size;
   447	
   448	    if (task_stack_size < min_task_stack_size)
   449	        task_stack_size = min_task_stack_size;
   450	
   451	    return 0;
   452	}
   453	
   454	int
   455	hev_config_init_from_file (const char *config_path)
   456	{
   457	    yaml_parser_t parser;
   458	    yaml_document_t doc;
   459	    FILE *fp;
   460	    int res = -1;
   461	
   462	    if (!yaml_parser_initialize (&parser))
   463	        goto exit;
   464	
   465	    fp = fopen (config_path, "r");
   466	    if (!fp) {
   467	        fprintf (stderr, "Open %s failed!\n", config_path);
   468	        goto exit_free_parser;
   469	    }
   470	
   471	    yaml_parser_set_input_file (&parser, fp);
   472	    if (!yaml_parser_load (&parser, &doc)) {
   473	        fprintf (stderr, "Parse %s failed!\n", config_path);
   474	        goto exit_close_fp;
   475	    }
   476	
   477	    res = hev_config_parse_doc (&doc);
   478	    yaml_document_delete (&doc);
   479	
   480	exit_close_fp:
   481	    fclose (fp);
   482	exit_free_parser:
   483	    yaml_parser_delete (&parser);
   484	exit:
   485	    return res;
   486	}
   487	
   488	int
   489	hev_config_init_from_str (const unsigned char *config_str,
   490	                          unsigned int config_len)
   491	{
   492	    yaml_parser_t parser;
   493	    yaml_document_t doc;
   494	    int res = -1;
   495	
   496	    if (!yaml_parser_initialize (&parser))
   497	        goto exit;
   498	
   499	    yaml_parser_set_input_string (&parser, config_str, config_len);
   500	    if (!yaml_parser_load (&parser, &doc)) {
   501	        fprintf (stderr, "Failed to parse config.");
   502	        goto exit_free_parser;
   503	    }
   504	
   505	    res = hev_config_parse_doc (&doc);
   506	    yaml_document_delete (&doc);
   507	
   508	exit_free_parser:
   509	    yaml_parser_delete (&parser);
   510	exit:
   511	    return res;
   512	}
