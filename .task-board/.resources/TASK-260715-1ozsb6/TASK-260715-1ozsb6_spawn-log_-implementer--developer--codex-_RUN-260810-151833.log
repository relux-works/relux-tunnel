  1887	  private func reconcileProtectedMetrics() async {
  1888	    guard let baseline = protectedNetworkBaseline else { return }
  1889	    let current = context.network.engineByteCounts
  1890	    let sent = current.sent - baseline.sent
  1891	    let received = current.received - baseline.received
  1892	    if sent > counters.protectedBytesSent {
  1893	      await metric(.increment(.protectedBytesSent, by: sent - counters.protectedBytesSent))
  1894	      counters.protectedBytesSent = sent
  1895	    }
  1896	    if received > counters.protectedBytesReceived {
  1897	      await metric(
  1898	        .increment(.protectedBytesReceived, by: received - counters.protectedBytesReceived))
  1899	      counters.protectedBytesReceived = received
  1900	    }
  1901	  }
