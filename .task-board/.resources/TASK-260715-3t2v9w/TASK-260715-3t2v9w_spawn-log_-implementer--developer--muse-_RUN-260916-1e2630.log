{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c457","stream":{"kind":"session","id":"01a0aa7a-9815-7302-a96f-7a8fde67c84b"},"sequence":134,"recorded_at":1780531400000263,"record_type":"event","durability":"durable","causation_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","run_stream":{"kind":"run","id":"7cb39f37-e5ea-43fc-a612-eaf97474622d"},"task_stream":{"kind":"task","id":"01a0aa7a-e81c-7800-9eaf-24183c20746b"},"task_id":"01a0aa7a-e81c-7800-9eaf-24183c20746b","event":{"kind":"output","task_id":"01a0aa7a-e81c-7800-9eaf-24183c20746b","chunk":"Read text file `Sources/ReluxTunnelCore/SSHContracts.swift`.\n1|import CryptoKit\n2|import Foundation\n3|\n4|// MARK: - Identities and validation\n5|\n6|/// Opaque runtime identity for one immutable SSH lane.\n7|///\n8|/// Callers must generate this value independently of profile, host, user,\n9|/// destination, fingerprint, and credential data.\n10|public struct SSHLaneIdentity: Hashable, Sendable {\n11|  public let rawValue: UUID\n12|\n13|  public init(rawValue: UUID) {\n14|    self.rawValue = rawValue\n15|  }\n16|}\n17|\n18|/// Opaque connection-local channel correlation identity with no routing meaning.\n19|public struct SSHChannelIdentity: Hashable, Sendable {\n20|  public let rawValue: UUID\n21|\n22|  public init(rawValue: UUID) {\n23|    self.rawValue = rawValue\n24|  }\n25|}\n26|\n27|/// Opaque identity for one authenticated SSH session.\n28|public struct SSHSessionIdentity: Hashable, Sendable {\n29|  public let rawValue: UUID\n30|\n31|  public init(rawValue: UUID) {\n32|    self.rawValue = rawValue\n33|  }\n34|}\n35|\n36|public struct SSHCredentialReference: Hashable, Sendable {\n37|  public let rawValue: String\n38|\n39|  public init(rawValue: String) {\n40|    self.rawValue = rawValue\n41|  }\n42|}\n43|\n44|public struct SSHTrustRecordReference: Hashable, Sendable {\n45|  public let rawValue: String\n46|\n47|  public init(rawValue: String) {\n48|    self.rawValue = rawValue\n49|  }\n50|}\n51|\n52|public enum SSHValidationField: String, Equatable, Sendable {\n53|  case canonicalHostname\n54|  case endpointHost\n55|  case endpointPort\n56|  case username\n57|  case profileReference\n58|  case credentialReference\n59|  case credentialGeneration\n60|  case trustRecordReference\n61|  case keyExchangeAlgorithms\n62|  case hostKeyAlgorithms\n63|  case cipherAlgorithms\n64|  case macAlgorithms\n65|  case hostKeyAlgorithm\n66|  case hostKeyBytes\n67|  case execCommand\n68|  case maximumReadBytes\n69|  case initialReceiveWindowBytes\n70|  case maximumAdvertisedReceiveWindowBytes\n71|  case windowAdjustThresholdBytes\n72|  case maximumBufferedReadBytes\n73|  case maximumQueuedWriteBytes\n74|  case maximumWriteCallBytes\n75|  case uploadChunkBytes\n76|  case protectedByteThresholdPerDirection\n77|  case rekeyElapsedTimeThreshold\n78|  case rekeyTimeout\n79|  case keepaliveInterval\n80|  case keepaliveReplyTimeout\n81|  case allowedConsecutiveKeepaliveMisses\n82|  case resolutionTimeout\n83|  case tcpConnectTimeout\n84|  case initialKeyExchangeTimeout\n85|  case hostDecisionTimeout\n86|  case credentialLookupTimeout\n87|  case authenticationTimeout\n88|  case channelOpenTimeout\n89|  case writeCreditWaitTimeout\n90|  case explicitRekeyTimeout\n91|  case keepaliveReplyPolicyTimeout\n92|  case execExitTimeout\n93|  case uploadTimeout\n94|  case channelCloseTimeout\n95|  case transportCloseTimeout\n96|}\n97|\n98|public enum SSHContractValidationError: Error, Equatable, Sendable {\n99|  case empty(SSHValidationField)\n100|  case nonPositive(SSHValidationField)\n101|  case negative(SSHValidationField)\n102|  case initialReceiveWindowExceedsCap\n103|  case windowAdjustThresholdExceedsCap\n104|  case uploadChunkExceedsWriteCallLimit\n105|  case invalidAddressByteCount(expected: Int, actual: Int)\n106|  case invalidWindowSnapshot\n107|  case invalidWindowAdjustment\n108|  case initialReceiveWindowPolicyMismatch\n109|  case channelOpenReasonRequired\n110|  case channelOpenReasonUnexpected\n111|}\n112|\n113|// MARK: - Conformance tiers and deferred evidence\n114|\n115|public enum SSHConformanceTier: Equatable, Sendable {\n116|  case m0ViabilityMandatory\n117|  case m3Deferred(ownerTaskID: String)\n118|}\n119|\n120|/// Exhaustive candidate-neutral classification of the SSH transport contract.\n121|///\n122|/// M3 entries remain binding obligations. Their evidence may be unavailable at\n123|/// M0, but adapters must report that state instead of inventing a value.\n124|public enum SSHConformanceRequirement: String, CaseIterable, Hashable, Sendable {\n125|  case appleTargetIntegration\n126|  case candidateNeutralInjection\n127|  case hostKeyBeforeAuthentication\n128|  case approvedPublicKeyAuthentication\n129|  case approvedAlgorithmPolicy\n130|  case directTCPIP\n131|  case execAndStdinUpload\n132|  case clientInitiatedRekey\n133|  case serverInitiatedRekeyHandling\n134|  case boundedBuffersAndBackpressure\n135|  case deterministicCancellation\n136|  case boundedLifecycle\n137|  case keychainOnlySecrets\n138|  case privacySafeErrors\n139|  case connectionKeepalive\n140|  case availableObservability\n141|  case consumerDrivenReceiveWindowCredit\n142|  case rfcChannelOpenFailureReasons\n143|  case exactExecExitMetadata\n144|  case deepRekeyAndKeepaliveObservability\n145|\n146|  public var tier: SSHConformanceTier {\n147|    switch self {\n148|    case .consumerDrivenReceiveWindowCredit,\n149|      .rfcChannelOpenFailureReasons,\n150|      .exactExecExitMetadata,\n151|      .deepRekeyAndKeepaliveObservability:\n152|      .m3Deferred(ownerTaskID: \"TASK-260728-3cveay\")\n153|    default:\n154|      .m0ViabilityMandatory\n155|    }\n156|  }\n157|}\n158|\n159|/// Evidence state for a semantic whose exact reporting is deferred to M3.\n160|public enum SSHDeferredSemanticReport<Value: Sendable>: Sendable {\n161|  case reported(Value)\n162|  case notReported\n163|  case unsupported\n164|}\n165|\n166|extension SSHDeferredSemanticReport: Equatable where Value: Equatable {}\n167|\n168|public enum SSHDeferredSemanticAvailability: String, Equatable, Sendable {\n169|  case reported\n170|  case notReported\n171|  case unsupported\n172|}\n173|\n174|/// Factory-level disclosure for all four M3-deferred semantics.\n175|public struct SSHDeferredSemanticCapabilities: Equatable, Sendable {\n176|  public let consumerDrivenReceiveWindowCredit: SSHDeferredSemanticAvailability\n177|  public let rfcChannelOpenFailureReasons: SSHDeferredSemanticAvailability\n178|  public let exactExecExitMetadata: SSHDeferredSemanticAvailability\n179|  public let deepRekeyAndKeepaliveObservability: SSHDeferredSemanticAvailability\n180|\n181|  public init(\n182|    consumerDrivenReceiveWindowCredit: SSHDeferredSemanticAvailability,\n183|    rfcChannelOpenFailureReasons: SSHDeferredSemanticAvailability,\n184|    exactExecExitMetadata: SSHDeferredSemanticAvailability,\n185|    deepRekeyAndKeepaliveObservability: SSHDeferredSemanticAvailability\n186|  ) {\n187|    self.consumerDrivenReceiveWindowCredit = consumerDrivenReceiveWindowCredit\n188|    self.rfcChannelOpenFailureReasons = rfcChannelOpenFailureReasons\n189|    self.exactExecExitMetadata = exactExecExitMetadata\n190|    self.deepRekeyAndKeepaliveObservability = deepRekeyAndKeepaliveObservability\n191|  }\n192|}\n193|\n194|// MARK: - Network and injected dependencies\n195|\n196|public enum SSHNetworkAddressFamily: Equatable, Sendable {\n197|  case ipv4\n198|  case ipv6\n199|}\n200|\n201|/// A resolved network address. This value is input to the network seam only and\n202|/// must never be copied into default diagnostics.\n203|public struct SSHResolvedEndpoint: Equatable, Sendable {\n204|  public let addressFamily: SSHNetworkAddressFamily\n205|  public let addressBytes: Data\n206|  public let port: UInt16\n207|\n208|  public init(\n209|    addressFamily: SSHNetworkAddressFamily,\n210|    addressBytes: Data,\n211|    port: UInt16\n212|  ) throws {\n213|    let expectedCount = addressFamily == .ipv4 ? 4 : 16\n214|    guard addressBytes.count == expectedCount else {\n215|      throw SSHContractValidationError.invalidAddressByteCount(\n216|        expected: expectedCount,\n217|        actual: addressBytes.count\n218|      )\n219|    }\n220|    guard port > 0 else {\n221|      throw SSHContractValidationError.nonPositive(.endpointPort)\n222|    }\n223|    self.addressFamily = addressFamily\n224|    self.addressBytes = addressBytes\n225|    self.port = port\n226|  }\n227|}\n228|\n229|public protocol SSHNetworkResolver: Sendable {\n230|  func resolve(hostname: String, port: UInt16) async throws -> [SSHResolvedEndpoint]\n231|}\n232|\n233|public enum SSHTCPReadiness: Hashable, Sendable {\n234|  case readable\n235|  case writable\n236|}\n237|\n238|/// Candidate-neutral nonblocking TCP connection used by an SSH adapter.\n239|public protocol SSHTCPConnection: AnyObject, Sendable {\n240|  func waitForReadiness(_ interests: Set<SSHTCPReadiness>) async throws\n241|    -> Set<SSHTCPReadiness>\n242|  func readSome(maximumBytes: Int) async throws -> Data?\n243|  func writeSome(_ bytes: Data) async throws -> Int\n244|  func close() async\n245|}\n246|\n247|public protocol SSHTCPConnector: Sendable {\n248|  func connect(to endpoint: SSHResolvedEndpoint) async throws -> any SSHTCPConnection\n249|}\n250|\n251|public protocol SSHIdentityGenerator: Sendable {\n252|  func makeLaneIdentity() -> SSHLaneIdentity\n253|  func makeSessionIdentity() -> SSHSessionIdentity\n254|  func makeChannelIdentity() -> SSHChannelIdentity\n255|}\n256|\n257|public protocol SSHPublicKeyCredential: Sendable {\n258|  var algorithm: String { get }\n259|  var publicKeyBytes: Data { get }\n260|  func sign(_ payload: Data) async throws -> Data\n261|  func retire()\n262|}\n263|\n264|extension SSHPublicKeyCredential {\n265|  /// Releases credential-owned signing state after authentication or cancellation.\n266|  /// Implementations that own mutable secret storage should clear it here.\n267|  public func retire() {}\n268|}\n269|\n270|public protocol SSHCredentialProvider: Sendable {\n271|  func credential(for request: SSHCredentialRequest) async throws\n272|    -> any SSHPublicKeyCredential\n273|}\n274|\n275|public protocol SSHTransportObserver: Sendable {\n276|  func observe(_ event: SSHTransportEvent) async\n277|}\n278|\n279|/// A privacy-safe logger: callers can emit only the typed event schema.\n280|public protocol SSHTransportLogger: Sendable {\n281|  func log(level: TunnelLogLevel, event: SSHTransportEvent) async\n282|}\n283|\n284|public protocol SSHTransportMetricsSink: Sendable {\n285|  func record(_ update: SSHMetricUpdate) async\n286|}\n287|\n288|/// Optional harness sink. Candidate labels belong to the recorder's harness\n289|/// registration and are deliberately absent from this runtime record.\n290|public protocol SSHExperimentRecorder: Sendable {\n291|  func record(_ observation: SSHExperimentObservation) async\n292|}\n293|\n294|public struct SSHTransportDependencies: Sendable {\n295|  public let resolver: any SSHNetworkResolver\n296|  public let connector: any SSHTCPConnector\n297|  public let hostKeyPolicy: any SSHHostKeyPolicy\n298|  public let credentialProvider: any SSHCredentialProvider\n299|  public let clock: any TunnelClock\n300|  public let cancellation: any TunnelCancellationChecking\n301|  public let logger: any SSHTransportLogger\n302|  public let observer: any SSHTransportObserver\n303|  public let metrics: any SSHTransportMetricsSink\n304|  public let identityGenerator: any SSHIdentityGenerator\n305|  public let experimentRecorder: (any SSHExperimentRecorder)?\n306|\n307|  public init(\n308|    resolver: any SSHNetworkResolver,\n309|    connector: any SSHTCPConnector,\n310|    hostKeyPolicy: any SSHHostKeyPolicy,\n311|    credentialProvider: any SSHCredentialProvider,\n312|    clock: any TunnelClock,\n313|    cancellation: any TunnelCancellationChecking,\n314|    logger: any SSHTransportLogger,\n315|    observer: any SSHTransportObserver,\n316|    metrics: any SSHTransportMetricsSink,\n317|    identityGenerator: any SSHIdentityGenerator,\n318|    experimentRecorder: (any SSHExperimentRecorder)? = nil\n319|  ) {\n320|    self.resolver = resolver\n321|    self.connector = connector\n322|    self.hostKeyPolicy = hostKeyPolicy\n323|    self.credentialProvider = credentialProvider\n324|    self.clock = clock\n325|    self.cancellation = cancellation\n326|    self.logger = logger\n327|    self.observer = observer\n328|    self.metrics = metrics\n329|    self.identityGenerator = identityGenerator\n330|    self.experimentRecorder = experimentRecorder\n331|  }\n332|}\n333|\n334|// MARK: - Host verification and credentials\n335|\n336|public struct SSHHostKeyEvidence: Equatable, Sendable, CustomStringConvertible,\n337|  CustomDebugStringConvertible\n338|{\n339|  public let algorithm: String\n340|  public let keyBytes: Data\n341|  public let fingerprint: String\n342|\n343|  public init(algorithm: String, keyBytes: Data) throws {\n344|    guard !algorithm.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {\n345|      throw SSHContractValidationError.empty(.hostKeyAlgorithm)\n346|    }\n347|    guard !keyBytes.isEmpty else {\n348|      throw SSHContractValidationError.empty(.hostKeyBytes)\n349|    }\n350|    self.algorithm = algorithm\n351|    self.keyBytes = keyBytes\n352|    self.fingerprint = Self.sha256Fingerprint(for: keyBytes)\n353|  }\n354|\n355|  public static func sha256Fingerprint(for keyBytes: Data) -> String {\n356|    let digest = SHA256.hash(data: keyBytes)\n357|    let encoded = Data(digest).base64EncodedString().replacingOccurrences(of: \"=\", with: \"\")\n358|    return \"SHA256:\\(encoded)\"\n359|  }\n360|\n361|  /// Raw host-key bytes and fingerprints are restricted to the host-policy scope.\n362|  public var description: String { \"SSHHostKeyEvidence(<redacted>)\" }\n363|  public var debugDescription: String { description }\n364|}\n365|\n366|public struct SSHHostKeyPolicyInput: Equatable, Sendable, CustomStringConvertible,\n367|  CustomDebugStringConvertible\n368|{\n369|  public let canonicalHostname: String\n370|  public let connectedEndpoint: TunnelEndpoint\n371|  public let evidence: SSHHostKeyEvidence\n372|  public let lane: SSHLaneIdentity\n373|  public let trustRecordReference: SSHTrustRecordReference?\n374|\n375|  public init(\n376|    canonicalHostname: String,\n377|    connectedEndpoint: TunnelEndpoint,\n378|    evidence: SSHHostKeyEvidence,\n379|    lane: SSHLaneIdentity,\n380|    trustRecordReference: SSHTrustRecordReference?\n381|  ) {\n382|    self.canonicalHostname = canonicalHostname\n383|    self.connectedEndpoint = connectedEndpoint\n384|    self.evidence = evidence\n385|    self.lane = lane\n386|    self.trustRecordReference = trustRecordReference\n387|  }\n388|\n389|  public var description: String { \"SSHHostKeyPolicyInput(<redacted>)\" }\n390|  public var debugDescription: String { description }\n391|}\n392|\n393|public enum SSHHostKeyDecision: Equatable, Sendable {\n394|  /// Candidate-neutral test and adapter seam for an already-approved match.\n395|  case acceptMatch(SSHTrustRecordReference)\n396|  /// Production snapshot-backed approval with privacy-safe record metadata.\n397|  case acceptApproved(SSHApprovedHostIdentityMatch)\n398|  case trustRequired(SSHHostTrustRequiredEvidence)\n399|  case rejectChanged\n400|  case rejectRevoked(SSHHostIdentityAuditMetadata)\n401|  case rejectAlgorithm\n402|  case rejectHostMismatch\n403|  case rejectMalformed\n404|  case rejectPolicy\n405|}\n406|\n407|public enum SSHHostDecisionOutcome: String, Equatable, Sendable {\n408|  case matchAccepted\n409|  case trustRequired\n410|  case changedRejected\n411|  case revokedRejected\n412|  case algorithmRejected\n413|  case hostMismatchRejected\n414|  case malformedRejected\n415|  case policyRejected\n416|}\n417|\n418|public protocol SSHHostKeyPolicy: Sendable {\n419|  func evaluate(_ input: SSHHostKeyPolicyInput) async throws -> SSHHostKeyDecision\n420|}\n421|\n422|/// Proof that the host policy returned an accepting decision for exact evidence.\n423|/// Credential requests require this value, making rejection an invalid typed path.\n424|public struct SSHHostKeyAcceptance: Equatable, Sendable, CustomStringConvertible,\n425|  CustomDebugStringConvertible\n426|{\n427|  public let identity: SSHVerifiedHostIdentity\n428|  public let lane: SSHLaneIdentity\n429|  public let outcome: SSHHostDecisionOutcome\n430|  public let trustRecordReference: SSHTrustRecordReference\n431|  public let auditMetadata: SSHHostIdentityAuditMetadata?\n432|\n433|  fileprivate init(\n434|    identity: SSHVerifiedHostIdentity,\n435|    lane: SSHLaneIdentity,\n436|    outcome: SSHHostDecisionOutcome,\n437|    trustRecordReference: SSHTrustRecordReference,\n438|    auditMetadata: SSHHostIdentityAuditMetadata?\n439|  ) {\n440|    self.identity = identity\n441|    self.lane = lane\n442|    self.outcome = outcome\n443|    self.trustRecordReference = trustRecordReference\n444|    self.auditMetadata = auditMetadata\n445|  }\n446|\n447|  public var description: String { \"SSHHostKeyAcceptance(<redacted>)\" }\n448|  public var debugDescription: String { description }\n449|}\n450|\n451|public enum SSHHostAcceptanceError: Error, Equatable, Sendable {\n452|  case rejected(SSHHostDecisionOutcome)\n453|}\n454|\n455|extension SSHHostKeyDecision {\n456|  public var outcome: SSHHostDecisionOutcome {\n457|    switch self {\n458|    case .acceptMatch, .acceptApproved:\n459|      .matchAccepted\n460|    case .trustRequired:\n461|      .trustRequired\n462|    case .rejectChanged:\n463|      .changedRejected\n464|    case .rejectRevoked:\n465|      .revokedRejected\n466|    case .rejectAlgorithm:\n467|      .algorithmRejected\n468|    case .rejectHostMismatch:\n469|      .hostMismatchRejected\n470|    case .rejectMalformed:\n471|      .malformedRejected\n472|    case .rejectPolicy:\n473|      .policyRejected\n474|    }\n475|  }\n476|\n477|  public func acceptance(for input: SSHHostKeyPolicyInput) throws -> SSHHostKeyAcceptance {\n478|    switch self {\n479|    case .acceptMatch(let reference):\n480|      guard !reference.rawValue.isEmpty else {\n481|        throw SSHContractValidationError.empty(.trustRecordReference)\n482|      }\n483|      return SSHHostKeyAcceptance(\n484|        identity: SSHVerifiedHostIdentity(\n485|          algorithm: input.evidence.algorithm,\n486|          fingerprintSHA256: input.evidence.fingerprint\n487|        ),\n488|        lane: input.lane,\n489|        outcome: .matchAccepted,\n490|        trustRecordReference: reference,\n491|        auditMetadata: nil\n492|      )\n493|    case .acceptApproved(let match):\n494|      return SSHHostKeyAcceptance(\n495|        identity: match.identity,\n496|        lane: input.lane,\n497|        outcome: .matchAccepted,\n498|        trustRecordReference: match.trustRecordReference,\n499|        auditMetadata: match.auditMetadata\n500|      )\n(more lines below)","final_result":true}}}
