   812	    var interests = Set<SSHTCPReadiness>()
   813	    if directions & LIBSSH2_SESSION_BLOCK_INBOUND != 0 { interests.insert(.readable) }
   814	    if directions & LIBSSH2_SESSION_BLOCK_OUTBOUND != 0 { interests.insert(.writable) }
   815	    if interests.isEmpty { interests = [.readable, .writable] }
   816	    let requestedInterests = interests
   817	    try await withTimeout(remaining, clock: dependencies.clock) {
   818	      try await withTaskCancellationHandler {
   819	        try await self.context.network.service(
   820	          connection: connection,
   821	          interests: requestedInterests
   822	        )
   823	      } onCancel: {
