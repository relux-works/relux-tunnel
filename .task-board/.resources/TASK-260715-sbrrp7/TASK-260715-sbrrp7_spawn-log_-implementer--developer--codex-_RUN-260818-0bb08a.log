+awk '/^[[:space:]]+\// { print $1 }' "$task_output/provider-release-linkage.log" |
+  while IFS= read -r dependency; do
+    case "$dependency" in
+      /usr/lib/*|/System/Library/Frameworks/*) ;;
+      *)
+        echo "error: disallowed provider dynamic dependency: $dependency" >&2
