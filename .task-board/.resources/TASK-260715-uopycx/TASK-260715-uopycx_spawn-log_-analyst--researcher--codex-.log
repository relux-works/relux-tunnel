   356	static int
   357	tunnel_init (int extern_tun_fd)
   358	{
   359	    const char *script_path, *name, *ipv4, *ipv6;
   360	    int multi_queue, res;
   361	    unsigned int mtu;
   362	
   363	    if (extern_tun_fd >= 0) {
   364	        int nonblock = 1;
   365	
   366	        res = ioctl (extern_tun_fd, FIONBIO, (char *)&nonblock);
   367	        if (res < 0) {
   368	            LOG_E ("socks5 tunnel non-blocking");
   369	            return -1;
   370	        }
   371	
   372	        tun_fd = extern_tun_fd;
   373	        return 0;
   374	    }
   375	
   376	    name = hev_config_get_tunnel_name ();
   377	    multi_queue = hev_config_get_tunnel_multi_queue ();
   378	    tun_fd = hev_tunnel_open (name, multi_queue);
   379	    if (tun_fd < 0) {
   380	        LOG_E ("socks5 tunnel open (%s)", strerror (errno));
   381	        return -1;
   382	    }
   383	
   384	    mtu = hev_config_get_tunnel_mtu ();
   385	    res = hev_tunnel_set_mtu (mtu);
   386	    if (res < 0) {
   387	        LOG_E ("socks5 tunnel mtu");
   388	        return -1;
   389	    }
   390	
   391	    ipv4 = hev_config_get_tunnel_ipv4_address ();
   392	    if (ipv4) {
   393	        res = hev_tunnel_set_ipv4 (ipv4, 32);
   394	        if (res < 0) {
   395	            LOG_E ("socks5 tunnel ipv4");
   396	            return -1;
   397	        }
   398	    }
   399	
   400	    ipv6 = hev_config_get_tunnel_ipv6_address ();
   401	    if (ipv6) {
   402	        res = hev_tunnel_set_ipv6 (ipv6, 128);
   403	        if (res < 0) {
   404	            LOG_E ("socks5 tunnel ipv6");
   405	            return -1;
   406	        }
   407	    }
   408	
   409	    res = hev_tunnel_set_state (1);
   410	    if (res < 0) {
   411	        LOG_E ("socks5 tunnel state");
   412	        return -1;
   413	    }
   414	
   415	    script_path = hev_config_get_tunnel_post_up_script ();
   416	    if (script_path)
   417	        hev_exec_run (script_path, hev_tunnel_get_name (),
   418	                      hev_tunnel_get_index (), 0);
   419	
   420	    tun_fd_local = 1;
   421	    return 0;
   422	}
   423	
   424	static void
   425	tunnel_fini (void)
   426	{
   427	    const char *script_path;
   428	
   429	    if (!tun_fd_local)
   430	        return;
   431	
   432	    script_path = hev_config_get_tunnel_pre_down_script ();
   433	    if (script_path)
   434	        hev_exec_run (script_path, hev_tunnel_get_name (),
   435	                      hev_tunnel_get_index (), 1);
   436	
   437	    hev_tunnel_close (tun_fd);
   438	    tun_fd_local = 0;
   439	    tun_fd = -1;
   440	}
   441	
   442	static int
   443	gateway_init (void)
   444	{
   445	    ip4_addr_t addr4, mask, gw;
   446	    ip6_addr_t addr6;
   447	
   448	    netif_add_noaddr (&netif, NULL, netif_init_handler, ip_input);
   449	
   450	    ip4_addr_set_loopback (&addr4);
   451	    ip4_addr_set_any (&mask);
   452	    ip4_addr_set_any (&gw);
   453	    netif_set_addr (&netif, &addr4, &mask, &gw);
   454	
   455	    ip6_addr_set_loopback (&addr6);
   490	
   491	    res = socketpair (PF_LOCAL, SOCK_STREAM, 0, event_fds);
   492	    if (res < 0) {
   493	        LOG_E ("socks5 tunnel event");
   494	        return -1;
   495	    }
   496	
   497	    res = ioctl (event_fds[0], FIONBIO, (char *)&nonblock);
   498	    if (res < 0) {
   499	        LOG_E ("socks5 tunnel event nonblock");
   500	        return -1;
   501	    }
   502	
   503	    task_event = hev_task_new (-1);
   504	    if (!task_event) {
   505	        LOG_E ("socks5 tunnel task event");
   506	        return -1;
   507	    }
   508	
   509	    return 0;
   510	}
   511	
   512	static void
   513	event_task_fini (void)
   514	{
   515	    if (task_event) {
   516	        hev_task_unref (task_event);
   517	        task_event = NULL;
   518	    }
   519	
   520	    if (event_fds[0] >= 0) {
   521	        close (event_fds[0]);
   522	        event_fds[0] = -1;
   523	    }
   524	    if (event_fds[1] >= 0) {
   525	        close (event_fds[1]);
   526	        event_fds[1] = -1;
   527	    }
   528	}
