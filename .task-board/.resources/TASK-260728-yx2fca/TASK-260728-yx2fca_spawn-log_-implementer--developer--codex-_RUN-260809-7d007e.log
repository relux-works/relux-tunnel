+  ) {
+    self.consumerDrivenReceiveWindowCredit = consumerDrivenReceiveWindowCredit
+    self.rfcChannelOpenFailureReasons = rfcChannelOpenFailureReasons
+    self.exactExecExitMetadata = exactExecExitMetadata
