   887	    guard self.event == nil else {
   888	      lock.unlock()
   889	      return false
   890	    }
   891	    self.event = event
   892	    let waiter = waiter
   893	    self.waiter = nil
   894	    lock.unlock()
   895	    waiter?.resume(returning: event)
