    #expect(error.domain == ProviderNSErrorCode.errorDomain)
    #expect(error.code == ProviderNSErrorCode.runtimeStartupFailed.rawValue)
    #expect(error.userInfo.isEmpty)
    await runtime.waitUntilStopEntered()

