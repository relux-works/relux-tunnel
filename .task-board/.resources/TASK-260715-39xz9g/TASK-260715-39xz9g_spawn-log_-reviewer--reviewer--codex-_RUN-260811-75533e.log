   359	class EndpointListener:
   360	    """Task-owned numeric-loopback listener for one destination behavior."""
   361	
   362	    def __init__(self, mode: str):
   363	        if mode not in REQUIRED_ENDPOINTS:
   364	            raise FixtureError(f"unsupported endpoint mode {mode!r}")
   365	        self.mode = mode
   366	        self.results: list[EndpointResult] = []
   367	        self._lock = threading.Lock()
   368	        self._connections: set[socket.socket] = set()
   369	        self._listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
   370	        self._listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
   371	        self._listener.bind(("127.0.0.1", 0))
   372	        self._listener.listen()
   373	        self._listener.settimeout(0.1)
   374	        self.host, self.port = self._listener.getsockname()
   375	        self._stopped = threading.Event()
   376	        self._thread = threading.Thread(target=self._accept, daemon=True)
   377	        self._thread.start()
   378	
   379	    def _accept(self) -> None:
   380	        while not self._stopped.is_set():
   381	            try:
   382	                connection, _ = self._listener.accept()
   383	            except TimeoutError:
   384	                continue
   385	            except OSError:
   386	                break
   387	            with self._lock:
   388	                self._connections.add(connection)
   389	            threading.Thread(
   390	                target=self._serve,
   391	                args=(connection,),
   392	                daemon=True,
   393	            ).start()
   394	
   395	    def _serve(self, connection: socket.socket) -> None:
   396	        try:
   397	            result = serve_endpoint(connection, self.mode)
   398	            with self._lock:
   399	                self.results.append(result)
   400	        except OSError:
   401	            pass
   402	        finally:
   403	            with self._lock:
   404	                self._connections.discard(connection)
   405	            connection.close()
   406	
   407	    def stop(self) -> None:
   408	        self._stopped.set()
   409	        self._listener.close()
   410	        with self._lock:
   411	            connections = list(self._connections)
   412	        for connection in connections:
   413	            try:
   414	                connection.shutdown(socket.SHUT_RDWR)
   415	            except OSError:
   416	                pass
   417	            connection.close()
   418	        self._thread.join(timeout=2)
   419	
   420	    def public_address(self) -> dict[str, object]:
   421	        return {"host": self.host, "port": self.port}
