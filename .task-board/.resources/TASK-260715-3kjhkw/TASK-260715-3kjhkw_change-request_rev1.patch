+import Foundation
+import Synchronization
+import Testing
+
+@testable import ReluxTunnelCore
+
+@Suite("Advisory memory sampling and watermark control")
+struct MemoryWatermarkControllerTests {
+  @Test("system service reports public-platform availability without a proxy")
+  func systemServiceAvailability() {
+    let result = SystemMemoryPlatformSamplingService().sampleCurrentProcessMemory()
+    #expect(result.physicalFootprint.bytes != nil)
+    #expect(result.physicalFootprintPeak.bytes != nil)
+    #expect(result.physicalFootprintPeak.bytes! >= result.physicalFootprint.bytes!)
+    #if os(iOS)
+      #expect(result.advisoryAvailableMemory.bytes != nil)
+    #else
+      #expect(
+        result.advisoryAvailableMemory
+          == .unavailable(
+            reason: .unsupportedPlatform, provenance: .osProcessAvailableMemory))
+    #endif
+  }
+
+  @Test("system sampling has bounded low-frequency overhead")
+  func systemSamplingOverhead() {
+    let service = SystemMemoryPlatformSamplingService()
+    let clock = ContinuousClock()
+    let startedAt = clock.now
+    var maximum = Duration.zero
+    for _ in 0..<256 {
+      let sampleStartedAt = clock.now
+      _ = service.sampleCurrentProcessMemory()
+      maximum = max(maximum, sampleStartedAt.duration(to: clock.now))
+    }
+    let total = startedAt.duration(to: clock.now)
+    print("MEMORY_SAMPLER_OVERHEAD samples=256 total=\(total) maximum=\(maximum)")
+    #expect(total < .seconds(2))
+    #expect(maximum < .seconds(1))
+  }
+
+  @Test("configuration rejects inverted hysteresis and unbounded history")
+  func configurationValidation() throws {
+    #expect(throws: MemoryWatermarkConfigurationError.invalidThresholdOrder) {
+      _ = try MemorySignalThresholds(
+        criticalEnterBytes: 10,
+        pressureEnterBytes: 9,
+        softEnterBytes: 30,
+        criticalExitBytes: 15,
+        pressureExitBytes: 25,
+        softExitBytes: 35)
+    }
+    #expect(throws: MemoryWatermarkConfigurationError.invalidHistoryLimit) {
+      _ = try configuration(historyLimit: 1_025)
+    }
+    #expect(throws: MemoryWatermarkConfigurationError.invalidDuration) {
+      _ = try configuration(minimumEventInterval: .zero)
+    }
+  }
+
+  @Test("each observation is fresh, complete, byte-unit evidence")
+  func freshObservationContract() async throws {
+    let clock = ManualMemoryClock()
+    let service = ScriptedMemoryService([
+      sample(advisory: 900),
+      sample(advisory: nil),
+    ])
+    let controller = MemoryWatermarkController(
+      configuration: try configuration(), platform: service, clock: clock)
+
+    let first = try observed(
+      await controller.observe(trigger: .admission, ledger: ledger(clock: clock)))
+    let second = try observed(
+      await controller.observe(trigger: .release, ledger: ledger(clock: clock)))
+
+    #expect(service.callCount == 2)
+    #expect(first.sequence == 1)
+    #expect(second.sequence == 2)
+    #expect(first.configurationGeneration == 1)
+    #expect(first.unit == .bytes)
+    #expect(first.physicalFootprint.bytes == 100)
+    #expect(first.physicalFootprintPeak.bytes == 120)
+    #expect(first.advisoryAvailableMemory.bytes == 900)
+    #expect(first.ledger == ledger(clock: clock))
+    #expect(first.ledger.provenance == .sharedMemoryLedger)
+    #expect(
+      second.advisoryAvailableMemory
+        == .unavailable(reason: .systemCallFailed, provenance: .osProcessAvailableMemory))
+  }
+
+  @Test("entry boundaries are inclusive and can jump directly to maximum severity")
+  func thresholdBoundaries() async throws {
+    let clock = ManualMemoryClock()
+    let service = ScriptedMemoryService(
+      Array(repeating: sample(), count: 6),
+      onSample: { clock.advance(by: .milliseconds(5)) })
+    let controller = MemoryWatermarkController(
+      configuration: try configuration(), platform: service, clock: clock)
+
+    let soft = try observed(
+      await controller.observe(
+        trigger: .admission, ledger: ledger(clock: clock, committed: 970)))
+    #expect(soft.state == .soft)
+    #expect(soft.transition?.reason == .ledgerHeadroom)
+
+    let pressure = try observed(
+      await controller.observe(
+        trigger: .release, ledger: ledger(clock: clock, committed: 980)))
+    #expect(pressure.state == .pressure)
+
+    let critical = try observed(
+      await controller.observe(
+        trigger: .lifecycle, ledger: ledger(clock: clock, committed: 990)))
+    #expect(critical.state == .critical)
+
+    let noRecoveryAtEquality = try observed(
+      await controller.observe(
+        trigger: .admission, ledger: ledger(clock: clock, committed: 985)))
+    #expect(noRecoveryAtEquality.state == .critical)
+    let oneAbove = try observed(
+      await controller.observe(
+        trigger: .release, ledger: ledger(clock: clock, committed: 984)))
+    #expect(oneAbove.state == .pressure)
+  }
+
+  @Test("hysteresis blocks oscillation and recovery moves one state per dwell")
+  func hysteresisAndRecovery() async throws {
+    let clock = ManualMemoryClock()
+    let service = ScriptedMemoryService(
+      Array(repeating: sample(), count: 10),
+      onSample: { clock.advance(by: .milliseconds(5)) })
+    let controller = MemoryWatermarkController(
+      configuration: try configuration(recoveryDwell: .seconds(10)),
+      platform: service,
+      clock: clock)
+    _ = try observed(
+      await controller.observe(
+        trigger: .admission, ledger: ledger(clock: clock, committed: 990)))
+
+    var observation = try observed(
+      await controller.observe(
+        trigger: .release, ledger: ledger(clock: clock, committed: 900)))
+    #expect(observation.state == .critical)
+    clock.advance(by: .seconds(9))
+    observation = try observed(
+      await controller.observe(
+        trigger: .release, ledger: ledger(clock: clock, committed: 900)))
+    #expect(observation.state == .critical)
+    clock.advance(by: .seconds(1))
+    observation = try observed(
+      await controller.observe(
+        trigger: .release, ledger: ledger(clock: clock, committed: 900)))
+    #expect(observation.transition == .init(from: .critical, to: .pressure, reason: .recovery))
+
+    clock.advance(by: .seconds(10))
+    observation = try observed(
+      await controller.observe(
+        trigger: .release, ledger: ledger(clock: clock, committed: 900)))
+    #expect(observation.state == .soft)
+    clock.advance(by: .seconds(10))
+    observation = try observed(
+      await controller.observe(
+        trigger: .release, ledger: ledger(clock: clock, committed: 900)))
+    #expect(observation.state == .normal)
+  }
+
+  @Test("stale, unavailable, and unacknowledged evidence cannot recover pressure")
+  func staleUnavailableAndAcknowledgementGates() async throws {
+    let clock = ManualMemoryClock()
+    let service = ScriptedMemoryService(
+      [
+        sample(), sample(advisory: nil), sample(), sample(),
+      ], onSample: { clock.advance(by: .milliseconds(5)) })
+    let controller = MemoryWatermarkController(
+      configuration: try configuration(
+        maximumEvidenceAge: .seconds(5), recoveryDwell: .zero),
+      platform: service,
+      clock: clock)
+    _ = try observed(
+      await controller.observe(
+        trigger: .admission, ledger: ledger(clock: clock, committed: 980)))
+
+    var observation = try observed(
+      await controller.observe(
+        trigger: .release, ledger: ledger(clock: clock, committed: 900)))
+    #expect(observation.state == .pressure)
+    let stale = ledger(clock: clock, committed: 900)
+    clock.advance(by: .seconds(6))
+    observation = try observed(
+      await controller.observe(trigger: .release, ledger: stale))
+    #expect(observation.state == .pressure)
+    #expect(observation.ledger == .unavailable(.stale))
+
+    observation = try observed(
+      await controller.observe(
+        trigger: .release,
+        ledger: ledger(clock: clock, committed: 900),
+        actionsAcknowledged: false))
+    #expect(observation.state == .pressure)
+    let metrics = await controller.metrics()
+    #expect(metrics.staleLedgerSamples == 1)
+    #expect(metrics.unavailableSamples >= 2)
+  }
+
+  @Test("warning and cadence lanes coalesce bursts without losing warning severity")
+  func warningBurstAndCadenceBounds() async throws {
+    let clock = ManualMemoryClock()
+    let service = ScriptedMemoryService(Array(repeating: sample(), count: 5))
+    let controller = MemoryWatermarkController(
+      configuration: try configuration(
+        cadence: .seconds(10), minimumEventInterval: .seconds(5)),
+      platform: service,
+      clock: clock)
+
+    _ = try observed(
+      await controller.observe(trigger: .cadence, ledger: ledger(clock: clock)))
+    _ = try observed(
+      await controller.observe(trigger: .admission, ledger: ledger(clock: clock)))
+    let warning = try observed(
+      await controller.observe(trigger: .memoryWarning, ledger: ledger(clock: clock)))
+    #expect(warning.state == .pressure)
+    #expect(warning.warningReceived)
+    #expect(warning.transition?.reason == .memoryWarning)
+    #expect(
+      try await controller.observe(trigger: .memoryWarning, ledger: ledger(clock: clock))
+        == .rateLimited(currentState: .pressure))
+    #expect(
+      try await controller.observe(trigger: .cadence, ledger: ledger(clock: clock))
+        == .rateLimited(currentState: .pressure))
+    #expect(service.callCount == 3)
+  }
+
+  @Test("configuration replacement is monotonic and changes bounded history capacity")
+  func configurationReplacement() async throws {
+    let clock = ManualMemoryClock()
+    let service = ScriptedMemoryService(Array(repeating: sample(), count: 5))
+    let controller = MemoryWatermarkController(
+      configuration: try configuration(historyLimit: 4), platform: service, clock: clock)
+    _ = try observed(
+      await controller.observe(trigger: .admission, ledger: ledger(clock: clock)))
+
+    await #expect(
+      throws: MemoryWatermarkConfigurationError.generationMustIncrease(
+        current: 1, proposed: 1
+      )
+    ) {
+      try await controller.replaceConfiguration(try configuration(generation: 1))
+    }
+    try await controller.replaceConfiguration(try configuration(generation: 2, historyLimit: 2))
+    for trigger in [MemoryObservationTrigger.configurationReplacement, .release, .admission] {
+      _ = try observed(
+        await controller.observe(trigger: trigger, ledger: ledger(clock: clock)))
+    }
+    let history = await controller.retainedHistory()
+    #expect(history.count == 2)
+    #expect(history.allSatisfy { $0.configurationGeneration == 2 })
+    #expect((await controller.metrics()).retainedHistoryCapacity == 2)
+  }
+
+  @Test("concurrent observations serialize into one gap-free generation")
+  func concurrentObservations() async throws {
+    let count = 64
+    let clock = ManualMemoryClock()
+    let service = ScriptedMemoryService(
+      Array(repeating: sample(), count: count),
+      onSample: { clock.advance(by: .milliseconds(5)) })
+    let controller = MemoryWatermarkController(
+      configuration: try configuration(historyLimit: count), platform: service, clock: clock)
+
+    try await withThrowingTaskGroup(of: Void.self) { group in
+      for _ in 0..<count {
+        group.addTask {
+          _ = try await controller.observe(
+            trigger: .admission, ledger: ledger(clock: clock))
+        }
+      }
+      try await group.waitForAll()
+    }
+    let history = await controller.retainedHistory()
+    #expect(history.map(\.sequence) == Array(1...UInt64(count)))
+    #expect(history.allSatisfy { $0.stateGeneration == 0 && $0.state == .normal })
+    #expect(service.callCount == count)
+  }
+
+  @Test("overflow and late sampling become explicit unavailable evidence")
+  func overflowAndSamplingOverrun() async throws {
+    let clock = ManualMemoryClock()
+    let service = ScriptedMemoryService(
+      [
+        sample(), sample(),
+      ], onSample: { clock.advance(by: .milliseconds(2)) })
+    let controller = MemoryWatermarkController(
+      configuration: try configuration(maximumSamplingDuration: .milliseconds(1)),
+      platform: service,
+      clock: clock)
+
+    let overflow = MemoryLedgerSnapshot(
+      capturedAt: clock.now(), currentBytes: .max, reservedBytes: 1,
+      committedBytes: .max, peakBytes: .max)
+    let observation = try observed(
+      await controller.observe(trigger: .admission, ledger: .available(overflow)))
+    #expect(observation.ledger == .unavailable(.malformed))
+    #expect(
+      observation.advisoryAvailableMemory
+        == .unavailable(
+          reason: .executionTimeExceeded, provenance: .osProcessAvailableMemory))
+    let metrics = await controller.metrics()
+    #expect(metrics.samplingOverruns == 1)
+    #expect(metrics.unavailableSamples == 4)
+  }
+
+  @Test("metrics expose fixed aggregate cardinality and retain no traffic labels")
+  func redactedMetrics() async throws {
+    let clock = ManualMemoryClock()
+    let controller = MemoryWatermarkController(
+      configuration: try configuration(),
+      platform: ScriptedMemoryService([sample()]),
+      clock: clock)
+    _ = try observed(
+      await controller.observe(trigger: .admission, ledger: ledger(clock: clock)))
+    let metrics = await controller.metrics()
+
+    #expect(Set(metrics.transitionCounts.keys) == Set(MemoryWatermarkState.allCases))
+    #expect(metrics.transitionCounts.count == 4)
+    #expect(metrics.retainedHistoryCount == 1)
+    #expect(!String(reflecting: metrics).contains("example.com"))
+    #expect(MemoryObservationProvenance.allCases.count == 3)
+    #expect(MemorySampleUnavailableReason.allCases.count == 6)
+  }
+}
+
+private func observed(_ disposition: MemoryObservationDisposition) throws -> MemoryObservation {
+  guard case .observed(let observation) = disposition else {
+    Issue.record("Expected an accepted observation")
+    throw MemoryWatermarkTestError.rateLimited
+  }
+  return observation
+}
+
+private enum MemoryWatermarkTestError: Error { case rateLimited }
+
+private func thresholds() throws -> MemorySignalThresholds {
+  try MemorySignalThresholds(
+    criticalEnterBytes: 10,
+    pressureEnterBytes: 20,
+    softEnterBytes: 30,
+    criticalExitBytes: 15,
+    pressureExitBytes: 25,
+    softExitBytes: 35)
+}
+
+private func configuration(
+  generation: UInt64 = 1,
+  cadence: Duration = .seconds(1),
+  minimumEventInterval: Duration = .milliseconds(5),
+  maximumEvidenceAge: Duration = .seconds(30),
+  maximumSamplingDuration: Duration = .milliseconds(5),
+  recoveryDwell: Duration = .zero,
+  historyLimit: Int = 16
+) throws -> MemoryWatermarkConfiguration {
+  try MemoryWatermarkConfiguration(
+    generation: generation,
+    deviceBaselineBytes: 1_000,
+    globalLedgerCeilingBytes: 1_000,
+    ledgerHeadroom: thresholds(),
+    physicalHeadroom: thresholds(),
+    advisoryAvailable: thresholds(),
+    cadence: cadence,
+    minimumEventInterval: minimumEventInterval,
+    maximumEvidenceAge: maximumEvidenceAge,
+    maximumSamplingDuration: maximumSamplingDuration,
+    recoveryDwell: recoveryDwell,
+    historyLimit: historyLimit)
+}
+
+private func ledger(
+  clock: ManualMemoryClock,
+  current: UInt64 = 50,
+  reserved: UInt64? = nil,
+  committed: UInt64 = 50,
+  peak: UInt64 = 60
+) -> MemoryLedgerAvailability {
+  .available(
+    MemoryLedgerSnapshot(
+      capturedAt: clock.now(),
+      currentBytes: current,
+      reservedBytes: reserved ?? committed,
+      committedBytes: committed,
+      peakBytes: max(peak, max(current, committed))))
+}
+
+private func sample(
+  footprint: UInt64 = 100,
+  peak: UInt64 = 120,
+  advisory: UInt64? = 900
+) -> MemoryPlatformSample {
+  MemoryPlatformSample(
+    physicalFootprint: .available(
+      bytes: footprint, provenance: .taskVMPhysicalFootprint),
+    physicalFootprintPeak: .available(
+      bytes: peak, provenance: .taskVMPhysicalFootprint),
+    advisoryAvailableMemory: advisory.map {
+      .available(bytes: $0, provenance: .osProcessAvailableMemory)
+    }
+      ?? .unavailable(
+        reason: .systemCallFailed, provenance: .osProcessAvailableMemory))
+}
+
+private final class ScriptedMemoryService: MemoryPlatformSamplingService, @unchecked Sendable {
+  private struct State {
+    var samples: [MemoryPlatformSample]
+    var index = 0
+  }
+
+  private let state: Mutex<State>
+  private let onSample: @Sendable () -> Void
+
+  init(
+    _ samples: [MemoryPlatformSample],
+    onSample: @escaping @Sendable () -> Void = {}
+  ) {
+    precondition(!samples.isEmpty)
+    self.state = Mutex(State(samples: samples))
+    self.onSample = onSample
+  }
+
+  var callCount: Int { state.withLock(\.index) }
+
+  func sampleCurrentProcessMemory() -> MemoryPlatformSample {
+    onSample()
+    return state.withLock { state in
+      let sample = state.samples[min(state.index, state.samples.count - 1)]
+      state.index += 1
+      return sample
+    }
+  }
+}
+
+private final class ManualMemoryClock: TunnelClock, @unchecked Sendable {
+  private let instant = Mutex(ContinuousClock().now)
+
+  func now() -> ContinuousClock.Instant { instant.withLock { $0 } }
+
+  func sleep(for duration: Duration) async throws {
+    instant.withLock { $0 = $0.advanced(by: duration) }
+  }
+
+  func advance(by duration: Duration) {
+    instant.withLock { $0 = $0.advanced(by: duration) }
+  }
+}
