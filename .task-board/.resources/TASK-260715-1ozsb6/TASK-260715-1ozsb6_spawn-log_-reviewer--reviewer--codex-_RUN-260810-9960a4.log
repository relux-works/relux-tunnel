   289	  private func exerciseDirectTCPIP(transport: LibSSH2Transport, echoPort: UInt16) async throws {
   290	    let channel = try await transport.openDirectTCPIP(
   291	      destination: TunnelEndpoint(host: "127.0.0.1", port: echoPort),
   292	      originator: TunnelEndpoint(host: "127.0.0.1", port: 41_414),
   293	      policy: try fixtureChannelPolicy()
   294	    )
   295	    let payload = Data("direct-tcpip-echo".utf8)
   296	    var written = 0
   297	    while written < payload.count {
   298	      written += try await channel.writeSome(Data(payload[written...]))
   299	    }
   300	    var received = Data()
   301	    while received.count < payload.count {
   302	      let next = try #require(try await channel.read(maximumBytes: payload.count - received.count))
   303	      received.append(next)
   304	    }
   305	    #expect(received == payload)
   306	    #expect(await channel.receiveWindow() == .unsupported)
   307	    await channel.close()
   308	  }
