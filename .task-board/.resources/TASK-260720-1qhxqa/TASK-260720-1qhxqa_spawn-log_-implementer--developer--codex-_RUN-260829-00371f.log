+        },
+        "transportBufferBytes": 65536,
+        "readBufferBytes": 16384,
+        "queuedWriteBytes": 32768,
+        "writeCallBytes": 8192,
+        "pendingOperationLimit": 64,
+        "rekeyProtectedBytesPerDirection": {
+          "minimum": 4096,
+          "maximum": 5368709120
+        },
+        "rekeyElapsedMilliseconds": {
