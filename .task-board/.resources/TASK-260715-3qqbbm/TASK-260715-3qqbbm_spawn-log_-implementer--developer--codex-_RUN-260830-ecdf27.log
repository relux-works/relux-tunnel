    23	def named_invocation(
    24	    text: str, kind: str, name: str, required_marker: str | None = None
    25	) -> str:
    26	    pattern = re.compile(rf"\.{re.escape(kind)}\s*\(\s*name:\s*\"{re.escape(name)}\"")
    27	    for match in pattern.finditer(text):
    28	        start = match.start()
    29	        opening = text.find("(", start)
    30	        depth = 0
    31	        in_string = False
    32	        escaped = False
    33	        for index in range(opening, len(text)):
    34	            character = text[index]
    35	            if in_string:
    36	                if escaped:
    37	                    escaped = False
    38	                elif character == "\\":
    39	                    escaped = True
    40	                elif character == '"':
    41	                    in_string = False
    42	                continue
    43	            if character == '"':
    44	                in_string = True
    45	            elif character == "(":
    46	                depth += 1
    47	            elif character == ")":
    48	                depth -= 1
    49	                if depth == 0:
    50	                    block = text[start : index + 1]
    51	                    if required_marker is None or required_marker in block:
    52	                        return block
    53	                    break
    54	    if not pattern.search(text):
    55	        raise ContractError(f"missing {kind} declaration for {name}")
    56	    raise ContractError(f"unterminated {kind} declaration for {name}")
    57	
