   686	private struct P256FixtureCredential: SSHPublicKeyCredential {
   687	  let algorithm = "ecdsa-sha2-nistp256"
   688	  let publicKeyBytes: Data
   689	  let authorizedKey: String
   690	  private let privateKey: P256.Signing.PrivateKey
   691	
   692	  init() {
   693	    let privateKey = P256.Signing.PrivateKey()
   694	    var blob = Data()
   695	    appendSSHString(Data(algorithm.utf8), to: &blob)
   696	    appendSSHString(Data("nistp256".utf8), to: &blob)
   697	    appendSSHString(privateKey.publicKey.x963Representation, to: &blob)
   698	    self.privateKey = privateKey
   699	    publicKeyBytes = blob
   700	    authorizedKey = "\(algorithm) \(blob.base64EncodedString()) relux-fixture"
   701	  }
   702	
   703	  func sign(_ payload: Data) async throws -> Data {
   704	    let raw = try privateKey.signature(for: payload).rawRepresentation
   705	    var result = Data()
   706	    appendSSHString(sshMPInt(Data(raw.prefix(32))), to: &result)
   707	    appendSSHString(sshMPInt(Data(raw.suffix(32))), to: &result)
   708	    return result
   709	  }
   710	}
