+        harness.serverHostKeys = [
+            .init(ed25519Key: .init()),
+            .init(p256Key: .init()),
+        ]
+        let keyExchangeAllowlist = ["curve25519-sha256@libssh.org", "ecdh-sha2-nistp256"]
+        let hostKeyAllowlist = ["ecdsa-sha2-nistp256", "ssh-ed25519"]
+        let events = UserEventExpecter()
