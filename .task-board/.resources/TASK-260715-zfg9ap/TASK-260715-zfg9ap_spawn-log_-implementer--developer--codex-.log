+                _ = unexpectedFlow.release(reason: .internal)
+              case .failure(let rejection):
+                if rejection.reason != .flowCapacity {
+                  unexpectedRejections.increment()
+                }
+                if rejection.shouldOpenSSHChannel {
+                  sshOpenCalls.increment()
+                }
+              }
+            }
+          }
+        }
+      }
+    }
+
