+        "verify_command": "./scripts/native-dependency-tool.py verify --dependency relux-native-fixture"
+      },
+      "artifact": {
+        "file_sha256": {}
+      }
+    },
+    "hev-lwip": {
+      "revision": "ad7600497931205105b08367bd1b450048157e40",
+      "upstream": "https://github.com/heiher/hev-socks5-tunnel",
+      "source": {
+        "kind": "git_archive_with_submodules",
+        "sha256": "1d48d9b8a4dd5befc3460fda3ac4684149ace458c1630ca5f5692c9dc8dd154f",
+        "submodules": [
+          {"path": "src/core", "revision": "c234519072ff5b928b90b304da9a666bcb440455", "sha256": "4b17bed847de4336adad9961c1a6943ab4a4df670da057a12c50a0d06c3b2438"},
+          {"path": "third-part/hev-task-system", "revision": "b1afa0e21fb4ed5a69560e78e54baf0efdebe171", "sha256": "3e3ef1eaa15b151e48123e006a98ef9de134914488fb38bcc44626cd239ffe93"},
+          {"path": "third-part/lwip", "revision": "2a11c14c7a32887af25a034e82ef18b0b12076ac", "sha256": "3a2252de07e42d3e5d31d8af97005eb73d7f0ed7725d029f0025c99ab5a0497f"},
+          {"path": "third-part/yaml", "revision": "efa36117a8646d26d12b58e05bac472d7854a70d", "sha256": "b0f33a1062e687bef8f86d5e0690895e8e5f7f5fdeda285216a00bfcc5616334"}
+        ]
+      },
+      "integration": {
+        "swiftpm_kind": "binaryTarget",
+        "future_target_name": "CHevSocks5Tunnel",
+        "future_adapter_target": "ReluxTunnelHEVAdapter",
+        "linkage": "static",
