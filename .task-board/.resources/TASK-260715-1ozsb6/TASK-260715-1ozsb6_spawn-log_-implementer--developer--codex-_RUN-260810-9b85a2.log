+  func stop() {
+    if process.isRunning {
+      process.terminate()
+      process.waitUntilExit()
+    }
+    if ProcessInfo.processInfo.environment["RELUX_KEEP_SSHD_FIXTURE"] == nil {
+      try? FileManager.default.removeItem(at: directory)
