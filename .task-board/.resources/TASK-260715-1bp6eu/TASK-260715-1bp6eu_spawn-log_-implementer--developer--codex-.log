+  private static func protocolCode(for error: ProviderMessageError) -> RuntimeProtocolErrorCode {
+    switch error {
+    case .unsupportedProtocolVersion:
+      .unsupportedProtocolVersion
+    case .unsupportedKind:
+      .unsupportedKind
+    case .invalidPayload(let code):
+      code
+    }
+  }
