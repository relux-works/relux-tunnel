    43	REMOTE_STDIO = {
    44	    "echo": (
    45	        "python3 -u -c 'import shutil,sys; "
    46	        "shutil.copyfileobj(sys.stdin.buffer,sys.stdout.buffer,length=65536)'"
    47	    ),
    48	    "sink": (
    49	        "python3 -u -c 'import sys; "
    50	        "while sys.stdin.buffer.read(65536): pass'"
    51	    ),
