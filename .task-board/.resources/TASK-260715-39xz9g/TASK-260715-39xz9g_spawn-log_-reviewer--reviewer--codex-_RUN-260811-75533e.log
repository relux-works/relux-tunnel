+    try:
+        for server_id in sorted(REQUIRED_SERVERS):
+            server = servers[server_id]
+            reference = _provider_reference(server_id)
+            prepared.append((server, reference))
+            prepare = invoke(
+                reference,
+                {
+                    "protocol": "relux-ssh-matrix-provider-v1",
+                    "action": "prepare",
