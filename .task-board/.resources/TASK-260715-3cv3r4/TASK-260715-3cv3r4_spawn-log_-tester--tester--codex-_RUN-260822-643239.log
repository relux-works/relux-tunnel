+      generation: 1
+    ),
+    hostPolicy: SSHHostPolicyV1(
+      allowedAlgorithms: [.sshEd25519],
+      records: [
+        SSHHostIdentityRecordV1(
+          algorithm: .sshEd25519,
+          fingerprintSHA256: SSHHostKeyFingerprint("SHA256:\(fingerprint)"),
+          state: .approved,
