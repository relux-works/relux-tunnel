  1505	  private func incrementRekeyCounter(_ reason: SSHClientRekeyReason) {
  1506	    switch reason {
  1507	    case .byteThreshold: counters.clientByteRekeys += 1
  1508	    case .timeThreshold: counters.clientTimeRekeys += 1
  1509	    case .test, .manual: counters.explicitRekeys += 1
  1510	    }
  1511	  }
