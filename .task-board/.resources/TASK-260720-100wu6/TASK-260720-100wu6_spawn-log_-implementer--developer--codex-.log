+    let adjustment = try SSHWindowAdjustment(
+      channel: fixtureChannelID(1),
+      before: 3,
+      amount: 4,
+      after: 7,
+      cap: 8
+    )
+    #expect(adjustment.after <= adjustment.cap)
+    #expect(adjustment.before + adjustment.amount == adjustment.after)
+  }
