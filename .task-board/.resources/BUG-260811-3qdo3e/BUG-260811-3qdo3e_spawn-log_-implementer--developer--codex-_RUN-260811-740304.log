exec
/bin/zsh -lc 'aggregate_log=.temp/BUG-260811-3qdo3e/unfiltered-20-run-streak.log
: > "$aggregate_log"
for run_index in $(seq 1 20); do
  run_log=".temp/BUG-260811-3qdo3e/unfiltered-run-$(printf '"'%02d' \""'$run_index").log"
  run_started=$SECONDS
  swift test --skip-build > "$run_log" 2>&1
  run_code=$?
  run_elapsed=$((SECONDS-run_started))
  if rg -q '"'Test run with 426 tests in 35 suites passed' \""'$run_log"; then
    run_count=426
    run_result=passed
  else
    run_count=$(rg -o '"'Test run with [0-9]+ tests' \""'$run_log" | tail -1 | rg -o '"'[0-9]+' || true)
    run_result=missing-pass-summary
  fi
  print -r -- \"unfiltered_run="'$run_index exit=$run_code tests=${run_count:-unknown} result=$run_result elapsed_s=$run_elapsed" | tee -a "$aggregate_log"
  if [ "$run_code" -ne 0 ] || [ "$run_result" != passed ]; then
    tail -120 "$run_log"
    exit 1
  fi
done' in /Users/iv/Developer/relux-tunnel
