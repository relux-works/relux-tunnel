{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb8f","stream":{"kind":"session","id":"01a0aa7a-9815-7302-a96f-7a8fde67c84b"},"sequence":1058,"recorded_at":1780531400002111,"record_type":"event","durability":"durable","causation_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","run_stream":{"kind":"run","id":"7cb39f37-e5ea-43fc-a612-eaf97474622d"},"call_id":"call_01a0aa810f85753099a806906ab168bd","text":"Read text file `Sources/ReluxTunnelCore/SSHBootstrapDiagnostics.swift`.\n(499 line(s) above)\n500|      return transportProjection(cause, stage: .algorithmNegotiation)\n501|\n502|    case .host(let cause):\n503|      switch cause {\n504|      case .trustRequired:\n505|        return (.hostTrustRequired, .hostVerification, .approveHost, .terminal)\n506|      case .changed:\n507|        return (.hostKeyChanged, .hostVerification, .replaceHostTrust, .terminal)\n508|      case .algorithmUnsupported:\n509|        return (.hostKeyAlgorithmUnsupported, .hostVerification, .reviewProfile, .terminal)\n510|      case .revoked:\n511|        return (.hostIdentityRevoked, .hostVerification, .reviewHostTrust, .terminal)\n512|      case .policyRejected:\n513|        return (.hostPolicyRejected, .hostVerification, .reviewHostTrust, .terminal)\n514|      }\n515|\n516|    case .credential(let cause):\n517|      let code: SSHBootstrapErrorCode\n518|      let action: SSHBootstrapUserActionCategory\n519|      switch cause {\n520|      case .notProvisioned:\n521|        (code, action) = (.credentialNotProvisioned, .restoreCredential)\n522|      case .accessDenied:\n523|        (code, action) = (.credentialAccessDenied, .reviewCredential)\n524|      case .generationMismatch:\n525|        (code, action) = (.credentialGenerationMismatch, .restoreCredential)\n526|      case .malformed:\n527|        (code, action) = (.credentialMalformed, .restoreCredential)\n528|      case .passphraseRequired:\n529|        (code, action) = (.credentialPassphraseRequired, .reviewCredential)\n530|      case .passphraseInvalid:\n531|        (code, action) = (.credentialPassphraseInvalid, .reviewCredential)\n532|      case .keyUnsupported:\n533|        (code, action) = (.credentialKeyUnsupported, .reviewCredential)\n534|      case .mutationConflict:\n535|        (code, action) = (.credentialMutationConflict, .reviewCredential)\n536|      case .referenceCollision:\n537|        (code, action) = (.credentialReferenceCollision, .contactSupport)\n538|      case .formatRegistryUnavailable:\n539|        (code, action) = (.credentialFormatRegistryUnavailable, .contactSupport)\n540|      case .reconciliationProfileSetUnavailable:\n541|        (code, action) = (.credentialReconciliationProfileSetUnavailable, .retryLater)\n542|      case .reconciliationLimitExceeded:\n543|        (code, action) = (.credentialReconciliationLimitExceeded, .reviewCredential)\n544|      case .reconciliationFailed:\n545|        (code, action) = (.credentialReconciliationFailed, .reviewCredential)\n546|      }\n547|      return (code, .credentialAccess, action, .terminal)\n548|\n549|    case .authentication(let cause):\n550|      let action: SSHBootstrapUserActionCategory =\n551|        cause == .rejected ? .reviewCredential : .reviewProfile\n552|      return (.authenticationRejected, .publicKeyAuthentication, action, .terminal)\n553|\n554|    case .cancellation(let cause):\n555|      let code: SSHBootstrapErrorCode = cause == .userStopped ? .userStopped : .operationCancelled\n556|      return (code, .cancellation, .none, .cancelled)\n557|\n558|    case .operationTimedOut(let stage):\n559|      return (.operationTimedOut, stage, .retryLater, .retryableLater)\n560|\n561|    case .transportInterrupted(let stage, _):\n562|      return (.transportInterrupted, stage, .retryLater, .retryableLater)\n563|\n564|    case .sessionClose(let cause):\n565|      switch cause {\n566|      case .timedOut:\n567|        return (.operationTimedOut, .sessionClose, .retryLater, .retryableLater)\n568|      case .transportFailure:\n569|        return (.sessionCloseFailed, .sessionClose, .contactSupport, .terminal)\n570|      case .invariantViolation:\n571|        return (.internalInvariant, .sessionClose, .contactSupport, .terminal)\n572|      }\n573|\n574|    case .invariantViolation(let stage):\n575|      return (.internalInvariant, stage, .contactSupport, .terminal)\n576|    }\n577|  }\n578|\n579|  private static func transportProjection(\n580|    _ cause: SSHBootstrapTransportCause,\n581|    stage: SSHBootstrapStage\n582|  ) -> (\n583|    code: SSHBootstrapErrorCode,\n584|    stage: SSHBootstrapStage,\n585|    action: SSHBootstrapUserActionCategory,\n586|    retry: SSHBootstrapRetryDisposition\n587|  ) {\n588|    if cause == .cancelled {\n589|      return (.operationCancelled, .cancellation, .none, .cancelled)\n590|    }\n591|    if cause == .timedOut {\n592|      return (.operationTimedOut, stage, .retryLater, .retryableLater)\n593|    }\n594|    switch stage {\n595|    case .physicalPathResolution:\n596|      let retry: SSHBootstrapRetryDisposition =\n597|        cause == .unexpected || cause == .connectionRefused ? .terminal : .retryableLater\n598|      return (\n599|        .pathUnavailable,\n600|        stage,\n601|        retry.isRetryable ? .checkNetwork : .reviewProfile,\n602|        retry\n603|      )\n604|    case .endpointConnect:\n605|      let retryable: Set<SSHBootstrapTransportCause> = [\n606|        .unavailable, .connectionReset, .connectionAborted, .temporaryResourceExhaustion,\n607|      ]\n608|      let retry: SSHBootstrapRetryDisposition =\n609|        retryable.contains(cause) ? .retryableLater : .terminal\n610|      return (\n611|        .endpointConnectFailed,\n612|        stage,\n613|        retry.isRetryable ? .checkNetwork : .reviewProfile,\n614|        retry\n615|      )\n616|    case .algorithmNegotiation:\n617|      let retryable: Set<SSHBootstrapTransportCause> = [\n618|        .unavailable, .connectionReset, .connectionAborted,\n619|      ]\n620|      let retry: SSHBootstrapRetryDisposition =\n621|        retryable.contains(cause) ? .retryableLater : .terminal\n622|      return (\n623|        .negotiationFailed,\n624|        stage,\n625|        retry.isRetryable ? .retryLater : .reviewProfile,\n626|        retry\n627|      )\n628|    default:\n629|      return (.internalInvariant, stage, .contactSupport, .terminal)\n630|    }\n631|  }\n632|\n633|  private static func transportCause(_ error: SSHTransportError) -> SSHBootstrapInternalCause {\n634|    if error.code == .cancelled {\n635|      return .cancellation(.taskCancelled)\n636|    }\n637|    if error.code == .timedOut {\n638|      return .operationTimedOut(bootstrapStage(for: error.phase))\n639|    }\n640|    if [.connectionLost, .connectionClosed, .networkUnavailable, .peerReset].contains(error.code),\n641|      ![.resolution, .tcpConnect, .initialKeyExchange, .transportClose].contains(error.phase)\n642|    {\n643|      return .transportInterrupted(\n644|        bootstrapStage(for: error.phase), normalizedTransportCause(error.code))\n645|    }\n646|    switch error.phase {\n647|    case .resolution:\n648|      return .physicalPath(normalizedTransportCause(error.code))\n649|    case .tcpConnect:\n650|      return .endpointConnect(normalizedTransportCause(error.code))\n651|    case .configuration, .initialKeyExchange:\n652|      return .negotiation(normalizedTransportCause(error.code))\n653|    case .hostDecision:\n654|      return .host(hostCause(error.code))\n655|    case .credentialLookup:\n656|      return .credential(credentialCause(error.code))\n657|    case .authentication:\n658|      return .authentication(authenticationCause(error.code))\n659|    case .transportClose:\n660|      let closeCause: SSHBootstrapSessionCloseCause =\n661|        error.code == .timedOut ? .timedOut : .transportFailure\n662|      return .sessionClose(closeCause)\n663|    case .channelOpen, .channelRead, .channelWrite, .channelEOF, .channelClose,\n664|      .execRequest, .execExit, .uploadSource, .rekey, .keepalive, .protocolProcessing:\n665|      return .invariantViolation(\n666|        error.phase == .protocolProcessing ? .algorithmNegotiation : .sessionClose)\n667|    }\n668|  }\n669|\n670|  private static func bootstrapStage(for phase: SSHTransportPhase) -> SSHBootstrapStage {\n671|    switch phase {\n672|    case .configuration:\n673|      .profileLoad\n674|    case .resolution:\n675|      .physicalPathResolution\n676|    case .tcpConnect:\n677|      .endpointConnect\n678|    case .initialKeyExchange, .protocolProcessing:\n679|      .algorithmNegotiation\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
