        )
    except (OSError, subprocess.CalledProcessError) as error:
        raise SupplyChainError(
            f"Git provenance lookup failed: {' '.join(arguments)}"
        ) from error
    return result.stdout.rstrip("\n")


def git_bytes(revision: str, path: str) -> bytes:
    try:
