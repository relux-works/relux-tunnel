index 0000000000000000000000000000000000000000..d82335b28de674d80e550ec448028265238a14e4
--- /dev/null
+++ b/.temp/TASK-260715-3jloqy/provisioning-project/inspect_profiles.py
@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+
+from __future__ import annotations
+
+import datetime as dt
+import hashlib
+import json
+import plistlib
+import re
+import subprocess
+from pathlib import Path
+
+
+TEAM_ID = "262RZ595FP"
+EXPECTED = {
+    "works.relux.tunnel.mac": "ReluxTunnelMacHostProvisioning",
+    "works.relux.tunnel.mac.tunnel": "ReluxTunnelMacProviderProvisioning",
+    "works.relux.tunnel.probe.mac": "ReluxTunnelProbeMacHostProvisioning",
+    "works.relux.tunnel.probe.mac.tunnel": "ReluxTunnelProbeMacProviderProvisioning",
+}
+PROFILE_DIRS = (
+    Path.home() / "Library/Developer/Xcode/UserData/Provisioning Profiles",
+    Path.home() / "Library/MobileDevice/Provisioning Profiles",
+)
+RUN_CUTOFF = dt.datetime(2026, 8, 10, 19, 25, tzinfo=dt.UTC).timestamp()
+
+
+def provisioning_udid() -> str:
+    text = subprocess.check_output(
+        ["/usr/sbin/system_profiler", "SPHardwareDataType"], text=True
+    )
+    match = re.search(r"^\s*Provisioning UDID:\s*(\S+)\s*$", text, re.MULTILINE)
+    if match is None:
+        raise RuntimeError("current Mac provisioning identifier unavailable")
+    return match.group(1)
+
+
+def decode_profile(path: Path) -> dict:
+    decoded = subprocess.check_output(
+        ["/usr/bin/security", "cms", "-D", "-i", str(path)],
+        stderr=subprocess.DEVNULL,
+    )
+    return plistlib.loads(decoded)
+
+
+def bundle_identifier(profile: dict) -> str | None:
+    application_identifier = profile.get("Entitlements", {}).get(
+        "com.apple.application-identifier"
+    )
+    prefix = f"{TEAM_ID}."
+    if isinstance(application_identifier, str) and application_identifier.startswith(prefix):
+        return application_identifier[len(prefix) :]
+    return None
+
+
+def main() -> int:
+    current_mac = provisioning_udid()
+    current_mac_ref = "sha256:" + hashlib.sha256(current_mac.encode()).hexdigest()[:12]
+    profiles_by_bundle: dict[str, list[dict]] = {key: [] for key in EXPECTED}
+    changed_profiles = 0
+    changed_unexpected = 0
+
+    for directory in PROFILE_DIRS:
+        if not directory.is_dir():
+            continue
+        for path in directory.iterdir():
+            if path.suffix not in {".provisionprofile", ".mobileprovision"}:
+                continue
+            try:
+                profile = decode_profile(path)
+            except (subprocess.CalledProcessError, plistlib.InvalidFileException):
+                continue
+            identifier = bundle_identifier(profile)
+            if identifier in EXPECTED:
+                profiles_by_bundle[identifier].append(profile)
+            if path.stat().st_mtime >= RUN_CUTOFF:
+                changed_profiles += 1
+                if identifier not in EXPECTED:
+                    changed_unexpected += 1
+
+    errors: list[str] = []
+    metadata: list[dict] = []
+    now = dt.datetime.now(dt.UTC).replace(tzinfo=None)
+    for identifier, product_name in EXPECTED.items():
+        unique = {profile.get("UUID"): profile for profile in profiles_by_bundle[identifier]}
+        if len(unique) != 1:
+            errors.append(f"{identifier}: expected one local profile UUID, found {len(unique)}")
+            continue
+        profile = next(iter(unique.values()))
+        entitlements = profile.get("Entitlements", {})
+        devices = profile.get("ProvisionedDevices", [])
+        network_extensions = entitlements.get(
+            "com.apple.developer.networking.networkextension", []
+        )
+        checks = {
+            "team": profile.get("TeamIdentifier") == [TEAM_ID],
+            "prefix": profile.get("ApplicationIdentifierPrefix") == [TEAM_ID],
+            "applicationIdentifier": entitlements.get("com.apple.application-identifier")
+            == f"{TEAM_ID}.{identifier}",
+            "platform": profile.get("Platform") == ["OSX"],
+            "currentMacOnly": devices == [current_mac],
+            "validNow": profile.get("CreationDate") <= now < profile.get("ExpirationDate"),
+            "networkExtensionUnsuffixed": "packet-tunnel-provider" in network_extensions,
+            "networkExtensionNoSystemExtensionSuffix": "packet-tunnel-provider-systemextension"
+            not in network_extensions,
+            "appGroupsAbsent": "com.apple.security.application-groups" not in entitlements,
+            "keychainWildcardExpected": entitlements.get("keychain-access-groups")
+            == [f"{TEAM_ID}.*"],
+            "developmentDeviceBound": "ProvisionsAllDevices" not in profile,
+            "developmentCertificatesPresent": bool(profile.get("DeveloperCertificates")),
+        }
+        for check, passed in checks.items():
+            if not passed:
+                errors.append(f"{identifier}: {check} failed")
+        metadata.append(
+            {
+                "bundleIdentifier": identifier,
+                "profileName": profile.get("Name"),
+                "profileUUID": profile.get("UUID"),
+                "teamIdentifier": profile.get("TeamIdentifier", [None])[0],
+                "applicationIdentifier": entitlements.get("com.apple.application-identifier"),
+                "platform": profile.get("Platform", [None])[0],
+                "currentMacRef": current_mac_ref,
+                "provisionedDeviceCount": len(devices),
+                "creationDate": profile.get("CreationDate").isoformat() + "Z",
+                "expirationDate": profile.get("ExpirationDate").isoformat() + "Z",
+                "networkExtensionValues": network_extensions,
+                "appGroupsPresent": "com.apple.security.application-groups" in entitlements,
+                "keychainAccessGroups": entitlements.get("keychain-access-groups"),
+                "developerCertificateCount": len(profile.get("DeveloperCertificates", [])),
+                "harnessProduct": product_name,
+                "checks": checks,
+            }
+        )
+
+    if changed_profiles != 4:
+        errors.append(f"expected four locally changed profiles, found {changed_profiles}")
+    if changed_unexpected:
+        errors.append(f"unexpected locally changed profiles: {changed_unexpected}")
+
+    print(
+        json.dumps(
+            {
+                "matrixRevision": "2026-07-28.r12",
+                "currentMacRef": current_mac_ref,
+                "changedProfileCount": changed_profiles,
+                "unexpectedChangedProfileCount": changed_unexpected,
+                "profiles": metadata,
+                "errorCount": len(errors),
+                "errors": errors,
+            },
+            indent=2,
+        )
+    )
+    return 0 if not errors else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
