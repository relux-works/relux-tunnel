          )
        } catch {
          guard
            await self?.handleAutomaticKeepaliveFailure(
              error,
              policy: configuration.keepalive
            ) == true
          else { return }
        }
      }
    }
  }

  private func handleAutomaticKeepaliveFailure(
    _ error: Error,
    policy: SSHKeepalivePolicy
  ) async -> Bool {
