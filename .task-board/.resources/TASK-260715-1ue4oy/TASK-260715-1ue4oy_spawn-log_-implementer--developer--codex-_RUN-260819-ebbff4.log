+    resourceName: "TASK-260715-24icoz_portable-relay-assets.tar.gz",
+    archiveSHA256: "1f0ba226ed591d1baf5f9464b33e45b7658a33bf5a1a114e77b6d22d3d9eef4e")
+
+  static let generatedAssets: [RelayBundledAsset] = [
+    RelayBundledAsset(
