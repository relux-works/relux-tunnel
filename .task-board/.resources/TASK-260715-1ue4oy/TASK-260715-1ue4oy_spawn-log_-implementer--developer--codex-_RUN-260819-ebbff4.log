      name: name,
      shared: true,
      buildAction: .buildAction(targets: ["ReluxProxyMacTunnel"]),
      testAction: .targets(["ReluxProxyMacTunnelTests"])
    )
  default:
    .scheme(name: name, shared: true)
  }
}

