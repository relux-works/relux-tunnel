   629	def parser() -> argparse.ArgumentParser:
   630	    result = argparse.ArgumentParser(description=__doc__)
   631	    result.add_argument("--target", required=True, choices=SUPPORTED_TARGETS)
   632	    result.add_argument("--runner-kind", required=True, choices=("native", "emulated"))
   633	    result.add_argument("--runner-name", required=True)
   634	    result.add_argument("--runner-owner", required=True)
   635	    result.add_argument("--require-native", action="store_true")
   636	    result.add_argument("--emulator", action="append", default=[])
   637	    result.add_argument("--manifest", required=True)
   638	    result.add_argument("--executable", required=True)
   639	    result.add_argument("--evidence", required=True)
   640	    return result
   641	
   642	
   643	def main() -> int:
   644	    return run_gate(parser().parse_args())
   645	
   646	
   647	if __name__ == "__main__":
   648	    raise SystemExit(main())

