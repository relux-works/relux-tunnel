from pathlib import Path
import re
files = [Path('README.md'), Path('relay/README.md'), Path('docs/relay-supply-chain.md'), Path('docs/relay-asset-release-runbook.md')]
count = 0
for source in files:
    text = source.read_text(encoding='utf-8')
    for match in re.finditer(r'\\[["'^'"\\]]*\\]\\((["'^)]+)'"\\)', text):
        target = match.group(1).strip().strip('<>')
        if target.startswith(('http://', 'https://', 'mailto:', '#', 'board-resource://')):
            continue
        path = target.split('#', 1)[0]
        if not path:
            continue
        resolved = (source.parent / path).resolve()
        if not resolved.exists():
            raise SystemExit(f'broken local link in {source}: {target}')
        count += 1
print(f'local_markdown_links={count}: pass')
PY
