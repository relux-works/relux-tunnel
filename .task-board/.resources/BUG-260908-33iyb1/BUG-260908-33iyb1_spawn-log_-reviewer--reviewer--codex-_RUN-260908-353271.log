count=0
[ ! -f "$COUNTER" ] || count=$(cat "$COUNTER")
count=$((count + 1))
echo "$count" > "$COUNTER"
echo "compiler invocation $count: $*"
if [ "$count" -eq "$FAIL_CALL" ]; then
  echo 'ConcreteCompile.swift:42: error: diagnostic sentinel' >&2
