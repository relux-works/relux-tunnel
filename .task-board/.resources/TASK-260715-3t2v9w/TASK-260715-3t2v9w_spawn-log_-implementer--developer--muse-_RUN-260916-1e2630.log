\n2702|    cancelTasks()\n2703|  }\n2704|\n2705|  private func resolveChild(_ child: Child, outcome: Result<Value, Error>) -> Bool {\n2706|    let action = lock.withLock {\n2707|      let continuation: CheckedContinuation<Value, Error>?\n2708|      let won = result == nil\n2709|      if won {\n2710|        result = outcome\n2711|        continuation = self.continuation\n2712|        self.continuation = nil\n2713|      } else {\n2714|        continuation = nil\n2715|      }\n2716|      return (continuation, won)\n2717|    }\n2718|    if action.1 {\n2719|      switch child {\n2720|      case .operation: timerTask?.cancel()\n2721|      case .timer: operationTask?.cancel()\n2722|      }\n2723|    }\n2724|    // Cancellation must be observable before the public waiter resumes. The\n2725|    // registry still retains both children until they really finish, so an\n2726|    // uncooperative dependency remains accounted for without extending the\n2727|    // caller's deadline.\n2728|    action.0?.resume(with: outcome)\n2729|    return action.1\n2730|  }\n2731|\n2732|  private func finishChild() {\n2733|    let allChildrenFinished = lock.withLock {\n2734|      completedChildren += 1\n2735|      return completedChildren == 2\n2736|    }\n2737|    if allChildrenFinished { registry?.remove(identifier: identifier) }\n2738|  }\n2739|\n2740|  private func completeCallerIfNeeded(with outcome: Result<Value, Error>) {\n2741|    let continuation: CheckedContinuation<Value, Error>? = lock.withLock {\n2742|      guard result == nil else { return nil }\n2743|      result = outcome\n2744|      defer { self.continuation = nil }\n2745|      return self.continuation\n2746|    }\n2747|    continuation?.resume(with: outcome)\n2748|  }\n2749|\n2750|  private func cancelTasks() {\n2751|    let tasks = lock.withLock { (operationTask, timerTask) }\n2752|    tasks.0?.cancel()\n2753|    tasks.1?.cancel()\n2754|  }\n2755|}\n2756|\n2757|private func withTimeout<Value: Sendable>(\n2758|  _ timeout: Dura