  private func cancelAcquisition(identifier: UUID) {
    let action: (cancelled: Waiter?, promoted: Waiter?) = lock.withLock {
      if let index = waiters.firstIndex(where: { $0.identifier == identifier }) {
        return (waiters.remove(at: index), nil)
