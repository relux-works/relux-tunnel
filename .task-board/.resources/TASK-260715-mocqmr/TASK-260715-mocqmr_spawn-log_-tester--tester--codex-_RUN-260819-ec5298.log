+        _SockFilter(bpf_jump_equal, 4, 0, fork),
+        _SockFilter(bpf_jump_equal, 3, 0, vfork),
+        _SockFilter(bpf_jump_equal, 2, 0, clone3),
+        _SockFilter(bpf_jump_equal, 1, 0, socket_call),
