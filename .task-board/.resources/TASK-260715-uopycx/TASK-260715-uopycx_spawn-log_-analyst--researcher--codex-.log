     2	 ============================================================================
     3	 Name        : hev-task-aide.c
     4	 Author      : Heiher <r@hev.cc>
     5	 Copyright   : Copyright (c) 2022 - 2024 everyone.
     6	 Description : Aide
     7	 ============================================================================
     8	 */
     9	
    10	#include <poll.h>
    11	#include <errno.h>
    12	#include <unistd.h>
    13	#include <pthread.h>
    14	
    15	#include "kern/task/hev-task-private.h"
    16	#include "kern/io/hev-task-io-reactor.h"
    17	#include "lib/io/basic/hev-task-io.h"
    18	
    19	#include "hev-task-aide.h"
    20	
    21	static pthread_t thread;
    22	static pthread_mutex_t mutex = PTHREAD_MUTEX_INITIALIZER;
    23	static HevTaskIOReactor *reactor;
    24	
    25	static void *
    26	hev_task_aide_entry (void *data)
    27	{
    28	    for (;;) {
    29	        HevTaskIOReactorWaitEvent events[256];
    30	        int i, count;
    31	
    32	        count = hev_task_io_reactor_wait (reactor, events, 256, -1);
    33	
    34	        for (i = 0; i < count; i++) {
    35	            HevTaskAideWork *work;
    36	            unsigned int revents;
    37	
    38	            work = hev_task_io_reactor_wait_event_get_data (&events[i]);
    39	            revents = hev_task_io_reactor_wait_event_get_events (&events[i]);
    40	
    41	            work->handler (revents, work->data);
    42	        }
    43	    }
    44	
    45	    return NULL;
    46	}
    47	
    48	int
    49	hev_task_aide_init (void)
    50	{
    51	    int res = 0;
    52	
    53	    if (reactor)
    54	        return 0;
    55	
    56	    pthread_mutex_lock (&mutex);
    57	    if (!reactor) {
    58	        reactor = hev_task_io_reactor_new ();
    59	        if (!reactor) {
    60	            res = -1;
    61	        } else {
    62	            res = pthread_create (&thread, NULL, hev_task_aide_entry, NULL);
    63	            if (res != 0)
    64	                res = -1;
    65	        }
    66	    }
    67	    pthread_mutex_unlock (&mutex);
    68	
    69	    return res;
    70	}
    71	
    72	int
    73	hev_task_aide_add (HevTaskAideWork *work)
    74	{
    75	    HevTaskIOReactorSetupEvent revents[HEV_TASK_IO_REACTOR_EVENT_GEN_MAX];
    76	    int count;
    77	
    78	    count = hev_task_io_reactor_setup_event_fd_gen (
    79	        revents, work->fd, HEV_TASK_IO_REACTOR_OP_ADD, work->events, work);
    80	
    81	    return hev_task_io_reactor_setup (reactor, revents, count);
    82	}
    83	
    84	int
    85	hev_task_aide_del (HevTaskAideWork *work)
    86	{
    87	    HevTaskIOReactorSetupEvent revents[HEV_TASK_IO_REACTOR_EVENT_GEN_MAX];
    88	    int count;
    89	
    90	    count = hev_task_io_reactor_setup_event_fd_gen (
    91	        revents, work->fd, HEV_TASK_IO_REACTOR_OP_DEL, 0, NULL);
    92	
    93	    return hev_task_io_reactor_setup (reactor, revents, count);
    94	}
     1	# HevTaskSystem
     2	
     3	[![status](https://github.com/heiher/hev-task-system/actions/workflows/build.yaml/badge.svg?branch=main&event=push)](https://github.com/heiher/hev-task-system)
     4	
     5	HevTaskSystem is a simple, lightweight multi-task system (coroutines).
     6	
     7	The task system is executed within a native process/thread. In task system, you
     8	can create many tasks and attach them to the task system. When a task yields or
     9	is blocked by I/O, the scheduler will pick a suitable task from running list and
    10	switch to it. Memory space, file descriptors, and other resources are shared among
    11	all tasks in the task system. Each task has its private, standalone task structure
    12	(#HevTask) and stack in heap of the process.
    13	
    14	Within a task, you can allocate memory from heap, read and write data to the stack,
    15	and perform I/O operations in synchronized mode.
    16	
    17	## Features
    18	
    19	* Simple/lightweight task.
    20	* I/O operations wrapper.
    21	* Inter-task synchronous. (Mutex/Condition)
    22	* Inter-task communications. (Channel)
    23	* Slice-based memory allocator.
    24	* Call on new stack.
    25	* Multi-thread support.
    26	* Multi-platform support. (Linux/BSD/macOS/Windows)
    27	
    28	## How to Build
    29	
    30	### Unix
    31	
    32	```bash
    33	git clone https://gitlab.com/hev/hev-task-system
    34	cd hev-task-system
    35	make
    36	
    37	# Link with librt (only for glibc versions before 2.17)
    38	make LDFLAGS=-lrt
    39	
    40	# Disable stack overflow detection
    41	make ENABLE_STACK_OVERFLOW_DETECTION=0
    42	
    43	# Set stack backend to heap (Recommended for 32-bit)
    44	make CONFIG_STACK_BACKEND=STACK_HEAP
    45	
    46	# Disable sliced memory allocator
    47	make ENABLE_MEMALLOC_SLICE=0
    48	
    49	# Disable I/O splice by splice syscall (for old Linux kernel)
    50	make ENABLE_IO_SPLICE_SYSCALL=0
    51	
    52	# Demos
    53	make apps
    54	
    55	# Tests
    56	make tests
    57	```
    58	
    59	### Android
    60	
    61	```bash
    62	mkdir hev-task-system
    63	cd hev-task-system
    64	git clone https://gitlab.com/hev/hev-task-system jni
    65	ndk-build
    66	```
    67	
    68	### iOS and MacOS
    69	
    70	```bash
    71	git clone https://gitlab.com/hev/hev-task-system
    72	cd hev-task-system
    73	# will generate HevTaskSystem.xcframework
    74	./build-apple.sh
    75	```
    76	
    77	### Windows (MSYS2)
    78	
    79	```bash
    80	export MSYS=winsymlinks:native
    81	git clone https://gitlab.com/hev/hev-task-system
    82	cd hev-task-system
    83	make
    84	```
    85	
    86	## Demos
    87	
    88	1. [simple](https://gitlab.com/hev/hev-task-system/blob/main/apps/simple.c)
    89	1. [channel](https://gitlab.com/hev/hev-task-system/blob/main/apps/channel.c)
    90	1. [timeout](https://gitlab.com/hev/hev-task-system/blob/main/apps/timeout.c)
    91	1. [wakeup](https://gitlab.com/hev/hev-task-system/blob/main/apps/wakeup.c)
    92	1. [echo-server](https://gitlab.com/hev/hev-task-system/blob/main/apps/echo-server.c)
    93	1. [call](https://gitlab.com/hev/hev-task-system/blob/main/apps/call.c)
    94	1. [gtk](https://gitlab.com/hev/hev-task-system/blob/main/apps/gtk.c)
    95	1. [curl](https://gitlab.com/hev/hev-task-system/blob/main/apps/curl.c)
