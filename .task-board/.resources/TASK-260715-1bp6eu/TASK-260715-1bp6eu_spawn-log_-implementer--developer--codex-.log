+private final class ProviderOnceGate<Value: Sendable>: @unchecked Sendable {
+  private let lock = NSLock()
+  private var handler: (@Sendable (Value) -> Void)?
+
+  init(_ handler: @escaping @Sendable (Value) -> Void) {
+    self.handler = handler
+  }
