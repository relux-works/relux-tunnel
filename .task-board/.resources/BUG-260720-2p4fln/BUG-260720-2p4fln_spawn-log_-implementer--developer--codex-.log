   246	        source: Data([10, 43, UInt8(iteration / 250), UInt8(iteration % 250 + 1)]),
   247	        destination: Data([192, 0, 2, 1]),
   248	        sourcePort: UInt16(55_000 + iteration),
   249	        destinationPort: 7,
   250	        payload: Data([UInt8(iteration)])
   251	      )
   252	      try harness.driver.deliver(packet)
