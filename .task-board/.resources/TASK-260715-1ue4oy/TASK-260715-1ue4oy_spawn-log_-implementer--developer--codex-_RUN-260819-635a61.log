+        )
+        self.assertEqual(
+            foreign_marker.read_bytes(), b"preserve exact foreign bytes"
+        )
+        self.assertEqual(
+            manifest_tool.directory_identity(displaced, "displaced stale fixture"),
+            stale_identity,
