  1103	  private func engineError(
  1104	    _ engineCode: Int32,
  1105	    phase: SSHTransportPhase,
  1106	    fallback: SSHTransportErrorCode
  1107	  ) -> SSHTransportError {
  1108	    let code: SSHTransportErrorCode
  1109	    switch engineCode {
  1110	    case LIBSSH2_ERROR_AUTHENTICATION_FAILED: code = .authenticationRejected
  1111	    case LIBSSH2_ERROR_PUBLICKEY_UNVERIFIED, LIBSSH2_ERROR_PUBLICKEY_PROTOCOL:
  1112	      code = .signatureFailed
  1113	    case LIBSSH2_ERROR_CHANNEL_FAILURE: code = .channelOpenRejected
  1114	    case LIBSSH2_ERROR_CHANNEL_REQUEST_DENIED: code = .execRejected
  1115	    case LIBSSH2_ERROR_CHANNEL_CLOSED, LIBSSH2_ERROR_CHANNEL_EOF_SENT: code = .channelClosed
  1116	    case LIBSSH2_ERROR_ALLOC: code = .resourceLimitExceeded
  1117	    case LIBSSH2_ERROR_SOCKET_SEND, LIBSSH2_ERROR_SOCKET_RECV,
  1118	      LIBSSH2_ERROR_SOCKET_DISCONNECT:
