   940	public struct SSHReceiveWindowSnapshot: Equatable, Sendable {
   941	  public let initialReceiveWindowBytes: Int
   942	  public let maximumAdvertisedReceiveWindowBytes: Int
   943	  public let remainingProtocolCreditBytes: Int
   944	  public let bufferedUnreadBytes: Int
   945	  public let deliveredButNotYetReturnedCreditBytes: Int
   946	  public let adjustmentCount: UInt64
   947	  public let cumulativeAdjustmentBytes: UInt64
   948	
   949	  public init(
   950	    initialReceiveWindowBytes: Int,
   951	    maximumAdvertisedReceiveWindowBytes: Int,
   952	    remainingProtocolCreditBytes: Int,
   953	    bufferedUnreadBytes: Int,
   954	    deliveredButNotYetReturnedCreditBytes: Int,
   955	    adjustmentCount: UInt64,
   956	    cumulativeAdjustmentBytes: UInt64
   957	  ) throws {
   958	    let (creditAndBuffered, firstOverflow) =
   959	      remainingProtocolCreditBytes.addingReportingOverflow(bufferedUnreadBytes)
   960	    let (accountedBytes, secondOverflow) =
   961	      creditAndBuffered.addingReportingOverflow(deliveredButNotYetReturnedCreditBytes)
   962	    guard initialReceiveWindowBytes > 0,
   963	      maximumAdvertisedReceiveWindowBytes > 0,
   964	      initialReceiveWindowBytes <= maximumAdvertisedReceiveWindowBytes,
   965	      remainingProtocolCreditBytes >= 0,
   966	      remainingProtocolCreditBytes <= maximumAdvertisedReceiveWindowBytes,
   967	      bufferedUnreadBytes >= 0,
   968	      deliveredButNotYetReturnedCreditBytes >= 0,
   969	      !firstOverflow,
   970	      !secondOverflow,
   971	      accountedBytes <= maximumAdvertisedReceiveWindowBytes
   972	    else {
   973	      throw SSHContractValidationError.invalidWindowSnapshot
   974	    }
   975	    self.initialReceiveWindowBytes = initialReceiveWindowBytes
   976	    self.maximumAdvertisedReceiveWindowBytes = maximumAdvertisedReceiveWindowBytes
   977	    self.remainingProtocolCreditBytes = remainingProtocolCreditBytes
   978	    self.bufferedUnreadBytes = bufferedUnreadBytes
   979	    self.deliveredButNotYetReturnedCreditBytes = deliveredButNotYetReturnedCreditBytes
   980	    self.adjustmentCount = adjustmentCount
   981	    self.cumulativeAdjustmentBytes = cumulativeAdjustmentBytes
   982	  }
   983	}
