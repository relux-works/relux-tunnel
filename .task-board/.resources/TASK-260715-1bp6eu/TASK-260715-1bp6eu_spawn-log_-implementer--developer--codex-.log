+    }
+    requestLedgerGeneration = nil
+    activeRequestIDs.removeAll(keepingCapacity: false)
+    recentRequestIDs.removeAll(keepingCapacity: false)
+    recentRequestOrder.removeAll(keepingCapacity: false)
+  }
