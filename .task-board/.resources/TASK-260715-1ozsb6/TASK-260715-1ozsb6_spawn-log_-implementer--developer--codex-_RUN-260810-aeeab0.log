  1186	public struct SSHTransportError: Error, Equatable, Sendable {
  1187	  public let code: SSHTransportErrorCode
  1188	  public let phase: SSHTransportPhase
  1189	  public let scope: SSHTransportErrorScope
  1190	  public let retryDisposition: SSHRetryDisposition
  1191	  public let requiresTeardown: Bool
  1192	  public let channelOpenReason: SSHChannelOpenReasonReport
  1193	
  1194	  public init(
  1195	    code: SSHTransportErrorCode,
  1196	    phase: SSHTransportPhase,
  1197	    scope: SSHTransportErrorScope,
  1198	    retryDisposition: SSHRetryDisposition,
  1199	    requiresTeardown: Bool,
  1200	    channelOpenReason: SSHChannelOpenReasonReport
  1201	  ) throws {
  1202	    switch (code == .channelOpenRejected, channelOpenReason) {
  1203	    case (true, .notApplicable):
  1204	      throw SSHContractValidationError.channelOpenReasonRequired
  1205	    case (false, .reported), (false, .notReported), (false, .unsupported):
  1206	      throw SSHContractValidationError.channelOpenReasonUnexpected
  1207	    default:
  1208	      break
  1209	    }
  1210	    self.init(
  1211	      validatedCode: code,
  1212	      phase: phase,
  1213	      scope: scope,
  1214	      retryDisposition: retryDisposition,
  1215	      requiresTeardown: requiresTeardown,
  1216	      channelOpenReason: channelOpenReason
  1217	    )
  1218	  }
  1219	
  1220	  private init(
  1221	    validatedCode code: SSHTransportErrorCode,
  1222	    phase: SSHTransportPhase,
  1223	    scope: SSHTransportErrorScope,
  1224	    retryDisposition: SSHRetryDisposition,
  1225	    requiresTeardown: Bool,
  1226	    channelOpenReason: SSHChannelOpenReasonReport
  1227	  ) {
  1228	    self.code = code
  1229	    self.phase = phase
  1230	    self.scope = scope
  1231	    self.retryDisposition = retryDisposition
  1232	    self.requiresTeardown = requiresTeardown
  1233	    self.channelOpenReason = channelOpenReason
  1234	  }
  1235	
  1236	  public static func hostDecisionFailure(
  1237	    _ decision: SSHHostKeyDecision,
  1238	    lane: SSHLaneIdentity
  1239	  ) -> SSHTransportError? {
  1240	    let code: SSHTransportErrorCode
  1241	    switch decision {
  1242	    case .acceptFirstUse, .acceptMatch:
  1243	      return nil
  1244	    case .rejectUnknown:
  1245	      code = .hostKeyUnknown
  1246	    case .rejectChanged:
  1247	      code = .hostKeyChanged
  1248	    case .rejectAlgorithm:
  1249	      code = .hostKeyAlgorithmRejected
  1250	    case .rejectPolicy:
  1251	      code = .hostKeyRejected
  1252	    }
  1253	    return SSHTransportError(
  1254	      validatedCode: code,
  1255	      phase: .hostDecision,
  1256	      scope: .lane(lane),
  1257	      retryDisposition: .afterConfigurationChange,
  1258	      requiresTeardown: true,
  1259	      channelOpenReason: .notApplicable
  1260	    )
  1261	  }
  1262	
  1263	  public static func authenticationFailure(
  1264	    _ outcome: SSHAuthenticationOutcome,
  1265	    lane: SSHLaneIdentity,
  1266	    cancellationPhase: SSHTransportPhase = .authentication
  1267	  ) -> SSHTransportError? {
  1268	    let code: SSHTransportErrorCode
  1269	    let phase: SSHTransportPhase
  1270	    let retry: SSHRetryDisposition
  1271	    switch outcome {
  1272	    case .success:
  1273	      return nil
  1274	    case .rejectedByServer:
  1275	      (code, phase, retry) = (.authenticationRejected, .authentication, .never)
  1276	    case .methodUnavailable:
  1277	      (code, phase, retry) = (
  1278	        .authenticationMethodUnavailable,
  1279	        .authentication,
  1280	        .afterConfigurationChange
  1281	      )
  1282	    case .keyAlgorithmUnavailable:
  1283	      (code, phase, retry) = (
  1284	        .authenticationKeyAlgorithmUnavailable,
  1285	        .authentication,
  1286	        .afterConfigurationChange
  1287	      )
  1288	    case .credentialUnavailable:
  1289	      (code, phase, retry) = (
  1290	        .credentialUnavailable,
  1291	        .credentialLookup,
  1292	        .afterConfigurationChange
  1293	      )
  1294	    case .credentialInteractionRequired:
  1295	      (code, phase, retry) = (
  1296	        .credentialInteractionRequired,
  1297	        .credentialLookup,
  1298	        .afterConfigurationChange
  1299	      )
  1300	    case .signatureFailed:
  1301	      (code, phase, retry) = (.signatureFailed, .authentication, .never)
  1302	    case .cancelled:
  1303	      (code, phase, retry) = (.cancelled, cancellationPhase, .newConnection)
  1304	    case .timedOut:
  1305	      (code, phase, retry) = (.timedOut, cancellationPhase, .newConnection)
  1306	    }
  1307	    return SSHTransportError(
  1308	      validatedCode: code,
  1309	      phase: phase,
  1310	      scope: .lane(lane),
  1311	      retryDisposition: retry,
  1312	      requiresTeardown: true,
  1313	      channelOpenReason: .notApplicable
  1314	    )
  1315	  }
  1316	}
