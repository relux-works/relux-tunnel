     1	#!/usr/bin/swift
     2	
     3	import AppKit
     4	import Foundation
     5	
     6	guard CommandLine.arguments.count == 2 else {
     7	    fputs("usage: generate-icon.swift <output.icns>\n", stderr)
     8	    exit(2)
     9	}
    10	
    11	let outputURL = URL(fileURLWithPath: CommandLine.arguments[1])
    12	let fileManager = FileManager.default
    13	let temporaryRoot = fileManager.temporaryDirectory
    14	    .appendingPathComponent("ReluxProxyIcon-\(UUID().uuidString)", isDirectory: true)
    15	let iconsetURL = temporaryRoot.appendingPathComponent("ReluxProxy.iconset", isDirectory: true)
    16	
    17	try fileManager.createDirectory(at: iconsetURL, withIntermediateDirectories: true)
    18	defer { try? fileManager.removeItem(at: temporaryRoot) }
    19	
    20	let representations: [(name: String, pixels: Int)] = [
    21	    ("icon_16x16.png", 16),
    22	    ("icon_16x16@2x.png", 32),
    23	    ("icon_32x32.png", 32),
    24	    ("icon_32x32@2x.png", 64),
    25	    ("icon_128x128.png", 128),
    26	    ("icon_128x128@2x.png", 256),
    27	    ("icon_256x256.png", 256),
    28	    ("icon_256x256@2x.png", 512),
    29	    ("icon_512x512.png", 512),
    30	    ("icon_512x512@2x.png", 1_024),
    31	]
    32	
    33	func renderIcon(pixels: Int, to url: URL) throws {
    34	    guard
    35	        let bitmap = NSBitmapImageRep(
    36	            bitmapDataPlanes: nil,
    37	            pixelsWide: pixels,
    38	            pixelsHigh: pixels,
    39	            bitsPerSample: 8,
    40	            samplesPerPixel: 4,
    41	            hasAlpha: true,
    42	            isPlanar: false,
    43	            colorSpaceName: .deviceRGB,
    44	            bytesPerRow: 0,
    45	            bitsPerPixel: 0
    46	        ),
    47	        let graphicsContext = NSGraphicsContext(bitmapImageRep: bitmap)
    48	    else {
    49	        throw CocoaError(.featureUnsupported)
    50	    }
    51	
    52	    NSGraphicsContext.saveGraphicsState()
    53	    NSGraphicsContext.current = graphicsContext
    54	    defer { NSGraphicsContext.restoreGraphicsState() }
    55	
    56	    let context = graphicsContext.cgContext
    57	    let scale = CGFloat(pixels) / 1_024
    58	    context.scaleBy(x: scale, y: scale)
    59	
    60	    let backgroundRect = NSRect(x: 48, y: 48, width: 928, height: 928)
    61	    let background = NSBezierPath(roundedRect: backgroundRect, xRadius: 218, yRadius: 218)
    62	    let gradient = NSGradient(
    63	        colorsAndLocations:
    64	            (NSColor(calibratedRed: 0.08, green: 0.12, blue: 0.32, alpha: 1), 0),
    65	            (NSColor(calibratedRed: 0.20, green: 0.36, blue: 0.88, alpha: 1), 0.62),
    66	            (NSColor(calibratedRed: 0.27, green: 0.78, blue: 0.83, alpha: 1), 1)
    67	    )!
    68	    gradient.draw(in: background, angle: -42)
    69	
    70	    NSColor.white.withAlphaComponent(0.14).setStroke()
    71	    background.lineWidth = 14
    72	    background.stroke()
    73	
    74	    let tunnel = NSBezierPath()
    75	    tunnel.move(to: NSPoint(x: 280, y: 512))
    76	    tunnel.curve(
    77	        to: NSPoint(x: 744, y: 512),
    78	        controlPoint1: NSPoint(x: 400, y: 720),
    79	        controlPoint2: NSPoint(x: 624, y: 304)
    80	    )
    81	    tunnel.lineWidth = 70
    82	    tunnel.lineCapStyle = .round
    83	    NSColor.white.withAlphaComponent(0.94).setStroke()
    84	    tunnel.stroke()
    85	
    86	    for point in [NSPoint(x: 256, y: 512), NSPoint(x: 768, y: 512)] {
    87	        let outer = NSBezierPath(ovalIn: NSRect(x: point.x - 104, y: point.y - 104, width: 208, height: 208))
    88	        NSColor.white.setFill()
    89	        outer.fill()
    90	
    91	        let inner = NSBezierPath(ovalIn: NSRect(x: point.x - 48, y: point.y - 48, width: 96, height: 96))
    92	        NSColor(calibratedRed: 0.14, green: 0.28, blue: 0.72, alpha: 1).setFill()
    93	        inner.fill()
    94	    }
    95	
    96	    guard let png = bitmap.representation(using: .png, properties: [:]) else {
    97	        throw CocoaError(.fileWriteUnknown)
    98	    }
    99	    try png.write(to: url, options: .atomic)
   100	}
   101	
   102	for representation in representations {
   103	    try renderIcon(
   104	        pixels: representation.pixels,
   105	        to: iconsetURL.appendingPathComponent(representation.name)
   106	    )
   107	}
   108	
   109	let iconutil = Process()
   110	iconutil.executableURL = URL(fileURLWithPath: "/usr/bin/iconutil")
   111	iconutil.arguments = ["-c", "icns", iconsetURL.path, "-o", outputURL.path]
   112	try iconutil.run()
   113	iconutil.waitUntilExit()
   114	
   115	guard iconutil.terminationStatus == 0 else {
   116	    throw CocoaError(.fileWriteUnknown)
   117	}

