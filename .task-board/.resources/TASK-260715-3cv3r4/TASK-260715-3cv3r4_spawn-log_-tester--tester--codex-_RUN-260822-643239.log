+      isAccepted: false
+    ),
+    HostDecisionCase(name: "rejectMalformed", decision: .rejectMalformed, isAccepted: false),
+    HostDecisionCase(name: "rejectPolicy", decision: .rejectPolicy, isAccepted: false),
+  ]
+}
