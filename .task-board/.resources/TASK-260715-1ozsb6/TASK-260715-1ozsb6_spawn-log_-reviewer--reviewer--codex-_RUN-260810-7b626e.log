   542	  private func validateAlgorithmPolicy(_ policy: SSHAlgorithmPolicy) throws {
   543	    let capabilities = LibSSH2TransportFactory().capabilities
   544	    guard Set(policy.keyExchange).isSubset(of: capabilities.keyExchangeAlgorithms),
   545	      Set(policy.hostKey).isSubset(of: capabilities.hostKeyAlgorithms),
   546	      Set(policy.cipher).isSubset(of: capabilities.cipherAlgorithms),
   547	      Set(policy.mac).isSubset(of: capabilities.macAlgorithms)
   548	    else {
   549	      throw transportError(code: .algorithmNegotiationFailed, phase: .configuration)
   550	    }
   551	    let normalized = (policy.keyExchange + policy.hostKey + policy.cipher + policy.mac)
   552	      .map { $0.lowercased() }
   553	    guard !normalized.contains(where: { $0.contains("sha1") || $0.contains("-cbc") }) else {
   554	      throw transportError(code: .algorithmNegotiationFailed, phase: .configuration)
   555	    }
   556	  }
