   429	  @Test("concurrent replacement permits exactly one complete atomic capture")
   430	  func concurrentCapture() async throws {
   431	    let loader = SSHProfileRuntimeSnapshotLoader()
   432	    let first = try SSHProfileProviderConfigurationCodec.encode(fixture(generation: 11))
   433	    let second = try SSHProfileProviderConfigurationCodec.encode(fixture(generation: 12))
   434	
   435	    let results = await withTaskGroup(of: Bool.self, returning: [Bool].self) { group in
   436	      for configuration in [first, second] {
   437	        group.addTask {
   438	          do {
   439	            _ = try loader.capture(from: configuration)
   440	            return true
   441	          } catch SSHProfileSnapshotLoaderError.profileGenerationMismatch {
   442	            return false
   443	          } catch {
   444	            return false
   445	          }
   446	        }
   447	      }
   448	      var values: [Bool] = []
   449	      for await value in group { values.append(value) }
   450	      return values
   451	    }
   452	    #expect(results.filter { $0 }.count == 1)
   453	    #expect(results.filter { !$0 }.count == 1)
   454	  }
