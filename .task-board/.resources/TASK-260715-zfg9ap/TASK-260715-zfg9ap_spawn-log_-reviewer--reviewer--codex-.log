    79	/// Fixed capacity reserved for the two pump-owned directional buffers.
    80	public struct TCPFlowQueuedByteReservation: Equatable, Sendable {
    81	  public let localToSSHBytes: Int
    82	  public let sshToLocalBytes: Int
    83	  public let totalBytes: Int
    84	
    85	  public init(localToSSHBytes: Int, sshToLocalBytes: Int) throws {
    86	    guard localToSSHBytes > 0 else {
    87	      throw TCPFlowQueuedByteReservationError.nonPositive(.localToSSH)
    88	    }
    89	    guard sshToLocalBytes > 0 else {
    90	      throw TCPFlowQueuedByteReservationError.nonPositive(.sshToLocal)
    91	    }
    92	    let (total, overflow) = localToSSHBytes.addingReportingOverflow(sshToLocalBytes)
    93	    guard !overflow else { throw TCPFlowQueuedByteReservationError.totalOverflow }
    94	    self.localToSSHBytes = localToSSHBytes
    95	    self.sshToLocalBytes = sshToLocalBytes
    96	    totalBytes = total
    97	  }
    98	
    99	  /// Uses the exact fixed directional capacities already validated for a
   100	  /// bounded full-duplex pump, avoiding a second independently tuned value.
   101	  public init(pumpConfiguration: BoundedFullDuplexBytePumpConfiguration) {
   102	    localToSSHBytes = pumpConfiguration.localReadChunkBytes
   103	    sshToLocalBytes = pumpConfiguration.remoteReadChunkBytes
   104	    totalBytes = pumpConfiguration.perFlowReservedBufferBytes
   105	  }
   106	}
