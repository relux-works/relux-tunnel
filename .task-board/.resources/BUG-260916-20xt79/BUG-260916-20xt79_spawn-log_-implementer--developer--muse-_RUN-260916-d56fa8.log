{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c409","stream":{"kind":"session","id":"01a0a9b7-1be4-70c3-9f65-33dc9d5961ad"},"sequence":95,"recorded_at":1780531400000185,"record_type":"event","durability":"durable","causation_id":"f764a614-f959-4acf-aa23-1fc534b9bf47","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f764a614-f959-4acf-aa23-1fc534b9bf47","run_stream":{"kind":"run","id":"f764a614-f959-4acf-aa23-1fc534b9bf47"},"task_stream":{"kind":"task","id":"01a0a9b7-59c3-7922-b87a-64e2ab0c2bba"},"task_id":"01a0a9b7-59c3-7922-b87a-64e2ab0c2bba","event":{"kind":"output","task_id":"01a0a9b7-59c3-7922-b87a-64e2ab0c2bba","chunk":"Read text file `Sources/ReluxTunnelMacOSAdapter/MacOSSSHBootstrapErrorMapper.swift`.\n1|import Foundation\n2|import Network\n3|import ReluxTunnelCore\n4|import Security\n5|\n6|/// macOS normalization layer for Network.framework and Security.framework failures.\n7|/// Platform values are consumed for classification and are never copied into diagnostics.\n8|public enum MacOSSSHBootstrapErrorMapper {\n9|  public static func network(\n10|    _ error: NWError,\n11|    stage: SSHBootstrapStage,\n12|    configurationGeneration: UInt64,\n13|    context: SSHBootstrapDiagnosticContext = .none\n14|  ) -> SSHBootstrapProviderError {\n15|    switch error {\n16|    case .posix(let code):\n17|      return SSHBootstrapErrorMapper.transport(\n18|        posixCode: Int32(code.rawValue),\n19|        stage: stage,\n20|        configurationGeneration: configurationGeneration,\n21|        context: context\n22|      )\n23|    case .dns:\n24|      return SSHBootstrapErrorMapper.transport(\n25|        .unavailable,\n26|        stage: stage,\n27|        configurationGeneration: configurationGeneration,\n28|        context: context\n29|      )\n30|    case .tls:\n31|      return SSHBootstrapErrorMapper.transport(\n32|        .unexpected,\n33|        stage: stage,\n34|        configurationGeneration: configurationGeneration,\n35|        context: context\n36|      )\n37|    case .wifiAware:\n38|      return SSHBootstrapErrorMapper.transport(\n39|        .unavailable,\n40|        stage: stage,\n41|        configurationGeneration: configurationGeneration,\n42|        context: context\n43|      )\n44|    @unknown default:\n45|      return SSHBootstrapErrorMapper.transport(\n46|        .unexpected,\n47|        stage: stage,\n48|        configurationGeneration: configurationGeneration,\n49|        context: context\n50|      )\n51|    }\n52|  }\n53|\n54|  public static func credential(\n55|    _ error: MacOSCredentialResolverError,\n56|    configurationGeneration: UInt64\n57|  ) -> SSHBootstrapProviderError {\n58|    switch error {\n59|    case .credentialNotProvisioned:\n60|      SSHBootstrapErrorMapper.credential(\n61|        .notProvisioned,\n62|        configurationGeneration: configurationGeneration\n63|      )\n64|    case .credentialAccessDenied:\n65|      SSHBootstrapErrorMapper.credential(\n66|        .accessDenied,\n67|        configurationGeneration: configurationGeneration\n68|      )\n69|    case .credentialWrongClass, .credentialMalformed:\n70|      SSHBootstrapErrorMapper.credential(\n71|        .malformed,\n72|        configurationGeneration: configurationGeneration\n73|      )\n74|    case .credentialGenerationMismatch:\n75|      SSHBootstrapErrorMapper.credential(\n76|        .generationMismatch,\n77|        configurationGeneration: configurationGeneration\n78|      )\n79|    case .credentialPassphraseRequired:\n80|      SSHBootstrapErrorMapper.credential(\n81|        .passphraseRequired,\n82|        configurationGeneration: configurationGeneration\n83|      )\n84|    case .credentialPassphraseInvalid:\n85|      SSHBootstrapErrorMapper.credential(\n86|        .passphraseInvalid,\n87|        configurationGeneration: configurationGeneration\n88|      )\n89|    case .credentialKeyUnsupported:\n90|      SSHBootstrapErrorMapper.credential(\n91|        .keyUnsupported,\n92|        configurationGeneration: configurationGeneration\n93|      )\n94|    case .operationCancelled:\n95|      SSHBootstrapErrorMapper.cancellation(\n96|        .taskCancelled,\n97|        configurationGeneration: configurationGeneration\n98|      )\n99|    }\n100|  }\n101|\n102|  static func credential(\n103|    status: OSStatus,\n104|    itemLookup: Bool,\n105|    configurationGeneration: UInt64\n106|  ) -> SSHBootstrapProviderError {\n107|    credential(\n108|      MacOSCredentialResolverError(status: status, itemLookup: itemLookup),\n109|      configurationGeneration: configurationGeneration\n110|    )\n111|  }\n112|}","final_result":true}}}
