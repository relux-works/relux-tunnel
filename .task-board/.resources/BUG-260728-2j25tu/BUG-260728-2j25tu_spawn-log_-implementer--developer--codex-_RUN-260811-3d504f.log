The unrelated LibSSH suite is already serialized; its intermittent hang is not caused by parallel execution inside that suite. The two interrupted task-created SSH fixtures are cleaned up. I’m restarting the unfiltered gate and will treat any recurrence as a recorded external anomaly, without changing or stashing the user’s unrelated work.
exec
/bin/zsh -lc 'task_evidence_dir=$(mktemp -d /tmp/BUG-260728-2j25tu.final3.XXXXXX)
for task_run in $(seq 1 20); do
  task_started=$(date +%s)
  swift test > "$task_evidence_dir/full-swift-test-$task_run.log" 2>&1
  task_code=$?
  task_elapsed=$(($(date +%s) - task_started))
  task_summary=$(rg '"'Test run with .* passed|Test run with .* failed' \""'$task_evidence_dir/full-swift-test-$task_run.log" | tail -n 1)
  printf '"'run=%02d exit=%d elapsed_seconds=%d summary=%s\\n' \""'$task_run" "$task_code" "$task_elapsed" "$task_summary"
  if [ "$task_code" -ne 0 ]; then
    printf '"'failure_log=%s\\n' \""'$task_evidence_dir/full-swift-test-$task_run.log"
    exit "$task_code"
  fi
done
