+
+static void sleep_milliseconds(long milliseconds)
+{
+    struct timespec duration;
+
+    duration.tv_sec = milliseconds / 1000;
+    duration.tv_nsec = (milliseconds % 1000) * 1000000;
+    while(nanosleep(&duration, &duration) && errno == EINTR)
