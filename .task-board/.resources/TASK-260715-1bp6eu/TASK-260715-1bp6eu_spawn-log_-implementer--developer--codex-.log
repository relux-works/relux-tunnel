+      let graceful = Task {
+        await runtime.stop(reason: reason)
+        first.resolve(.graceful)
+      }
+      let deadline = Task {
+        do {
+          try await clock.sleep(for: cleanupBudget)
+          first.resolve(.deadline)
+        } catch {
