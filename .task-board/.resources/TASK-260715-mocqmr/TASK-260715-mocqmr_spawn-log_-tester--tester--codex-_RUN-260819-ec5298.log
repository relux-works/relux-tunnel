   605	def run_gate(arguments: argparse.Namespace) -> int:
   606	    gate = SmokeGate(
   607	        target=arguments.target,
   608	        runner_kind=arguments.runner_kind,
   609	        runner_name=arguments.runner_name,
   610	        runner_owner=arguments.runner_owner,
   611	        evidence_path=Path(arguments.evidence),
   612	        emulator=arguments.emulator,
   613	        require_native=arguments.require_native,
   614	    )
   615	    try:
   616	        gate.validate_runner()
   617	        executable = Path(os.path.abspath(arguments.executable))
   618	        manifest_path = Path(os.path.abspath(arguments.manifest))
   619	        gate.validate_asset(executable, manifest_path)
   620	        gate.exercise_runtime(executable, manifest_path)
   621	    except GateFailure as error:
   622	        gate.finish("fail", error.code)
   623	        print(f"relay-asset-smoke: {error.code}", file=sys.stderr)
   624	        return 1
   625	    gate.finish("pass")
   626	    return 0
