+    let retirement = Task {
+      do {
+        try await signal.wait()
+        first.resolve(.retired)
+      } catch {
+        // The source won and removed this retirement subscription.
+      }
+    }
+    let result = await first.wait()
+    if case .value = result { retirement.cancel() }
+    switch result {
+    case .value(let snapshot):
+      return snapshot
+    case .retired:
+      return nil
+    }
+  }
