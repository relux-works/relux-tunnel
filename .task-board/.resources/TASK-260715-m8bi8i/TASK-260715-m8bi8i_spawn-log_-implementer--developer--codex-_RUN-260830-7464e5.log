    self.taskStackSizeBytes = taskStackSizeBytes
    self.tcpBufferSizeBytes = tcpBufferSizeBytes
    self.udpCopyBufferCount = udpCopyBufferCount
    self.maximumSessionCount = maximumSessionCount
    self.udpMode = udpMode
  }
