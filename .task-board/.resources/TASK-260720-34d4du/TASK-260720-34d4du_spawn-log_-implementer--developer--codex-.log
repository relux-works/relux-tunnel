+        case "ecdsa-sha2-nistp521":
+            self.init(
+                backingSignature: .ecdsaP521(
+                    try P521.Signing.ECDSASignature(rawRepresentation: externalSignatureBytes.readableBytesView)
+                )
+            )
+        default:
+            throw NIOSSHError.unknownSignature(algorithm: algorithm)
+        }
+    }
