   354	      try sendAll(request, to: peer)
   355	      let first = await relay.next()
   356	
   357	      let result = await adapter.receiveRelayError(
   358	        associationID: first.envelope.associationID,
   359	        generation: 41,
   360	        error: .generated(code)
   361	      )
   362	      guard case .applied(let key, from: .active, to: .active) = result else {
   363	        Issue.record("nonterminal relay error did not preserve active state")
   364	        Darwin.close(peer)
   365	        continue
   366	      }
   367	      #expect(key.associationID == first.envelope.associationID)
   368	      #expect(relay.snapshot().isEmpty)
   369	
   370	      try sendAll(request, to: peer)
   371	      let continued = await relay.next()
   372	      #expect(continued.envelope.associationID == first.envelope.associationID)
   373	      #expect(continued.envelope.payload == request)
   374	
   375	      let response = RelayDatagram(
   376	        endpoint: RelayDatagramEndpoint(
   377	          address: .ipv6(Data((0..<16).map(UInt8.init))),
   378	          port: 8_443
   379	        ),
   380	        data: Data([9, 8, 7])
   381	      )
   382	      #expect(
   383	        await adapter.receiveRelayDatagram(
   384	          associationID: first.envelope.associationID,
   385	          generation: 41,
   386	          datagram: response
   387	        ) == .delivered
   388	      )
   389	      let encodedResponse = try encoded(response)
   390	      #expect(try await receiveExactly(encodedResponse.count, from: peer) == encodedResponse)
   391	
   392	      let active = await adapter.snapshot()
   393	      #expect(active.registry.activeAssociations == 1)
   394	      #expect(active.metrics.remoteErrors == 1)
   395	      #expect(
   396	        active.metrics.remoteQueueSaturatedDropped
   397	          == (code == .queueSaturated ? 1 : 0)
   398	      )
   399	      #expect(
   400	        active.metrics.remoteDatagramTooLargeDropped
   401	          == (code == .datagramTooLarge ? 1 : 0)
   402	      )
   403	
   404	      _ = await adapter.receiveRelayClose(
   405	        associationID: first.envelope.associationID,
   406	        generation: 41
   407	      )
   408	      #expect(try await receiveEOF(from: peer))
   409	      Darwin.close(peer)
   410	      let acknowledgement = await relay.next()
   411	      #expect(acknowledgement.envelope.type == .closeAssociation)
   412	      #expect(acknowledgement.envelope.associationID == first.envelope.associationID)
   413	      let baseline = await adapter.snapshot()
   414	      #expect(baseline.activeConnections == 0)
   415	      #expect(baseline.registry.associationCount == 0)
   416	      #expect(baseline.metrics.remoteCloses == 1)
   417	      #expect(baseline.inboundQueuedBytes == 0)
   418	      #expect(baseline.outboundQueuedBytes == 0)
   419	    }
   420	  }
