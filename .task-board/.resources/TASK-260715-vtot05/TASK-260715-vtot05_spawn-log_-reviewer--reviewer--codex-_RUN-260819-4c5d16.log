   797	def manifest_linkage_subject(config: dict[str, Any]) -> dict[str, Any]:
   798	    artifact = config["artifactManifest"]
   799	    asset_source = load_json(ROOT / artifact["sourceContract"])
   800	    return {
   800	    return {
   801	        "manifestName": artifact["manifestName"],
   802	        "manifestSchemaSHA256": sha256_file(ROOT / artifact["schema"]),
   803	        "sourceCommit": config["source"]["revision"],
   804	        "sourceAggregateSHA256": config["source"]["aggregateSHA256"],
   805	        "buildRecipeRevision": config["build"]["recipeRevision"],
   806	        "buildRecipeAggregateSHA256": config["build"]["recipeAggregateSHA256"],
   807	        "toolchainManifestSHA256": next(
   808	            item["sha256"]
   809	            for item in config["build"]["recipeFiles"]
   810	            if item["path"] == "relay/toolchain-manifest-v1.json"
   811	        ),
   812	        "archiveSHA256": artifact["archiveSHA256"],
   813	        "assets": [
   814	            {
   815	                key: entry[key]
   816	                for key in ("os", "arch", "fileName", "byteSize", "sha256")
   817	            }
   818	            for entry in asset_source["assets"]
   819	        ],
   820	    }
   821	
   822	
   823	def linkage_id(config: dict[str, Any]) -> str:
   824	    return sha256_bytes(compact_json(manifest_linkage_subject(config)))
   825	
   826	
   827	def render_inventory(config: dict[str, Any]) -> bytes:
   828	    link = linkage_id(config)
   829	    components = []
   830	    for component in config["components"]:
   831	        components.append(
   832	            {
   833	                "id": component["id"],
   834	                "name": component["name"],
   835	                "version": component["version"],
   836	                "revision": component["revision"],
   837	                "contentSHA256": component["contentSHA256"],
   838	                "source": component["source"],
   839	                "license": component["license"],
   840	                "noticeObligation": component["noticeObligation"],
   841	                "byteAffecting": component["byteAffecting"],
   842	                "distribution": component["distribution"],
   843	                "vulnerabilityReview": {
   844	                    "identifier": component["id"],
   845	                    "version": component["version"],
   846	                },
   847	            }
   848	        )
   849	    return stable_json(
   850	        {
   851	            "schemaVersion": 1,
   852	            "kind": "relay-scoped-dependency-inventory",
   853	            "manifestLinkageSHA256": link,
   854	            "dependencyLock": config["dependencyLock"],
   855	            "components": components,
   856	            "metadataTools": config["metadataTools"],
   857	            "runtimePolicy": config["runtimePolicy"],
   858	        }
   859	    )
   860	
   861	
   862	def render_notices(config: dict[str, Any]) -> bytes:
   863	    lines = [
   864	        "Relux Relay product notice input\n",
   865	        "Generated by scripts/relay_supply_chain.py from relay/supply-chain-source-v1.json.\n",
   866	        "Do not edit this generated file.\n",
   867	    ]
   868	    groups: dict[tuple[str, str], list[dict[str, Any]]] = {}
   869	    for component in config["components"]:
   870	        if component["noticeObligation"] != "include-full-license":
   871	            continue
   872	        key = (component["license"], component["licenseTextSHA256"])
   873	        groups.setdefault(key, []).append(component)
   874	    for components in groups.values():
   875	        component = components[0]
   876	        text = (
   877	            (ROOT / component["licenseTextPath"]).read_text(encoding="utf-8").rstrip()
   878	        )
   879	        covered = ", ".join(item["name"] for item in components)
   880	        revisions = ", ".join(f"{item['id']}={item['revision']}" for item in components)
   881	        lines.extend(
   882	            [
   883	                "\n",
   884	                "=" * 72 + "\n",
   885	                f"{covered} ({component['license']})\n",
   886	                f"Revisions: {revisions}\n",
   887	                f"License SHA-256: {component['licenseTextSHA256']}\n",
   888	                "=" * 72 + "\n",
   889	                text + "\n",
   890	            ]
   891	        )
   892	    return "".join(lines).encode("utf-8")
   893	
