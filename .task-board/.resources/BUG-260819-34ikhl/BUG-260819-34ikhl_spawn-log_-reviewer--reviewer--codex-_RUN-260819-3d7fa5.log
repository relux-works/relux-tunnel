  func snapshot() -> DependencySnapshot {
    DependencySnapshot(
      clockRead: clockRead,
      transportCreated: transportCreated,
      packetEndpointCreated: packetEndpointCreated,
      runtimeComposed: runtimeComposed,
      pressureRead: pressureRead,
      faultOperations: faultOperations
    )
  }
}

