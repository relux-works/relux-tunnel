    73	private final class MacOSNEPacketFlowDriver: PacketFlowPlatformDriver, @unchecked Sendable {
    74	  private let packetFlow: NEPacketTunnelFlow
    75	
    76	  init(packetFlow: NEPacketTunnelFlow) {
    77	    self.packetFlow = packetFlow
    78	  }
    79	
    80	  func registerRead(
    81	    _ callback: @escaping @Sendable ([Data], [Int32]) -> Void
    82	  ) {
    83	    packetFlow.readPackets { packets, protocols in
    84	      callback(packets, protocols.map(\.int32Value))
    85	    }
    86	  }
    87	
    88	  func writePackets(_ packets: [Data], protocols: [Int32]) -> Bool {
    89	    packetFlow.writePackets(
