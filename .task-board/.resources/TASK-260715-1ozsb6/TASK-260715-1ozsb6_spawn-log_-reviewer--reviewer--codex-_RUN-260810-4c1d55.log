  1595	  private func phase(for state: SSHConnectionState) -> SSHTransportPhase {
  1596	    switch state {
  1597	    case .idle: .configuration
  1598	    case .resolving: .resolution
  1599	    case .tcpConnecting: .tcpConnect
  1600	    case .keyExchange: .initialKeyExchange
  1601	    case .awaitingHostDecision: .hostDecision
  1602	    case .authenticating: .authentication
  1603	    case .ready: .protocolProcessing
  1604	    case .rekeying: .rekey
  1605	    case .failed: .protocolProcessing
  1606	    case .closing, .closed: .transportClose
  1607	    }
  1608	  }
