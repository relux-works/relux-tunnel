  1235	  private mutating func parseNumber() throws {
  1236	    _ = consumeIf(UInt8(ascii: "-"))
  1237	    if consumeIf(UInt8(ascii: "0")) {
  1238	      if let next = peek, (UInt8(ascii: "0")...UInt8(ascii: "9")).contains(next) {
  1239	        throw RuntimeMessageCodecError.corruptPayload
  1240	      }
  1241	    } else {
  1242	      guard let first = peek, (UInt8(ascii: "1")...UInt8(ascii: "9")).contains(first) else {
  1243	        throw RuntimeMessageCodecError.corruptPayload
  1244	      }
  1245	      consumeDigits()
  1246	    }
  1247	    if consumeIf(UInt8(ascii: ".")) {
  1248	      guard let first = peek, (UInt8(ascii: "0")...UInt8(ascii: "9")).contains(first) else {
  1249	        throw RuntimeMessageCodecError.corruptPayload
  1250	      }
  1251	      consumeDigits()
  1252	    }
  1253	    if peek == UInt8(ascii: "e") || peek == UInt8(ascii: "E") {
  1254	      index += 1
  1255	      if peek == UInt8(ascii: "+") || peek == UInt8(ascii: "-") { index += 1 }
  1256	      guard let first = peek, (UInt8(ascii: "0")...UInt8(ascii: "9")).contains(first) else {
  1257	        throw RuntimeMessageCodecError.corruptPayload
  1258	      }
  1259	      consumeDigits()
  1260	    }
  1261	  }
  1262	
  1263	  private mutating func consumeDigits() {
  1264	    while let byte = peek, (UInt8(ascii: "0")...UInt8(ascii: "9")).contains(byte) {
  1265	      index += 1
  1266	    }
  1267	  }
  1268	
  1269	  private mutating func consumeLiteral(_ literal: StaticString) throws {
  1270	    for byte in String(describing: literal).utf8 {
  1271	      try consume(byte)
  1272	    }
  1273	  }
  1274	
  1275	  private mutating func consume(_ expected: UInt8) throws {
  1276	    guard peek == expected else { throw RuntimeMessageCodecError.corruptPayload }
  1277	    index += 1
  1278	  }
  1279	
  1280	  private mutating func consumeIf(_ expected: UInt8) -> Bool {
  1281	    guard peek == expected else { return false }
  1282	    index += 1
  1283	    return true
  1284	  }
  1285	
  1286	  private mutating func skipWhitespace() {
  1287	    while let byte = peek,
  1288	      byte == UInt8(ascii: " ") || byte == UInt8(ascii: "\n")
  1289	        || byte == UInt8(ascii: "\r") || byte == UInt8(ascii: "\t")
  1290	    {
  1291	      index += 1
  1292	    }
  1293	  }
  1294	
  1295	  private var peek: UInt8? {
  1296	    index < bytes.count ? bytes[index] : nil
  1297	  }
  1298	
  1299	  private func isHex(_ byte: UInt8) -> Bool {
  1300	    (UInt8(ascii: "0")...UInt8(ascii: "9")).contains(byte)
  1301	      || (UInt8(ascii: "a")...UInt8(ascii: "f")).contains(byte)
  1302	      || (UInt8(ascii: "A")...UInt8(ascii: "F")).contains(byte)
  1303	  }
  1304	}
     1	# Runtime Messages
     2	
     3	Use deterministic, bounded v1 JSON models to exchange non-secret configuration
     4	references and immutable runtime state without importing platform or transport
     5	types into `ReluxTunnelCore`.
     6	
     7	## Wire families
     8	
     9	The legacy `version` request and response remain an exact exception with only
    10	`kind` and `protocolVersion`. Every M1 app message has required
    11	`protocolVersion`, `kind`, and `schemaVersion` fields. `requestID` is the only
    12	optional common field and defaults to absent. The system-owned provider
    13	configuration and start request are not app messages; they carry a required
    14	`schemaVersion` instead of a command kind.
    15	
    16	| Model | Version | Maximum JSON bytes | Required payload fields | Defaults |
    17	| --- | --- | ---: | --- | --- |
    18	| `ProviderVersionRequest`, `ProviderVersionResponse` | protocol 1 | 4 KiB | `protocolVersion`, `kind=version` | request protocol version 1 when constructed |
    19	| `TunnelConfigurationReference` | schema 1 | 4 KiB | `schemaVersion`, `profileIdentifier` | current schema when constructed |
    20	| `RuntimeStartRequest` | schema 1 | 4 KiB | `schemaVersion`, `configurationReference` | current schema when constructed |
    21	| `RuntimeConfigurationSnapshot` | protocol 1, schema 1 | 64 KiB | generation, profile identity/revision, credential reference, trust reference, compatible route mode | absent `requestID` |
    22	| `RuntimeCommand` | protocol 1, schema 1 | 4 KiB | one read-only command kind | absent `requestID` |
    23	| `RuntimeProtocolCapabilitiesSnapshot` | protocol 1, schema 1 | 4 KiB | protocol range and per-kind schema ranges | current protocol range; absent `requestID` |
    24	| `RuntimeCapabilitySnapshot` | protocol 1, schema 1 | 16 KiB | generation, sequence, TCP, safe DNS, UDP, route mode, route-installed, and health facts | absent `requestID`; capability facts never default while decoding |
    25	| `RuntimeLifecycleSnapshot` | protocol 1, schema 1 | 16 KiB | generation, sequence, lifecycle/route state, and all capability facts | absent `requestID` and `error` |
    26	| `RuntimeDiagnosticsSnapshot` | protocol 1, schema 1 | 64 KiB | generation and sequence | absent `requestID`; empty aggregate collections |
    27	| `RuntimeProtocolError` | protocol 1, schema 1 | 4 KiB | finite error code and supported protocol/schema ranges | current supported ranges; absent `requestID` |
    28	
    29	All opaque identifiers encode as UUID strings. Configuration models have no
    30	arbitrary byte fields, free-form parameter dictionary, private-key field, or
    31	passphrase field. Credential and trust values are lookup references only.
    32	
    33	## Compatibility and rejection
    34	
    35	`RuntimeMessageCodec` and `RuntimeConfigurationCodec` emit sorted-key JSON and
    36	enforce the model-specific encoded limit in both directions. Decoding rejects
    37	invalid UTF-8, non-object roots, trailing bytes, duplicate keys (including
    38	escape-equivalent keys), nesting deeper than 16 levels, corrupt JSON numbers,
    39	missing required fields, unsupported protocol/schema versions, unknown input
    40	kinds, and unknown provider-input values through `RuntimeMessageCodecError`.
    41	The start-request decoder validates both its own schema version and the nested
    42	configuration-reference schema version before returning the request.
    43	
    44	Unknown object fields are ignored and disappear on re-encoding. Unknown output
    45	lifecycle, route-state, or route-mode values project to `unknown` with every
    46	capability false. Known capability fields remain required, so their absence is
    47	corrupt rather than an optimistic default. Diagnostics generation and sequence
    48	remain required while absent aggregate collections decode to their documented
    49	empty defaults. `RuntimeSnapshotPosition.isNewer(than:)` implements the
    50	generation/sequence discard rule.
    51	
    52	The v1 capability schema deliberately has independent `tcp`, `safeDNS`, `udp`,
    53	`routeMode`, `routesInstalled`, and `healthy` fields and no aggregate full-mode
    54	claim. M1 producers publish TCP and safe DNS independently while UDP remains
    55	false.

