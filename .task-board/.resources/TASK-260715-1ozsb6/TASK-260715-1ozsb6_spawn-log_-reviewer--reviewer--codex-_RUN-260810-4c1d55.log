  1579	  private func reconcileProtectedMetrics() async {
  1580	    guard let baseline = protectedNetworkBaseline else { return }
  1581	    let current = context.network.engineByteCounts
  1582	    let sent = current.sent - baseline.sent
  1583	    let received = current.received - baseline.received
  1584	    if sent > counters.protectedBytesSent {
  1585	      await metric(.increment(.protectedBytesSent, by: sent - counters.protectedBytesSent))
  1586	      counters.protectedBytesSent = sent
  1587	    }
  1588	    if received > counters.protectedBytesReceived {
  1589	      await metric(
  1590	        .increment(.protectedBytesReceived, by: received - counters.protectedBytesReceived))
  1591	      counters.protectedBytesReceived = received
  1592	    }
  1593	  }
