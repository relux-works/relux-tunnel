import json, re
from pathlib import Path
p = Path('docs/TASK-260715-whtdsf_ci-trust-and-quality-gate-contract.md')
text = p.read_text()
flat = re.sub(r'\\s+', ' ', text)
section = text.split('## 4. Required-check and branch-protection policy', 1)[1].split('## 5.', 1)[0]
checks = re.findall(r'"'^'"\\d+\\. "'`([''^`]+)`$'"', section, re.M)
expected = [
    'policy/github-actions', 'policy/board-spec', 'policy/version-release-metadata',
    'build/workspace-legacy', 'test/core-protocol', 'build/apple-credential-free',
    'build/relay-four-target', 'security/supply-chain', 'security/ci-threat-model',
]
assert checks == expected, checks
required = [
