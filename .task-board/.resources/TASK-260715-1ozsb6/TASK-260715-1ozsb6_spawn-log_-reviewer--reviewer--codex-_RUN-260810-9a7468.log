  1040	      try await withTimeout(remaining, clock: dependencies.clock) {
  1041	        try await self.context.network.service(
  1042	          connection: connection,
  1043	          interests: requestedInterests
  1044	        )
  1045	      }
  1046	    } catch is LibSSH2TimeoutError {
  1047	      throw transportError(code: .timedOut, phase: phase, scope: scope)
  1048	    } catch is CancellationError {
  1049	      throw transportError(code: .cancelled, phase: phase, scope: scope)
  1050	    } catch {
  1051	      throw transportError(code: .connectionLost, phase: phase)
  1052	    }
  1053	  }
