+
+  private func sanitizeProvenance(
+    _ sample: MemoryByteSample, expected: MemoryObservationProvenance
+  ) -> MemoryByteSample {
+    switch sample {
+    case .available(let bytes, let provenance) where provenance == expected:
+      return .available(bytes: bytes, provenance: provenance)
+    case .unavailable(let reason, let provenance) where provenance == expected:
+      return .unavailable(reason: reason, provenance: provenance)
+    case .available, .unavailable:
+      return .unavailable(reason: .malformed, provenance: expected)
+    }
+  }
+
+  private func sanitize(
