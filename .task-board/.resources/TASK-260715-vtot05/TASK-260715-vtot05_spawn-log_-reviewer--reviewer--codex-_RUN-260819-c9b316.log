   774	def manifest_linkage_subject(config: dict[str, Any]) -> dict[str, Any]:
   775	    artifact = config["artifactManifest"]
   776	    asset_source = load_json(ROOT / artifact["sourceContract"])
   777	    return {
   778	        "manifestName": artifact["manifestName"],
   779	        "manifestSchemaSHA256": sha256_file(ROOT / artifact["schema"]),
   780	        "sourceCommit": config["source"]["revision"],
   781	        "sourceAggregateSHA256": config["source"]["aggregateSHA256"],
   782	        "buildRecipeRevision": config["build"]["recipeRevision"],
   783	        "buildRecipeAggregateSHA256": config["build"]["recipeAggregateSHA256"],
   784	        "toolchainManifestSHA256": next(
   785	            item["sha256"]
   786	            for item in config["build"]["recipeFiles"]
   787	            if item["path"] == "relay/toolchain-manifest-v1.json"
   788	        ),
   789	        "archiveSHA256": artifact["archiveSHA256"],
   790	        "assets": [
   791	            {
   792	                key: entry[key]
   793	                for key in ("os", "arch", "fileName", "byteSize", "sha256")
   794	            }
   795	            for entry in asset_source["assets"]
   796	        ],
   797	    }
