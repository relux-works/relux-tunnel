#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
task_output="$repo_root/.temp/TASK-260715-uyju7n"
products="$task_output/Products"
intermediates="$task_output/Intermediates"
derived_data="$task_output/DerivedData-validation"

mkdir -p "$task_output"
