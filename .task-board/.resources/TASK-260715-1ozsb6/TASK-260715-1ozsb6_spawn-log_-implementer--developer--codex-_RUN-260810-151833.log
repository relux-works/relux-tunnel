+  private func handleOperationFailure(
+    _ error: Error,
+    phase: SSHTransportPhase,
+    fallback: SSHTransportErrorCode = .adapterFailure,
+    scope: SSHTransportErrorScope? = nil,
+    resetChannel identity: SSHChannelIdentity? = nil
