   357	private enum RelayVectorCorpusLoader {
   358	  static let corpusURL: URL = {
   359	    let testFile = URL(fileURLWithPath: #filePath)
   360	    let root = testFile.deletingLastPathComponent()
   361	      .deletingLastPathComponent()
   362	      .deletingLastPathComponent()
   363	      .deletingLastPathComponent()
   364	    return root.appendingPathComponent("Protocol/Relay/Vectors/v1/corpus.json")
   365	  }()
   366	
   367	  static func load() throws -> RelayVectorCorpus {
   368	    try decode(Data(contentsOf: corpusURL))
   369	  }
   370	
   371	  static func decode(_ data: Data) throws -> RelayVectorCorpus {
   372	    let root = try requireObject(
   373	      JSONSerialization.jsonObject(with: data),
   374	      vectorID: "<corpus>"
   375	    )
   376	    try exactKeys(
   377	      root,
   378	      ["formatVersion", "protocolVersion", "provenance", "vectors"],
   379	      vectorID: "<corpus>"
   380	    )
   381	    let provenance = try requireObject(root["provenance"], vectorID: "<corpus>")
   382	    try exactKeys(
   383	      provenance,
   384	      [
   385	        "generator", "generatorFormatVersion", "generatorSHA256", "privacy",
   386	        "regenerateCommand", "reviewPolicy", "schemaSHA256", "sources", "task",
   387	      ],
   388	      vectorID: "<corpus>"
   389	    )
   390	    let review = try requireObject(provenance["reviewPolicy"], vectorID: "<corpus>")
   391	    try exactKeys(
   392	      review,
   393	      ["compatibility", "identifiers", "requiredConsumers"],
   394	      vectorID: "<corpus>"
   395	    )
   396	    guard let rawVectors = root["vectors"] as? [Any] else {
   397	      throw RelayVectorHarnessFailure(vectorID: "<corpus>", reason: "vectors is not an array")
   398	    }
   399	    for rawVector in rawVectors {
   400	      let object = try requireObject(rawVector, vectorID: "<unknown>")
   401	      let identifier = object["id"] as? String ?? "<unknown>"
   402	      try exactKeys(
   403	        object,
   404	        [
   405	          "chunks", "covers", "direction", "expected", "features", "id",
   406	          "inputHex", "kind", "limitRefs", "protocolVersion",
   407	        ],
   408	        vectorID: identifier
   409	      )
   410	      let expected = try requireObject(object["expected"], vectorID: identifier)
   411	      try validateExpected(expected, kind: object["kind"] as? String, vectorID: identifier)
   412	      if let frames = expected["frames"] as? [Any] {
   413	        for frame in frames {
   414	          try exactKeys(
   415	            requireObject(frame, vectorID: identifier),
   416	            ["associationID", "flags", "messageType", "payloadHex"],
   417	            vectorID: identifier
   418	          )
   419	        }
   420	      }
   421	    }
   422	
   423	    let corpus: RelayVectorCorpus
   424	    do {
   425	      corpus = try JSONDecoder().decode(RelayVectorCorpus.self, from: data)
   426	    } catch {
   427	      throw RelayVectorHarnessFailure(vectorID: "<corpus>", reason: "typed schema decode failed")
   428	    }
   429	    try validate(corpus)
   430	    return corpus
   431	  }
   432	
   433	  private static func validate(_ corpus: RelayVectorCorpus) throws {
   434	    guard corpus.formatVersion == 1 else {
   435	      throw RelayVectorHarnessFailure(vectorID: "<corpus>", reason: "unsupported format version")
   436	    }
   437	    guard corpus.protocolVersion == RelayProtocolV1.wireVersion else {
   438	      throw RelayVectorHarnessFailure(vectorID: "<corpus>", reason: "protocol version mismatch")
   439	    }
   440	    guard
   441	      corpus.provenance.generator == "scripts/relay-protocol-vectors.py",
   442	      corpus.provenance.generatorFormatVersion == 1,
   443	      corpus.provenance.generatorSHA256.count == 64,
   444	      corpus.provenance.privacy == "synthetic-only-rfc-reserved-endpoints",
   445	      corpus.provenance.regenerateCommand == "make relay-protocol-vectors-generate",
   446	      corpus.provenance.schemaSHA256 == RelayProtocolV1.schemaSHA256,
   447	      corpus.provenance.task == "TASK-260715-1q7u14",
   448	      Set(corpus.provenance.reviewPolicy.requiredConsumers) == [
   449	        "Swift ReluxTunnelCoreTests", "Go relay/internal/protocol",
   450	      ],
   451	      !corpus.provenance.reviewPolicy.compatibility.isEmpty,
   452	      !corpus.provenance.reviewPolicy.identifiers.isEmpty,
   453	      !corpus.provenance.sources.isEmpty
   454	    else {
   455	      throw RelayVectorHarnessFailure(vectorID: "<corpus>", reason: "invalid provenance")
   456	    }
   457	
   458	    var identifiers: Set<String> = []
   459	    var coverage: Set<String> = []
   460	    for vector in corpus.vectors {
   461	      guard
   462	        vector.id.hasPrefix("v1."),
   463	        vector.id.unicodeScalars.allSatisfy({
   464	          CharacterSet(charactersIn: "abcdefghijklmnopqrstuvwxyz0123456789.-").contains($0)
   465	        }),
   466	        identifiers.insert(vector.id).inserted
   467	      else {
   468	        throw RelayVectorHarnessFailure(
   469	          vectorID: vector.id, reason: "invalid or duplicate identifier")
   470	      }
   471	      guard vector.protocolVersion == corpus.protocolVersion else {
   472	        throw RelayVectorHarnessFailure(vectorID: vector.id, reason: "protocol version mismatch")
   473	      }
   474	      let input = try decodeHex(vector.inputHex, vectorID: vector.id)
