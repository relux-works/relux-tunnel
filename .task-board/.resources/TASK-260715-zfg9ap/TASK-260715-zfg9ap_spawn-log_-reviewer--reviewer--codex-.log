   212	/// A generation-scoped, fixed-size coalescing cell for authoritative TCP gauges.
   213	///
   214	/// The registry is the single writer for a generation. Publications use only
   215	/// atomics and never wait for the bounded diagnostics queue. Snapshot readers
   216	/// use the sequence as a seqlock so they never export a mixture of two registry
   217	/// states. A stale recorder owns a different cell and therefore cannot affect a
   218	/// later generation.
   219	private final class RuntimeTCPAdmissionGaugeReconciler: Sendable {
   220	  private let sequence = Atomic<UInt64>(0)
   221	  private let published = Atomic(false)
   222	  private let sessionHealthCode = Atomic<Int64>(0)
   223	  private let pendingHandshakes = Atomic<Int64>(0)
   224	  private let reservedFlows = Atomic<Int64>(0)
   225	  private let parsingFlows = Atomic<Int64>(0)
   226	  private let openingFlows = Atomic<Int64>(0)
   227	  private let streamingFlows = Atomic<Int64>(0)
   228	  private let halfClosedFlows = Atomic<Int64>(0)
   229	  private let openChannels = Atomic<Int64>(0)
   230	  private let reservedQueuedBytes = Atomic<Int64>(0)
   231	  private let adapterBufferedBytes = Atomic<Int64>(0)
   232	  private let localToSSHBufferedBytes = Atomic<Int64>(0)
   233	  private let sshToLocalBufferedBytes = Atomic<Int64>(0)
   234	  private let peakPendingHandshakes = Atomic<Int64>(0)
   235	  private let peakReservedFlows = Atomic<Int64>(0)
   236	  private let peakOpeningFlows = Atomic<Int64>(0)
   237	  private let peakOpenChannels = Atomic<Int64>(0)
   238	  private let peakReservedQueuedBytes = Atomic<Int64>(0)
   239	  private let peakAdapterBufferedBytes = Atomic<Int64>(0)
   240	
   241	  func publish(_ snapshot: TCPAdmissionGaugeSnapshot) {
   242	    _ = sequence.wrappingAdd(1, ordering: .acquiringAndReleasing)
   243	    sessionHealthCode.store(snapshot.sessionHealthCode, ordering: .relaxed)
   244	    pendingHandshakes.store(snapshot.pendingHandshakes, ordering: .relaxed)
   245	    reservedFlows.store(snapshot.reservedFlows, ordering: .relaxed)
   246	    parsingFlows.store(snapshot.parsingFlows, ordering: .relaxed)
   247	    openingFlows.store(snapshot.openingFlows, ordering: .relaxed)
   248	    streamingFlows.store(snapshot.streamingFlows, ordering: .relaxed)
   249	    halfClosedFlows.store(snapshot.halfClosedFlows, ordering: .relaxed)
   250	    openChannels.store(snapshot.openChannels, ordering: .relaxed)
   251	    reservedQueuedBytes.store(snapshot.reservedQueuedBytes, ordering: .relaxed)
   252	    adapterBufferedBytes.store(snapshot.adapterBufferedBytes, ordering: .relaxed)
   253	    localToSSHBufferedBytes.store(snapshot.localToSSHBufferedBytes, ordering: .relaxed)
   254	    sshToLocalBufferedBytes.store(snapshot.sshToLocalBufferedBytes, ordering: .relaxed)
   255	    peakPendingHandshakes.store(snapshot.peakPendingHandshakes, ordering: .relaxed)
   256	    peakReservedFlows.store(snapshot.peakReservedFlows, ordering: .relaxed)
   257	    peakOpeningFlows.store(snapshot.peakOpeningFlows, ordering: .relaxed)
   258	    peakOpenChannels.store(snapshot.peakOpenChannels, ordering: .relaxed)
   259	    peakReservedQueuedBytes.store(snapshot.peakReservedQueuedBytes, ordering: .relaxed)
   260	    peakAdapterBufferedBytes.store(snapshot.peakAdapterBufferedBytes, ordering: .relaxed)
   261	    published.store(true, ordering: .releasing)
   262	    _ = sequence.wrappingAdd(1, ordering: .releasing)
   263	  }
   264	
   265	  func load() -> TCPAdmissionGaugeSnapshot? {
   266	    guard published.load(ordering: .acquiring) else { return nil }
   267	    while true {
   268	      let before = sequence.load(ordering: .acquiring)
   269	      guard before.isMultiple(of: 2) else {
   270	        continue
   271	      }
   272	      let snapshot = TCPAdmissionGaugeSnapshot(
   273	        sessionHealthCode: sessionHealthCode.load(ordering: .relaxed),
   274	        pendingHandshakes: pendingHandshakes.load(ordering: .relaxed),
   275	        reservedFlows: reservedFlows.load(ordering: .relaxed),
   276	        parsingFlows: parsingFlows.load(ordering: .relaxed),
   277	        openingFlows: openingFlows.load(ordering: .relaxed),
   278	        streamingFlows: streamingFlows.load(ordering: .relaxed),
   279	        halfClosedFlows: halfClosedFlows.load(ordering: .relaxed),
   280	        openChannels: openChannels.load(ordering: .relaxed),
   281	        reservedQueuedBytes: reservedQueuedBytes.load(ordering: .relaxed),
   282	        adapterBufferedBytes: adapterBufferedBytes.load(ordering: .relaxed),
   283	        localToSSHBufferedBytes: localToSSHBufferedBytes.load(ordering: .relaxed),
   284	        sshToLocalBufferedBytes: sshToLocalBufferedBytes.load(ordering: .relaxed),
   285	        peakPendingHandshakes: peakPendingHandshakes.load(ordering: .relaxed),
   286	        peakReservedFlows: peakReservedFlows.load(ordering: .relaxed),
   287	        peakOpeningFlows: peakOpeningFlows.load(ordering: .relaxed),
   288	        peakOpenChannels: peakOpenChannels.load(ordering: .relaxed),
   289	        peakReservedQueuedBytes: peakReservedQueuedBytes.load(ordering: .relaxed),
   290	        peakAdapterBufferedBytes: peakAdapterBufferedBytes.load(ordering: .relaxed)
   291	      )
   292	      guard sequence.load(ordering: .acquiring) == before else { continue }
   293	      return snapshot
   294	    }
   295	  }
   296	}
