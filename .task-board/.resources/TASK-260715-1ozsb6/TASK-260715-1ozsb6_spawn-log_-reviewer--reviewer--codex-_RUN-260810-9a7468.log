  1853	  private func scheduleByteRekeyIfNeeded() async {
  1854	    guard let configuration, !byteRekeyScheduled else { return }
  1855	    if let completedTask = byteRekeyTask {
  1856	      await completedTask.value
  1857	      byteRekeyTask = nil
  1858	    }
  1859	    let threshold = configuration.rekey.protectedByteThresholdPerDirection
  1860	    guard
  1861	      counters.protectedBytesSent - rekeySentBytesBaseline >= threshold
  1862	        || counters.protectedBytesReceived - rekeyReceivedBytesBaseline >= threshold
