+private struct FixtureResolver: SSHNetworkResolver {
+  func resolve(hostname: String, port: UInt16) async throws -> [SSHResolvedEndpoint] {
+    [
+      try SSHResolvedEndpoint(
+        addressFamily: .ipv4,
+        addressBytes: Data([127, 0, 0, 1]),
+        port: port
+      )
