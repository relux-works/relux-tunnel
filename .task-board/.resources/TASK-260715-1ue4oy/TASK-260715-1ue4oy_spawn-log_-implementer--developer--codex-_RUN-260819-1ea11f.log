+def directory_identity(path: Path, label: str) -> tuple[int, int]:
+    try:
+        status = os.lstat(path)
+    except OSError as error:
+        raise AssetManifestError(f"{label} is unavailable") from error
+    if not stat.S_ISDIR(status.st_mode) or stat.S_ISLNK(status.st_mode):
+        raise AssetManifestError(f"{label} is not a safe directory")
+    return status.st_dev, status.st_ino
+
+
+def remove_owned_directory(path: Path, identity: tuple[int, int]) -> None:
+    try:
+        status = os.lstat(path)
+    except FileNotFoundError:
+        return
+    except OSError as error:
+        raise AssetManifestError("relay asset staging cleanup failed") from error
+    if (
+        not stat.S_ISDIR(status.st_mode)
+        or stat.S_ISLNK(status.st_mode)
+        or (status.st_dev, status.st_ino) != identity
+    ):
+        raise AssetManifestError(
+            "relay asset staging ownership changed; refusing unsafe cleanup"
+        )
+    if not shutil.rmtree.avoids_symlink_attacks:
+        raise AssetManifestError("safe relay asset staging cleanup is unavailable")
+    try:
+        shutil.rmtree(path)
+    except OSError as error:
+        raise AssetManifestError("relay asset staging cleanup failed") from error
+
+
+def fsync_directory(path: Path) -> None:
+    descriptor = open_bundle_directory(path)
+    try:
+        os.fsync(descriptor)
+    except OSError as error:
+        raise AssetManifestError("relay asset directory sync failed") from error
+    finally:
+        os.close(descriptor)
+
+
+def atomic_exchange(left: Path, right: Path) -> None:
+    library = ctypes.CDLL(None, use_errno=True)
+    left_bytes = os.fsencode(left)
+    right_bytes = os.fsencode(right)
+    if sys.platform == "darwin":
+        function = library.renameatx_np
+        function.argtypes = [
+            ctypes.c_int,
+            ctypes.c_char_p,
+            ctypes.c_int,
+            ctypes.c_char_p,
+            ctypes.c_uint,
+        ]
+        function.restype = ctypes.c_int
+        result = function(-2, left_bytes, -2, right_bytes, 0x00000002)
+    elif sys.platform.startswith("linux"):
+        function = library.renameat2
+        function.argtypes = [
+            ctypes.c_int,
+            ctypes.c_char_p,
+            ctypes.c_int,
+            ctypes.c_char_p,
+            ctypes.c_uint,
+        ]
+        function.restype = ctypes.c_int
+        result = function(-100, left_bytes, -100, right_bytes, 0x00000002)
+    else:
+        raise AssetManifestError(
+            "atomic relay asset directory replacement is unavailable"
+        )
+    if result != 0:
+        error_number = ctypes.get_errno()
+        raise AssetManifestError(
+            "atomic relay asset directory replacement failed"
+        ) from OSError(error_number, os.strerror(error_number))
+
+
+def publish_staged_bundle(
+    staging: Path,
+    bundle: Path,
+    event_hook: Callable[[str, Path], None] | None,
+) -> None:
+    parent = bundle.parent
+    try:
