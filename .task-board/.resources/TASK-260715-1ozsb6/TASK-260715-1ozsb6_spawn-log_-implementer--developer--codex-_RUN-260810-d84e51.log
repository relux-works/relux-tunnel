          UInt32(clamping: policy.initialReceiveWindowBytes),
          UInt32(clamping: min(policy.maximumWriteCallBytes, Int(LIBSSH2_CHANNEL_PACKET_DEFAULT))),
          bytes.bindMemory(to: CChar.self).baseAddress,
          UInt32(bytes.count)

