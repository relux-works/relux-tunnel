  2438	  func complete(with result: Result<Void, Error>) {
  2439	    let continuation: CheckedContinuation<Void, Error>? = lock.withLock {
  2440	      guard self.result == nil else { return nil }
  2441	      self.result = result
  2442	      defer { self.continuation = nil }
  2443	      return self.continuation
  2444	    }
  2445	    continuation?.resume(with: result)
  2446	  }
  2447	}
