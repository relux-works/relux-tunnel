// step8 performs safe cleanup. Force removal or deletion is never automatic.
func (s *session) step8(txn *Txn, result *Result) error {
	if txn.Phase != PhaseIntegrated {
		return nil
	}
	integrationFault(faultAfterIntegrated)
	// Cleanup of the managed worktree and branch is owned by the worktree
	// lifecycle surface, which already refuses on unmet preconditions. What this
	// step owns is recording that cleanup is now permitted, and leaving the
	// transaction at cleanup_pending so `worktree repair`/`gc` retries it.
	if err := s.txnStore.Advance(txn, PhaseCleanupPending); err != nil {
		return err
	}
	result.Notes = append(result.Notes,
		"safe cleanup is now eligible; `worktree cleanup` removes the workspace and branch only after exact commit ancestry, Story done, a committed board record, a clean workspace, and no active lease or RUN")
	return nil
}

