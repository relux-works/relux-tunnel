   340	  public func upload(_ request: SSHExecUploadRequest) async throws -> SSHExecExit {
   341	    let channel = try await openExecChannel(request: request.exec, policy: request.channelPolicy)
   342	    let execChannel = channel as! LibSSH2ExecChannel
   343	    do {
   344	      async let stdout: Void = drain(channel: execChannel, standardError: false)
   345	      async let stderr: Void = drain(channel: execChannel, standardError: true)
   346	      while let bytes = try await request.source.read(maximumBytes: request.chunkBytes) {
   347	        guard !bytes.isEmpty else {
   348	          throw transportError(code: .protocolViolation, phase: .uploadSource)
   349	        }
   350	        var offset = 0
   351	        while offset < bytes.count {
   352	          let written = try await execChannel.writeSome(Data(bytes[offset...]))
   353	          offset += written
   354	        }
   355	      }
   356	      try await execChannel.finishWriting()
   357	      let exit = try await execChannel.waitForExit()
   358	      _ = try await (stdout, stderr)
   359	      await execChannel.close()
   360	      return exit
   361	    } catch {
   362	      await execChannel.cancel()
   363	      throw map(error, phase: .uploadSource)
   364	    }
   365	  }
