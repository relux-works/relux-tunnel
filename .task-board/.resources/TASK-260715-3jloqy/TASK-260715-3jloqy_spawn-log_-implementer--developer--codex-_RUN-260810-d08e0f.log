+        CODE_SIGN_ENTITLEMENTS: Provisioning.entitlements
+        PRODUCT_BUNDLE_IDENTIFIER: works.relux.tunnel.mac.tunnel
+        PRODUCT_NAME: ReluxTunnelMacProviderProvisioning
+  ReluxTunnelProbeMacHostProvisioning:
+    type: application
+    platform: macOS
+    sources:
+      - Sources
+    settings:
+      base:
+        CODE_SIGN_ENTITLEMENTS: Provisioning.entitlements
+        PRODUCT_BUNDLE_IDENTIFIER: works.relux.tunnel.probe.mac
