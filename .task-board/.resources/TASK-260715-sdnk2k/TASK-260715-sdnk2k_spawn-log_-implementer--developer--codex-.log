+private func pumpConfiguration(
+  localChunk: Int = 8,
+  remoteChunk: Int = 8,
+  maximumSSHWriteCall: Int = 8,
+  aggregate: Int = 16,
+  fairnessOperations: Int = 8,
+  fairnessBytes: Int = 64,
+  readinessWakeups: Int = 4
