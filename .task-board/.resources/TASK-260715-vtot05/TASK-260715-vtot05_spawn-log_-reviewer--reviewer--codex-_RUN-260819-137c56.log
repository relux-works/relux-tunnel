   491	def parse_tar_number(field: bytes, label: str) -> int:
   492	    encoded = field.rstrip(b"\0 ").lstrip(b" ")
   493	    if not encoded or any(byte not in b"01234567" for byte in encoded):
   494	        raise AssetManifestError(f"trusted relay archive {label} is invalid")
   495	    return int(encoded, 8)
