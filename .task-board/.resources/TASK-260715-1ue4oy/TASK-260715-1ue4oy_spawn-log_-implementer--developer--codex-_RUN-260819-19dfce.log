   125	def sha256_file(path: Path) -> str:
   126	    digest = hashlib.sha256()
   127	    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
   128	    no_follow = getattr(os, "O_NOFOLLOW", None)
   129	    if no_follow is None:
   130	        raise AssetManifestError("trusted relay input no-follow reads are unavailable")
   131	    try:
   132	        descriptor = os.open(path, flags | no_follow)
   133	        with os.fdopen(descriptor, "rb") as stream:
   134	            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
   135	                raise AssetManifestError("trusted relay input is not a regular file")
   136	            for chunk in iter(lambda: stream.read(READ_CHUNK_BYTES), b""):
   137	                digest.update(chunk)
   138	    except OSError as error:
   139	        raise AssetManifestError("trusted relay input is unavailable") from error
   140	    return digest.hexdigest()
