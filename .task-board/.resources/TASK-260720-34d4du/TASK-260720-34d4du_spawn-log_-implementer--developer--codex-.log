  1194	extension SSHConnectionStateMachine {
  1195	    /// The result of spinning the state machine with an inbound message.
  1196	    ///
  1197	    /// When the state machine processes a message, several things may happen. Firstly, it may generate an
  1198	    /// automatic message that should be sent. Secondly, it may generate a possibility of having a message in
  1199	    /// future. Thirdly, it may be a message targetted to one of the child channels. Fourthly, it may require us to disconnect.
  1200	    /// Fifthly, it may generate nothing.
  1201	    enum StateMachineInboundProcessResult {
  1202	        case emitMessage(SSHMultiMessage)
  1203	        case possibleFutureMessage(EventLoopFuture<SSHMultiMessage?>)
  1204	        case forwardToMultiplexer(SSHMessage)
  1205	        case globalRequestResponse(GlobalRequestResponse)
  1206	        case globalRequest(SSHMessage.GlobalRequestMessage)
  1207	        case disconnect
  1208	        case noMessage
  1209	        case event(Any)
  1210	
  1211	        enum GlobalRequestResponse {
  1212	            case success(SSHMessage.RequestSuccessMessage)
  1213	            case failure
  1214	        }
  1215	    }
  1216	}
