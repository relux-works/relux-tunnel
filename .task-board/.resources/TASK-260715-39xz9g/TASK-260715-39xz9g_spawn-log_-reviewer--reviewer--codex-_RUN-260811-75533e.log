   265	    digest = hashlib.sha256()
   266	    remaining = total_bytes
   267	    while remaining:
   268	        chunk = block[: min(remaining, len(block))]
   269	        digest.update(chunk)
   270	        remaining -= len(chunk)
   271	    return f"SHA256:{digest.hexdigest()}"
