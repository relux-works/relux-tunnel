tKeyAlgorithm] = [\n40|    .sshEd25519,\n41|    .ecdsaNISTP256,\n42|    .ecdsaNISTP384,\n43|    .ecdsaNISTP521,\n44|    .rsaSHA2512,\n45|    .rsaSHA2256,\n46|  ]\n47|}\n48|\n49|public enum SSHHostIdentityState: String, Codable, Sendable {\n50|  case approved\n51|  case revoked\n52|}\n53|\n54|public enum SSHHostIdentityProvenance: String, Codable, Sendable {\n55|  case firstUseApproval\n56|  case changedKeyReplacement\n57|}\n58|\n59|public enum SSHHostIdentityRevocationReason: String, Codable, Sendable {\n60|  case replaced\n61|  case userRevoked\n62|}\n63|\n64|public struct SSHProfileTimestamp: Equatable, Sendable {\n65|  public let rawValue: String\n66|\n67|  public init(_ rawValue: String) {\n68|    self.rawValue = rawValue\n69|  }\n70|}\n71|\n72|public struct SSHHostKeyFingerprint: Equatable, Hashable, Sendable {\n73|  public let rawValue: String\n74|\n75|  public init(_ rawValue: String) {\n76|    self.rawValue = rawValue\n77|  }\n78|}\n79|\n80|/// Lowercase hexadecimal SHA-256 of the exact canonical snapshot bytes.\n81|public struct SSHProfileSnapshotDigestSHA256: Codable, Equatable, Sendable {\n82|  public let rawValue: String\n83|\n84|  fileprivate init(validatedRawValue: String) {\n85|    rawValue = validatedRawValue\n86|  }\n87|\n88|  public init(_ rawValue: String) throws {\n89|    guard rawValue.utf8.count == 64,\n90|      rawValue.utf8.allSatisfy({ byte in\n91|        (UInt8(ascii: \"0\")...UInt8(ascii: \"9\")).contains(byte)\n92|          || (UInt8(ascii: \"a\")...UInt8(ascii: \"f\")).contains(byte)\n93|      })\n94|    else {\n95|      throw RuntimeMessageCodecError.corruptPayload\n96|    }\n97|    self.rawValue = rawValue\n98|  }\n99|\n100|  public init(from decoder: any Decoder) throws {\n101|    try self.init(decoder.singleValueContainer().decode(String.self))\n102|  }\n103|\n104|  public func encode(to encoder: any Encoder) throws {\n105|    var container = encoder.singleValueContainer()\n106|    try container.encode(rawValue)\n107|  }\n108|}\n109|\n110|public struct SSHHostIdentityRecordV1: Equatable, Sendable {\n111|  public let algorithm: SSHHostKeyAlgorithm\n112|  public let fingerprintSHA256: SSHHostKeyFingerprint\n113|  public let state: SSHHostIdentityState\n114|  public let provenance: SSHHostIdentityProvenance\n115|  public let firstSeenAt: SSHProfileTimestamp\n116|  public let lastSeenAt: SSHProfileTimestamp\n117|  public let approvedAt: SSHProfileTimestamp?\n118|  public let revokedAt: SSHProfileTimestamp?\n119|  public let revocationReason: SSHHostIdentityRevocationReason?\n120|\n121|  public init(\n122|    algorithm: SSHHostKeyAlgorithm,\n123|    fingerprintSHA256: SSHHostKeyFingerprint,\n124|    state: SSHHostIdentityState,\n125|    provenance: SSHHostIdentityProvenance,\n126|    firstSeenAt: SSHProfileTimestamp,\n127|    lastSeenAt: SSHProfileTimestamp,\n128|    approvedAt: SSHProfileTimestamp?,\n129|    revokedAt: SSHProfileTimestamp?,\n130|    revocationReason: SSHHostIdentityRevocationReason?\n131|  ) {\n132|    self.algorithm = algorithm\n133|    self.fingerprintSHA256 = fingerprintSHA256\n134|    self.state = state\n135|    self.provenance = provenance\n136|    self.firstSeenAt = firstSeenAt\n137|    self.lastSeenAt = lastSeenAt\n138|    self.approvedAt = approvedAt\n139|    self.revokedAt = revokedAt\n140|    self.revocationReason = revocationReason\n141|  }\n142|}\n143|\n144|public struct SSHHostPolicyV1: Equatable, Sendable {\n145|  public let allowedAlgorithms: [SSHHostKeyAlgorithm]\n146|  public let records: [SSHHostIdentityRecordV1]\n147|\n148|  public init(\n149|    allowedAlgorithms: [SSHHostKeyAlgorithm],\n150|    records: [SSHHostIdentityRecordV1]\n151|  ) {\n152|    self.allowedAlgorithms = allowedAlgorithms\n153|    self.records = records\n154|  }\n155|}\n156|\n157|/// The complete bounded non-secret profile value captured by a macOS provider start.\n158|///\n159|/// The model deliberately has no raw byte fields and no printable description.\n160|/// Credential material and raw observed host keys cannot be represented here.\n161|public struct SSHProfileSnapshotV1: Equatable, Sendable {\n162|  public static let currentProtocolVersion: UInt16 = 1\n163|  public static let currentSchemaVersion: UInt16 = 1\n164|  public static let kind = \"sshProfileSnapshot\"\n165|  public static let maximumNestingDepth = 8\n166|\n167|  public let protocolVersion: UInt16\n168|  public let schemaVersion: UInt16\n169|  public let configurationGeneration: UInt64\n170|  public let profileID: OpaqueProfileIdentifier\n171|  public let createdAt: SSHProfileTimestamp\n172|  public let updatedAt: SSHProfileTimestamp\n173|  public let displayName: String\n174|  public let canonicalHost: SSHProfileCanonicalHost\n175|  public let port: UInt16\n176|  public let account: String\n177|  public let credential: SSHProfileCredentialReferenceV1\n178|  public let hostPolicy: SSHHostPolicyV1\n179|\n180|  public init(\n181|    configurationGeneration: UInt64,\n182|    profileID: OpaqueProfileIdentifier,\n183|    createdAt: SSHProfileTimestamp,\n184|    updatedAt: SSHProfileTimestamp,\n185|    displayName: String,\n186|    canonicalHost: SSHProfileCanonicalHost,\n187|    port: UInt16,\n188|    account: String,\n189|    credential: SSHProfileCredentialReferenceV1,\n190|    hostPolicy: SSHHostPolicyV1\n191|  ) {\n192|    protocolVersion = Self.currentProtocolVersion\n193|    schemaVersion = Self.currentSchemaVersion\n194|    self.configurationGeneration = configurationGeneration\n195|    self.profileID = profileID\n196|    self.createdAt = createdAt\n197|    self.updatedAt = updatedAt\n198|    self.displayName = displayName\n199|    self.canonicalHost = canonicalHost\n200|    self.port = port\n201|    self.account = account\n202|    self.credential = credential\n203|    self.hostPolicy = hostPolicy\n204|  }\n205|}\n206|\n207|public enum SSHProfileSnapshotField: String, Equatable, Sendable {\n208|  case providerConfiguration\n209|  case configurationGeneration\n210|  case profileID\n211|  case createdAt\n212|  case updatedAt\n213|  case displayName\n214|  case canonicalHost\n215|  case port\n216|  case account\n217|  case credentialReference\n218|  case credentialGeneration\n219|  case allowedAlgorithms\n220|  case trustRecords\n221|}\n222|\n223|public enum SSHProfileSnapshotErrorCode: String, Equatable, Sendable {\n224|  case profileOversize\n225|  case profileCorrupt\n226|  case profileVersionUnsupported\n227|  case profileInvalidField\n228|  case profileGenerationMismatch\n229|  case profileContainsProhibitedField\n230|}\n231|\n232|/// Stable errors that expose only a fixed code and, where safe, a fixed field token.\n233|public enum SSHProfileSnapshotLoaderError: Error, Equatable, Sendable {\n234|  case profileOversize\n235|  case profileCorrupt\n236|  case profileVersionUnsupported\n237|  case profileInvalidField(SSHProfileSnapshotField)\n238|  case profileGenerationMismatch\n239|  case profileContainsProhibitedField\n240|\n241|  public var code: SSHProfileSnapshotErrorCode {\n242|    switch self {\n243|    case .profileOversize: .profileOversize\n244|    case .profileCorrupt: .profileCorrupt\n245|    case .profileVersionUnsupported: .profileVersionUnsupported\n246|    case .profileInvalidField: .profileInvalidField\n247|    case .profileGenerationMismatch: .profileGenerationMismatch\n248|    case .profileContainsProhibitedField: .profileContainsProhibitedField\n249|    }\n250|  }\n251|}\n252|\n253|public enum SSHProfileSnapshotCodec {\n254|  public static let maximumSnapshotBytes = RuntimeMessageSizeLimit.providerConfiguration\n255|\n256|  public static func encode(_ snapshot: SSHProfileSnapshotV1) throws -> Data {\n257|    let wire = SSHProfileSnapshotWire(snapshot)\n258|    _ = try validate(wire)\n259|    let encoder = JSONEncoder()\n260|    encoder.outputFormatting = [.sortedKeys, .withoutEscapingSlashes]\n261|    do {\n262|      let data = try encoder.encode(wire)\n263|      guard data.count <= maximumSnapshotBytes else {\n264|        throw SSHProfileSnapshotLoaderError.profileOversize\n265|      }\n266|      return data\n267|    } catch let error as SSHProfileSnapshotLoaderError {\n268|      throw error\n269|    } catch {\n270|      throw SSHProfileSnapshotLoaderError.profileCorrupt\n271|    }\n272|  }\n273|\n274|  public static func decode(_ data: Data) throws -> SSHProfileSnapshotV1 {\n275|    let validation: StrictJSONValidator.ValidationResult\n276|    do {\n277|      validation = try StrictJSONValidator.validate(\n278|        data,\n279|        maximumBytes: maximumSnapshotBytes,\n280|        maximumDepth: SSHProfileSnapshotV1.maximumNestingDepth,\n281|        requiresSortedKeys: true,\n282|        allowsInsignificantWhitespace: false,\n283|        requiresCanonicalStrings: true,\n284|        requiresCanonicalNumbers: true\n285|      )\n286|    } catch RuntimeMessageCodecError.payloadTooLarge {\n287|      throw SSHProfileSnapshotLoaderError.profileOversize\n288|    } catch {\n289|      throw SSHProfileSnapshotLoaderError.profileCorrupt\n290|    }\n291|\n292|    guard !validation.allObjectKeys.contains(where: isProhibitedFieldName) else {\n293|      throw SSHProfileSnapshotLoaderError.profileContainsProhibitedField\n294|    }\n295|\n296|    let header: SSHProfileSnapshotHeader\n297|    do {\n298|      header = try JSONDecoder().decode(SSHProfileSnapshotHeader.self, from: data)\n299|    } catch {\n300|      throw SSHProfileSnapshotLoaderError.profileCorrupt\n301|    }\n302|    guard header.protocolVersion == UInt64(SSHProfileSnapshotV1.currentProtocolVersion),\n303|      header.schemaVersion == UInt64(SSHProfileSnapshotV1.currentSchemaVersion),\n304|      header.kind == SSHProfileSnapshotV1.kind\n305|    else {\n306|      throw SSHProfileSnapshotLoaderError.profileVersionUnsupported\n307|    }\n308|\n309|    do {\n310|      return try validate(JSONDecoder().decode(SSHProfileSnapshotWire.self, from: data))\n311|    } catch let error as SSHProfileSnapshotLoaderError {\n312|      throw error\n313|    } catch {\n314|      throw SSHProfileSnapshotLoaderError.profileCorrupt\n315|    }\n316|  }\n317|\n318|  /// Validates and hashes the exact canonical bytes that will be stored in the manager.\n319|  public static func digest(\n320|    ofEncodedSnapshot data: Data\n321|  ) throws -> SSHProfileSnapshotDigestSHA256 {\n322|    _ = try decode(data)\n323|    return digestOfValidatedBytes(data)\n324|  }\n325|\n326|  public static func digest(\n327|    of snapshot: SSHProfileSnapshotV1\n328|  ) throws -> SSHProfileSnapshotDigestSHA256 {\n329|    digestOfValidatedBytes(try encode(snapshot))\n330|  }\n331|\n332|  private static func validate(_ wire: SSHProfileSnapshotWire) throws -> SSHProfileSnapshotV1 {\n333|    guard wire.protocolVersion == UInt64(SSHProfileSnapshotV1.currentProtocolVersion),\n334|      wire.schemaVersion == UInt64(SSHProfileSnapshotV1.currentSchemaVersion),\n335|      wire.kind == SSHProfileSnapshotV1.kind\n336|    else {\n337|      throw SSHProfileSnapshotLoaderError.profileVersionUnsupported\n338|    }\n339|    guard wire.configurationGeneration >= 1 else {\n340|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.configurationGeneration)\n341|    }\n342|    let profileID = try canonicalUUID(wire.profileID, field: .profileID)\n343|    let createdAt = try timestamp(wire.createdAt, field: .createdAt)\n344|    let updatedAt = try timestamp(wire.updatedAt, field: .updatedAt)\n345|    guard createdAt.date <= updatedAt.date else {\n346|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.updatedAt)\n347|    }\n348|    try validateDisplayName(wire.displayName)\n349|    let canonicalHost = try validateHost(wire.canonicalHost)\n350|    guard (1...65_535).contains(wire.port), let port = UInt16(exactly: wire.port) else {\n351|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.port)\n352|    }\n353|    try validateAccount(wire.account)\n354|    let credentialReference = try canonicalUUID(\n355|      wire.credential.ref,\n356|      field: .credentialReference\n357|    )\n358|    guard wire.credential.generation >= 1 else {\n359|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.credentialGeneration)\n360|    }\n361|    let hostPolicy = try validateHostPolicy(wire.hostPolicy)\n362|\n363|    return SSHProfileSnapshotV1(\n364|      configurationGeneration: wire.configurationGeneration,\n365|      profileID: OpaqueProfileIdentifier(profileID),\n366|      createdAt: SSHProfileTimestamp(createdAt.rawValue),\n367|      updatedAt: SSHProfileTimestamp(updatedAt.rawValue),\n368|      displayName: wire.displayName,\n369|      canonicalHost: canonicalHost,\n370|      port: port,\n371|      account: wire.account,\n372|      credential: SSHProfileCredentialReferenceV1(\n373|        reference: OpaqueCredentialReference(credentialReference),\n374|        generation: wire.credential.generation\n375|      ),\n376|      hostPolicy: hostPolicy\n377|    )\n378|  }\n379|\n380|  private static func validateHostPolicy(\n381|    _ wire: SSHProfileHostPolicyWire\n382|  ) throws -> SSHHostPolicyV1 {\n383|    guard\n384|      (1...SSHHostKeyAlgorithm.canonicalPreferenceOrder.count).contains(\n385|        wire.allowedAlgorithms.count\n386|      )\n387|    else {\n388|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.allowedAlgorithms)\n389|    }\n390|\n391|    let algorithms: [SSHHostKeyAlgorithm] = try wire.allowedAlgorithms.map { value in\n392|      guard let algorithm = SSHHostKeyAlgorithm(rawValue: value) else {\n393|        throw SSHProfileSnapshotLoaderError.profileInvalidField(.allowedAlgorithms)\n394|      }\n395|      return algorithm\n396|    }\n397|    let canonicalIndexes = algorithms.compactMap {\n398|      SSHHostKeyAlgorithm.canonicalPreferenceOrder.firstIndex(of: $0)\n399|    }\n400|    guard zip(canonicalIndexes, canonicalIndexes.dropFirst()).allSatisfy(<) else {\n401|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.allowedAlgorithms)\n402|    }\n403|    guard wire.records.count <= 8 else {\n404|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)\n405|    }\n406|\n407|    var tuples: Set<SSHHostIdentityTuple> = []\n408|    var approvedCount = 0\n409|    var records: [SSHHostIdentityRecordV1] = []\n410|    for record in wire.records {\n411|      guard let algorithm = SSHHostKeyAlgorithm(rawValue: record.algorithm),\n412|        algorithms.contains(algorithm),\n413|        let state = SSHHostIdentityState(rawValue: record.state),\n414|        let provenance = SSHHostIdentityProvenance(rawValue: record.provenance)\n415|      else {\n416|        throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)\n417|      }\n418|      let fingerprint = try fingerprint(record.fingerprintSHA256)\n419|      let tuple = SSHHostIdentityTuple(algorithm: algorithm, digest: fingerprint.digest)\n420|      guard tuples.insert(tuple).inserted else {\n421|        throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)\n422|      }\n423|      let firstSeenAt = try timestamp(record.firstSeenAt, field: .trustRecords)\n424|      let lastSeenAt = try timestamp(record.lastSeenAt, field: .trustRecords)\n425|      guard firstSeenAt.date <= lastSeenAt.date else {\n426|        throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)\n427|      }\n428|      let approvedAt = try record.approvedAt.map { value in\n429|        let parsed = try timestamp(value, field: .trustRecords)\n430|        return SSHProfileTimestamp(parsed.rawValue)\n431|      }\n432|      let revokedAt = try record.revokedAt.map { value in\n433|        let parsed = try timestamp(value, field: .trustRecords)\n434|        return SSHProfileTimestamp(parsed.rawValue)\n435|      }\n436|      let revocationReason = record.revocationReason.flatMap(\n437|        SSHHostIdentityRevocationReason.init(rawValue:)\n438|      )\n439|\n440|      switch state {\n441|      case .approved:\n442|        approvedCount += 1\n443|        guard approvedAt != nil, revokedAt == nil, record.revocationReason == nil else {\n444|          throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)\n445|        }\n446|      case .revoked:\n447|        guard revokedAt != nil, revocationReason != nil else {\n448|          throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)\n449|        }\n450|      }\n451|      if record.revocationReason != nil, revocationReason == nil {\n452|        throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)\n453|      }\n454|\n455|      records.append(\n456|        SSHHostIdentityRecordV1(\n457|          algorithm: algorithm,\n458|          fingerprintSHA256: SSHHostKeyFingerprint(fingerprint.rawValue),\n459|          state: state,\n460|          provenance: provenance,\n461|          firstSeenAt: SSHProfileTimestamp(firstSeenAt.rawValue),\n462|          lastSeenAt: SSHProfileTimestamp(lastSeenAt.rawValue),\n463|          approvedAt: approvedAt,\n464|          revokedAt: revokedAt,\n465|          revocationReason: revocationReason\n466|        )\n467|      )\n468|    }\n469|    guard approvedCount <= 1 else {\n470|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)\n471|    }\n472|\n473|    let sortedTuples = tuples.sorted(by: SSHHostIdentityTuple.isOrderedBefore)\n474|    let actualTuples = records.map {\n475|      SSHHostIdentityTuple(\n476|        algorithm: $0.algorithm,\n477|        digest: fingerprintDigest($0.fingerprintSHA256.rawValue)!\n478|      )\n479|    }\n480|    guard actualTuples == sortedTuples else {\n481|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)\n482|    }\n483|    return SSHHostPolicyV1(allowedAlgorithms: algorithms, records: records)\n484|  }\n485|\n486|  private static func validateDisplayName(_ value: String) throws {\n487|    guard value.utf8.elementsEqual(value.precomposedStringWithCanonicalMapping.utf8),\n488|      value == value.trimmingCharacters(in: .white