+        .macOS(.v15),
+    ],
+    products: [
+        .library(name: "ReluxTunnelCore", targets: ["ReluxTunnelCore"]),
+        .library(name: "ReluxTunnelIOSAdapter", targets: ["ReluxTunnelIOSAdapter"]),
+        .library(name: "ReluxTunnelMacOSAdapter", targets: ["ReluxTunnelMacOSAdapter"]),
