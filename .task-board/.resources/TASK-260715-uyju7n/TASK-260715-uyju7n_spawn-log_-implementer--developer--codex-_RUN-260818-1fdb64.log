      "consumer": "TASK-260715-1r0fxv / TASK-260715-9yp8to",
      "entitlements": {
        "com.apple.developer.networking.networkextension": {
          "status": "required",
          "valueByChannel": {
            "development": [
              "packet-tunnel-provider"
