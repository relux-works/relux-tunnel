   872	  func wait() async -> BytePumpControlEvent {
   873	    await withCheckedContinuation { continuation in
   874	      lock.lock()
   875	      if let event {
   876	        lock.unlock()
   877	        continuation.resume(returning: event)
   878	      } else {
   879	        waiter = continuation
   880	        lock.unlock()
   881	      }
   882	    }
   883	  }
