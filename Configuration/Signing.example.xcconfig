// Copy to Signing.local.xcconfig and populate only for an explicitly credentialed lane.
// Signing.local.xcconfig is ignored and must never contain private keys or profile data.
CODE_SIGNING_ALLOWED = YES
CODE_SIGNING_REQUIRED = YES
DEVELOPMENT_TEAM = $(RELUX_DEVELOPMENT_TEAM)
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_STYLE = Automatic

// Gate P0 development defaults. A later Developer ID lane overrides these two
// entitlement paths and supplies its own profile/identity inputs.
RELUX_MACOS_HOST_ENTITLEMENTS = Configuration/Entitlements/ReluxProxyMac-Development.entitlements
RELUX_MACOS_PROVIDER_ENTITLEMENTS = Configuration/Entitlements/ReluxProxyMacTunnel-Development.entitlements
RELUX_MACOS_HOST_PROFILE_SPECIFIER = Mac Team Provisioning Profile: works.relux.tunnel.mac
RELUX_MACOS_PROVIDER_PROFILE_SPECIFIER = Mac Team Provisioning Profile: works.relux.tunnel.mac.tunnel
