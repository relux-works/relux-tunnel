    case .starting:
      isOwnedState = true
    case .usableTCPDNS:
      isOwnedState = allowUsable
    case .disconnected, .stopping, .failed:
      isOwnedState = false
    }
    guard isOwnedState, termination == nil else {
      throw CancellationError()
    }
  }

