+    expected_directories = {
+        parent.as_posix()
+        for path in expected
+        for parent in path.parents
+        if parent != PurePosixPath(".")
+    }
+    actual_files: set[str] = set()
+    actual_directories: set[str] = set()
+    for entry in root.rglob("*"):
