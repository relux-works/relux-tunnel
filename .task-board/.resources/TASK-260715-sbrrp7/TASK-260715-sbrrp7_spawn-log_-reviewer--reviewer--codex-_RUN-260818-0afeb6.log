exec
/bin/zsh -lc "sed -n '1,240p' Package.swift; test -f Package.resolved && sed -n '1,240p' Package.resolved || true; sed -n '1,220p' scripts/validate-workspace-foundation.sh; sed -n '1,180p' scripts/check-core-boundaries.sh; sed -n '1,140p' Makefile" in /Users/iv/Developer/relux-tunnel
