   458	        while offset < bytes.count {
   459	          let written = try await execChannel.writeSome(Data(bytes[offset...]))
   460	          offset += written
   461	        }
   462	      }
   463	      try await execChannel.finishWriting()
   464	      let exit = try await execChannel.waitForExit()
   465	      _ = try await (stdout, stderr)
