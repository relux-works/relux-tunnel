+
+    let cases: [(Data, RuntimeProtocolErrorCode)] = [
+      (Data("{".utf8), .corruptPayload),
+      (
+        Data(repeating: UInt8(ascii: "x"), count: RuntimeMessageSizeLimit.command + 1),
+        .payloadTooLarge
+      ),
