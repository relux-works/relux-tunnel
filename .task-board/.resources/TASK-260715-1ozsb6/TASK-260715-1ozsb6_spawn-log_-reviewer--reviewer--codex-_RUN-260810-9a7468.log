  1104	  private func handleAutomaticKeepaliveFailure(
  1105	    _ error: Error,
  1106	    policy: SSHKeepalivePolicy
  1107	  ) async -> Bool {
  1108	    let mapped = map(error, phase: .keepalive, fallback: .keepaliveFailed)
  1109	    if state == .rekeying, mapped.code == .timedOut || mapped.code == .invalidState {
  1110	      return true
  1111	    }
  1112	    guard state == .ready else { return false }
  1113	    consecutiveKeepaliveFailures += 1
  1114	    guard consecutiveKeepaliveFailures > policy.allowedConsecutiveMisses else {
  1115	      return true
  1116	    }
  1117	    await recordTerminalOperation(mapped)
  1118	    try? await transition(to: .failed)
  1119	    await emit(.error(code: mapped.code, phase: mapped.phase, scope: mapped.scope))
  1120	    _ = startTearDownIfNeeded()
  1121	    return false
  1122	  }
