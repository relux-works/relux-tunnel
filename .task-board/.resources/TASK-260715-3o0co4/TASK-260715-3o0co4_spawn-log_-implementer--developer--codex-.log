+enum FakeSendOutcome: Sendable {
+  case full
+  case short(Int)
+  case error(Int32)
+}
+
+enum FakeReceiveOutcome: Sendable {
+  case datagram(Data, fullBytes: Int? = nil, truncated: Bool = false)
+  case error(Int32)
+}
