+
+    corpus = {
+        "formatVersion": FORMAT_VERSION,
+        "protocolVersion": version,
+        "provenance": {
+            "generator": "scripts/relay-protocol-vectors.py",
+            "generatorFormatVersion": GENERATOR_FORMAT_VERSION,
