+  var freeCallCount: Int { state.withLock(\.freeCallCount) }
+  var closeEAGAINRemaining: Int { state.withLock(\.closeEAGAINRemaining) }
+  var freeEAGAINRemaining: Int { state.withLock(\.freeEAGAINRemaining) }
