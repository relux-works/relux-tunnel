+    configuration: RuntimeConfigurationSnapshot,
+    tcp: any TCPConsumer,
+    dns: any DNSConsumer,
+    runtimeGeneration: UInt64,
+    healthSink: any TunnelRuntimeHealthEventSink
+  ) async throws -> any M1PacketPlaneSession { throw HarnessFactoryTestError.notUsed }
+}
