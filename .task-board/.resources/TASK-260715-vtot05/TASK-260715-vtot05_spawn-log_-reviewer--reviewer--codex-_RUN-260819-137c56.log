+            "runtime audit scope",
+        ),
+        must_reject(
+            "weakened-exclusions",
+            lambda c: c["runtimePolicy"].update(excludedPaths=[]),
+            "runtime audit scope",
+        ),
+        must_reject(
+            "m5-boundary-drift",
+            lambda c: c["boundary"].pop(),
+            "M2/M5 supply-chain boundary",
+        ),
+    ]
