+    let first = ProviderFirstResult<StartRaceResult>()
+    Task {
+      first.resolve(await operation.value)
+    }
+    let deadline = Task { [clock = dependencies.clock, startBudget] in
+      do {
+        try await clock.sleep(for: startBudget)
+        first.resolve(.deadline)
+      } catch {
