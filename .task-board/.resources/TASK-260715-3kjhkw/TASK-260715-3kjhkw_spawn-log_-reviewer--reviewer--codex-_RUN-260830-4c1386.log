   299	/// The actor is the only state writer. It performs at most two constant-time public system
   300	/// calls per accepted event and never runs on packet, SSH, or lifecycle actors.
   301	public actor MemoryWatermarkController {
   302	  private var configuration: MemoryWatermarkConfiguration
   303	  private let platform: any MemoryPlatformSamplingService
   304	  private let clock: any TunnelClock
   305	  private var state: MemoryWatermarkState = .normal
   306	  private var stateGeneration: UInt64 = 0
   307	  private var sequence: UInt64 = 0
   308	  private var lastCadenceObservation: ContinuousClock.Instant?
   309	  private var lastEventObservations: [MemoryObservationTrigger: ContinuousClock.Instant] = [:]
   310	  private var recoveryEligibleSince: ContinuousClock.Instant?
   311	  private var history: RingHistory
   312	  private var observationCount: UInt64 = 0
   313	  private var rateLimitedCount: UInt64 = 0
   314	  private var samplingOverrunCount: UInt64 = 0
   315	  private var unavailableSampleCount: UInt64 = 0
   316	  private var staleLedgerSampleCount: UInt64 = 0
   317	  private var transitions = Dictionary(
   318	    uniqueKeysWithValues: MemoryWatermarkState.allCases.map { ($0, UInt64(0)) })
   319	
   320	  public init(
   321	    configuration: MemoryWatermarkConfiguration,
   322	    platform: any MemoryPlatformSamplingService,
   323	    clock: any TunnelClock = ContinuousTunnelClock()
   324	  ) {
   325	    self.configuration = configuration
   326	    self.platform = platform
   327	    self.clock = clock
   328	    self.history = RingHistory(limit: configuration.historyLimit)
   329	  }
   330	
   331	  public func currentState() -> MemoryWatermarkState { state }
   332	
   333	  public func replaceConfiguration(_ replacement: MemoryWatermarkConfiguration) throws {
   334	    guard replacement.generation > configuration.generation else {
   335	      throw MemoryWatermarkConfigurationError.generationMustIncrease(
   336	        current: configuration.generation, proposed: replacement.generation)
   337	    }
   338	    configuration = replacement
   339	    history.resize(to: replacement.historyLimit)
   340	    recoveryEligibleSince = nil
   341	    lastCadenceObservation = nil
   342	    lastEventObservations.removeAll(keepingCapacity: true)
   343	  }
   344	
   345	  public func observe(
   346	    trigger: MemoryObservationTrigger,
   347	    ledger: MemoryLedgerAvailability,
   348	    actionsAcknowledged: Bool = true
   349	  ) throws -> MemoryObservationDisposition {
   350	    let startedAt = clock.now()
   351	    if isRateLimited(trigger: trigger, at: startedAt) {
   352	      rateLimitedCount = incrementSaturating(rateLimitedCount)
   353	      return .rateLimited(currentState: state)
   354	    }
   355	    guard sequence < UInt64.max else { throw MemoryWatermarkControllerError.sequenceExhausted }
   356	
   357	    let sampled = platform.sampleCurrentProcessMemory()
   358	    let finishedAt = clock.now()
   359	    let samplingDuration = startedAt.duration(to: finishedAt)
   360	    let overran = samplingDuration > configuration.maximumSamplingDuration
   361	    if overran { samplingOverrunCount = incrementSaturating(samplingOverrunCount) }
   362	    let platformSample = sanitize(sampled, overran: overran)
   363	    let ledgerSample = sanitize(ledger, at: finishedAt)
   364	
   365	    sequence += 1
   366	    observationCount = incrementSaturating(observationCount)
   367	    markAccepted(trigger: trigger, at: startedAt)
   368	    unavailableSampleCount = incrementSaturating(
   369	      unavailableSampleCount,
   370	      by: unavailableCount(platformSample) + unavailableCount(ledgerSample))
   371	
   372	    let warning = trigger == .memoryWarning
   373	    let previous = state
   374	    let (next, reason) = nextState(
   375	      platform: platformSample,
   376	      ledger: ledgerSample,
   377	      warning: warning,
   378	      actionsAcknowledged: actionsAcknowledged,
   379	      now: finishedAt)
   380	    var transition: MemoryWatermarkTransition?
   381	    if next != previous {
   382	      state = next
   383	      stateGeneration = incrementSaturating(stateGeneration)
   384	      transitions[next] = incrementSaturating(transitions[next, default: 0])
   385	      transition = MemoryWatermarkTransition(from: previous, to: next, reason: reason!)
   386	    }
   387	    let observation = MemoryObservation(
   388	      sequence: sequence,
   389	      stateGeneration: stateGeneration,
   390	      configurationGeneration: configuration.generation,
   391	      timestamp: finishedAt,
   392	      unit: .bytes,
   393	      trigger: trigger,
   394	      physicalFootprint: platformSample.physicalFootprint,
   395	      physicalFootprintPeak: platformSample.physicalFootprintPeak,
   396	      advisoryAvailableMemory: platformSample.advisoryAvailableMemory,
   397	      ledger: ledgerSample,
   398	      warningReceived: warning,
   399	      actionsAcknowledged: actionsAcknowledged,
   400	      state: state,
   401	      transition: transition,
   402	      samplingDuration: samplingDuration)
   403	    history.append(observation)
   404	    return .observed(observation)
   405	  }
   406	
   407	  public func retainedHistory() -> [MemoryObservation] { history.values }
   408	
   409	  public func metrics() -> MemoryWatermarkMetrics {
   410	    MemoryWatermarkMetrics(
   411	      observations: observationCount,
   412	      rateLimited: rateLimitedCount,
   413	      samplingOverruns: samplingOverrunCount,
   414	      unavailableSamples: unavailableSampleCount,
   415	      staleLedgerSamples: staleLedgerSampleCount,
   416	      transitionCounts: transitions,
   417	      retainedHistoryCount: history.values.count,
   418	      retainedHistoryCapacity: history.limit)
   419	  }
