+}
+
+assert_domain_rejects() {
+  local source_path=$1
+  if strict_jq_jcs_json "$source_path" projection >"$tmp_dir/rejected-output.json" 2>/dev/null; then
+    fail "strict jq/JCS domain accepted unsupported numeric input: $source_path"
