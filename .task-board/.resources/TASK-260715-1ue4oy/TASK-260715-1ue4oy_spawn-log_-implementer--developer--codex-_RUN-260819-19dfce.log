   143	def read_bounded_descriptor(
   144	    descriptor: int, *, label: str, maximum_size: int, expected_size: int | None = None
   145	) -> bytes:
   146	    try:
   147	        status = os.fstat(descriptor)
   148	        if not stat.S_ISREG(status.st_mode):
   149	            raise AssetManifestError(f"{label} is not a regular file")
   150	        if status.st_size > maximum_size:
   151	            raise AssetManifestError(f"{label} exceeds its size limit")
   152	        if expected_size is not None and status.st_size != expected_size:
   153	            raise AssetManifestError(f"{label} size does not match the manifest")
   154
   155	        chunks: list[bytes] = []
   156	        total = 0
   157	        while True:
   158	            chunk = os.read(descriptor, min(READ_CHUNK_BYTES, maximum_size + 1 - total))
   159	            if not chunk:
   160	                break
   161	            total += len(chunk)
   162	            if total > maximum_size:
   163	                raise AssetManifestError(f"{label} exceeds its size limit")
   164	            chunks.append(chunk)
   165	            if total == maximum_size:
   166	                if os.read(descriptor, 1):
   167	                    raise AssetManifestError(f"{label} exceeds its size limit")
   168	                break
   169	        if expected_size is not None and total != expected_size:
   170	            raise AssetManifestError(f"{label} size changed while reading")
   171	        return b"".join(chunks)
   172	    except OSError as error:
   173	        raise AssetManifestError(f"{label} could not be read") from error
