   101	tcp_client_entry (void *data)
   102	{
   103	    HevSocks5ClientTCP *tcp;
   104	
   105	    tcp = hev_socks5_client_tcp_new_name ("www.google.com", 443);
   106	    hev_socks5_client_connect (HEV_SOCKS5_CLIENT (tcp), "127.0.0.1", 1080);
   107	    hev_socks5_client_handshake (HEV_SOCKS5_CLIENT (tcp));
   108	
   109	    /*
   110	     * splice data to/from a socket fd:
   111	     *     hev_socks5_tcp_splice (HEV_SOCKS5_TCP (tcp), fd);
   112	     */
   113	
   114	    hev_object_unref (HEV_OBJECT (tcp));
