+
+private actor LateConnectorConnection: SSHTCPConnection {
+  private(set) var closeCount = 0
+
+  func waitForReadiness(_ interests: Set<SSHTCPReadiness>) async throws
+    -> Set<SSHTCPReadiness>
+  {
+    interests
+  }
+
