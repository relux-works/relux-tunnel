   172	final class MacOSSystemKeychainHandle: @unchecked Sendable {
   173	  private let liveValue: SecKeychain?
   174	  private let fixtureValue: NSObject?
   175	
   176	  init(_ rawValue: SecKeychain) {
   177	    liveValue = rawValue
   178	    fixtureValue = nil
   179	  }
   180	
   181	  /// Test-only construction seam for deterministic Security-client fakes.
   182	  /// A fixture handle can be recorded and compared, but a live client rejects it.
   183	  init(fixtureIdentity: UUID) {
   184	    liveValue = nil
   185	    fixtureValue = FixtureKeychainIdentity(rawValue: fixtureIdentity)
   186	  }
   187	
   188	  fileprivate var rawValue: SecKeychain? { liveValue }
   189	
   190	  fileprivate var queryValue: AnyObject {
   191	    if let liveValue { return liveValue }
   192	    return fixtureValue!
   193	  }
   194	}
