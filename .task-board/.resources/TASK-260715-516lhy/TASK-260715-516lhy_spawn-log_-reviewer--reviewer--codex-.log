    93	  @Test("malformed inner lengths, address forms, and ports fail before materialization")
    94	  func malformedRecords() throws {
    95	    let cases: [(String, Data, RelayDatagramFailureCode)] = [
    96	      ("empty", Data(), .truncatedFixedHeader),
    97	      ("short MSGLEN", Data([0x00]), .truncatedFixedHeader),
    98	      ("short HDRLEN", Data([0x00, 0x00]), .truncatedFixedHeader),
    99	      ("short ATYP", Data([0x00, 0x00, 0x0A]), .truncatedFixedHeader),
   100	      ("unknown ATYP", Data([0x00, 0x00, 0x0A, 0xFF]), .unknownAddressType),
   101	      ("domain length missing", Data([0x00, 0x00, 0x07, 0x03]), .truncatedAddress),
   102	      (
   103	        "empty domain",
   104	        Data([0x00, 0x00, 0x07, 0x03, 0x00, 0x00, 0x35]),
   105	        .invalidAddressLength
   106	      ),
   107	      (
   108	        "domain too long",
   109	        Data([0x00, 0x00, 0xFF, 0x03, 0xF9]),
   110	        .invalidAddressLength
   111	      ),
   112	      (
   113	        "wrong IPv4 HDRLEN",
   114	        Data([0x00, 0x00, 0x09, 0x01, 192, 0, 2, 1, 0, 53]),
   115	        .headerLengthMismatch
   116	      ),
   117	      ("truncated IPv4", Data([0x00, 0x00, 0x0A, 0x01, 192]), .truncatedAddress),
   118	      (
   119	        "truncated port",
   120	        Data([0x00, 0x00, 0x0A, 0x01, 192, 0, 2, 1, 0]),
   121	        .truncatedPort
   122	      ),
   123	      (
   124	        "zero port",
   125	        Data([0x00, 0x00, 0x0A, 0x01, 192, 0, 2, 1, 0, 0]),
   126	        .invalidPort
   127	      ),
   128	      (
   129	        "protocol-sized declaration with truncated DATA",
   130	        Data([0x05, 0xC1, 0x0A, 0x01, 192, 0, 2, 1, 0, 53]),
   131	        .messageLengthMismatch
   132	      ),
   133	      (
   134	        "inner length exceeds outer",
   135	        Data([0x00, 0x01, 0x0A, 0x01, 192, 0, 2, 1, 0, 53]),
   136	        .messageLengthMismatch
   137	      ),
   138	      (
   139	        "outer length exceeds inner",
   140	        Data([0x00, 0x00, 0x0A, 0x01, 192, 0, 2, 1, 0, 53, 0xAA]),
   141	        .messageLengthMismatch
   142	      ),
   143	    ]
   144	
   145	    for (name, record, code) in cases {
   146	      var codec = try RelayDatagramCodec()
   147	      expectFailure(code, scope: .association, disposition: .closeAssociation) {
   148	        _ = try codec.decode(record)
   149	      }
   150	      #expect(codec.metrics.decodedMaterializedBytes == 0, "\(name)")
   151	      #expect(codec.metrics.decodedRecords == 0, "\(name)")
   152	      #expect(codec.metrics.failures == 1, "\(name)")
   153	    }
   154	  }
