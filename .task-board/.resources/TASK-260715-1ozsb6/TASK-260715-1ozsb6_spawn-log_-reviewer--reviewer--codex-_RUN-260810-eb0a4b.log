   234	    case .ready(let existing, let signature):
   235	      signatureState = .idle
   236	      lock.unlock()
   237	      return existing == payload ? .success(signature) : .failure(.signaturePayloadChanged)
   238	    case .failed(let existing):
   239	      signatureState = .idle
   240	      lock.unlock()
   241	      return existing == payload ? .failure(.signatureFailed) : .failure(.signaturePayloadChanged)
   242	    }
   243	  }
   244	
   245	  func signatureIsPending() -> Bool {
   246	    lock.withLock {
   247	      if case .pending = signatureState { return true }
   248	      return false
   249	    }
   250	  }
   251	
   252	  func waitForSignature() async {
   253	    let task = lock.withLock { signatureTask }
   254	    await task?.value
   255	  }
   256	
   257	  func cancelSignatureAndWait() async {
   258	    let task = lock.withLock { () -> Task<Void, Never>? in
   259	      let task = signatureTask
   260	      signatureTask = nil
   261	      credential = nil
   262	      if case .pending(let payload) = signatureState {
   263	        signatureState = .failed(payload)
   264	      }
   265	      return task
   266	    }
   267	    task?.cancel()
   268	    await task?.value
   269	  }
   270	
   271	  private func completeSignature(
   272	    payload: Data,
   273	    result: Result<Data, LibSSH2BridgeError>
   274	  ) {
   275	    lock.withLock {
   276	      guard case .pending(let existing) = signatureState, existing == payload else { return }
   277	      signatureTask = nil
   278	      switch result {
   279	      case .success(let signature):
   280	        signatureState = .ready(payload: payload, signature: signature)
   281	      case .failure:
   282	        signatureState = .failed(payload)
   283	      }
   284	    }
   285	  }
   286	
   287	  func allocate(byteCount: Int) -> UnsafeMutableRawPointer? {
   288	    guard byteCount > 0, let pointer = malloc(byteCount) else { return nil }
   289	    _ = lock.withLock { allocations.insert(UInt(bitPattern: pointer)) }
   290	    return pointer
   291	  }
   292	
   293	  func reallocate(_ pointer: UnsafeMutableRawPointer?, byteCount: Int) -> UnsafeMutableRawPointer? {
   294	    guard let pointer else { return allocate(byteCount: byteCount) }
   295	    let oldAddress = UInt(bitPattern: pointer)
   296	    guard let replacement = realloc(pointer, byteCount) else { return nil }
   297	    lock.withLock {
   298	      allocations.remove(oldAddress)
   299	      allocations.insert(UInt(bitPattern: replacement))
   300	    }
   301	    return replacement
   302	  }
   303	
   304	  func free(_ pointer: UnsafeMutableRawPointer?) {
   305	    guard let pointer else { return }
   306	    _ = lock.withLock { allocations.remove(UInt(bitPattern: pointer)) }
   307	    Darwin.free(pointer)
   308	  }
   309	}
