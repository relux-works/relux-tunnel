+  func makeSessionIdentity() -> SSHSessionIdentity { SSHSessionIdentity(rawValue: UUID()) }
+  func makeChannelIdentity() -> SSHChannelIdentity { SSHChannelIdentity(rawValue: UUID()) }
+}
