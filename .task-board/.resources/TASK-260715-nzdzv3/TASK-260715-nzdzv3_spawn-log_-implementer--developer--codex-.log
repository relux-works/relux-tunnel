index 0000000000000000000000000000000000000000..ff4c2619c27070f02726c2e3109ef707de3b50ae
--- /dev/null
+++ b/Dependencies/ReluxNIOSSH/Sources/NIOSSH/ReluxPolicies.swift
@@ -0,0 +1,211 @@
+//===----------------------------------------------------------------------===//
+//
+// This source file is part of the SwiftNIO open source project
+//
+// Copyright (c) 2017-2026 Apple Inc. and the SwiftNIO project authors
