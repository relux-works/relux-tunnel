 )
+HEV_SDK_PLATFORMS = {
+    "iphoneos": "ios",
+    "iphonesimulator": "ios",
+    "macosx": "macos",
+    "appletvos": "tvos",
+    "appletvsimulator": "tvos",
+}
 
 
 class NativeDependencyError(RuntimeError):
