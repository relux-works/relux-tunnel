   294	public enum BoundedFullDuplexBytePumpRunError: Error, Equatable, Sendable {
   295	  case alreadyRunning
   296	  case alreadyTerminated
   297	}
   298	
   299	/// One-shot structured owner of two independent bounded byte pumps.
   300	///
   301	/// EOF and failure policy deliberately remain outside this type. A direction
   302	/// reports its typed terminal event while its sibling continues until the
   303	/// lifecycle owner cancels it or it reaches its own terminal event.
   304	public actor BoundedFullDuplexBytePump {
   305	  private enum State {
   306	    case idle
   307	    case running
   308	    case terminated
   309	  }
   310	
   311	  private let local: any LocalNonblockingByteStream
   312	  private let channel: any SSHByteChannel
   313	  private let configuration: BoundedFullDuplexBytePumpConfiguration
   314	  private let bufferBudget: BytePumpBufferBudget
   315	  private let scheduler: any BytePumpScheduler
   316	  private let eventSink: any BytePumpTerminalEventSink
   317	  private let diagnostics: any BytePumpDiagnosticsSink
   318	  private let control = BytePumpControl()
   319	  private var state = State.idle
   320	
   321	  public init(
   322	    local: any LocalNonblockingByteStream,
   323	    channel: any SSHByteChannel,
   324	    configuration: BoundedFullDuplexBytePumpConfiguration,
   325	    bufferBudget: BytePumpBufferBudget,
   326	    scheduler: any BytePumpScheduler = TaskBytePumpScheduler(),
   327	    eventSink: any BytePumpTerminalEventSink = NoOpBytePumpTerminalEventSink(),
   328	    diagnostics: any BytePumpDiagnosticsSink = NoOpBytePumpDiagnosticsSink()
   329	  ) throws {
   330	    guard configuration.maximumAggregateReservedBytes == bufferBudget.maximumReservedBytes else {
   331	      throw BytePumpConfigurationError.aggregateBudgetMismatch(
   332	        configuration: configuration.maximumAggregateReservedBytes,
   333	        budget: bufferBudget.maximumReservedBytes
   334	      )
   335	    }
   336	    self.local = local
   337	    self.channel = channel
   338	    self.configuration = configuration
   339	    self.bufferBudget = bufferBudget
   340	    self.scheduler = scheduler
   341	    self.eventSink = eventSink
   342	    self.diagnostics = diagnostics
   343	  }
   344	
   345	  public func run() async throws -> BoundedFullDuplexBytePumpOutcome {
   346	    switch state {
   347	    case .idle:
   348	      state = .running
   349	    case .running:
   350	      throw BoundedFullDuplexBytePumpRunError.alreadyRunning
   351	    case .terminated:
   352	      throw BoundedFullDuplexBytePumpRunError.alreadyTerminated
   353	    }
   354	
   355	    let reservedBytes = configuration.perFlowReservedBufferBytes
   356	    guard !control.isCancellationRequested else {
   357	      let outcome = cancellationOutcome()
   358	      await publish(outcome)
   359	      state = .terminated
   360	      return outcome
   361	    }
   362	    guard await bufferBudget.tryReserve(bytes: reservedBytes) else {
   363	      let outcome = boundViolationOutcome()
   364	      await publish(outcome)
   365	      state = .terminated
   366	      return outcome
   367	    }
   368	    diagnostics.record(.aggregateReservedBytes((await bufferBudget.snapshot()).reservedBytes))
   369	
   370	    let local = self.local
   371	    let channel = self.channel
   372	    let configuration = self.configuration
   373	    let scheduler = self.scheduler
   374	    let eventSink = self.eventSink
   375	    let diagnostics = self.diagnostics
   376	    let control = self.control
   377	
   378	    let outcome = await withTaskCancellationHandler {
   379	      await Self.runStructuredPumps(
   380	        local: local,
   381	        channel: channel,
   382	        configuration: configuration,
   383	        scheduler: scheduler,
   384	        eventSink: eventSink,
   385	        diagnostics: diagnostics,
   386	        control: control
   387	      )
   388	    } onCancel: {
   389	      if control.requestCancellation() {
   390	        local.cancelPendingOperations()
   391	      }
   392	    }
   393	
   394	    await bufferBudget.release(bytes: reservedBytes)
   395	    diagnostics.record(.aggregateReservedBytes((await bufferBudget.snapshot()).reservedBytes))
   396	    state = .terminated
   397	    return outcome
   398	  }
   399	
   400	  public func cancel() {
   401	    guard state != .terminated else { return }
   402	    if control.requestCancellation() {
   403	      local.cancelPendingOperations()
   404	    }
   405	  }
   406	
   407	  private func cancellationOutcome() -> BoundedFullDuplexBytePumpOutcome {
   408	    BoundedFullDuplexBytePumpOutcome(
   409	      localToSSH: BytePumpTerminalEvent(direction: .localToSSH, reason: .cancelled),
   410	      sshToLocal: BytePumpTerminalEvent(direction: .sshToLocal, reason: .cancelled)
   411	    )
   412	  }
   413	
   414	  private func boundViolationOutcome() -> BoundedFullDuplexBytePumpOutcome {
   415	    BoundedFullDuplexBytePumpOutcome(
   416	      localToSSH: BytePumpTerminalEvent(direction: .localToSSH, reason: .boundViolation),
   417	      sshToLocal: BytePumpTerminalEvent(direction: .sshToLocal, reason: .boundViolation)
   418	    )
   419	  }
   420	
   421	  private func publish(_ outcome: BoundedFullDuplexBytePumpOutcome) async {
   422	    diagnostics.record(.terminal(outcome.localToSSH))
   423	    await eventSink.receive(outcome.localToSSH)
   424	    diagnostics.record(.terminal(outcome.sshToLocal))
   425	    await eventSink.receive(outcome.sshToLocal)
   426	  }
   427	
   428	  private static func runStructuredPumps(
   429	    local: any LocalNonblockingByteStream,
   430	    channel: any SSHByteChannel,
   431	    configuration: BoundedFullDuplexBytePumpConfiguration,
   432	    scheduler: any BytePumpScheduler,
   433	    eventSink: any BytePumpTerminalEventSink,
   434	    diagnostics: any BytePumpDiagnosticsSink,
   435	    control: BytePumpControl
   436	  ) async -> BoundedFullDuplexBytePumpOutcome {
   437	    await withTaskGroup(of: BytePumpChildResult.self) { group in
   438	      group.addTask {
   439	        .terminal(
   440	          await pumpLocalToSSH(
   441	            local: local,
   442	            channel: channel,
   443	            configuration: configuration,
   444	            scheduler: scheduler,
   445	            diagnostics: diagnostics,
   446	            control: control
   447	          ))
   448	      }
   449	      group.addTask {
   450	        .terminal(
   451	          await pumpSSHToLocal(
   452	            local: local,
   453	            channel: channel,
   454	            configuration: configuration,
   455	            scheduler: scheduler,
   456	            diagnostics: diagnostics,
   457	            control: control
   458	          ))
   459	      }
   460	      group.addTask {
   461	        .control(await control.wait())
   462	      }
   463	
   464	      var localToSSH: BytePumpTerminalEvent?
   465	      var sshToLocal: BytePumpTerminalEvent?
   466	      var cancellationHandled = false
   467	
   468	      for await result in group {
   469	        switch result {
   470	        case .terminal(let event):
   471	          switch event.direction {
   472	          case .localToSSH:
   473	            localToSSH = event
   474	          case .sshToLocal:
   475	            sshToLocal = event
   476	          }
   477	          diagnostics.record(.terminal(event))
   478	          await eventSink.receive(event)
   479	          if localToSSH != nil, sshToLocal != nil {
   480	            control.requestFinished()
   481	          }
   482	        case .control(.cancellation):
   483	          if !cancellationHandled {
   484	            cancellationHandled = true
   485	            group.cancelAll()
   486	            await channel.cancel()
   487	          }
   488	        case .control(.finished):
   489	          break
   490	        }
   491	      }
   492	
   493	      return BoundedFullDuplexBytePumpOutcome(
   494	        localToSSH: localToSSH
   495	          ?? BytePumpTerminalEvent(direction: .localToSSH, reason: .cancelled),
   496	        sshToLocal: sshToLocal
   497	          ?? BytePumpTerminalEvent(direction: .sshToLocal, reason: .cancelled)
   498	      )
   499	    }
   500	  }
   501	
   502	  private static func pumpLocalToSSH(
   503	    local: any LocalNonblockingByteStream,
   504	    channel: any SSHByteChannel,
   505	    configuration: BoundedFullDuplexBytePumpConfiguration,
   506	    scheduler: any BytePumpScheduler,
   507	    diagnostics: any BytePumpDiagnosticsSink,
   508	    control: BytePumpControl
   509	  ) async -> BytePumpTerminalEvent {
   510	    let direction = BytePumpDirection.localToSSH
   511	    var fairness = BytePumpFairnessSlice(configuration: configuration)
   512	    var buffer: Data?
   513	    var offset = 0
   514	    var retryAfterReadiness = false
   515	    var readinessWakeupsWithoutProgress = 0
   516	    var failureFallback = BytePumpTerminalReason.readError
   517	
   518	    let reason: BytePumpTerminalReason
   519	    do {
   520	      pumpLoop: while true {
   521	        try checkCancellation(control)
   522	
   523	        if buffer == nil {
   524	          failureFallback = .readError
   525	          let readLimit = try await fairness.beginOperation(
   526	            maximumTransferBytes: configuration.localReadChunkBytes,
   527	            direction: direction,
   528	            scheduler: scheduler,
   529	            diagnostics: diagnostics,
   530	            control: control
   531	          )
   532	          diagnostics.record(.operation(direction: direction, operation: .read))
   533	          let result = try await local.readSome(maximumBytes: readLimit)
   534	          try checkCancellation(control)
   535	          switch result {
   536	          case .bytes(let bytes):
   537	            guard !bytes.isEmpty else {
   538	              reason = .zeroProgress
   539	              break pumpLoop
   540	            }
   541	            guard bytes.count <= readLimit else {
   542	              reason = .boundViolation
   543	              break pumpLoop
   544	            }
   545	            fairness.recordTransferred(bytes.count)
   546	            buffer = bytes
   547	            offset = 0
   548	            retryAfterReadiness = false
   549	            readinessWakeupsWithoutProgress = 0
   550	            diagnostics.record(.bufferedBytes(direction: direction, count: bytes.count))
   551	          case .endOfStream:
   552	            reason = .eof
   553	            break pumpLoop
   554	          case .wouldBlock:
   555	            if retryAfterReadiness {
   556	              readinessWakeupsWithoutProgress += 1
   557	              guard
   558	                readinessWakeupsWithoutProgress
   559	                  < configuration.maximumConsecutiveReadinessWakeupsWithoutProgress
   560	              else {
   561	                reason = .zeroProgress
   562	                break pumpLoop
   563	              }
   564	            }
   565	            diagnostics.record(.pressure(direction: direction, readiness: .readable))
   566	            _ = try await fairness.beginOperation(
   567	              maximumTransferBytes: nil,
   568	              direction: direction,
   569	              scheduler: scheduler,
   570	              diagnostics: diagnostics,
   571	              control: control
   572	            )
   573	            diagnostics.record(.operation(direction: direction, operation: .readinessWait))
   574	            let readiness = try await local.waitForReadiness(.readable)
   575	            try checkCancellation(control)
   576	            guard readiness == .ready else {
   577	              reason = .localClosure
   578	              break pumpLoop
   579	            }
   580	            retryAfterReadiness = true
   581	          }
   582	          continue
   583	        }
   584	
   585	        guard let ownedBuffer = buffer else {
   586	          preconditionFailure("Local-to-SSH pump lost its owned buffer")
   587	        }
   588	        let remaining = ownedBuffer.count - offset
   589	        let callMaximum = min(remaining, configuration.maximumSSHWriteCallBytes)
   590	        failureFallback = .writeError
   591	        let writeLimit = try await fairness.beginOperation(
   592	          maximumTransferBytes: callMaximum,
   593	          direction: direction,
   594	          scheduler: scheduler,
   595	          diagnostics: diagnostics,
   596	          control: control
   597	        )
   598	        diagnostics.record(.operation(direction: direction, operation: .write))
   599	        let writeStart = ownedBuffer.index(ownedBuffer.startIndex, offsetBy: offset)
   600	        let writeEnd = ownedBuffer.index(writeStart, offsetBy: writeLimit)
   601	        let suffix = ownedBuffer[writeStart..<writeEnd]
   602	        let accepted = try await channel.writeSome(suffix)
   603	        try checkCancellation(control)
   604	        guard accepted > 0 else {
   605	          reason = .zeroProgress
   606	          break pumpLoop
   607	        }
   608	        guard accepted <= writeLimit else {
   609	          reason = .boundViolation
   610	          break pumpLoop
   611	        }
   612	        offset += accepted
   613	        fairness.recordTransferred(accepted)
   614	        diagnostics.record(.bytes(direction: direction, count: accepted))
   615	        diagnostics.record(
   616	          .bufferedBytes(direction: direction, count: ownedBuffer.count - offset))
   617	        if offset == ownedBuffer.count {
   618	          selfDiscard(&buffer, offset: &offset)
   619	        }
   620	      }
   621	    } catch {
   622	      reason = terminalReason(
   623	        for: error,
   624	        fallback: failureFallback,
   625	        control: control
   626	      )
   627	    }
   628	
   629	    selfDiscard(&buffer, offset: &offset)
   630	    diagnostics.record(.bufferedBytes(direction: direction, count: 0))
   631	    return BytePumpTerminalEvent(direction: direction, reason: reason)
   632	  }
   633	
   634	  private static func pumpSSHToLocal(
   635	    local: any LocalNonblockingByteStream,
   636	    channel: any SSHByteChannel,
   637	    configuration: BoundedFullDuplexBytePumpConfiguration,
   638	    scheduler: any BytePumpScheduler,
   639	    diagnostics: any BytePumpDiagnosticsSink,
   640	    control: BytePumpControl
   641	  ) async -> BytePumpTerminalEvent {
   642	    let direction = BytePumpDirection.sshToLocal
   643	    var fairness = BytePumpFairnessSlice(configuration: configuration)
   644	    var buffer: Data?
   645	    var offset = 0
   646	    var retryAfterReadiness = false
   647	    var readinessWakeupsWithoutProgress = 0
   648	    var failureFallback = BytePumpTerminalReason.readError
   649	
   650	    let reason: BytePumpTerminalReason
   651	    do {
   652	      pumpLoop: while true {
   653	        try checkCancellation(control)
   654	
   655	        if buffer == nil {
   656	          failureFallback = .readError
   657	          let readLimit = try await fairness.beginOperation(
   658	            maximumTransferBytes: configuration.remoteReadChunkBytes,
   659	            direction: direction,
   660	            scheduler: scheduler,
   661	            diagnostics: diagnostics,
   662	            control: control
   663	          )
   664	          diagnostics.record(.operation(direction: direction, operation: .read))
   665	          let bytes = try await channel.read(maximumBytes: readLimit)
   666	          try checkCancellation(control)
   667	          guard let bytes else {
   668	            reason = .eof
   669	            break pumpLoop
   670	          }
   671	          guard !bytes.isEmpty else {
   672	            reason = .zeroProgress
   673	            break pumpLoop
   674	          }
   675	          guard bytes.count <= readLimit else {
   676	            reason = .boundViolation
   677	            break pumpLoop
   678	          }
   679	          fairness.recordTransferred(bytes.count)
   680	          buffer = bytes
   681	          offset = 0
   682	          diagnostics.record(.bufferedBytes(direction: direction, count: bytes.count))
   683	          continue
   684	        }
   685	
   686	        guard let ownedBuffer = buffer else {
   687	          preconditionFailure("SSH-to-local pump lost its owned buffer")
   688	        }
   689	        let remaining = ownedBuffer.count - offset
   690	        failureFallback = .writeError
   691	        let writeLimit = try await fairness.beginOperation(
   692	          maximumTransferBytes: remaining,
   693	          direction: direction,
   694	          scheduler: scheduler,
   695	          diagnostics: diagnostics,
   696	          control: control
   697	        )
   698	        diagnostics.record(.operation(direction: direction, operation: .write))
   699	        let writeStart = ownedBuffer.index(ownedBuffer.startIndex, offsetBy: offset)
   700	        let writeEnd = ownedBuffer.index(writeStart, offsetBy: writeLimit)
   701	        let suffix = ownedBuffer[writeStart..<writeEnd]
   702	        let result = try await local.writeSome(suffix)
   703	        try checkCancellation(control)
   704	        switch result {
   705	        case .written(let count):
   706	          guard count > 0 else {
   707	            reason = .localClosure
   708	            break pumpLoop
   709	          }
   710	          guard count <= writeLimit else {
   711	            reason = .boundViolation
   712	            break pumpLoop
   713	          }
   714	          offset += count
   715	          fairness.recordTransferred(count)
   716	          diagnostics.record(.bytes(direction: direction, count: count))
   717	          diagnostics.record(
   718	            .bufferedBytes(direction: direction, count: ownedBuffer.count - offset))
   719	          retryAfterReadiness = false
   720	          readinessWakeupsWithoutProgress = 0
   721	          if offset == ownedBuffer.count {
   722	            selfDiscard(&buffer, offset: &offset)
   723	          }
   724	        case .peerClosed:
   725	          reason = .localClosure
   726	          break pumpLoop
   727	        case .wouldBlock:
   728	          if retryAfterReadiness {
   729	            readinessWakeupsWithoutProgress += 1
   730	            guard
   731	              readinessWakeupsWithoutProgress
   732	                < configuration.maximumConsecutiveReadinessWakeupsWithoutProgress
   733	            else {
   734	              reason = .zeroProgress
   735	              break pumpLoop
   736	            }
   737	          }
   738	          diagnostics.record(.pressure(direction: direction, readiness: .writable))
   739	          _ = try await fairness.beginOperation(
   740	            maximumTransferBytes: nil,
   741	            direction: direction,
   742	            scheduler: scheduler,
   743	            diagnostics: diagnostics,
   744	            control: control
   745	          )
   746	          diagnostics.record(.operation(direction: direction, operation: .readinessWait))
   747	          let readiness = try await local.waitForReadiness(.writable)
   748	          try checkCancellation(control)
   749	          guard readiness == .ready else {
   750	            reason = .localClosure
   751	            break pumpLoop
   752	          }
   753	          retryAfterReadiness = true
   754	        }
   755	      }
   756	    } catch {
   757	      reason = terminalReason(
   758	        for: error,
   759	        fallback: failureFallback,
   760	        control: control
   761	      )
   762	    }
   763	
   764	    selfDiscard(&buffer, offset: &offset)
   765	    diagnostics.record(.bufferedBytes(direction: direction, count: 0))
   766	    return BytePumpTerminalEvent(direction: direction, reason: reason)
   767	  }
   768	
   769	  private static func checkCancellation(_ control: BytePumpControl) throws {
   770	    if control.isCancellationRequested || Task<Never, Never>.isCancelled {
   771	      throw CancellationError()
   772	    }
   773	  }
   774	
   775	  private static func terminalReason(
   776	    for error: any Error,
   777	    fallback: BytePumpTerminalReason,
   778	    control: BytePumpControl
   779	  ) -> BytePumpTerminalReason {
   780	    if control.isCancellationRequested || error is CancellationError {
   781	      return .cancelled
   782	    }
   783	    guard let sshError = error as? SSHTransportError else {
   784	      return fallback
   785	    }
   786	    switch sshError.code {
   787	    case .cancelled:
   788	      return .cancelled
   789	    case .connectionLost, .connectionClosed, .channelClosed, .peerReset, .channelReset:
   790	      return .remoteClosure
   791	    default:
   792	      return fallback
   793	    }
   794	  }
   795	
   796	  private static func selfDiscard(_ buffer: inout Data?, offset: inout Int) {
   797	    buffer = nil
   798	    offset = 0
   799	  }
   800	}
   801	
   802	private struct BytePumpFairnessSlice {
   803	  private let maximumOperations: Int
   804	  private let maximumBytes: Int
   805	  private var operations = 0
   806	  private var bytes = 0
   807	
   808	  init(configuration: BoundedFullDuplexBytePumpConfiguration) {
   809	    maximumOperations = configuration.fairnessMaximumOperations
   810	    maximumBytes = configuration.fairnessMaximumBytes
   811	  }
   812	
   813	  mutating func beginOperation(
   814	    maximumTransferBytes: Int?,
   815	    direction: BytePumpDirection,
   816	    scheduler: any BytePumpScheduler,
   817	    diagnostics: any BytePumpDiagnosticsSink,
   818	    control: BytePumpControl
   819	  ) async throws -> Int {
   820	    if operations >= maximumOperations || bytes >= maximumBytes {
   821	      diagnostics.record(.fairnessYield(direction: direction))
   822	      try await scheduler.yield()
   823	      if control.isCancellationRequested || Task<Never, Never>.isCancelled {
   824	        throw CancellationError()
   825	      }
   826	      operations = 0
   827	      bytes = 0
   828	    }
   829	    operations += 1
   830	    guard let maximumTransferBytes else { return 0 }
   831	    return min(maximumTransferBytes, maximumBytes - bytes)
   832	  }
   833	
   834	  mutating func recordTransferred(_ count: Int) {
   835	    bytes += count
   836	  }
   837	}
   838	
   839	private enum BytePumpControlEvent: Sendable {
   840	  case cancellation
   841	  case finished
   842	}
   843	
   844	private enum BytePumpChildResult: Sendable {
   845	  case terminal(BytePumpTerminalEvent)
   846	  case control(BytePumpControlEvent)
   847	}
   848	
   849	private final class BytePumpControl: @unchecked Sendable {
   850	  private let lock = NSLock()
   851	  private var event: BytePumpControlEvent?
   852	  private var waiter: CheckedContinuation<BytePumpControlEvent, Never>?
   853	
   854	  var isCancellationRequested: Bool {
   855	    lock.withLock {
   856	      if case .cancellation = event {
   857	        return true
   858	      }
   859	      return false
   860	    }
   861	  }
   862	
   863	  @discardableResult
   864	  func requestCancellation() -> Bool {
   865	    finish(with: .cancellation)
   866	  }
   867	
