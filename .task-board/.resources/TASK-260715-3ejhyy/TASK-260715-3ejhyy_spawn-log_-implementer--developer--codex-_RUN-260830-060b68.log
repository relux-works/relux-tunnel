+    session: any SSHBootstrapSession,
+    runtimeGeneration: UInt64,
+    healthSink: any TunnelRuntimeHealthEventSink
+  ) async throws -> any TCPConsumer { throw HarnessFactoryTestError.notUsed }
+}
