   186	    if (!base || YAML_MAPPING_NODE != base->type)
   187	        return -1;
   188	
   189	    for (pair = base->data.mapping.pairs.start;
   190	         pair < base->data.mapping.pairs.top; pair++) {
   191	        yaml_node_t *node;
   192	        const char *key, *value;
   193	
   194	        if (!pair->key || !pair->value)
   195	            break;
   196	
   197	        node = yaml_document_get_node (doc, pair->key);
   198	        if (!node || YAML_SCALAR_NODE != node->type)
   199	            break;
   200	        key = (const char *)node->data.scalar.value;
   201	
   202	        node = yaml_document_get_node (doc, pair->value);
   203	        if (!node || YAML_SCALAR_NODE != node->type)
   204	            break;
   205	        value = (const char *)node->data.scalar.value;
   206	
   207	        if (0 == strcmp (key, "port"))
   208	            port = value;
   209	        else if (0 == strcmp (key, "address"))
   210	            addr = value;
   211	        else if (0 == strcmp (key, "udp"))
   212	            udpm = value;
   213	        else if (0 == strcmp (key, "udp-address"))
   214	            udpa = value;
   215	        else if (0 == strcmp (key, "pipeline"))
   216	            pipe = value;
   217	        else if (0 == strcmp (key, "username"))
   218	            user = value;
   219	        else if (0 == strcmp (key, "password"))
   220	            pass = value;
   221	        else if (0 == strcmp (key, "mark"))
   222	            mark = value;
   223	        else if (0 == strcmp (key, "tcp-fastopen"))
   224	            tfso = value;
   225	    }
   226	
   227	    if (!port) {
   228	        fprintf (stderr, "Can't found socks5.port!\n");
   229	        return -1;
   230	    }
   231	
   232	    if (!addr) {
   233	        fprintf (stderr, "Can't found socks5.address!\n");
   234	        return -1;
   235	    }
   236	
   237	    if ((user && !pass) || (!user && pass)) {
   238	        fprintf (stderr, "Must be set both socks5 username and password!\n");
   239	        return -1;
   240	    }
   241	
   242	    strncpy (srv.addr, addr, 256 - 1);
   243	    srv.port = strtoul (port, NULL, 10);
   244	
   245	    if (pipe && (strcasecmp (pipe, "true") == 0))
   246	        srv.pipeline = 1;
   247	
   248	    if (udpm && (strcasecmp (udpm, "udp") == 0))
   249	        srv.udp_in_udp = 1;
   250	
   251	    if (udpa)
   252	        strncpy (srv.udp_addr, udpa, 256 - 1);
   253	
   254	    if (user && pass) {
   255	        strncpy (_user, user, 256 - 1);
   256	        strncpy (_pass, pass, 256 - 1);
   257	        srv.user = _user;
   258	        srv.pass = _pass;
   259	    }
   260	
   261	    if (mark)
   262	        srv.mark = strtoul (mark, NULL, 0);
   263	
   264	    if (tfso)
   265	        srv.fastopen = (0 == strcasecmp (tfso, "true")) ? 1 : 0;
   266	
   267	    return 0;
   268	}
