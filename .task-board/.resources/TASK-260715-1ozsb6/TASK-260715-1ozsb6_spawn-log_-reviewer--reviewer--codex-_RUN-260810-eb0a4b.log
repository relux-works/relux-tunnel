  1329	  private func scheduleByteRekeyIfNeeded() {
  1330	    guard let configuration, !byteRekeyScheduled else { return }
  1331	    let threshold = configuration.rekey.protectedByteThresholdPerDirection
  1332	    guard
  1333	      counters.protectedBytesSent - rekeySentBytesBaseline >= threshold
  1334	        || counters.protectedBytesReceived - rekeyReceivedBytesBaseline >= threshold
  1335	    else { return }
  1336	    byteRekeyScheduled = true
  1337	    byteRekeyTask = Task { [weak self] in
  1338	      try? await self?.requestRekey(reason: .byteThreshold)
  1339	      await self?.clearByteRekeySchedule()
  1340	    }
  1341	  }
  1342	
  1343	  private func clearByteRekeySchedule() {
  1344	    byteRekeyScheduled = false
  1345	    byteRekeyTask = nil
  1346	  }
