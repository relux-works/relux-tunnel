   643	  private func runRekeyFlight(until deadline: ContinuousClock.Instant) async {
   644	    var permit: LibSSH2SessionOperationPermit?
   645	    do {
   646	      permit = try await beginSessionOperation(phase: .rekey, until: deadline)
   647	      try await performRequestRekey(until: deadline)
   648	      if let permit { finishSessionOperation(permit) }
   649	      finishRekeyFlight(with: .success(()))
   650	    } catch {
   651	      if let permit { finishSessionOperation(permit) }
   652	      let mapped = map(error, phase: .rekey, fallback: .rekeyFailed)
   653	      await recordTerminalOperation(mapped)
   654	      if state != .failed, state != .closing, state != .closed {
   655	        try? await transition(to: .failed)
   656	      }
   657	      finishRekeyFlight(with: .failure(mapped))
   658	      _ = startTearDownIfNeeded()
   659	    }
   660	  }
