RELAY_GO_ENV = \
	GOROOT="$(RELAY_GOROOT)" \
	GOTOOLCHAIN="$(RELAY_GO_TOOLCHAIN)" \
	GOENV=off \
	GOWORK=off \
	GOPROXY=off \
	GOSUMDB=off \
