+            right_chunk = right_stream.read(64 * 1024)
+            common = min(len(left_chunk), len(right_chunk))
+            for index in range(common):
+                if left_chunk[index] != right_chunk[index]:
+                    return offset + index
+            if len(left_chunk) != len(right_chunk):
