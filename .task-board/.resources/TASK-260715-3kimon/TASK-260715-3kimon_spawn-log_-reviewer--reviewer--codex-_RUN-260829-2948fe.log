+/// Every quantity in the memory observation API is an unsigned byte count.
+public enum MemoryObservationUnit: String, Sendable {
+  case bytes
+}
+
+/// Fixed provenance values prevent metric labels from carrying user or traffic data.
+public enum MemoryObservationProvenance: String, CaseIterable, Sendable {
+  case osProcessAvailableMemory
+  case taskVMPhysicalFootprint
+  case sharedMemoryLedger
+}
+
+public enum MemorySampleUnavailableReason: String, CaseIterable, Sendable {
+  case unsupportedPlatform
+  case systemCallFailed
+  case executionTimeExceeded
+  case malformed
+  case stale
+  case notReported
+}
+
+public enum MemoryByteSample: Equatable, Sendable {
+  case available(bytes: UInt64, provenance: MemoryObservationProvenance)
+  case unavailable(reason: MemorySampleUnavailableReason, provenance: MemoryObservationProvenance)
+
+  public var bytes: UInt64? {
+    guard case .available(let bytes, _) = self else { return nil }
+    return bytes
+  }
+}
+
+public struct MemoryPlatformSample: Equatable, Sendable {
+  public let physicalFootprint: MemoryByteSample
+  public let physicalFootprintPeak: MemoryByteSample
+  public let advisoryAvailableMemory: MemoryByteSample
+
+  public init(
+    physicalFootprint: MemoryByteSample,
+    physicalFootprintPeak: MemoryByteSample,
+    advisoryAvailableMemory: MemoryByteSample
+  ) {
+    self.physicalFootprint = physicalFootprint
+    self.physicalFootprintPeak = physicalFootprintPeak
+    self.advisoryAvailableMemory = advisoryAvailableMemory
+  }
+}
+
+/// The production implementation performs new system calls for every accepted observation.
+/// It intentionally has no stored sample value that could be reused as future availability.
+public protocol MemoryPlatformSamplingService: Sendable {
+  func sampleCurrentProcessMemory() -> MemoryPlatformSample
+}
+
+public struct SystemMemoryPlatformSamplingService: MemoryPlatformSamplingService {
+  public init() {}
+
+  public func sampleCurrentProcessMemory() -> MemoryPlatformSample {
+    let footprint = Self.physicalFootprint()
+    #if os(iOS)
+      let advisory: MemoryByteSample = .available(
+        bytes: UInt64(os_proc_available_memory()),
+        provenance: .osProcessAvailableMemory)
+    #else
+      let advisory: MemoryByteSample = .unavailable(
+        reason: .unsupportedPlatform,
+        provenance: .osProcessAvailableMemory)
+    #endif
+    return MemoryPlatformSample(
+      physicalFootprint: footprint.current,
+      physicalFootprintPeak: footprint.peak,
+      advisoryAvailableMemory: advisory)
+  }
