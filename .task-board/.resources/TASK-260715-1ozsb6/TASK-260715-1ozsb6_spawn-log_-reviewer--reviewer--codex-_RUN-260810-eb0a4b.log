   713	  private func runHandshake(timeout: Duration) async throws {
   714	    guard let engineSession else {
   715	      throw transportError(code: .invalidState, phase: .initialKeyExchange)
   716	    }
   717	    let deadline = dependencies.clock.now().advanced(by: timeout)
   718	    while true {
   719	      try checkCancellation(phase: .initialKeyExchange)
   720	      let result = libssh2_session_handshake(engineSession, LibSSH2AdapterConstants.socketToken)
   721	      if result == 0 {
   722	        protectedNetworkBaseline = context.network.engineByteCounts
   723	        return
   724	      }
   725	      guard result == LIBSSH2_ERROR_EAGAIN else {
   726	        throw engineError(result, phase: .initialKeyExchange, fallback: .algorithmNegotiationFailed)
   727	      }
   728	      try await progress(until: deadline, phase: .initialKeyExchange)
   729	    }
   730	  }
