+        "preserve deterministic Tuist generation and the exact generated target closure",
+        "keep CReluxNativeFixture test-only and prohibit runtime downloads or third-party dylibs"
+      ],
+      "revalidationTriggers": [
+        "Project.swift, Package.swift, workspace schemes, deployment targets, relay resource path, native linkage, or generated graph changes",
+        "accepted repository or graph revision changes",
+        "deterministic generation, unsigned build, legacy preservation, or architecture boundary gate becomes red"
+      ]
+    },
+    {
+      "kind": "packetBridgeAndHEV",
+      "taskId": "TASK-260715-2jatnd",
