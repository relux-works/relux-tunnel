  1097	  func channelWrite(identity: SSHChannelIdentity, bytes: Data) async throws -> Int {
  1098	    guard !bytes.isEmpty else {
  1099	      throw transportError(code: .invalidArgument, phase: .channelWrite, scope: .channel(identity))
  1100	    }
  1101	    guard let record = channels[identity], !record.closed, !record.writeEOF else {
  1102	      throw transportError(code: .writeAfterEOF, phase: .channelWrite, scope: .channel(identity))
  1103	    }
  1104	    let acceptedPrefix = min(
  1105	      bytes.count,
  1106	      record.policy.maximumWriteCallBytes,
  1107	      record.policy.maximumQueuedWriteBytes
  1108	    )
  1109	    try await beginChannelWrite(identity: identity, byteCount: acceptedPrefix)
  1110	    do {
  1111	      let result = try await performChannelWrite(
  1112	        identity: identity,
  1113	        bytes: bytes,
  1114	        acceptedPrefix: acceptedPrefix
  1115	      )
  1116	      await endChannelWrite(identity: identity, byteCount: acceptedPrefix)
  1117	      return result
  1118	    } catch {
  1119	      await endChannelWrite(identity: identity, byteCount: acceptedPrefix)
  1120	      let mapped = map(error, phase: .channelWrite)
  1121	      await recordTerminalOperation(mapped)
  1122	      throw mapped
  1123	    }
  1124	  }
  1125	
  1126	  private func performChannelWrite(
  1127	    identity: SSHChannelIdentity,
  1128	    bytes: Data,
  1129	    acceptedPrefix: Int
  1130	  ) async throws -> Int {
  1131	    guard let record = channels[identity], !record.closed, !record.writeEOF,
  1132	      let configuration
  1133	    else {
  1134	      throw transportError(code: .writeAfterEOF, phase: .channelWrite, scope: .channel(identity))
  1135	    }
  1136	    let deadline = dependencies.clock.now().advanced(by: configuration.timeouts.writeCreditWait)
  1137	    while true {
  1138	      try checkCancellation(phase: .channelWrite)
  1139	      try checkChannelDisposition(identity: identity, phase: .channelWrite)
  1140	      let result = bytes.withUnsafeBytes { raw in
  1141	        libssh2_channel_write_ex(
  1142	          record.pointer,
  1143	          0,
  1144	          raw.bindMemory(to: CChar.self).baseAddress,
  1145	          acceptedPrefix
  1146	        )
  1147	      }
  1148	      if result > 0 {
  1149	        counters.payloadBytesSent += UInt64(result)
  1150	        await metric(.increment(.payloadBytesSent, by: UInt64(result)))
  1151	        await reconcileProtectedMetrics()
  1152	        scheduleByteRekeyIfNeeded()
  1153	        return result
  1154	      }
  1155	      guard result == LIBSSH2_ERROR_EAGAIN else {
  1156	        throw engineError(Int32(result), phase: .channelWrite, fallback: .connectionLost)
  1157	      }
  1158	      counters.writeBackpressureWaits += 1
  1159	      await metric(.increment(.writeBackpressureWaits, by: 1))
  1160	      await emit(.writeBackpressureBegan(identity))
  1161	      let started = dependencies.clock.now()
  1162	      try await progress(until: deadline, phase: .channelWrite)
  1163	      await emit(
  1164	        .writeBackpressureEnded(
  1165	          channel: identity,
  1166	          waitDuration: started.duration(to: dependencies.clock.now())
  1167	        )
  1168	      )
  1169	    }
  1170	  }
