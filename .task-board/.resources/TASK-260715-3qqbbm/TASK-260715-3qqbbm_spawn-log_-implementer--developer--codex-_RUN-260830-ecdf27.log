   251	def verify_linkage(
   252	    libraries_path: Path | None,
   253	    symbols_path: Path | None,
   254	    all_symbols_path: Path | None,
   255	) -> None:
   256	    if libraries_path is not None:
   257	        for line in libraries_path.read_text(encoding="utf-8").splitlines():
   258	            if not line[:1].isspace():
   259	                continue
   260	            stripped = line.strip()
   261	            if not stripped.startswith("/"):
   262	                continue
   263	            dependency = stripped.split()[0]
   264	            if not (
   265	                dependency.startswith("/usr/lib/")
   266	                or dependency.startswith("/System/Library/Frameworks/")
   267	            ):
   268	                raise ContractError(
   269	                    f"disallowed provider dynamic dependency: {dependency}"
   270	                )
   271	    if symbols_path is not None:
   272	        symbols = symbols_path.read_text(encoding="utf-8")
   273	        forbidden = (
   274	            "_NSAddImage",
   275	            "_NSCreateObjectFileImageFromFile",
   276	            "_dladdr",
   277	            "_dlclose",
   278	            "_dlopen",
   279	            "_dlsym",
   280	        )
   281	        for symbol in forbidden:
   282	            if re.search(
   283	                rf"(?:^|\s){re.escape(symbol)}(?:$|\s)", symbols, re.MULTILINE
   284	            ):
   285	                raise ContractError(
   286	                    f"disallowed runtime-loading symbol in provider: {symbol}"
   287	                )
   288	    if all_symbols_path is not None:
   289	        all_symbols = all_symbols_path.read_text(encoding="utf-8")
   290	        if "relux_native_fixture" in all_symbols:
   291	            raise ContractError(
   292	                "CReluxNativeFixture symbols leaked into the provider binary"
   293	            )
