   770	private final class ManualUDPAdapterClock: TunnelClock, @unchecked Sendable {
   771	  private struct Sleep {
   772	    let deadline: ContinuousClock.Instant
   773	    let continuation: CheckedContinuation<Void, any Error>
   774	  }
   775	
   776	  private struct State {
   777	    var instant = ContinuousClock().now
   778	    var sleeps: [UUID: Sleep] = [:]
   779	    var timerArms: UInt64 = 0
   780	  }
   781	
   782	  private let state = Mutex(State())
   783	
   784	  var pendingSleeps: Int { state.withLock { $0.sleeps.count } }
   785	  var onlyPendingDeadline: ContinuousClock.Instant? {
   786	    state.withLock { state in
   787	      guard state.sleeps.count == 1 else { return nil }
   788	      return state.sleeps.values.first?.deadline
   789	    }
   790	  }
   791	  var timerArms: UInt64 { state.withLock(\.timerArms) }
   792	
   793	  func now() -> ContinuousClock.Instant {
   794	    state.withLock(\.instant)
   795	  }
   796	
   797	  func sleep(for duration: Duration) async throws {
   798	    let identifier = UUID()
   799	    try Task<Never, Never>.checkCancellation()
   800	    try await withTaskCancellationHandler {
   801	      try await withCheckedThrowingContinuation { continuation in
   802	        let cancelled = state.withLock { state in
   803	          if Task<Never, Never>.isCancelled { return true }
   804	          state.sleeps[identifier] = Sleep(
   805	            deadline: state.instant.advanced(by: duration),
   806	            continuation: continuation
   807	          )
   808	          state.timerArms += 1
   809	          return false
   810	        }
   811	        if cancelled { continuation.resume(throwing: CancellationError()) }
   812	      }
   813	    } onCancel: {
   814	      let continuation = self.state.withLock {
   815	        $0.sleeps.removeValue(forKey: identifier)?.continuation
   816	      }
   817	      continuation?.resume(throwing: CancellationError())
   818	    }
   819	  }
   820	
   821	  func advance(by duration: Duration) {
   822	    let continuations = state.withLock { state -> [CheckedContinuation<Void, any Error>] in
   823	      state.instant = state.instant.advanced(by: duration)
   824	      let ready = state.sleeps.filter { $0.value.deadline <= state.instant }
   825	      for identifier in ready.keys { state.sleeps.removeValue(forKey: identifier) }
   826	      return ready.values.map(\.continuation)
   827	    }
   828	    for continuation in continuations { continuation.resume() }
   829	  }
   830	}
