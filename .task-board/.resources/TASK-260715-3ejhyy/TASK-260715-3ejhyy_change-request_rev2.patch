+    return MacOSAcceptedM0Bindings(
+      packetBridgeConfiguration: PacketBridgeConfiguration(
+        mtu: mtuBytes,
+        sendBufferBytes: sendBufferBytes,
+        receiveBufferBytes: receiveBufferBytes,
+        maximumWorkCount: pumpPacketBudget,
