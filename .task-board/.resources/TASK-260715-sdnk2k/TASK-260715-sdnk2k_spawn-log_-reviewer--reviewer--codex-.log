   617	    case .localWritable:
   618	      local.pendingReadinessCount == 1
   619	    case .sshRead:
   620	      channel.pendingReadCount == 1
   621	    case .sshWrite:
   622	      channel.pendingWriteCount == 1
   623	    case .fairnessYield:
