   558	  private func runHandshake(timeout: Duration) async throws {
   559	    guard let engineSession else {
   560	      throw transportError(code: .invalidState, phase: .initialKeyExchange)
   561	    }
   562	    let deadline = dependencies.clock.now().advanced(by: timeout)
   563	    while true {
   564	      try checkCancellation(phase: .initialKeyExchange)
   565	      let result = libssh2_session_handshake(engineSession, LibSSH2AdapterConstants.socketToken)
   566	      if result == 0 {
   567	        protectedNetworkBaseline = context.network.engineByteCounts
   568	        return
   569	      }
   570	      guard result == LIBSSH2_ERROR_EAGAIN else {
   571	        throw engineError(result, phase: .initialKeyExchange, fallback: .algorithmNegotiationFailed)
   572	      }
   573	      try await progress(until: deadline, phase: .initialKeyExchange)
   574	    }
   575	  }
