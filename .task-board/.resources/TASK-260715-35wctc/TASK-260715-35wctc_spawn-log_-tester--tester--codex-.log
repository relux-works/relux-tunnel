+private func openDescriptorCount() -> Int {
+  let upperBound = getdtablesize()
+  return (0..<upperBound).reduce(into: 0) { count, descriptor in
+    errno = 0
+    if fcntl(descriptor, F_GETFD) >= 0 || errno != EBADF {
+      count += 1
+    }
+  }
+}
