import glob
import os
import re
import subprocess
import sys
from pathlib import Path

root = Path.cwd()
board = Path(os.environ.get(\"TASK_BOARD_DIR\", \"/Users/iv/Developer/relux-tunnel/.task-board\"))

repo_names = subprocess.run(
    [\"git\", \"ls-files\", \"-co\", \"--exclude-standard\", \"-z\"],
    cwd=root,
    check=True,
    stdout=subprocess.PIPE,
).stdout.split(b\"\\0\")
repo_files = [root / os.fsdecode(name) for name in repo_names if name]
board_files = [p for p in (board / \".resources\").rglob(\"*\") if p.is_file()]
run_logs = [p for p in board_files if \"spawn-log\" in p.name or p.suffix == \".log\"]
history_candidates = [Path.home() / \".zsh_history\", Path.home() / \".bash_history\"]
history_candidates.extend(Path(p) for p in glob.glob(str(Path.home() / \".zsh_sessions\" / \"*.history\")))
history_files = [p for p in history_candidates if p.exists() and p.is_file()]

patterns = [
    re.compile(rb\"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----\\r?\\n(?:[A-Za-z0-9+/]{20,}={0,2}\\r?\\n){2,}\", re.I),
    re.compile(rb\"(?:sparkle[_ -]?(?:private|secret|ed)[_ -]?key|ed25519[_ -]?private[_ -]?key|notary[_ -]?(?:password|key|secret)|asc[_ -]?(?:private[_ -]?key|password|secret))\\s*[:=]\\s*[\\\"']?[A-Za-z0-9+/]{40,}={0,2}[\\\"']?\", re.I),
    re.compile(rb\"(?:generate_keys|generate-keys)\\s+["'^'"\\r\\n]{0,160}(?:-x|-f)\\s+(?"'!private-key-file'"\\b|<|\\{|REDACTED\\b)["'^'"\\s\\\"']+\", re.I),
    re.compile(rb\"--ed-key-file\\s+(?"'!-|private-key-file'"\\b|<|\\{|REDACTED\\b)["'^'"\\s\\\"']+\", re.I),
    re.compile(rb\"AuthKey_[A-Z0-9]{6,}\\.p8\\b\", re.I),
]
key_name = re.compile(r\"(?:"'^id_(?:rsa|dsa|ecdsa|ed25519)$|'"\\.(?:p8|pem|pk8|key)"'$)", re.I)

def scan(label, paths):
    matched = set()
    name_hits = set()
    errors = []
    total_bytes = 0
    for path in paths:
        try:
            if key_name.search(path.name):
                name_hits.add(path)
            with path.open("rb") as handle:
                overlap = b""
                while True:
                    chunk = handle.read(1024 * 1024)
                    if not chunk:
                        break
                    total_bytes += len(chunk)
                    data = overlap + chunk
                    if any(pattern.search(data) for pattern in patterns):
                        matched.add(path)
                    overlap = data[-4096:]
        except Exception as exc:
            errors.append((path, type(exc).__name__))
    print(f"scope={label} files={len(paths)} bytes={total_bytes} content_candidate_files={len(matched)} key_named_files={len(name_hits)} read_errors={len(errors)}")
    if matched or name_hits:
        import hashlib
        ids = sorted(hashlib.sha256(os.fsencode(str(p))).hexdigest()[:12] for p in matched | name_hits)
        print(f"scope={label} candidate_path_ids={'"','.join(ids)}\")
    if errors:
        print(f\"scope={label} read_error_types={','.join(sorted(set(kind for _, kind in errors)))}\")
    return len(matched) + len(name_hits), len(errors)

results = [
    scan(\"repository_git_scope\", repo_files),
    scan(\"board_resources\", board_files),
    scan(\"task_run_logs\", run_logs),
    scan(\"shell_history\", history_files),
]
print(f\"shell_history_discovered={len(history_files)}\")
candidates = sum(item[0] for item in results)
errors = sum(item[1] for item in results)
print(f\"aggregate_candidates={candidates} aggregate_read_errors={errors}\")
if errors:
    sys.exit(3)
if candidates:
    sys.exit(2)
