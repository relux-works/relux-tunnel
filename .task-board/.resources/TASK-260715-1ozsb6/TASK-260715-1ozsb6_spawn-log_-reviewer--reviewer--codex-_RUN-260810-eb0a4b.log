   232	private actor BridgeConnection: SSHTCPConnection {
   233	  private var reads: [Data?]
   234	  private let maximumWriteBytes: Int
   235	  private var written = Data()
   236	
   237	  init(reads: [Data?] = [], maximumWriteBytes: Int = .max) {
   238	    self.reads = reads
   239	    self.maximumWriteBytes = maximumWriteBytes
   240	  }
   241	
   242	  func waitForReadiness(_ interests: Set<SSHTCPReadiness>) async throws
   243	    -> Set<SSHTCPReadiness>
   244	  {
   245	    interests
   246	  }
   247	
   248	  func readSome(maximumBytes: Int) async throws -> Data? {
   249	    guard !reads.isEmpty else { return Data() }
   250	    return reads.removeFirst()
   251	  }
   252	
   253	  func writeSome(_ bytes: Data) async throws -> Int {
   254	    let count = min(bytes.count, maximumWriteBytes)
   255	    written.append(bytes.prefix(count))
   256	    return count
   257	  }
   258	
   259	  func close() async {}
   260	
   261	  func writtenBytes() -> Data { written }
   262	}
   263	
   264	private actor SuspendingWriteConnection: SSHTCPConnection {
   265	  private let maximumWriteBytes: Int
   266	  private var written = Data()
   267	  private var activeWrites = 0
   268	  private var maximumActiveWrites = 0
   269	  private var firstWriteStarted = false
   270	  private var firstWriteStartWaiters: [CheckedContinuation<Void, Never>] = []
   271	  private var firstWriteRelease: CheckedContinuation<Void, Never>?
   272	
   273	  init(maximumWriteBytes: Int) {
   274	    self.maximumWriteBytes = maximumWriteBytes
   275	  }
   276	
   277	  func waitForReadiness(_ interests: Set<SSHTCPReadiness>) async throws
   278	    -> Set<SSHTCPReadiness>
   279	  {
   280	    interests
   281	  }
   282	
   283	  func readSome(maximumBytes: Int) async throws -> Data? { Data() }
   284	
   285	  func writeSome(_ bytes: Data) async throws -> Int {
   286	    activeWrites += 1
   287	    maximumActiveWrites = max(maximumActiveWrites, activeWrites)
   288	    if !firstWriteStarted {
   289	      firstWriteStarted = true
   290	      let waiters = firstWriteStartWaiters
   291	      firstWriteStartWaiters.removeAll()
   292	      for waiter in waiters { waiter.resume() }
   293	      await withCheckedContinuation { continuation in
   294	        firstWriteRelease = continuation
   295	      }
   296	    }
   297	    let count = min(bytes.count, maximumWriteBytes)
   298	    written.append(bytes.prefix(count))
   299	    activeWrites -= 1
   300	    return count
   301	  }
   302	
   303	  func close() async {}
   304	
   305	  func waitUntilFirstWriteStarts() async {
   306	    guard !firstWriteStarted else { return }
   307	    await withCheckedContinuation { continuation in
   308	      firstWriteStartWaiters.append(continuation)
   309	    }
   310	  }
   311	
   312	  func releaseFirstWrite() {
   313	    firstWriteRelease?.resume()
   314	    firstWriteRelease = nil
   315	  }
   316	
   317	  func writtenBytes() -> Data { written }
   318	  func maximumConcurrentWrites() -> Int { maximumActiveWrites }
   319	}
