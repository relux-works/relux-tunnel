+    await withTaskGroup(of: Void.self) { group in
+      group.addTask {
+        for iteration in 0..<2_000 {
+          registry.setSessionHealth(iteration.isMultiple(of: 2) ? .healthy : .stopping)
+          await Task.yield()
+        }
+      }
+      for _ in 0..<16 {
+        group.addTask {
+          for _ in 0..<500 {
+            guard case .success(let handshake) = registry.tryReserveHandshake() else {
+              continue
