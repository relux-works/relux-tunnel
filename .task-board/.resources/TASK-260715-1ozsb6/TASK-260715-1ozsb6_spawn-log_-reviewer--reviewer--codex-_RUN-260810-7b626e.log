  1129	    fallback: SSHTransportErrorCode = .adapterFailure
  1130	  ) -> SSHTransportError {
  1131	    if let error = error as? SSHTransportError { return error }
  1132	    if error is CancellationError { return transportError(code: .cancelled, phase: phase) }
  1133	    if error is LibSSH2TimeoutError { return transportError(code: .timedOut, phase: phase) }
  1134	    return transportError(code: fallback, phase: phase)
  1135	  }
