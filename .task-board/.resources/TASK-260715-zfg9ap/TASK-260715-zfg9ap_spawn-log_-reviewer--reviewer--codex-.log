     1	import Foundation
     2	import Synchronization
     3	
     4	/// Stable component categories used by the aggregate health gauges.
     5	///
     6	/// The schema intentionally has no component instance, lane, flow, endpoint,
     7	/// or request identifiers.
     8	public enum RuntimeDiagnosticComponent: String, CaseIterable, Sendable {
     9	  case coordinator
    10	  case packetBridge
    11	  case hev
    12	  case ssh
    13	  case tcp
    14	  case dns
    15	  case route
    16	}
    17	
    18	/// Numeric values stored in the component health gauges.
    19	public enum RuntimeDiagnosticHealth: Int64, Sendable {
    20	  case unknown = 0
    21	  case healthy = 1
    22	  case unhealthy = 2
    23	}
    24	
    25	/// Finite queue-drop reasons. No free-form label enters the snapshot.
    26	public enum RuntimeQueueDropReason: String, CaseIterable, Sendable {
    27	  case packetForwardMalformed
    28	  case packetForwardWouldBlock
    29	  case packetForwardNoBuffer
    30	  case packetReverseMalformed
    31	  case packetReverseWriteRejected
    32	  case tcpAdmissionLimit
    33	  case tcpQueuedByteLimit
    34	  case dnsQueueFull
    35	}
    36	
    37	/// Privacy-safe DNS outcome classes. Query names and resolver endpoints are not accepted.
    38	public enum RuntimeDNSResultClass: String, CaseIterable, Sendable {
    39	  case success
    40	  case noData
    41	  case nameError
    42	  case serverFailure
    43	  case refused
    44	  case timeout
    45	  case malformed
    46	  case otherFailure
    47	}
    48	
    49	/// Reviewed finite errors that diagnostics producers may publish.
    50	///
    51	/// The raw values are stable wire tokens. The associated domain is fixed here,
    52	/// so an adapter cannot create a new label or attach a code to another domain.
    53	public enum RuntimeDiagnosticErrorCode: String, CaseIterable, Sendable {
    54	  case configurationInvalid = "configuration_invalid"
    55	  case sshTrustRejected = "ssh_trust_rejected"
    56	  case sshCredentialRejected = "ssh_credential_rejected"
    57	  case sshSessionLost = "ssh_session_lost"
    58	  case tcpFlowFailed = "tcp_flow_failed"
    59	  case dnsUpstreamTimeout = "dns_upstream_timeout"
    60	  case packetPlaneFailed = "packet_plane_failed"
    61	  case networkSettingsApplyFailed = "network_settings_apply_failed"
    62	  case runtimeInvariantViolated = "runtime_invariant_violated"
    63	  case cleanupDeadlineExceeded = "cleanup_deadline_exceeded"
    64	  case protocolUnsupported = "protocol_unsupported"
    65	
    66	  public var domain: RuntimeErrorDomain {
    67	    switch self {
    68	    case .configurationInvalid: .configuration
    69	    case .sshTrustRejected: .sshTrust
    70	    case .sshCredentialRejected: .sshCredential
    71	    case .sshSessionLost: .sshTransport
    72	    case .tcpFlowFailed: .tcp
    73	    case .dnsUpstreamTimeout: .dns
    74	    case .packetPlaneFailed: .packetPlane
    75	    case .networkSettingsApplyFailed: .networkSettings
    76	    case .runtimeInvariantViolated, .cleanupDeadlineExceeded: .runtimeInvariant
    77	    case .protocolUnsupported: .protocol
    78	    }
    79	  }
    80	
    81	  fileprivate init?(_ error: RedactedRuntimeError) {
    82	    guard
    83	      let code = Self.allCases.first(where: {
    84	        $0.domain == error.domain && $0.rawValue == error.code.rawValue
    85	      })
    86	    else { return nil }
    87	    self = code
