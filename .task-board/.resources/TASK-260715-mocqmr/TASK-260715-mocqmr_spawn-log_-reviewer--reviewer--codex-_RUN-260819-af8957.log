   496	            started = time.monotonic_ns()
   497	            exit_code, identity_output, diagnostics = run_bounded(
   498	                identity_command, b"", working, environment
   499	            )
   500	            try:
   501	                if exit_code != 0 or diagnostics:
   502	                    raise GateFailure("identity_process_contract_mismatch")
   503	                relay_release.verify_identity_against_manifest(
   504	                    identity_output, manifest_path, executable, self.target
   505	                )
   506	                identity = json.loads(identity_output)
   507	            except (json.JSONDecodeError, relay_release.ReleaseError) as error:
   508	                raise GateFailure("identity_manifest_mismatch") from error
   509	            self.record(
   510	                "identity-and-self-hash",
   511	                started,
   512	                "pass",
   513	                exit_code,
   514	                identity_command,
   515	            )
   516	            self.report["identity"] = identity
   517	
   518	            stdio_command = self.runtime_command(
   519	                executable, ["--stdio", "--protocol", "1"]
   520	            )
   521	            self.expect_process(
   522	                "stdio-eof-and-stdout-framing",
   523	                stdio_command,
   524	                CLIENT_HELLO,
   525	                working,
   526	                environment,
   527	                0,
   528	                SERVER_HELLO,
   529	                b"",
   530	            )
   531	
   532	            malformed = bytearray(CLIENT_HELLO)
   533	            malformed[:4] = b"SECR"
   534	            self.expect_process(
   535	                "stderr-redaction",
   536	                stdio_command,
   537	                bytes(malformed),
   538	                working,
   539	                environment,
   540	                65,
   541	                REJECTED_HELLO,
   542	                b"relux-relay: protocol rejected\n",
   543	            )
   544	
   545	            for suffix, arguments in (
   546	                ("daemon", ["--daemon", "--protocol", "1"]),
   547	                ("listener", ["--listen", "--protocol", "1"]),
   548	                ("payload", ["payload.example", "--protocol", "1"]),
   549	                ("version", ["--stdio", "--protocol", "2"]),
   550	            ):
   551	                command = self.runtime_command(executable, arguments)
   552	                self.expect_process(
   553	                    f"unsupported-{suffix}",
   554	                    command,
   555	                    b"",
   556	                    working,
   557	                    environment,
   558	                    64,
   559	                    b"",
   560	                    b"relux-relay: unsupported invocation\n",
   561	                )
   562	
   563	            self.signal_smoke(executable, working, environment)
   564	            file_started = time.monotonic_ns()
   565	            unexpected = [
   566	                path.relative_to(runtime_root).as_posix()
   567	                for path in runtime_root.rglob("*")
   568	                if not path.is_dir()
   569	            ]
   570	            unexpected.extend(
   571	                f"{directory.relative_to(runtime_root).as_posix()}:mode"
   572	                for directory in (working, home, temporary)
   573	                if stat.S_IMODE(directory.stat().st_mode) != 0o555
   574	            )
   575	            self.record(
   576	                "no-runtime-files-or-system-write-fallback",
   577	                file_started,
   578	                "pass" if not unexpected else "fail",
   579	            )
   580	            if unexpected:
   581	                raise GateFailure("runtime_file_residue_detected")
   582	        finally:
   583	            cleanup_started = time.monotonic_ns()
   584	            try:
   585	                for directory in (working, home, temporary):
   586	                    if directory.exists():
   587	                        directory.chmod(0o700)
   588	                shutil.rmtree(runtime_root)
   589	            except OSError as error:
   590	                self.record("runtime-cleanup", cleanup_started, "fail")
   591	                raise GateFailure("runtime_cleanup_failed") from error
   592	            self.record("runtime-cleanup", cleanup_started, "pass")
   593	
   594	    def finish(self, status_value: str, error_code: str | None = None) -> None:
   595	        self.report["status"] = status_value
   596	        self.report["durationMilliseconds"] = round(
   597	            (time.monotonic_ns() - self.started) / 1_000_000, 3
   598	        )
   599	        if error_code is not None:
   600	            self.report["errorCode"] = error_code
   601	        self.evidence_path.parent.mkdir(parents=True, exist_ok=True)
   602	        self.evidence_path.write_bytes(stable_json(self.report))
