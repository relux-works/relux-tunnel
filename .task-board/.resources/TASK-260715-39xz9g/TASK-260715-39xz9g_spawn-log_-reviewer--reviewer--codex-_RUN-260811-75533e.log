+    expected_cases = len(REQUIRED_CANDIDATES) * (
+        len(REQUIRED_SERVERS) + len(REQUIRED_SCENARIOS) - 1
+    )
+    if len(matrix_observations) != expected_cases:
+        raise FixtureError("orchestration report has incomplete candidate coverage")
+    return report
+
