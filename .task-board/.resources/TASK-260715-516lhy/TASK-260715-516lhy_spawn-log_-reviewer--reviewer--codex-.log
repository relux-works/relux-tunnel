     5	@Suite("RelayProtocol v1 HEV datagram codec")
     6	struct RelayProtocolDatagramCodecTests {
     7	  private typealias P = RelayProtocolV1
     8	
     9	  @Test("HEV IPv4, IPv6, and domain vectors are byte exact at zero, typical, and maximum DATA")
    10	  func exactHEVVectors() throws {
    11	    for endpoint in vectorEndpoints() {
    12	      for data in vectorPayloads() {
    13	        let datagram = RelayDatagram(endpoint: endpoint.endpoint, data: data)
    14	        let expected = hevOracle(headerTail: endpoint.headerTail, data: data)
    15	        var codec = try RelayDatagramCodec()
    16	
    17	        let encoded = try codec.encode(datagram)
    18	        #expect(encoded == expected, "\(endpoint.name), DATA=\(data.count)")
    19	        #expect(try codec.decode(encoded) == datagram)
    20	        #expect(encoded.count == endpoint.headerTail.count + 2 + data.count)
    21	      }
    22	    }
    23	  }
    24	
    25	  @Test("every permitted DATA size round-trips for every address form")
    26	  func everyPermittedDataSize() throws {
    27	    for endpoint in vectorEndpoints() {
    28	      var codec = try RelayDatagramCodec()
    29	      for length in 0...Int(P.maxUDPPayloadClientHardCeiling) {
    30	        let data = patternedData(count: length)
    31	        let datagram = RelayDatagram(endpoint: endpoint.endpoint, data: data)
    32	        let encoded = try codec.encode(datagram)
    33	        #expect(encoded == hevOracle(headerTail: endpoint.headerTail, data: data))
    34	        #expect(try codec.decode(encoded) == datagram)
    35	        #expect(encoded.count <= P.maxHEVRecordWidth)
    36	      }
    37	    }
    38	  }
    39	
    40	  @Test("maximum domain and DATA lengths produce the generated maximum record width")
    41	  func maximumRecordWidth() throws {
    42	    let domain = Data((0..<P.maxDomainWireBytes).map { UInt8(truncatingIfNeeded: $0) })
    43	    let datagram = RelayDatagram(
    44	      endpoint: RelayDatagramEndpoint(address: .domain(domain), port: UInt16.max),
    45	      data: patternedData(count: Int(P.maxUDPPayloadClientHardCeiling))
    46	    )
    47	    var codec = try RelayDatagramCodec()
    48	
    49	    let encoded = try codec.encode(datagram)
    50	    #expect(encoded.count == P.maxHEVRecordWidth)
    51	    #expect(encoded.byte(at: 2) == UInt8.max)
    52	    #expect(encoded.byte(at: 4) == UInt8(P.maxDomainWireBytes))
    53	    #expect(try codec.decode(encoded) == datagram)
    54	  }
    55	
    56	  @Test("domain bytes are opaque and preserved without IDNA or DNS normalization")
