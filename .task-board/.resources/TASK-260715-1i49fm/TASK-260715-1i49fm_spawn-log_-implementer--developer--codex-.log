+    let snapshotTask = Task.detached { try store.snapshot() }
+    defer { releaseSnapshot.signal() }
+
+    var snapshotEnteredIterator = snapshotEntered.makeAsyncIterator()
+    _ = await snapshotEnteredIterator.next()
+
