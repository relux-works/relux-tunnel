ol grep ===\\n143:            f\\\"relux-native-fixture source checksum mismatch: expected \\\"\\n176:            f\\\"HEV revision mismatch: expected {revision}, got {actual_revision}\\\"\\n184:            f\\\"HEV source archive mismatch: expected {item['source']['sha256']}, \\\"\\n193:                f\\\"HEV submodule revision mismatch at {submodule['path']}: expected \\\"\\n207:                f\\\"HEV submodule archive mismatch at {submodule['path']}: expected \\\"\\n212:def expected_slices(item: dict[str, Any]) -> list[dict[str, Any]]:\\n219:    for slice_ in expected_slices(item):\\n257:    expected_sdks = {\\n260:    if seen_sdks != expected_sdks:\\n262:            \\\"HEV build script SDK coverage mismatch: expected \\\"\\n263:            f\\\"{sorted(expected_sdks)}, got {sorted(seen_sdks)}\\\"\\n296:    expected = {slice_[\\\"library_identifier\\\"]: slice_ for slice_ in expected_slices(item)}\\n297:    missing = sorted(set(expected) - set(libraries))\\n300:    unexpected = sorted(set(libraries) - set(expected))\\n301:    if unexpected:\\n302:        raise NativeDependencyError(f\\\"unexpected unvalidated XCFramework slices: {unexpected}\\\")\\n304:    for identifier, slice_ in expected.items():\\n314:                f\\\"architecture mismatch for {identifier}: expected \\\"\\n329:                f\\\"archive architecture mismatch for {identifier}: expected \\\"\\n356:                    f\\\"minimum deployment mismatch for {identifier}: expected \\\"\\n387:        expected_hashes = item.get(\\\"artifact\\\", {}).get(\\\"file_sha256\\\", {})\\n388:        if not expected_hashes:\\n391:        if actual_hashes != expected_hashes:\\n410:            f\\\"linked binary architecture mismatch: expected {sorted(required_architectures)}, \\\"\\n670:        expected_source = notice_swift_source(\\n673:        if embedded_notice.read_text(encoding=\\\"utf-8\\\") != expected_source:\\n\",\n  \"original_output_bytes\": 7639,\n  \"original_output_tokens\": 1910,\n  \