   720	    try container.encode(protocolVersion, forKey: .protocolVersion)
   760	    case runtimeGeneration
   761	    case snapshotSequence
   762	    case counters
   763	    case gauges
   764	    case histograms
   765	    case errors
   766	    case sshBootstrapError
   767	  }
