   925	  private func runHandshake(timeout: Duration) async throws {
   926	    guard let engineSession else {
   927	      throw transportError(code: .invalidState, phase: .initialKeyExchange)
   928	    }
   929	    let deadline = dependencies.clock.now().advanced(by: timeout)
   930	    while true {
   931	      try checkCancellation(phase: .initialKeyExchange)
   932	      let result = libssh2_session_handshake(engineSession, LibSSH2AdapterConstants.socketToken)
   933	      if result == 0 {
   934	        protectedNetworkBaseline = context.network.engineByteCounts
   935	        return
   936	      }
   937	      guard result == LIBSSH2_ERROR_EAGAIN else {
   938	        throw engineError(result, phase: .initialKeyExchange, fallback: .algorithmNegotiationFailed)
   939	      }
   940	      try await progress(until: deadline, phase: .initialKeyExchange)
   941	    }
   942	  }
