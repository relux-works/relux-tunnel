   473	private func fixture(
   474	  generation: UInt64 = 7,
   475	  account: String = "fixture-account",
   476	  host: SSHProfileCanonicalHost = .init(kind: .dns, value: "example.com")
   477	) -> SSHProfileSnapshotV1 {
   478	  let digest = Data(repeating: 0x01, count: 32).base64EncodedString().dropLast()
   479	  let record = SSHHostIdentityRecordV1(
   480	    algorithm: .sshEd25519,
   481	    fingerprintSHA256: SSHHostKeyFingerprint("SHA256:\(digest)"),
   482	    state: .approved,
   483	    provenance: .firstUseApproval,
   484	    firstSeenAt: SSHProfileTimestamp("2026-08-11T10:00:00.000Z"),
   485	    lastSeenAt: SSHProfileTimestamp("2026-08-11T10:00:01.000Z"),
   486	    approvedAt: SSHProfileTimestamp("2026-08-11T10:00:01.000Z"),
   487	    revokedAt: nil,
   488	    revocationReason: nil
   489	  )
   490	  return SSHProfileSnapshotV1(
   491	    configurationGeneration: generation,
   492	    profileID: OpaqueProfileIdentifier(
   493	      UUID(uuidString: "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa")!
   494	    ),
   495	    createdAt: SSHProfileTimestamp("2026-08-11T09:00:00.000Z"),
   496	    updatedAt: SSHProfileTimestamp("2026-08-11T10:00:01.000Z"),
   497	    displayName: "Fixture Profile",
   498	    canonicalHost: host,
   499	    port: 22,
   500	    account: account,
   501	    credential: SSHProfileCredentialReferenceV1(
   502	      reference: OpaqueCredentialReference(
   503	        UUID(uuidString: "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb")!
   504	      ),
   505	      generation: 3
   506	    ),
   507	    hostPolicy: SSHHostPolicyV1(
   508	      allowedAlgorithms: [.sshEd25519, .rsaSHA2256],
   509	      records: [record]
   510	    )
   511	  )
   512	}
   513	
   514	private func mutateJSON(
   515	  _ data: Data,
   516	  mutation: (inout [String: Any]) throws -> Void
   517	) throws -> Data {
   518	  var object = try #require(
   519	    JSONSerialization.jsonObject(with: data) as? [String: Any]
   520	  )
