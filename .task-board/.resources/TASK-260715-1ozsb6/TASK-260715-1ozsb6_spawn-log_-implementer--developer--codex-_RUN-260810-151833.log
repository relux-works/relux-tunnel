  1387	      throw transportError(code: .writeAfterEOF, phase: .channelWrite, scope: .channel(identity))
  1388	    }
  1389	    let deadline = dependencies.clock.now().advanced(by: configuration.timeouts.writeCreditWait)
  1390	    while true {
  1391	      try checkCancellation(phase: .channelWrite, scope: .channel(identity))
  1392	      try checkChannelDisposition(identity: identity, phase: .channelWrite)
  1393	      let result = bytes.withUnsafeBytes { raw in
  1394	        libssh2_channel_write_ex(
  1395	          record.pointer,
  1396	          0,
  1397	          raw.bindMemory(to: CChar.self).baseAddress,
  1398	          acceptedPrefix
  1399	        )
  1400	      }
  1401	      if result > 0 {
  1402	        counters.payloadBytesSent += UInt64(result)
  1403	        await metric(.increment(.payloadBytesSent, by: UInt64(result)))
  1404	        await reconcileProtectedMetrics()
  1405	        scheduleByteRekeyIfNeeded()
  1406	        return result
  1407	      }
  1408	      guard result == LIBSSH2_ERROR_EAGAIN else {
  1409	        throw engineError(
  1410	          Int32(result),
  1411	          phase: .channelWrite,
  1412	          fallback: .connectionLost,
  1413	          scope: .channel(identity)
  1414	        )
  1415	      }
