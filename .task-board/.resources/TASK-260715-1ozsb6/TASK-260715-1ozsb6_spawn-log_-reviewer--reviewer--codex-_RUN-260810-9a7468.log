  1078	  private func startAutomaticTasks(configuration: SSHConnectionConfiguration) {
  1079	    automaticRekeyTask = Task { [weak self, clock = dependencies.clock] in
  1080	      while !Task.isCancelled {
  1081	        do {
  1082	          try await clock.sleep(for: configuration.rekey.elapsedTimeThreshold)
  1083	          try await self?.requestRekey(reason: .timeThreshold, waitsForFatalTeardown: false)
  1084	        } catch { return }
  1085	      }
  1086	    }
  1087	    automaticKeepaliveTask = Task { [weak self, clock = dependencies.clock] in
  1088	      while !Task.isCancelled {
  1089	        do {
  1090	          try await clock.sleep(for: configuration.keepalive.interval)
  1091	          _ = try await self?.sendKeepalive(deferBehindRekey: true)
  1092	        } catch {
  1093	          guard
  1094	            await self?.handleAutomaticKeepaliveFailure(
  1095	              error,
  1096	              policy: configuration.keepalive
  1097	            ) == true
  1098	          else { return }
  1099	        }
  1100	      }
  1101	    }
  1102	  }
