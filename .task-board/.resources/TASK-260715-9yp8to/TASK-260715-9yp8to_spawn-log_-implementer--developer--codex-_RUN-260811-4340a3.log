+open "$HOME/Applications/ReluxPacketTunnelProbe.app"
+pluginkit -m -A -D -v -i works.relux.tunnel.probe.mac.tunnel
+PROBE_PHYSICAL_OUTPUT_ROOT=.temp/TASK-260715-9yp8to/reinstall-cycle \
