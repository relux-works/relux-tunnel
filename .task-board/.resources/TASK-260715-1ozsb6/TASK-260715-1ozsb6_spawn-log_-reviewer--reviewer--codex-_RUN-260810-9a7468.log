  1813	  private func performChannelDispose(
  1814	    identity: SSHChannelIdentity,
  1815	    graceful: Bool,
  1816	    terminalEvent: SSHTransportEventKind?
  1817	  ) async -> Bool {
  1818	    await waitForChannelOperationsToDrain(identity: identity)
  1819	    guard let record = channels[identity] else { return true }
  1820	    let deadline = dependencies.clock.now().advanced(
  1821	      by: configuration?.timeouts.channelClose ?? .seconds(1)
  1822	    )
  1823	    if graceful {
  1824	      var closeResult = channelAPI.close(record.pointer)
  1825	      while closeResult == LIBSSH2_ERROR_EAGAIN {
  1826	        do {
  1827	          try await cleanupProgress(until: deadline)
  1828	        } catch {
  1829	          return false
  1830	        }
  1831	        closeResult = channelAPI.close(record.pointer)
  1832	      }
  1833	      guard closeResult == 0 else { return false }
  1834	    }
  1835	    var freeResult = channelAPI.free(record.pointer)
  1836	    while freeResult == LIBSSH2_ERROR_EAGAIN {
  1837	      do {
  1838	        try await cleanupProgress(until: deadline)
  1839	      } catch {
  1840	        return false
  1841	      }
  1842	      freeResult = channelAPI.free(record.pointer)
  1843	    }
  1844	    guard freeResult == 0 else { return false }
  1845	    channels.removeValue(forKey: identity)
  1846	    channelWriteGates.removeValue(forKey: identity)
  1847	    disposingChannels.removeValue(forKey: identity)
  1848	    pendingWriteBytes.removeValue(forKey: identity)
  1849	    if let terminalEvent { await emit(terminalEvent) }
  1850	    return true
  1851	  }
