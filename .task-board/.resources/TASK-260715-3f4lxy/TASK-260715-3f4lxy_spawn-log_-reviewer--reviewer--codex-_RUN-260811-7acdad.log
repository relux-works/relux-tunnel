   775	/// A once-only, thread-safe capture for one provider runtime start.
   776	///
   777	/// Construct a fresh loader for each start. It never consults storage, performs
   778	/// credential work, or mutates a profile. Concurrent candidates race only for
   779	/// the first complete validated capture; all differing candidates fail closed.
   780	public final class SSHProfileRuntimeSnapshotLoader: @unchecked Sendable {
   781	  private struct Capture {
   782	    let data: Data
   783	    let snapshot: SSHProfileSnapshotV1
   784	  }
   785	
   786	  private let lock = NSLock()
   787	  private var capture: Capture?
   788	
   789	  public init() {}
   790	
   791	  public func capture(
   792	    from providerConfiguration: [String: VPNProviderConfigurationValue]?,
   793	    expectation: SSHProfileSnapshotExpectation? = nil
   794	  ) throws -> SSHProfileSnapshotV1 {
   795	    let candidate = try SSHProfileProviderConfigurationCodec.decodeCapture(
   796	      providerConfiguration
   797	    )
   798	    if let expectation {
   799	      guard candidate.snapshot.profileID == expectation.profileID,
   800	        candidate.snapshot.configurationGeneration == expectation.configurationGeneration
   801	      else {
   802	        throw SSHProfileSnapshotLoaderError.profileGenerationMismatch
   803	      }
   804	    }
   805	
   806	    return try lock.withLock {
   807	      if let capture {
   808	        guard capture.data == candidate.data else {
   809	          throw SSHProfileSnapshotLoaderError.profileGenerationMismatch
   810	        }
   811	        return capture.snapshot
   812	      }
   813	      let immutableCapture = Capture(data: candidate.data, snapshot: candidate.snapshot)
   814	      capture = immutableCapture
   815	      return immutableCapture.snapshot
   816	    }
   817	  }
   818	}
