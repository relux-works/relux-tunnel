+        "TASK-260728-3cveay owns future rebase; no silent pin movement"
+      ],
+      "revalidationTriggers": [
+        "a selected-engine mandatory row becomes red, leaks, corrupts traffic, violates host-before-auth, exports secrets, or needs weaker thresholds",
+        "a libssh2/OpenSSL advisory affects the pin or a signed release changes relevant code",
+        "patch ceiling, crypto/algorithm policy, public-header boundary, or clean rebase condition changes",
+        "macOS/Xcode/deployment target, OpenSSH policy, approved algorithms, real-host policy, Keychain boundary, or adapter/core boundary changes",
+        "M3 scale, memory, soak, DNS, or deep-observability evidence is red",
+        "ReluxNIOSSH becomes conforming at materially lower security, maintenance, or footprint cost"
+      ]
+    }
+  ],
+  "compatibilityChecks": [
+    {
+      "id": "M1-CONTRACT-SCHEMA",
+      "result": "pass",
+      "condition": "runtime contract schema is exactly m1-runtime-contract/1"
+    },
+    {
+      "id": "M1-GRAPH-DIRECTION",
+      "result": "pass",
+      "condition": "provider consumes only ReluxTunnelMacOSAdapter plus the verified relay resource; adapter closure is Core + libssh2 adapter + native adapter"
+    },
+    {
+      "id": "M1-CANDIDATE-NEUTRAL-CORE",
+      "result": "pass",
+      "condition": "NetworkExtension, HEV, and selected SSH engine types do not cross ReluxTunnelCore public contracts"
+    },
+    {
+      "id": "M1-PACKET-ACTIVATION-ORDER",
+      "result": "pass",
+      "condition": "bound packet preflight is resource-free before routes; PacketFlowBridge.start and HEV acquisition occur only after settings apply"
+    },
+    {
+      "id": "M1-SSH-BEFORE-ROUTES",
+      "result": "pass",
+      "condition": "selected SSH host verification and authentication complete before TCP/DNS preparation or route apply"
+    },
+    {
+      "id": "M1-BOUND-VALUES",
+      "result": "pass",
+      "condition": "MTU, buffers, batching, HEV session ceiling, SSH windows, rekey envelope, lifecycle, notices, and fork dispositions exactly match accepted outcomes"
+    },
+    {
+      "id": "M1-DEFERRED-NOT-PROMOTED",
+      "result": "pass",
+      "condition": "iOS, general UDP, lanes, reconnect, fail-closed routes, physical extension memory, and M3 tuning remain deferred and are not defaults"
+    },
+    {
+      "id": "M1-SOLE-BINDING-SOURCE",
+      "result": "pass",
+      "condition": "TASK-260715-3ejhyy consumes this manifest without copying or reinterpreting M0 decisions"
+    }
+  ],
+  "productionCompositionPermitted": true,
+  "consumerContract": {
+    "taskId": "TASK-260715-3ejhyy",
+    "soleM0BindingSource": "Configuration/TASK-260720-1qhxqa_m0-production-bindings-v1.json",
+    "productionCallSite": "the TASK-260715-3ejhyy macOS production factory entry point before construction of concrete SSH, PacketFlowBridge, or HEV dependencies and before NetworkSettingsApplier.apply",
+    "failureBehavior": "do not construct the production root and do not apply network settings when validation is absent, unreadable, unknown, stale, superseded, incompatible, or digest-mismatched"
+  }
+}
