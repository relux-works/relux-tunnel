+    return try body(descriptor)
+  }
+
+  func close() {
+    lock.lock()
+    let ownedDescriptors = descriptors
+    descriptors.removeAll()
+    lock.unlock()
+    for descriptor in ownedDescriptors.reversed() {
+      _ = Darwin.close(descriptor)
+    }
+  }
