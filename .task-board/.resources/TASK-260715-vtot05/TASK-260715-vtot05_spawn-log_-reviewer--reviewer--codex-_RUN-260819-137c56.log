+        OBJC_COMMAND,
+        "Objective-C dynamic URL loader",
+    ),
+    (
+        "objc-reflection-digraph",
+        "Downloader.m",
+        "#import <Foundation/Foundation.h>\n#define JOIN(a,b) a %:%: b\nid f(id o,SEL s){return [o JOIN(perform,Selector):s];}\n",
+        OBJC_COMMAND,
+        "Objective-C dynamic URL loader",
