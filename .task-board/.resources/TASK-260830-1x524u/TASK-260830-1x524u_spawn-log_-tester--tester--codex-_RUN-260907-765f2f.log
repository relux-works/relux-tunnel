func (s *session) requireTransitionInPlace(txn *Txn) error {
	if !txn.Step6WriteSetPresent {
		return newError(ErrorIntegrationIndeterminate,
			"board_state_pending was entered with no durable step-6 write set to re-classify", nil)
	}
	classifications, err := ClassifyLanePlan(s.layout, s.renderer, txn)
	if err != nil {
		return s.recordAndReport(txn, Refusal{Code: CodeOf(err), Detail: err.Error()})
	}
	residual := ResidualPre(classifications)
	if len(residual) == 0 {
		return nil
	}
	return s.recordAndReport(txn, Refusal{
		Code:   ErrorTxnTransitionNotInPlace,
		Path:   strings.Join(residual, ","),
		Detail: "a phase that asserts the transition landed is not enterable on the strength of the field that says so",
	})
}

