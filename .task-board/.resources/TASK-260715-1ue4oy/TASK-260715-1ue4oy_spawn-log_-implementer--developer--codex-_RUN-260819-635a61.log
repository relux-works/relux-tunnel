+    if not stat.S_ISDIR(status.st_mode) or stat.S_ISLNK(status.st_mode):
+        raise AssetManifestError(f"{label} is not a safe directory")
+    return status.st_dev, status.st_ino
+
+
+def require_directory_identity_at(
