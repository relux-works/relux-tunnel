def handle(connection, mode):
    with connection:
        if mode == "early-close":
            return
        if mode == "reset":
            connection.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))
            return
        if mode == "disconnect":
