   957	  init(from decoder: any Decoder, expectedKind: RuntimeMessageKind) throws {
   958	    let container = try decoder.container(keyedBy: RuntimeSnapshotCodingKey.self)
   959	    protocolVersion = try container.decode(UInt16.self, forKey: .protocolVersion)
   960	    let kind = try container.decode(RuntimeMessageKind.self, forKey: .kind)
   961	    guard kind == expectedKind else { throw RuntimeMessageCodecError.unsupportedKind }
   962	    schemaVersion = try container.decode(UInt16.self, forKey: .schemaVersion)
   963	    requestID = try container.decodeIfPresent(
   964	      OpaqueRuntimeRequestIdentifier.self, forKey: .requestID)
   965	    runtimeGeneration = try container.decode(UInt64.self, forKey: .runtimeGeneration)
   966	    snapshotSequence = try container.decode(UInt64.self, forKey: .snapshotSequence)
   967	    let decodedRouteMode = try container.decode(RuntimeRouteMode.self, forKey: .routeMode)
   968	    routeMode = decodedRouteMode
   969	    projectedCapabilities = RuntimeCapabilityProjection(
   970	      tcp: try container.decode(Bool.self, forKey: .tcp),
   971	      safeDNS: try container.decode(Bool.self, forKey: .safeDNS),
   972	      udp: try container.decode(Bool.self, forKey: .udp),
   973	      routesInstalled: try container.decode(Bool.self, forKey: .routesInstalled),
   974	      healthy: try container.decode(Bool.self, forKey: .healthy)
   975	    ).projected(routeMode: decodedRouteMode, lifecycleState: nil)
   976	  }
   977	}
