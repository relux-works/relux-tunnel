def synthetic_binary(os_name: str, architecture: str) -> bytes:
    if os_name == "darwin":
        machine = 0x01000007 if architecture == "amd64" else 0x0100000C
        header = b"\xcf\xfa\xed\xfe" + struct.pack("<I", machine)
    else:
