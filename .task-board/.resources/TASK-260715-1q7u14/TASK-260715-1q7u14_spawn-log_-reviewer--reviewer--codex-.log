    73	    }
    74	  }
    75	
    76	  private func consumeClientHello(_ vector: RelayProtocolVector, input: Data) throws {
    77	    guard vector.expected.outcome == "success" else {
    78	      // Swift owns the client side and does not expose a client-hello decoder.
    79	      // The strict loader plus independent Python oracle audits hostile client
    80	      // hellos; the Go consumer executes them through its production decoder.
    81	      return
    82	    }
    83	    let maximumFrame = try require(vector.expected.maxFrame, vector, "missing maxFrame")
    84	    let configuration = try RelayClientHandshakeConfiguration(
    85	      maximumFrameBytes: maximumFrame,
    86	      requestedFeatures: featureSet(vector.features),
    87	      timeout: .seconds(1)
    88	    )
    89	    let encoded = RelayHandshakeWire.encodeClientHello(configuration: configuration)
    90	    try require(encoded == input, vector, "client hello encoder mismatch")
    91	  }
    92	
    93	  private func consumeServerHello(_ vector: RelayProtocolVector, input: Data) throws {
    94	    let configuration = try RelayClientHandshakeConfiguration(
    95	      maximumFrameBytes: RelayProtocolV1.maxFrameClientHardCeiling,
    96	      requestedFeatures: featureSet(vector.features),
    97	      timeout: .seconds(1)
    98	    )
    99	    do {
   100	      let result = try RelayHandshakeWire.decodeServerHelloExact(
   101	        input,
   102	        configuration: configuration
   103	      )
   104	      try require(vector.expected.outcome == "success", vector, "expected failure")
   105	      try require(
   106	        result.protocolVersion == vector.expected.version,
   107	        vector,
   108	        "server hello version mismatch"
   109	      )
   110	      try require(
   111	        result.negotiatedFeatures.rawValue == vector.expected.features,
   112	        vector,
   113	        "server hello features mismatch"
   114	      )
   115	      try require(
   116	        result.effectiveLimits.effectiveMaxFrame == vector.expected.maxFrame,
   117	        vector,
   118	        "server hello maxFrame mismatch"
   119	      )
   120	      let status = RelayProtocolV1.HelloStatus(
   121	        rawValue: try require(vector.expected.status, vector, "missing status")
   122	      )
   123	      let encoded = RelayHandshakeWire.encodeServerHello(
   124	        status: try require(status, vector, "unknown success status"),
   125	        features: result.negotiatedFeatures,
   126	        maximumFrameBytes: result.effectiveLimits.effectiveMaxFrame
   127	      )
   128	      try require(encoded == input, vector, "server hello encoder mismatch")
   129	    } catch let failure as RelayHandshakeFailure {
   130	      try expectHandshakeFailure(failure, vector: vector)
   131	    }
   132	  }
   133	
   134	  private func consumeEnvelopeInput(_ vector: RelayProtocolVector, input: Data) throws {
   135	    let maximumFrame = try resolvedLimit(vector.limitRefs[0], vectorID: vector.id)
   136	    guard maximumFrame <= UInt64(UInt32.max) else {
   137	      throw RelayVectorHarnessFailure(vectorID: vector.id, reason: "maxFrame overflow")
   138	    }
   139	    let direction = try envelopeDirection(vector.direction, vectorID: vector.id)
   140	    var decoder = try RelayEnvelopeDecoder(
   280	      "datagram disposition mismatch"
   281	    )
   282	  }
   283	}
