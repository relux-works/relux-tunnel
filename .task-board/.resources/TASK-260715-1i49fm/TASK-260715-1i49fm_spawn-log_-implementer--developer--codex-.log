   203	  @Test("snapshot top-level schema and reflected storage contain only approved fields")
   204	  func snapshotFieldAllowlist() throws {
   205	    let snapshot = try RuntimeDiagnosticsStore(runtimeGeneration: 1).snapshot()
   206	    let data = try RuntimeMessageCodec.encode(snapshot)
   207	    let object = try #require(JSONSerialization.jsonObject(with: data) as? [String: Any])
   208	    let approvedFields: Set<String> = [
   209	      "protocolVersion", "kind", "schemaVersion", "runtimeGeneration", "snapshotSequence",
   210	      "counters", "gauges", "histograms", "errors",
