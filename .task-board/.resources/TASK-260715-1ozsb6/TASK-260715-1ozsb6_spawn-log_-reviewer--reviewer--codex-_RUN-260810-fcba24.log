  1642	  private func channelDispose(
  1643	    identity: SSHChannelIdentity,
  1644	    disposition: SSHTransportErrorCode,
  1645	    graceful: Bool,
  1646	    terminalEvent: SSHTransportEventKind?
  1647	  ) async {
  1648	    guard channels[identity] != nil else { return }
  1649	    guard disposingChannels[identity] == nil else {
  1650	      await waitForChannelOperationsToDrain(identity: identity)
  1651	      return
  1652	    }
  1653	    disposingChannels[identity] = disposition
  1654	    channelWriteGates[identity]?.cancelPending()
  1655	    await waitForChannelOperationsToDrain(identity: identity)
  1656	    guard let record = channels.removeValue(forKey: identity) else { return }
  1657	    channelWriteGates.removeValue(forKey: identity)
  1658	    let deadline = dependencies.clock.now().advanced(
  1659	      by: configuration?.timeouts.channelClose ?? .seconds(1)
  1660	    )
  1661	    if graceful {
  1662	      while libssh2_channel_close(record.pointer) == LIBSSH2_ERROR_EAGAIN {
  1663	        do { try await cleanupProgress(until: deadline) } catch { break }
  1664	      }
  1665	    }
  1666	    while libssh2_channel_free(record.pointer) == LIBSSH2_ERROR_EAGAIN {
  1667	      do { try await cleanupProgress(until: deadline) } catch { break }
  1668	    }
  1669	    disposingChannels.removeValue(forKey: identity)
  1670	    pendingWriteBytes.removeValue(forKey: identity)
  1671	    if let terminalEvent { await emit(terminalEvent) }
  1672	  }
