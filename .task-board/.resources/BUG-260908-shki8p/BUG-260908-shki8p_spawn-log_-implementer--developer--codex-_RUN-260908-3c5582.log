enum StartupCancellationPoint: String, CaseIterable, Sendable {
  case duringConfiguration
  case beforeSSH
  case beforeTCP
  case beforeDNS
  case beforePacketPreparation
  case duringSettingsApply
  case duringPacketActivation
  case duringFinalHealth

