{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c57f","stream":{"kind":"session","id":"01a0a818-bded-7950-8bad-8c987713be85"},"sequence":282,"recorded_at":1780531400000559,"record_type":"event","durability":"durable","causation_id":"3d0e694b-dcbb-457c-8e66-a4082a9a6555","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3d0e694b-dcbb-457c-8e66-a4082a9a6555","run_stream":{"kind":"run","id":"3d0e694b-dcbb-457c-8e66-a4082a9a6555"},"task_stream":{"kind":"task","id":"01a0a819-7f3b-7792-8632-34d0ceb57a66"},"task_id":"01a0a819-7f3b-7792-8632-34d0ceb57a66","event":{"kind":"output","task_id":"01a0a819-7f3b-7792-8632-34d0ceb57a66","chunk":"{\n  \"chunk_id\": \"exec-6-1\",\n  \"command\": \"git -C /Users/iv/Developer/relux-tunnel status --short --branch 2>&1 | head -n 30\\necho \\\"===SHOW-REF-LOCAL===\\\"\\ngit -C /Users/iv/Developer/relux-tunnel show-ref 2>&1 | head -n 40\\necho \\\"===WORKTREES===\\\"\\ngit -C /Users/iv/Developer/relux-tunnel worktree list 2>&1 | head -n 20\\necho \\\"===TEMP-CONFIG===\\\"\\ncat /Users/iv/Developer/relux-tunnel/.temp/resume-20260916/task-board.config.json 2>&1 | head -n 60\",\n  \"description\": \"Inspect git refs, worktrees and resume config\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"## main...origin/main [ahead 2]\\n M .task-board/.activity/STORY-260715-1y04r0/events.ndjson\\n M .task-board/.activity/TASK-260830-1x524u/events.ndjson\\n M .task-board/.goals/primary/head.json\\n M .task-board/.goals/v2/owners/parent/primary/head.json\\n M .task-board/.resources/TASK-260715-whtdsf/TASK-260715-whtdsf_ci-trust-boundary.puml\\n M .task-board/.resources/TASK-260830-1x524u/TASK-260830-1x524u_spawn-log_-tester--tester--codex-_RUN-260907-765f2f.log\\n M .task-board/EPIC-260715-21g2pi_product-experience-and-security/STORY-260715-309t4z_connection-control-and-status-ui/TASK-260715-2a1cp7_record-connection-presentation-state-and-command-contr