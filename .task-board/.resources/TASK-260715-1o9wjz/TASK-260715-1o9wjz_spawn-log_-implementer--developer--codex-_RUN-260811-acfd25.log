+private actor FixtureSystemKeychainClient: MacOSSystemKeychainSecurityClient {
+  let keychain: MacOSSystemKeychainHandle
+  let status: OSStatus
+  let item: MacOSKeychainLookupItem?
+  let gate: ResolverTestGate?
