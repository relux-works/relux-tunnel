  2193	  private func cleanupProgress(until deadline: ContinuousClock.Instant) async throws {
  2194	    let now = dependencies.clock.now()
  2195	    guard now < deadline else { throw LibSSH2TimeoutError.elapsed }
  2196	    guard let connection, let engineSession else { return }
