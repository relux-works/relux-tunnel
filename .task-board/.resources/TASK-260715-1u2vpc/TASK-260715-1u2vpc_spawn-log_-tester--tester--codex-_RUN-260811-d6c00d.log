public enum HarnessConfigurationSchema {
  public static let currentVersion: UInt16 = 1
}

public enum HarnessResultSchema {
  public static let currentVersion: UInt16 = 1
}

public enum HarnessMetricSchema {
  public static let currentVersion: UInt16 = 1
