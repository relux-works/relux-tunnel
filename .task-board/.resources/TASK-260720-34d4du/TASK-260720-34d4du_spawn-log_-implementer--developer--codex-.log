   244	    private func writeMessage(
   245	        _ multiMessage: SSHMultiMessage,
   246	        context: ChannelHandlerContext,
   247	        promise: EventLoopPromise<Void>? = nil
   248	    ) throws {
   249	        self.outboundFrameBuffer.clear()
   250	
   251	        for message in multiMessage {
   252	            let wasKeyExchangeInProgress = self.stateMachine.isKeyExchangeInProgress
   253	            try self.stateMachine.processOutboundMessage(
   254	                message,
   255	                buffer: &self.outboundFrameBuffer,
   256	                allocator: context.channel.allocator,
   257	                loop: context.eventLoop
   258	            )
