new file mode 100644
index 0000000000000000000000000000000000000000..6d17896e583ec1f002a6367268177448147f7139
--- /dev/null
+++ b/relay/supply-chain-source-v1.json
@@ -0,0 +1,141 @@
+{
+  "schemaVersion": 1,
+  "taskID": "TASK-260715-vtot05",
