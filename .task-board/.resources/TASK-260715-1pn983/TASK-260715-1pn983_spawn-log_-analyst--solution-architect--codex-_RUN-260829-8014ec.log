+from pathlib import Path
+
+root = Path(__file__).resolve().parents[2]
+contract = (root / "docs/TASK-260715-1pn983_memory-window-rekey-contract.md").read_text()
+packet = (root / ".spec/packet-plane.md").read_text()
+diagram = (root / "diagrams/TASK-260715-1pn983_reconnect-rekey-state.puml").read_text()
+packet_words = " ".join(packet.split())
+
+
+def require(value: bool, message: str) -> None:
+    if not value:
+        raise AssertionError(message)
+
+
+# Reviewer F1: the permanent untracked row is already charged by every path.
+global_ceiling = 100
+other_charge = 80
+untracked_charge = 10
+committed = other_charge + untracked_charge
+require(committed + 10 == global_ceiling, "equality must fit")
+require(not (committed + 11 <= global_ceiling), "one-byte untracked spend must refuse")
+
+# Reviewer F2: total-capacity growth and a separate incremental owner are distinct.
+current = 60
+existing_capacity = 60
+existing_charge = max(current, existing_capacity)
+candidate_total_capacity = 110
+candidate_delta = max(current, candidate_total_capacity) - existing_charge
+require(candidate_delta == 50, "total-capacity growth must charge exactly its delta")
+incremental_owner_capacity = 50
+require(max(0, incremental_owner_capacity) == 50, "new incremental owner must charge in full")
+
+# Reviewer F3: exercise the closed lane predicate, then narrow every gate.
+base = {
+    "count": True,
+    "hard_count": True,
+    "base": True,
+    "kex": True,
+    "control": True,
+    "lane_a": True,
+    "global": True,
+    "generation": True,
+    "pool": True,
+    "pressure": True,
+}
+
+
+def lane_admits(values: dict[str, bool]) -> bool:
+    return all(values.values())
+
+
+require(lane_admits(base), "complete lane predicate must admit equality case")
+for gate in base:
+    narrowed = dict(base)
+    narrowed[gate] = False
+    require(not lane_admits(narrowed), f"narrowed lane gate admitted: {gate}")
+
+required_contract_terms = [
+    "B_untracked` is a permanent ledger consumer row",
+    "candidateChargeDelta_i",
+    "pre-admission `ledgerCommittedBytes` includes the permanent `B_untracked`",
+    "laneAdmissionRefused(reason)",
+    "There is no waiting or retry side queue",
+    "Failed construction cancels reachability and releases",
+    "it excludes the proposed replacement",
+    "oldTransportCharge=0",
+    "Untracked reservation cannot be spent",
+    "Total-capacity vs incremental reservation",
+    "Lane admission",
+]
+for term in required_contract_terms:
+    require(term in contract, f"missing contract term: {term}")
+
+require("baseline physical iPhone" not in packet_words, "deferred iPhone still named active target")
+require("named baseline physical Apple-silicon Mac" in packet_words, "Mac target missing")
+require("Mac evidence is never substituted" in packet_words, "device variance rule missing")
+require("KEXActive --> KEXIdle" in diagram, "KEX success must retain reservation")
+require("KEXActive --> Current" not in diagram, "KEX must not collapse into reconnect state")
+require("state Reconnect" in diagram, "orthogonal reconnect region missing")
+require("state KEX" in diagram, "orthogonal KEX region missing")
+
+print("reviewer counterexamples and narrowed lane predicates: PASS")
