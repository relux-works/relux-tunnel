  -destination 'platform=macOS' \
  -derivedDataPath "$derived_data" \
  CODE_SIGNING_ALLOWED=NO \
  CODE_SIGNING_REQUIRED=NO \
  SYMROOT="$products" \
  OBJROOT="$intermediates" \
  test > "$task_output/target-contract-tests.log" 2>&1

