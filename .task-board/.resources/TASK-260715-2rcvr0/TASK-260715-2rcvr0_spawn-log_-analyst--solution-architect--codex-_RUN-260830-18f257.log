   653	    gauges: [String: Int64] = [:],
   654	    histograms: [String: RuntimeDiagnosticHistogram] = [:],
   655	    errors: [RedactedRuntimeError] = [],
   656	    sshBootstrapError: SSHBootstrapDiagnostic? = nil
   657	  ) {
   658	    protocolVersion = RuntimeMessageProtocol.currentProtocolVersion
