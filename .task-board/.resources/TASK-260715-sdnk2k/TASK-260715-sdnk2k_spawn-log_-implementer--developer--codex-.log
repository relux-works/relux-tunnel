+      try await withCheckedThrowingContinuation { continuation in
+        lock.lock()
+        if firstReleased {
+          lock.unlock()
+          continuation.resume()
+        } else {
+          waiter = continuation
+          lock.unlock()
+        }
+      }
+    } onCancel: {
+      let waiter = lock.withLock { () -> CheckedContinuation<Void, Error>? in
+        defer { self.waiter = nil }
+        return self.waiter
+      }
+      waiter?.resume(throwing: CancellationError())
+    }
+  }
