   176	def open_regular_path(
   177	    path: Path,
   178	    label: str,
   179	    *,
   180	    maximum_size: int,
   181	    expected_size: int | None = None,
   182	) -> tuple[int, os.stat_result]:
   183	    no_follow = getattr(os, "O_NOFOLLOW", None)
   184	    if no_follow is None:
   185	        raise AssetManifestError("trusted relay input no-follow reads are unavailable")
   186	    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | no_follow
   187	    descriptor: int | None = None
   188	    try:
   189	        descriptor = os.open(path, flags)
   190	        status = os.fstat(descriptor)
