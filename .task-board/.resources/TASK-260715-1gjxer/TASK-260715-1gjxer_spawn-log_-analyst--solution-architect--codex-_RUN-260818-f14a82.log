+  func sign(_ payload: Data) async throws -> Data {
+    try await Task.detached {
+      var request = Data([13])
+      appendSSHString(publicKeyBytes, to: &request)
+      appendSSHString(payload, to: &request)
+      var flags = UInt32(0).bigEndian
