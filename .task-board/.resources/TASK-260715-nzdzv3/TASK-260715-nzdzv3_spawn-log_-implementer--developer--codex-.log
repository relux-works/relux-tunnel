+        precondition(!deliveredOverflow)
+        self.deliveredButUnadjustedBytes = newDeliveredBytes
+
+        guard let threshold = self.configuration.windowAdjustmentThreshold,
+            self.deliveredButUnadjustedBytes >= threshold
+        else {
+            return nil
