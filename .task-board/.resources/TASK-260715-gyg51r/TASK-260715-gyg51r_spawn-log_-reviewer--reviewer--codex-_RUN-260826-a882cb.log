    var sendTimes: [UInt64: UInt64] = [:]
    var latencies: [UInt64] = []
    var packetsSent = 0
    var packetsReceived = 0
    var bytesSent: UInt64 = 0
    var bytesReceived: UInt64 = 0
    var sendSyscalls = 0
    var receiveSyscalls = 0
