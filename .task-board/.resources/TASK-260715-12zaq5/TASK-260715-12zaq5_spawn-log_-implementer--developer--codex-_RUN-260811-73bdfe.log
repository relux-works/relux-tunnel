   300	private func canonicalRecords(
   301	  _ records: [SSHHostIdentityRecordV1]
   302	) -> [SSHHostIdentityRecordV1] {
   303	  records.sorted { lhs, rhs in
   304	    if lhs.algorithm.rawValue != rhs.algorithm.rawValue {
   305	      return lhs.algorithm.rawValue.utf8.lexicographicallyPrecedes(rhs.algorithm.rawValue.utf8)
   306	    }
   307	    return fingerprintDigest(lhs.fingerprintSHA256.rawValue).lexicographicallyPrecedes(
   308	      fingerprintDigest(rhs.fingerprintSHA256.rawValue)
   309	    )
   310	  }
   311	}
   312	
   313	private func fingerprintDigest(_ value: String) -> Data {
   314	  Data(base64Encoded: String(value.dropFirst(7)) + "=")!
   315	}
