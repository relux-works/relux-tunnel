   853	        await Task.yield()
   854	      }
   855	      #expect(await transport.snapshot().gauges.pendingReads == 1, "iteration \(iteration)")
   856	      await channel.cancel()
   857	      do {
   858	        _ = try await pendingRead.value
   859	        Issue.record(
   860	          "concurrent channel read unexpectedly completed", sourceLocation: #_sourceLocation)
   861	      } catch let error as SSHTransportError {
   862	        #expect(error.code == .cancelled, "iteration \(iteration)")
   863	        #expect(error.phase == .channelRead, "iteration \(iteration)")
   864	      }
   865	      #expect(await transport.snapshot().gauges.pendingReads == 0, "iteration \(iteration)")
   866	    }
   867	  }
