+private enum AdapterFixtureEvent: Equatable, Sendable {
+  case hostPolicy
+  case credentialLookup
+}
+
+private actor AdapterFixtureTrace {
+  private(set) var events: [AdapterFixtureEvent] = []
+
+  func append(_ event: AdapterFixtureEvent) {
+    events.append(event)
+  }
+}
