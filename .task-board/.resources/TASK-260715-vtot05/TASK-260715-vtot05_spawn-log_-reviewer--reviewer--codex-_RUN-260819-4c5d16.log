   951	def generated_outputs(config: dict[str, Any]) -> dict[str, bytes]:
   952	    return {
   953	        config["outputs"]["inventory"]: render_inventory(config),
   954	        config["outputs"]["provenance"]: render_provenance(config),
   955	        config["outputs"]["notices"]: render_notices(config),
   956	    }
