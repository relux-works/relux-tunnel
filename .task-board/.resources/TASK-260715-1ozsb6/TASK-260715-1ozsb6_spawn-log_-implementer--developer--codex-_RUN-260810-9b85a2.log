+    trustRecordReference: nil,
+    algorithms: SSHAlgorithmPolicy(
+      keyExchange: ["curve25519-sha256", "curve25519-sha256@libssh.org"],
+      hostKey: ["ssh-ed25519", "ecdsa-sha2-nistp256"],
