  1041	            if event_hook is not None:
  1042	                event_hook("after_publish", bundle)
  1043	            return
  1044	        if not stat.S_ISDIR(existing_status.st_mode) or stat.S_ISLNK(
  1045	            existing_status.st_mode
  1046	        ):
  1047	            raise AssetManifestError("relay asset bundle destination is unsafe")
