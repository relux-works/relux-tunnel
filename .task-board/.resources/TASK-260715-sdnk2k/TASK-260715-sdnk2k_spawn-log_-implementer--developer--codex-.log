+
+enum PumpCancellationSite: String, CaseIterable, Sendable {
+  case localReadable
+  case localWritable
+  case sshRead
+  case sshWrite
+  case fairnessYield
+
+  var direction: BytePumpDirection {
+    switch self {
+    case .localReadable, .sshWrite, .fairnessYield:
+      .localToSSH
+    case .localWritable, .sshRead:
+      .sshToLocal
+    }
