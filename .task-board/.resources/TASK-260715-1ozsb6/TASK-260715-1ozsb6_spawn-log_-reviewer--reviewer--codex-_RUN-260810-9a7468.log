   715	  private func sendKeepalive(
   716	    deferBehindRekey: Bool
   717	  ) async throws -> SSHDeferredSemanticReport<Duration> {
   718	    guard let configuration else {
   719	      throw transportError(code: .invalidState, phase: .keepalive)
   720	    }
   721	    guard !keepaliveInFlight else {
   722	      throw transportError(code: .operationInProgress, phase: .keepalive, scope: .operation)
   723	    }
