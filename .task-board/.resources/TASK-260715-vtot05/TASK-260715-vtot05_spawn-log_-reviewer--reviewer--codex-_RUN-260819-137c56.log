   304	def validate_provenance(value: Any) -> dict[str, str]:
   305	    if not isinstance(value, dict) or set(value) != PROVENANCE_KEYS:
   306	        raise AssetManifestError("build provenance field set changed")
   307	    if (
   308	        value.get("kind") != "taskBoardResource"
   309	        or not isinstance(value.get("taskID"), str)
   310	        or TASK_PATTERN.fullmatch(value["taskID"]) is None
   311	        or not isinstance(value.get("resourceName"), str)
   312	        or RESOURCE_PATTERN.fullmatch(value["resourceName"]) is None
   313	        or not isinstance(value.get("archiveSHA256"), str)
   314	        or SHA256_PATTERN.fullmatch(value["archiveSHA256"]) is None
   315	    ):
   316	        raise AssetManifestError("build provenance value is invalid")
   317	    return value
