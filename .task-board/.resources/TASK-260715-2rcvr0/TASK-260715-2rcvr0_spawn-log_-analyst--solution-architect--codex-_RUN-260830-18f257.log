   356	private final class ProviderOnceGate<Value: Sendable>: @unchecked Sendable {
   357	  private let lock = NSLock()
   358	  private var handler: (@Sendable (Value) -> Void)?
   359	
   360	  init(_ handler: @escaping @Sendable (Value) -> Void) {
   361	    self.handler = handler
   362	  }
   363	
   364	  func complete(_ value: Value) {
   365	    let callback = lock.withLock {
   366	      let callback = handler
   367	      handler = nil
   368	      return callback
   369	    }
   370	    callback?(value)
   371	  }
   372	}
   373	
   374	private final class ProviderFirstResult<Value: Sendable>: @unchecked Sendable {
   375	  private let lock = NSLock()
   376	  private var result: Value?
   377	  private var continuation: CheckedContinuation<Value, Never>?
   378	
   379	  func wait() async -> Value {
   380	    await withCheckedContinuation { continuation in
   381	      let immediate = lock.withLock { () -> Value? in
   382	        if let result { return result }
   383	        self.continuation = continuation
   384	        return nil
   385	      }
   386	      if let immediate {
   387	        continuation.resume(returning: immediate)
   388	      }
   389	    }
   390	  }
   391	
   392	  func resolve(_ value: Value) {
   393	    let continuation = lock.withLock { () -> CheckedContinuation<Value, Never>? in
   394	      guard result == nil else { return nil }
   395	      result = value
   396	      let continuation = self.continuation
   397	      self.continuation = nil
   398	      return continuation
   399	    }
   400	    continuation?.resume(returning: value)
   401	  }
   402	}
   403	
   404	private final class ProviderRetirementSignal: @unchecked Sendable {
   405	  private let lock = NSLock()
   406	  private var isRetired = false
   407	  private var waiters: [UUID: CheckedContinuation<Void, any Error>] = [:]
   408	
   409	  func wait() async throws {
   410	    let identifier = UUID()
   411	    try await withTaskCancellationHandler {
   412	      try await withCheckedThrowingContinuation {
   413	        (continuation: CheckedContinuation<Void, any Error>) in
   414	        let result: RetirementRegistration = lock.withLock {
   415	          if isRetired { return .retired }
   416	          if Task<Never, Never>.isCancelled { return .cancelled }
   417	          waiters[identifier] = continuation
   418	          return .registered
   419	        }
   420	        switch result {
   421	        case .registered:
   422	          break
   423	        case .retired:
   424	          continuation.resume()
   425	        case .cancelled:
   426	          continuation.resume(throwing: CancellationError())
   427	        }
   428	      }
   429	    } onCancel: {
   430	      let continuation = self.lock.withLock {
   431	        self.waiters.removeValue(forKey: identifier)
   432	      }
   433	      continuation?.resume(throwing: CancellationError())
   434	    }
   435	  }
   436	
   437	  func retire() {
   438	    let waiters: [CheckedContinuation<Void, any Error>] = lock.withLock {
   439	      guard !isRetired else { return [] }
   440	      isRetired = true
   441	      let waiters = Array(self.waiters.values)
   442	      self.waiters.removeAll()
   443	      return waiters
   444	    }
   445	    for waiter in waiters { waiter.resume() }
   446	  }
   447	
   448	  private enum RetirementRegistration {
   449	    case registered
   450	    case retired
   451	    case cancelled
   452	  }
   453	}
   454	
   455	/// Synchronous, exactly-once admission for provider-failure callbacks.
   456	///
   457	/// `providerDidFail` hands its work to the actor through an unstructured task,
   458	/// and those tasks are not ordered against one another. Claiming admission on
   459	/// the caller's thread keeps the first call the one that cancels the tunnel,
   460	/// and drops every later or concurrent call before it can reach the actor.
   461	private final class ProviderFailureAdmission: @unchecked Sendable {
   462	  private let lock = NSLock()
   463	  private var isClaimed = false
   464	
   465	  func claim() -> Bool {
   466	    lock.withLock {
   467	      guard !isClaimed else { return false }
   468	      isClaimed = true
   469	      return true
   470	    }
   471	  }
   472	
   473	  func releaseForNewGeneration() {
   474	    lock.withLock { isClaimed = false }
   475	  }
   476	}
