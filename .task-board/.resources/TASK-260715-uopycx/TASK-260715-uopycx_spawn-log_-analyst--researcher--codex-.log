   227	static uint16_t
   228	hev_socks5_addr_get_port (const HevSocks5Addr *addr)
   229	{
   230	    uint16_t port = 0;
   231	
   232	    switch (addr->atype) {
   233	    case HEV_SOCKS5_ADDR_TYPE_IPV4:
   234	        port = addr->ipv4.port;
   235	        break;
   236	    case HEV_SOCKS5_ADDR_TYPE_IPV6:
   237	        port = addr->ipv6.port;
   238	        break;
   239	    case HEV_SOCKS5_ADDR_TYPE_NAME:
   240	        memcpy (&port, addr->domain.addr + addr->domain.len, 2);
   241	    }
   242	
   243	    return port;
   244	}
