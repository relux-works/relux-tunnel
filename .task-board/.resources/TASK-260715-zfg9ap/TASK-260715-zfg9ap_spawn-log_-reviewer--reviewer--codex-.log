   353	  ) {
   354	    self.configuration = configuration
   355	    state = Mutex(State(sessionHealth: initialSessionHealth, nextID: 1))
   356	    self.diagnostics = diagnostics
   357	    state.withLock { emitGauges($0) }
   358	  }
