diff --git a/Tests/ReluxTunnelLibSSH2AdapterTests/LibSSH2WindowPolicyAdapterTests.swift b/Tests/ReluxTunnelLibSSH2AdapterTests/LibSSH2WindowPolicyAdapterTests.swift
new file mode 100644
