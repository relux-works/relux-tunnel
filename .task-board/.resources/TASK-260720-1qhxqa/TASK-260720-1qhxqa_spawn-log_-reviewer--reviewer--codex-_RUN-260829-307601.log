   300	def validate(
   301	    manifest_path: Path,
   302	    resources_root: Path,
   303	    repository_root: Path,
   304	    board_state_path: Path,
   305	) -> dict[str, Any]:
   306	    failures: list[dict[str, str]] = []
   307	    manifest_digest = "unknown"
   308	    try:
   309	        manifest_digest = sha256(manifest_path)
   310	        manifest = require_object(
   311	            json.loads(manifest_path.read_text(encoding="utf-8")), "MANIFEST-JSON"
   312	        )
   313	        require_exact_keys(manifest, ROOT_KEYS, "MANIFEST-FIELDS")
   314	        if manifest["schemaVersion"] != 1 or manifest["schemaIdentifier"] != "relux.m0-production-bindings/1":
   315	            raise BindingError("MANIFEST-SCHEMA", "unknown binding schema version")
   316	        if manifest["taskId"] != "TASK-260720-1qhxqa":
   317	            raise BindingError("MANIFEST-TASK", "wrong binding task authority")
   318	        verify_board_state(board_state_path, manifest)
   319	
   320	        runtime = require_object(manifest["runtimeContract"], "RUNTIME-CONTRACT")
   321	        require_exact_keys(runtime, RUNTIME_KEYS, "RUNTIME-CONTRACT")
   322	        if runtime["taskId"] != "TASK-260715-30zng6" or runtime["schema"] != "m1-runtime-contract/1":
   323	            raise BindingError("RUNTIME-CONTRACT", "unknown or incompatible runtime contract")
   324	        validate_supersession(runtime["supersession"], "RUNTIME-SUPERSESSION")
   325	        runtime_verdict = validate_verdict(runtime["reviewerVerdict"], "RUNTIME-VERDICT")
   326	        verify_resource(
   327	            resources_root,
   328	            runtime["taskId"],
   329	            {"resourceName": runtime["resourceName"], "sha256": runtime["sha256"]},
   330	            "RUNTIME-RESOURCE",
   331	        )
   332	        verify_resource(resources_root, runtime["taskId"], {
   333	            "resourceName": runtime_verdict["resourceName"],
   334	            "sha256": runtime_verdict["sha256"],
   335	        }, "RUNTIME-VERDICT-RESOURCE")
   336	
   337	        raw_inputs = manifest["acceptedInputs"]
   338	        if not isinstance(raw_inputs, list) or len(raw_inputs) != 3:
   339	            raise BindingError("INPUT-SET", "exactly three accepted inputs are required")
   340	        inputs: dict[str, dict[str, Any]] = {}
   341	        task_ids: set[str] = set()
   342	        for index, raw_input in enumerate(raw_inputs):
   343	            value = require_object(raw_input, f"INPUT-{index}")
   344	            require_exact_keys(value, INPUT_KEYS, f"INPUT-{index}-FIELDS")
   345	            kind = value["kind"]
   346	            task_id = value["taskId"]
   347	            if kind in inputs:
   348	                raise BindingError("INPUT-SET", f"duplicate input kind {kind}")
   349	            inputs[kind] = value
   350	            task_ids.add(task_id)
   351	            validate_supersession(value["supersession"], f"{task_id}-SUPERSESSION")
   352	            verdict = validate_verdict(value["reviewerVerdict"], f"{task_id}-VERDICT")
   353	            outcome = require_object(value["acceptedOutcome"], f"{task_id}-OUTCOME")
   354	            verify_resource(resources_root, task_id, outcome, f"{task_id}-OUTCOME")
   355	            verify_resource(resources_root, task_id, {
   356	                "resourceName": verdict["resourceName"], "sha256": verdict["sha256"]
   357	            }, f"{task_id}-VERDICT-RESOURCE")
   358	            require_nonempty_strings(value["requiredCapabilities"], f"{task_id}-CAPABILITIES")
   359	            require_nonempty_strings(
   360	                value["licenseAndMaintenanceObligations"], f"{task_id}-OBLIGATIONS"
   361	            )
   362	            require_nonempty_strings(value["revalidationTriggers"], f"{task_id}-TRIGGERS")
   363	            if not value["sourceOrBinaryPins"] or not value["bindings"]:
   364	                raise BindingError(f"{task_id}-BINDINGS", "pins and normalized bindings are required")
   365	        if task_ids != EXPECTED_TASKS or set(inputs) != EXPECTED_KINDS:
   366	            raise BindingError(
   367	                "INPUT-SET",
   368	                f"required tasks={sorted(EXPECTED_TASKS)}, got={sorted(task_ids)}; required kinds={sorted(EXPECTED_KINDS)}, got={sorted(inputs)}",
   369	            )
   370	
   371	        checks = manifest["compatibilityChecks"]
   372	        if not isinstance(checks, list):
   373	            raise BindingError("COMPATIBILITY", "compatibility checks must be an array")
   374	        check_ids: set[str] = set()
   375	        for check in checks:
   376	            value = require_object(check, "COMPATIBILITY")
   377	            require_exact_keys(value, COMPATIBILITY_KEYS, "COMPATIBILITY-FIELDS")
   378	            check_ids.add(value["id"])
   379	            if value["result"] != "pass" or not value["condition"]:
   380	                raise BindingError(value["id"], "compatibility condition did not pass")
   381	        if check_ids != EXPECTED_COMPATIBILITY_ROWS or len(checks) != len(check_ids):
   382	            raise BindingError("COMPATIBILITY-SET", "missing, unknown, or duplicate compatibility row")
   383	
   384	        consumer = require_object(manifest["consumerContract"], "CONSUMER-CONTRACT")
   385	        require_exact_keys(consumer, CONSUMER_KEYS, "CONSUMER-CONTRACT")
   386	        if consumer["taskId"] != "TASK-260715-3ejhyy":
   387	            raise BindingError("CONSUMER-CONTRACT", "wrong or ambiguous downstream consumer")
   388	        if not all(isinstance(consumer[key], str) and consumer[key] for key in CONSUMER_KEYS):
   389	            raise BindingError("CONSUMER-CONTRACT", "consumer fields must be non-empty strings")
   390	
   391	        verify_repository(repository_root, inputs)
   392	        computed_permit = True
   393	        if manifest["productionCompositionPermitted"] is not computed_permit:
   394	            raise BindingError("PERMIT-ATTESTATION", "stored permit does not equal recomputed permit")
   395	    except (BindingError, OSError, json.JSONDecodeError, KeyError, TypeError) as error:
   396	        if isinstance(error, BindingError):
   397	            failures.append({"row": error.row, "detail": error.detail})
   398	        else:
   399	            failures.append({"row": "UNREADABLE-OR-MALFORMED", "detail": str(error)})
   400	
   401	    return {
   402	        "schemaVersion": 1,
   403	        "manifestSha256": manifest_digest,
   404	        "productionCompositionPermitted": not failures,
   405	        "failures": failures,
   406	    }
