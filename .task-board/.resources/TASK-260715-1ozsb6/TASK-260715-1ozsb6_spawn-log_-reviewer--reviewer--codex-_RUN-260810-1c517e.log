   648	  private func requestRekey(
   649	    reason: SSHClientRekeyReason,
   650	    waitsForFatalTeardown: Bool
   651	  ) async throws {
   652	    guard state == .ready || state == .rekeying, !closeRequested, let configuration else {
   653	      throw transportError(code: .invalidState, phase: .rekey)
   654	    }
   655	    guard rekeyWaiters.count < Self.maximumPendingOperations else {
   656	      throw transportError(code: .resourceLimitExceeded, phase: .rekey, scope: .operation)
   657	    }
