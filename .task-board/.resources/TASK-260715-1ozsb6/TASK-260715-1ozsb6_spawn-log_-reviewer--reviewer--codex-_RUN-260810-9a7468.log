  1788	      task = existing
  1789	    } else {
  1790	      disposingChannels[identity] = disposition
  1791	      channelWriteGates[identity]?.cancelPending()
  1792	      task = Task { [weak self] in
  1793	        guard let self else { return false }
  1794	        return await self.performChannelDispose(
  1795	          identity: identity,
  1796	          graceful: graceful,
  1797	          terminalEvent: terminalEvent
  1798	        )
  1799	      }
  1800	      channelDisposalTasks[identity] = task
  1801	    }
  1802	    let disposed = await task.value
  1803	    channelDisposalTasks.removeValue(forKey: identity)
  1804	    if !disposed, triggersTeardownOnFailure {
  1805	      if state != .failed, state != .closing, state != .closed {
  1806	        try? await transition(to: .failed)
  1807	      }
  1808	      await tearDown()
  1809	    }
  1810	    return disposed
  1811	  }
