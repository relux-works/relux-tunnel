def validate_release_inputs(relay_version: str, source_commit: str) -> None:
    if (
        not relay_version
        or len(relay_version.encode("ascii", errors="ignore")) != len(relay_version)
        or len(relay_version) > MAX_RELAY_VERSION_BYTES
