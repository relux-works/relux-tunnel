+    @Sendable (SSHProfileSnapshotV1) throws -> any SSHHostKeyPolicy
+  public let mapCredentialError:
+    @Sendable (MacOSCredentialResolverError, UInt64) -> SSHBootstrapProviderError
+
+  fileprivate init(
+    transportFactory: any SSHTransportFactory,
+    credentialProvider: any SSHCredentialProvider,
+    acceptedTransportBufferBytes: Int,
+    acceptedInitialReceiveWindowBytes: Int
+  ) {
+    self.transportFactory = transportFactory
+    self.credentialProvider = credentialProvider
+    self.acceptedTransportBufferBytes = acceptedTransportBufferBytes
+    self.acceptedInitialReceiveWindowBytes = acceptedInitialReceiveWindowBytes
+    makeHostKeyPolicy = { try MacOSProviderSSHConfiguration.makeHostKeyPolicy(snapshot: $0) }
+    mapCredentialError = {
+      MacOSSSHBootstrapErrorMapper.credential($0, configurationGeneration: $1)
+    }
+  }
+}
