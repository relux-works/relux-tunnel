  1205	  func channelExit(identity: SSHChannelIdentity) async throws -> SSHExecExit {
  1206	    try beginChannelOperation(identity: identity, phase: .execExit)
  1207	    do {
  1208	      let result = try await performChannelExit(identity: identity)
  1209	      finishChannelOperation(identity: identity)
  1210	      return result
  1211	    } catch {
  1212	      finishChannelOperation(identity: identity)
  1213	      let mapped = map(error, phase: .execExit)
  1214	      await recordTerminalOperation(mapped)
  1215	      throw mapped
  1216	    }
  1217	  }
  1218	
  1219	  private func performChannelExit(identity: SSHChannelIdentity) async throws -> SSHExecExit {
  1220	    guard let record = channels[identity], record.kind == .exec, let configuration else {
  1221	      throw transportError(code: .invalidState, phase: .execExit, scope: .channel(identity))
  1222	    }
  1223	    let deadline = dependencies.clock.now().advanced(by: configuration.timeouts.execExit)
  1224	    while libssh2_channel_eof(record.pointer) == 0 {
  1225	      try checkChannelDisposition(identity: identity, phase: .execExit)
  1226	      try await progress(until: deadline, phase: .execExit)
  1227	    }
  1228	
  1229	    var signal: UnsafeMutablePointer<CChar>?
  1230	    var signalLength = 0
  1231	    let result = libssh2_channel_get_exit_signal(
  1232	      record.pointer,
  1233	      &signal,
  1234	      &signalLength,
  1235	      nil,
  1236	      nil,
  1237	      nil,
  1238	      nil
  1239	    )
  1240	    guard result == 0 else { return .notReported }
  1241	    guard let signal, signalLength > 0 else {
  1242	      // libssh2 exposes status 0 without a presence bit. Returning it would
  1243	      // fabricate the M3-deferred exact-exit semantic.
  1244	      return .notReported
  1245	    }
  1246	    let name = Data(bytes: signal, count: signalLength).withUnsafeBytes {
  1247	      String(decoding: $0.bindMemory(to: UInt8.self), as: UTF8.self)
  1248	    }
  1249	    if let engineSession { libssh2_free(engineSession, signal) }
  1250	    return .signal(
  1251	      SSHExecSignal(name: execSignalName(name), coreDumped: .unsupported)
  1252	    )
  1253	  }
