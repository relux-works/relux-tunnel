   766	def run_lifecycle(provider: BuiltinProvider) -> dict:
   767	    manifest = fixture.load_manifest()
   768	    servers = {server["id"]: server for server in manifest["servers"]}
   769	    prepared = []
   770	    observations = []
   771	    failure: Exception | None = None
   772	    try:
   773	        for server_id in sorted(fixture.REQUIRED_SERVERS):
   774	            prepared.append(server_id)
   775	            dispatch(
   776	                provider,
   777	                {
   778	                    "action": "prepare", "protocol": "relux-ssh-matrix-provider-v1",
   779	                    "secretReference": servers[server_id]["identity"]["secretReference"],
   780	                    "serverId": server_id,
   781	                },
   782	            )
   783	            rotation = dispatch(
   784	                provider,
   785	                {"action": "rotate", "protocol": "relux-ssh-matrix-provider-v1", "serverId": server_id},
   786	            )
   787	            expected = "external-owner-managed" if server_id == "relux-real" else "rotated"
   788	            if rotation.get("disposition") != expected:
   789	                raise ProviderError(f"{server_id} lifecycle rotation evidence drifted")
   790	            probe = dispatch(
   791	                provider,
   792	                {"action": "probe", "protocol": "relux-ssh-matrix-provider-v1", "serverId": server_id},
   793	            )
   794	            public = fixture._validate_public_observation(servers[server_id], probe)
   795	            observations.append(
   796	                {
   797	                    "architecture": public["architecture"],
   798	                    "hostKeyFingerprints": public["hostKeyFingerprints"],
   799	                    "opensshVersion": public["opensshVersion"],
   800	                    "osName": public["osName"],
   801	                    "osVersion": public["osVersion"],
   802	                    "privilege": public["privilege"],
   803	                    "reachable": public["reachable"],
   804	                    "rotation": expected,
   805	                    "serverId": server_id,
   806	                    "userKeyTypes": public["userKeyTypes"],
   807	                }
   808	            )
   809	        for scenario_id in sorted(fixture.SCENARIO_FIXTURE_EVIDENCE):
   810	            server_id = fixture.SCENARIO_SERVER[scenario_id]
   811	            control = dispatch(
   812	                provider,
   813	                {
   814	                    "action": "control", "protocol": "relux-ssh-matrix-provider-v1",
   815	                    "scenarioId": scenario_id, "serverId": server_id,
   816	                },
   817	            )
   818	            if control.get("fixtureEvidenceCode") != fixture.SCENARIO_FIXTURE_EVIDENCE[scenario_id]:
   819	                raise ProviderError(f"{scenario_id} lifecycle control evidence drifted")
   820	    except Exception as error:
   821	        failure = error
   822	    teardown = []
   823	    for server_id in reversed(prepared):
   824	        response = dispatch(
   825	            provider,
   826	            {"action": "teardown", "protocol": "relux-ssh-matrix-provider-v1", "serverId": server_id},
   827	        )
   828	        teardown.append({"residualResources": response["residualResources"], "serverId": server_id})
   829	    if failure is not None:
   830	        raise failure
   831	    if any(row["residualResources"] != 0 for row in teardown):
   832	        raise ProviderError("provider lifecycle teardown left residual resources")
   833	    return {
   834	        "payloadRetention": "none",
   835	        "scenarioControls": sorted(fixture.SCENARIO_FIXTURE_EVIDENCE.values()),
   836	        "schemaVersion": 1,
   837	        "serverObservations": observations,
   838	        "taskId": fixture.TASK_ID,
   839	        "teardown": teardown,
   840	    }
