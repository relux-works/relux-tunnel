   314	private func malformedStructuralRecords(messageLength: UInt16) -> [MalformedStructuralRecord] {
   315	  let high = UInt8(truncatingIfNeeded: messageLength >> 8)
   316	  let low = UInt8(truncatingIfNeeded: messageLength)
   317	  return [
   318	    MalformedStructuralRecord(
   319	      name: "unknown ATYP",
   320	      record: Data([high, low, 0x0A, 0xFF]),
   321	      code: .unknownAddressType
   322	    ),
   323	    MalformedStructuralRecord(
   324	      name: "wrong IPv4 HDRLEN",
   325	      record: Data([high, low, 0x09, 0x01, 192, 0, 2, 1, 0, 53]),
   326	      code: .headerLengthMismatch
   327	    ),
   328	    MalformedStructuralRecord(
   329	      name: "truncated IPv4 address",
   330	      record: Data([high, low, 0x0A, 0x01, 192]),
   331	      code: .truncatedAddress
   332	    ),
   333	    MalformedStructuralRecord(
   334	      name: "truncated port",
   335	      record: Data([high, low, 0x0A, 0x01, 192, 0, 2, 1, 0]),
   336	      code: .truncatedPort
   337	    ),
   338	    MalformedStructuralRecord(
   339	      name: "zero port",
   340	      record: Data([high, low, 0x0A, 0x01, 192, 0, 2, 1, 0, 0]),
   341	      code: .invalidPort
   342	    ),
   343	    MalformedStructuralRecord(
   344	      name: "outer length mismatch",
   345	      record: Data([high, low, 0x0A, 0x01, 192, 0, 2, 1, 0, 53]),
   346	      code: .messageLengthMismatch
