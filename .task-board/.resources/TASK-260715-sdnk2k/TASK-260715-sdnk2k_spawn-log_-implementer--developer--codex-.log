+    lock.withLock { writes += 1 }
+    switch writeBehavior {
+    case .accept:
+      return bytes.count
+    case .zero:
+      return 0
+    case .error:
+      throw PumpFixtureError.injected
+    case .stall, .lateSuccessOnCancel:
