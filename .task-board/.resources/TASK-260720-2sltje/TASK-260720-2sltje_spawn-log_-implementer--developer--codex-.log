+
+    (void)session;
+    if(context->event_count < MAX_SERVER_KEX_EVENTS)
+        context->events[context->event_count++] = *status;
+    if(context->fail_on_server_kex_start &&
+       status->state == LIBSSH2_SERVER_KEX_STARTED)
