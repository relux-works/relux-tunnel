+    let pathCapacity = MemoryLayout.size(ofValue: address.sun_path)
+    guard path.count <= pathCapacity else { throw POSIXFixtureError.system(ENAMETOOLONG) }
+    withUnsafeMutablePointer(to: &address.sun_path) { pointer in
