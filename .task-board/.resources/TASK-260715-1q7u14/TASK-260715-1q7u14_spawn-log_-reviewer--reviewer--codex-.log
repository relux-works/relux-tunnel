   597	private func featureSet(_ names: [String]) -> RelayFeatureSet {
   598	  names.contains("dnsPriorityHint") ? [.dnsPriorityHint] : []
   599	}
   600	
   601	private func envelopeDirection(
   602	  _ raw: String,
   603	  vectorID: String
   604	) throws -> RelayEnvelopeDirection {
   605	  switch raw {
   606	  case "clientToRelay": .clientToRelay
   607	  case "relayToClient": .relayToClient
   608	  default:
   609	    throw RelayVectorHarnessFailure(vectorID: vectorID, reason: "invalid direction")
   610	  }
   611	}
   612	
   613	private func decodeHex(_ value: String, vectorID: String) throws -> Data {
   614	  guard value.count.isMultiple(of: 2) else {
   615	    throw RelayVectorHarnessFailure(vectorID: vectorID, reason: "odd hex width")
   616	  }
   617	  var result = Data()
   618	  result.reserveCapacity(value.count / 2)
   619	  var index = value.startIndex
   620	  while index < value.endIndex {
   621	    let end = value.index(index, offsetBy: 2)
   622	    guard let byte = UInt8(value[index..<end], radix: 16) else {
   623	      throw RelayVectorHarnessFailure(vectorID: vectorID, reason: "invalid hex")
   624	    }
   625	    result.append(byte)
   626	    index = end
   627	  }
   628	  return result
   629	}
   630	
   631	private func chunks(
   632	  of data: Data,
   633	  plan: [Int],
   634	  vectorID: String
   635	) throws -> [Data] {
   636	  let sizes = plan.isEmpty ? [data.count] : plan
   637	  guard sizes.allSatisfy({ $0 > 0 }), sizes.reduce(0, +) == data.count else {
   638	    throw RelayVectorHarnessFailure(vectorID: vectorID, reason: "invalid chunk plan")
   639	  }
   640	  var offset = 0
   641	  return sizes.map { size in
   642	    defer { offset += size }
   643	    return Data(data[offset..<(offset + size)])
   644	  }
   645	}
   646	
   647	private func require<T>(
   648	  _ value: T?,
   649	  _ vector: RelayProtocolVector,
   650	  _ reason: String
   651	) throws -> T {
   652	  guard let value else {
   653	    throw RelayVectorHarnessFailure(vectorID: vector.id, reason: reason)
   654	  }
   655	  return value
   656	}
   657	
