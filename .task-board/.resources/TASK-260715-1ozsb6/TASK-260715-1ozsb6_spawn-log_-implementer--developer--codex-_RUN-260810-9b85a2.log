+    initialReceiveWindowBytes: 64 * 1_024,
+    consumerReceiveWindowCredit: .unsupported,
+    maximumBufferedReadBytes: 16 * 1_024,
+    maximumQueuedWriteBytes: 32 * 1_024,
+    maximumWriteCallBytes: 8 * 1_024
