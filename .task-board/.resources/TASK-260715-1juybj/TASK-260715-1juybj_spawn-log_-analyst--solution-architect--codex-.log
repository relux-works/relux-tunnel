# 3. Project-local remote config
cat > task-board.config.json <<'JSON'
{
  "mode": "remote",
  "spawn": {
    "max_parallel": 20

exec
/bin/zsh -lc "sed -n '781,1040p' /Users/iv/.agents/skills/project-management/SKILL.md" in /Users/iv/Developer/relux-tunnel
 succeeded in 0ms:
  },
  "remote": {
    "url": "http://127.0.0.1:8091",
