   969	            index += 1
   970	            continue
   971	        if text.startswith("//", index):
   972	            newline = text.find("\n", index + 2)
   973	            index = len(text) if newline < 0 else newline + 1
   974	            continue
   975	        if text.startswith("/*", index):
   976	            index += 2
   977	            end = text.find("*/", index)
   978	            index = len(text) if end < 0 else end + 2
   979	            continue
   980	        if character in {'"', "'"} or (language == "go" and character == "`"):
