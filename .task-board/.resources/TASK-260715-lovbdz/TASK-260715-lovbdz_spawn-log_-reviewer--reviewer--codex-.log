  1049	  static func decodeVersioned<T: Decodable>(
  1050	    _ type: T.Type,
  1051	    from data: Data,
  1052	    maximumBytes: Int
  1053	  ) throws -> T {
  1054	    try StrictJSONValidator.validate(data, maximumBytes: maximumBytes)
  1055	    let header: RuntimeSchemaHeader = try decodeJSON(RuntimeSchemaHeader.self, from: data)
  1056	    guard header.schemaVersion == RuntimeMessageProtocol.currentSchemaVersion else {
  1057	      throw RuntimeMessageCodecError.unsupportedSchemaVersion(header.schemaVersion)
  1058	    }
  1059	    return try decodeJSON(type, from: data)
  1060	  }
