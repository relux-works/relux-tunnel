   568	
   569	func NewDatagramCodec(maximumPayloadLength uint16) (*DatagramCodec, *DatagramError) {
   570		if failure := validateDatagramMaximumPayloadLength(maximumPayloadLength); failure != nil {
   571			return nil, failure
   572		}
   573		return &DatagramCodec{maximumPayloadLength: maximumPayloadLength}, nil
   574	}
   575	
   576	func (c *DatagramCodec) MaximumPayloadLength() uint16 {
   577		return c.maximumPayloadLength
   578	}
   579	
   580	func (c *DatagramCodec) Metrics() DatagramCodecMetrics {
   581		return c.metrics
   582	}
   583	
   584	// ValidateDatagramEncodedLength computes and validates the exact HEV record
   585	// size before allocating an output buffer.
   586	func ValidateDatagramEncodedLength(
   587		endpoint DatagramEndpoint,
   588		dataLength uint64,
   589		maximumPayloadLength uint16,
   590	) (int, *DatagramError) {
   591		if failure := validateDatagramMaximumPayloadLength(maximumPayloadLength); failure != nil {
   592			return 0, failure
   593		}
   594		headerLength, failure := validateDatagramEndpoint(endpoint, DatagramPhaseEncoding)
   595		if failure != nil {
   596			return 0, failure
   597		}
   598		if dataLength > ^uint64(0)-uint64(headerLength) ||
   599			dataLength+uint64(headerLength) > uint64(maxInt()) {
   600			return 0, datagramEncodingFailure(DatagramArithmeticOverflow, DatagramPhaseEncoding)
   601		}
   602		if dataLength > uint64(MaxUDPPayloadRelayHardCeiling) {
   603			return 0, datagramEncodingFailure(
   604				DatagramMessageLengthExceedsProtocolLimit,
   605				DatagramPhaseData,
   606			)
   607		}
   608		if dataLength > uint64(maximumPayloadLength) {
   609			return 0, datagramEncodingFailure(
   610				DatagramMessageLengthExceedsLocalLimit,
   611				DatagramPhaseData,
   612			)
   613		}
   614		recordLength := dataLength + uint64(headerLength)
   615		if recordLength > uint64(MaxHEVRecordWidth) {
   616			return 0, datagramEncodingFailure(DatagramArithmeticOverflow, DatagramPhaseEncoding)
   617		}
   618		return int(recordLength), nil
   619	}
   620	
   621	func (c *DatagramCodec) Encode(datagram Datagram) ([]byte, *DatagramError) {
   622		recordLength, failure := ValidateDatagramEncodedLength(
   623			datagram.Endpoint,
   624			uint64(len(datagram.Data)),
   625			c.maximumPayloadLength,
   626		)
   627		if failure != nil {
   628			c.metrics.Failures++
   629			return nil, failure
   630		}
   631		headerLength := recordLength - len(datagram.Data)
   632		record := make([]byte, recordLength)
   633		binary.BigEndian.PutUint16(record[0:2], uint16(len(datagram.Data)))
   634		record[2] = byte(headerLength)
   635		record[3] = byte(datagram.Endpoint.Address.Type)
   636	
   637		addressOffset := 4
   638		if datagram.Endpoint.Address.Type == AddressTypeDomain {
   639			record[4] = byte(len(datagram.Endpoint.Address.Bytes))
   640			addressOffset++
   641		}
   642		addressEnd := addressOffset + len(datagram.Endpoint.Address.Bytes)
   643		copy(record[addressOffset:addressEnd], datagram.Endpoint.Address.Bytes)
   644		binary.BigEndian.PutUint16(record[addressEnd:addressEnd+HEVPortWidth], datagram.Endpoint.Port)
   645		copy(record[headerLength:], datagram.Data)
   646	
   647		c.metrics.EncodedRecords++
   648		c.metrics.EncodedBytes += uint64(len(record))
   649		return record, nil
   650	}
   651	
   652	// Decode validates one complete envelope payload. It validates HEV structure
   653	// before payload-limit policy and finishes every check before slicing or
   654	// allocating decoded bytes.
   655	func (c *DatagramCodec) Decode(record []byte) (Datagram, *DatagramError) {
   656		c.metrics.InputRecords++
   657		c.metrics.InputBytes += uint64(len(record))
   658		layout, failure := c.validateDatagramRecordLayout(record)
   659		if failure != nil {
   660			c.metrics.Failures++
   661			return Datagram{}, failure
   662		}
   663	
   664		addressBytes := append([]byte(nil), record[layout.addressOffset:layout.addressEnd]...)
   665		data := append([]byte(nil), record[layout.headerLength:]...)
   666		result := Datagram{
   667			Endpoint: DatagramEndpoint{
   668				Address: DatagramAddress{Type: layout.addressType, Bytes: addressBytes},
   669				Port:    layout.port,
   670			},
   671			Data: data,
   672		}
   673		c.metrics.DecodedRecords++
   674		c.metrics.DecodedMaterializedBytes += uint64(len(addressBytes) + len(data))
   675		return result, nil
   676	}
   677	
   678	type datagramRecordLayout struct {
   679		addressType   AddressType
   680		addressOffset int
   681		addressEnd    int
   682		headerLength  int
   683		port          uint16
   684	}
   685	
   686	func (c *DatagramCodec) validateDatagramRecordLayout(record []byte) (datagramRecordLayout, *DatagramError) {
   687		if len(record) < 4 {
   688			return datagramRecordLayout{}, datagramDecodingFailure(
   689				DatagramTruncatedFixedHeader,
   690				DatagramPhaseFixedHeader,
   691			)
   692		}
   693		messageLength := int(binary.BigEndian.Uint16(record[0:2]))
   694		headerLength := int(record[2])
   695		addressType := AddressType(record[3])
   696		if addressType != AddressTypeIPv4 && addressType != AddressTypeIPv6 && addressType != AddressTypeDomain {
   697			return datagramRecordLayout{}, datagramDecodingFailure(
   698				DatagramUnknownAddressType,
   699				DatagramPhaseAddress,
   700			)
   701		}
   702		addressOffset := 4
   703		addressLength := 0
   704		expectedHeaderLength := 0
   705		switch addressType {
   706		case AddressTypeIPv4:
   707			addressLength = 4
   708			expectedHeaderLength = HEVHDRLENIPv4
   709		case AddressTypeIPv6:
   710			addressLength = 16
   711			expectedHeaderLength = HEVHDRLENIPv6
   712		case AddressTypeDomain:
   713			if len(record) < 5 {
   714				return datagramRecordLayout{}, datagramDecodingFailure(
   715					DatagramTruncatedAddress,
   716					DatagramPhaseAddress,
   717				)
   718			}
   719			addressOffset = 5
   720			addressLength = int(record[4])
   721			if addressLength < MinDomainWireBytes || addressLength > MaxDomainWireBytes {
   722				return datagramRecordLayout{}, datagramDecodingFailure(
   723					DatagramInvalidAddressLength,
   724					DatagramPhaseAddress,
   725				)
   726			}
   727			expectedHeaderLength = HEVHDRLENDomainBase + addressLength
   728		}
   729		if headerLength != expectedHeaderLength {
   730			return datagramRecordLayout{}, datagramDecodingFailure(
   731				DatagramHeaderLengthMismatch,
   732				DatagramPhaseFixedHeader,
   733			)
   734		}
   735		addressEnd := addressOffset + addressLength
   736		if len(record) < addressEnd {
   737			return datagramRecordLayout{}, datagramDecodingFailure(
   738				DatagramTruncatedAddress,
