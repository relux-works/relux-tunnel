EST)\n+        exit_code, output, _, _, _ = run_selection_script(\n+            fixture_manifest(libssh2),\n+            \"Xcode_26.5.app\",\n+            \"Xcode 26.5\\nBuild version 17F420\\n\")\n+        self.assertNotEqual(exit_code, 0, output)\n+        self.assertIn(\"mismatch\", output)\n","final_result":true}}}
