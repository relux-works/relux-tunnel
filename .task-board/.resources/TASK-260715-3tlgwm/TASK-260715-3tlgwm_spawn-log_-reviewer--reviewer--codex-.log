      lifecycleState: .connecting,
      routeState: .notInstalled,
      tcp: false,
      safeDNS: false,
      udp: false,
      routeMode: .compatible,
      routesInstalled: false,
      healthy: false
    ),
    capabilities: RuntimeCapabilitySnapshot(
      runtimeGeneration: generation,
      snapshotSequence: sequence,
      tcp: false,
      safeDNS: false,
      udp: false,
      routeMode: .compatible,
      routesInstalled: false,
      healthy: false
    )
  )
}

