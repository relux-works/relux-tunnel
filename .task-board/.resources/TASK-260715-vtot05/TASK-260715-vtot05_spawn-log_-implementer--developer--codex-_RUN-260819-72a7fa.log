   908	def scan_runtime(config: dict[str, Any], root: Path = ROOT) -> None:
   909	    policy = config["runtimePolicy"]
   910	    validate_runtime_policy(policy)
   911	    extensions = set(policy["scanExtensions"])
   912	    excluded_suffixes = tuple(policy["excludedFileSuffixes"])
   913	    scanned_files = 0
   914	    for relative_root in policy["scanRoots"]:
   915	        scan_root = root / relative_root
   916	        if not scan_root.is_dir() or scan_root.is_symlink():
   917	            raise SupplyChainError(
   918	                f"runtime audit root is unavailable: {relative_root}"
   919	            )
   920	        resolved_scan_root = scan_root.resolve(strict=True)
   921	        for path in sorted(scan_root.rglob("*")):
   922	            if (
   923	                not path.is_file()
   924	                or path.is_symlink()
   925	                or path.suffix not in extensions
   926	                or path.name.endswith(excluded_suffixes)
   927	            ):
   928	                continue
   929	            resolved_path = path.resolve(strict=True)
   930	            if not resolved_path.is_relative_to(resolved_scan_root):
   931	                raise SupplyChainError(
   932	                    f"runtime audit source escapes its root: {path.relative_to(root)}"
   933	                )
   934	            try:
   935	                text = path.read_text(encoding="utf-8")
   936	            except (OSError, UnicodeDecodeError) as error:
   937	                raise SupplyChainError(
   938	                    f"runtime audit source is unreadable: {path.relative_to(root)}"
   939	                ) from error
   940	            scanned_files += 1
   941	            for label, pattern in FORBIDDEN_RUNTIME_PATTERNS:
   942	                for match in pattern.finditer(text):
   943	                    if label == "Foundation Data URL loader" and (
   944	                        LOCAL_FILE_DATA_READ_PATTERN.match(text, match.start())
   945	                    ):
   946	                        continue
   947	                    raise SupplyChainError(
   948	                        "application runtime code-download surface found "
   949	                        f"({label}): {path.relative_to(root)}"
   950	                    )
   951	    if scanned_files == 0:
   952	        raise SupplyChainError("runtime audit scanned no application source files")
