  1301	  private mutating func parseString() throws -> String {
  1302	    let start = index
  1303	    try consume(UInt8(ascii: "\""))
  1304	    while let byte = peek {
  1305	      index += 1
  1306	      if byte == UInt8(ascii: "\"") {
  1307	        let token = Data(bytes[start..<index])
  1308	        guard let decoded = try? JSONDecoder().decode(String.self, from: token) else {
  1309	          throw RuntimeMessageCodecError.corruptPayload
  1310	        }
  1311	        if requiresCanonicalStrings {
  1312	          let encoder = JSONEncoder()
  1313	          encoder.outputFormatting = [.withoutEscapingSlashes]
  1314	          guard let canonical = try? encoder.encode(decoded), canonical == token else {
  1315	            throw RuntimeMessageCodecError.corruptPayload
  1316	          }
  1317	        }
  1318	        return decoded
  1319	      }
  1320	      if byte < 0x20 { throw RuntimeMessageCodecError.corruptPayload }
  1321	      if byte == UInt8(ascii: "\\") {
  1322	        guard let escaped = peek else { throw RuntimeMessageCodecError.corruptPayload }
  1323	        index += 1
  1324	        if escaped == UInt8(ascii: "u") {
  1325	          for _ in 0..<4 {
  1326	            guard let hex = peek, isHex(hex) else {
  1327	              throw RuntimeMessageCodecError.corruptPayload
  1328	            }
  1329	            index += 1
  1330	          }
  1331	        } else if ![
  1332	          UInt8(ascii: "\""), UInt8(ascii: "\\"), UInt8(ascii: "/"),
  1333	          UInt8(ascii: "b"), UInt8(ascii: "f"), UInt8(ascii: "n"),
  1334	          UInt8(ascii: "r"), UInt8(ascii: "t"),
  1335	        ].contains(escaped) {
  1336	          throw RuntimeMessageCodecError.corruptPayload
  1337	        }
  1338	      }
  1339	    }
  1340	    throw RuntimeMessageCodecError.corruptPayload
  1341	  }
  1342	
  1343	  private mutating func parseNumber() throws {
  1344	    let start = index
  1345	    _ = consumeIf(UInt8(ascii: "-"))
  1346	    if consumeIf(UInt8(ascii: "0")) {
  1347	      if let next = peek, (UInt8(ascii: "0")...UInt8(ascii: "9")).contains(next) {
  1348	        throw RuntimeMessageCodecError.corruptPayload
  1349	      }
  1350	    } else {
  1351	      guard let first = peek, (UInt8(ascii: "1")...UInt8(ascii: "9")).contains(first) else {
  1352	        throw RuntimeMessageCodecError.corruptPayload
  1353	      }
  1354	      consumeDigits()
  1355	    }
  1356	    if consumeIf(UInt8(ascii: ".")) {
  1357	      guard let first = peek, (UInt8(ascii: "0")...UInt8(ascii: "9")).contains(first) else {
  1358	        throw RuntimeMessageCodecError.corruptPayload
  1359	      }
  1360	      consumeDigits()
  1361	    }
  1362	    if peek == UInt8(ascii: "e") || peek == UInt8(ascii: "E") {
  1363	      index += 1
  1364	      if peek == UInt8(ascii: "+") || peek == UInt8(ascii: "-") { index += 1 }
  1365	      guard let first = peek, (UInt8(ascii: "0")...UInt8(ascii: "9")).contains(first) else {
  1366	        throw RuntimeMessageCodecError.corruptPayload
  1367	      }
  1368	      consumeDigits()
  1369	    }
  1370	    if requiresCanonicalNumbers {
  1371	      let token = Data(bytes[start..<index])
  1372	      guard
  1373	        let number = try? JSONSerialization.jsonObject(
  1374	          with: token,
  1375	          options: .fragmentsAllowed
  1376	        ),
  1377	        let canonical = try? JSONSerialization.data(
  1378	          withJSONObject: number,
  1379	          options: [.fragmentsAllowed, .withoutEscapingSlashes]
  1380	        ),
  1381	        canonical == token
  1382	      else {
  1383	        throw RuntimeMessageCodecError.corruptPayload
  1384	      }
  1385	    }
  1386	  }
  1387	
  1388	  private mutating func consumeDigits() {
  1389	    while let byte = peek, (UInt8(ascii: "0")...UInt8(ascii: "9")).contains(byte) {
  1390	      index += 1
  1391	    }
  1392	  }
  1393	
  1394	  private mutating func consumeLiteral(_ literal: StaticString) throws {
  1395	    for byte in String(describing: literal).utf8 {
  1396	      try consume(byte)
  1397	    }
  1398	  }
  1399	
  1400	  private mutating func consume(_ expected: UInt8) throws {
  1401	    guard peek == expected else { throw RuntimeMessageCodecError.corruptPayload }
  1402	    index += 1
  1403	  }
  1404	
  1405	  private mutating func consumeIf(_ expected: UInt8) -> Bool {
  1406	    guard peek == expected else { return false }
  1407	    index += 1
  1408	    return true
  1409	  }
  1410	
  1411	  private mutating func skipWhitespace() {
  1412	    let start = index
  1413	    while let byte = peek,
  1414	      byte == UInt8(ascii: " ") || byte == UInt8(ascii: "\n")
  1415	        || byte == UInt8(ascii: "\r") || byte == UInt8(ascii: "\t")
  1416	    {
  1417	      index += 1
  1418	    }
  1419	    if index != start {
  1420	      sawInsignificantWhitespace = true
  1421	    }
  1422	  }
  1423	
  1424	  private var peek: UInt8? {
  1425	    index < bytes.count ? bytes[index] : nil
  1426	  }
  1427	
  1428	  private func isHex(_ byte: UInt8) -> Bool {
  1429	    (UInt8(ascii: "0")...UInt8(ascii: "9")).contains(byte)
  1430	      || (UInt8(ascii: "a")...UInt8(ascii: "f")).contains(byte)
  1431	      || (UInt8(ascii: "A")...UInt8(ascii: "F")).contains(byte)
  1432	  }
  1433	}
