    print(f'race_injected={raced}')
    print(f'stale_identity={stale_identity}')
    print(f'foreign_identity={foreign_identity}')
    print(f'foreign_marker_locations={marker_locations}')
    print(f'displaced_stale_survives={displaced_stale.exists()}')
    print(f'published_bundle_valid={m.validate_bundle(bundle, case.loaded_contract()) is not None}')
