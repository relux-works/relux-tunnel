case.setUp()
try:
    bundle = case.generated_bundle('existing-cleanup-race')
    (bundle / m.MANIFEST_NAME).write_bytes(b'stale')
    stale_identity = m.directory_identity(bundle, 'stale A')
    foreign_source = case.root / 'foreign-source'
    foreign_source.mkdir()
    marker_bytes = b'foreign marker must survive'
    (foreign_source / 'marker').write_bytes(marker_bytes)
    foreign_identity = m.directory_identity(foreign_source, 'foreign B')
    displaced_stale = case.root / 'displaced-stale-A'
    real_rmtree = m.shutil.rmtree
    raced = False

    def race_rmtree(path, *args, **kwargs):
        global raced
        target = Path(path)
        if not raced and target.name.startswith(f'.{bundle.name}.staging-'):
            raced = True
            target.rename(displaced_stale)
            foreign_source.rename(target)
        return real_rmtree(path, *args, **kwargs)

    race_rmtree.avoids_symlink_attacks = real_rmtree.avoids_symlink_attacks
    outcome = 'returned'
    try:
        with mock.patch.object(m.shutil, 'rmtree', new=race_rmtree):
            m.generate_bundle(case.archive, bundle, case.loaded_contract())
