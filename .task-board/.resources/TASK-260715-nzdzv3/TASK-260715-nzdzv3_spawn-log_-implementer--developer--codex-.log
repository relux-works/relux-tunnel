diff --git a/Dependencies/ReluxNIOSSH/Tests/NIOSSHTests/ReluxPolicyTests.swift b/Dependencies/ReluxNIOSSH/Tests/NIOSSHTests/ReluxPolicyTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..25bdb243409cd96df997013d05a8b9e2ec300d43
--- /dev/null
+++ b/Dependencies/ReluxNIOSSH/Tests/NIOSSHTests/ReluxPolicyTests.swift
@@ -0,0 +1,383 @@
+//===----------------------------------------------------------------------===//
+//
+// This source file is part of the SwiftNIO open source project
+//
+// Copyright (c) 2017-2026 Apple Inc. and the SwiftNIO project authors
+// Licensed under Apache License v2.0
+//
