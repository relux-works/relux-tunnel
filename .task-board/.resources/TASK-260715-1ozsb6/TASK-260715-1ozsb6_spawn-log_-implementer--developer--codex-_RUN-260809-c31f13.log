 public final class MacOSPacketFlowAdapter: PacketFlow, @unchecked Sendable {
diff --git a/Tests/ReluxTunnelCoreTests/ProviderAdapterContractTests.swift b/Tests/ReluxTunnelCoreTests/ProviderAdapterContractTests.swift
