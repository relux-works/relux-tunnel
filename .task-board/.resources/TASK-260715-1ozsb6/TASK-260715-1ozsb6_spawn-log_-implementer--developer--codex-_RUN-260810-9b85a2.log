  1704	private func withTimeout<Value: Sendable>(
  1705	  _ timeout: Duration,
  1706	  clock: any TunnelClock,
  1707	  operation: @escaping @Sendable () async throws -> Value
  1708	) async throws -> Value {
  1709	  let race = LibSSH2TimeoutRace<Value>()
