   593	  public func snapshot() async -> SSHTransportSnapshot {
   594	    await reconcileProtectedMetrics()
   595	    let counts = context.network.bufferedByteCounts
   596	    let direct = channels.values.filter { $0.kind == .directTCPIP && !$0.closed }.count
   597	    let exec = channels.values.filter { $0.kind == .exec && !$0.closed }.count
   598	    return SSHTransportSnapshot(
   599	      lane: lane,
   600	      connectionState: state,
   601	      negotiatedAlgorithms: negotiatedAlgorithms,
   602	      keyExchangeGeneration: .unsupported,
   603	      counters: counters,
   604	      gauges: SSHTransportGauges(
   605	        openDirectChannels: Int64(direct),
   606	        openExecChannels: Int64(exec),
   607	        pendingChannelOpens: Int64(pendingChannelOpens),
   608	        pendingReads: Int64(pendingReads.count),
   609	        pendingWrites: Int64(pendingWriteOperations),
   610	        queuedWriteBytes: Int64(pendingWriteBytes.values.reduce(0, +)),
   611	        bufferedReadBytes: Int64(counts.inbound),
   612	        remainingReceiveWindowBytes: .unsupported,
   613	        activeKeyExchange: .unsupported,
   614	        consecutiveKeepaliveMisses: .unsupported,
   615	        lastKeepaliveRTTNanoseconds: .unsupported
   616	      )
   617	    )
   618	  }
