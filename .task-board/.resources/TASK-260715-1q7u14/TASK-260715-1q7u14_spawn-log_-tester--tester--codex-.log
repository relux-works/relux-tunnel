+
+    dns_record = datagram_record(addresses["DOMAIN"]["value"], domain_typical, 53, b"dns")
+    dns_wire = envelope(messages["UDP_DATAGRAM"]["value"], dns_flag, 1, dns_record)
+    add(
+        "v1.envelope.udp-datagram-dns-priority",
