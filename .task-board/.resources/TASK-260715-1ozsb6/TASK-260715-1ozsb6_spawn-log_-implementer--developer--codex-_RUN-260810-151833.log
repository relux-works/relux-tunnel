+private final class ChannelAPIFaultController: @unchecked Sendable {
+  private struct State {
+    var rejectStartup = false
+    var closeEAGAINRemaining = 0
+    var freeEAGAINRemaining = 0
+    var closeCallCount = 0
+    var freeCallCount = 0
+  }
