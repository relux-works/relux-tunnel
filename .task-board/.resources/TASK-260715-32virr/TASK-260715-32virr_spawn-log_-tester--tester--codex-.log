   696	enum StartupOwnershipBoundary: String, CaseIterable, Sendable {
   697	  case beforeConfiguration
   698	  case afterConfiguration
   699	  case beforeSSH
   700	  case afterSSH
   701	  case beforeTCP
   702	  case afterTCP
   703	  case beforeDNS
   704	  case afterDNS
   705	  case beforePacketPlane
   706	  case afterPacketPlane
   707	  case beforeSettingsCommit
   708	  case afterSettingsCommit
   709	  case beforePacketReads
   710	  case afterPacketReads
   711	
   712	  var checkOrdinal: Int {
   713	    switch self {
   714	    case .beforeConfiguration: 2
   715	    case .afterConfiguration: 3
   716	    case .beforeSSH: 6
   717	    case .afterSSH: 7
   718	    case .beforeTCP: 10
   719	    case .afterTCP: 11
   720	    case .beforeDNS: 12
   721	    case .afterDNS: 13
   722	    case .beforePacketPlane: 14
   723	    case .afterPacketPlane: 15
   724	    case .beforeSettingsCommit: 21
   725	    case .afterSettingsCommit: 22
   726	    case .beforePacketReads: 24
   727	    case .afterPacketReads: 25
   728	    }
   729	  }
   730	
   731	  var expectedCleanup: [String] {
   732	    switch self {
   733	    case .beforeConfiguration, .afterConfiguration, .beforeSSH:
   734	      []
   735	    case .afterSSH, .beforeTCP:
   736	      ["ssh.close"]
   737	    case .afterTCP, .beforeDNS:
   738	      ["tcp.closeAdmission", "tcp.stop", "ssh.close"]
   739	    case .afterDNS, .beforePacketPlane:
   740	      [
   360	      throw TunnelRuntimeCoordinatorError.generationAlreadyConsumed
   361	    }
   362	    generationConsumed = true
   363	    state = .starting(.configuration)
   364	
   365	    let operation = Task { [weak self] in
   366	      guard let self else { throw CancellationError() }
   367	      try await self.runStartup()
   368	    }
   369	    startupTask = operation
   370	
   371	    do {
   372	      try await withTaskCancellationHandler {
   373	        await publishCurrentState()
   374	        try await operation.value
   375	      } onCancel: {
   376	        operation.cancel()
   377	      }
   378	      await startupCompletionHandoffHook?(self)
   379	      try checkCancellationAndOwnership(allowUsable: true)
   380	      startupTask = nil
   381	    } catch {
   382	      startupTask = nil
   383	      let thrownError = classifyStartupError(error)
   384	      await joinCleanup()
   385	      throw thrownError
   386	    }
   387	  }
   388	
   389	  public func stop(reason: ProviderStopReason) async {
   390	    if state == .failed {
   391	      if let cleanupTask {
   392	        await cleanupTask.value
   393	      }
   394	      return
   395	    }
   396	
   397	    if state == .disconnected {
   398	      if let cleanupTask {
   399	        await cleanupTask.value
   400	        return
   401	      }
   402	      guard !generationConsumed else { return }
   403	      generationConsumed = true
   404	      recordTermination(for: reason)
   405	      state = .stopping
   406	      await publishCurrentState()
   407	      await joinCleanup()
   408	      return
   409	    }
   410	
   411	    recordTermination(for: reason)
   412	
   413	    let operation = startupTask
   414	    operation?.cancel()
   415	    await transitionToStopping()
   416	    if let operation {
   417	      _ = await operation.result
   418	    }
   419	    await joinCleanup()
   420	  }
   421	
   422	  private func recordTermination(for reason: ProviderStopReason) {
   423	    guard termination == nil else { return }
   424	    switch reason {
   425	    case .startupFailure:
   426	      setFailure(Self.error(domain: .runtimeInvariant, code: "startup_failed"))
   427	    case .providerFailure:
   428	      setFailure(Self.error(domain: .runtimeInvariant, code: "provider_failure"))
   429	    case .userInitiated, .system, .platform:
   430	      termination = .stopped(reason)
   431	    }
   432	  }
   433	
   434	  public func lifecycleState() -> TunnelLifecycleState {
   435	    switch state {
   436	    case .disconnected:
   437	      .disconnected
   438	    case .starting:
   439	      .connecting
   440	    case .usableTCPDNS:
   441	      .connectedDegraded
   442	    case .stopping:
   443	      .disconnecting
   444	    case .failed:
   445	      .failed
   446	    }
   447	  }
   448	
   449	  public func coordinatorState() -> TunnelRuntimeCoordinatorState {
   450	    state
   451	  }
   452	
   453	  public func latestSnapshot() -> TunnelRuntimePublishedSnapshot? {
   454	    lastSnapshot
   455	  }
   456	
   457	  func resourceFootprint() -> TunnelRuntimeCoordinatorResourceFootprint {
   458	    TunnelRuntimeCoordinatorResourceFootprint(
   459	      retainsConfigurationReference: configurationReference != nil,
   460	      retainsConfigurationSnapshot: configurationSnapshot != nil,
   461	      retainsSSHSession: sshSession != nil,
   462	      retainsTCPConsumer: tcpConsumer != nil,
   463	      retainsDNSConsumer: dnsConsumer != nil,
   464	      retainsPacketPlane: packetPlane != nil,
   465	      settingsRequireClear: settingsState.requiresClear,
   466	      retainsStartupTask: startupTask != nil,
   467	      retainsCleanupTask: cleanupTask != nil
   468	    )
   469	  }
   470	
   471	  public func receive(_ event: TunnelRuntimeHealthEvent) async {
   472	    guard event.runtimeGeneration == runtimeGeneration else { return }
   473	    guard event.health == .unhealthy else { return }
   474	    guard state != .disconnected, state != .stopping, state != .failed else { return }
   475	
   476	    setFailure(Self.healthFailure(for: event.component))
   477	    startupTask?.cancel()
   478	    await transitionToStopping()
   479	
   480	    // A startup owner joins cleanup after its in-flight acquisition settles.
   481	    // Once usable, no acquisition is in flight and cleanup can begin now.
   482	    if startupTask == nil {
   483	      _ = beginCleanup()
   484	    }
   485	  }
   486	
   487	  private func runStartup() async throws {
   488	    try checkCancellationAndOwnership()
   489	    guard let reference = configurationReference else {
   490	      throw TunnelRuntimeCoordinatorError.startupFailed(
   491	        Self.error(domain: .configuration, code: "configuration_invalid")
   492	      )
   493	    }
   494	
   495	    configurationSnapshot = try await mapped(
   496	      fallback: Self.error(domain: .configuration, code: "configuration_invalid")
   497	    ) {
   498	      try await dependencies.configurationSource.loadValidatedSnapshot(for: reference)
   499	    }
   500	    try checkCancellationAndOwnership()
   501	    guard configurationSnapshot?.profileIdentifier == reference.profileIdentifier,
   502	      configurationSnapshot?.routeMode == .compatible
   503	    else {
   504	      throw TunnelRuntimeCoordinatorError.startupFailed(
   505	        Self.error(domain: .configuration, code: "configuration_invalid")
   506	      )
   507	    }
   508	
   509	    try await transitionDuringStartup(to: .sshAuthentication)
   510	    guard let configurationSnapshot else {
   511	      throw TunnelRuntimeCoordinatorError.startupFailed(
   512	        Self.error(domain: .runtimeInvariant, code: "resource_missing")
   513	      )
   514	    }
   515	    sshSession = try await mapped(
   516	      fallback: Self.error(domain: .sshTransport, code: "ssh_session_lost")
   517	    ) {
   518	      try await dependencies.sshBootstrap.authenticate(
   519	        configuration: configurationSnapshot,
   520	        runtimeGeneration: runtimeGeneration,
   521	        healthSink: self
   522	      )
   523	    }
   524	    try checkCancellationAndOwnership()
   525	
   526	    try await transitionDuringStartup(to: .consumers)
   527	    guard let sshSession else {
   528	      throw TunnelRuntimeCoordinatorError.startupFailed(
   529	        Self.error(domain: .runtimeInvariant, code: "resource_missing")
   530	      )
   531	    }
   532	    tcpConsumer = try await mapped(
   533	      fallback: Self.error(domain: .tcp, code: "tcp_flow_failed")
   534	    ) {
   535	      try await dependencies.tcpFactory.prepare(
   536	        session: sshSession,
   537	        runtimeGeneration: runtimeGeneration,
   538	        healthSink: self
   539	      )
   540	    }
   541	    try checkCancellationAndOwnership()
   542	
   543	    dnsConsumer = try await mapped(
   544	      fallback: Self.error(domain: .dns, code: "dns_upstream_timeout")
   545	    ) {
   546	      try await dependencies.dnsFactory.prepareSafeDNS(
   547	        session: sshSession,
   548	        runtimeGeneration: runtimeGeneration,
   549	        healthSink: self
   550	      )
   551	    }
   552	    try checkCancellationAndOwnership()
   553	
   554	    guard let tcpConsumer, let dnsConsumer else {
   555	      throw TunnelRuntimeCoordinatorError.startupFailed(
   556	        Self.error(domain: .runtimeInvariant, code: "resource_missing")
   557	      )
   558	    }
   559	    packetPlane = try await mapped(
   560	      fallback: Self.error(domain: .packetPlane, code: "packet_plane_failed")
   561	    ) {
   562	      try await dependencies.packetPlaneFactory.prepare(
   563	        configuration: configurationSnapshot,
   564	        tcp: tcpConsumer,
   565	        dns: dnsConsumer,
   566	        runtimeGeneration: runtimeGeneration,
   567	        healthSink: self
   568	      )
   569	    }
   570	    try checkCancellationAndOwnership()
   571	    try await requireMandatoryHealth()
   572	
   573	    let settingsPlan: any NetworkSettingsPlan
   574	    do {
   575	      settingsPlan = try dependencies.settingsPlanBuilder.makePlan(
   576	        configuration: configurationSnapshot,
   577	        connectedEndpoint: sshSession.connectedEndpoint,
   578	        runtimeGeneration: runtimeGeneration
   579	      )
   580	    } catch {
   581	      throw map(error, fallback: Self.error(domain: .networkSettings, code: "settings_invalid"))
   582	    }
   583	
   584	    try await transitionDuringStartup(to: .networkSettings)
   585	    settingsState = .uncertain
   586	    do {
   587	      try await dependencies.settingsApplier.apply(
   588	        settingsPlan,
   589	        runtimeGeneration: runtimeGeneration
   590	      )
   591	      settingsState = .committed
   592	    } catch {
   593	      if let described = error as? any NetworkSettingsCommitDescribingError {
   594	        switch described.commitDisposition {
   595	        case .notCommitted:
   596	          settingsState = .notRequested
   597	        case .committed:
   598	          settingsState = .committed
   599	        case .uncertain:
   600	          settingsState = .uncertain
   601	        }
   602	      }
   603	      throw map(
   604	        error,
   605	        fallback: Self.error(domain: .networkSettings, code: "network_settings_apply_failed")
   606	      )
   607	    }
   608	    try checkCancellationAndOwnership()
   609	
   610	    try await transitionDuringStartup(to: .packetReads)
   611	    guard let packetPlane else {
   612	      throw TunnelRuntimeCoordinatorError.startupFailed(
   613	        Self.error(domain: .runtimeInvariant, code: "resource_missing")
   614	      )
   615	    }
   616	    do {
   617	      try await packetPlane.activateReads(packetFlow: packetFlow)
   618	    } catch {
   619	      throw map(
   620	        error,
   621	        fallback: Self.error(domain: .packetPlane, code: "packet_plane_failed")
   622	      )
   623	    }
   624	    try checkCancellationAndOwnership()
   625	    try await requireMandatoryHealth()
   626	    try checkCancellationAndOwnership()
   627	
   628	    state = .usableTCPDNS
   629	    await publishCurrentState()
   630	    try checkCancellationAndOwnership(allowUsable: true)
   631	  }
   632	
   633	  private func transitionDuringStartup(to phase: TunnelRuntimeStartupPhase) async throws {
   634	    try checkCancellationAndOwnership()
   635	    state = .starting(phase)
   636	    await publishCurrentState()
   637	    try checkCancellationAndOwnership()
   638	  }
