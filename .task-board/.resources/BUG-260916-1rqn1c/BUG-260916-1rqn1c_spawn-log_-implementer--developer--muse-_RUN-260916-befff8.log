ential-free-legacy.XXXXXX\")\n45|legacy_fixture=\"$legacy_work_root/legacy-v0.1.0\"\n46|cleanup() {\n47|  case \"$legacy_work_root\" in\n48|    \"${TMPDIR:-/tmp}\"/relux-credential-free-legacy.*)\n49|      chmod -R u+w \"$legacy_work_root\" 2>/dev/null || true\n50|      rm -rf \"$legacy_work_root\"\n51|      ;;\n52|    *)\n53|      echo \"warning: refusing to clean unexpected legacy work path: $legacy_work_root\" >&2\n54|      ;;\n55|  esac\n56|}\n57|trap cleanup EXIT INT TERM\n58|\n59|require_command() {\n60|  if ! command -v \"$1\" >/dev/null 2>&1; then\n61|    echo \"error: required command is unavailable: $1\" >&2\n62|    exit 2\n63|  fi\n64|}\n65|\n66|for command in curl git make mise plutil python3 shasum swift xcodebuild xcrun; do\n67|  require_command \"$command\"\n68|done\n69|if [ \"$(uname -s)\" != Darwin ]; then\n70|  echo \"error: credential-free generated-project validation requires macOS\" >&2\n71|  exit 2\n72|fi\n73|if [ ! -d \"$legacy_root/.git\" ]; then\n74|  echo \"error: expected a legacy Git checkout at $legacy_root\" >&2\n75|  echo \"Clone relux-works/relux-proxy with tags, or pass --legacy-root PATH.\" >&2\n76|  exit 2\n77|fi\n78|\n79|run_step() {\n80|  name=$1\n81|  shift\n82|  log=\"$logs/$name.log\"\n83|  printf 'RUN: %s\\n' \"$name\" | tee -a \"$summary\"\n84|  if \"$@\" >\"$log\" 2>&1; then\n85|    printf 'PASS: %s (log: %s)\\n' \"$name\" \"${log#\"$repo_root\"/}\" | tee -a \"$summary\"\n86|  else\n87|    status=$?\n88|    printf 'FAIL: %s (exit %s; log: %s)\\n' \\\n89|      \"$name\" \"$status\" \"${log#\"$repo_root\"/}\" | tee -a \"$summary\" >&2\n90|    tail -n 80 \"$log\" >&2\n91|    exit \"$status\"\n92|  fi\n93|}\n94|\n95|source_revision=$(git rev-parse HEAD)\n96|source_date_epoch=$(git show -s --format=%ct HEAD)\n97|marketing_version=$(sed -n 's/^MARKETING_VERSION = //p' Configuration/Versions.xcconfig)\n98|if [ -n \"$(git status --porcelain=v1 --untracked-files=normal -- . ':!.task-board' ':!.temp')\" ]; then\n99|  source_worktree_state=dirty\n100|else\n101|  source_worktree_state=clean\n102|fi\n103|\n104|run_step relay-tool-bootstrap ./scripts/bootstrap-relay-tools.sh\n105|\n106|relay_go=\"$repo_root/.build/relay/toolchains/go1.26.5-$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m | sed -e 's/^x86_64$/amd64/' -e 's/^aarch64$/arm64/')/go/bin/go\"\n107|relay_syft=\"$repo_root/.build/relay/toolchains/syft1.48.0-$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m | sed -e 's/^x86_64$/amd64/' -e 's/^aarch64$/arm64/')/syft\"\n108|\n109|{\n110|  echo \"source_revision=$source_revision\"\n111|  echo \"source_date_epoch=$source_date_epoch\"\n112|  echo \"source_worktree_state=$source_worktree_state\"\n113|  echo \"host=$(sw_vers -productName) $(sw_vers -productVersion) ($(uname -m))\"\n114|  echo \"xcode=$(xcodebuild -version | tr '\\n' ';' | sed 's/;$//')\"\n115|  echo \"swift=$(swift --version 2>&1 | head -n 1)\"\n116|  echo \"mise=$(mise --version | head -n 1)\"\n117|  echo \"tuist=$(mise exec -- tuist version | head -n 1)\"\n118|  echo \"go=$($relay_go version)\"\n119|  echo \"syft=$($relay_syft version | sed -n 's/^Version:[[:space:]]*//p')\"\n120|  echo \"macos_deployment_target=$(sed -n 's/^MACOSX_DEPLOYMENT_TARGET = //p' Configuration/Base.xcconfig)\"\n121|  echo \"ios_deployment_target=$(sed -n 's/^IPHONEOS_DEPLOYMENT_TARGET = //p' Configuration/Base.xcconfig)\"\n122|  echo \"invoked_schemes=ReluxProxyMac(Debug,Release,test),ReluxProxyMacTunnel(Debug,Release)\"\n123|  echo \"sdk_inventory_begin\"\n124|  xcodebuild -showsdks\n125|  echo \"sdk_inventory_end\"\n126|} > \"$metadata\"\n127|\n128|run_step relay-packaging env \\\n129|  RELAY_VERSION=\"$marketing_version\" \\\n130|  SOURCE_COMMIT=\"$source_revision\" \\\n131|  SOURCE_DATE_EPOCH=\"$source_date_epoch\" \\\n132|  make relay-shell-validate\n133|run_step validation-contract-tests ./scripts/tests/test-credential-free-validation.sh\n134|run_step deterministic-generation ./scripts/validate-workspace-foundation.sh\n135|run_step macos-target-builds-and-contracts ./scripts/validate-macos-targets.sh\n136|run_step core-boundaries ./scripts/check-core-boundaries.sh\n137|run_step swift-testing swift test\n138|run_step swift-release-build swift build -c release\n139|run_step native-packaging make check-native-dependencies test-native-dependencies\n140|\n141|run_step legacy-clone git clone --quiet --local --no-hardlinks \"$legacy_root\" \"$legacy_fixture\"\n142|run_step legacy-checkout git -C \"$legacy_fixture\" checkout --quiet \"$expected_legacy_commit\"\n143|run_step legacy-preservation ./scripts/check-legacy-preservation.sh \\\n144|  --legacy-root \"$legacy_fixture\" --workspace-root \"$repo_root\"\n145|run_step legacy-guard-tests ./scripts/tests/test-legacy-preservation-guard.sh \\\n146|  --legacy-root \"$legacy_fixture\"\n147|run_step legacy-swift-test swift test --package-path \"$legacy_fixture\"\n148|run_step legacy-swift-release-build swift build -c release --package-path \"$legacy_fixture\"\n149|\n150|{\n151|  echo \"NOT RUN: production signing, physical Gate P0, Developer ID archive, notarization, and DMG publication require credentials or belong to downstream release gates.\"\n152|  echo \"NOT RUN: ReluxProxyIOS and ReluxProxyIOSTunnel are deferred by ADR-024/ADR-027 and must remain absent from the macOS-only graph.\"\n153|  echo \"PASS: credential-free generated-project validation\"\n154|  echo \"metadata: ${metadata#\"$repo_root\"/}\"\n155|  echo \"logs: ${logs#\"$repo_root\"/}\"\n156|} | tee -a \"$summary\"","final_result":true}}}
