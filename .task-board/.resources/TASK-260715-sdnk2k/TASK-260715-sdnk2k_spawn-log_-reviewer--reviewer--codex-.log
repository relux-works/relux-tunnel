   499	enum PumpCancellationSite: String, CaseIterable, Sendable {
   500	  case localReadable
   501	  case localWritable
   502	  case sshRead
   503	  case sshWrite
   504	  case fairnessYield
   505	
   506	  var direction: BytePumpDirection {
   507	    switch self {
   508	    case .localReadable, .sshWrite, .fairnessYield:
   509	      .localToSSH
   510	    case .localWritable, .sshRead:
   511	      .sshToLocal
   512	    }
   513	  }
   514	}
   515	
   516	enum PumpFailureSite: String, CaseIterable, Sendable {
   517	  case localRead
   518	  case sshWrite
   519	  case sshRead
   520	  case localWrite
   521	  case sshRemoteClosure
   522	
   523	  var direction: BytePumpDirection {
   524	    switch self {
   525	    case .localRead, .sshWrite:
   526	      .localToSSH
   527	    case .sshRead, .localWrite, .sshRemoteClosure:
   528	      .sshToLocal
   529	    }
   530	  }
   531	
   532	  var expectedReason: BytePumpTerminalReason {
   533	    switch self {
   534	    case .localRead, .sshRead:
   535	      .readError
   536	    case .sshWrite, .localWrite:
   537	      .writeError
   538	    case .sshRemoteClosure:
   539	      .remoteClosure
   540	    }
   541	  }
   542	}
