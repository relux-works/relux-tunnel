   409	def main(argv: list[str] | None = None) -> int:
   410	    parser = argparse.ArgumentParser()
   411	    parser.add_argument(
   412	        "--manifest",
   413	        type=Path,
   414	        default=Path("Configuration/TASK-260720-1qhxqa_m0-production-bindings-v1.json"),
   415	    )
   416	    parser.add_argument("--resources-root", type=Path, required=True)
   417	    parser.add_argument("--repository-root", type=Path, default=Path("."))
   418	    parser.add_argument("--board-state", type=Path, required=True)
   419	    parser.add_argument("--report", type=Path)
   420	    arguments = parser.parse_args(argv)
   421	    report = validate(
   422	        arguments.manifest.resolve(),
   423	        arguments.resources_root.resolve(),
   424	        arguments.repository_root.resolve(),
   425	        arguments.board_state.resolve(),
   426	    )
   427	    encoded = json.dumps(report, indent=2, sort_keys=True) + "\n"
   428	    if arguments.report:
   429	        arguments.report.parent.mkdir(parents=True, exist_ok=True)
   430	        arguments.report.write_text(encoded, encoding="utf-8")
   431	    sys.stdout.write(encoded)
   432	    return 0 if report["productionCompositionPermitted"] else 1
   433	
   434	
   435	if __name__ == "__main__":
   436	    raise SystemExit(main())
