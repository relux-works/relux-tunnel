diff --git a/Tests/ReluxTunnelLibSSH2AdapterTests/SSHTransportConformanceTests.swift b/Tests/ReluxTunnelLibSSH2AdapterTests/SSHTransportConformanceTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..815f04c2464a4def13d758485448ff857946f1e7
