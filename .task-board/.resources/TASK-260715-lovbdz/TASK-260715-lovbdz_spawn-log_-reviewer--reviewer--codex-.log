  1132	        maximumDepth: RuntimeMessageProtocol.maximumNestingDepth
  1133	      )
  1134	    }
  1135	    guard let current = peek else { throw RuntimeMessageCodecError.corruptPayload }
  1136	    switch current {
  1137	    case UInt8(ascii: "{"):
  1138	      _ = try parseObject(depth: depth)
  1139	    case UInt8(ascii: "["):
  1140	      try parseArray(depth: depth)
  1141	    case UInt8(ascii: "\""):
  1142	      _ = try parseString()
