   909	      hostKey: method(Int32(LIBSSH2_METHOD_HOSTKEY)),
   910	      cipherClientToServer: method(Int32(LIBSSH2_METHOD_CRYPT_CS)),
   911	      cipherServerToClient: method(Int32(LIBSSH2_METHOD_CRYPT_SC)),
   912	      macClientToServer: method(Int32(LIBSSH2_METHOD_MAC_CS)),
   913	      macServerToClient: method(Int32(LIBSSH2_METHOD_MAC_SC))
