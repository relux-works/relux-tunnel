   393	    let captured = try loader.capture(from: firstConfiguration, startRequest: startRequest)
   394	    #expect(captured == first)
   395	    #expect(try loader.capture(from: firstConfiguration, startRequest: startRequest) == captured)
   396	
   397	    let staleRequest = RuntimeStartRequest(
   398	      configurationGeneration: 8,
   399	      snapshotDigestSHA256: startRequest.snapshotDigestSHA256
   400	    )
   401	    #expect(throws: SSHProfileSnapshotLoaderError.profileGenerationMismatch) {
   402	      try SSHProfileRuntimeSnapshotLoader().capture(
