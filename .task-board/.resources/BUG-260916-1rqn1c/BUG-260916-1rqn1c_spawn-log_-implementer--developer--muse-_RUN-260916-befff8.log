,\\n388:        f\\\"-DCMAKE_OSX_DEPLOYMENT_TARGET={build['target_triple'].split('ios')[-1].split('-')[0] if 'ios' in build['target_triple'] else build['target_triple'].split('macos')[-1]}\\\",\\n396:    run(command, environment=build_environment())\\n398:        [\\\"cmake\\\", \\\"--build\\\", str(build_dir), \\\"--parallel\\\"],\\n399:        environment=build_environment(),\\n401:    archive = build_dir / \\\"src\\\" / \\\"libssh2.a\\\"\\n403:        raise ForkError(f\\\"libssh2 build did not produce {archive}\\\")\\n425:def build_xcframework(\\n429:    with tempfile.TemporaryDirectory(prefix=\\\"relux-libssh2-build-\\\") as temporary:\\n441:            for build in slice_[\\\"builds\\\"]:\\n442:                openssl_install = build_openssl(\\n443:                    item, openssl_source, build, work, slice_[\\\"sdk\\\"]\\n445:                libssh2 = build_libssh2(\\n446:                    item, patched, openssl_install, build, work, slice_[\\\"sdk\\\"]\\n449:                    f\\\"libReluxLibSSH2-{slice_['sdk']}-{build['architecture']}.a\\\"\\n463:                    environment=build_environment(),\\n489:                \\\"xcodebuild\\\",\\n518:def verify_xcode_build(item: dict[str, Any]) -> None:\\n519:    output = run([\\\"xcodebuild\\\", \\\"-version\\\"], capture=True)\\n520:    expected = f\\\"Build version {item['compiler']['xcode_build']}\\\"\\n522:        raise ForkError(f\\\"Xcode build mismatch: expected {expected}, got {output.strip()}\\\")\\n527:    verify_xcode_build(item)\\n786:    build = subparsers.add_parser(\\\"build-xcframework\\\")\\n787:    build.add_argument(\\\"--libssh2-archive\\\", type=Path, required=True)\\n788:    build.add_argument(\\\"--openssl-archive\\\", type=Path, required=True)\\n789:    build.add_argument(\\\"--output\\\", type=Path, required=True)\\n790:    build.add_argument(\\\"--notices\\\", type=Path)\\n823:    elif arguments.command == \\\"build-xcframework\\\":\\n827:        build_xcframework(\\n===== lines =====\\n     864 scripts/libssh2-fork-tool.py\\n     768 scripts/native-dependency-tool.py\\n    1632 total\\n\",\n  \"original_output_bytes\": 2850,\n  \"original_output_tokens\": 713,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
