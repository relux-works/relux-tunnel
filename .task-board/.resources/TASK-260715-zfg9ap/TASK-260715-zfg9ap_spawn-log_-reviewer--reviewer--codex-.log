   369	      State(
   370	        sessionHealth: initialSessionHealth,
   371	        nextID: initialReservationIdentifierForTesting
   372	      )
   373	    )
   374	    self.diagnostics = diagnostics
   375	    state.withLock { emitGauges($0) }
   376	  }
