exec
/bin/zsh -lc "python3 - <<'PY'
import hashlib
import plistlib
import re
import subprocess
from pathlib import Path

text = subprocess.check_output(['/usr/sbin/system_profiler', 'SPHardwareDataType'], text=True)
match = re.search(r'"'^'"\\s*Provisioning UDID:\\s*(\\S+)\\s*"'$'"', text, re.MULTILINE)
if not match:
    raise SystemExit('Provisioning UDID unavailable')
current = match.group(1)
with Path('.inspection/host.plist').open('rb') as stream:
    profile = plistlib.load(stream)
devices = profile.get('ProvisionedDevices', [])
print('current_mac_ref=sha256:' + hashlib.sha256(current.encode()).hexdigest()[:12])
print('provisioned_device_count=' + str(len(devices)))
print('contains_current_mac=' + str(current in devices).lower())
print('profile_device_refs=' + ','.join('sha256:' + hashlib.sha256(item.encode()).hexdigest()[:12] for item in devices))
