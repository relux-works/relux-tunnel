   523	  private func exerciseDirectTCPIP(transport: LibSSH2Transport, echoPort: UInt16) async throws {
   524	    let channel = try await transport.openDirectTCPIP(
   525	      destination: TunnelEndpoint(host: "127.0.0.1", port: echoPort),
   526	      originator: TunnelEndpoint(host: "127.0.0.1", port: 41_414),
   527	      policy: try fixtureChannelPolicy()
   528	    )
   529	    let payload = Data("direct-tcpip-echo".utf8)
   530	    var written = 0
   531	    while written < payload.count {
   532	      written += try await channel.writeSome(Data(payload[written...]))
   533	    }
   534	    var received = Data()
   535	    while received.count < payload.count {
   536	      let next = try #require(try await channel.read(maximumBytes: payload.count - received.count))
   537	      received.append(next)
   538	    }
   539	    #expect(received == payload)
   540	    #expect(await channel.receiveWindow() == .unsupported)
   540	    #expect(await channel.receiveWindow() == .unsupported)
   541	    await channel.close()
   542	  }
