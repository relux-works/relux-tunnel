   568	def scan_runtime(config: dict[str, Any], root: Path = ROOT) -> None:
   569	    policy = config["runtimePolicy"]
   570	    extensions = set(policy["scanExtensions"])
   571	    for relative_root in policy["scanRoots"]:
   572	        scan_root = root / relative_root
   573	        if not scan_root.exists():
   574	            continue
   575	        for path in sorted(scan_root.rglob("*")):
   576	            if not path.is_file() or path.suffix not in extensions:
   577	                continue
   578	            text = path.read_text(encoding="utf-8")
   579	            for pattern in FORBIDDEN_RUNTIME_PATTERNS:
   580	                if pattern.search(text):
   581	                    raise SupplyChainError(
   582	                        f"application runtime code-download surface found: {path.relative_to(root)}"
   583	                    )
