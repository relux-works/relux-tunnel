+            return true
+          } catch SSHProfileSnapshotLoaderError.profileGenerationMismatch {
+            return false
+          } catch {
+            return false
+          }
+        }
+      }
+      var values: [Bool] = []
+      for await value in group { values.append(value) }
+      return values
+    }
+    #expect(results.filter { $0 }.count == 1)
