+  let indexDirectory = taskDirectory.appendingPathComponent(
+    "candidate-index-\(UUID().uuidString)",
+    isDirectory: true
+  )
+  do {
+    try FileManager.default.createDirectory(
+      at: indexDirectory,
+      withIntermediateDirectories: true
+    )
+  } catch {
