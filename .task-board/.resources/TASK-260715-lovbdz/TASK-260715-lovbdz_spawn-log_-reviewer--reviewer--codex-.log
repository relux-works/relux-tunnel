   808	    case .excessiveNesting: .excessiveNesting
   809	    case .duplicateKey: .duplicateKey
   810	    case .unsupportedProtocolVersion: .unsupportedProtocolVersion
   811	    case .unsupportedSchemaVersion: .unsupportedSchemaVersion
   812	    case .unsupportedKind: .unsupportedKind
   813	    case .unsupportedValue: .unsupportedValue
   814	    }
   815	  }
