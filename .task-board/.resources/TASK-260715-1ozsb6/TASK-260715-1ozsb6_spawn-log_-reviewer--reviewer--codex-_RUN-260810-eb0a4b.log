  1348	  private func directTCPIPMessage(
  1349	    destination: TunnelEndpoint,
  1350	    originator: TunnelEndpoint
  1351	  ) -> Data {
  1352	    var data = Data()
  1353	    appendSSHString(destination.host, to: &data)
  1354	    appendUInt32(UInt32(destination.port), to: &data)
  1355	    appendSSHString(originator.host, to: &data)
  1356	    appendUInt32(UInt32(originator.port), to: &data)
  1357	    return data
  1358	  }
  1359	
  1360	  private func appendSSHString(_ value: String, to data: inout Data) {
  1361	    let bytes = Data(value.utf8)
  1362	    appendUInt32(UInt32(clamping: bytes.count), to: &data)
  1363	    data.append(bytes)
  1364	  }
  1365	
  1366	  private func appendUInt32(_ value: UInt32, to data: inout Data) {
  1367	    var bigEndian = value.bigEndian
  1368	    withUnsafeBytes(of: &bigEndian) { data.append(contentsOf: $0) }
  1369	  }
