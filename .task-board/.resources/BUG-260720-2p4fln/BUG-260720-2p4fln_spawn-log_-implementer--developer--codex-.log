   238	    var acceptedSessions = 0
   239	
   240	    for iteration in 0..<100 {
   241	      let descriptorBaseline = openDescriptorCount()
   242	      let harness = RealHEVBridgeHarness(adapterMode: .stallAfterAuthentication)
