diff --git a/NativeDependencies/manifest.json b/NativeDependencies/manifest.json
new file mode 100644
index 0000000000000000000000000000000000000000..0aca17ea25948d1c3b20c6f6e35e18c4fd89f5e3
--- /dev/null
+++ b/NativeDependencies/manifest.json
@@ -0,0 +1,146 @@
+{
+  "schema_version": 1,
+  "cache_policy": {
+    "environment_variable": "RELUX_NATIVE_CACHE_DIR",
+    "default_under_tmpdir": "relux-native-dependencies",
+    "key_fields": [
+      "dependency",
+      "revision",
+      "source_sha256",
+      "xcode_build",
+      "compiler_flags"
+    ],
+    "runtime_downloads_allowed": false,
+    "cache_is_authoritative": false,
+    "mismatch_policy": "delete the keyed entry and rebuild only after source verification passes"
+  },
+  "dependencies": {
+    "relux-native-fixture": {
+      "revision": "relux-native-fixture-1",
+      "source": {
+        "kind": "repository_files",
+        "files": [
+          "NativeDependencies/Fixtures/ReluxNativeFixture/LICENSE",
+          "NativeDependencies/Fixtures/ReluxNativeFixture/Sources/relux_native_fixture.c",
+          "NativeDependencies/Fixtures/ReluxNativeFixture/include/module.modulemap",
+          "NativeDependencies/Fixtures/ReluxNativeFixture/include/relux_native_fixture.h"
+        ],
+        "sha256": "7b60fe3e2c3be07eea15cfcb331474318d950315e73c2a423bc6ff0e297b015d"
+      },
+      "integration": {
+        "swiftpm_kind": "binaryTarget",
+        "target_name": "CReluxNativeFixture",
+        "linkage": "static",
+        "artifact_path": "NativeDependencies/Artifacts/ReluxNativeFixture.xcframework",
+        "application_extension_api_only": true
+      },
+      "compiler": {
+        "tool": "xcrun --sdk <sdk> clang",
+        "common_c_flags": [
+          "-Os",
+          "-Wall",
+          "-Wextra",
+          "-Werror",
+          "-fapplication-extension",
+          "-ffunction-sections",
+          "-fdata-sections",
+          "-fno-common",
+          "-fno-ident"
+        ],
+        "slices": [
+          {
+            "library_identifier": "ios-arm64",
+            "platform": "ios",
+            "sdk": "iphoneos",
+            "minimum": "18.0",
+            "architectures": ["arm64"],
+            "target_triples": ["arm64-apple-ios18.0"]
+          },
+          {
+            "library_identifier": "ios-arm64_x86_64-simulator",
+            "platform": "ios",
+            "variant": "simulator",
+            "sdk": "iphonesimulator",
+            "minimum": "18.0",
+            "architectures": ["arm64", "x86_64"],
+            "target_triples": [
+              "arm64-apple-ios18.0-simulator",
+              "x86_64-apple-ios18.0-simulator"
+            ]
+          },
+          {
+            "library_identifier": "macos-arm64_x86_64",
+            "platform": "macos",
+            "sdk": "macosx",
+            "minimum": "15.0",
+            "architectures": ["arm64", "x86_64"],
+            "target_triples": [
+              "arm64-apple-macos15.0",
+              "x86_64-apple-macos15.0"
+            ]
+          }
+        ]
+      },
+      "license": {
+        "spdx": "MIT",
+        "files": ["NativeDependencies/Fixtures/ReluxNativeFixture/LICENSE"],
+        "notices_output": "NativeDependencies/THIRD_PARTY_NOTICES.txt"
+      },
+      "rebuild": {
