+    try requirePin(sshPins, "binaryTarget", "ReluxLibSSH2")
+    try requirePin(
+      sshPins,
+      "libssh2Commit",
+      "a34302491c164d53c900fec9b3cbb050ecebe719"
+    )
+    try requirePin(
+      sshPins,
