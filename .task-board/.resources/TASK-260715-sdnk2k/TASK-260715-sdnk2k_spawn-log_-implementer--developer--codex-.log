+    #expect(throws: BytePumpConfigurationError.nonPositive(.localReadChunkBytes)) {
+      _ = try pumpConfiguration(localChunk: 0)
+    }
+    #expect(throws: BytePumpConfigurationError.perFlowReservationExceedsAggregate(
+      perFlow: 17,
+      aggregate: 16
