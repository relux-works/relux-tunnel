  2106	    // state locally so its destructors cannot remain parked behind a stale
  2107	    // partially-sent packet. No abort-drain byte reaches the network.
  2108	    context.network.beginAbortDrain()
  2109	    await waitForChannelOpensToDrain()
  2110	    await waitForSessionOperationsToDrain()
  2111	    let ownedOperationDrainDeadline = min(
  2112	      deadline,
  2113	      dependencies.clock.now().advanced(by: .milliseconds(100))
  2114	    )
  2115	    _ = await asyncOperations.waitForAll(
  2116	      until: ownedOperationDrainDeadline,
  2117	      clock: dependencies.clock
  2118	    )
  2119	    for identity in Array(channels.keys) {
