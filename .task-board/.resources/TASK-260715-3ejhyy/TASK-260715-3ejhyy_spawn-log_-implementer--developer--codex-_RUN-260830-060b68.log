   223	public enum HarnessArgumentParser {
   224	  public static func parse(
   225	    arguments: [String],
   226	    registeredCommands: [String]
   227	  ) throws -> HarnessInvocation {
   228	    guard let command = arguments.first else {
   229	      throw HarnessArgumentError.missingCommand
   230	    }
   231	    guard registeredCommands.contains(command) else {
   232	      throw HarnessArgumentError.unknownCommand(command)
   233	    }
   234	
   235	    var configuration: HarnessConfigurationInput?
   236	    var index = 1
   237	    while index < arguments.count {
   238	      let option = arguments[index]
   239	      guard option == "--configuration" || option == "--configuration-json" else {
   240	        throw HarnessArgumentError.unexpectedArgument(option)
   241	      }
   242	      guard configuration == nil else {
   243	        throw HarnessArgumentError.duplicateConfiguration
   244	      }
   245	      let valueIndex = index + 1
   246	      guard valueIndex < arguments.count else {
   247	        throw HarnessArgumentError.missingOptionValue(option)
   248	      }
   249	      let value = arguments[valueIndex]
   250	      configuration = option == "--configuration" ? .file(value) : .json(value)
   251	      index += 2
   252	    }
   253	
   254	    guard let configuration else {
   255	      throw HarnessArgumentError.missingConfiguration
   256	    }
   257	    return HarnessInvocation(command: command, configuration: configuration)
   258	  }
   259	}
