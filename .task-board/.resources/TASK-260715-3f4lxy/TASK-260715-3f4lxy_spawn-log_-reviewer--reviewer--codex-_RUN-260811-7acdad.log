   466	    }
   467	    let value = wire.value
   468	    guard !value.isEmpty,
   469	      value == value.trimmingCharacters(in: CharacterSet(charactersIn: " \t\r\n")),
   470	      !value.unicodeScalars.contains(where: { $0.value < 0x20 || $0.value == 0x7F }),
   471	      !value.contains(where: { $0.isWhitespace }),
   472	      !value.contains("@"), !value.contains("/"), !value.contains("?"),
   473	      !value.contains("#"), !value.contains("["), !value.contains("]"),
