+    encoded = field.rstrip(b"\0 ").lstrip(b" ")
+    if not encoded or any(byte not in b"01234567" for byte in encoded):
+        raise AssetManifestError(f"trusted relay archive {label} is invalid")
+    return int(encoded, 8)
