		"$(RELAY_APPLE_BUNDLE_INPUT)" \
		"$(RELAY_PROTOCOL_TEST_OUTPUT)" \
		"$(RELAY_VERSION)" \
		"$(SOURCE_COMMIT)"

relay-shell-reproducibility: relay-shell-build
