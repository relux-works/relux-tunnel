from pathlib import Path
import re
paths = [Path('docs/relay-asset-release-runbook.md'), Path('docs/relay-supply-chain.md'), Path('relay/README.md'), Path('README.md')]
checked = 0
for path in paths:
    text = path.read_text(encoding='utf-8')
    for link in re.findall(r'\\[["'^]]+'"\\]\\((["'^)]+)'"\\)', text):
        target = link.split('#', 1)[0]
        if not target or '://' in target or target.startswith('board-resource:'):
            continue
        resolved = (path.parent / target).resolve()
        if not resolved.exists():
            raise SystemExit(f'missing local link: {path}: {link}')
        checked += 1
print(f'changed-doc local links: pass={checked}/{checked}')
