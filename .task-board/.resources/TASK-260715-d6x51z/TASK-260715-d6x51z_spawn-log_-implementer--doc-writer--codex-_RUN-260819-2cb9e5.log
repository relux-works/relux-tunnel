  text = File.read(file)
  text.scan(/\\[["'^'"\\]]+\\]\\((["'^)]+)'"\\)/).flatten.each do |target|
    next if target.start_with?(\"http://\", \"https://\", \"#\")
    clean = target.split(\"#\", 2).first
    path = File.expand_path(clean, File.dirname(file))
    missing << \"#{file}: #{target}\" unless File.exist?(path)
  end
end
abort(\"missing links:\\n#{missing.join(\"\\n\")}\") unless missing.empty?
puts \"local markdown links resolve\"
'
link_rc="'$?
echo "GATE_RESULT markdown_links exit=$link_rc"
git diff --check
diff_rc=$?
echo "GATE_RESULT diff_check exit=$diff_rc"
