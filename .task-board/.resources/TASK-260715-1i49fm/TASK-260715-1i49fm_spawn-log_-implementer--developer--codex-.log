   251	  @Test("concurrent updates and requests return consistent bounded snapshots")
   252	  func concurrentUpdatesAndSnapshots() async throws {
   253	    let store = RuntimeDiagnosticsStore(runtimeGeneration: 21)
   254	    let recorder = store.recorder()
   255	    let workerCount = 8
   256	    let updatesPerWorker = 2_000
   257	    var observed: [RuntimeDiagnosticsSnapshot] = []
   258	
   259	    await withTaskGroup(of: [RuntimeDiagnosticsSnapshot].self) { group in
   260	      for _ in 0..<workerCount {
   261	        group.addTask {
   262	          for _ in 0..<updatesPerWorker {
   263	            recorder.recordQueueDrop(.tcpAdmissionLimit)
   264	            recorder.recordDNSResult(.success, latencyMilliseconds: 25)
   265	            recorder.recordTCPFlowOpened()
   266	            recorder.recordTCPFlowClosed()
   267	          }
   268	          return []
   269	        }
   270	      }
   271	      group.addTask {
   272	        var snapshots: [RuntimeDiagnosticsSnapshot] = []
   273	        for _ in 0..<200 {
   274	          if let snapshot = try? store.snapshot() {
   275	            snapshots.append(snapshot)
   276	          }
   277	          await Task.yield()
   278	        }
   279	        return snapshots
   280	      }
   281	      for await snapshots in group {
   282	        observed.append(contentsOf: snapshots)
   283	      }
   284	    }
   285	
   286	    let expected = UInt64(workerCount * updatesPerWorker)
   287	    let snapshot = try store.snapshot()
   288	    #expect(snapshot.counters["tcp_drop_admission_limit_total"] == expected)
   289	    #expect(snapshot.counters["dns_result_success_total"] == expected)
   290	    #expect(snapshot.counters["tcp_flows_opened_total"] == expected)
   291	    #expect(snapshot.counters["tcp_flows_closed_total"] == expected)
   292	    #expect(snapshot.gauges["tcp_active_flows"] == 0)
   293	    #expect((snapshot.gauges["tcp_peak_flows"] ?? 0) >= 1)
   294	    #expect((snapshot.gauges["tcp_peak_flows"] ?? 0) <= Int64(workerCount))
   295	    #expect(Set(snapshot.counters.keys) == Set(RuntimeDiagnosticsSchema.counterNames))
   296	    #expect(Set(snapshot.gauges.keys) == Set(RuntimeDiagnosticsSchema.gaugeNames))
   297	
   298	    let ordered = observed.sorted { $0.snapshotSequence < $1.snapshotSequence }
   299	    for pair in zip(ordered, ordered.dropFirst()) {
   300	      #expect(pair.1.snapshotSequence > pair.0.snapshotSequence)
   301	      #expect(
   302	        pair.1.counters["tcp_drop_admission_limit_total"]
   303	          ?? 0 >= pair.0.counters["tcp_drop_admission_limit_total"] ?? 0
   304	      )
   305	      #expect(pair.1.runtimeGeneration == 21)
   306	    }
   307	    #expect(
   308	      try RuntimeMessageCodec.encode(snapshot).count < RuntimeMessageSizeLimit.diagnosticsSnapshot)
   309	  }
