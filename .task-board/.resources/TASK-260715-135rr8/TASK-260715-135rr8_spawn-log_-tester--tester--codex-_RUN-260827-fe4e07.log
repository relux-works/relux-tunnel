+private struct PhysicalMemoryMatrixReport: Codable, Sendable {
+  let schemaVersion: UInt16
+  let taskID: String
+  let generatedAtUTC: String
+  let device: String
+  let platform: String
+  let architecture: String
+  let sourceRevision: String
