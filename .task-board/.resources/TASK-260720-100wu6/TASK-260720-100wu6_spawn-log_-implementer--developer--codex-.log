+        maximumAdvertisedReceiveWindowBytes: 8,
+        windowAdjustThresholdBytes: 9,
+        maximumBufferedReadBytes: 8,
+        maximumQueuedWriteBytes: 4,
+        maximumWriteCallBytes: 8
