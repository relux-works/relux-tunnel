+  func register(_ resource: FixtureLifecycleResource) -> FixtureLifecycleToken {
+    nextToken += 1
+    let token = FixtureLifecycleToken(rawValue: nextToken)
+    resources[token] = resource
+    return token
+  }
+
+  func release(_ token: FixtureLifecycleToken) {
