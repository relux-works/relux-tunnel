+          "archive_sha256": "a8c0d28a529ca480f9f36cf5792e2cd21984552a3c8e4aa11a24aa31aeac98e8",
+          "top_level_directory": "openssl-3.5.7"
+        },
+        "patch_manifest": "Dependencies/ReluxLibSSH2/PATCH_MANIFEST.json"
+      },
+      "integration": {
