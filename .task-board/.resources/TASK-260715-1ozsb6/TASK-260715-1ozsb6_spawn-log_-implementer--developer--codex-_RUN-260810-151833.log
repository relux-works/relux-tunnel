  1918	  private func engineError(
  1919	    _ engineCode: Int32,
  1920	    phase: SSHTransportPhase,
  1921	    fallback: SSHTransportErrorCode,
  1922	    scope: SSHTransportErrorScope? = nil
  1923	  ) -> SSHTransportError {
  1924	    let code: SSHTransportErrorCode
  1925	    switch engineCode {
  1926	    case LIBSSH2_ERROR_AUTHENTICATION_FAILED: code = .authenticationRejected
  1927	    case LIBSSH2_ERROR_PUBLICKEY_UNVERIFIED, LIBSSH2_ERROR_PUBLICKEY_PROTOCOL:
  1928	      code = .signatureFailed
  1929	    case LIBSSH2_ERROR_CHANNEL_FAILURE: code = .channelOpenRejected
  1930	    case LIBSSH2_ERROR_CHANNEL_REQUEST_DENIED: code = .execRejected
  1931	    case LIBSSH2_ERROR_CHANNEL_CLOSED, LIBSSH2_ERROR_CHANNEL_EOF_SENT: code = .channelClosed
  1932	    case LIBSSH2_ERROR_ALLOC: code = .resourceLimitExceeded
  1933	    case LIBSSH2_ERROR_SOCKET_SEND, LIBSSH2_ERROR_SOCKET_RECV,
  1934	      LIBSSH2_ERROR_SOCKET_DISCONNECT:
  1935	      code = .connectionLost
  1936	    case LIBSSH2_ERROR_TIMEOUT, LIBSSH2_ERROR_SOCKET_TIMEOUT: code = .timedOut
  1937	    default: code = fallback
  1938	    }
  1939	    let effectiveScope: SSHTransportErrorScope? =
  1940	      switch code {
  1941	      case .connectionLost, .connectionClosed:
  1942	        nil
  1943	      default:
  1944	        scope
  1945	      }
  1946	    return transportError(code: code, phase: phase, scope: effectiveScope)
  1947	  }
  1948	
  1949	  private func map(
  1950	    _ error: Error,
  1951	    phase: SSHTransportPhase,
  1952	    fallback: SSHTransportErrorCode = .adapterFailure,
  1953	    scope: SSHTransportErrorScope? = nil
  1954	  ) -> SSHTransportError {
  1955	    if let error = error as? SSHTransportError { return error }
  1956	    if error is CancellationError {
  1957	      return transportError(code: .cancelled, phase: phase, scope: scope)
  1958	    }
  1959	    if error is LibSSH2TimeoutError {
  1960	      return transportError(code: .timedOut, phase: phase, scope: scope)
  1961	    }
  1962	    return transportError(code: fallback, phase: phase, scope: scope)
  1963	  }
  1964	
  1965	  private func recordTerminalOperation(_ error: SSHTransportError) async {
  1966	    if error.code == .timedOut {
  1967	      await metric(.increment(.operationsTimedOut, by: 1))
  1968	    } else if error.code == .cancelled {
  1969	      await metric(.increment(.operationsCancelled, by: 1))
  1970	    }
  1971	  }
  1972	
  1973	  private func transportError(
  1974	    code: SSHTransportErrorCode,
  1975	    phase: SSHTransportPhase,
  1976	    scope: SSHTransportErrorScope? = nil
  1977	  ) -> SSHTransportError {
  1978	    if code == .timedOut {
  1979	      counters.operationsTimedOut += 1
  1980	    } else if code == .cancelled {
  1981	      counters.operationsCancelled += 1
  1982	    }
  1983	    let resolvedScope = scope ?? .lane(lane)
  1984	    let operationScoped = scope != nil
  1985	    return try! SSHTransportError(
  1986	      code: code,
  1987	      phase: phase,
  1988	      scope: resolvedScope,
  1989	      retryDisposition: code == .cancelled || code == .timedOut
  1990	        ? (operationScoped ? .sameChannelOperation : .newConnection) : .never,
  1991	      requiresTeardown: !operationScoped,
  1992	      channelOpenReason: code == .channelOpenRejected ? .unsupported : .notApplicable
  1993	    )
  1994	  }
  1995	}
