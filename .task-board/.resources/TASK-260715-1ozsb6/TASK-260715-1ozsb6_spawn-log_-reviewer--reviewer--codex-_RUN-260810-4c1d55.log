   536	        .rekeyFailed(
   537	          reasons: reasons,
   538	          generation: counters.rekeysSucceeded + 1,
   539	          code: .rekeyFailed
   540	        )
   541	      )
   542	      throw map(error, phase: .rekey, fallback: .rekeyFailed)
   543	    }
