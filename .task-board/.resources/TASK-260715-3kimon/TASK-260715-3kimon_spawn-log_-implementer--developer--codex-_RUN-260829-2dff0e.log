+/// The selected adapter's single conversion point for the immutable initial credit.
+/// Consumer-earned WINDOW_ADJUST remains explicitly unsupported by this adapter.
+enum LibSSH2ChannelWindowAdapter {
+  static func initialReceiveWindow(_ policy: SSHChannelPolicy) -> UInt32 {
+    UInt32(clamping: policy.initialReceiveWindowBytes)
+  }
+}
+
