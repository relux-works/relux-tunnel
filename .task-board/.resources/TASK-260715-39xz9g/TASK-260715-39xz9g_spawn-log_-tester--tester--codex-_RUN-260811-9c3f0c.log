        payload = b"first-frame\x00second-frame"
        echoed = io.BytesIO()
        echo_result = fixture.echo_stream(io.BytesIO(payload), echoed, read_bytes=3)
        sink_result = fixture.consume_stream(io.BytesIO(payload), read_bytes=5)
