            "target": target,
            "runner": {
                "kind": runner_kind,
                "name": runner_name,
                "hostTarget": normalized_host_target(),
            },
            "nativeEvidence": {
                "owner": runner_owner,
                "requirement": f"native unprivileged runtime evidence for {target}",
                "satisfied": False,
            },
            "checks": [],
        }

    def record(
        self,
        name: str,

