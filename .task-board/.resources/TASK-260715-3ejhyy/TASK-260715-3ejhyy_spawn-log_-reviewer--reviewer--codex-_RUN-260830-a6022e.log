   415	private final class CompositionFactoryProbe: @unchecked Sendable {
   416	  private let lock = NSLock()
   417	  private var values: [String: Int] = [:]
   418	
   419	  var totalFactoryCalls: Int { lock.withLock { values.values.reduce(0, +) } }
   420	  var configurationSources: Int { count("configuration") }
   421	  var sshRuntimeServices: Int { count("sshServices") }
   422	  var tcpFactories: Int { count("tcp") }
   423	  var dnsFactories: Int { count("dns") }
   424	  var privateIngressHandlers: Int { count("ingressHandler") }
   425	  var settingsBuilders: Int { count("settingsBuilder") }
   426	  var settingsAppliers: Int { count("settingsApplier") }
   427	  var snapshotStores: Int { count("snapshot") }
   428	
   429	  func recordConfigurationSource() { increment("configuration") }
   430	  func recordTCPFactory() { increment("tcp") }
   431	  func recordDNSFactory() { increment("dns") }
   432	  func recordSSHRuntimeServices() { increment("sshServices") }
   433	  func recordPrivateIngressHandler() { increment("ingressHandler") }
   434	  func recordSettingsBuilder() { increment("settingsBuilder") }
   435	  func recordSettingsApplier() { increment("settingsApplier") }
   436	  func recordSnapshotStore() { increment("snapshot") }
   437	
   438	  private func increment(_ key: String) {
   439	    lock.withLock { values[key, default: 0] += 1 }
   440	  }
   441	
   442	  private func count(_ key: String) -> Int {
   443	    lock.withLock { values[key, default: 0] }
   444	  }
   445	}
