   419	    def _lima_config(self) -> tuple[Path, str]:
   420	        config = Path.home() / ".lima" / LIMA_INSTANCE / "ssh.config"
   421	        return config, f"lima-{LIMA_INSTANCE}"
   422	
   423	    def _prepare_linux(self) -> dict:
   424	        listing = subprocess.run(
   425	            ["limactl", "list", LIMA_INSTANCE, "--json"],
   426	            stdout=subprocess.PIPE,
   427	            stderr=subprocess.PIPE,
   428	            check=False,
   429	        )
   430	        if listing.returncode != 0 or not listing.stdout.strip():
   431	            _run(
   432	                [
   433	                    "limactl", "start", "-y", "--name", LIMA_INSTANCE,
   434	                    "--mount-none", "--containerd", "none", "--cpus", "1",
   435	                    "--memory", "1", "--disk", "5", "template:ubuntu-24.04",
   436	                ],
   437	                timeout=180,
   438	            )
   439	        else:
   440	            _run(["limactl", "start", LIMA_INSTANCE], timeout=60)
   441	        config, alias = self._lima_config()
   442	        endpoints, endpoint_process = self._start_endpoint_supervisor(
   443	            "linux-current", ["/usr/bin/ssh", "-F", str(config), alias]
   444	        )
   445	        runtime = self._install_linux_identity("initial")
   446	        runtime["destinationEndpoints"] = endpoints
   447	        runtime["stdioExec"] = REMOTE_STDIO
   448	        return {
   449	            "processes": [endpoint_process],
   450	            "runtime": runtime,
   451	            "serverId": "linux-current",
   452	            "userKey": runtime["identityReference"].removeprefix("ephemeral-file://"),
   453	        }
   454	
   455	    def _ssh_config_values(self, config: Path | None, alias: str) -> dict[str, str]:
   456	        arguments = ["/usr/bin/ssh", "-G"]
   457	        if config is not None:
   458	            arguments.extend(["-F", str(config)])
   459	        arguments.append(alias)
   460	        completed = _run(arguments)
   461	        values = {}
   462	        for line in completed.stdout.decode("utf-8", errors="strict").splitlines():
   463	            key, separator, value = line.partition(" ")
   464	            if separator:
   465	                values[key.lower()] = value
   466	        for required in ("hostname", "port", "user"):
   467	            if not values.get(required):
   468	                raise ProviderError("SSH configuration is missing a required runtime field")
   469	        return values
