+      transitions[next] = incrementSaturating(transitions[next, default: 0])
+      transition = MemoryWatermarkTransition(from: previous, to: next, reason: reason!)
+    }
+    let observation = MemoryObservation(
+      sequence: sequence,
+      stateGeneration: stateGeneration,
+      configurationGeneration: configuration.generation,
+      timestamp: finishedAt,
+      unit: .bytes,
+      trigger: trigger,
+      physicalFootprint: platformSample.physicalFootprint,
+      physicalFootprintPeak: platformSample.physicalFootprintPeak,
+      advisoryAvailableMemory: platformSample.advisoryAvailableMemory,
+      ledger: ledgerSample,
+      warningReceived: warning,
+      actionsAcknowledged: actionsAcknowledged,
+      state: state,
+      transition: transition,
+      samplingDuration: samplingDuration)
+    history.append(observation)
+    return .observed(observation)
+  }
+
+  public func retainedHistory() -> [MemoryObservation] { history.values }
