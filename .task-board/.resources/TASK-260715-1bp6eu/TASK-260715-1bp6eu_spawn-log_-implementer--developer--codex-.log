+        }
+        for waiter in waiters { waiter.resume() }
+      }
+    } onCancel: {
+      let continuation = self.lock.withLock {
+        self.sleepers[duration]?.removeValue(forKey: identifier)
+      }
+      continuation?.resume(throwing: CancellationError())
+    }
