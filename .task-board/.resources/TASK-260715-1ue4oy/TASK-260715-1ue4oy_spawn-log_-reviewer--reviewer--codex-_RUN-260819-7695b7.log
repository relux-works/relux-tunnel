   883	def publish_staged_bundle(
   884	    staging: Path,
   885	    bundle: Path,
   886	    event_hook: Callable[[str, Path], None] | None,
   887	) -> None:
   888	    parent = bundle.parent
   889	    try:
   890	        existing_status = os.lstat(bundle)
   891	    except FileNotFoundError:
   892	        existing_status = None
   893	    except OSError as error:
   894	        raise AssetManifestError(
   895	            "relay asset bundle destination is unavailable"
   896	        ) from error
   897
   898	    if existing_status is None:
   899	        try:
   900	            os.replace(staging, bundle)
   901	            fsync_directory(parent)
   902	        except OSError as error:
   903	            raise AssetManifestError("relay asset bundle publication failed") from error
   904	        if event_hook is not None:
   905	            event_hook("after_publish", bundle)
   906	        return
   907	    if not stat.S_ISDIR(existing_status.st_mode) or stat.S_ISLNK(
   908	        existing_status.st_mode
   909	    ):
   910	        raise AssetManifestError("relay asset bundle destination is unsafe")
   911
   912	    displaced_identity = (existing_status.st_dev, existing_status.st_ino)
   913	    atomic_exchange(staging, bundle)
   914	    try:
   915	        fsync_directory(parent)
   916	        if event_hook is not None:
   917	            event_hook("after_exchange", bundle)
   918	    finally:
   919	        remove_owned_directory(staging, displaced_identity)
   920	        fsync_directory(parent)
