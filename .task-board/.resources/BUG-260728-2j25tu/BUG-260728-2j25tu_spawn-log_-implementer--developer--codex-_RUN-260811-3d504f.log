   840	  private func popInbound() -> Data? {
   841	    let item = lock.withLock { () -> (Data, UInt32)? in
   842	      guard !inbound.isEmpty else { return nil }
   843	      let item = inbound.removeFirst()
   844	      inboundBytes -= item.1
   845	      return item
   846	    }
   847	    guard let item else { return nil }
   848	    owner?.releaseInbound(item.1)
   849	    return item.0
   850	  }
   851	
   852	  private func drainOutbound() {
   853	    while true {
   854	      let item = lock.withLock { () -> (Data, UInt32)? in
   855	        guard !closed else {
   856	          writerScheduled = false
   857	          return nil
   858	        }
   859	        guard !outbound.isEmpty else {
   860	          writerScheduled = false
   861	          return nil
   862	        }
   863	        let item = outbound.removeFirst()
   864	        outboundBytes -= item.1
   865	        return item
   866	      }
   867	      guard let item else { return }
   868	      owner?.releaseOutbound(item.1)
   869	      do {
   870	        try channel.withBorrowedDescriptor { descriptor in
   871	          try sendAll(item.0, descriptor: descriptor)
   872	        }
   873	      } catch {
   874	        close(notifyRegistry: true)
   875	        return
   876	      }
   877	    }
   878	  }
   879	
   880	  private func configureTimeouts() throws {
   881	    try channel.withBorrowedDescriptor { descriptor in
   882	      var timeout = timeval(
   883	        tv_sec: Int(ioTimeoutMilliseconds / 1_000),
   884	        tv_usec: Int32(ioTimeoutMilliseconds % 1_000) * 1_000
   885	      )
   886	      for option in [SO_RCVTIMEO, SO_SNDTIMEO] {
   887	        guard
   888	          setsockopt(
   889	            descriptor,
   890	            SOL_SOCKET,
   891	            option,
   892	            &timeout,
   893	            socklen_t(MemoryLayout.size(ofValue: timeout))
   894	          ) == 0
   895	        else {
   896	          throw HEVIntegrationError.socksBoundaryFailed(code: errno)
   897	        }
   898	      }
   899	    }
   900	  }
   901	
   902	  private func sendSOCKSReply(code: UInt8) throws {
   903	    try channel.withBorrowedDescriptor { descriptor in
   904	      try sendAll(Data([5, code, 0, 1, 0, 0, 0, 0, 0, 0]), descriptor: descriptor)
   905	    }
   906	  }
   907	}
