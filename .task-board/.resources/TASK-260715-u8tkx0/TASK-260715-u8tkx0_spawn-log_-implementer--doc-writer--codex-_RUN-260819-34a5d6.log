  cp -R "$SCRATCH/$RUN/.build/relay/TASK-260715-1q03sa/protocol-tests" "$EVIDENCE_ROOT/$RUN/protocol-tests"
done

python3 scripts/relay_release.py compare \
  --first "$EVIDENCE_ROOT/run-a/release" \
