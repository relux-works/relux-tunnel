  1359	def scan_runtime(config: dict[str, Any], root: Path = ROOT) -> None:
  1360	    policy = config["runtimePolicy"]
  1361	    validate_runtime_policy(policy)
  1362	    extensions = set(policy["scanExtensions"])
  1363	    excluded_suffixes = tuple(policy["excludedFileSuffixes"])
  1364	    excluded_paths = set(policy["excludedPaths"])
  1365	    scanned_files = 0
  1366	    for relative_root in policy["scanRoots"]:
  1367	        scan_root = root / relative_root
  1368	        if not scan_root.is_dir() or scan_root.is_symlink():
  1369	            raise SupplyChainError(
  1370	                f"runtime audit root is unavailable: {relative_root}"
  1371	            )
  1372	        resolved_scan_root = scan_root.resolve(strict=True)
  1373	        for path in sorted(scan_root.rglob("*")):
  1374	            if path.is_symlink():
  1375	                raise SupplyChainError(
  1376	                    f"runtime audit scope contains a symlink: {path.relative_to(root)}"
  1377	                )
  1378	            if path.is_dir():
  1379	                continue
  1380	            relative_path = path.relative_to(root).as_posix()
  1381	            if not path.is_file():
  1382	                raise SupplyChainError(
  1383	                    f"runtime audit scope contains an unclassified entry: {relative_path}"
  1384	                )
  1385	            if relative_path in excluded_paths:
  1386	                continue
  1387	            if path.suffix == ".go" and path.name.endswith(excluded_suffixes):
  1388	                continue
  1389	            if path.suffix not in extensions:
  1390	                raise SupplyChainError(
  1391	                    f"runtime audit scope contains an unclassified file: {relative_path}"
  1392	                )
  1393	            resolved_path = path.resolve(strict=True)
  1394	            if not resolved_path.is_relative_to(resolved_scan_root):
  1395	                raise SupplyChainError(
  1396	                    f"runtime audit source escapes its root: {path.relative_to(root)}"
  1397	                )
  1398	            try:
  1399	                text = path.read_text(encoding="utf-8")
  1400	            except (OSError, UnicodeDecodeError) as error:
  1401	                raise SupplyChainError(
  1402	                    f"runtime audit source is unreadable: {path.relative_to(root)}"
  1403	                ) from error
  1404	            scanned_files += 1
  1405	            label = forbidden_runtime_surface(path.suffix, text)
  1406	            if label is not None:
  1407	                raise SupplyChainError(
  1408	                    "application runtime code-download surface found "
  1409	                    f"({label}): {path.relative_to(root)}"
  1410	                )
  1411	    if scanned_files == 0:
  1412	        raise SupplyChainError("runtime audit scanned no application source files")
