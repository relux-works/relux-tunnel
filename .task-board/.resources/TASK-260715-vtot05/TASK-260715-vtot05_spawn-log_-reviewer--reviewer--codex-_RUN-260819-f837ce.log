   722	def manifest_linkage_subject(config: dict[str, Any]) -> dict[str, Any]:
   723	    artifact = config["artifactManifest"]
   724	    asset_source = load_json(ROOT / artifact["sourceContract"])
   725	    return {
   726	        "manifestName": artifact["manifestName"],
   727	        "manifestSchemaSHA256": sha256_file(ROOT / artifact["schema"]),
   728	        "sourceCommit": config["source"]["revision"],
   729	        "sourceAggregateSHA256": config["source"]["aggregateSHA256"],
   730	        "buildRecipeRevision": config["build"]["recipeRevision"],
   731	        "buildRecipeAggregateSHA256": config["build"]["recipeAggregateSHA256"],
   732	        "toolchainManifestSHA256": next(
   733	            item["sha256"]
   734	            for item in config["build"]["recipeFiles"]
   735	            if item["path"] == "relay/toolchain-manifest-v1.json"
   736	        ),
   737	        "archiveSHA256": artifact["archiveSHA256"],
   738	        "assets": [
   739	            {
   740	                key: entry[key]
   741	                for key in ("os", "arch", "fileName", "byteSize", "sha256")
   742	            }
   743	            for entry in asset_source["assets"]
   744	        ],
   745	    }
   746	
   747	
   748	def linkage_id(config: dict[str, Any]) -> str:
   749	    return sha256_bytes(compact_json(manifest_linkage_subject(config)))
