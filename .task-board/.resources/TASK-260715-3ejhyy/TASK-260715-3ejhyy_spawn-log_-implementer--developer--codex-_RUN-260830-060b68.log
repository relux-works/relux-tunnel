+  }
+}
+
+/// One-generation owner of the accepted PacketBridge.
+public actor BridgeBackedM1PacketPlaneSession: M1PacketPlaneSession {
+  private enum State {
+    case prepared
+    case activating
+    case active
+    case failed
+    case stopped
+  }
