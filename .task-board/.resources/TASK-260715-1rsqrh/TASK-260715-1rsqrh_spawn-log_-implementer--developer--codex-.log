        status: status,
        generation: generation,
        observationID: observationID,
        revision: revision
      )
    else { return }
    statusProjection = VPNStatusProjection(
      systemStatus: status,
      disconnectReason: disconnectReason
    )
  }

  private func isCurrent(
    status: VPNManagerSessionStatus,
    generation: UInt64,
    observationID: UInt64,
    revision: UInt64
  ) -> Bool {
