+      identity: SSHSessionIdentity(
+        rawValue: UUID(uuidString: "20000000-0000-0000-0000-000000000001")!
+      ),
+      acceptedHost: accepted,
+      negotiatedAlgorithms: fixtureNegotiatedAlgorithms(),
+      keyExchangeGeneration: 1
