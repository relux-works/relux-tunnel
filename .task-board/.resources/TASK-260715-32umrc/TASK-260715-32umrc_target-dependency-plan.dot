digraph GeneratedTargetDependencyPlan {
  graph [
    label=<TASK-260715-32umrc: generated target dependencies<BR/><FONT POINT-SIZE="10">arrow = source consumes or contains destination; iOS is deferred</FONT>>
    labelloc=t
    rankdir=LR
    nodesep=0.5
    ranksep=0.8
  ]
  node [shape=box style=rounded]
  edge [fontsize=10]

  subgraph cluster_generated {
    label=<Generated Apple workspace>
    color="#7f8c8d"

    MacHost [label=<ReluxProxyMac<BR/>configuration / activation owner>]
    MacProvider [label=<ReluxProxyMacTunnel<BR/>live-state owner / thin entry point>]
    IOSHost [label=<ReluxProxyIOS<BR/>DEFERRED> style=<rounded,dashed> color="#7f8c8d"]
    IOSProvider [label=<ReluxProxyIOSTunnel<BR/>DEFERRED> style=<rounded,dashed> color="#7f8c8d"]
  }

  subgraph cluster_swift {
    label=<Local Swift package: ReluxTunnel>
    color="#3498db"

    MacAdapter [label=<ReluxTunnelMacOSAdapter<BR/>thin NetworkExtension adapter>]
    IOSAdapter [label=<ReluxTunnelIOSAdapter<BR/>thin adapter / DEFERRED> style=<rounded,dashed> color="#7f8c8d"]
    SSHAdapter [label=<ReluxTunnelLibSSH2Adapter<BR/>selected macOS SSH adapter>]
    Native [label=<ReluxTunnelNativeAdapter<BR/>static native boundary>]
    Core [label=<ReluxTunnelCore<BR/>platform-neutral contracts / state>]
    HarnessSupport [label=<ReluxTunnelHarnessSupport>]
    Harness [label=<ReluxTunnelHarness<BR/>macOS CLI>]
  }

  Relay [label=<relux-relay + protocol test<BR/>verified Go artifacts / resource input>]
  Legacy [label=<Existing ReluxProxy<BR/>separate SwiftPM macOS 14 lane> style=<rounded,dashed>]

  MacHost -> MacProvider [label=<embeds / manages configuration> color="#1f618d"]
  MacHost -> Core [label=<configuration models>]
  MacProvider -> MacAdapter [label=<composition root>]
  MacAdapter -> SSHAdapter
  MacAdapter -> Native
  MacAdapter -> Core
  SSHAdapter -> Core
  Native -> Core
  MacProvider -> Relay [label=<bundles verified resource> style=dashed]
  Harness -> HarnessSupport
  HarnessSupport -> SSHAdapter
  HarnessSupport -> Native
  HarnessSupport -> Core

  IOSHost -> IOSProvider [label=<embeds / manages configuration> style=dashed color="#7f8c8d"]
  IOSProvider -> IOSAdapter [style=dashed color="#7f8c8d"]
  IOSAdapter -> Native [style=dashed color="#7f8c8d"]
  IOSAdapter -> Core [style=dashed color="#7f8c8d"]
  IOSProvider -> Relay [label=<bundles verified resource> style=dashed color="#7f8c8d"]

  Legacy -> MacHost [label=<coexists; no dependency or silent replacement> style=dashed dir=none]
}
