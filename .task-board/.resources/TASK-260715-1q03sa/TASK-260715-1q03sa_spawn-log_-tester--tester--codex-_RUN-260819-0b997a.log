    def write_archive(self, path: Path, members: dict[str, bytes]) -> None:
        with tarfile.open(path, "w:gz") as bundle:
            for name, contents in members.items():
                info = tarfile.TarInfo(name)
                info.size = len(contents)
                info.mode = 0o755
