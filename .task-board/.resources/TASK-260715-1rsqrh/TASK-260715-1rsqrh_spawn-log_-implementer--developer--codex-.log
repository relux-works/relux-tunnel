      try RuntimeConfigurationCodec.decodeStartRequest(data)
        == RuntimeStartRequest(configurationReference: reference)
    )
    #expect(
      (await controller.currentProjection()).providerFacts?.position
        == .init(
          runtimeGeneration: 4,
