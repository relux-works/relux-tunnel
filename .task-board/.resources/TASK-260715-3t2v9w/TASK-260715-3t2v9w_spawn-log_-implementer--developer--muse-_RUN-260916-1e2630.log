virtualDNSEndpoints.contains(destination) else {\n97|        throw M1PrivateIngressError.generalUDPDeferred\n98|      }\n99|      return .dnsUDP(\n100|        try await dns.exchangeUDP(\n101|          payload,\n102|          destination: destination,\n103|          originator: originator\n104|        )\n105|      )\n106|    }\n107|  }\n108|}\n109|\n110|public typealias M1PacketBridgeBuilder =\n111|  @Sendable (\n112|    _ ingress: any M1PrivateIngressDispatching,\n113|    _ runtimeGeneration: UInt64\n114|  ) throws -> any PacketBridge\n115|\n116|/// Resource-free packet-plane preflight.\n117|///\n118|/// The builder may construct owners but must not create descriptors, listeners,\n119|/// native leases/threads, or PacketFlow reads. Those operations belong to the\n120|/// returned bridge's `start` call, reached only through `activateReads`.\n121|public struct BridgeBackedM1PacketPlaneFactory: M1PacketPlaneFactory {\n122|  private let configuration: PacketBridgeConfiguration\n123|  private let virtualDNSEndpoints: Set<TunnelEndpoint>\n124|  private let makeBridge: M1PacketBridgeBuilder\n125|\n126|  public init(\n127|    configuration: PacketBridgeConfiguration,\n128|    virtualDNSEndpoints: Set<TunnelEndpoint>,\n129|    makeBridge: @escaping M1PacketBridgeBuilder\n130|  ) {\n131|    self.configuration = configuration\n132|    self.virtualDNSEndpoints = virtualDNSEndpoints\n133|    self.makeBridge = makeBridge\n134|  }\n135|\n136|  public func prepare(\n137|    configuration: RuntimeConfigurationSnapshot,\n138|    tcp: any TCPConsumer,\n139|    dns: any DNSConsumer,\n140|    runtimeGeneration: UInt64,\n141|    healthSink: any TunnelRuntimeHealthEventSink\n142|  ) async throws -> any M1PacketPlaneSession {\n143|    guard let tcp = tcp as? any M1TCPIngressConsumer else {\n144|      throw M1PrivateIngressError.incompatibleTCPConsumer\n145|    }\n146|    guard let dns = dns as? any M1DNSIngressConsumer else {\n147|      throw M1PrivateIngressError.incompatibleDNSConsumer\n148|    }\n149|    let ingress = M1PrivateIngressDispatcher(\n150|      tcp: tcp,\n151|      dns: dns,\n152|      virtualDNSEndpoints: virtualDNSEndpoints\n153|    )\n154|    let bridge = try makeBridge(ingress, runtimeGeneration)\n155|    return BridgeBackedM1PacketPlaneSession(\n156|      bridge: bridge,\n157|      configuration: self.configuration,\n158|      runtimeGeneration: runtimeGeneration,\n159|      healthSink: healthSink\n160|    )\n161|  }\n162|}\n163|\n164|/// One-generation owner of the accepted PacketBridge.\n165|public actor BridgeBackedM1PacketPlaneSession: M1PacketPlaneSession {\n166|  private enum State {\n167|    case prepared\n168|    case activating\n169|    case active\n170|    case failed\n171|    case stopped\n172|  }\n173|\n174|  private let bridge: any PacketBridge\n175|  private let configuration: PacketBridgeConfiguration\n176|  private let runtimeGeneration: UInt64\n177|  private let healthSink: any TunnelRuntimeHealthEventSink\n178|  private var state = State.prepared\n179|\n180|  public init(\n181|    bridge: any PacketBridge,\n182|    configuration: PacketBridgeConfiguration,\n183|    runtimeGeneration: UInt64,\n184|    healthSink: any TunnelRuntimeHealthEventSink\n185|  ) {\n186|    self.bridge = bridge\n187|    self.configuration = configuration\n188|    self.runtimeGeneration = runtimeGeneration\n189|    self.healthSink = healthSink\n190|  }\n191|\n192|  public func activateReads(packetFlow: any PacketFlow) async throws {\n193|    guard state == .prepared else {\n194|      throw PacketFlowBridgeError.alreadyActive\n195|    }\n196|    state = .activating\n197|    do {\n198|      _ = try await bridge.start(\n199|        packetFlow: packetFlow,\n200|        configuration: configuration\n201|      )\n202|      state = .active\n203|    } catch {\n204|      state = .failed\n205|      await healthSink.receive(\n206|        TunnelRuntimeHealthEvent(\n207|          runtimeGeneration: runtimeGeneration,\n208|          component: .packetPlane,\n209|          health: .unhealthy\n210|        )\n211|      )\n212|      throw error\n213|    }\n214|  }\n215|\n216|  public func stop() async {\n217|    guard state != .stopped else { return }\n218|    await bridge.stop()\n219|    state = .stopped\n220|  }\n221|\n222|  public func health() async -> TunnelRuntimeComponentHealth {\n223|    switch state {\n224|    case .prepared, .activating, .active:\n225|      .healthy\n226|    case .failed, .stopped:\n227|      .unhealthy\n228|    }\n229|  }\n230|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
