+    var offset = 0
+    while offset < count {
+      let readCount = result.withUnsafeMutableBytes {
+        Darwin.read(descriptor, $0.baseAddress!.advanced(by: offset), count - offset)
+      }
+      if readCount > 0 {
+        offset += readCount
+      } else if readCount < 0, errno == EINTR {
