diff --git a/App/ReluxProxyMac/Sources/ReluxUpdateSettings.swift b/App/ReluxProxyMac/Sources/ReluxUpdateSettings.swift
new file mode 100644
index 0000000..5684437
--- /dev/null
+++ b/App/ReluxProxyMac/Sources/ReluxUpdateSettings.swift
@@ -0,0 +1,416 @@
+import AppKit
+import Foundation
+import Observation
+import Sparkle
+import SwiftUI
+
+enum ReluxUpdateChannel: String, CaseIterable, Equatable {
+  case stable
+  case preRelease
+
+  var title: LocalizedStringResource {
+    switch self {
+    case .stable: "Stable"
+    case .preRelease: "Pre-release"
+    }
+  }
+}
+
+struct ReluxUpdateFeedPolicy: Equatable {
+  let stableFeedURL: URL
+  let preReleaseChannel: String?
+
+  var supportsPreRelease: Bool { preReleaseChannel != nil }
+
+  func effectiveChannel(for requestedChannel: ReluxUpdateChannel) -> ReluxUpdateChannel {
+    requestedChannel == .preRelease && supportsPreRelease ? .preRelease : .stable
+  }
+}
+
+protocol ReluxUpdatePreferencesStoring: AnyObject {
+  var automaticallyChecksForUpdates: Bool { get set }
+  var selectedChannel: ReluxUpdateChannel { get set }
+}
+
+final class ReluxUserDefaultsUpdatePreferences: ReluxUpdatePreferencesStoring {
+  static let automaticChecksKey = "updates.automaticallyChecks"
+  static let selectedChannelKey = "updates.channel"
+
+  private let defaults: UserDefaults
+
+  init(defaults: UserDefaults = .standard) {
+    self.defaults = defaults
+  }
+
+  var automaticallyChecksForUpdates: Bool {
+    get {
+      guard defaults.object(forKey: Self.automaticChecksKey) != nil else { return true }
+      return defaults.bool(forKey: Self.automaticChecksKey)
+    }
+    set { defaults.set(newValue, forKey: Self.automaticChecksKey) }
+  }
+
+  var selectedChannel: ReluxUpdateChannel {
+    get {
+      guard
+        let rawValue = defaults.string(forKey: Self.selectedChannelKey),
+        let channel = ReluxUpdateChannel(rawValue: rawValue)
+      else { return .stable }
+      return channel
+    }
+    set { defaults.set(newValue.rawValue, forKey: Self.selectedChannelKey) }
+  }
+}
+
+enum ReluxUpdatePresentationEvent {
+  case checkStarted
+  case upToDate
+  case updateAvailable
+  case downloadStarted
+  case readyToRelaunch
+  case failed
+  case reset
+}
+
+enum ReluxUpdatePresentationState: Equatable {
+  case idle
+  case checking
+  case upToDate
+  case available
+  case downloading
+  case readyToRelaunch
+  case failed
+
+  var message: LocalizedStringResource {
+    switch self {
+    case .idle: "Updates are ready to check."
+    case .checking: "Checking for updates…"
+    case .upToDate: "Relux is up to date."
+    case .available: "An update is available."
+    case .downloading: "Downloading the update…"
+    case .readyToRelaunch: "The update is ready. Relaunch to finish."
+    case .failed: "The update check failed. Try again later."
+    }
+  }
+}
+
+@MainActor
+@Observable
+final class ReluxUpdatePresentationModel {
+  private(set) var state: ReluxUpdatePresentationState = .idle
+
+  func receive(_ event: ReluxUpdatePresentationEvent) {
+    switch event {
+    case .checkStarted: state = .checking
+    case .upToDate: state = .upToDate
+    case .updateAvailable: state = .available
+    case .downloadStarted: state = .downloading
+    case .readyToRelaunch: state = .readyToRelaunch
+    case .failed: state = .failed
+    case .reset: state = .idle
+    }
+  }
+
+  func receiveFailure(_ error: any Error) {
+    _ = error
+    receive(.failed)
+  }
+}
+
+@MainActor
+protocol ReluxUpdaterControlling: AnyObject {
+  var automaticallyChecksForUpdates: Bool { get set }
+  var updateCheckInterval: TimeInterval { get set }
+  var selectedChannel: ReluxUpdateChannel { get set }
+  var canCheckForUpdates: Bool { get }
+  func checkForUpdates()
+  func resetUpdateCycle()
+}
+
+@MainActor
+protocol ReluxUpdateScheduling: AnyObject {
+  func scheduleAutomaticChecks(
+    every interval: TimeInterval,
+    using updater: any ReluxUpdaterControlling
+  )
+  func cancelAutomaticChecks(using updater: any ReluxUpdaterControlling)
+}
+
+@MainActor
+final class ReluxSparkleUpdateScheduler: ReluxUpdateScheduling {
+  private var scheduledInterval: TimeInterval?
+
+  func scheduleAutomaticChecks(
+    every interval: TimeInterval,
+    using updater: any ReluxUpdaterControlling
+  ) {
+    guard scheduledInterval != interval || !updater.automaticallyChecksForUpdates else { return }
+    scheduledInterval = interval
+    updater.updateCheckInterval = interval
+    updater.automaticallyChecksForUpdates = true
+    updater.resetUpdateCycle()
+  }
+
+  func cancelAutomaticChecks(using updater: any ReluxUpdaterControlling) {
+    guard scheduledInterval != nil || updater.automaticallyChecksForUpdates else { return }
+    scheduledInterval = nil
+    updater.automaticallyChecksForUpdates = false
+    updater.resetUpdateCycle()
+  }
+}
+
+@MainActor
+@Observable
+final class ReluxUpdateSettingsModel {
+  static let automaticCheckInterval: TimeInterval = 86_400
+
+  let feedPolicy: ReluxUpdateFeedPolicy
+  let presentationModel: ReluxUpdatePresentationModel
+  private let preferences: any ReluxUpdatePreferencesStoring
+  private let updater: any ReluxUpdaterControlling
+  private let scheduler: any ReluxUpdateScheduling
+
+  var automaticallyChecksForUpdates: Bool {
+    didSet {
+      guard automaticallyChecksForUpdates != oldValue else { return }
+      preferences.automaticallyChecksForUpdates = automaticallyChecksForUpdates
+      reconcileSchedule()
+    }
+  }
+
+  var selectedChannel: ReluxUpdateChannel {
+    didSet {
+      let effectiveChannel = feedPolicy.effectiveChannel(for: selectedChannel)
+      guard effectiveChannel == selectedChannel else {
+        selectedChannel = effectiveChannel
+        return
+      }
+      guard selectedChannel != oldValue else { return }
+      preferences.selectedChannel = selectedChannel
+      updater.selectedChannel = selectedChannel
+      updater.resetUpdateCycle()
+    }
+  }
+
+  init(
+    feedPolicy: ReluxUpdateFeedPolicy,
+    preferences: any ReluxUpdatePreferencesStoring,
+    updater: any ReluxUpdaterControlling,
+    scheduler: any ReluxUpdateScheduling,
+    presentationModel: ReluxUpdatePresentationModel = ReluxUpdatePresentationModel()
+  ) {
+    self.feedPolicy = feedPolicy
+    self.preferences = preferences
+    self.updater = updater
+    self.scheduler = scheduler
+    self.presentationModel = presentationModel
+    automaticallyChecksForUpdates = preferences.automaticallyChecksForUpdates
+    selectedChannel = feedPolicy.effectiveChannel(for: preferences.selectedChannel)
+    preferences.selectedChannel = selectedChannel
+    updater.selectedChannel = selectedChannel
+    reconcileSchedule()
+  }
+
+  var canCheckForUpdates: Bool {
+    switch presentationModel.state {
+    case .checking, .downloading: false
+    default: updater.canCheckForUpdates
+    }
+  }
+
+  func checkForUpdates() {
+    presentationModel.receive(.checkStarted)
+    updater.checkForUpdates()
+  }
+
+  private func reconcileSchedule() {
+    if automaticallyChecksForUpdates {
+      scheduler.scheduleAutomaticChecks(every: Self.automaticCheckInterval, using: updater)
+    } else {
+      scheduler.cancelAutomaticChecks(using: updater)
+    }
+  }
+}
+
+enum ReluxScheduledUpdatePresentationPolicy {
+  static func letsSparklePresent(userInitiated: Bool) -> Bool {
+    userInitiated
+  }
+}
+
+@MainActor
+final class ReluxSparkleUpdaterAdapter: NSObject, ReluxUpdaterControlling {
+  private let updaterDelegate: ReluxSparkleUpdaterDelegate
+  private let userDriverDelegate: ReluxSparkleUserDriverDelegate
+  private let controller: SPUStandardUpdaterController
+  private var updaterStarted = false
+
+  init(
+    presentationModel: ReluxUpdatePresentationModel,
+    preReleaseChannel: String?,
+    startingUpdater: Bool
+  ) {
+    updaterDelegate = ReluxSparkleUpdaterDelegate(
+      presentationModel: presentationModel,
+      preReleaseChannel: preReleaseChannel
+    )
+    userDriverDelegate = ReluxSparkleUserDriverDelegate(presentationModel: presentationModel)
+    controller = SPUStandardUpdaterController(
+      startingUpdater: false,
+      updaterDelegate: updaterDelegate,
+      userDriverDelegate: userDriverDelegate
+    )
+    super.init()
+    if startingUpdater {
+      controller.startUpdater()
+      updaterStarted = true
+    }
+  }
+
+  var isControllerConstructed: Bool { true }
+
+  var automaticallyChecksForUpdates: Bool {
+    get { controller.updater.automaticallyChecksForUpdates }
+    set { controller.updater.automaticallyChecksForUpdates = newValue }
+  }
+
+  var updateCheckInterval: TimeInterval {
+    get { controller.updater.updateCheckInterval }
+    set { controller.updater.updateCheckInterval = newValue }
+  }
+
+  var selectedChannel: ReluxUpdateChannel {
+    get { updaterDelegate.selectedChannel }
+    set { updaterDelegate.selectedChannel = newValue }
+  }
+
+  var canCheckForUpdates: Bool { controller.updater.canCheckForUpdates }
+
+  func checkForUpdates() {
+    controller.checkForUpdates(nil)
+  }
+
+  func resetUpdateCycle() {
+    guard updaterStarted else { return }
+    controller.updater.resetUpdateCycle()
+  }
+}
+
+@MainActor
+final class ReluxSparkleUpdaterDelegate: NSObject, SPUUpdaterDelegate {
+  private let presentationModel: ReluxUpdatePresentationModel
+  private let preReleaseChannel: String?
+  var selectedChannel: ReluxUpdateChannel = .stable
+
+  init(
+    presentationModel: ReluxUpdatePresentationModel,
+    preReleaseChannel: String?
+  ) {
+    self.presentationModel = presentationModel
+    self.preReleaseChannel = preReleaseChannel
+  }
+
+  func allowedChannels(for updater: SPUUpdater) -> Set<String> {
+    guard selectedChannel == .preRelease, let preReleaseChannel else { return [] }
+    return [preReleaseChannel]
+  }
+
+  func updater(_ updater: SPUUpdater, didFindValidUpdate item: SUAppcastItem) {
+    presentationModel.receive(.updateAvailable)
+  }
+
+  func updater(_ updater: SPUUpdater, didFinishLoading appcast: SUAppcast) {
+    presentationModel.receive(.checkStarted)
+  }
+
+  func updaterDidNotFindUpdate(_ updater: SPUUpdater, error: any Error) {
+    presentationModel.receive(.upToDate)
+  }
+
+  func updater(
+    _ updater: SPUUpdater,
+    willDownloadUpdate item: SUAppcastItem,
+    with request: NSMutableURLRequest
+  ) {
+    presentationModel.receive(.downloadStarted)
+  }
+
+  func updaterWillRelaunchApplication(_ updater: SPUUpdater) {
+    presentationModel.receive(.readyToRelaunch)
+  }
+
+  func updater(
+    _ updater: SPUUpdater,
+    didFinishUpdateCycleFor updateCheck: SPUUpdateCheck,
+    error: (any Error)?
+  ) {
+    guard let error else { return }
+    let cocoaError = error as NSError
+    if cocoaError.domain == SUSparkleErrorDomain && cocoaError.code == 1001 {
+      presentationModel.receive(.upToDate)
+    } else if cocoaError.domain == SUSparkleErrorDomain && cocoaError.code == 4007 {
+      presentationModel.receive(.reset)
+    } else {
+      presentationModel.receiveFailure(error)
+    }
+  }
+
+}
+
+final class ReluxSparkleUserDriverDelegate: NSObject, SPUStandardUserDriverDelegate,
+  @unchecked Sendable
+{
+  private let presentationModel: ReluxUpdatePresentationModel
+
+  init(presentationModel: ReluxUpdatePresentationModel) {
+    self.presentationModel = presentationModel
+  }
+
+  var supportsGentleScheduledUpdateReminders: Bool { true }
+
+  func standardUserDriverShouldHandleShowingScheduledUpdate(
+    _ update: SUAppcastItem,
+    andInImmediateFocus immediateFocus: Bool
+  ) -> Bool {
+    ReluxScheduledUpdatePresentationPolicy.letsSparklePresent(userInitiated: false)
+  }
+
+  func standardUserDriverWillHandleShowingUpdate(
+    _ handleShowingUpdate: Bool,
+    forUpdate update: SUAppcastItem,
+    state: SPUUserUpdateState
+  ) {
+    if !ReluxScheduledUpdatePresentationPolicy.letsSparklePresent(
+      userInitiated: state.userInitiated
+    ) {
+      Task { @MainActor in
+        presentationModel.receive(.updateAvailable)
+      }
+    }
+  }
+}
+
+struct ReluxUpdateMenu: View {
+  @Bindable var model: ReluxUpdateSettingsModel
+
+  var body: some View {
+    Text(model.presentationModel.state.message)
+    Divider()
+    Toggle("Automatically Check for Updates", isOn: $model.automaticallyChecksForUpdates)
+    if model.feedPolicy.supportsPreRelease {
+      Picker("Update Channel", selection: $model.selectedChannel) {
+        ForEach(ReluxUpdateChannel.allCases, id: \.self) { channel in
+          Text(channel.title).tag(channel)
+        }
+      }
+    }
+    Button("Check for Updates…") {
+      model.checkForUpdates()
+    }
+    .disabled(!model.canCheckForUpdates)
+    Divider()
+    Button("Quit Relux") {
+      NSApplication.shared.terminate(nil)
+    }
+  }
+}
