     1	import Foundation
     2	import Sparkle
     3	
     4	enum ReluxProxyUpdaterConfigurationError: Error, Equatable {
     5	  case missingFeedURL
     6	  case invalidFeedURL
     7	  case missingPublicEDKey
     8	  case invalidPublicEDKey
     9	  case invalidPreReleaseChannel
    10	}
    11	
    12	enum ReluxProxyUpdaterConfiguration {
    13	  static let feedURLKey = "SUFeedURL"
    14	  static let publicEDKeyKey = "SUPublicEDKey"
    15	  static let preReleaseChannelKey = "ReluxPreReleaseUpdateChannel"
    16	
    17	  static func feedURL(in infoDictionary: [String: Any]) throws -> URL {
    18	    guard let rawValue = infoDictionary[feedURLKey] as? String, !rawValue.isEmpty else {
    19	      throw ReluxProxyUpdaterConfigurationError.missingFeedURL
    20	    }
    21	    guard
    22	      let components = URLComponents(string: rawValue),
    23	      components.scheme == "https",
    24	      components.host != nil,
    25	      components.user == nil,
    26	      components.password == nil,
    27	      components.query == nil,
    28	      components.fragment == nil,
    29	      let url = components.url
    30	    else {
    31	      throw ReluxProxyUpdaterConfigurationError.invalidFeedURL
    32	    }
    33	    return url
    34	  }
    35	
    36	  static func publicEDKey(in infoDictionary: [String: Any]) throws -> Data {
    37	    guard let rawValue = infoDictionary[publicEDKeyKey] as? String, !rawValue.isEmpty else {
    38	      throw ReluxProxyUpdaterConfigurationError.missingPublicEDKey
    39	    }
    40	    guard let publicKey = Data(base64Encoded: rawValue), publicKey.count == 32 else {
    41	      throw ReluxProxyUpdaterConfigurationError.invalidPublicEDKey
    42	    }
    43	    return publicKey
    44	  }
    45	
    46	  static func feedPolicy(in infoDictionary: [String: Any]) throws -> ReluxUpdateFeedPolicy {
    47	    let stableFeedURL = try feedURL(in: infoDictionary)
    48	    guard let channelValue = infoDictionary[preReleaseChannelKey] else {
    49	      return ReluxUpdateFeedPolicy(stableFeedURL: stableFeedURL, preReleaseChannel: nil)
    50	    }
    51	    guard
    52	      let channel = channelValue as? String,
    53	      !channel.isEmpty,
    54	      channel.range(of: #"^[A-Za-z0-9._-]+$"#, options: .regularExpression) != nil
    55	    else {
    56	      throw ReluxProxyUpdaterConfigurationError.invalidPreReleaseChannel
    57	    }
    58	    return ReluxUpdateFeedPolicy(stableFeedURL: stableFeedURL, preReleaseChannel: channel)
    59	  }
    60	}
    61	
    62	enum ReluxProxyUpdaterLaunchPolicy {
    63	  static func shouldStartUpdater(environment: [String: String]) -> Bool {
    64	    environment["XCTestConfigurationFilePath"] == nil
    65	  }
    66	}
    67	
    68	@MainActor
    69	final class ReluxProxyUpdaterLifecycle {
    70	  let feedURL: URL
    71	  let settingsModel: ReluxUpdateSettingsModel
    72	  private let adapter: ReluxSparkleUpdaterAdapter
    73	
    74	  init(
    75	    infoDictionary: [String: Any],
    76	    startingUpdater: Bool = true,
    77	    preferences: (any ReluxUpdatePreferencesStoring)? = nil,
    78	    scheduler: (any ReluxUpdateScheduling)? = nil
    79	  ) throws {
    80	    let feedPolicy = try ReluxProxyUpdaterConfiguration.feedPolicy(in: infoDictionary)
    81	    feedURL = feedPolicy.stableFeedURL
    82	    _ = try ReluxProxyUpdaterConfiguration.publicEDKey(in: infoDictionary)
    83	    let presentationModel = ReluxUpdatePresentationModel()
    84	    let adapter = ReluxSparkleUpdaterAdapter(
    85	      presentationModel: presentationModel,
    86	      preReleaseChannel: feedPolicy.preReleaseChannel,
    87	      startingUpdater: startingUpdater,
    88	    )
    89	    self.adapter = adapter
    90	    settingsModel = ReluxUpdateSettingsModel(
    91	      feedPolicy: feedPolicy,
    92	      preferences: preferences ?? ReluxUserDefaultsUpdatePreferences(),
    93	      updater: adapter,
    94	      scheduler: scheduler ?? ReluxSparkleUpdateScheduler(),
    95	      presentationModel: presentationModel
    96	    )
    97	  }
    98	
    99	  var isControllerConstructed: Bool { adapter.isControllerConstructed }
   100	  var effectiveAutomaticallyChecksForUpdates: Bool {
   101	    adapter.automaticallyChecksForUpdates
   102	  }
   103	  var effectiveChannel: ReluxUpdateChannel { adapter.selectedChannel }
   104	}

