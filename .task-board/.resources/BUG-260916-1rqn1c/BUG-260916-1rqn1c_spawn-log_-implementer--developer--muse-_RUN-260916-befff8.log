{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc47","stream":{"kind":"session","id":"01a0aa16-3b54-7fb3-a8e8-7c1297771955"},"sequence":1150,"recorded_at":1780531400002295,"record_type":"event","durability":"durable","causation_id":"2c2593ed-ac6a-4422-9347-544e1af6ae8d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2c2593ed-ac6a-4422-9347-544e1af6ae8d","run_stream":{"kind":"run","id":"2c2593ed-ac6a-4422-9347-544e1af6ae8d"},"task_stream":{"kind":"task","id":"01a0aa1a-e229-7ac0-a694-a67221928049"},"task_id":"01a0aa1a-e229-7ac0-a694-a67221928049","event":{"kind":"output","task_id":"01a0aa1a-e229-7ac0-a694-a67221928049","chunk":"Read text file `scripts/tests/test_macos_build_diagnostics.py`.\n1|\"\"\"Behavioral diagnostics tests; fixtures never launch Xcode or activate a VPN.\"\"\"\n2|import os\n3|from pathlib import Path\n4|import shutil\n5|import subprocess\n6|import tempfile\n7|import unittest\n8|\n9|ROOT = Path(__file__).resolve().parents[2]\n10|\n11|\n12|class MacOSBuildDiagnosticsTests(unittest.TestCase):\n13|    def test_successful_child_retains_both_streams(self):\n14|        with tempfile.TemporaryDirectory() as directory:\n15|            log = Path(directory) / 'child.log'\n16|            result = subprocess.run(\n17|                ['sh', '-c', '. \"$1\"; run_logged_command \"$2\" sh -c '\n18|                 '\\'echo compiler-output; echo compiler-warning >&2\\'',\n19|                 'test', str(ROOT / 'scripts/logged-command.sh'), str(log)],\n20|                capture_output=True, text=True)\n21|            self.assertEqual(result.returncode, 0, result.stderr)\n22|            self.assertEqual(log.read_text(), 'compiler-output\\ncompiler-warning\\n')\n23|\n24|    def test_each_failing_build_and_test_retains_status_and_context(self):\n25|        self.assert_failing_build_and_test_status(65)\n26|\n27|    def test_exit_one_stops_each_build_and_test_with_exact_status(self):\n28|        self.assert_failing_build_and_test_status(1)\n29|\n30|    def assert_failing_build_and_test_status(self, status):\n31|        # Four unsigned builds followed by the target-contract test invocation.\n32|        for failing_call in range(1, 6):\n33|            with self.subTest(failing_call=failing_call), tempfile.TemporaryDirectory() as directory:\n34|                root = Path(directory)\n35|                scripts = root / 'scripts'\n36|                scripts.mkdir()\n37|                for name in ('validate-macos-targets.sh', 'logged-command.sh'):\n38|                    shutil.copyfile(ROOT / 'scripts' / name, scripts / name)\n39|                generate = scripts / 'generate-workspace.sh'\n40|                generate.write_text('#!/bin/sh\\nexit 0\\n')\n41|                generate.chmod(0o755)\n42|                binary = root / 'bin'\n43|                binary.mkdir()\n44|                xcodebuild = binary / 'xcodebuild'\n45|                xcodebuild.write_text('''#!/bin/sh\n46|count=0\n47|[ ! -f \"$COUNTER\" ] || count=$(cat \"$COUNTER\")\n48|count=$((count + 1))\n49|echo \"$count\" > \"$COUNTER\"\n50|echo \"compiler invocation $count: $*\"\n51|if [ \"$count\" -eq \"$FAIL_CALL\" ]; then\n52|  echo 'ConcreteCompile.swift:42: error: diagnostic sentinel' >&2\n53|  exit \"$FAIL_STATUS\"\n54|fi\n55|''')\n56|                xcodebuild.chmod(0o755)\n57|                counter = root / 'counter'\n58|                result = subprocess.run(\n59|                    ['sh', str(scripts / 'validate-macos-targets.sh')],\n60|                    env={**os.environ, 'PATH': f'{binary}:/usr/bin:/bin',\n61|                         'COUNTER': str(counter), 'FAIL_CALL': str(failing_call),\n62|                         'FAIL_STATUS': str(status)},\n63|                    capture_output=True, text=True)\n64|                self.assertEqual(result.returncode, status, result.stderr)\n65|                self.assertEqual(counter.read_text().strip(), str(failing_call))\n66|                self.assertIn('ConcreteCompile.swift:42: error: diagnostic sentinel', result.stderr)\n67|                self.assertIn(f'exit {status}', result.stderr)\n68|                logs = root / '.temp/TASK-260715-sbrrp7/credential-free-validation/logs/macos-targets'\n69|                self.assertEqual(len(list(logs.glob('*.log'))), failing_call)\n70|                self.assertTrue(any('diagnostic sentinel' in log.read_text()\n71|                                    for log in logs.glob('*.log')))\n72|\n73|\n74|if __name__ == '__main__':\n75|    unittest.main()","final_result":true}}}
