+      fileName: "relux-relay-darwin-amd64",
+      bundleLocation: "relay-assets-v1/relux-relay-darwin-amd64",
+      byteSize: 2623664,
+      sha256: "783b94982e90f0ceed0af0fa11662d11a333e244b87256cbfa0f7d21695f3290",
+      relayProtocolVersion: 1,
+      buildIdentity: RelayAssetBuildIdentity(
+        schemaVersion: 1,
+        relayProtocolVersion: 1,
+        relayVersion: "0.1.0",
+        sourceCommit: "58676a23e2e0fb3fcc1b5005d59c6ed56d3c0096",
+        operatingSystem: .darwin,
+        architecture: .amd64,
+        selfSHA256: "783b94982e90f0ceed0af0fa11662d11a333e244b87256cbfa0f7d21695f3290"),
+      buildProvenanceReference: "#/buildProvenance"),
+    RelayBundledAsset(
