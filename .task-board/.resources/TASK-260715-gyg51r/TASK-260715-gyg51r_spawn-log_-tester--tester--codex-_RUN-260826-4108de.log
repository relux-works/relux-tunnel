+    durationNanoseconds: 1,
+    requestedSendBufferBytes: 4_096,
+    effectiveSendBufferBytes: 4_096,
+    requestedReceiveBufferBytes: 4_096,
+    effectiveReceiveBufferBytes: 4_096,
+    packetsAttempted: 2,
+    packetsSent: 2,
+    packetsReceived: 2 - drops,
