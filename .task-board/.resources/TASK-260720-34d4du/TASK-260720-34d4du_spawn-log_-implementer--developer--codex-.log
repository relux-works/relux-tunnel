   134	            encryptionAlgorithmsClientToServer: encryptionAlgorithms,
   135	            encryptionAlgorithmsServerToClient: encryptionAlgorithms,
   136	            macAlgorithmsClientToServer: macAlgorithms,
   137	            macAlgorithmsServerToClient: macAlgorithms,
   138	            compressionAlgorithmsClientToServer: ["none"],
   139	            compressionAlgorithmsServerToClient: ["none"],
