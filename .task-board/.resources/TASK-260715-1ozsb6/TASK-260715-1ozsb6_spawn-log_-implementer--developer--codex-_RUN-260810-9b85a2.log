+    }
+
+    let result: Result<Value, Error>
+    do {
+      result = .success(try await group.next()!)
+    } catch {
+      result = .failure(error)
     }
-  } onCancel: {
-    race.cancel()
+    group.cancelAll()
+    while !group.isEmpty { _ = try? await group.next() }
+    return try result.get()
   }
 }
 
