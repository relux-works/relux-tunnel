+      isRetired = true
+      let waiters = Array(self.waiters.values)
+      self.waiters.removeAll()
+      return waiters
+    }
+    for waiter in waiters { waiter.resume() }
+  }
+
+  private enum RetirementRegistration {
+    case registered
+    case retired
+    case cancelled
+  }
+}
