{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc7f","stream":{"kind":"session","id":"01a0aa16-3b54-7fb3-a8e8-7c1297771955"},"sequence":1178,"recorded_at":1780531400002351,"record_type":"event","durability":"durable","causation_id":"2c2593ed-ac6a-4422-9347-544e1af6ae8d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2c2593ed-ac6a-4422-9347-544e1af6ae8d","run_stream":{"kind":"run","id":"2c2593ed-ac6a-4422-9347-544e1af6ae8d"},"task_stream":{"kind":"task","id":"01a0aa1a-f1ce-7d91-97d2-a098a81e7386"},"task_id":"01a0aa1a-f1ce-7d91-97d2-a098a81e7386","event":{"kind":"output","task_id":"01a0aa1a-f1ce-7d91-97d2-a098a81e7386","chunk":"Read text file `scripts/tests/test_pr6_boundary_mutants.py`.\n1|\"\"\"Behavioral narrowing mutants for BUG-260908-7c5iv4; no network or VPN use.\n2|\n3|Run: python3 scripts/tests/test_pr6_boundary_mutants.py\n4|Each mutant runs in a disposable fixture, never edits the active checkout, and\n5|must fail its named regression test. Swift tests exercise the production source.\n6|\"\"\"\n7|from pathlib import Path\n8|import shutil\n9|import subprocess\n10|import sys\n11|import tempfile\n12|\n13|ROOT = Path(__file__).resolve().parents[2]\n14|\n15|\n16|def run(command, root, expected, diagnostic):\n17|    result = subprocess.run(command, cwd=root, text=True, stdout=subprocess.PIPE,\n18|                            stderr=subprocess.STDOUT, timeout=240)\n19|    print(\"COMMAND:\", \" \".join(command), \"EXIT:\", result.returncode)\n20|    print(result.stdout)\n21|    if (result.returncode == 0) != (expected == 0) or diagnostic not in result.stdout:\n22|        raise SystemExit(\"mutant proof failed: unexpected exit or missing named diagnostic\")\n23|\n24|\n25|def main():\n26|    with tempfile.TemporaryDirectory(prefix=\"pr6-boundary-mutants-\") as temporary:\n27|        root = Path(temporary)\n28|        for relative in (\n29|            \"scripts/check_board_structure.py\", \"scripts/relay_supply_chain.py\",\n30|            \"scripts/tests/test_check_board_structure.py\",\n31|            \"scripts/tests/test_relay_supply_chain.py\", \"relay/supply-chain-source-v1.json\",\n32|            \"Sources/ReluxSnapshotDiffSupport/SnapshotDiff.swift\",\n33|        ):\n34|            target = root / relative\n35|            target.parent.mkdir(parents=True, exist_ok=True)\n36|            shutil.copy2(ROOT / relative, target)\n37|        board = root / \"scripts/check_board_structure.py\"\n38|        original = board.read_text()\n39|        command = [sys.executable, \"-m\", \"unittest\", \"-v\",\n40|                   \"scripts.tests.test_check_board_structure.BoardStructureTests.test_unknown_hidden_directory_is_not_exempt\"]\n41|        run(command, root, 0, \"OK\")\n42|        board.write_text(original.replace('(\".resources\", \".activity\")',\n43|                                          '(\".resources\", \".activity\", \".hidden\")'))\n44|        run(command, root, 1, \"FAIL: test_unknown_hidden_directory_is_not_exempt\")\n45|        board.write_text(original)\n46|        scanner = root / \"scripts/relay_supply_chain.py\"\n47|        original = scanner.read_text()\n48|        command = [sys.executable, \"-m\", \"unittest\", \"-v\",\n49|                   \"scripts.tests.test_relay_supply_chain.RelaySupplyChainTests.test_snapshot_support_network_mutants_preserve_file_tokens_and_fail\"]\n50|        run(command, root, 0, \"OK\")\n51|        scanner.write_text(original.replace(\"if explicit_local_url:\",\n52|                                            'if explicit_local_url or token_is(tokens, index + 2, \"referenceURL\"):'))\n53|        run(command, root, 1, \"FAIL: test_snapshot_support_network_mutants_preserve_file_tokens_and_fail\")\n54|        scanner.write_text(original)\n55|\n56|        package = root / \"snapshot\"\n57|        source = package / \"Sources/ReluxSnapshotDiffSupport/SnapshotDiff.swift\"\n58|        test = package / \"Tests/ReluxSnapshotDiffSupportTests/SnapshotDiffSupportTests.swift\"\n59|        for target, relative in ((source, \"Sources/ReluxSnapshotDiffSupport/SnapshotDiff.swift\"),\n60|                                 (test, \"Tests/ReluxSnapshotDiffSupportTests/SnapshotDiffSupportTests.swift\")):\n61|            target.parent.mkdir(parents=True, exist_ok=True)\n62|            shutil.copy2(ROOT / relative, target)\n63|        (package / \"Package.swift\").write_text('''// swift-tools-version: 6.1\n64|import PackageDescription\n65|let package = Package(name: \"SnapshotBoundaryProof\", platforms: [.macOS(.v15)], targets: [\n66|  .target(name: \"ReluxSnapshotDiffSupport\"),\n67|  .testTarget(name: \"ReluxSnapshotDiffSupportTests\", dependencies: [\"ReluxSnapshotDiffSupport\"]),\n68|])\n69|''')\n70|        command = [\"swift\", \"test\", \"--package-path\", str(package)]\n71|        run(command, root, 0, \"Test run with 3 tests\")\n72|        # Keep isFileURL and the refusal; admit only HTTP from the forbidden schemes.\n73|        source.write_text(source.read_text().replace(\"guard url.isFileURL else\",\n74|                                                     'guard url.isFileURL || url.scheme == \"http\" else'))\n75|        run(command, root, 1, \"expected nonFileURL before I/O\")\n76|    print(\"All three narrowing mutants killed by named behavioral regressions.\")\n77|\n78|\n79|if __name__ == \"__main__\":\n80|    main()","final_result":true}}}
