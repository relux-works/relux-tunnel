index 0000000000000000000000000000000000000000..3497e95255268fa1a91f8b8a581cf606793dfdb8
--- /dev/null
+++ b/.temp/TASK-260715-3bdplx/hello_udp.go
@@ -0,0 +1,65 @@
+package main
+
+import (
+	"bufio"
+	"fmt"
+	"net"
+	"os"
+	"time"
+)
+
+func fail(stage string, err error) {
+	fmt.Fprintf(os.Stderr, "%s: %v\n", stage, err)
+	os.Exit(1)
+}
+
+func main() {
+	line, err := bufio.NewReader(os.Stdin).ReadString('\n')
+	if err != nil {
+		fail("stdio read", err)
+	}
+	fmt.Printf("stdio:%s", line)
+
+	server, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.ParseIP("127.0.0.1")})
+	if err != nil {
+		fail("udp listen", err)
+	}
+	defer server.Close()
+
+	client, err := net.DialUDP("udp4", nil, server.LocalAddr().(*net.UDPAddr))
+	if err != nil {
+		fail("udp dial", err)
+	}
+	defer client.Close()
+
+	deadline := time.Now().Add(2 * time.Second)
+	if err := server.SetReadDeadline(deadline); err != nil {
+		fail("udp server deadline", err)
+	}
+	if err := client.SetReadDeadline(deadline); err != nil {
+		fail("udp client deadline", err)
+	}
+
+	payload := []byte("relux-udp-proof")
+	if _, err := client.Write(payload); err != nil {
+		fail("udp write", err)
+	}
+
+	buffer := make([]byte, 64)
+	n, peer, err := server.ReadFromUDP(buffer)
+	if err != nil {
+		fail("udp receive", err)
+	}
+	if _, err := server.WriteToUDP(buffer[:n], peer); err != nil {
+		fail("udp echo", err)
+	}
+
+	n, err = client.Read(buffer)
+	if err != nil {
+		fail("udp reply", err)
+	}
+	if string(buffer[:n]) != string(payload) {
+		fail("udp payload", fmt.Errorf("got %q", buffer[:n]))
+	}
+	fmt.Println("udp:ok")
+}
