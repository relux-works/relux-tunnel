   118	class ProviderError(fixture.FixtureError):
   119	    """A provider failure whose message is safe to persist."""
   120	
   121	
   122	def _run(
   123	    arguments: list[str],
   124	    *,
   125	    input_bytes: bytes | None = None,
   126	    timeout: int = 30,
   127	) -> subprocess.CompletedProcess[bytes]:
   128	    try:
   129	        completed = subprocess.run(
   130	            arguments,
   131	            input=input_bytes,
   132	            stdout=subprocess.PIPE,
   133	            stderr=subprocess.PIPE,
   134	            timeout=timeout,
   135	            check=False,
   136	        )
   137	    except (OSError, subprocess.TimeoutExpired) as error:
   138	        raise ProviderError("fixture command failed safely") from error
   139	    if completed.returncode != 0:
   140	        raise ProviderError(
   141	            f"fixture command exited {completed.returncode}; output redacted"
   142	        )
   143	    return completed
   144	
   145	
   146	def _free_port() -> int:
   147	    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as listener:
   148	        listener.bind(("127.0.0.1", 0))
   149	        return listener.getsockname()[1]
   150	
   151	
   152	def _fingerprint_blob(encoded: str) -> str:
   153	    try:
   154	        blob = base64.b64decode(encoded, validate=True)
   155	    except ValueError as error:
   156	        raise ProviderError("invalid public host-key encoding") from error
   157	    digest = base64.b64encode(hashlib.sha256(blob).digest()).decode().rstrip("=")
   158	    return f"SHA256:{digest}"
   159	
   160	
   161	def _fingerprint_public_key(path: Path) -> str:
   162	    fields = path.read_text(encoding="utf-8").split()
   163	    if len(fields) < 2:
   164	        raise ProviderError("generated public host key is malformed")
   165	    return _fingerprint_blob(fields[1])
   166	
   167	
   168	def _scan_fingerprints(host: str, port: int) -> list[str]:
   169	    scanned = _run(
   170	        ["/usr/bin/ssh-keyscan", "-T", "5", "-p", str(port), host], timeout=10
   171	    ).stdout.decode("utf-8", errors="strict")
   172	    fingerprints = []
   173	    for line in scanned.splitlines():
   174	        if not line or line.startswith("#"):
   175	            continue
   176	        fields = line.split()
   177	        if len(fields) >= 3:
   178	            fingerprints.append(_fingerprint_blob(fields[2]))
   179	    if not fingerprints:
   180	        raise ProviderError("pre-auth host-key scan returned no public keys")
   181	    return sorted(set(fingerprints))
   182	
   183	
   184	def _parse_key_values(encoded: bytes) -> dict[str, str]:
   185	    values = {}
   186	    for line in encoded.decode("utf-8", errors="strict").splitlines():
   187	        key, separator, value = line.partition("=")
   188	        if separator and key:
   189	            values[key] = value
   190	    return values
   191	
   192	
   193	def _ssh_version() -> str:
   194	    completed = subprocess.run(
   195	        ["/usr/bin/ssh", "-V"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False
   196	    )
   197	    text = (completed.stderr or completed.stdout).decode("utf-8", errors="replace")
   198	    match = re.search(r"OpenSSH_[^,\s]+", text)
   199	    if completed.returncode != 0 or match is None:
   200	        raise ProviderError("unable to observe the local OpenSSH version")
   201	    return match.group(0)
