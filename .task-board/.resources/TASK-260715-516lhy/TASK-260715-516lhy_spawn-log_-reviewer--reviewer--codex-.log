   156	  @Test("HEV structure is validated before local and protocol DATA limits")
   157	  func structuralValidationPrecedesPayloadLimits() throws {
   158	    let limitCases: [(String, UInt16, UInt16)] = [
   159	      ("lowered local cap", P.maxUDPPayloadFloor, P.maxUDPPayloadFloor + 1),
   160	      (
   161	        "protocol ceiling",
   162	        P.maxUDPPayloadClientDefault,
   163	        P.maxUDPPayloadClientHardCeiling + 1
   164	      ),
   165	    ]
   166	
   167	    for (limitName, maximumPayloadLength, declaredMessageLength) in limitCases {
   168	      for malformed in malformedStructuralRecords(messageLength: declaredMessageLength) {
   169	        var codec = try RelayDatagramCodec(maximumPayloadLength: maximumPayloadLength)
   170	        expectFailure(
   171	          malformed.code,
   172	          scope: .association,
   173	          disposition: .closeAssociation
   174	        ) {
   175	          _ = try codec.decode(malformed.record)
   176	        }
   177	        #expect(
   178	          codec.metrics.decodedMaterializedBytes == 0,
   179	          "\(limitName): \(malformed.name)"
   180	        )
   181	        #expect(codec.metrics.decodedRecords == 0, "\(limitName): \(malformed.name)")
   182	        #expect(codec.metrics.failures == 1, "\(limitName): \(malformed.name)")
   183	      }
   184	    }
   185	
   186	    let protocolOversizedData = patternedData(
   187	      count: Int(P.maxUDPPayloadClientHardCeiling) + 1
   188	    )
   189	    let structurallyValidRecord = hevOracle(
   190	      headerTail: vectorEndpoints()[0].headerTail,
   191	      data: protocolOversizedData
   192	    )
   193	    var codec = try RelayDatagramCodec()
   194	    expectFailure(
   195	      .messageLengthExceedsProtocolMaximum,
   196	      scope: .association,
