    let transport =
      try await LibSSH2TransportFactory(maximumTransportBufferBytes: 64 * 1_024)
      .makeTransport(
        lane: SSHLaneIdentity(rawValue: UUID()),
        dependencies: fixtureDependencies(
          port: server.port,
          credential: credential,
