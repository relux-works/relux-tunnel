   285	private final class RealHEVBridgeHarness: @unchecked Sendable {
   286	  let adapter: IntegrationSOCKSAdapter
   287	  let accessRecorder = BoundaryAccessRecorder()
   288	  let driver: IntegrationPacketFlowDriver
   289	  let lifecycleRecorder = IntegrationLifecycleRecorder()
   290	  let metrics = IntegrationMetrics()
   291	  let bridge: PacketFlowBridge
   292	  private let flow: MacOSPacketFlowAdapter
   293	
   294	  init(
   295	    adapterMode: IntegrationSOCKSAdapter.Mode = .respond,
   296	    socketBufferBytes: Int = 16_384,
   297	    rejectPacketWrites: Bool = false
   298	  ) {
   299	    adapter = IntegrationSOCKSAdapter(mode: adapterMode)
   300	    driver = IntegrationPacketFlowDriver(rejectWrites: rejectPacketWrites)
   301	    flow = MacOSPacketFlowAdapter(driver: driver)
   302	    let credentials = HEVSOCKSCredentials(
   303	      username: "relux-integration-user",
   304	      password: "relux-integration-password"
   305	    )
   306	    let factory = CapturingBoundaryFactory(
   307	      adapter: adapter,
   308	      credentials: credentials,
   309	      recorder: accessRecorder
   310	    )
   311	    let consumer = HEVDescriptorBorrowConsumer(
   312	      configuration: InternalSOCKSConfiguration(
   313	        mtuBytes: 1_500,
   314	        taskStackSizeBytes: 24_576,
   315	        tcpBufferSizeBytes: 4_096,
   316	        udpCopyBufferCount: 2,
   317	        maximumSessionCount: 1_200
   318	      ),
   319	      boundaryFactory: factory,
   320	      runtime: PinnedHEVNativeRuntime(),
   321	      logger: IntegrationLogger(),
   322	      metrics: metrics
   323	    )
   324	    bridge = PacketFlowBridge(
   325	      descriptorConsumer: consumer,
   326	      clock: ContinuousTunnelClock(),
   327	      logger: IntegrationLogger(),
   328	      metrics: metrics,
   329	      runIDSource: FixedIntegrationRunIDSource(),
   330	      lifecycleBarrier: lifecycleRecorder
   331	    )
   332	    configuration = PacketBridgeConfiguration(
   333	      mtu: 1_500,
   334	      sendBufferBytes: socketBufferBytes,
   335	      receiveBufferBytes: socketBufferBytes,
   336	      maximumWorkCount: 64,
   337	      workTimeBudget: .milliseconds(5),
   338	      diagnosticsWindow: .seconds(60)
   339	    )
   340	  }
   341	
   342	  let configuration: PacketBridgeConfiguration
   343	
   344	  func start() async throws -> PacketFlowBridgeRunHandle {
   345	    try await bridge.start(packetFlow: flow, configuration: configuration)
   346	  }
   347	
   348	  func stop(_ handle: PacketFlowBridgeRunHandle) async {
   349	    await bridge.stop()
   350	    try? await handle.waitForTermination()
   351	  }
   352	
   353	  func ownedResourceSnapshot() async -> OwnedResourceSnapshot {
   354	    let access = accessRecorder.snapshot()
   355	    let driver = driver.snapshot()
   356	    let bridgeMetrics = await bridge.metrics()
   357	    return OwnedResourceSnapshot(
   358	      boundaryStarts: access.starts,
   359	      boundaryStops: access.stops,
   360	      liveSOCKSChannels: adapter.liveChannelCount,
   361	      queuedPacketBatches: driver.queuedBatchCount,
   362	      outstandingPacketReads: driver.outstandingReadCount,
   363	      reachedHEVDescriptorClosed: lifecycleRecorder.reached(.hevDescriptorClosed),
   364	      reachedBridgeDescriptorClosed: lifecycleRecorder.reached(.bridgeDescriptorClosed),
   365	      cleanupCloseErrors: bridgeMetrics.counters[
   366	        "packet_bridge_cleanup_close_error_total", default: 0]
   367	    )
   368	  }
   369	}
