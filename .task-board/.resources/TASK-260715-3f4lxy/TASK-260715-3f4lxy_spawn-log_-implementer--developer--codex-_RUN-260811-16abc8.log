+import Darwin
+import Foundation
+
+public enum SSHProfileHostKind: String, Codable, CaseIterable, Sendable {
+  case dns
+  case ipv4
+  case ipv6
+}
+
+public struct SSHProfileCanonicalHost: Equatable, Sendable {
