+    let packet = makeUDPPacket(
+      family: .ipv4,
+      source: source,
+      destination: destination,
+      sourcePort: 53_000,
+      destinationPort: 53,
+      payload: payload
+    )
+    try harness.driver.deliver(packet)
+
+    let session = try await harness.adapter.nextSession()
+    #expect(session.request.command == .forwardUDP)
