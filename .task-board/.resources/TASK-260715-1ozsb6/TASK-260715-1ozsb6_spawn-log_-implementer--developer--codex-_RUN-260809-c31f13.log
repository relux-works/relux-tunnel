   908	/// Exact consumer-earned receive-credit policy. Adapters that cannot suppress
   909	/// engine-owned automatic adjustment use an explicit deferred state instead.
   910	public struct SSHConsumerReceiveWindowPolicy: Equatable, Sendable {
