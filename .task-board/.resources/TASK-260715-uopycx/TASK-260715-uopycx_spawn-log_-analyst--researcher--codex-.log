   262	static void
   263	hev_socks5_session_udp_splice (HevSocks5Session *base)
   264	{
   265	    HevSocks5SessionUDP *self = HEV_SOCKS5_SESSION_UDP (base);
   266	    HevTask *task = hev_task_self ();
   267	    int res_f = 1, res_b = 1;
   268	    int num;
   269	    int fd;
   270	
   271	    LOG_D ("%p socks5 session udp splice", self);
   272	
   273	    num = hev_config_get_misc_udp_copy_buffer_nums ();
   274	    fd = hev_socks5_udp_get_fd (HEV_SOCKS5_UDP (self));
   275	    if (hev_task_mod_fd (task, fd, POLLIN | POLLOUT) < 0)
   276	        hev_task_add_fd (task, fd, POLLIN | POLLOUT);
   277	
   278	    for (;;) {
   279	        HevTaskYieldType type;
   280	
   281	        if (res_f >= 0)
   282	            res_f = hev_socks5_session_udp_fwd_f (self, num);
   283	        if (res_b >= 0)
   284	            res_b = hev_socks5_session_udp_fwd_b (self, num);
   285	
   286	        if (res_f > 0 || res_b > 0)
   287	            type = HEV_TASK_YIELD;
   288	        else if ((res_f & res_b) == 0)
   289	            type = HEV_TASK_WAITIO;
   290	        else
   291	            break;
   292	
   293	        if (task_io_yielder (type, self))
   294	            break;
   295	    }
   296	}
