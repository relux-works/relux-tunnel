nt) async\n49|}\n50|\n51|public protocol TunnelRuntimeHealthProviding: AnyObject, Sendable {\n52|  func health() async -> TunnelRuntimeComponentHealth\n53|}\n54|\n55|public protocol ConfigurationSnapshotSource: Sendable {\n56|  func loadValidatedSnapshot(\n57|    for reference: TunnelConfigurationReference\n58|  ) async throws -> RuntimeConfigurationSnapshot\n59|}\n60|\n61|public protocol SSHBootstrapSession: TunnelRuntimeHealthProviding {\n62|  var connectedEndpoint: TunnelEndpoint { get }\n63|  func close() async\n64|}\n65|\n66|public protocol SSHBootstrap: Sendable {\n67|  func authenticate(\n68|    configuration: RuntimeConfigurationSnapshot,\n69|    runtimeGeneration: UInt64,\n70|    healthSink: any TunnelRuntimeHealthEventSink\n71|  ) async throws -> any SSHBootstrapSession\n72|}\n73|\n74|public protocol TCPConsumer: TunnelRuntimeHealthProviding {\n75|  func closeAdmission() async\n76|  func stop() async\n77|}\n78|\n79|public protocol TCPConsumerFactory: Sendable {\n80|  func prepare(\n81|    session: any SSHBootstrapSession,\n82|    runtimeGeneration: UInt64,\n83|    healthSink: any TunnelRuntimeHealthEventSink\n84|  ) async throws -> any TCPConsumer\n85|}\n86|\n87|public protocol DNSConsumer: TunnelRuntimeHealthProviding {\n88|  func closeAdmission() async\n89|  func stop() async\n90|}\n91|\n92|public protocol DNSConsumerFactory: Sendable {\n93|  /// Returns only after safe DNS is ready with an SSH-only upstream.\n94|  func prepareSafeDNS(\n95|    session: any SSHBootstrapSession,\n96|    runtimeGeneration: UInt64,\n97|    healthSink: any TunnelRuntimeHealthEventSink\n98|  ) async throws -> any DNSConsumer\n99|}\n100|\n101|public protocol M1PacketPlaneSession: TunnelRuntimeHealthProviding {\n102|  /// Activates the private packet plane and returns only after packet reads are registered.\n103|  func activateReads(packetFlow: any PacketFlow) async throws\n104|\n105|  /// Stops reads, bridge pumps, native work, sockets, and private admission.\n106|  func stop() async\n107|}\n108|\n109|public protocol M1PacketPlaneFactory: Sendable {\n110|  /// Performs preparation without acquiring packet reads or native runtime resources.\n111|  func prepare(\n112|    configuration: RuntimeConfigurationSnapshot,\n113|    tcp: any TCPConsumer,\n114|    dns: any DNSConsumer,\n115|    runtimeGeneration: UInt64,\n116|    healthSink: any TunnelRuntimeHealthEventSink\n117|  ) async throws -> any M1PacketPlaneSession\n118|}\n119|\n120|public protocol NetworkSettingsPlan: Sendable {}\n121|\n122|public protocol NetworkSettingsPlanBuilder: Sendable {\n123|  func makePlan(\n124|    configuration: RuntimeConfigurationSnapshot,\n125|    connectedEndpoint: TunnelEndpoint,\n126|    runtimeGeneration: UInt64\n127|  ) throws -> any NetworkSettingsPlan\n128|}\n129|\n130|public enum NetworkSettingsCommitDisposition: Equatable, Sendable {\n131|  case notCommitted\n132|  case committed\n133|  case uncertain\n134|}\n135|\n136|/// Apply errors can provide a definitive commit disposition. Unknown errors are\n137|/// conservatively treated as uncertain and require a clear request.\n138|public protocol NetworkSettingsCommitDescribingError: Error, Sendable {\n139|  var commitDisposition: NetworkSettingsCommitDisposition { get }\n140|}\n141|\n142|public protocol NetworkSettingsApplier: Sendable {\n143|  func apply(\n144|    _ plan: any NetworkSettingsPlan,\n145|    runtimeGeneration: UInt64\n146|  ) async throws\n147|\n148|  func clear(runtimeGeneration: UInt64) async throws\n149|}\n150|\n151|public struct TunnelRuntimePublishedSnapshot: Equatable, Sendable {\n152|  public let lifecycle: RuntimeLifecycleSnapshot\n153|  public let capabilities: RuntimeCapabilitySnapshot\n154|\n155|  public init(\n156|    lifecycle: RuntimeLifecycleSnapshot,\n157|    capabilities: RuntimeCapabilitySnapshot\n158|  ) {\n159|    precondition(lifecycle.position == capabilities.position)\n160|    self.lifecycle = lifecycle\n161|    self.capabilities = capabilities\n162|  }\n163|\n164|  public var position: RuntimeSnapshotPosition {\n165|    lifecycle.position\n166|  }\n167|}\n168|\n169|public protocol RuntimeSnapshotStore: Sendable {\n170|  func publish(_ snapshot: TunnelRuntimePublishedSnapshot) async\n171|}\n172|\n173|/// Provider-instance snapshot authority. Older generations and repeated or\n174|/// out-of-order sequence values cannot replace the active immutable snapshot.\n175|public actor LatestRuntimeSnapshotStore: RuntimeSnapshotStore {\n176|  private var latestSnapshot: TunnelRuntimePublishedSnapshot?\n177|\n178|  public init() {}\n179|\n180|  public func publish(_ snapshot: TunnelRuntimePublishedSnapshot) {\n181|    guard snapshot.position.isNewer(than: latestSnapshot?.position) else {\n182|      return\n183|    }\n184|    latestSnapshot = snapshot\n185|  }\n186|\n187|  public func latest() -> TunnelRuntimePublishedSnapshot? {\n188|    latestSnapshot\n189|  }\n190|}\n191|\n192|extension LatestRuntimeSnapshotStore: ProviderRuntimeSnapshotSource {\n193|  public func latestProviderSnapshot() -> TunnelRuntimePublishedSnapshot? {\n194|    latestSnapshot\n195|  }\n196|}\n197|\n198|public struct TunnelRuntimeCoordinatorDependencies: Sendable {\n199|  public let configurationSource: any ConfigurationSnapshotSource\n200|  public let sshBootstrap: any SSHBootstrap\n201|  public let tcpFactory: any TCPConsumerFactory\n202|  public let dnsFactory: any DNSConsumerFactory\n203|  public let packetPlaneFactory: any M1PacketPlaneFactory\n204|  public let settingsPlanBuilder: any NetworkSettingsPlanBuilder\n205|  public let settingsApplier: any NetworkSettingsApplier\n206|  public let snapshotStore: any RuntimeSnapshotStore\n207|\n208|  public init(\n209|    configurationSource: any ConfigurationSnapshotSource,\n210|    sshBootstrap: any SSHBootstrap,\n211|    tcpFactory: any TCPConsumerFactory,\n212|    dnsFactory: any DNSConsumerFactory,\n213|    packetPlaneFactory: any M1PacketPlaneFactory,\n214|    settingsPlanBuilder: any NetworkSettingsPlanBuilder,\n215|    settingsApplier: any NetworkSettingsApplier,\n216|    snapshotStore: any RuntimeSnapshotStore\n217|  ) {\n218|    self.configurationSource = configurationSource\n219|    self.sshBootstrap = sshBootstrap\n220|    self.tcpFactory = tcpFactory\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
