   229	static int
   230	hev_socks5_name_resolve_ipv4 (const char *name, struct sockaddr_in6 *saddr)
   231	{
   232	    int res;
   233	
   234	    memset (&saddr->sin6_addr, 0, 10);
   235	    res = inet_pton (AF_INET, name, &saddr->sin6_addr.s6_addr[12]);
   236	    if (res == 0)
   237	        return -1;
   238	
   239	    saddr->sin6_addr.s6_addr[10] = 0xff;
   240	    saddr->sin6_addr.s6_addr[11] = 0xff;
   241	
   242	    return 0;
   243	}
