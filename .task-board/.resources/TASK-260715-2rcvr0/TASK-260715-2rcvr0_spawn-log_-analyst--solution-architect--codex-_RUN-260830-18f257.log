  1185	  private let requiresCanonicalStrings: Bool
  1186	  private let requiresCanonicalNumbers: Bool
  1187	  private var index = 0
  1188	  private var allObjectKeys: Set<String> = []
  1189	  private var sawInsignificantWhitespace = false
  1190	
  1191	  init(
  1192	    bytes: [UInt8],
  1193	    maximumDepth: Int,
  1194	    requiresSortedKeys: Bool,
  1195	    allowsInsignificantWhitespace: Bool,
  1196	    requiresCanonicalStrings: Bool,
  1197	    requiresCanonicalNumbers: Bool
  1198	  ) {
  1199	    self.bytes = bytes
  1200	    self.maximumDepth = maximumDepth
  1201	    self.requiresSortedKeys = requiresSortedKeys
  1202	    self.allowsInsignificantWhitespace = allowsInsignificantWhitespace
  1203	    self.requiresCanonicalStrings = requiresCanonicalStrings
  1204	    self.requiresCanonicalNumbers = requiresCanonicalNumbers
  1205	  }
