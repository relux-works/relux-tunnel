   712	private struct RecordedUDPSubmission: Sendable {
   713	  let envelope: RelayEnvelope
   714	  let generation: UInt64
   715	}
   716	
   717	private final class RecordingUDPRelay: HEVUDPRelaySink, @unchecked Sendable {
   718	  private struct State {
   719	    var submissions: [RecordedUDPSubmission] = []
   720	    var waiters: [CheckedContinuation<RecordedUDPSubmission, Never>] = []
   721	    var nextResult = HEVUDPRelaySubmissionResult.accepted
   722	  }
   723	
   724	  private let state = Mutex(State())
   725	
   726	  func submit(
   727	    _ envelope: RelayEnvelope,
   728	    generation: UInt64
   729	  ) -> HEVUDPRelaySubmissionResult {
   730	    let submission = RecordedUDPSubmission(envelope: envelope, generation: generation)
   430	    }
   431	  }
   432	
   433	  fileprivate func releaseInbound(_ charge: UInt32) {
   434	    lock.withLock {
   435	      inboundQueuedBytes = charge > inboundQueuedBytes ? 0 : inboundQueuedBytes - charge
   436	    }
   437	  }
   438	
   439	  fileprivate func recordInputQueueSaturation() {
   440	    recordMetric {
   441	      $0.inputQueueSaturatedDropped = incremented($0.inputQueueSaturatedDropped)
   442	    }
   443	  }
   444	
   445	  fileprivate func reserveOutbound(_ charge: UInt32) -> Bool {
   446	    lock.withLock {
   447	      let (next, overflow) = outboundQueuedBytes.addingReportingOverflow(charge)
   448	      guard !overflow, next <= configuration.limits.aggregateQueuedBytes else {
   449	        return false
   450	      }
   451	      outboundQueuedBytes = next
   452	      metrics.peakOutboundQueuedBytes = max(metrics.peakOutboundQueuedBytes, next)
   453	      return true
   454	    }
   455	  }
   456	
   457	  fileprivate func releaseOutbound(_ charge: UInt32) {
   458	    lock.withLock {
   459	      outboundQueuedBytes = charge > outboundQueuedBytes ? 0 : outboundQueuedBytes - charge
   460	    }
   461	  }
   462	
   463	  fileprivate func processInbound(
   464	    _ record: Data,
   465	    from connection: HEVUDPAssociationConnection
   466	  ) async {
   467	    do {
   468	      var codec = try RelayDatagramCodec(
   469	        maximumPayloadLength: configuration.limits.maxUDPPayload
   470	      )
   471	      _ = try codec.decode(record)
   472	    } catch {
   473	      recordMalformedInbound()
   474	      connection.close(notifyRegistry: true)
   475	      return
   476	    }
   477	
   478	    let admission = await registry.admit(connection.handle, generation: generation)
   479	    let key: ClientUDPAssociationKey
   480	    switch admission {
   481	    case .success(let admitted):
   482	      key = admitted
   483	    case .failure:
   484	      recordMetric { $0.associationRejected = incremented($0.associationRejected) }
   485	      connection.close(notifyRegistry: false)
   486	      return
   487	    }
   488	    connection.setKey(key)
   489	    guard connection.matches(key) else {
   490	      _ = await registry.closeLocally(key)
   491	      return
   492	    }
   493	    guard case .applied = await registry.recordActivity(for: key) else { return }
   494	
   495	    let result = relay.submit(
   496	      RelayEnvelope(
   497	        type: .udpDatagram,
   498	        associationID: key.associationID,
   499	        payload: record
   500	      ),
   501	      generation: generation
   502	    )
   503	    switch result {
   504	    case .accepted:
   505	      recordMetric { $0.datagramsSubmitted = incremented($0.datagramsSubmitted) }
   506	    case .queueSaturated:
   507	      recordMetric {
   508	        $0.relayQueueSaturatedDropped = incremented($0.relayQueueSaturatedDropped)
   509	      }
   510	    case .sessionUnavailable:
   511	      recordMetric { $0.relayUnavailable = incremented($0.relayUnavailable) }
   512	      _ = await registry.closeLocally(key)
   513	    }
   514	  }
   515	
   516	  fileprivate func connectionClosed(
   517	    _ connection: HEVUDPAssociationConnection,
   518	    notifyRegistry: Bool,
   519	    inboundCharge: UInt32,
   520	    outboundCharge: UInt32
   521	  ) {
   522	    lock.withLock {
   523	      if connections[connection.handle] === connection {
   524	        connections.removeValue(forKey: connection.handle)
   525	      }
   526	      inboundQueuedBytes =
   527	        inboundCharge > inboundQueuedBytes
   528	        ? 0 : inboundQueuedBytes - inboundCharge
   529	      outboundQueuedBytes =
   530	        outboundCharge > outboundQueuedBytes
   531	        ? 0 : outboundQueuedBytes - outboundCharge
   532	      if notifyRegistry {
   533	        metrics.localCloses = incremented(metrics.localCloses)
   534	      }
   535	    }
   536	    guard notifyRegistry, let key = connection.key else { return }
   537	    Task { [registry] in
   538	      _ = await registry.closeLocally(key)
   539	    }
   540	  }
   541	
   542	  fileprivate func closeHEV(
   543	    _ handle: HEVUDPAssociationHandle,
   544	    reason: ClientUDPAssociationCleanupReason
   545	  ) {
   546	    let connection = lock.withLock { connections[handle] }
   547	    connection?.requestClose(notifyRegistry: false)
   548	    _ = reason
   549	  }
   550	
   551	  fileprivate func cleanupRelay(_ cleanup: ClientUDPAssociationRelayCleanup) {
   552	    guard cleanup.shouldSendClose else { return }
   553	    _ = relay.submit(
   554	      RelayEnvelope(
   555	        type: .closeAssociation,
   556	        associationID: cleanup.key.associationID
   557	      ),
   558	      generation: cleanup.key.generation
   559	    )
   560	  }
   561	
   562	  private func recordMetric(
   563	    _ update: (inout HEVUDPDatagramAdapterMetrics) -> Void
   564	  ) {
   565	    lock.withLock { update(&metrics) }
   566	  }
   567	
   568	  private func recordRemoteEvent(
   569	    _ result: ClientUDPAssociationEventResult,
   570	    applied update: (inout HEVUDPDatagramAdapterMetrics) -> Void
   571	  ) {
   572	    recordMetric {
   573	      switch result {
   574	      case .applied:
   575	        update(&$0)
   576	      case .ignoredStaleGeneration, .ignoredUnknownAssociation, .ignoredState:
   577	        $0.lateCallbacks = incremented($0.lateCallbacks)
   578	      }
   579	    }
   580	  }
   581	
   582	  private func observeNonterminalRelayError(
   583	    associationID: UInt32,
   584	    generation callbackGeneration: UInt64
   585	  ) async -> ClientUDPAssociationEventResult {
   586	    let resolution = await registry.observeActiveAssociation(
   587	      associationID: associationID,
   588	      generation: callbackGeneration
   589	    )
   590	    switch resolution {
   591	    case .resolved(let handle, let key):
   592	      let connection = lock.withLock { connections[handle] }
   593	      guard let connection, connection.matches(key) else {
   594	        return .ignoredUnknownAssociation
   595	      }
   596	      return .applied(key: key, from: .active, to: .active)
   597	    case .staleGeneration:
   598	      return .ignoredStaleGeneration
   599	    case .unknownAssociation:
   600	      return .ignoredUnknownAssociation
   601	    case .unavailable(let state):
   602	      return .ignoredState(state)
   603	    }
   604	  }
   605	
   606	  private func closeUnadmittedConnections() {
   607	    let candidates = lock.withLock { Array(connections.values) }
   608	    let unadmitted = candidates.filter { $0.key == nil }
   609	    for connection in unadmitted {
   610	      connection.close(notifyRegistry: false)
   611	    }
   612	  }
   613	}
   614	
   615	private final class HEVUDPAdapterCallbackRouter: @unchecked Sendable {
   616	  weak var adapter: HEVUDPDatagramAdapter?
