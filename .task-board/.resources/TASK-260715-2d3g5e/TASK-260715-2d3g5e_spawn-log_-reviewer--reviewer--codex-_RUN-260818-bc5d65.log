relay-toolchain-licenses:
	python3 scripts/relay_release.py extract-licenses --go "$(RELAY_GO)" --go-toolchain "$(RELAY_GO_TOOLCHAIN)" --output "$(RELAY_TOOLCHAIN_LICENSE_OUTPUT)"

relay-toolchain-native-linux-smoke:
