   255	def aggregate_file_records(records: list[dict[str, Any]], revision: str) -> str:
   256	    lines = []
   257	    for record in records:
   258	        contents = git_bytes(revision, record["path"])
   259	        digest = sha256_bytes(contents)
   260	        if digest != record["sha256"]:
   261	            raise SupplyChainError(f"pinned source hash mismatch: {record['path']}")
   262	        lines.append(f"{digest}  {record['path']}\n")
   263	    return sha256_bytes("".join(lines).encode("utf-8"))
