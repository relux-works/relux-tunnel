#!/bin/sh
set -eu

doc=docs/TASK-260715-whtdsf_ci-trust-and-quality-gate-contract.md

inventory_rows=$(awk '
  /^## 3\./ { in_inventory=1 }
  /^## 4\./ { in_inventory=0 }
  in_inventory && /^\| `/ { count++; pipes=gsub(/\|/, "|"); if (pipes != 7) bad=1 }
  END { if (bad || count != 26) exit 1; print count }
' "$doc")

required_checks=$(awk '
  /^## 4\./ { in_checks=1; next }
  /^## 5\./ { in_checks=0 }
  in_checks && /^[1-9]\. `/ { count++ }
  END { if (count != 9) exit 1; print count }
' "$doc")

trace_rows=$(awk '
  /^## 5\./ { in_trace=1 }
  /^## 6\./ { in_trace=0 }
  in_trace && /^\| [^:-]/ && !/^\| Epic/ && !/^\| ---/ {
    count++
    split($0, cell, "|")
    ticks=gsub(/`/, "`", cell[3])
    if (ticks != 2) bad=1
  }
  END { if (bad || count < 16) exit 1; print count }
' "$doc")

for phrase in \
  'Forked code' \
  'Mutable action' \
  'Cache poisoning' \
  'Artifact substitution' \
  'Tag/workflow spoofing or race' \
  'Rerun' \
  'Cancellation/timeout/runner loss' \
  'Concurrent releases' \
  'Compromised low-privilege credential' \
  'repository_dispatch: types: [relux_release_request]' \
  'Contents: write' \
  'public Internet egress' \
  'github.workflow_sha' \
  'full-reviewed-commit-SHA' \
  'relative or candidate-ref reusable workflow'
do
  grep -Fq "$phrase" "$doc"
done

if grep -Fq 'Triggers: a `v*` tag push or explicit `workflow_dispatch`' "$doc" ||
   grep -Fq '`release-intake.yml`' "$doc" ||
   grep -Fq 'workflow_run: completed' "$doc"; then
  exit 1
fi

printf 'inventory_rows=%s required_checks=%s trace_rows=%s trusted_entry=pass threats=pass\n' \
  "$inventory_rows" "$required_checks" "$trace_rows"

