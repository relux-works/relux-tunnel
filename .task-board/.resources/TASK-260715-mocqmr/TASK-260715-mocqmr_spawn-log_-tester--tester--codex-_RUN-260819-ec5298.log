+    finally:
+        listener.close()
+
+require_denied(lambda: open(sys.argv[1], "wb"))
+require_denied(bind_listener)
+require_denied(lambda: subprocess.Popen(["/bin/sleep", "1"]))
+sys.stdout.write("containment-ok\n")
+"""
