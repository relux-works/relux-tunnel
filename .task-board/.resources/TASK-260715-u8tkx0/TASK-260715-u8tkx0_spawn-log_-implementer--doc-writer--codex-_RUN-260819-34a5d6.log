+  done
+  (
+    cd "$RUN"
+    python3 scripts/relay_release.py archive-assets \
+      --portable-root .build/relay/archive-input \
+      --archive .build/relay/portable-relay-assets.tar.gz \
+      --source-date-epoch "$SOURCE_DATE_EPOCH"
