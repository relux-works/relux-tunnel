+      dependencies += delta
+    case "packet":
+      sockets += delta
+      channels += delta
+      dependencies += delta
+    case "settings":
+      dependencies += delta
+    case "reads":
+      tasks += delta
+    default:
+      preconditionFailure("Unknown fixture resource: \(resource)")
+    }
+  }
