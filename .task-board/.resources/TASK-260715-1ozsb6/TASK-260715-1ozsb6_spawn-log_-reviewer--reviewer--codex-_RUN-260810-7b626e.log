   450	  public func snapshot() async -> SSHTransportSnapshot {
   451	    await reconcileProtectedMetrics()
   452	    let counts = context.network.bufferedByteCounts
   453	    let direct = channels.values.filter { $0.kind == .directTCPIP && !$0.closed }.count
   454	    let exec = channels.values.filter { $0.kind == .exec && !$0.closed }.count
