        with self.assertRaisesRegex(fixture.FixtureError, "sink mismatch"):
            fixture.stream_sink(io.BytesIO(good[:-1]), len(good), digest)
        with self.assertRaisesRegex(fixture.FixtureError, "sink mismatch"):
