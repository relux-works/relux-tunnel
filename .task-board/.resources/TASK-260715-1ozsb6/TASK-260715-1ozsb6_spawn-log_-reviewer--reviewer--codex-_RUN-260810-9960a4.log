   379	  private func readAll(_ channel: any SSHExecChannel) async throws -> Data {
   380	    var result = Data()
   381	    while let bytes = try await channel.read(maximumBytes: 16 * 1_024) {
   382	      result.append(bytes)
   383	    }
   384	    return result
   385	  }
   386	
   387	  private func waitForPendingReads(_ count: Int64, transport: LibSSH2Transport) async {
   388	    for _ in 0..<200 {
   389	      if await transport.snapshot().gauges.pendingReads == count { return }
   390	      await Task.yield()
   391	    }
   392	  }
   393	}
