hat will be stored in the manager.\n319|  public static func digest(\n320|    ofEncodedSnapshot data: Data\n321|  ) throws -> SSHProfileSnapshotDigestSHA256 {\n322|    _ = try decode(data)\n323|    return digestOfValidatedBytes(data)\n324|  }\n325|\n326|  public static func digest(\n327|    of snapshot: SSHProfileSnapshotV1\n328|  ) throws -> SSHProfileSnapshotDigestSHA256 {\n329|    digestOfValidatedBytes(try encode(snapshot))\n330|  }\n331|\n332|  private static func validate(_ wire: SSHProfileSnapshotWire) throws -> SSHProfileSnapshotV1 {\n333|    guard wire.protocolVersion == UInt64(SSHProfileSnapshotV1.currentProtocolVersion),\n334|      wire.schemaVersion == UInt64(SSHProfileSnapshotV1.currentSchemaVersion),\n335|      wire.kind == SSHProfileSnapshotV1.kind\n336|    else {\n337|      throw SSHProfileSnapshotLoaderError.profileVersionUnsupported\n338|    }\n339|    guard wire.configurationGeneration >= 1 else {\n340|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.configurationGeneration)\n341|    }\n342|    let profileID = try canonicalUUID(wire.profileID, field: .profileID)\n343|    let createdAt = try timestamp(wire.createdAt, field: .createdAt)\n344|    let updatedAt = try timestamp(wire.updatedAt, field: .updatedAt)\n345|    guard createdAt.date <= updatedAt.date else {\n346|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.updatedAt)\n347|    }\n348|    try validateDisplayName(wire.displayName)\n349|    let canonicalHost = try validateHost(wire.canonicalHost)\n350|    guard (1...65_535).contains(wire.port), let port = UInt16(exactly: wire.port) else {\n351|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.port)\n352|    }\n353|    try validateAccount(wire.account)\n354|    let credentialReference = try canonicalUUID(\n355|      wire.credential.ref,\n356|      field: .credentialReference\n357|    )\n358|    guard wire.credential.generation >= 1 else {\n359|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.credentialGeneration)\n360|    }\n361|    let hostPolicy = try validateHostPolicy(wire.hostPolicy)\n362|\n363|    return SSHProfileSnapshotV1(\n364|      configurationGeneration: wire.configurationGeneration,\n365|      profileID: OpaqueProfileIdentifier(profileID),\n366|      createdAt: SSHProfileTimestamp(createdAt.rawValue),\n367|      updatedAt: SSHProfileTimestamp(updatedAt.rawValue),\n368|      displayName: wire.displayName,\n369|      canonicalHost: canonicalHost,\n370|      port: port,\n371|      account: wire.account,\n372|      credential: SSHProfileCredentialReferenceV1(\n373|        reference: OpaqueCredentialReference(credentialReference),\n374|        generation: wire.credential.generation\n375|      ),\n376|      hostPolicy: hostPolicy\n377|    )\n378|  }\n379|\n380|  private static func validateHostPolicy(\n381|    _ wire: SSHProfileHostPolicyWire\n382|  ) throws -> SSHHostPolicyV1 {\n383|    guard\n384|      (1...SSHHostKeyAlgorithm.canonicalPreferenceOrder.count).contains(\n385|        wire.allowedAlgorithms.count\n386|      )\n387|    else {\n388|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.allowedAlgorithms)\n389|    }\n390|\n391|    let algorithms: [SSHHostKeyAlgorithm] = try wire.allowedAlgorithms.map { value in\n392|      guard let algorithm = SSHHostKeyAlgorithm(rawValue: value) else {\n393|        throw SSHProfileSnapshotLoaderError.profileInvalidField(.allowedAlgorithms)\n394|      }\n395|      return algorithm\n396|    }\n397|    let canonicalIndexes = algorithms.compactMap {\n398|      SSHHostKeyAlgorithm.canonicalPreferenceOrder.firstIndex(of: $0)\n399|    }\n400|    guard zip(canonicalIndexes, canonicalIndexes.dropFirst()).allSatisfy(<) else {\n401|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.allowedAlgorithms)\n402|    }\n403|    guard wire.records.count <= 8 else {\n404|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)\n405|    }\n406|\n407|    var tuples: Set<SSHHostIdentityTuple> = []\n408|    var approvedCount = 0\n409|    var records: [SSHHostIdentityRecordV1] = []\n410|    for record in wire.records {\n411|      guard let algorithm = SSHHostKeyAlgorithm(rawValue: record.algorithm),\n412|        algorithms.contains(algorithm),\n413|        let state = SSHHostIdentityState(rawValue: record.state),\n414|        let provenance = SSHHostIdentityProvenance(rawValue: record.provenance)\n415|      else {\n416|        throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)\n417|      }\n418|      let fingerprint = try fingerprint(record.fingerprintSHA256)\n419|      let tuple = SSHHostIdentityTuple(algorithm: algorithm, digest: fingerprint.digest)\n420|      guard tuples.insert(tuple).inserted else {\n421|        throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)\n422|      }\n423|      let firstSeenAt = try timestamp(record.firstSeenAt, field: .trustRecords)\n424|      let lastSeenAt = try timestamp(record.lastSeenAt, field: .trustRecords)\n425|      guard firstSeenAt.date <= lastSeenAt.date else {\n426|        throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)\n427|      }\n428|      let approvedAt = try record.approvedAt.map { value in\n429|        let parsed = try timestamp(value, field: .trustRecords)\n430|        return SSHProfileTimestamp(parsed.rawValue)\n431|      }\n432|      let revokedAt = try record.revokedAt.map { value in\n433|        let parsed = try timestamp(value, field: .trustRecords)\n434|        return SSHProfileTimestamp(parsed.rawValue)\n435|      }\n436|      let revocationReason = record.revocationReason.flatMap(\n437|        SSHHostIdentityRevocationReason.init(rawValue:)\n438|      )\n439|\n440|      switch state {\n441|      case .approved:\n442|        approvedCount += 1\n443|        guard approvedAt != nil, revokedAt == nil, record.revocationReason == nil else {\n444|          throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)\n445|        }\n446|      case .revoked:\n447|        guard revokedAt != nil, revocationReason != nil else {\n448|          throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)\n449|        }\n450|      }\n451|      if record.revocationReason != nil, revocationReason == nil {\n452|        throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)\n453|      }\n454|\n455|      records.append(\n456|        SSHHostIdentityRecordV1(\n457|          algorithm: algorithm,\n458|          fingerprintSHA256: SSHHostKeyFingerprint(fingerprint.rawValue),\n459|          state: state,\n460|          provenance: provenance,\n461|          firstSeenAt: SSHProfileTimestamp(firstSeenAt.rawValue),\n462|          lastSeenAt: SSHProfileTimestamp(lastSeenAt.rawValue),\n463|          approvedAt: approvedAt,\n464|          revokedAt: revokedAt,\n465|          revocationReason: revocationReason\n466|        )\n467|      )\n468|    }\n469|    guard approvedCount <= 1 else {\n470|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)\n471|    }\n472|\n473|    let sortedTuples = tuples.sorted(by: SSHHostIdentityTuple.isOrderedBefore)\n474|    let actualTuples = records.map {\n475|      SSHHostIdentityTuple(\n476|        algorithm: $0.algorithm,\n477|        digest: fingerprintDigest($0.fingerprintSHA256.rawValue)!\n478|      )\n479|    }\n480|    guard actualTuples == sortedTuples else {\n481|      throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)\n482|    }\n483|    return SSHHostPolicyV1(allowedAlgorithms: algorithms, records: records)\n484|  }\n485|\n486|  private static func validateDisplayName(_ value: String) throws {\n487|    guard value.utf8.elementsEqual(value.precomposedStringWithCanonicalMapping.utf8),\n488|      value == value.trimmingCharacters(in: .whitespacesAndNewlines),\n489|      (1...128).contains(value.unicodeScalars.count),\n490|      !value.unicodeScalars.contains(where: isRejectedDisplayScalar)\n491|   