  1236	  public static func hostDecisionFailure(
  1237	    _ decision: SSHHostKeyDecision,
  1238	    lane: SSHLaneIdentity
  1239	  ) -> SSHTransportError? {
  1240	    let code: SSHTransportErrorCode
  1241	    switch decision {
  1242	    case .acceptFirstUse, .acceptMatch:
  1243	      return nil
  1244	    case .rejectUnknown:
  1245	      code = .hostKeyUnknown
  1246	    case .rejectChanged:
  1247	      code = .hostKeyChanged
  1248	    case .rejectAlgorithm:
  1249	      code = .hostKeyAlgorithmRejected
  1250	    case .rejectPolicy:
  1251	      code = .hostKeyRejected
  1252	    }
  1253	    return SSHTransportError(
  1254	      validatedCode: code,
  1255	      phase: .hostDecision,
  1256	      scope: .lane(lane),
  1257	      retryDisposition: .afterConfigurationChange,
  1258	      requiresTeardown: true,
  1259	      channelOpenReason: .notApplicable
  1260	    )
  1261	  }
