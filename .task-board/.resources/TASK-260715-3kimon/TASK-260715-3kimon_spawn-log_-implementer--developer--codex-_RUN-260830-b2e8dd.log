   637	  private var managedWindowReservedBytes: Int {
   638	    reservations.values.reduce(0) { $0 + $1.reservedWindowBytes }
   639	  }
   640	
   641	  private var globalWindowReservedBytes: Int {
   642	    otherGlobalWindowReservedBytes + managedWindowReservedBytes
   643	  }
   644	
   645	  private var ledgerCommittedBytes: Int {
   646	    otherLedgerCommittedBytes + reservations.values.reduce(0) { $0 + $1.ledgerChargeBytes }
   647	  }
   648	
   649	  private func laneReservedBytes(_ lane: SSHLaneIdentity) -> Int {
   650	    let external = lanes[lane]?.externallyReservedWindowBytes ?? 0
   651	    return external
   652	      + reservations.values.lazy.filter { $0.lane == lane }
   653	      .reduce(0) { $0 + $1.reservedWindowBytes }
   654	  }
