   259	        let immediate: Result<Void, Error>? = lock.withLock {
   260	          if Task.isCancelled { return .failure(CancellationError()) }
   261	          if let result { return result }
   262	          self.continuation = continuation
   263	          return nil
   264	        }
   265	        if let immediate { continuation.resume(with: immediate) }
   266	      }
   267	    } onCancel: {
   268	      self.complete(with: .failure(CancellationError()))
   269	    }
   270	  }
   271	
   272	  func complete(with result: Result<Void, Error>) {
   273	    let continuation: CheckedContinuation<Void, Error>? = lock.withLock {
   274	      guard self.result == nil else { return nil }
   275	      self.result = result
   276	      defer { self.continuation = nil }
   277	      return self.continuation
   278	    }
   279	    continuation?.resume(with: result)
   280	  }
   281	}
