   670	int
   671	hev_socks5_tunnel_run (void)
   672	{
   673	    LOG_D ("socks5 tunnel run");
   674	
   675	    task_event = hev_task_ref (task_event);
   676	    hev_task_run (task_event, event_task_entry, NULL);
   677	
   678	    task_lwip_io = hev_task_ref (task_lwip_io);
   679	    hev_task_run (task_lwip_io, lwip_io_task_entry, NULL);
   680	
   681	    task_lwip_timer = hev_task_ref (task_lwip_timer);
   682	    hev_task_run (task_lwip_timer, lwip_timer_task_entry, NULL);
   683	
   684	    run = 1;
   685	    hev_task_system_run ();
   686	
   687	    return 0;
   688	}
   689	
   690	void
   691	hev_socks5_tunnel_stop (void)
   692	{
   693	    int res = 0;
   694	    int fd;
   695	
   696	    LOG_D ("socks5 tunnel stop");
   697	
   698	    for (;;) {
   699	        fd = READ_ONCE (event_fds[1]);
   700	        if (fd >= 0)
   701	            break;
   702	        /* Wait for async initialization */
   703	        usleep (100 * 1000);
   704	    }
   705	
   706	    res = write (fd, &res, 1);
   707	    assert (res > 0 && "socks5 tunnel write event");
   708	}
