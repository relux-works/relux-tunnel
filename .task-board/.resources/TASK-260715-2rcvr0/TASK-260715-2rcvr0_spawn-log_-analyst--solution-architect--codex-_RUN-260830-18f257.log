   280	/// Frozen compatibility codec for the pre-v1 discovery message.
   281	public enum ProviderMessageCodec {
   282	  public static let currentVersion = RuntimeMessageProtocol.currentProtocolVersion
   283	  public static let versionKind = "version"
   284	
   285	  public static func encodeVersionRequest(
   286	    protocolVersion: UInt16 = currentVersion
   287	  ) throws -> Data {
   288	    try RuntimeJSONCodec.encode(
   289	      ProviderVersionRequest(protocolVersion: protocolVersion),
   290	      maximumBytes: RuntimeMessageSizeLimit.legacyVersion
   291	    )
   292	  }
   293	
   294	  public static func decodeVersionResponse(_ data: Data) throws -> ProviderVersionResponse {
   295	    try validateLegacyObject(data)
   296	    let response: ProviderVersionResponse
   297	    do {
   298	      response = try JSONDecoder().decode(ProviderVersionResponse.self, from: data)
   299	    } catch {
   300	      throw ProviderMessageError.invalidPayload(.corruptPayload)
   301	    }
   302	    guard response.kind == versionKind else {
   303	      throw ProviderMessageError.unsupportedKind(response.kind)
   304	    }
   305	    guard response.protocolVersion == currentVersion else {
   306	      throw ProviderMessageError.unsupportedProtocolVersion(response.protocolVersion)
   307	    }
   308	    return response
   309	  }
   310	
   311	  public static func response(to data: Data) throws -> Data {
   312	    try validateLegacyObject(data)
   313	    let request: ProviderVersionRequest
   314	    do {
   315	      request = try JSONDecoder().decode(ProviderVersionRequest.self, from: data)
   316	    } catch {
   317	      throw ProviderMessageError.invalidPayload(.corruptPayload)
   318	    }
   319	    guard request.kind == versionKind else {
   320	      throw ProviderMessageError.unsupportedKind(request.kind)
   321	    }
   322	    guard request.protocolVersion == currentVersion else {
   323	      throw ProviderMessageError.unsupportedProtocolVersion(request.protocolVersion)
   324	    }
   325	    return try RuntimeJSONCodec.encode(
   326	      ProviderVersionResponse(protocolVersion: currentVersion),
   327	      maximumBytes: RuntimeMessageSizeLimit.legacyVersion
   328	    )
   329	  }
   330	
   331	  static func isVersionCandidate(_ data: Data) -> Bool {
   332	    guard data.count <= RuntimeMessageSizeLimit.legacyVersion else { return false }
   333	    struct KindHeader: Decodable { let kind: String }
   334	    return (try? JSONDecoder().decode(KindHeader.self, from: data).kind) == versionKind
   335	  }
   336	
   337	  private static func validateLegacyObject(_ data: Data) throws {
   338	    do {
   339	      let keys = try StrictJSONValidator.validate(
   340	        data,
   341	        maximumBytes: RuntimeMessageSizeLimit.legacyVersion
   342	      )
   343	      guard keys == ["kind", "protocolVersion"] else {
   344	        throw ProviderMessageError.invalidPayload(.corruptPayload)
   345	      }
   346	    } catch let error as ProviderMessageError {
   347	      throw error
   348	    } catch let error as RuntimeMessageCodecError {
   349	      throw ProviderMessageError.invalidPayload(error.protocolErrorCode)
   350	    } catch {
   351	      throw ProviderMessageError.invalidPayload(.corruptPayload)
   352	    }
   353	  }
   354	}
