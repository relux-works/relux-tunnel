+          pointer,
+          "exec",
+          UInt32("exec".utf8.count),
+          bytes.bindMemory(to: CChar.self).baseAddress,
+          UInt32(max(0, bytes.count - 1))
+        )
+      }
+    },
+    close: { libssh2_channel_close($0) },
+    free: { libssh2_channel_free($0) }
+  )
