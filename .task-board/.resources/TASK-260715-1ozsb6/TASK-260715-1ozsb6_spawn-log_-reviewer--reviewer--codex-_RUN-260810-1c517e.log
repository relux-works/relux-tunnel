   245	      try configureEngine(configuration: configuration)
   246	      failurePhase = .initialKeyExchange
   247	      try await transition(to: .keyExchange)
   248	      try await runHandshake(timeout: configuration.timeouts.initialKeyExchange)
   249	
   250	      let evidence = try hostKeyEvidence()
   251	      failurePhase = .hostDecision
   252	      try await transition(to: .awaitingHostDecision)
   253	      let hostInput = SSHHostKeyPolicyInput(
   254	        canonicalHostname: configuration.canonicalHostname,
   255	        connectedEndpoint: configuration.endpoint,
   256	        evidence: evidence,
   257	        lane: lane,
   258	        trustRecordReference: configuration.trustRecordReference
   259	      )
   260	      let decision = try await withTimeout(
   261	        configuration.timeouts.hostDecision,
   262	        clock: dependencies.clock,
   263	        registry: asyncOperations,
   264	        operation: { try await self.dependencies.hostKeyPolicy.evaluate(hostInput) }
   265	      )
   266	      await recordHostDecision(decision)
   267	      if let failure = SSHTransportError.hostDecisionFailure(decision, lane: lane) {
   268	        throw failure
   269	      }
   270	      let acceptedHost = try decision.acceptance(for: hostInput)
   271	
   272	      failurePhase = .credentialLookup
   273	      try await transition(to: .authenticating)
   274	      let request = SSHCredentialRequest(
   275	        credentialReference: configuration.credentialReference,
   276	        username: configuration.username,
   277	        allowedPublicKeyAlgorithms: configuration.algorithms.hostKey,
   278	        acceptedHost: acceptedHost
   279	      )
   280	      let credential = try await withTimeout(
   281	        configuration.timeouts.credentialLookup,
   282	        clock: dependencies.clock,
   283	        registry: asyncOperations,
   284	        operation: { try await self.dependencies.credentialProvider.credential(for: request) }
   285	      )
   286	      guard
   287	        LibSSH2TransportFactory().capabilities.publicKeyAuthenticationAlgorithms.contains(
   288	          credential.algorithm),
   289	        request.allowedPublicKeyAlgorithms.contains(credential.algorithm)
