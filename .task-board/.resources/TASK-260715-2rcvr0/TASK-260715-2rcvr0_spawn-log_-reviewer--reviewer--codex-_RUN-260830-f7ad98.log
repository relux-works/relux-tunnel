   903	  public nonisolated func providerDidFail(
   904	    _ errorCode: ProviderNSErrorCode,
   905	    cancelTunnelWithError: @escaping ProviderCancelTunnelHandler
   906	  ) {
   907	    guard failureAdmission.claim() else { return }
   908	    Task { [weak self] in
   909	      await self?.handleProviderFailure(
   910	        errorCode,
   911	        cancelTunnelWithError: cancelTunnelWithError
   912	      )
   913	    }
   914	  }
   915	
   916	  private func handleProviderFailure(
   917	    _ errorCode: ProviderNSErrorCode,
   918	    cancelTunnelWithError: ProviderCancelTunnelHandler
   919	  ) async {
   920	    let generation = activeGeneration?.identifier ?? latestGeneration
   921	    cancelTunnelWithError(errorCode.nsError)
   922	
   923	    awaitingSystemStopAfterProviderFailure = true
   924	    guard activeGeneration?.identifier == generation else {
   925	      phase = .stopping
   926	      return
   927	    }
   928	    await stopAndJoin(
   929	      reason: .providerFailure,
   930	      generation: generation,
__ADAPTER_MESSAGES__
   930	      generation: generation,
   931	      keepStoppingAfterCleanup: true
   932	    )
   933	    pendingStartGate?.complete(errorCode.nsError)
   934	    pendingStartGate = nil
   935	  }
