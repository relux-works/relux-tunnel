   146	int
   147	hev_socks5_udp_sendmmsg (HevSocks5UDP *self, HevSocks5UDPMsg *msgv,
   148	                         unsigned int num)
   149	{
   150	    switch (HEV_SOCKS5 (self)->type) {
   151	    case HEV_SOCKS5_TYPE_UDP_IN_TCP:
   152	        return hev_socks5_udp_sendmmsg_tcp (self, msgv, num);
   153	    case HEV_SOCKS5_TYPE_UDP_IN_UDP:
   154	        return hev_socks5_udp_sendmmsg_udp (self, msgv, num);
