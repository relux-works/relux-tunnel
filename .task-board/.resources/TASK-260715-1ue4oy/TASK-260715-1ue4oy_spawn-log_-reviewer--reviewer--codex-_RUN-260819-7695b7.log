   175	        block = pbx_object(text, match.group(1))
   176	        if "isa = PBXNativeTarget;" not in block:
   177	            continue
   178	        target_name = re.search(r"(?m)^\s*name\s*=\s*\"?([^\";]+)\"?;", block)
   179	        if target_name is not None and target_name.group(1) == name:
   180	            candidates.append(block)
   181	    if len(candidates) != 1:
   182	        raise ContractError(
