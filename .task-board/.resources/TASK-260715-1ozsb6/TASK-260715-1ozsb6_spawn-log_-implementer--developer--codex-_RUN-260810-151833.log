   470	  public func upload(_ request: SSHExecUploadRequest) async throws -> SSHExecExit {
   471	    guard let configuration else {
   472	      throw transportError(code: .invalidState, phase: .uploadSource)
   473	    }
   474	    do {
   475	      return try await withTimeout(
   476	        configuration.timeouts.upload,
   477	        clock: dependencies.clock
   478	      ) {
   479	        try await self.performUpload(request)
   480	      }
   481	    } catch {
   482	      let mapped = map(error, phase: .uploadSource, scope: .operation)
   483	      await recordTerminalOperation(mapped)
   484	      throw mapped
   485	    }
   486	  }
   487	
   488	  private func performUpload(_ request: SSHExecUploadRequest) async throws -> SSHExecExit {
   489	    let channel = try await openExecChannel(request: request.exec, policy: request.channelPolicy)
   490	    let execChannel = channel as! LibSSH2ExecChannel
   491	    do {
   492	      async let stdout: Void = drain(channel: execChannel, standardError: false)
   493	      async let stderr: Void = drain(channel: execChannel, standardError: true)
   494	      while let bytes = try await request.source.read(maximumBytes: request.chunkBytes) {
   495	        guard !bytes.isEmpty, bytes.count <= request.chunkBytes else {
   496	          throw transportError(code: .protocolViolation, phase: .uploadSource)
   497	        }
   498	        var offset = 0
   499	        while offset < bytes.count {
   500	          let written = try await execChannel.writeSome(Data(bytes[offset...]))
   501	          offset += written
   502	        }
   503	      }
   504	      try await execChannel.finishWriting()
   505	      let exit = try await execChannel.waitForExit()
   506	      _ = try await (stdout, stderr)
   507	      await execChannel.close()
   508	      return exit
   509	    } catch {
   510	      await resetChannelAfterFailedOperation(identity: execChannel.identity)
   511	      throw map(error, phase: .uploadSource, scope: .channel(execChannel.identity))
   512	    }
   513	  }
   514	
   515	  private func drain(channel: LibSSH2ExecChannel, standardError: Bool) async throws {
   516	    while true {
   517	      let bytes =
   518	        if standardError {
   519	          try await channel.readStandardError(maximumBytes: 16 * 1_024)
   520	        } else {
   521	          try await channel.read(maximumBytes: 16 * 1_024)
   522	        }
   523	      if bytes == nil { return }
   524	    }
   525	  }
