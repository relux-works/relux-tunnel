{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c5","stream":{"kind":"session","id":"01a0aa7a-9815-7302-a96f-7a8fde67c84b"},"sequence":573,"recorded_at":1780531400001141,"record_type":"event","durability":"durable","causation_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","run_stream":{"kind":"run","id":"7cb39f37-e5ea-43fc-a612-eaf97474622d"},"call_id":"call_01a0aa7c05fc722d8f7b6767ab8bf200","text":"{\n  \"chunk_id\": \"exec-13-1\",\n  \"command\": \"grep -n \\\"@Test\\\" Tests/ReluxTunnelLibSSH2AdapterTests/LibSSH2AdapterIntegrationTests.swift; echo ===; grep -c \\\"\\\" Tests/ReluxTunnelLibSSH2AdapterTests/LibSSH2AdapterIntegrationTests.swift; echo ===; grep -rn \\\"LoopbackSSHD\\\" Tests/ReluxTunnelLibSSH2AdapterTests/*.swift | grep -v Integration | head\",\n  \"description\": \"List integration test cases and sshd fixture\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"13:  @Test(\\\"every untrusted host stops before credentials and destination channels\\\")\\n107:  @Test(\\\"host-policy cancellation is phase-accurate and restores the full baseline\\\")\\n143:  @Test(\\\"credential-lookup cancellation is phase-accurate and restores the full baseline\\\")\\n179:  @Test(\\\"caller cancellation is scoped and idle reads have no implicit timeout\\\")\\n242:  @Test(\\\"rekey callers coalesce, caller cancellation detaches, and opens keep their deadline\\\")\\n331:  @Test(\\\"authentication timeout cancels and retires the external signer\\\")\\n380:  @Test(\\\"rekey deadline starts before admission to the session gate\\\")\\n439:  @Test(\\\"automatic keepalive defers behind KEX without consuming its reply deadline\\\")\\n489:  @Test(\\\"automatic keepalive fatal failure retires before teardown joins owned tasks\\\")\\n538:  @Test(\\\"same-channel writes preserve exact arguments across EAGAIN\\\")\\n596:  @Test(\\\"channel-open cancellation retires admission waiters and preserves the session baseline\\\")\\n661:  @Test(\\\"write and EOF cancellation retire queued operations without disturbing the channel\\\")\\n729:  @Test(\\\"exec-request cancellation frees the candidate channel and restores baseline\\\")\\n787:  @Test(\\\"keepalive cancellation retires admission waiters and restores the rekey baseline\\\")\\n841:  @Test(\\\"server-initiated rekey preserves byte-exact active traffic and bounded buffers\\\")\\n891:  @Test(\\\"credential algorithms outside the caller allowlist fail before authentication\\\")\\n922:  @Test(\\\"server rejection of an unapproved public key is terminal and cleans up\\\")\\n957:  @Test(\\\"exec and upload timeouts reset their channel and preserve siblings\\\")\\n1034:  @Test(\\\"upload and close deadlines survive a source that ignores cancellation\\\")\\n1099:  @Test(\\\"channel-open rejection is operation-scoped and preserves an existing sibling\\\")\\n1146:  @Test(\\\"socket failure during channel open is privacy-safe and connection-fatal\\\")\\n1166:  @Test(\\\"approved primary and fallback algorithm sets negotiate without forbidden downgrade\\\")\\n1195:  @Test(\\\"socket failure during channel read is privacy-safe and connection-fatal\\\")\\n1216:  @Test(\\\"socket failure during channel write is privacy-safe and connection-fatal\\\")\\n1242:  @Test(\\\"socket failure during manual keepalive is privacy-safe and connection-fatal\\\")\\n1259:  @Test(\\\"production public diagnostics exclude every privacy sentinel class\\\")\\n1384:  @Test(\\\"exec-request failure retries EAGAIN free without losing channel ownership\\\")\\n1422:  @Test(\\\"channel close retries EAGAIN and concurrent close pressure returns tasks to baseline\\\")\\n1461:  @Test(\\\"per-channel operation pressure is rejected at the hard cap\\\")\\n1502:  @Test(\\\"successful sessions exercise M0 flows and return resources to baseline\\\")\\n1563:  @Test(\\\"approved real relux host passes the selected libssh2 compatibility row\\\")\\n1692:  @Test(\\\"Ed25519 authenticates through the opaque external signer after host approval\\\")\\n1732:  @Test(\\\"protected-byte threshold rekeys through production KEX and preserves traffic\\\")\\n1782:  @Test(\\\"elapsed-time threshold rekeys through production KEX and preserves traffic\\\")\\n1841:  @Test(\\\"connected close retires tasks after a cancellation-ignoring socket deadline\\\")\\n1894:  @Test(\\\"mandatory metric updates reconcile with the complete available snapshot\\\")\\n2008:  @Test(\\\"all libssh2 M3 runtime surfaces report unsupported or not-reported explicitly\\\")\\n===\\n3774\\n===\\n\",\n  \"original_output_bytes\": 3324,\n  \"original_output_tokens\": 831,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
