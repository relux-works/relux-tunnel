+    await flow.enqueue(
+      PacketReadBatch(results: [
+        .packet(TunnelPacket(payload: Data(), addressFamily: .ipv4)),
+        .packet(TunnelPacket(payload: Data([0x60]), addressFamily: .ipv4)),
