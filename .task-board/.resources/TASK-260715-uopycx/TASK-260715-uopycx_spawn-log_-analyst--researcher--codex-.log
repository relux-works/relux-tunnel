   126	static int
   127	hev_socks5_client_udp_get_fd (HevSocks5UDP *self)
   128	{
   129	    int fd;
   130	
   131	    switch (HEV_SOCKS5 (self)->type) {
   132	    case HEV_SOCKS5_TYPE_UDP_IN_TCP:
   133	        fd = HEV_SOCKS5 (self)->fd;
   134	        break;
   135	    case HEV_SOCKS5_TYPE_UDP_IN_UDP:
   136	        fd = HEV_SOCKS5_CLIENT_UDP (self)->fd;
   137	        break;
   138	    default:
   139	        return -1;
   140	    }
   141	
   142	    return fd;
   143	}
