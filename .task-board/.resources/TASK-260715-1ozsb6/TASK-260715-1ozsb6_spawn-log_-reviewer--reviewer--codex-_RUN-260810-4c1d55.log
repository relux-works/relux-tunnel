  1346	    disposingChannels[identity] = disposition
  1347	    await waitForChannelOperationsToDrain(identity: identity)
  1348	    guard let record = channels.removeValue(forKey: identity) else { return }
  1349	    let deadline = dependencies.clock.now().advanced(
  1350	      by: configuration?.timeouts.channelClose ?? .seconds(1)
  1351	    )
  1352	    if graceful {
  1353	      while libssh2_channel_close(record.pointer) == LIBSSH2_ERROR_EAGAIN {
  1354	        do { try await cleanupProgress(until: deadline) } catch { break }
