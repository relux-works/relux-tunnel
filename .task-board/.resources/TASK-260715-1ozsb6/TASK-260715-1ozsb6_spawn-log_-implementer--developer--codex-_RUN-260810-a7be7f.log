+
+    let timedOutChannel = try await transport.openExecChannel(
+      request: SSHExecRequest(command: "sleep 2"),
+      policy: fixtureChannelPolicy()
+    )
+    do {
+      _ = try await timedOutChannel.read(maximumBytes: 1)
+      Issue.record("read unexpectedly beat its timeout", sourceLocation: #_sourceLocation)
+    } catch let error as SSHTransportError {
+      #expect(error.code == .timedOut)
+      #expect(error.scope == .channel(timedOutChannel.identity))
+      #expect(error.retryDisposition == .sameChannelOperation)
+      #expect(!error.requiresTeardown)
+    }
+    await timedOutChannel.cancel()
