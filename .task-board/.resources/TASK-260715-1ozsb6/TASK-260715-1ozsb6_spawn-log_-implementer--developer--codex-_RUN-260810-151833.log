   310	  private func performOpenDirectTCPIP(
   311	    destination: TunnelEndpoint,
   312	    originator: TunnelEndpoint,
   313	    policy: SSHChannelPolicy,
   314	    deadline: ContinuousClock.Instant
   315	  ) async throws -> any SSHByteChannel {
   316	    guard state == .ready else {
   317	      throw transportError(code: .invalidState, phase: .channelOpen)
   318	    }
   319	    let identity = dependencies.identityGenerator.makeChannelIdentity()
   320	    let message = directTCPIPMessage(destination: destination, originator: originator)
   321	    while true {
   322	      try checkCancellation(phase: .channelOpen, scope: .operation)
   323	      guard state == .ready, let engineSession else {
   324	        throw transportError(code: .cancelled, phase: .channelOpen)
   325	      }
   326	      let pointer = message.withUnsafeBytes { bytes in
   327	        libssh2_channel_open_ex(
   328	          engineSession,
   329	          "direct-tcpip",
   330	          UInt32("direct-tcpip".utf8.count),
   331	          UInt32(clamping: policy.initialReceiveWindowBytes),
   332	          UInt32(clamping: min(policy.maximumWriteCallBytes, Int(LIBSSH2_CHANNEL_PACKET_DEFAULT))),
   333	          bytes.bindMemory(to: CChar.self).baseAddress,
   334	          UInt32(bytes.count)
   335	        )
   336	      }
   337	      if let pointer {
   338	        channels[identity] = LibSSH2ChannelRecord(
   339	          pointer: pointer,
   340	          kind: .directTCPIP,
   341	          policy: policy
   342	        )
   343	        channelWriteGates[identity] = LibSSH2SessionOperationGate(maximumWaiters: 1_024)
   344	        counters.directChannelsOpened += 1
   345	        await metric(.increment(.directChannelsOpened, by: 1))
   346	        await emit(.channelOpened(channel: identity, kind: .directTCPIP))
   347	        return LibSSH2ByteChannel(identity: identity, owner: self)
   348	      }
   349	      let code = libssh2_session_last_errno(engineSession)
   350	      guard code == LIBSSH2_ERROR_EAGAIN else {
   351	        counters.channelOpenFailed += 1
   352	        await metric(.increment(.channelOpenFailed, by: 1))
   353	        throw engineError(
   354	          code,
   355	          phase: .channelOpen,
   356	          fallback: .channelOpenRejected,
   357	          scope: .operation
   358	        )
   359	      }
   360	      try await progress(until: deadline, phase: .channelOpen, scope: .operation)
   361	    }
   362	  }
