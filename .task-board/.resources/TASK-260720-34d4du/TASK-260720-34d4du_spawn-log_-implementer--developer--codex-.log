    21	private final class ReluxWindowEventRecorder: ChannelInboundHandler, @unchecked Sendable {
    22	    typealias InboundIn = SSHChannelData
    23	
    24	    var sequence: [String] = []
    25	    var adjustments: [NIOSSHChannelWindowAdjustedEvent] = []
    26	
    27	    func channelRead(context: ChannelHandlerContext, data: NIOAny) {
    28	        self.sequence.append("read")
    29	        context.fireChannelRead(data)
    30	    }
    31	
    32	    func userInboundEventTriggered(context: ChannelHandlerContext, event: Any) {
    33	        if let adjustment = event as? NIOSSHChannelWindowAdjustedEvent {
    34	            self.sequence.append("adjust")
    35	            self.adjustments.append(adjustment)
    36	        }
    37	        context.fireUserInboundEventTriggered(event)
    38	    }
    39	}
