   357	def load_source_contract(path: Path = DEFAULT_CONTRACT) -> dict[str, Any]:
   358	    contract, _ = load_json(path, "relay asset source contract")
   359	    if set(contract) != SOURCE_KEYS:
   360	        raise AssetManifestError("relay asset source contract field set changed")
   361	    if (
   362	        contract.get("schemaVersion") != 1
   363	        or contract.get("manifestSchemaVersion") != SCHEMA_VERSION
   364	        or contract.get("relayProtocolVersion") != PROTOCOL_VERSION
   365	    ):
   366	        raise AssetManifestError("relay asset source contract version mismatch")
   367	    if (
   368	        not isinstance(contract.get("relayVersion"), str)
   369	        or VERSION_PATTERN.fullmatch(contract["relayVersion"]) is None
   370	        or not isinstance(contract.get("sourceCommit"), str)
   371	        or COMMIT_PATTERN.fullmatch(contract["sourceCommit"]) is None
   372	        or contract.get("bundleSubdirectory") != "relay-assets-v1"
   373	    ):
   374	        raise AssetManifestError("relay asset source build identity is invalid")
   375	    validate_provenance(contract.get("buildProvenance"))
   376	    validate_supply_chain(contract.get("supplyChain"))
   377	
   378	    assets = contract.get("assets")
   379	    if not isinstance(assets, list) or len(assets) != len(TARGETS):
   380	        raise AssetManifestError("relay asset source must contain exactly four assets")
   381	    tuples: set[tuple[str, str]] = set()
   382	    names: set[str] = set()
   383	    paths: set[str] = set()
   384	    for index, (asset, expected_target) in enumerate(zip(assets, TARGETS, strict=True)):
   385	        if not isinstance(asset, dict) or set(asset) != SOURCE_ASSET_KEYS:
   386	            raise AssetManifestError("relay asset source entry field set changed")
   387	        target = (asset.get("os"), asset.get("arch"))
   388	        if target != expected_target or target in tuples:
   389	            raise AssetManifestError(
   390	                "relay asset source target order or uniqueness changed"
   391	            )
   392	        os_name, architecture = expected_target
   393	        expected_name = canonical_file_name(os_name, architecture)
   394	        expected_path = canonical_archive_path(os_name, architecture)
   395	        if (
   396	            asset.get("fileName") != expected_name
   397	            or asset.get("archivePath") != expected_path
   398	        ):
   399	            raise AssetManifestError(
   400	                f"relay asset source name is not canonical at index {index}"
   401	            )
   402	        if (
   403	            type(asset.get("byteSize")) is not int
   404	            or asset["byteSize"] <= 0
   405	            or asset["byteSize"] > MAX_ASSET_BYTES
   406	            or not isinstance(asset.get("sha256"), str)
   407	            or SHA256_PATTERN.fullmatch(asset["sha256"]) is None
   408	        ):
   409	            raise AssetManifestError(
   410	                f"relay asset source digest is invalid: {expected_name}"
   411	            )
   412	        tuples.add(target)
   413	        names.add(expected_name)
   414	        paths.add(expected_path)
   415	    if len(tuples) != 4 or len(names) != 4 or len(paths) != 4:
   416	        raise AssetManifestError("relay asset source contains a duplicate asset")
   417	    return contract
