   910	  fileprivate func metricsSnapshot(generation: UInt64) async -> TunnelMetricsSnapshot {
   911	    await withCheckedContinuation { continuation in
   912	      guard pendingUpdateSlots.wait(timeout: .now()) == .success else {
   913	        continuation.resume(returning: Self.emptyMetricsSnapshot())
   914	        return
   915	      }
   916	      stateQueue.async { [self] in
   917	        defer { pendingUpdateSlots.signal() }
   918	        mergeDroppedUpdates()
   919	        guard generation == state.runtimeGeneration else {
   920	          continuation.resume(returning: Self.emptyMetricsSnapshot())
   921	          return
   922	        }
   923	        reconcileTCPAdmissionGauges()
   924	        continuation.resume(
   925	          returning: TunnelMetricsSnapshot(
   926	            schemaVersion: RuntimeDiagnosticsSchema.version,
   927	            counters: state.counters,
   928	            gauges: state.gauges
   929	          )
   930	        )
   931	      }
   932	    }
   933	  }
   934	
   935	  private func enqueue(
   936	    _ update: Update,
   937	    droppedUpdates: RuntimeDiagnosticsDroppedUpdateCounter
   938	  ) {
   939	    guard pendingUpdateSlots.wait(timeout: .now()) == .success else {
   940	      droppedUpdates.increment()
   941	      return
   942	    }
   943	    stateQueue.async { [self] in
   944	      defer { pendingUpdateSlots.signal() }
   945	      guard update.generation == state.runtimeGeneration else { return }
   946	      apply(update)
   947	    }
   948	  }
   949	
   950	  private func apply(_ update: Update) {
   951	    switch update {
   952	    case .incrementCounter(let name, let amount, _):
   953	      incrementKnownCounter(name, by: amount)
   954	    case .setGauge(let name, let value, _):
   955	      applyGauge(name, value: value)
   956	    case .stateTransition(let lifecycleState, let uptime, _):
   957	      incrementKnownCounter(RuntimeDiagnosticsMetricMap.transitionCounter(lifecycleState), by: 1)
   958	      let timeGauge = RuntimeDiagnosticsMetricMap.transitionTimeGauge(lifecycleState)
   959	      state.gauges[timeGauge] = max(state.gauges[timeGauge] ?? 0, clampedInt64(uptime))
   960	    case .tcpFlowOpened:
   961	      incrementKnownCounter("tcp_flows_opened_total", by: 1)
   962	      let current = state.gauges["tcp_active_flows"] ?? 0
   963	      let active = current == Int64.max ? Int64.max : current + 1
   964	      state.gauges["tcp_active_flows"] = active
   965	      state.gauges["tcp_peak_flows"] = max(state.gauges["tcp_peak_flows"] ?? 0, active)
   966	    case .tcpFlowClosed:
   967	      let active = state.gauges["tcp_active_flows"] ?? 0
   968	      guard active > 0 else {
   969	        incrementKnownCounter("diagnostics_rejected_metric_update_total", by: 1)
   970	        return
   971	      }
   972	      state.gauges["tcp_active_flows"] = active - 1
   973	      incrementKnownCounter("tcp_flows_closed_total", by: 1)
   974	    case .dnsResult(let result, let latency, _):
   975	      incrementKnownCounter(RuntimeDiagnosticsMetricMap.dnsResultCounter(result), by: 1)
   976	      for index in state.dnsLatencyCounts.indices
   977	      where latency <= RuntimeDiagnosticsSchema.dnsLatencyBucketUpperBoundsMilliseconds[index] {
   978	        state.dnsLatencyCounts[index] = state.dnsLatencyCounts[index].saturatingAdding(1)
   979	      }
   980	    case .tcpChannelOpenLatency(let latency, _):
   981	      for index in state.tcpChannelOpenLatencyCounts.indices
   982	      where latency
   983	        <= RuntimeDiagnosticsSchema.tcpChannelOpenLatencyBucketUpperBoundsMilliseconds[index]
   984	      {
   985	        state.tcpChannelOpenLatencyCounts[index] =
   986	          state.tcpChannelOpenLatencyCounts[index].saturatingAdding(1)
   987	      }
   988	    case .route(let mode, let installed, _):
   989	      state.gauges["route_mode_compatible"] = mode == .compatible ? 1 : 0
   990	      state.gauges["route_mode_unknown"] = mode == .unknown ? 1 : 0
   991	      state.gauges["route_installed"] = installed ? 1 : 0
   992	    case .memory(let physicalFootprintBytes, let availableMemoryBytes, _):
   993	      let footprint = clampedInt64(physicalFootprintBytes)
   994	      let available = clampedInt64(availableMemoryBytes)
   995	      incrementKnownCounter("memory_sample_total", by: 1)
   996	      state.gauges["memory_physical_footprint_bytes"] = footprint
   997	      state.gauges["memory_physical_footprint_peak_bytes"] = max(
   998	        state.gauges["memory_physical_footprint_peak_bytes"] ?? 0,
   999	        footprint
  1000	      )
  1001	      state.gauges["memory_available_bytes"] = available
  1002	      state.gauges["memory_available_min_bytes"] =
  1003	        state.hasAvailableMemorySample
  1004	        ? min(state.gauges["memory_available_min_bytes"] ?? available, available)
  1005	        : available
  1006	      state.hasAvailableMemorySample = true
  1007	    case .error(let code, _):
  1008	      state.errors[code.domain] = code
  1009	    case .clearError(let domain, _):
  1010	      state.errors.removeValue(forKey: domain)
  1011	    case .sshBootstrapError(let diagnostic, _):
  1012	      state.sshBootstrapError = diagnostic
  1013	    case .clearSSHBootstrapError:
  1014	      state.sshBootstrapError = nil
  1015	    case .rejected:
  1016	      incrementKnownCounter("diagnostics_rejected_metric_update_total", by: 1)
  1017	    }
  1018	  }
  1019	
  1020	  private func applyGauge(_ name: String, value: Int64) {
  1021	    switch name {
  1022	    case "packet_bridge_forward_datagram_max_bytes",
  1023	      "packet_bridge_reverse_datagram_max_bytes",
  1024	      "memory_physical_footprint_peak_bytes",
  1025	      "tcp_peak_flows",
  1026	      RuntimeTCPAdapterGauge.peakPendingHandshakes.rawValue,
  1027	      RuntimeTCPAdapterGauge.peakReservedFlows.rawValue,
  1028	      RuntimeTCPAdapterGauge.peakOpeningFlows.rawValue,
  1029	      RuntimeTCPAdapterGauge.peakOpenChannels.rawValue,
  1030	      RuntimeTCPAdapterGauge.peakReservedQueuedBytes.rawValue,
  1031	      RuntimeTCPAdapterGauge.peakAdapterBufferedBytes.rawValue,
  1032	      "hev_transmitted_packets",
  1033	      "hev_transmitted_bytes",
  1034	      "hev_received_packets",
  1035	      "hev_received_bytes":
  1036	      state.gauges[name] = max(state.gauges[name] ?? 0, value)
  1037	    case "memory_available_min_bytes":
  1038	      if state.hasAvailableMemorySample {
  1039	        state.gauges[name] = min(state.gauges[name] ?? value, value)
  1040	      } else {
  1041	        state.gauges[name] = value
  1042	        state.hasAvailableMemorySample = true
  1043	      }
  1044	    default:
  1045	      state.gauges[name] = value
  1046	    }
  1047	  }
  1048	
  1049	  private func mergeDroppedUpdates() {
  1050	    let dropped = state.droppedUpdates.value.exchange(0, ordering: .relaxed)
  1051	    incrementKnownCounter("diagnostics_ingestion_drop_total", by: dropped)
  1052	  }
  1053	
  1054	  private func reconcileTCPAdmissionGauges() {
  1055	    guard let snapshot = state.tcpAdmissionGauges.load() else { return }
  1056	    state.gauges[RuntimeTCPAdapterGauge.sessionHealthCode.rawValue] =
  1057	      snapshot.sessionHealthCode
  1058	    state.gauges[RuntimeTCPAdapterGauge.pendingHandshakes.rawValue] =
  1059	      snapshot.pendingHandshakes
  1060	    state.gauges[RuntimeTCPAdapterGauge.reservedFlows.rawValue] = snapshot.reservedFlows
  1061	    state.gauges[RuntimeTCPAdapterGauge.parsingFlows.rawValue] = snapshot.parsingFlows
  1062	    state.gauges[RuntimeTCPAdapterGauge.openingFlows.rawValue] = snapshot.openingFlows
  1063	    state.gauges[RuntimeTCPAdapterGauge.streamingFlows.rawValue] = snapshot.streamingFlows
  1064	    state.gauges[RuntimeTCPAdapterGauge.halfClosedFlows.rawValue] = snapshot.halfClosedFlows
  1065	    state.gauges[RuntimeTCPAdapterGauge.openChannels.rawValue] = snapshot.openChannels
  1066	    state.gauges[RuntimeTCPAdapterGauge.reservedQueuedBytes.rawValue] =
  1067	      snapshot.reservedQueuedBytes
  1068	    state.gauges[RuntimeTCPAdapterGauge.adapterBufferedBytes.rawValue] =
  1069	      snapshot.adapterBufferedBytes
  1070	    state.gauges[RuntimeTCPAdapterGauge.localToSSHBufferedBytes.rawValue] =
  1071	      snapshot.localToSSHBufferedBytes
  1072	    state.gauges[RuntimeTCPAdapterGauge.sshToLocalBufferedBytes.rawValue] =
  1073	      snapshot.sshToLocalBufferedBytes
  1074	    state.gauges[RuntimeTCPAdapterGauge.peakPendingHandshakes.rawValue] =
  1075	      snapshot.peakPendingHandshakes
  1076	    state.gauges[RuntimeTCPAdapterGauge.peakReservedFlows.rawValue] =
  1077	      snapshot.peakReservedFlows
  1078	    state.gauges[RuntimeTCPAdapterGauge.peakOpeningFlows.rawValue] =
  1079	      snapshot.peakOpeningFlows
  1080	    state.gauges[RuntimeTCPAdapterGauge.peakOpenChannels.rawValue] =
  1081	      snapshot.peakOpenChannels
  1082	    state.gauges[RuntimeTCPAdapterGauge.peakReservedQueuedBytes.rawValue] =
  1083	      snapshot.peakReservedQueuedBytes
  1084	    state.gauges[RuntimeTCPAdapterGauge.peakAdapterBufferedBytes.rawValue] =
  1085	      snapshot.peakAdapterBufferedBytes
  1086	    state.gauges["tcp_active_flows"] = snapshot.reservedFlows
  1087	    state.gauges["tcp_peak_flows"] = snapshot.peakReservedFlows
  1088	  }
