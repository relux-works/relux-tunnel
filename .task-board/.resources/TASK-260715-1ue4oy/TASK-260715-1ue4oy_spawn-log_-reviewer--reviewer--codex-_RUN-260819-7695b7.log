   449	def build_manifest(contract: dict[str, Any], contents: list[bytes]) -> dict[str, Any]:
   450	    assets: list[dict[str, Any]] = []
   451	    for source, binary in zip(contract["assets"], contents, strict=True):
   452	        digest = sha256_bytes(binary)
   453	        identity = {
   454	            "schemaVersion": IDENTITY_SCHEMA_VERSION,
   455	            "relayProtocolVersion": contract["relayProtocolVersion"],
   456	            "relayVersion": contract["relayVersion"],
   457	            "sourceCommit": contract["sourceCommit"],
   458	            "os": source["os"],
   459	            "arch": source["arch"],
   460	            "selfSha256": digest,
   461	        }
   462	        assets.append(
   463	            {
   464	                "os": source["os"],
   465	                "arch": source["arch"],
   466	                "fileName": source["fileName"],
   467	                "bundleLocation": f"{contract['bundleSubdirectory']}/{source['fileName']}",
   468	                "byteSize": len(binary),
   469	                "sha256": digest,
   470	                "relayProtocolVersion": contract["relayProtocolVersion"],
   471	                "buildIdentity": identity,
   472	                "buildProvenanceReference": "#/buildProvenance",
   473	            }
   474	        )
   475	    return {
   476	        "schemaVersion": contract["manifestSchemaVersion"],
   477	        "relayProtocolVersion": contract["relayProtocolVersion"],
   478	        "buildProvenance": contract["buildProvenance"],
   479	        "assets": assets,
   480	    }
