diff --git a/Probes/macOSPacketTunnelProbe/Host/Info.plist b/Probes/macOSPacketTunnelProbe/Host/Info.plist
new file mode 100644
index 0000000000000000000000000000000000000000..257665c07d98b9bcd7e474bb2403ee6768cd8acd
--- /dev/null
+++ b/Probes/macOSPacketTunnelProbe/Host/Info.plist
@@ -0,0 +1,32 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0">
