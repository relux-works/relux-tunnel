    54	ENDPOINT_WORKER = r'''
    55	import hashlib,json,signal,socket,struct,threading,time
    56	TASK_ID = "TASK-260715-39xz9g"
    57	MODES = ("echo","sink","early-close","half-close","reset","disconnect")
    58	stopping = threading.Event()
    59	listeners = {}
    60	
    61	def handle(connection, mode):
    62	    with connection:
    63	        if mode == "early-close":
    64	            return
    65	        if mode == "reset":
    66	            connection.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))
    67	            return
    68	        if mode == "disconnect":
    69	            connection.recv(65536)
    70	            return
    71	        if mode == "half-close":
    72	            data = connection.recv(65536)
    73	            if data:
    74	                connection.sendall(data)
    75	            connection.shutdown(socket.SHUT_WR)
    76	            while connection.recv(65536):
    77	                pass
    78	            return
    79	        while True:
    80	            data = connection.recv(65536)
    81	            if not data:
    82	                return
    83	            if mode == "echo":
    84	                connection.sendall(data)
    85	
    86	def serve(listener, mode):
    87	    while not stopping.is_set():
    88	        try:
    89	            connection, _ = listener.accept()
    90	        except OSError:
    91	            return
    92	        threading.Thread(target=handle, args=(connection, mode), daemon=True).start()
    93	
    94	for mode in MODES:
    95	    listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    96	    listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    97	    listener.bind(("127.0.0.1", 0))
    98	    listener.listen(32)
    99	    listeners[mode] = listener
   100	    threading.Thread(target=serve, args=(listener, mode), daemon=True).start()
   101	
   102	print(json.dumps({mode:{"host":"127.0.0.1","port":listener.getsockname()[1]}
   103	                  for mode,listener in listeners.items()}, sort_keys=True), flush=True)
   104	
   105	def stop(*_):
   106	    stopping.set()
   107	    for listener in listeners.values():
   108	        listener.close()
   109	    raise SystemExit(0)
   110	
   111	signal.signal(signal.SIGTERM, stop)
   112	signal.signal(signal.SIGHUP, stop)
   113	while True:
   114	    time.sleep(60)
   115	'''
