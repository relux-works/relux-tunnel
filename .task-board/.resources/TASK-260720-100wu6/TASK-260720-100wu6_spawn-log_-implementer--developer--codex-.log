+      negotiatedAlgorithms: nil,
+      keyExchangeGeneration: 0,
+      counters: SSHTransportCounters(),
+      gauges: SSHTransportGauges()
+    )
+  }
+
+  func close() async {}
+
+  func directRequest() -> DirectRequest? {
