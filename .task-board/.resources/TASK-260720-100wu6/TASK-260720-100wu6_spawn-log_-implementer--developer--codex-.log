+
+  public init(
+    code: SSHTransportErrorCode,
+    phase: SSHTransportPhase,
+    scope: SSHTransportErrorScope,
+    retryDisposition: SSHRetryDisposition,
+    requiresTeardown: Bool,
+    channelOpenReason: SSHChannelOpenFailureReason? = nil
