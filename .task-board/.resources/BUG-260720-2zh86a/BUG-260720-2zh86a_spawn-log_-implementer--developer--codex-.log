+def deployment_minimums(item: dict[str, Any]) -> dict[str, str]:
+    minimums: dict[str, str] = {}
+    for slice_ in expected_slices(item):
+        platform = slice_["platform"]
+        minimum = slice_.get("minimum")
+        if not minimum:
+            raise NativeDependencyError(
