+        let snapshot = manager.snapshot
+        #expect(snapshot.bufferedBytes == 16 * 1024)
+        #expect(snapshot.deliveredButUnadjustedBytes == 0)
+        #expect(snapshot.adjustmentCount == 1)
+        #expect(snapshot.adjustmentBytes == 32 * 1024)
+    }
