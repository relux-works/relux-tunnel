   728	  private func raceStart(_ operation: Task<StartRaceResult, Never>) async -> StartRaceResult {
   729	    let first = ProviderFirstResult<StartRaceResult>()
   730	    Task {
   760	      guard let self else {
   761	        gate.complete(())
   762	        return
   763	      }
   764	      await self.stopWithRawReason(rawReason, gate: gate)
   765	    }
   766	  }
   767	
   768	  private func stopWithRawReason(
   769	    _ rawReason: Int,
   770	    gate: ProviderOnceGate<Void>
   771	  ) async {
   772	    lifecycleDiagnostics?.recordProviderStopReason(rawValue: rawReason)
   773	    let reason = ProviderStopReason.apple(rawValue: rawReason, duringStartup: phase == .starting)
   774	    await performStop(reason: reason, gate: gate)
   775	  }
   776	
   777	  private func performStop(
   778	    reason: ProviderStopReason,
   779	    gate: ProviderOnceGate<Void>?
   780	  ) async {
   781	    if awaitingSystemStopAfterProviderFailure {
   782	      if let cleanupTask {
   783	        _ = await cleanupTask.value
   784	        finalizeCleanup(
   785	          generation: cleanupGeneration,
   786	          keepStoppingAfterCleanup: true
   787	        )
   788	      }
   789	      pendingStartGate?.complete(ProviderNSErrorCode.startCancelled.nsError)
   790	      pendingStartGate = nil
   791	      awaitingSystemStopAfterProviderFailure = false
   792	      phase = .idle
   793	      gate?.complete(())
   794	      return
   795	    }
   796	
   797	    guard let generation = activeGeneration?.identifier else {
   798	      phase = .idle
   799	      pendingStartGate?.complete(ProviderNSErrorCode.startCancelled.nsError)
   800	      pendingStartGate = nil
   801	      gate?.complete(())
   802	      return
   803	    }
   804	
   805	    await stopAndJoin(
   806	      reason: reason,
   807	      generation: generation,
   808	      keepStoppingAfterCleanup: false
   809	    )
   810	    pendingStartGate?.complete(ProviderNSErrorCode.startCancelled.nsError)
   811	    pendingStartGate = nil
   812	    gate?.complete(())
   813	  }
   814	
   815	  private func stopAndJoin(
   816	    reason: ProviderStopReason,
   817	    generation: UInt64,
   818	    keepStoppingAfterCleanup: Bool
   819	  ) async {
   820	    guard activeGeneration?.identifier == generation || cleanupGeneration == generation else {
   821	      return
   822	    }
   823	    let operation = beginCleanup(reason: reason, generation: generation)
   824	    _ = await operation.value
   825	    finalizeCleanup(
   826	      generation: generation,
   827	      keepStoppingAfterCleanup: keepStoppingAfterCleanup
   828	    )
   829	  }
   830	
   831	  private func joinCleanupIfPresent(generation: UInt64) async {
   832	    guard cleanupGeneration == generation, let cleanupTask else { return }
   833	    _ = await cleanupTask.value
   834	    finalizeCleanup(generation: generation, keepStoppingAfterCleanup: false)
   835	  }
   836	
   837	  private func beginCleanup(
   838	    reason: ProviderStopReason,
   839	    generation: UInt64
   840	  ) -> Task<CleanupRaceResult, Never> {
   841	    if cleanupGeneration == generation, let cleanupTask {
   842	      return cleanupTask
   843	    }
   844	
   845	    phase = .stopping
   846	    retireRequestLedger(generation: generation)
   847	    activeGeneration?.retirementSignal.retire()
   848	    let runtime = activeGeneration?.identifier == generation ? activeGeneration?.runtime : nil
   849	    let registry =
   850	      activeGeneration?.identifier == generation
   851	      ? activeGeneration?.cleanupRegistry : nil
   852	    registry?.cancelAll()
   853	
   854	    let operation = Task { [clock = dependencies.clock, cleanupBudget, lifecycleDiagnostics] in
   855	      guard let registry else { return CleanupRaceResult.graceful }
   856	      guard let runtime else {
   857	        registry.retireAfterGracefulCleanup()
   858	        return .graceful
   859	      }
   860	
   861	      let first = ProviderFirstResult<CleanupRaceResult>()
   862	      let graceful = Task {
   863	        await runtime.stop(reason: reason)
   864	        first.resolve(.graceful)
   865	      }
   866	      let deadline = Task {
   867	        do {
   868	          try await clock.sleep(for: cleanupBudget)
   869	          first.resolve(.deadline)
   870	        } catch {
   871	          // Cancellation means graceful cleanup won the race.
   872	        }
   873	      }
   874	
   875	      let result = await first.wait()
   876	      switch result {
   877	      case .graceful:
   878	        deadline.cancel()
   879	        registry.retireAfterGracefulCleanup()
   880	      case .deadline:
   881	        graceful.cancel()
   882	        registry.forceCloseAll()
   883	        lifecycleDiagnostics?.recordProviderCleanupDeadlineExceeded()
   884	      }
   885	      return result
   886	    }
   887	    cleanupGeneration = generation
   888	    cleanupTask = operation
   889	    return operation
   890	  }
   891	
   892	  private func finalizeCleanup(
   893	    generation: UInt64?,
   894	    keepStoppingAfterCleanup: Bool
   895	  ) {
   896	    guard let generation, cleanupGeneration == generation else { return }
   897	    activeGeneration = nil
   898	    cleanupTask = nil
   899	    cleanupGeneration = nil
   900	    phase = keepStoppingAfterCleanup ? .stopping : .idle
   901	  }
