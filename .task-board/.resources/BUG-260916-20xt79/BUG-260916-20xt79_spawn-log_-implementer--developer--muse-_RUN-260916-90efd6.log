\n38|  relux-relay relux-relay-protocol-test ReluxProxyMac ReluxProxyMacTunnel \\\n39|  ReluxTunnelCore ReluxTunnelHarness UnexpectedScheme\n40|write_list \"$adversarial\" \\\n41|  relux-relay relux-relay-protocol-test ReluxProxyMacTunnel \\\n42|  ReluxTunnelCore ReluxTunnelHarness UnexpectedScheme\n43|\n44|\"$repo_root/scripts/check-workspace-schemes.sh\" \"$valid\" >/dev/null\n45|for invalid in \"$missing\" \"$unexpected\" \"$adversarial\"; do\n46|  if \"$repo_root/scripts/check-workspace-schemes.sh\" \"$invalid\" >/dev/null 2>&1; then\n47|    echo \"error: invalid scheme fixture unexpectedly passed: $invalid\" >&2\n48|    exit 1\n49|  fi\n50|done\n51|\n52|workflow=\"$repo_root/.github/workflows/ci.yml\"\n53|runner_label='    runs-on: macos-15'\n54|mise_action='      - uses: jdx/mise-action@3c2e0cf82a5b2e5249f0d3635a4d83d0ae861518 # v4.2.5'\n55|arm64_checksum='          sha256: c7a0eb1035de974b42d36b69c4b55b836c06b455b990dd6ac530aaf05d4a8a17 # mise-v2026.3.10-macos-arm64'\n56|test \"$(grep -Fxc \"$runner_label\" \"$workflow\")\" -eq 1\n57|test \"$(grep -Fxc \"$mise_action\" \"$workflow\")\" -eq 1\n58|grep -Fx '          version: 2026.3.10' \"$workflow\" >/dev/null\n59|test \"$(grep -Fxc \"$arm64_checksum\" \"$workflow\")\" -eq 1\n60|grep -Fx '          install: false' \"$workflow\" >/dev/null\n61|test \"$(grep -Fc 'make credential-free-validate LEGACY_ROOT=' \"$workflow\")\" -eq 1\n62|\n63|runner_line=$(grep -nF \"$runner_label\" \"$workflow\" | cut -d: -f1)\n64|mise_line=$(grep -nF \"$mise_action\" \"$workflow\" | cut -d: -f1)\n65|checksum_line=$(grep -nF \"$arm64_checksum\" \"$workflow\" | cut -d: -f1)\n66|gate_line=$(grep -nF 'make credential-free-validate LEGACY_ROOT=' \"$workflow\" | cut -d: -f1)\n67|test \"$runner_line\" -lt \"$mise_line\"\n68|test \"$mise_line\" -lt \"$checksum_line\"\n69|test \"$mise_line\" -lt \"$gate_line\"\n70|\n71|\"$repo_root/scripts/tests/test-generated-provider-graph.sh\" >/dev/null\n72|\n73|echo \"credential-free validation contract tests passed\"","final_result":true}}}
