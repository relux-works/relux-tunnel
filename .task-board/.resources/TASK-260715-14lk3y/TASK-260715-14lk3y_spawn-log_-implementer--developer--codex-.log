#!/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VERSION="${VERSION:-0.1.0-dev}"
VERSION="${VERSION#v}"
SHORT_VERSION="${VERSION%%-*}"
BUILD_NUMBER="${BUILD_NUMBER:-$(git -C "$ROOT" rev-list --count HEAD 2>/dev/null || echo 1)}"
APP_NAME="ReluxProxy"
BUNDLE="$ROOT/dist/$APP_NAME.app"
SIGN_IDENTITY="${SIGN_IDENTITY:-Developer ID Application: Relux Works, LLC (262RZ595FP)}"

cd "$ROOT"
rm -rf "$BUNDLE"
mkdir -p "$BUNDLE/Contents/MacOS" "$BUNDLE/Contents/Resources"

BUILD_ARGUMENTS=(-c release)
if [[ "${UNIVERSAL:-1}" == "1" ]]; then
    BUILD_ARGUMENTS+=(--arch arm64 --arch x86_64)
fi

swift build "${BUILD_ARGUMENTS[@]}"
BIN_DIR="$(swift build "${BUILD_ARGUMENTS[@]}" --show-bin-path)"
cp "$BIN_DIR/ReluxProxy" "$BUNDLE/Contents/MacOS/ReluxProxy"
cp "$ROOT/Resources/Info.plist" "$BUNDLE/Contents/Info.plist"
swift "$ROOT/scripts/generate-icon.swift" "$BUNDLE/Contents/Resources/ReluxProxy.icns"

/usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $SHORT_VERSION" "$BUNDLE/Contents/Info.plist"
/usr/libexec/PlistBuddy -c "Set :CFBundleVersion $BUILD_NUMBER" "$BUNDLE/Contents/Info.plist"

if [[ "$SIGN_IDENTITY" == "-" ]]; then
    codesign --force --sign - "$BUNDLE"
elif security find-identity -v -p codesigning | grep -Fq "$SIGN_IDENTITY"; then
    codesign --force --options runtime --timestamp --sign "$SIGN_IDENTITY" "$BUNDLE"
else
    echo "warning: '$SIGN_IDENTITY' not found; using an ad-hoc signature" >&2
    codesign --force --sign - "$BUNDLE"
fi

codesign --verify --deep --strict --verbose=2 "$BUNDLE"
echo "Built $BUNDLE ($VERSION, build $BUILD_NUMBER)"
#!/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VERSION="${VERSION:-0.1.0-dev}"
VERSION="${VERSION#v}"
APP="$ROOT/dist/ReluxProxy.app"
DMG="$ROOT/dist/ReluxProxy-v$VERSION-universal.dmg"
STAGE="$ROOT/.build/dmg-root"

if [[ ! -d "$APP" ]]; then
    echo "error: $APP does not exist; run scripts/build-app.sh first" >&2
    exit 1
fi

rm -rf "$STAGE" "$DMG"
mkdir -p "$STAGE"
cp -R "$APP" "$STAGE/"
ln -s /Applications "$STAGE/Applications"
hdiutil create -volname "Relux Proxy" -srcfolder "$STAGE" -ov -format UDZO "$DMG"
echo "Built $DMG"
import XCTest
@testable import ReluxProxy

final class TunnelConfigurationTests: XCTestCase {
    func testBuildsTargetWithAccount() throws {
        let configuration = TunnelConfiguration(
            host: " relux ",
            account: " administrator ",
            localPort: 1_080
        )

        XCTAssertEqual(configuration.target, "administrator@relux")
        XCTAssertEqual(configuration.localEndpoint, "127.0.0.1:1080")
        XCTAssertNil(configuration.validationError)
    }

    func testBuildsTargetWithoutAccount() {
        let configuration = TunnelConfiguration(host: "relux", account: "", localPort: 9_050)
        XCTAssertEqual(configuration.target, "relux")
    }

    func testRejectsInvalidValues() {
        XCTAssertNotNil(TunnelConfiguration(host: "", account: "user", localPort: 1_080).validationError)
        XCTAssertNotNil(TunnelConfiguration(host: "bad host", account: "user", localPort: 1_080).validationError)
        XCTAssertNotNil(TunnelConfiguration(host: "host", account: "bad@user", localPort: 1_080).validationError)
        XCTAssertNotNil(TunnelConfiguration(host: "host", account: "user", localPort: 70_000).validationError)
    }

    func testSSHArgumentsMatchHardenedTunnelSetup() throws {
        let configuration = TunnelConfiguration(host: "relux", account: "administrator", localPort: 1_080)
        let arguments = try SSHCommandBuilder.arguments(for: configuration)

        XCTAssertEqual(
            arguments,
            [
                "-N",
                "-C",
                "-D", "127.0.0.1:1080",
                "-o", "ExitOnForwardFailure=yes",
                "-o", "ServerAliveInterval=30",
                "-o", "ServerAliveCountMax=3",
                "-o", "ConnectTimeout=15",
                "-o", "BatchMode=yes",
                "-o", "LogLevel=ERROR",
                "administrator@relux",
            ]
        )
    }
}
import Foundation

struct TunnelConfiguration: Equatable {
    let host: String
    let account: String
    let localPort: Int

    var normalizedHost: String {
        host.trimmingCharacters(in: .whitespacesAndNewlines)
    }

    var normalizedAccount: String {
        account.trimmingCharacters(in: .whitespacesAndNewlines)
    }

    var target: String {
        normalizedAccount.isEmpty
            ? normalizedHost
            : "\(normalizedAccount)@\(normalizedHost)"
    }

    var localEndpoint: String {
        "127.0.0.1:\(localPort)"
    }

    var validationError: String? {
        if normalizedHost.isEmpty {
            return "Enter an SSH host or an alias from ~/.ssh/config."
        }
        if normalizedHost.contains(where: \Character.isWhitespace) {
            return "The SSH host cannot contain whitespace."
        }
        if normalizedAccount.contains(where: \Character.isWhitespace)
            || normalizedAccount.contains("@") {
            return "The SSH account must not contain whitespace or @."
        }
        if !(1...65_535).contains(localPort) {
            return "The local port must be between 1 and 65535."
        }
        return nil
    }
}
import Foundation

enum SSHCommandBuilder {
    static let executableURL = URL(fileURLWithPath: "/usr/bin/ssh")

    static func arguments(for configuration: TunnelConfiguration) throws -> [String] {
        if let error = configuration.validationError {
            throw SSHCommandError.invalidConfiguration(error)
        }

        return [
            "-N",
            "-C",
            "-D", configuration.localEndpoint,
            "-o", "ExitOnForwardFailure=yes",
            "-o", "ServerAliveInterval=30",
            "-o", "ServerAliveCountMax=3",
            "-o", "ConnectTimeout=15",
            "-o", "BatchMode=yes",
            "-o", "LogLevel=ERROR",
            configuration.target,
        ]
    }
}

enum SSHCommandError: LocalizedError, Equatable {
    case invalidConfiguration(String)

    var errorDescription: String? {
        switch self {
        case let .invalidConfiguration(message):
            return message
        }
    }
}
# Relux Proxy

Relux Proxy currently ships as a native macOS menu bar app that manages an SSH
dynamic SOCKS5 tunnel. It uses the system `/usr/bin/ssh`, so hosts, keys, jump
hosts, and other options from `~/.ssh/config` continue to work.

The repository also contains the approved specifications and implementation
backlog for a future macOS/iOS system VPN over SSH. That VPN is not implemented
yet. Start with [the specification index](.spec/README.md),
[the current-state inventory](docs/current-state.md), and
[the saved task-board workflow](docs/project-management.md).

## Use

1. Open Relux Proxy from Applications.
2. Enter the SSH host (or config alias), account, and local SOCKS port.
3. Choose **Connect**.
4. In Firefox, open **Settings → Network Settings**, select **Manual proxy configuration**, and set:
   - SOCKS Host: `127.0.0.1`
   - Port: the port shown by Relux Proxy (`1080` by default)
   - SOCKS v5
   - Proxy DNS when using SOCKS v5

The initial defaults are `administrator@relux` and `127.0.0.1:1080`.

## Download

The latest signed and notarized build always has the same asset name and URL
(GitHub authentication is required while this repository is private):

https://github.com/relux-works/relux-proxy/releases/latest/download/ReluxProxy.dmg

Versioned DMGs and SHA-256 checksums are available on the GitHub Releases page.

## Development

Requirements: macOS 14 or newer and Xcode 15.3 or newer.

```bash
make test
make app
make run
```

The app is intentionally not sandboxed because it needs to launch the system SSH executable. Release bundles use the hardened runtime and are signed with the Relux Works Developer ID.

Contributors must follow [CONTRIBUTING.md](CONTRIBUTING.md). Planned VPN work is
tracked in `.task-board/`; no VPN implementation should begin without explicit
approval of the generated plan.

## Release

Push a semantic version tag to build, sign, notarize, staple, attest, and publish both versioned and stable-name DMGs:

```bash
git tag -s v0.1.0 -m "Relux Proxy v0.1.0"
git push origin v0.1.0
```

The release workflow expects `MACOS_CERT_P12`, `ASC_KEY_ID`, `ASC_ISSUER_ID`, and `ASC_KEY_P8` repository secrets. `ASC_KEY_P8` and `MACOS_CERT_P12` are base64 encoded.

