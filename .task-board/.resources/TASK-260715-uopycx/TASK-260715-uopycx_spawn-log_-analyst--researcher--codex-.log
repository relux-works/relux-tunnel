    56	static int
    57	hev_socks5_udp_sendmmsg_tcp (HevSocks5UDP *self, HevSocks5UDPMsg *msgv,
    58	                             unsigned int num)
    59	{
    60	    struct iovec iov[num * 3];
    61	    HevSocks5UDPHdr udp[num];
    62	    struct msghdr mh;
    63	    int i, res;
    64	
    65	    mh.msg_name = NULL;
    66	    mh.msg_namelen = 0;
    67	    mh.msg_control = NULL;
    68	    mh.msg_controllen = 0;
    69	    mh.msg_iov = iov;
    70	    mh.msg_iovlen = num * 3;
    71	
    72	    for (i = 0; i < num; i++) {
    73	        int addrlen;
    74	
    75	        addrlen = hev_socks5_addr_len (msgv[i].addr);
    76	        if (addrlen <= 0) {
    77	            LOG_D ("%p socks5 udp addr", self);
    78	            return -1;
    79	        }
    80	
    81	        udp[i].datlen = htons (msgv[i].len);
    82	        udp[i].hdrlen = 3 + addrlen;
    83	
    84	        iov[i * 3].iov_base = &udp[i];
    85	        iov[i * 3].iov_len = 3;
    86	        iov[i * 3 + 1].iov_base = msgv[i].addr;
    87	        iov[i * 3 + 1].iov_len = addrlen;
    88	        iov[i * 3 + 2].iov_base = msgv[i].buf;
    89	        iov[i * 3 + 2].iov_len = msgv[i].len;
    90	    }
    91	
    92	    res = hev_task_io_socket_sendmsg (hev_socks5_udp_get_fd (self), &mh,
    93	                                      MSG_WAITALL, task_io_yielder, self);
    94	    if (res <= 0) {
    95	        LOG_D ("%p socks5 udp write tcp", self);
    96	        return -1;
    97	    }
    98	
    99	    return num;
   100	}
