+    let channelWrite: StallSSHByteChannel.WriteBehavior
+    let scheduler: FirstYieldGateBytePumpScheduler?
+
+    switch site {
+    case .localReadable:
+      readBehavior = .wouldBlockStall
+      writeBehavior = .accept
+      channelRead = .eof
+      channelWrite = .accept
+      scheduler = nil
+    case .localWritable:
