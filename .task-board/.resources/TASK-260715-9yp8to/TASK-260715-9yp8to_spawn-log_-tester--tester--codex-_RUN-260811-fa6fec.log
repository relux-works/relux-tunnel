+    preflight)
+      shift
+      preflight "$@"
+      ;;
+    exercise)
+      shift
+      exercise "$@"
+      ;;
+    verify-log)
+      [ "$#" -eq 3 ] || { usage; return 2; }
+      verify_lifecycle_log "$2" "$3"
+      ;;
