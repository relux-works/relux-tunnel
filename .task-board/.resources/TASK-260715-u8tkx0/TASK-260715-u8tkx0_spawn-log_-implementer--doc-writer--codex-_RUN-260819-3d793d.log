+        })
+    elif component["id"] == "relay-build-recipe":
+        component.update({
+            "version": recipe_commit,
+            "revision": recipe_commit,
+            "contentSHA256": supply["build"]["recipeAggregateSHA256"],
+            "source": recipe_url,
+            "licenseTextSHA256": hashlib.sha256(
