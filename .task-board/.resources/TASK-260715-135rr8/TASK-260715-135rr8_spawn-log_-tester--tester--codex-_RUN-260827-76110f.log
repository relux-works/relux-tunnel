exec
/bin/zsh -lc "sed -n '761,1100p' /Users/iv/.claude/skills/project-management/references/tracked-background-spawn.md
sed -n '1101,1520p' /Users/iv/.claude/skills/project-management/references/tracked-background-spawn.md" in /Users/iv/Developer/relux-tunnel/.temp/STORY-260716-2m2tl1/worktree
