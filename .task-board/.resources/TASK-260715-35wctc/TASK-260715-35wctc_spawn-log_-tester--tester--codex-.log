+    let sourcePort = self.sourcePort
+    let destinationPort = self.destinationPort
+    let match = try await nextSegment(from: driver) {
+      $0.sourcePort == destinationPort && $0.destinationPort == sourcePort
+        && !$0.payload.isEmpty
