{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c83f","stream":{"kind":"session","id":"01a0a9b7-1be4-70c3-9f65-33dc9d5961ad"},"sequence":634,"recorded_at":1780531400001263,"record_type":"event","durability":"durable","causation_id":"f764a614-f959-4acf-aa23-1fc534b9bf47","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f764a614-f959-4acf-aa23-1fc534b9bf47","run_stream":{"kind":"run","id":"f764a614-f959-4acf-aa23-1fc534b9bf47"},"task_stream":{"kind":"task","id":"01a0a9b9-dd1e-7be1-80c5-2e8c8e0b3c6a"},"task_id":"01a0a9b9-dd1e-7be1-80c5-2e8c8e0b3c6a","event":{"kind":"output","task_id":"01a0a9b9-dd1e-7be1-80c5-2e8c8e0b3c6a","chunk":"Read text file `Sources/ReluxTunnelCore/SSHBootstrapDiagnostics.swift`.\n(248 line(s) above)\n249|/// Typed, privacy-safe platform transport causes retained behind the public projection.\n250|public enum SSHBootstrapTransportCause: Hashable, Sendable {\n251|  case unavailable\n252|  case timedOut\n253|  case connectionRefused\n254|  case connectionReset\n255|  case connectionAborted\n256|  case temporaryResourceExhaustion\n257|  case cancelled\n258|  case unexpected\n259|}\n260|\n261|public enum SSHBootstrapHostCause: Equatable, Sendable {\n262|  case trustRequired\n263|  case changed\n264|  case algorithmUnsupported\n265|  case revoked\n266|  case policyRejected\n267|}\n268|\n269|public enum SSHBootstrapCredentialCause: Equatable, Sendable {\n270|  case notProvisioned\n271|  case accessDenied\n272|  case generationMismatch\n273|  case malformed\n274|  case passphraseRequired\n275|  case passphraseInvalid\n276|  case keyUnsupported\n277|  case mutationConflict\n278|  case referenceCollision\n279|  case formatRegistryUnavailable\n280|  case reconciliationProfileSetUnavailable\n281|  case reconciliationLimitExceeded\n282|  case reconciliationFailed\n283|}\n284|\n285|public enum SSHBootstrapAuthenticationCause: Equatable, Sendable {\n286|  case rejected\n287|  case methodUnavailable\n288|  case keyAlgorithmUnavailable\n289|  case signatureFailed\n290|}\n291|\n292|public enum SSHBootstrapCancellationCause: Equatable, Sendable {\n293|  case taskCancelled\n294|  case userStopped\n295|}\n296|\n297|public enum SSHBootstrapSessionCloseCause: Equatable, Sendable {\n298|  case timedOut\n299|  case transportFailure\n300|  case invariantViolation\n301|}\n302|\n303|/// Internal mapping evidence is deliberately typed and contains no source description.\n304|public enum SSHBootstrapInternalCause: Equatable, Sendable {\n305|  case profile(SSHProfileSnapshotLoaderError)\n306|  case physicalPath(SSHBootstrapTransportCause)\n307|  case endpointConnect(SSHBootstrapTransportCause)\n308|  case negotiation(SSHBootstrapTransportCause)\n309|  case host(SSHBootstrapHostCause)\n310|  case credential(SSHBootstrapCredentialCause)\n311|  case authentication(SSHBootstrapAuthenticationCause)\n312|  case cancellation(SSHBootstrapCancellationCause)\n313|  case operationTimedOut(SSHBootstrapStage)\n314|  case transportInterrupted(SSHBootstrapStage, SSHBootstrapTransportCause)\n315|  case sessionClose(SSHBootstrapSessionCloseCause)\n316|  case invariantViolation(SSHBootstrapStage)\n317|}\n318|\n319|/// Testable mapping result. Provider consumers should expose `providerError`, not `cause`.\n320|struct SSHBootstrapMappedFailure: Equatable, Sendable {\n321|  let cause: SSHBootstrapInternalCause\n322|  let providerError: SSHBootstrapProviderError\n323|}\n324|\n325|/// Stable bootstrap mapping. It classifies only; it never schedules a retry.\n326|public enum SSHBootstrapErrorMapper {\n327|  public static func profile(\n328|    _ error: SSHProfileSnapshotLoaderError,\n329|    configurationGeneration: UInt64 = 0\n330|  ) -> SSHBootstrapProviderError {\n331|    map(.profile(error), configurationGeneration: configurationGeneration).providerError\n332|  }\n333|\n334|  public static func transport(\n335|    _ error: SSHTransportError,\n336|    configurationGeneration: UInt64,\n337|    context: SSHBootstrapDiagnosticContext = .none\n338|  ) -> SSHBootstrapProviderError {\n339|    map(transportCause(error), configurationGeneration: configurationGeneration, context: context)\n340|      .providerError\n341|  }\n342|\n343|  /// Maps an untrusted platform error without retaining its domain, userInfo, or description.\n344|  public static func transport(\n345|    _ error: any Error,\n346|    stage: SSHBootstrapStage,\n347|    configurationGeneration: UInt64,\n348|    context: SSHBootstrapDiagnosticContext = .none\n349|  ) -> SSHBootstrapProviderError {\n350|    let normalized: SSHBootstrapTransportCause\n351|    if error is CancellationError {\n352|      normalized = .cancelled\n353|    } else {\n354|      let nsError = error as NSError\n355|      if nsError.domain == NSPOSIXErrorDomain {\n356|        normalized = posixCause(Int32(clamping: nsError.code))\n357|      } else if nsError.domain == NSURLErrorDomain {\n358|        normalized = urlCause(nsError.code)\n359|      } else {\n360|        normalized = .unexpected\n361|      }\n362|    }\n363|    return transport(\n364|      normalized,\n365|      stage: stage,\n366|      configurationGeneration: configurationGeneration,\n367|      context: context\n368|    )\n(more lines below)","final_result":true}}}
