   271	
   272	    switch (result->ai_family) {
   273	    case AF_INET: {
   274	        struct sockaddr_in *sa = (struct sockaddr_in *)result->ai_addr;
   275	        memset (&saddr->sin6_addr, 0, 10);
   276	        saddr->sin6_addr.s6_addr[10] = 0xff;
   277	        saddr->sin6_addr.s6_addr[11] = 0xff;
   278	        memcpy (&saddr->sin6_addr.s6_addr[12], &sa->sin_addr, 4);
   279	        *family = HEV_SOCKS5_ADDR_FAMILY_IPV4;
