    ]
    let expectedGauges = [
      "openDirectChannels", "openExecChannels", "pendingChannelOpens", "pendingReads",
      "pendingWrites", "queuedWriteBytes", "bufferedReadBytes",
      "remainingReceiveWindowBytes", "activeKeyExchange", "consecutiveKeepaliveMisses",
