     1	#!/bin/sh
     2	set -eu
     3	
     4	repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
     5	task_root="$repo_root/.temp/TASK-260715-1idq8c/apple-ui-test"
     6	mkdir -p "$task_root"
     7	run_root=$(mktemp -d "$task_root/run.XXXXXX")
     8	macos_derived_data="$run_root/DerivedData-macos"
     9	ios_derived_data="$run_root/DerivedData-ios-simulator"
    10	cd "$repo_root"
    11	
    12	./scripts/generate-workspace.sh --clean
    13	
    14	build_macos_for_testing() {
    15	  log="$run_root/macos-build-for-testing-xcodebuild.log"
    16	  products="$run_root/macos-build-for-testing-products.txt"
    17	
    18	  if xcodebuild \
    19	    -workspace ReluxTunnel.xcworkspace \
    20	    -scheme ReluxProxyMacUITests \
    21	    -configuration Debug \
    22	    -destination 'platform=macOS' \
    23	    -derivedDataPath "$macos_derived_data" \
    24	    CODE_SIGNING_ALLOWED=NO \
    25	    CODE_SIGNING_REQUIRED=NO \
    26	    build-for-testing > "$log" 2>&1; then
    27	    row_status=0
    28	  else
    29	    row_status=$?
    30	  fi
    31	
    32	  find \
    33	    "$repo_root/.build/Products" \
    34	    "$macos_derived_data/Build/Products" \
    35	    -name 'ReluxProxyMacUITests_*.xctestrun' -print \
    36	    > "$products" 2>/dev/null || true
    37	  if [ "$row_status" -eq 0 ] && [ ! -s "$products" ]; then
    38	    echo "error: native macOS build-for-testing produced no xctestrun" >> "$log"
    39	    row_status=1
    40	  fi
    41	  return "$row_status"
    42	}
    43	
    44	run_ui_test() {
    45	  scheme=$1
    46	  destination=$2
    47	  result_name=$3
    48	  test_target=$4
