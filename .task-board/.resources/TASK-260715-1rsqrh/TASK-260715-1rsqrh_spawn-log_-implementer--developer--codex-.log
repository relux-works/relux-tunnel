        revision: revision
      ) {
        statusProjection = VPNStatusProjection(systemStatus: .connected)
      }
      return
    }
    lastAcceptedProviderPosition = facts.position
    statusProjection = VPNStatusProjection(systemStatus: .connected, providerFacts: facts)
  }

