  private func performChannelRead(
    identity: SSHChannelIdentity,
    maximumBytes: Int,
    stream: Int32
  ) async throws -> Data? {
    guard maximumBytes > 0 else {
      throw transportError(
        code: .invalidArgument,
        phase: .channelRead,
        scope: .channel(identity)
