   235	func (h *ServerHandshake) Consume(generation uint64, now time.Time, input []byte) ServerHandshakeStep {
   236		if generation != h.generation {
   237			return ServerHandshakeStep{State: h.state, StaleCallbackIgnored: true}
   238		}
   239		if h.state == ServerHandshakeFailed {
   240			return ServerHandshakeStep{State: h.state, Failure: h.failure, Close: true}
   241		}
   242		if h.state == ServerHandshakeCompleted {
   243			if len(input) == 0 {
   244				return ServerHandshakeStep{State: h.state, Result: h.result}
   245			}
   246			code := HandshakeTrailingHelloBytes
   247			if beginsWithHelloMagic(input) {
   248				code = HandshakeDuplicateHello
   249			}
   250			return h.fail(handshakeFailure(code, HandshakePhaseTerminal), nil)
   251		}
   252		if !now.Before(h.deadline) {
   253			return h.fail(handshakeFailure(HandshakeTimedOut, HandshakePhaseClientHelloRead), nil)
   254		}
   255	
   256		needed := ClientHelloWidth - h.buffered
   257		consumed := min(needed, len(input))
   258		copy(h.hello[h.buffered:], input[:consumed])
   259		h.buffered += consumed
   260		if h.buffered != ClientHelloWidth {
   261			return ServerHandshakeStep{
   262				State:       h.state,
   263				NeededBytes: ClientHelloWidth - h.buffered,
   264			}
   265		}
   266	
   267		hello, failure := DecodeClientHelloExact(h.hello[:], h.config)
   268		if failure != nil {
   269			status := HelloStatusInvalidClientHello
   270			if failure.Code == HandshakeUnsupportedVersion {
   271				status = HelloStatusUnsupportedVersion
   272			}
   273			reply := EncodeServerHello(WireVersion, status, 0, 0)
   274			return h.fail(failure, reply[:])
   275		}
   276	
   277		requested := FeatureSet(0)
   278		if hello.Flags&HelloFlagDNSPriorityHint != 0 {
   279			requested |= FeatureSetDNSPriorityHint
   280		}
   281		negotiated := requested & h.config.SupportedFeatures
   282		effectiveMaxFrame := min(hello.MaxFrame, h.config.MaximumFrameBytes)
   283		remaining := input[consumed:]
   284		if beginsWithHelloMagic(remaining) {
   285			return h.fail(handshakeFailure(HandshakeDuplicateHello, HandshakePhaseTerminal), nil)
   286		}
   287		result := &ServerHandshakeResult{Summary: HandshakeSummary{
   288			ProtocolVersion:    WireVersion,
   289			NegotiatedFeatures: negotiated,
   290			EffectiveLimits: EffectiveLimits{
   291				EffectiveMaxFrame:         effectiveMaxFrame,
   292				MaxUDPPayload:             min(h.config.MaximumUDPPayloadBytes, MaxUDPPayloadRelayDefault),
   293				MaxAssociations:           min(h.config.MaximumAssociations, MaxAssociationsRelayDefault),
   294				PerAssociationQueuedBytes: min(h.config.PerAssociationQueuedBytes, PerAssociationQueuedBytesRelayDefault),
   295				AggregateQueuedBytes:      min(h.config.AggregateQueuedBytes, AggregateQueuedBytesRelayDefault),
   296				ControlReservedBytes:      min(h.config.ControlReservedBytes, ControlReservedBytesRelayDefault),
   297				DNSPriorityWeight:         min(h.config.DNSPriorityWeight, DNSPriorityWeightRelayDefault),
   298				IdleTimeoutMilliseconds:   min(h.config.IdleTimeoutMilliseconds, IdleTimeoutRelayDefault),
   299			},
   300		}}
   301		reply := EncodeServerHello(WireVersion, HelloStatusAccepted, negotiated, effectiveMaxFrame)
   302		h.state = ServerHandshakeCompleted
   303		h.result = result
   304		h.clearBuffer()
   305		return ServerHandshakeStep{
   306			State:     h.state,
   307			Reply:     append([]byte(nil), reply[:]...),
   308			Result:    result,
   309			Remaining: append([]byte(nil), remaining...),
   310		}
   311	}
