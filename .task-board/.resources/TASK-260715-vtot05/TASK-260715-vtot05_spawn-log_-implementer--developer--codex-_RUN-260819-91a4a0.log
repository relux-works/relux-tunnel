+        "provenanceSHA256",
+        "inventorySHA256",
+        "noticesSHA256",
+    ):
+        if not isinstance(value.get(key), str) or SHA256_PATTERN.fullmatch(value[key]) is None:
+            raise AssetManifestError("supply-chain provenance digest is invalid")
+    expected_files = {
