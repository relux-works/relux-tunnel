  1494	  private func cleanupProgress(until deadline: ContinuousClock.Instant) async throws {
  1495	    let now = dependencies.clock.now()
  1496	    guard now < deadline else { throw LibSSH2TimeoutError.elapsed }
  1497	    guard let connection, let engineSession else { return }
  1498	    let directions = libssh2_session_block_directions(engineSession)
  1499	    var interests = Set<SSHTCPReadiness>()
  1500	    if directions & LIBSSH2_SESSION_BLOCK_INBOUND != 0 { interests.insert(.readable) }
  1501	    if directions & LIBSSH2_SESSION_BLOCK_OUTBOUND != 0 { interests.insert(.writable) }
  1502	    if interests.isEmpty { interests = [.readable, .writable] }
  1503	    let requestedInterests = interests
  1504	    try await withTimeout(now.duration(to: deadline), clock: dependencies.clock) {
  1505	      try await withTaskCancellationHandler {
  1506	        try await self.context.network.service(
  1507	          connection: connection,
  1508	          interests: requestedInterests
  1509	        )
  1510	      } onCancel: {
  1511	        self.context.network.beginShutdown()
  1512	        Task { await connection.close() }
  1513	      }
  1514	    }
  1515	  }
