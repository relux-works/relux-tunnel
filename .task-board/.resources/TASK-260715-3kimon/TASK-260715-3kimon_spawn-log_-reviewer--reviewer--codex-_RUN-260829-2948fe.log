+    var count = mach_msg_type_number_t(
+      MemoryLayout<task_vm_info_data_t>.size / MemoryLayout<natural_t>.size)
+    let status = withUnsafeMutablePointer(to: &info) { pointer in
+      pointer.withMemoryRebound(to: integer_t.self, capacity: Int(count)) {
+        task_info(mach_task_self_, task_flavor_t(TASK_VM_INFO), $0, &count)
+      }
+    }
+    guard status == KERN_SUCCESS else {
+      let unavailable: MemoryByteSample = .unavailable(
+        reason: .systemCallFailed, provenance: .taskVMPhysicalFootprint)
+      return (unavailable, unavailable)
+    }
+    return (
+      .available(bytes: info.phys_footprint, provenance: .taskVMPhysicalFootprint),
+      .available(
+        bytes: UInt64(max(0, info.ledger_phys_footprint_peak)),
+        provenance: .taskVMPhysicalFootprint)
+    )
+  }
+}
+
+public enum MemoryLedgerAvailability: Equatable, Sendable {
+  case available(MemoryLedgerSnapshot)
+  case unavailable(MemorySampleUnavailableReason)
+
+  public var provenance: MemoryObservationProvenance { .sharedMemoryLedger }
+}
+
+public struct MemoryLedgerSnapshot: Equatable, Sendable {
+  public let capturedAt: ContinuousClock.Instant
+  public let currentBytes: UInt64
+  public let reservedBytes: UInt64
+  public let committedBytes: UInt64
+  public let peakBytes: UInt64
+
+  public init(
+    capturedAt: ContinuousClock.Instant,
+    currentBytes: UInt64,
+    reservedBytes: UInt64,
+    committedBytes: UInt64,
+    peakBytes: UInt64
+  ) {
+    self.capturedAt = capturedAt
+    self.currentBytes = currentBytes
+    self.reservedBytes = reservedBytes
+    self.committedBytes = committedBytes
+    self.peakBytes = peakBytes
+  }
+}
+
+public struct MemorySignalThresholds: Equatable, Sendable {
+  public let criticalEnterBytes: UInt64
+  public let pressureEnterBytes: UInt64
+  public let softEnterBytes: UInt64
+  public let criticalExitBytes: UInt64
+  public let pressureExitBytes: UInt64
+  public let softExitBytes: UInt64
+
+  public init(
+    criticalEnterBytes: UInt64,
+    pressureEnterBytes: UInt64,
+    softEnterBytes: UInt64,
+    criticalExitBytes: UInt64,
+    pressureExitBytes: UInt64,
+    softExitBytes: UInt64
+  ) throws {
+    guard criticalEnterBytes < pressureEnterBytes,
+      pressureEnterBytes < softEnterBytes,
+      criticalExitBytes > criticalEnterBytes,
+      pressureExitBytes > pressureEnterBytes,
+      softExitBytes > softEnterBytes,
+      criticalExitBytes < pressureExitBytes,
+      pressureExitBytes < softExitBytes
+    else { throw MemoryWatermarkConfigurationError.invalidThresholdOrder }
+    self.criticalEnterBytes = criticalEnterBytes
+    self.pressureEnterBytes = pressureEnterBytes
+    self.softEnterBytes = softEnterBytes
+    self.criticalExitBytes = criticalExitBytes
+    self.pressureExitBytes = pressureExitBytes
+    self.softExitBytes = softExitBytes
+  }
+}
+
+public enum MemoryWatermarkConfigurationError: Error, Equatable, Sendable {
+  case invalidThresholdOrder
+  case zeroGeneration
+  case zeroBaseline
+  case zeroLedgerCeiling
+  case invalidDuration
+  case invalidHistoryLimit
+  case thresholdExceedsSignalRange
+  case generationMustIncrease(current: UInt64, proposed: UInt64)
+}
+
+public struct MemoryWatermarkConfiguration: Equatable, Sendable {
+  public let generation: UInt64
+  public let deviceBaselineBytes: UInt64
+  public let globalLedgerCeilingBytes: UInt64
+  public let ledgerHeadroom: MemorySignalThresholds
+  public let physicalHeadroom: MemorySignalThresholds
+  public let advisoryAvailable: MemorySignalThresholds
+  public let cadence: Duration
+  public let minimumEventInterval: Duration
+  public let maximumEvidenceAge: Duration
+  public let maximumSamplingDuration: Duration
+  public let recoveryDwell: Duration
+  public let historyLimit: Int
+
+  public init(
+    generation: UInt64,
+    deviceBaselineBytes: UInt64,
+    globalLedgerCeilingBytes: UInt64,
+    ledgerHeadroom: MemorySignalThresholds,
+    physicalHeadroom: MemorySignalThresholds,
+    advisoryAvailable: MemorySignalThresholds,
+    cadence: Duration,
+    minimumEventInterval: Duration,
+    maximumEvidenceAge: Duration,
+    maximumSamplingDuration: Duration,
+    recoveryDwell: Duration,
+    historyLimit: Int
+  ) throws {
+    guard generation > 0 else { throw MemoryWatermarkConfigurationError.zeroGeneration }
+    guard deviceBaselineBytes > 0 else { throw MemoryWatermarkConfigurationError.zeroBaseline }
+    guard globalLedgerCeilingBytes > 0 else {
+      throw MemoryWatermarkConfigurationError.zeroLedgerCeiling
+    }
+    guard cadence > .zero, minimumEventInterval > .zero, maximumEvidenceAge > .zero,
+      maximumSamplingDuration > .zero, maximumSamplingDuration <= cadence,
+      maximumSamplingDuration <= minimumEventInterval, recoveryDwell >= .zero
+    else { throw MemoryWatermarkConfigurationError.invalidDuration }
+    guard (1...1_024).contains(historyLimit) else {
+      throw MemoryWatermarkConfigurationError.invalidHistoryLimit
+    }
+    guard ledgerHeadroom.softExitBytes < globalLedgerCeilingBytes,
+      physicalHeadroom.softExitBytes < deviceBaselineBytes
+    else { throw MemoryWatermarkConfigurationError.thresholdExceedsSignalRange }
+    self.generation = generation
+    self.deviceBaselineBytes = deviceBaselineBytes
+    self.globalLedgerCeilingBytes = globalLedgerCeilingBytes
+    self.ledgerHeadroom = ledgerHeadroom
+    self.physicalHeadroom = physicalHeadroom
+    self.advisoryAvailable = advisoryAvailable
+    self.cadence = cadence
+    self.minimumEventInterval = minimumEventInterval
+    self.maximumEvidenceAge = maximumEvidenceAge
+    self.maximumSamplingDuration = maximumSamplingDuration
+    self.recoveryDwell = recoveryDwell
+    self.historyLimit = historyLimit
+  }
+}
+
+public enum MemoryWatermarkState: Int, CaseIterable, Comparable, Sendable {
+  case normal
+  case soft
+  case pressure
+  case critical
+
+  public static func < (lhs: Self, rhs: Self) -> Bool { lhs.rawValue < rhs.rawValue }
+}
+
+public enum MemoryObservationTrigger: String, CaseIterable, Sendable {
+  case cadence
+  case admission
+  case release
+  case lifecycle
+  case memoryWarning
+  case configurationReplacement
+}
+
+public enum MemoryTransitionReason: String, CaseIterable, Sendable {
+  case ledgerHeadroom
+  case physicalHeadroom
+  case advisoryAvailable
+  case memoryWarning
+  case recovery
+}
+
+public struct MemoryWatermarkTransition: Equatable, Sendable {
+  public let from: MemoryWatermarkState
+  public let to: MemoryWatermarkState
+  public let reason: MemoryTransitionReason
+}
+
+public struct MemoryObservation: Equatable, Sendable {
+  public let sequence: UInt64
+  public let stateGeneration: UInt64
+  public let configurationGeneration: UInt64
+  public let timestamp: ContinuousClock.Instant
+  public let unit: MemoryObservationUnit
+  public let trigger: MemoryObservationTrigger
+  public let physicalFootprint: MemoryByteSample
+  public let physicalFootprintPeak: MemoryByteSample
+  public let advisoryAvailableMemory: MemoryByteSample
+  public let ledger: MemoryLedgerAvailability
+  public let warningReceived: Bool
+  public let actionsAcknowledged: Bool
+  public let state: MemoryWatermarkState
+  public let transition: MemoryWatermarkTransition?
+  public let samplingDuration: Duration
+}
+
+public enum MemoryObservationDisposition: Equatable, Sendable {
+  case observed(MemoryObservation)
+  case rateLimited(currentState: MemoryWatermarkState)
+}
+
+public struct MemoryWatermarkMetrics: Equatable, Sendable {
+  public let observations: UInt64
+  public let rateLimited: UInt64
+  public let samplingOverruns: UInt64
+  public let unavailableSamples: UInt64
+  public let staleLedgerSamples: UInt64
+  public let transitionCounts: [MemoryWatermarkState: UInt64]
+  public let retainedHistoryCount: Int
+  public let retainedHistoryCapacity: Int
+}
+
+/// The actor is the only state writer. It performs at most two constant-time public system
+/// calls per accepted event and never runs on packet, SSH, or lifecycle actors.
+public actor MemoryWatermarkController {
+  private var configuration: MemoryWatermarkConfiguration
+  private let platform: any MemoryPlatformSamplingService
+  private let clock: any TunnelClock
+  private var state: MemoryWatermarkState = .normal
+  private var stateGeneration: UInt64 = 0
+  private var sequence: UInt64 = 0
+  private var lastCadenceObservation: ContinuousClock.Instant?
+  private var lastEventObservations: [MemoryObservationTrigger: ContinuousClock.Instant] = [:]
+  private var recoveryEligibleSince: ContinuousClock.Instant?
+  private var history: RingHistory
+  private var observationCount: UInt64 = 0
+  private var rateLimitedCount: UInt64 = 0
+  private var samplingOverrunCount: UInt64 = 0
+  private var unavailableSampleCount: UInt64 = 0
+  private var staleLedgerSampleCount: UInt64 = 0
+  private var transitions = Dictionary(
+    uniqueKeysWithValues: MemoryWatermarkState.allCases.map { ($0, UInt64(0)) })
+
+  public init(
+    configuration: MemoryWatermarkConfiguration,
+    platform: any MemoryPlatformSamplingService,
+    clock: any TunnelClock = ContinuousTunnelClock()
+  ) {
+    self.configuration = configuration
+    self.platform = platform
+    self.clock = clock
+    self.history = RingHistory(limit: configuration.historyLimit)
+  }
+
+  public func currentState() -> MemoryWatermarkState { state }
+
+  public func replaceConfiguration(_ replacement: MemoryWatermarkConfiguration) throws {
+    guard replacement.generation > configuration.generation else {
+      throw MemoryWatermarkConfigurationError.generationMustIncrease(
+        current: configuration.generation, proposed: replacement.generation)
+    }
+    configuration = replacement
+    history.resize(to: replacement.historyLimit)
+    recoveryEligibleSince = nil
+    lastCadenceObservation = nil
+    lastEventObservations.removeAll(keepingCapacity: true)
+  }
+
+  public func observe(
+    trigger: MemoryObservationTrigger,
+    ledger: MemoryLedgerAvailability,
+    actionsAcknowledged: Bool = true
+  ) throws -> MemoryObservationDisposition {
+    let startedAt = clock.now()
+    if isRateLimited(trigger: trigger, at: startedAt) {
+      rateLimitedCount = incrementSaturating(rateLimitedCount)
+      return .rateLimited(currentState: state)
+    }
+    guard sequence < UInt64.max else { throw MemoryWatermarkControllerError.sequenceExhausted }
+
+    let sampled = platform.sampleCurrentProcessMemory()
+    let finishedAt = clock.now()
+    let samplingDuration = startedAt.duration(to: finishedAt)
+    let overran = samplingDuration > configuration.maximumSamplingDuration
+    if overran { samplingOverrunCount = incrementSaturating(samplingOverrunCount) }
+    let platformSample = sanitize(sampled, overran: overran)
+    let ledgerSample = sanitize(ledger, at: finishedAt)
+
+    sequence += 1
+    observationCount = incrementSaturating(observationCount)
+    markAccepted(trigger: trigger, at: startedAt)
+    unavailableSampleCount = incrementSaturating(
+      unavailableSampleCount,
+      by: unavailableCount(platformSample) + unavailableCount(ledgerSample))
+
+    let warning = trigger == .memoryWarning
+    let previous = state
+    let (next, reason) = nextState(
+      platform: platformSample,
+      ledger: ledgerSample,
+      warning: warning,
+      actionsAcknowledged: actionsAcknowledged,
+      now: finishedAt)
+    var transition: MemoryWatermarkTransition?
+    if next != previous {
+      state = next
+      stateGeneration = incrementSaturating(stateGeneration)
+      transitions[next] = incrementSaturating(transitions[next, default: 0])
+      transition = MemoryWatermarkTransition(from: previous, to: next, reason: reason!)
+    }
+    let observation = MemoryObservation(
+      sequence: sequence,
+      stateGeneration: stateGeneration,
+      configurationGeneration: configuration.generation,
+      timestamp: finishedAt,
+      unit: .bytes,
+      trigger: trigger,
+      physicalFootprint: platformSample.physicalFootprint,
+      physicalFootprintPeak: platformSample.physicalFootprintPeak,
+      advisoryAvailableMemory: platformSample.advisoryAvailableMemory,
+      ledger: ledgerSample,
+      warningReceived: warning,
+      actionsAcknowledged: actionsAcknowledged,
+      state: state,
+      transition: transition,
+      samplingDuration: samplingDuration)
+    history.append(observation)
+    return .observed(observation)
+  }
+
+  public func retainedHistory() -> [MemoryObservation] { history.values }
+
+  public func metrics() -> MemoryWatermarkMetrics {
+    MemoryWatermarkMetrics(
+      observations: observationCount,
+      rateLimited: rateLimitedCount,
+      samplingOverruns: samplingOverrunCount,
+      unavailableSamples: unavailableSampleCount,
+      staleLedgerSamples: staleLedgerSampleCount,
+      transitionCounts: transitions,
+      retainedHistoryCount: history.values.count,
+      retainedHistoryCapacity: history.limit)
+  }
+
+  private func isRateLimited(
+    trigger: MemoryObservationTrigger, at now: ContinuousClock.Instant
+  ) -> Bool {
+    if trigger == .memoryWarning && state < .pressure { return false }
+    let prior = trigger == .cadence ? lastCadenceObservation : lastEventObservations[trigger]
+    let interval = trigger == .cadence ? configuration.cadence : configuration.minimumEventInterval
+    guard let prior else { return false }
+    return prior.duration(to: now) < interval
+  }
+
+  private func markAccepted(trigger: MemoryObservationTrigger, at now: ContinuousClock.Instant) {
+    if trigger == .cadence {
+      lastCadenceObservation = now
+    } else {
+      lastEventObservations[trigger] = now
+    }
+  }
+
+  private func sanitize(
+    _ sample: MemoryPlatformSample, overran: Bool
+  ) -> MemoryPlatformSample {
+    guard !overran else {
+      return MemoryPlatformSample(
+        physicalFootprint: .unavailable(
+          reason: .executionTimeExceeded, provenance: .taskVMPhysicalFootprint),
+        physicalFootprintPeak: .unavailable(
+          reason: .executionTimeExceeded, provenance: .taskVMPhysicalFootprint),
+        advisoryAvailableMemory: .unavailable(
+          reason: .executionTimeExceeded, provenance: .osProcessAvailableMemory))
+    }
+    let currentSample = sanitizeProvenance(
+      sample.physicalFootprint, expected: .taskVMPhysicalFootprint)
+    let peakSample = sanitizeProvenance(
+      sample.physicalFootprintPeak, expected: .taskVMPhysicalFootprint)
+    let advisorySample = sanitizeProvenance(
+      sample.advisoryAvailableMemory, expected: .osProcessAvailableMemory)
+    if let current = currentSample.bytes, let peak = peakSample.bytes, peak < current {
+      return MemoryPlatformSample(
+        physicalFootprint: .unavailable(
+          reason: .malformed, provenance: .taskVMPhysicalFootprint),
+        physicalFootprintPeak: .unavailable(
+          reason: .malformed, provenance: .taskVMPhysicalFootprint),
+        advisoryAvailableMemory: advisorySample)
+    }
+    return MemoryPlatformSample(
+      physicalFootprint: currentSample,
+      physicalFootprintPeak: peakSample,
+      advisoryAvailableMemory: advisorySample)
+  }
+
+  private func sanitizeProvenance(
+    _ sample: MemoryByteSample, expected: MemoryObservationProvenance
+  ) -> MemoryByteSample {
+    switch sample {
+    case .available(let bytes, let provenance) where provenance == expected:
+      return .available(bytes: bytes, provenance: provenance)
+    case .unavailable(let reason, let provenance) where provenance == expected:
+      return .unavailable(reason: reason, provenance: provenance)
+    case .available, .unavailable:
+      return .unavailable(reason: .malformed, provenance: expected)
+    }
+  }
+
+  private func sanitize(
+    _ ledger: MemoryLedgerAvailability, at now: ContinuousClock.Instant
+  ) -> MemoryLedgerAvailability {
+    guard case .available(let snapshot) = ledger else { return ledger }
+    guard snapshot.capturedAt <= now else { return .unavailable(.malformed) }
+    if snapshot.capturedAt.duration(to: now) > configuration.maximumEvidenceAge {
+      staleLedgerSampleCount = incrementSaturating(staleLedgerSampleCount)
+      return .unavailable(.stale)
+    }
+    let (total, overflow) = snapshot.currentBytes.addingReportingOverflow(snapshot.reservedBytes)
+    guard !overflow, snapshot.peakBytes >= snapshot.committedBytes,
+      snapshot.committedBytes >= snapshot.currentBytes,
+      snapshot.committedBytes >= snapshot.reservedBytes,
+      snapshot.committedBytes <= total
+    else { return .unavailable(.malformed) }
+    return ledger
+  }
+
+  private func nextState(
+    platform: MemoryPlatformSample,
+    ledger: MemoryLedgerAvailability,
+    warning: Bool,
+    actionsAcknowledged: Bool,
+    now: ContinuousClock.Instant
+  ) -> (MemoryWatermarkState, MemoryTransitionReason?) {
+    let entry = entrySeverity(platform: platform, ledger: ledger, warning: warning)
+    if entry.state > state {
+      recoveryEligibleSince = nil
+      return (entry.state, entry.reason)
+    }
+    guard state != .normal,
+      actionsAcknowledged,
+      allSignalsPermitRecovery(platform: platform, ledger: ledger, from: state)
+    else {
+      recoveryEligibleSince = nil
+      return (state, nil)
+    }
+    if recoveryEligibleSince == nil { recoveryEligibleSince = now }
+    guard recoveryEligibleSince!.duration(to: now) >= configuration.recoveryDwell else {
+      return (state, nil)
+    }
+    recoveryEligibleSince = now
+    return (MemoryWatermarkState(rawValue: state.rawValue - 1)!, .recovery)
+  }
+
+  private func entrySeverity(
+    platform: MemoryPlatformSample,
+    ledger: MemoryLedgerAvailability,
+    warning: Bool
+  ) -> (state: MemoryWatermarkState, reason: MemoryTransitionReason?) {
+    var result: (MemoryWatermarkState, MemoryTransitionReason?) =
+      warning ? (.pressure, .memoryWarning) : (.normal, nil)
+    func include(
+      _ bytes: UInt64?, _ thresholds: MemorySignalThresholds, _ reason: MemoryTransitionReason
+    ) {
+      guard let bytes else { return }
+      let candidate: MemoryWatermarkState
+      if bytes <= thresholds.criticalEnterBytes {
+        candidate = .critical
+      } else if bytes <= thresholds.pressureEnterBytes {
+        candidate = .pressure
+      } else if bytes <= thresholds.softEnterBytes {
+        candidate = .soft
+      } else {
+        candidate = .normal
+      }
+      if candidate > result.0 { result = (candidate, reason) }
+    }
+    if case .available(let snapshot) = ledger {
+      include(
+        headroom(limit: configuration.globalLedgerCeilingBytes, used: snapshot.committedBytes),
+        configuration.ledgerHeadroom, .ledgerHeadroom)
+    }
+    include(
+      platform.physicalFootprint.bytes.map {
+        headroom(limit: configuration.deviceBaselineBytes, used: $0)
+      }, configuration.physicalHeadroom, .physicalHeadroom)
+    include(
+      platform.advisoryAvailableMemory.bytes,
+      configuration.advisoryAvailable, .advisoryAvailable)
+    return result
+  }
+
+  private func allSignalsPermitRecovery(
+    platform: MemoryPlatformSample,
+    ledger: MemoryLedgerAvailability,
+    from state: MemoryWatermarkState
+  ) -> Bool {
+    guard case .available(let ledgerSnapshot) = ledger,
+      let footprint = platform.physicalFootprint.bytes,
+      platform.physicalFootprintPeak.bytes != nil,
+      let advisory = platform.advisoryAvailableMemory.bytes
+    else { return false }
+    return aboveExit(
+      headroom(limit: configuration.globalLedgerCeilingBytes, used: ledgerSnapshot.committedBytes),
+      configuration.ledgerHeadroom, state: state)
+      && aboveExit(
+        headroom(limit: configuration.deviceBaselineBytes, used: footprint),
+        configuration.physicalHeadroom, state: state)
+      && aboveExit(advisory, configuration.advisoryAvailable, state: state)
+  }
+
+  private func aboveExit(
+    _ value: UInt64, _ thresholds: MemorySignalThresholds, state: MemoryWatermarkState
+  ) -> Bool {
+    switch state {
+    case .critical: value > thresholds.criticalExitBytes
+    case .pressure: value > thresholds.pressureExitBytes
+    case .soft: value > thresholds.softExitBytes
+    case .normal: true
+    }
+  }
+
+  private func unavailableCount(_ sample: MemoryPlatformSample) -> UInt64 {
+    [sample.physicalFootprint, sample.physicalFootprintPeak, sample.advisoryAvailableMemory]
+      .reduce(0) { count, value in
+        if case .unavailable = value { return count + 1 }
+        return count
+      }
+  }
+
+  private func unavailableCount(_ ledger: MemoryLedgerAvailability) -> UInt64 {
+    if case .unavailable = ledger { return 1 }
+    return 0
+  }
+}
+
+public enum MemoryWatermarkControllerError: Error, Equatable, Sendable {
+  case sequenceExhausted
+}
+
+private func headroom(limit: UInt64, used: UInt64) -> UInt64 {
+  used >= limit ? 0 : limit - used
+}
+
+private func incrementSaturating(_ value: UInt64, by amount: UInt64 = 1) -> UInt64 {
+  let (result, overflow) = value.addingReportingOverflow(amount)
+  return overflow ? UInt64.max : result
+}
+
+private struct RingHistory: Sendable {
+  private var storage: [MemoryObservation?]
+  private var next = 0
+  private var count = 0
+  private(set) var limit: Int
+
+  init(limit: Int) {
+    self.limit = limit
+    self.storage = Array(repeating: nil, count: limit)
+  }
+
+  mutating func append(_ value: MemoryObservation) {
+    storage[next] = value
+    next = (next + 1) % limit
+    count = min(count + 1, limit)
+  }
+
+  mutating func resize(to newLimit: Int) {
+    let retained = Array(values.suffix(newLimit))
+    self = RingHistory(limit: newLimit)
+    for value in retained { append(value) }
+  }
+
+  var values: [MemoryObservation] {
+    guard count > 0 else { return [] }
+    let start = count == limit ? next : 0
+    return (0..<count).compactMap { storage[(start + $0) % limit] }
+  }
+}
