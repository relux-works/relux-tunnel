   557	private func platformValue(_ value: VPNProviderConfigurationValue) -> Any? {
   558	  switch value {
   559	  case .string(let value): value
   560	  case .integer(let value): NSNumber(value: value)
   561	  case .unsignedInteger(let value): NSNumber(value: value)
   562	  case .data(let value): value
   563	  case .unsupported: nil
   564	  }
