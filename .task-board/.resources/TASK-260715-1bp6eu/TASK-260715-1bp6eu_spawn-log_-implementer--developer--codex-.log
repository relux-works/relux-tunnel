+  func retire() {
+    let waiters: [CheckedContinuation<Void, any Error>] = lock.withLock {
+      guard !isRetired else { return [] }
+      isRetired = true
+      let waiters = Array(self.waiters.values)
+      self.waiters.removeAll()
+      return waiters
+    }
+    for waiter in waiters { waiter.resume() }
+  }
