   170	static int
   171	hev_config_parse_socks5 (yaml_document_t *doc, yaml_node_t *base)
   172	{
   173	    yaml_node_pair_t *pair;
   174	    static char _user[256];
   175	    static char _pass[256];
   176	    const char *addr = NULL;
   177	    const char *port = NULL;
   178	    const char *udpm = NULL;
   179	    const char *udpa = NULL;
   180	    const char *user = NULL;
   181	    const char *pass = NULL;
