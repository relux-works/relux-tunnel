diff --git a/Dependencies/ReluxNIOSSH/Tests/NIOSSHTests/ReluxPolicyTests.swift b/Dependencies/ReluxNIOSSH/Tests/NIOSSHTests/ReluxPolicyTests.swift
new file mode 100644
