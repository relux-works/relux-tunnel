+
+@Test("Public server-KEX observation symbols and typed states are exported")
+func publicServerKEXObservationIsExported() {
+  var status = LIBSSH2_SERVER_KEX_STATUS(
+    state: LIBSSH2_SERVER_KEX_NONE,
+    generation: 0
+  )
