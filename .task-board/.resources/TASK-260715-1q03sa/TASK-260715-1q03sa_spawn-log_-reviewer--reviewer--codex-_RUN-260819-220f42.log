            (second / filename).chmod(0o755)

            protocol_name = relay_release.protocol_test_filename(
                relay_release.TARGETS[0]
            )
            (second_tests / protocol_name).write_bytes(
                (first_tests / protocol_name).read_bytes() + b"x"
            )
