+private actor RecordingBytePumpTerminalSink: BytePumpTerminalEventSink {
+  private(set) var values: [BytePumpTerminalEvent] = []
+
+  func receive(_ event: BytePumpTerminalEvent) {
+    values.append(event)
+  }
+}
