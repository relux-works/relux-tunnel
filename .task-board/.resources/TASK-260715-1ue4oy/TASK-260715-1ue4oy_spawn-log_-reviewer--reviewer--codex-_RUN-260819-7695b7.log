   969	        staging_descriptor = open_bundle_directory(staging)
   970	        try:
   971	            for source, binary in zip(contract["assets"], contents, strict=True):
   972	                write_new_file_at(staging_descriptor, source["fileName"], binary, 0o755)
   973	                if event_hook is not None:
