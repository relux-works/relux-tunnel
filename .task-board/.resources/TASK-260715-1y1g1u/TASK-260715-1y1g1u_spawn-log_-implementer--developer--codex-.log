   453	public struct RelayClientHandshakeStateMachine: Sendable {
   454	  private enum State: Sendable {
   455	    case awaitingServerHello
   456	    case completed(RelayClientHandshakeResult)
   457	    case failed(RelayHandshakeFailure)
   458	  }
   459	
   460	  public let generation: UInt64
   461	  public let configuration: RelayClientHandshakeConfiguration
   462	  private var state: State = .awaitingServerHello
   463	  private var helloBytes = Data()
   464	
   465	  public init(generation: UInt64, configuration: RelayClientHandshakeConfiguration) {
   466	    self.generation = generation
   467	    self.configuration = configuration
   468	    helloBytes.reserveCapacity(RelayProtocolV1.serverHelloWidth)
   469	  }
   470	
   471	  public var clientHello: Data {
   472	    RelayHandshakeWire.encodeClientHello(configuration: configuration)
   473	  }
   474	
   475	  public mutating func receive(
   476	    _ bytes: Data,
   477	    generation callbackGeneration: UInt64
   478	  ) -> RelayClientHandshakeProgress {
   479	    guard callbackGeneration == generation else {
   480	      return .staleCallbackIgnored
   481	    }
   482	    switch state {
   483	    case .failed(let failure):
   484	      return .failed(failure)
   485	    case .completed(let result):
   486	      guard !bytes.isEmpty else { return .completed(result) }
   487	      return fail(
   488	        beginsWithHelloMagic(bytes)
   489	          ? .duplicateHello : .trailingHelloBytes,
   490	        phase: .terminal
   491	      )
   492	    case .awaitingServerHello:
   493	      break
   494	    }
   495	
   496	    let needed = RelayProtocolV1.serverHelloWidth - helloBytes.count
   497	    let consumed = min(needed, bytes.count)
   498	    helloBytes.append(bytes.prefix(consumed))
   499	    guard helloBytes.count == RelayProtocolV1.serverHelloWidth else {
   500	      return .needsMoreBytes(RelayProtocolV1.serverHelloWidth - helloBytes.count)
   501	    }
   502	
   503	    do {
   504	      let summary = try RelayHandshakeWire.decodeServerHelloExact(
   505	        helloBytes,
   506	        configuration: configuration
   507	      )
   508	      let remainingBytes = Data(bytes.dropFirst(consumed))
   509	      guard !beginsWithHelloMagic(remainingBytes) else {
   510	        return fail(.duplicateHello, phase: .terminal)
   511	      }
   512	      let result = RelayClientHandshakeResult(
   513	        summary: summary,
   514	        remainingBytes: remainingBytes
   515	      )
   516	      state = .completed(result)
   517	      helloBytes.removeAll(keepingCapacity: false)
   518	      return .completed(result)
   519	    } catch let failure as RelayHandshakeFailure {
   520	      state = .failed(failure)
   521	      helloBytes.removeAll(keepingCapacity: false)
   522	      return .failed(failure)
   523	    } catch {
   524	      return fail(.transportFailure, phase: .serverHelloValidation)
   525	    }
   526	  }
