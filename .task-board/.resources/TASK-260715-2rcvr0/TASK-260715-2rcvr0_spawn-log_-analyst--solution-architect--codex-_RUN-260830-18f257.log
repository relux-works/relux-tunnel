   673	    protocolVersion = try container.decode(UInt16.self, forKey: .protocolVersion)
   674	    kind = try container.decode(RuntimeMessageKind.self, forKey: .kind)
   675	    schemaVersion = try container.decode(UInt16.self, forKey: .schemaVersion)
   676	    requestID = try container.decodeIfPresent(
   677	      OpaqueRuntimeRequestIdentifier.self,
   678	      forKey: .requestID
   679	    )
   680	    runtimeGeneration = try container.decode(UInt64.self, forKey: .runtimeGeneration)
   681	    snapshotSequence = try container.decode(UInt64.self, forKey: .snapshotSequence)
   682	    counters =
   683	      if container.contains(.counters) {
   684	        try container.decode([String: UInt64].self, forKey: .counters)
   685	      } else {
   686	        [:]
   687	      }
   688	    gauges =
   689	      if container.contains(.gauges) {
   690	        try container.decode([String: Int64].self, forKey: .gauges)
   691	      } else {
   692	        [:]
   693	      }
   694	    histograms =
   695	      if container.contains(.histograms) {
   696	        try container.decode([String: RuntimeDiagnosticHistogram].self, forKey: .histograms)
   697	      } else {
   698	        [:]
   699	      }
   700	    errors =
   701	      if container.contains(.errors) {
   702	        try container.decode([RedactedRuntimeError].self, forKey: .errors)
   703	      } else {
   704	        []
   705	      }
