    26	class BackToBackEmbeddedChannel {
    27	    private(set) var client: EmbeddedChannel
    28	    private(set) var server: EmbeddedChannel
    29	    private var loop: EmbeddedEventLoop
    30	
    31	    private(set) var activeServerChannels: [Channel]
    32	
    33	    var clientSSHHandler: NIOSSHHandler? {
    34	        try? self.client.pipeline.syncOperations.handler(type: NIOSSHHandler.self)
    35	    }
    36	
    37	    var serverSSHHandler: NIOSSHHandler? {
    38	        try? self.server.pipeline.syncOperations.handler(type: NIOSSHHandler.self)
    39	    }
    40	
    41	    init() {
    42	        self.loop = EmbeddedEventLoop()
    43	        self.client = EmbeddedChannel(loop: self.loop)
    44	        self.server = EmbeddedChannel(loop: self.loop)
    45	        self.activeServerChannels = []
    46	    }
    47	
    48	    func run() {
    49	        self.loop.run()
    50	    }
    51	
    52	    func interactInMemory() throws {
    53	        var workToDo = true
    54	
    55	        while workToDo {
    56	            workToDo = false
    57	
    58	            self.loop.run()
    59	            let clientDatum = try self.client.readOutbound(as: IOData.self)
    60	            let serverDatum = try self.server.readOutbound(as: IOData.self)
    61	
    62	            if let clientMsg = clientDatum {
    63	                try self.server.writeInbound(clientMsg)
    64	                workToDo = true
    65	            }
    66	
    67	            if let serverMsg = serverDatum {
    68	                try self.client.writeInbound(serverMsg)
    69	                workToDo = true
    70	            }
    71	        }
    72	    }
    73	
    74	    func advanceTime(by increment: TimeAmount) {
    75	        self.loop.advanceTime(by: increment)
    76	    }
    77	
    78	    func activate() throws {
    79	        // A weird wrinkle of embedded channel is that it only properly activates on connect.
    80	        try self.client.connect(to: .init(unixDomainSocketPath: "/fake")).wait()
    81	        try self.server.connect(to: .init(unixDomainSocketPath: "/fake")).wait()
    82	    }
    83	
    84	    func configureWithHarness(
    85	        _ harness: TestHarness,
    86	        clientRekeyPolicy: NIOSSHRekeyPolicy = .disabled,
    87	        clientRekeyClock: any NIOSSHRekeyClock = NIOSSHSystemRekeyClock()
    88	    ) throws {
    89	        let clientHandler = NIOSSHHandler(
    90	            role: .client(
    91	                .init(
    92	                    userAuthDelegate: harness.clientAuthDelegate,
    93	                    serverAuthDelegate: harness.clientServerAuthDelegate,
    94	                    globalRequestDelegate: harness.clientGlobalRequestDelegate
    95	                )
    96	            ),
    97	            allocator: self.client.allocator,
    98	            inboundChildChannelInitializer: nil,
    99	            rekeyPolicy: clientRekeyPolicy,
   100	            rekeyClock: clientRekeyClock
   101	        )
   102	        let serverHandler = NIOSSHHandler(
   103	            role: .server(
   104	                .init(
   105	                    hostKeys: harness.serverHostKeys,
   106	                    userAuthDelegate: harness.serverAuthDelegate,
   107	                    globalRequestDelegate: harness.serverGlobalRequestDelegate,
   108	                    banner: harness.serverAuthBanner
   109	                )
   110	            ),
   111	            allocator: self.server.allocator
   112	        ) { channel, _ in
   113	            self.activeServerChannels.append(channel)
   114	            let boxedSelf = NIOLoopBound(self, eventLoop: channel.eventLoop)
   115	            channel.closeFuture.whenComplete { _ in
   116	                boxedSelf.value.activeServerChannels.removeAll(where: { $0 === channel })
   117	            }
   118	            return channel.eventLoop.makeSucceededFuture(())
   119	        }
   120	
   121	        try self.client.pipeline.syncOperations.addHandler(clientHandler)
   122	        try self.server.pipeline.syncOperations.addHandler(serverHandler)
   123	    }
   124	
   125	    func finish() throws {
   126	        XCTAssertNoThrow(XCTAssertTrue(try self.client.finish(acceptAlreadyClosed: true).isClean))
   127	        XCTAssertNoThrow(XCTAssertTrue(try self.server.finish(acceptAlreadyClosed: true).isClean))
   128	        XCTAssertNoThrow(try self.loop.syncShutdownGracefully())
   129	    }
   130	
   131	    func createNewChannel() throws -> Channel {
   132	        var clientChannel = Optional<Channel>.none
   133	        self.clientSSHHandler?.createChannel { channel, _ in
   134	            clientChannel = channel
   135	            return channel.eventLoop.makeSucceededFuture(())
   136	        }
   137	
   138	        guard let channel = clientChannel else {
   139	            XCTFail("Unable to create child channel")
   140	            throw EndToEndTestError.unableToCreateChildChannel
   141	        }
   142	
   143	        return channel
   144	    }
   145	}
