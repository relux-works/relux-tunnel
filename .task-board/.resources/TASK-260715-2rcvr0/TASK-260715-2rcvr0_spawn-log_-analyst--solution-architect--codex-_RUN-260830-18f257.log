   576	/// Generation-scoped counter used when the bounded ingestion lane is full.
   577	/// Each generation gets a distinct instance so stale recorders cannot label a
   578	/// newer generation's aggregate.
   579	private final class RuntimeDiagnosticsDroppedUpdateCounter: Sendable {
   580	  let value = Atomic<UInt64>(0)
   581	
   582	  func increment() {
   583	    var current = value.load(ordering: .relaxed)
   584	    while current < UInt64.max {
   585	      let result = value.compareExchange(
   586	        expected: current,
   587	        desired: current + 1,
   588	        ordering: .relaxed
   589	      )
   590	      guard !result.exchanged else { return }
   591	      current = result.original
   592	    }
   593	  }
   594	}
   595	
   596	/// Fixed-size aggregate state shared by runtime layers.
   597	///
   598	/// Component calls reserve one of a fixed number of pending slots without
   599	/// waiting and enqueue a typed value on the private diagnostics lane. Snapshot
   600	/// construction is serialized on that lane, so it cannot hold a lock needed by
   601	/// packet or SSH executors. Callers encode the immutable result after the lane
   602	/// has been released.
   603	public final class RuntimeDiagnosticsStore: @unchecked Sendable {
   604	  private enum Update: Sendable {
   605	    case incrementCounter(String, UInt64, UInt64)
   606	    case setGauge(String, Int64, UInt64)
   607	    case stateTransition(TunnelLifecycleState, UInt64, UInt64)
   608	    case tcpFlowOpened(UInt64)
   609	    case tcpFlowClosed(UInt64)
   610	    case dnsResult(RuntimeDNSResultClass, UInt64, UInt64)
   611	    case tcpChannelOpenLatency(UInt64, UInt64)
   612	    case route(RuntimeRouteMode, Bool, UInt64)
   613	    case memory(UInt64, UInt64, UInt64)
   614	    case error(RuntimeDiagnosticErrorCode, UInt64)
   615	    case clearError(RuntimeErrorDomain, UInt64)
   616	    case sshBootstrapError(SSHBootstrapDiagnostic, UInt64)
   617	    case clearSSHBootstrapError(UInt64)
   618	    case rejected(UInt64)
   619	
   620	    var generation: UInt64 {
   621	      switch self {
   622	      case .incrementCounter(_, _, let generation),
   623	        .setGauge(_, _, let generation),
   624	        .stateTransition(_, _, let generation),
   625	        .dnsResult(_, _, let generation),
   626	        .tcpChannelOpenLatency(_, let generation),
   627	        .route(_, _, let generation),
   628	        .memory(_, _, let generation):
   629	        generation
   630	      case .tcpFlowOpened(let generation), .tcpFlowClosed(let generation),
   631	        .error(_, let generation), .clearError(_, let generation),
   632	        .sshBootstrapError(_, let generation), .clearSSHBootstrapError(let generation),
   633	        .rejected(let generation):
   634	        generation
   635	      }
   636	    }
   637	  }
   638	
   639	  private struct State {
   640	    var runtimeGeneration: UInt64
   641	    var nextSnapshotSequence: UInt64?
   642	    var counters = Dictionary(
   643	      uniqueKeysWithValues: RuntimeDiagnosticsSchema.counterNames.map { ($0, UInt64.zero) }
   644	    )
   645	    var gauges = Dictionary(
   646	      uniqueKeysWithValues: RuntimeDiagnosticsSchema.gaugeNames.map { ($0, Int64.zero) }
   647	    )
   648	    var dnsLatencyCounts = Array(
   649	      repeating: UInt64.zero,
   650	      count: RuntimeDiagnosticsSchema.dnsLatencyBucketUpperBoundsMilliseconds.count
   651	    )
   652	    var tcpChannelOpenLatencyCounts = Array(
   653	      repeating: UInt64.zero,
   654	      count: RuntimeDiagnosticsSchema.tcpChannelOpenLatencyBucketUpperBoundsMilliseconds.count
   655	    )
   656	    var errors: [RuntimeErrorDomain: RuntimeDiagnosticErrorCode] = [:]
   657	    var sshBootstrapError: SSHBootstrapDiagnostic?
   658	    var hasAvailableMemorySample = false
   659	    let droppedUpdates: RuntimeDiagnosticsDroppedUpdateCounter
   660	    let tcpAdmissionGauges: RuntimeTCPAdmissionGaugeReconciler
   661	
   662	    init(
   663	      runtimeGeneration: UInt64,
   664	      nextSnapshotSequence: UInt64 = 0,
   665	      droppedUpdates: RuntimeDiagnosticsDroppedUpdateCounter = .init(),
   666	      tcpAdmissionGauges: RuntimeTCPAdmissionGaugeReconciler = .init()
   667	    ) {
   668	      self.runtimeGeneration = runtimeGeneration
   669	      self.nextSnapshotSequence = nextSnapshotSequence
   670	      self.droppedUpdates = droppedUpdates
   671	      self.tcpAdmissionGauges = tcpAdmissionGauges
   672	    }
   673	  }
   674	
   675	  private let stateQueue = DispatchQueue(label: "works.relux.runtime-diagnostics")
   676	  private let pendingUpdateSlots = DispatchSemaphore(
   677	    value: RuntimeDiagnosticsSchema.maximumPendingUpdates
   678	  )
   679	  private let snapshotRequestSlot = DispatchSemaphore(value: 1)
   680	  private let snapshotConstructionHook: (@Sendable () -> Void)?
   681	  private var state: State
   682	
   683	  public convenience init(runtimeGeneration: UInt64) {
   684	    self.init(
   685	      runtimeGeneration: runtimeGeneration,
   686	      initialSnapshotSequenceForTesting: 0,
   687	      snapshotConstructionHook: nil
   688	    )
   689	  }
   690	
   691	  internal init(
   692	    runtimeGeneration: UInt64,
   693	    initialSnapshotSequenceForTesting: UInt64,
   694	    snapshotConstructionHook: (@Sendable () -> Void)?
   695	  ) {
   696	    state = State(
   697	      runtimeGeneration: runtimeGeneration,
   698	      nextSnapshotSequence: initialSnapshotSequenceForTesting
   699	    )
   700	    self.snapshotConstructionHook = snapshotConstructionHook
   701	  }
   702	
   703	  public func recorder() -> RuntimeDiagnosticsRecorder {
   704	    stateQueue.sync {
   705	      RuntimeDiagnosticsRecorder(
   706	        store: self,
   707	        runtimeGeneration: state.runtimeGeneration,
   708	        droppedUpdates: state.droppedUpdates,
   709	        tcpAdmissionGauges: state.tcpAdmissionGauges
   710	      )
   711	    }
   712	  }
   713	
   714	  /// Advances to a strictly newer generation and drops all prior aggregates.
   715	  public func beginGeneration(_ runtimeGeneration: UInt64) throws
   716	    -> RuntimeDiagnosticsRecorder
   717	  {
   718	    try stateQueue.sync {
   719	      guard runtimeGeneration > state.runtimeGeneration else {
   720	        throw RuntimeDiagnosticsStoreError.generationMustIncrease(
   721	          current: state.runtimeGeneration,
   722	          proposed: runtimeGeneration
   723	        )
   724	      }
   725	      state = State(runtimeGeneration: runtimeGeneration)
   726	      return RuntimeDiagnosticsRecorder(
   727	        store: self,
   728	        runtimeGeneration: runtimeGeneration,
   729	        droppedUpdates: state.droppedUpdates,
   730	        tcpAdmissionGauges: state.tcpAdmissionGauges
   731	      )
   732	    }
   733	  }
   734	
   735	  /// Returns one immutable, self-consistent snapshot without polling any component.
   736	  public func snapshot(
   737	    requestID: OpaqueRuntimeRequestIdentifier? = nil
   738	  ) throws -> RuntimeDiagnosticsSnapshot {
   739	    snapshotRequestSlot.wait()
   740	    defer { snapshotRequestSlot.signal() }
   741	    return try stateQueue.sync {
   742	      mergeDroppedUpdates()
   743	      snapshotConstructionHook?()
   744	      reconcileTCPAdmissionGauges()
   745	      guard let sequence = state.nextSnapshotSequence else {
   746	        throw RuntimeDiagnosticsStoreError.snapshotSequenceExhausted(
   747	          runtimeGeneration: state.runtimeGeneration
   748	        )
   749	      }
   750	      state.nextSnapshotSequence = sequence == UInt64.max ? nil : sequence + 1
   751	      let buckets = zip(
   752	        RuntimeDiagnosticsSchema.dnsLatencyBucketUpperBoundsMilliseconds,
   753	        state.dnsLatencyCounts
   754	      ).map(RuntimeDiagnosticBucket.init)
   755	      let tcpChannelOpenBuckets = zip(
   756	        RuntimeDiagnosticsSchema.tcpChannelOpenLatencyBucketUpperBoundsMilliseconds,
   757	        state.tcpChannelOpenLatencyCounts
   758	      ).map(RuntimeDiagnosticBucket.init)
   759	      return RuntimeDiagnosticsSnapshot(
   760	        requestID: requestID,
   761	        runtimeGeneration: state.runtimeGeneration,
   762	        snapshotSequence: sequence,
   763	        counters: state.counters,
   764	        gauges: state.gauges,
   765	        histograms: [
   766	          "dns_latency_milliseconds": RuntimeDiagnosticHistogram(
   767	            unit: .milliseconds,
   768	            buckets: buckets
   769	          ),
   770	          "tcp_channel_open_latency_milliseconds": RuntimeDiagnosticHistogram(
   771	            unit: .milliseconds,
   772	            buckets: tcpChannelOpenBuckets
   773	          ),
   774	        ],
   775	        errors: state.errors.values
   776	          .map(\.redactedError)
   777	          .sorted { $0.domain.rawValue < $1.domain.rawValue },
   778	        sshBootstrapError: state.sshBootstrapError
   779	      )
   780	    }
   781	  }
   782	
