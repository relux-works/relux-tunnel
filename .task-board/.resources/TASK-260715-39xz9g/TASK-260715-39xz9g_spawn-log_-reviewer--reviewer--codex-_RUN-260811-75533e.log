    REPOSITORY_ROOT
    / ".research"
    / "fixtures"
    / f"{TASK_ID}_ssh-matrix-fixture-manifest-v1.json"
)
FIVE_GIB = 5 * 1024 * 1024 * 1024
DEFAULT_BLOCK_BYTES = 1024 * 1024
REQUIRED_SERVERS = {
    "linux-current",
    "macos-current",
    "macos-approved-older-profile",
    "relux-real",
}
