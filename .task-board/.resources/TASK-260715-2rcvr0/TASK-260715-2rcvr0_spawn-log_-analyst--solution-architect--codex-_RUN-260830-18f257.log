  1131	enum StrictJSONValidator {
  1132	  struct ValidationResult {
  1133	    let topLevelKeys: Set<String>
  1134	    let allObjectKeys: Set<String>
  1135	  }
  1136	
  1137	  @discardableResult
  1138	  static func validate(_ data: Data, maximumBytes: Int) throws -> Set<String> {
  1139	    try validate(
  1140	      data,
  1141	      maximumBytes: maximumBytes,
  1142	      maximumDepth: RuntimeMessageProtocol.maximumNestingDepth,
  1143	      requiresSortedKeys: false,
  1144	      allowsInsignificantWhitespace: true,
  1145	      requiresCanonicalStrings: false,
  1146	      requiresCanonicalNumbers: false
  1147	    ).topLevelKeys
  1148	  }
  1149	
  1150	  static func validate(
  1151	    _ data: Data,
  1152	    maximumBytes: Int,
  1153	    maximumDepth: Int,
  1154	    requiresSortedKeys: Bool,
  1155	    allowsInsignificantWhitespace: Bool,
  1156	    requiresCanonicalStrings: Bool,
  1157	    requiresCanonicalNumbers: Bool
  1158	  ) throws -> ValidationResult {
  1159	    guard data.count <= maximumBytes else {
  1160	      throw RuntimeMessageCodecError.payloadTooLarge(
  1161	        maximumBytes: maximumBytes,
  1162	        actualBytes: data.count
  1163	      )
  1164	    }
  1165	    guard String(data: data, encoding: .utf8) != nil else {
  1166	      throw RuntimeMessageCodecError.invalidUTF8
  1167	    }
