   909	  private func validateAlgorithmPolicy(_ policy: SSHAlgorithmPolicy) throws {
   910	    let capabilities = LibSSH2TransportFactory().capabilities
   911	    guard Set(policy.keyExchange).isSubset(of: capabilities.keyExchangeAlgorithms),
   912	      Set(policy.hostKey).isSubset(of: capabilities.hostKeyAlgorithms),
   913	      Set(policy.cipher).isSubset(of: capabilities.cipherAlgorithms),
   914	      Set(policy.mac).isSubset(of: capabilities.macAlgorithms)
   915	    else {
   916	      throw transportError(code: .algorithmNegotiationFailed, phase: .configuration)
   917	    }
   918	    let normalized = (policy.keyExchange + policy.hostKey + policy.cipher + policy.mac)
   919	      .map { $0.lowercased() }
   920	    guard !normalized.contains(where: { $0.contains("sha1") || $0.contains("-cbc") }) else {
   921	      throw transportError(code: .algorithmNegotiationFailed, phase: .configuration)
   922	    }
