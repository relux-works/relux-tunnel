   246	static int
   247	hev_socks5_session_udp_set_upstream_addr (HevSocks5Client *base,
   248	                                          HevSocks5Addr *addr)
   249	{
   250	    HevConfigServer *srv = hev_config_get_socks5_server ();
   251	    HevSocks5ClientClass *ckptr;
   252	
   253	    if (srv->udp_in_udp && srv->udp_addr[0]) {
   254	        uint16_t port = hev_socks5_addr_get_port (addr);
   255	        hev_socks5_addr_from_name (addr, srv->udp_addr, port);
   256	    }
   257	
   258	    ckptr = HEV_SOCKS5_CLIENT_CLASS (HEV_SOCKS5_CLIENT_UDP_TYPE);
   259	    return ckptr->set_upstream_addr (base, addr);
   260	}
