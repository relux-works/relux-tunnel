   248	    for (i = 0; i < num; i++) {
   249	        mvec[i].msg_hdr.msg_name = NULL;
   250	        mvec[i].msg_hdr.msg_namelen = 0;
   251	        mvec[i].msg_hdr.msg_control = NULL;
   252	        mvec[i].msg_hdr.msg_controllen = 0;
   253	        mvec[i].msg_hdr.msg_iov = &iov[i];
   254	        mvec[i].msg_hdr.msg_iovlen = 1;
   255	
   256	        iov[i].iov_base = msgv[i].buf;
   257	        iov[i].iov_len = msgv[i].len;
   258	    }
   259	
   260	    if (!HEV_SOCKS5 (self)->udp_associated) {
   261	        mvec[0].msg_hdr.msg_name = &taddr;
   262	        mvec[0].msg_hdr.msg_namelen = sizeof (taddr);
   263	    }
   264	
   265	    res = hev_task_io_socket_recvmmsg (fd, mvec, num, nonblock, task_io_yielder,
   266	                                       self);
   267	    if (res <= 0) {
   268	        if (res != -1 || errno != EAGAIN)
   269	            LOG_D ("%p socks5 udp read udp", self);
   270	        return res;
   271	    }
   272	
