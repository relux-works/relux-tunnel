+private func physicalProcessSnapshot() throws -> PhysicalProcessSnapshot {
+  var usage = rusage_info_v4()
+  let usageStatus = withUnsafeMutablePointer(to: &usage) { pointer in
+    var opaque: rusage_info_t? = UnsafeMutableRawPointer(pointer)
+    return proc_pid_rusage(getpid(), RUSAGE_INFO_V4, &opaque)
+  }
+  guard usageStatus == 0 else {
+    throw IntegrationTestError.systemCall("proc_pid_rusage", errno)
