   694	        if error is CancellationError {
   695	          transportError(code: .cancelled, phase: .rekey, scope: .operation)
   696	        } else if error is LibSSH2TimeoutError {
   697	          transportError(code: .timedOut, phase: .rekey, scope: .operation)
