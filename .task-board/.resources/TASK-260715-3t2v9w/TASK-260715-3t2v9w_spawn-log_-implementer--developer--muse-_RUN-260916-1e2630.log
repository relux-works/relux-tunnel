wnstream\n28|      )\n29|\n30|      await #expect(throws: TunnelRuntimeCoordinatorError.self) {\n31|        try await fixture.coordinator.start()\n32|      }\n33|      #expect(downstream.keychainCalls == 0)\n34|      #expect(downstream.networkCalls == 0)\n35|      #expect(await fixture.coordinator.resourceFootprint() == .baseline)\n36|    }\n37|\n38|    let downstream = ProfileDownstreamProbe()\n39|    let fixture = CoordinatorFixture(\n40|      profileProviderConfiguration: try SSHProfileProviderConfigurationCodec.encode(\n41|        validSnapshot\n42|      ),\n43|      profileDownstreamProbe: downstream\n44|    )\n45|    try await fixture.coordinator.start()\n46|    #expect(downstream.keychainCalls == 1)\n47|    #expect(downstream.networkCalls == 1)\n48|    await fixture.coordinator.stop(reason: .system)\n49|    #expect(await fixture.coordinator.resourceFootprint() == .baseline)\n50|  }\n51|\n52|  @Test(\"startup gates settings and publishes M1 usability only after reads\")\n53|  func orderedStartupAndStop() async throws {\n54|    let fixture = CoordinatorFixture()\n55|\n56|    try await fixture.coordinator.start()\n57|\n58|    #expect(await fixture.coordinator.coordinatorState() == .usableTCPDNS)\n59|    let events = fixture.recorder.events()\n60|    #expect(events.first == \"snapshot.connecting.0.0\")\n61|    #expect(events.dropFirst().first == \"configuration.load\")\n62|    #expect(index(of: \"settings.apply\", in: events) > index(of: \"packet.prepare\", in: events))\n63|    #expect(index(of: \"packet.activate\", in: events) > index(of: \"settings.apply\", in: events))\n64|    #expect(\n65|      index(of: \"snapshot.connectedDegraded.1.1\", in: events)\n66|        > index(of: \"packet.health.2\", in: events)\n67|    )\n68|\n69|    let startupSnapshots = fixture.recorder.snapshots()\n70|    #expect(startupSnapshots.first?.position.snapshotSequence == 0)\n71|    #expect(startupSnapshots.dropLast().allSatisfy { !$0.capabilities.tcp })\n72|    #expect(startupSnapshots.dropLast().allSatisfy { !$0.capabilities.safeDNS })\n73|    #expect(startupSnapshots.last?.capabilities.tcp == true)\n74|    #expect(startupSnapshots.last?.capabilities.safeDNS == true)\n75|    #expect(startupSnapshots.last?.capabilities.udp == false)\n76|    #expect(startupSnapshots.last?.capabilities.routesInstalled == true)\n77|\n78|    await fixture.coordinator.stop(reason: .userInitiated)\n79|\n80|    #expect(await fixture.coordinator.coordinatorState() == .disconnected)\n81|    #expect(\n82|      fixture.recorder.cleanupEvents() == [\n83|        \"tcp.closeAdmission\",\n84|        \"dns.closeAdmission\",\n85|        \"packet.stop\",\n86|        \"settings.clear\",\n87|        \"dns.stop\",\n88|        \"tcp.stop\",\n89|        \"ssh.close\",\n90|      ]\n91|    )\n92|    #expect(fixture.recorder.snapshots().last?.lifecycle.lifecycleState == .disconnected)\n93|    #expect(await fixture.coordinator.resourceFootprint() == .baseline)\n94|    #expect(fixture.recorder.activeResources() == 0)\n95|  }\n96|\n97|  @Test(\n98|    \"every partial startup acquisition rolls back only acquired resources\",\n99|    arguments: StartupFailurePoint.allCases\n100|  )\n101|  func partialStartRollback(point: StartupFailurePoint) async {\n102|    let fixture = CoordinatorFixture(failurePoint: point)\n103|\n104|    await #expect(throws: point.expectedError) {\n105|      try await fixture.coordinator.start()\n106|    }\n107|\n108|    #expect(await fixture.coordinator.coordinatorState() == .failed)\n109|    #expect(fixture.recorder.cleanupEvents() == point.expectedCleanup)\n110|    for event in point.expectedCleanup {\n111|      #expect(fixture.recorder.count(event) == 1)\n112|    }\n113|    #expect(\n114|      fixture.recorder.snapshots().count { $0.lifecycle.lifecycleState == .disconnecting } == 1\n115|    )\n116|    #expect(fixture.recorder.snapshots().count { $0.lifecycle.lifecycleState == .failed } == 1)\n117|    #expect(fixture.recorder.snapshots().last?.lifecycle.error == point.expectedFailure)\n118|    #expect(fixture.recorder.resourceBaseline() == .zero)\n119|    #expect(await fixture.coordinator.resourceFootprint() == .baseline)\n120|    #expect(fixture.recorder.snapshots().allSatisfy { !$0.capabilities.tcp })\n121|    #expect(fixture.recorder.snapshots().allSatisfy { !$0.capabilities.safeDNS })\n122|  }\n123|\n124|  @Test(\n125|    \"failure before and after every ownership boundary rolls back once\",\n126|    arguments: StartupOwnershipBoundary.allCases\n127|  )\n128|  func ownershipBoundaryFailure(boundary: StartupOwnershipBoundary) async {\n129|    let cancellation = OrdinalFailureCancellationChecker(failingAt: boundary.checkOrdinal)\n130|    let fixture = CoordinatorFixture(cancellation: cancellation)\n(more lines below)","final_result":true}}}
