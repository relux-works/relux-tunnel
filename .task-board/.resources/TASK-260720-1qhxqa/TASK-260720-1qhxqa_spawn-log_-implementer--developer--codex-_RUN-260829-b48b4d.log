                self.assertEqual(process.returncode, 1, process.stdout + process.stderr)
                self.assert_refused(report)
                self.assertEqual(report["failures"][0]["row"], "REPOSITORY-GRAPH")
                self.assertIn("extra=", report["failures"][0]["detail"])

