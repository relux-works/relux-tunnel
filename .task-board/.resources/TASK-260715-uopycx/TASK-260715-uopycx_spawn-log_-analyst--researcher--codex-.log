    85	    hev_task_io_reactor_destroy (context->reactor);
    86	rest_context:
    87	    hev_task_system_set_context (NULL);
    88	free_context:
    89	    hev_free (context);
    90	exit:
    91	    return -1;
    92	}
    93	
    94	EXPORT_SYMBOL void
    95	hev_task_system_fini (void)
    96	{
    97	    HevMemoryAllocator *allocator;
    98	    HevTaskSystemContext *context = hev_task_system_get_context ();
    99	
   100	    if (context->dns_proxy)
   101	        hev_task_dns_proxy_destroy (context->dns_proxy);
   102	    hev_task_stack_detector_destroy (context->stack_detector);
   103	    hev_task_timer_destroy (context->timer);
   104	    hev_task_io_reactor_destroy (context->reactor);
   105	    hev_free (context);
   106	    hev_task_system_set_context (NULL);
   107	
   108	    allocator = hev_memory_allocator_set_default (NULL);
   109	    if (allocator)
   110	        hev_memory_allocator_unref (allocator);
   111	}
   112	
   113	EXPORT_SYMBOL void
   114	hev_task_system_run (void)
   115	{
   116	    hev_task_system_schedule (HEV_TASK_RUN_SCHEDULER);
   117	}
