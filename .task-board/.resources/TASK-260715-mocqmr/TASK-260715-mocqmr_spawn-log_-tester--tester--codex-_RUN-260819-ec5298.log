+                    mock.patch.object(relay_asset_smoke.os, "close") as close,
+                ):
+                    relay_asset_smoke._linux_containment_preexec()
+                self.assertEqual(len(fake.syscall.calls), 3)
+                self.assertEqual(len(fake.prctl.calls), 2)
