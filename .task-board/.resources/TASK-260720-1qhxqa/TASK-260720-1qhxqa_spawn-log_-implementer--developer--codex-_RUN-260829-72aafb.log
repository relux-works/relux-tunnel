   333	def verify_board_state(board_state_path: Path, manifest: dict[str, Any]) -> None:
   334	    board_state = json.loads(board_state_path.read_text(encoding="utf-8"))
   335	    if not isinstance(board_state, list) or len(board_state) != 4:
   336	        raise BindingError("BOARD-STATE", "exactly four authority rows are required")
   337	    rows: dict[str, dict[str, Any]] = {}
   338	    for raw_row in board_state:
   339	        row = require_object(raw_row, "BOARD-STATE")
   340	        require_exact_keys(row, {"id", "status", "outcomeResources"}, "BOARD-STATE-FIELDS")
   341	        task_id = row["id"]
   342	        if task_id in rows:
   343	            raise BindingError("BOARD-STATE", f"duplicate task {task_id}")
   344	        rows[task_id] = row
   345	
   346	    required: dict[str, set[str]] = {}
   347	    runtime = manifest["runtimeContract"]
   348	    required[runtime["taskId"]] = {
   349	        runtime["resourceName"], runtime["reviewerVerdict"]["resourceName"]
   350	    }
   351	    for item in manifest["acceptedInputs"]:
   352	        required[item["taskId"]] = {
   353	            item["acceptedOutcome"]["resourceName"],
   354	            item["reviewerVerdict"]["resourceName"],
   355	        }
   356	    if set(rows) != set(required):
   357	        raise BindingError("BOARD-STATE", "authority task set drift")
   358	    for task_id, names in required.items():
   359	        row = rows[task_id]
   360	        if row["status"] != "done":
   361	            raise BindingError("BOARD-STATE", f"{task_id} is not reviewer-terminal done")
   362	        resources = row["outcomeResources"]
   363	        if not isinstance(resources, list):
   364	            raise BindingError("BOARD-STATE", f"{task_id} outcome resource declaration unreadable")
   365	        declared = {
   366	            item.get("name") for item in resources if isinstance(item, dict)
   367	        }
   368	        missing = sorted(names - declared)
   369	        if missing:
   370	            raise BindingError(
   371	                "BOARD-STATE", f"{task_id} accepted resources are no longer declared: {missing}"
   372	            )
