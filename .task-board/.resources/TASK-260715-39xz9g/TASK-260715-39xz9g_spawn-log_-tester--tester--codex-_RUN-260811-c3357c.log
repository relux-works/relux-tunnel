    let code: SSHTransportErrorCode
    switch engineCode {
    case LIBSSH2_ERROR_AUTHENTICATION_FAILED: code = .authenticationRejected
    case LIBSSH2_ERROR_PUBLICKEY_UNVERIFIED, LIBSSH2_ERROR_PUBLICKEY_PROTOCOL:
