+          "macos-arm64_x86_64/libReluxLibSSH2.a": "836e3a5dad2b43b7e62677437f2a269c90383f4e8563c09428ecc6349b7b15ed"
+        }
+      }
+    },
     "hev-lwip": {
       "revision": "ad7600497931205105b08367bd1b450048157e40",
       "upstream": "https://github.com/heiher/hev-socks5-tunnel",
