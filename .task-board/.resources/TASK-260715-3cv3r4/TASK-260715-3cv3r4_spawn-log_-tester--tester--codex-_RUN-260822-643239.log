+  var networkCalls: Int { lock.withLock { networkCallCount } }
+
+  func recordKeychainCall() {
+    lock.withLock { keychainCallCount += 1 }
+  }
+
+  func recordNetworkCall() {
+    lock.withLock { networkCallCount += 1 }
+  }
+}
