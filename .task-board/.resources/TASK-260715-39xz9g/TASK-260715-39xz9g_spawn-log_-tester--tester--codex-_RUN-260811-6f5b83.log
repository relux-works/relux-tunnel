   843	def parser() -> argparse.ArgumentParser:
   844	    root = argparse.ArgumentParser(description=__doc__)
   845	    commands = root.add_subparsers(dest="command", required=True)
   846	    commands.add_parser("dispatch")
   847	    lifecycle = commands.add_parser("lifecycle")
   848	    lifecycle.add_argument("--output", type=Path)
   849	    return root
   850	
   851	
   852	def main(argv: list[str] | None = None) -> int:
   853	    arguments = parser().parse_args(argv)
   854	    provider = BuiltinProvider()
   855	    try:
   856	        if arguments.command == "dispatch":
   857	            request = json.load(sys.stdin)
   858	            if not isinstance(request, dict):
   859	                raise ProviderError("provider request must be a JSON object")
   860	            print(fixture.canonical_json(dispatch(provider, request)).decode(), end="")
