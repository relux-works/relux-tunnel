   159	
   160	static int
   161	hev_socks5_udp_recvmmsg_tcp (HevSocks5UDP *self, HevSocks5UDPMsg *msgv,
   162	                             unsigned int num, int nonblock)
   163	{
   164	    int i, fd, rlen = 0;
   165	
   166	    fd = hev_socks5_udp_get_fd (self);
   167	
   168	    if (nonblock)
   169	        nonblock = MSG_DONTWAIT;
   170	
   171	    for (i = 0; i < num; i++) {
   172	        HevSocks5UDPHdr udp;
   173	        struct iovec iov[2];
   174	        struct msghdr mh;
   175	        int addrlen;
   176	        int res;
   177	
   178	        res = hev_task_io_socket_recv (fd, &udp, 5, nonblock, task_io_yielder,
   179	                                       self);
   180	        if (res > 0 && res < 5)
   181	            res += hev_task_io_socket_recv (fd, (void *)&udp + res, 5 - res,
   182	                                            MSG_WAITALL, task_io_yielder, self);
   183	        if (res != 5) {
   184	            if (rlen > 0)
   185	                break;
   186	            if (res != -1 || errno != EAGAIN)
   187	                LOG_D ("%p socks5 udp read udp head", self);
   188	            return res;
   189	        }
   190	
   191	        if (udp.hdrlen < 5) {
   192	            LOG_D ("%p socks5 udp head len", self);
   193	            return -1;
   194	        }
   195	
   196	        addrlen = udp.hdrlen - 3;
   197	        udp.datlen = ntohs (udp.datlen);
   198	        if (udp.datlen > (msgv[i].len - addrlen)) {
   199	            LOG_D ("%p socks5 udp data len", self);
   200	            return -1;
   201	        }
   202	
   203	        mh.msg_name = NULL;
   204	        mh.msg_namelen = 0;
   205	        mh.msg_control = NULL;
   206	        mh.msg_controllen = 0;
   207	        mh.msg_iov = iov;
   208	        mh.msg_iovlen = 2;
   209	
   210	        iov[0].iov_base = msgv[i].buf + 2;
   211	        iov[0].iov_len = addrlen - 2;
   212	        iov[1].iov_base = msgv[i].buf + addrlen;
   213	        iov[1].iov_len = udp.datlen;
   214	
   215	        res = hev_task_io_socket_recvmsg (fd, &mh, MSG_WAITALL, task_io_yielder,
   216	                                          self);
   217	        if (res != (addrlen - 2 + udp.datlen)) {
   218	            LOG_D ("%p socks5 udp read udp data", self);
   219	            return res;
   220	        }
   221	
   222	        msgv[i].addr = msgv[i].buf;
   223	        msgv[i].buf = iov[1].iov_base;
   224	        msgv[i].len = udp.datlen;
   225	        msgv[i].addr->atype = udp.addr.atype;
   226	        msgv[i].addr->domain.len = udp.addr.domain.len;
   227	
   228	        rlen++;
   229	    }
   230	
   231	    return rlen;
   232	}
   233	
   234	static int
   235	hev_socks5_udp_recvmmsg_udp (HevSocks5UDP *self, HevSocks5UDPMsg *msgv,
   236	                             unsigned int num, int nonblock)
   237	{
   238	    struct sockaddr_in6 taddr;
   239	    struct mmsghdr mvec[num];
   240	    struct iovec iov[num];
   241	    int i, fd, res;
   242	
   243	    fd = hev_socks5_udp_get_fd (self);
   244	
   245	    if (nonblock)
   246	        nonblock = MSG_DONTWAIT;
