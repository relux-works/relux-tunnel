  1371	  private func execSignalName(_ value: String) -> SSHExecSignalName {
  1372	    switch value.uppercased() {
  1373	    case "HUP": .hangup
  1374	    case "INT": .interrupt
  1375	    case "QUIT": .quit
  1376	    case "ILL": .illegalInstruction
  1377	    case "ABRT": .abort
  1378	    case "FPE": .floatingPointException
  1379	    case "KILL": .kill
  1380	    case "SEGV": .segmentationFault
  1381	    case "PIPE": .pipe
  1382	    case "ALRM": .alarm
  1383	    case "TERM": .terminate
  1384	    default: .other(value)
  1385	    }
  1386	  }
  1387	
  1388	  private func tearDown() async {
  1389	    if teardownInProgress {
  1390	      await withCheckedContinuation { continuation in
  1391	        teardownWaiters.append(continuation)
  1392	      }
  1393	      return
  1394	    }
  1395	    teardownInProgress = true
  1396	    await performTearDown()
  1397	    teardownInProgress = false
  1398	    let waiters = teardownWaiters
  1399	    teardownWaiters.removeAll()
  1400	    for waiter in waiters { waiter.resume() }
  1401	  }
  1402	
  1403	  private func performTearDown() async {
  1404	    automaticRekeyTask?.cancel()
  1405	    automaticKeepaliveTask?.cancel()
  1406	    byteRekeyTask?.cancel()
  1407	    automaticRekeyTask = nil
  1408	    automaticKeepaliveTask = nil
  1409	    byteRekeyTask = nil
  1410	    await context.cancelSignatureAndWait()
  1411	    await waitForChannelOpensToDrain()
  1412	    await waitForSessionOperationsToDrain()
  1413	    let deadline = dependencies.clock.now().advanced(
  1414	      by: configuration?.timeouts.transportClose ?? .seconds(1)
  1415	    )
  1416	    for identity in Array(channels.keys) {
  1417	      await channelDispose(
  1418	        identity: identity,
  1419	        disposition: .connectionClosed,
  1420	        graceful: false,
  1421	        terminalEvent: .channelClosed(identity)
  1422	      )
  1423	    }
  1424	    if let engineSession {
  1425	      while libssh2_session_disconnect_ex(
  1426	        engineSession,
  1427	        Int32(SSH_DISCONNECT_BY_APPLICATION),
  1428	        "closed",
  1429	        ""
  1430	      ) == LIBSSH2_ERROR_EAGAIN {
  1431	        do { try await cleanupProgress(until: deadline) } catch { break }
  1432	      }
  1433	      var freeResult = libssh2_session_free(engineSession)
  1434	      while freeResult == LIBSSH2_ERROR_EAGAIN {
  1435	        do { try await cleanupProgress(until: deadline) } catch { break }
  1436	        freeResult = libssh2_session_free(engineSession)
  1437	      }
  1438	      if freeResult == LIBSSH2_ERROR_EAGAIN {
  1439	        context.network.fail()
  1440	        _ = libssh2_session_free(engineSession)
  1441	      }
  1442	      self.engineSession = nil
  1443	      sessionContextPointer = nil
  1444	    }
  1445	    context.network.discard()
  1446	    await connection?.close()
  1447	    connection = nil
  1448	    negotiatedAlgorithms = nil
  1449	    if state != .closed {
  1450	      if state != .closing { try? await transition(to: .closing) }
  1451	      try? await transition(to: .closed)
  1452	    }
  1453	  }
  1454	
  1455	  private func cleanupProgress(until deadline: ContinuousClock.Instant) async throws {
  1456	    let now = dependencies.clock.now()
  1457	    guard now < deadline else { throw LibSSH2TimeoutError.elapsed }
  1458	    guard let connection, let engineSession else { return }
  1459	    let directions = libssh2_session_block_directions(engineSession)
  1460	    var interests = Set<SSHTCPReadiness>()
  1461	    if directions & LIBSSH2_SESSION_BLOCK_INBOUND != 0 { interests.insert(.readable) }
  1462	    if directions & LIBSSH2_SESSION_BLOCK_OUTBOUND != 0 { interests.insert(.writable) }
  1463	    if interests.isEmpty { interests = [.readable, .writable] }
  1464	    let requestedInterests = interests
  1465	    try await withTimeout(now.duration(to: deadline), clock: dependencies.clock) {
  1466	      try await self.context.network.service(
  1467	        connection: connection,
  1468	        interests: requestedInterests
  1469	      )
  1470	    }
  1471	  }
  1472	
  1473	  private func transition(to next: SSHConnectionState) async throws {
  1474	    guard state.permitsTransition(to: next) else {
  1475	      throw transportError(code: .invalidState, phase: phase(for: state))
  1476	    }
  1477	    let previous = state
  1478	    state = next
  1479	    await emit(.connectionTransition(from: previous, to: next))
  1480	  }
