   192	def verify_repository(repository_root: Path, inputs: dict[str, dict[str, Any]]) -> None:
   193	    project = (repository_root / "Project.swift").read_text(encoding="utf-8")
   194	    package = (repository_root / "Package.swift").read_text(encoding="utf-8")
   195	    native_manifest = json.loads(
   196	        (repository_root / "NativeDependencies/manifest.json").read_text(encoding="utf-8")
   197	    )
   198	
   199	    provider = target_block(project, "ReluxProxyMacTunnel")
   200	    require_tokens(
   201	        provider,
   202	        {
   203	            '.folderReference(path: verifiedRelayBundleInput)',
   204	            '.package(product: "ReluxTunnelMacOSAdapter")',
   205	        },
   206	        "REPOSITORY-GRAPH",
   207	    )
   208	    require_tokens(
   209	        target_block(package, "ReluxTunnelMacOSAdapter"),
   210	        {'"ReluxTunnelCore"', '"ReluxTunnelLibSSH2Adapter"', '"ReluxTunnelNativeAdapter"'},
   211	        "REPOSITORY-GRAPH",
   212	    )
   213	    require_tokens(
   214	        target_block(package, "ReluxTunnelNativeAdapter"),
   215	        {'"ReluxTunnelCore"', '"HevSocks5Tunnel"'},
   216	        "REPOSITORY-GRAPH",
   217	    )
   218	    require_tokens(
   219	        target_block(package, "ReluxTunnelLibSSH2Adapter"),
   220	        {'"ReluxTunnelCore"', '"ReluxLibSSH2"'},
   221	        "REPOSITORY-GRAPH",
   222	    )
   223	
   224	    packet_pins = inputs["packetBridgeAndHEV"]["sourceOrBinaryPins"]
   225	    hev = native_manifest["dependencies"].get("hev-lwip", {})
   226	    if hev.get("revision") != packet_pins["hevSocks5Tunnel"]:
   227	        raise BindingError("REPOSITORY-HEV-PIN", "HEV top-level revision drift")
   228	    expected_submodules = {
   229	        "src/core": packet_pins["hevSocks5Core"],
   230	        "third-part/hev-task-system": packet_pins["hevTaskSystem"],
   231	        "third-part/lwip": packet_pins["lwip"],
   232	        "third-part/yaml": packet_pins["yaml"],
   233	    }
   234	    actual_submodules = {
   235	        item["path"]: item["revision"] for item in hev.get("source", {}).get("submodules", [])
   236	    }
   237	    if actual_submodules != expected_submodules:
   238	        raise BindingError("REPOSITORY-HEV-PIN", "HEV recursive graph drift")
   239	
   240	    ssh_pins = inputs["sshEngine"]["sourceOrBinaryPins"]
   241	    ssh = native_manifest["dependencies"].get("libssh2-openssl", {})
   242	    if ssh.get("source", {}).get("libssh2", {}).get("revision") != ssh_pins["libssh2Commit"]:
   243	        raise BindingError("REPOSITORY-SSH-PIN", "libssh2 revision drift")
   244	    if (
   245	        ssh.get("source", {}).get("libssh2", {}).get("archive_sha256")
   246	        != ssh_pins["libssh2ArchiveSha256"]
   247	    ):
   248	        raise BindingError("REPOSITORY-SSH-PIN", "libssh2 archive digest drift")
   249	    if ssh.get("source", {}).get("openssl", {}).get("revision") != ssh_pins["opensslTag"]:
   250	        raise BindingError("REPOSITORY-SSH-PIN", "OpenSSL tag drift")
   251	    if (
   252	        ssh.get("source", {}).get("openssl", {}).get("archive_sha256")
   253	        != ssh_pins["opensslArchiveSha256"]
   254	    ):
   255	        raise BindingError("REPOSITORY-SSH-PIN", "OpenSSL archive digest drift")
