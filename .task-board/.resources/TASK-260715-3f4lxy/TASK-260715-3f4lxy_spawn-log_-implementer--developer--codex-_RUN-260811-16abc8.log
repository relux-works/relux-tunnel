+) throws -> Data {
+  try mutatePolicy(data) { policy in
+    var records = try #require(policy["records"] as? [[String: Any]])
+    var first = try #require(records.first)
+    try mutation(&first)
+    records[0] = first
+    policy["records"] = records
+  }
