   561	/// Validated finite-token error code. It cannot contain endpoints or error text.
   562	public struct RedactedRuntimeErrorCode: Codable, Hashable, Sendable {
   563	  public static let maximumUTF8Bytes = 64
   564	  public let rawValue: String
   565	
   566	  public init(_ rawValue: String) throws {
   567	    guard Self.isValid(rawValue) else {
   568	      throw RuntimeMessageCodecError.unsupportedValue
   569	    }
   570	    self.rawValue = rawValue
   571	  }
   572	
   573	  public init(from decoder: any Decoder) throws {
   574	    try self.init(try decoder.singleValueContainer().decode(String.self))
   575	  }
   576	
   577	  public func encode(to encoder: any Encoder) throws {
   578	    var container = encoder.singleValueContainer()
   579	    try container.encode(rawValue)
   580	  }
   581	
   582	  private static func isValid(_ value: String) -> Bool {
   583	    guard !value.isEmpty, value.utf8.count <= maximumUTF8Bytes else { return false }
   584	    return value.utf8.allSatisfy {
   585	      (UInt8(ascii: "a")...UInt8(ascii: "z")).contains($0)
   586	        || (UInt8(ascii: "0")...UInt8(ascii: "9")).contains($0)
   587	        || $0 == UInt8(ascii: "_")
   588	    }
   589	  }
   590	}
