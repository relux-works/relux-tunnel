   484	        required[item["taskId"]] = {
   485	            item["acceptedOutcome"]["resourceName"],
   486	            item["reviewerVerdict"]["resourceName"],
   487	        }
   488	    if set(rows) != set(required):
   489	        raise BindingError("BOARD-STATE", "authority task set drift")
