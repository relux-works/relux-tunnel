    )
    let error = try SSHTransportError(
      code: .authenticationRejected,
      phase: .authentication,
      scope: .lane(fixtureLane()),
      retryDisposition: .never,
      requiresTeardown: true,
      channelOpenReason: .notApplicable
    )
    let diagnostics = [
      String(reflecting: event),
