   530	def parse_ustar_assets(stream: Any, contract: dict[str, Any]) -> list[bytes]:
   531	    contents_by_target: list[bytes] = []
   532	    for asset in contract["assets"]:
   533	        header = read_exact_stream(stream, 512, "header")
   534	        if header == bytes(512):
   535	            raise AssetManifestError("trusted relay archive is missing an asset")
   536	        stored_checksum = parse_tar_number(header[148:156], "header checksum")
   537	        computed_checksum = sum(header[:148]) + (8 * ord(" ")) + sum(header[156:])
   538	        if stored_checksum != computed_checksum:
   539	            raise AssetManifestError("trusted relay archive header checksum mismatch")
   540	        if header[257:263] != b"ustar\0" or header[156:157] not in {b"0", b"\0"}:
   541	            raise AssetManifestError("trusted relay archive contains unsafe metadata")
   542	        try:
   543	            name = header[:100].split(b"\0", 1)[0].decode("ascii")
   544	            prefix = header[345:500].split(b"\0", 1)[0].decode("ascii")
   545	        except UnicodeDecodeError as error:
   546	            raise AssetManifestError(
   547	                "trusted relay archive member name is invalid"
   548	            ) from error
   549	        if prefix:
   550	            name = f"{prefix}/{name}"
   551	        member_size = parse_tar_number(header[124:136], "member size")
   552	        member_mode = parse_tar_number(header[100:108], "member mode")
   553	        if (
   554	            name != asset["archivePath"]
   555	            or member_size != asset["byteSize"]
   556	            or member_mode != 0o755
   557	        ):
   558	            raise AssetManifestError(
   559	                "trusted relay archive member set, order, or metadata changed"
   560	            )
   561	        contents = read_exact_stream(stream, member_size, "asset")
   562	        padding_size = (-member_size) % 512
   563	        if padding_size and read_exact_stream(stream, padding_size, "padding") != bytes(
   564	            padding_size
   565	        ):
   566	            raise AssetManifestError("trusted relay archive padding is invalid")
   567	        if sha256_bytes(contents) != asset["sha256"]:
   568	            raise AssetManifestError("trusted relay archive asset checksum mismatch")
   569	        verify_binary_header(contents, asset["os"], asset["arch"])
   570	        verify_embedded_identity(contents, contract)
   571	        contents_by_target.append(contents)
   572	
   573	    validate_archive_trailer(stream)
   574	    return contents_by_target
   575	
