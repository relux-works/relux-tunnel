verify_records('build-recipe',build['recipeRevision'],build['recipeFiles'],build['recipeAggregateSHA256'])
repo_tree=subprocess.run(['git','rev-parse',f\"{src['revision']}"'^{{tree}}"],cwd=root,check=True,text=True,capture_output=True).stdout.strip()
