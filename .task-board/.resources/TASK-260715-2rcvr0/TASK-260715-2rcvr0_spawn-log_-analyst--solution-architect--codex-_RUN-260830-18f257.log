    recordTermination(for: reason)

    let operation = startupTask
    operation?.cancel()
    await transitionToStopping()
    if let operation {
      _ = await operation.result
    }
    await joinCleanup()
  }

  private func recordTermination(for reason: ProviderStopReason) {
