+          }
+        ]
+      },
+      "license": {
+        "spdx": "MIT",
+        "files": ["NativeDependencies/Fixtures/ReluxNativeFixture/LICENSE"],
+        "notices_output": "NativeDependencies/THIRD_PARTY_NOTICES.txt"
+      },
+      "rebuild": {
