+@testable import ReluxTunnelLibSSH2Adapter
+import Testing
+
+@Test("bounded custom transport bridge starts empty")
+func boundedBridgeStartsEmpty() {
+  let bridge = LibSSH2NetworkBridge(maximumBufferedBytes: 64)
+  #expect(bridge.bufferedByteCounts.inbound == 0)
+  #expect(bridge.bufferedByteCounts.outbound == 0)
+}

