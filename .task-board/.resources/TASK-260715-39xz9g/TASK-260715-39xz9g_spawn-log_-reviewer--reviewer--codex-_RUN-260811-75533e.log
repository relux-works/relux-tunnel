   259	def expected_stream_hash(
   260	    total_bytes: int, seed: str, block_bytes: int = DEFAULT_BLOCK_BYTES
   261	) -> str:
   262	    if total_bytes < 0:
   263	        raise FixtureError("traffic byte count cannot be negative")
