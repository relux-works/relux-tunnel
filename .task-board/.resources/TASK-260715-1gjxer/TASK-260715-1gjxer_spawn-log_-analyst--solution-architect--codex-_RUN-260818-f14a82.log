+    let start = data.index(data.startIndex, offsetBy: offset)
+    let end = data.index(start, offsetBy: 4)
+    let value = data[start..<end].withUnsafeBytes {
+      UInt32(bigEndian: $0.loadUnaligned(as: UInt32.self))
+    }
+    offset += 4
+    return value
+  }
