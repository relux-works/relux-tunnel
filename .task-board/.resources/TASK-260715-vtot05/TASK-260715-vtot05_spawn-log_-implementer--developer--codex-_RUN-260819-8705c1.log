+                elif index >= 4 and tokens[index - 4][0] == "identifier":
+                    initializer_type = tokens[index - 4][1]
+                else:
+                    initializer_type = "ambiguous"
+            elif candidate[0] == "identifier":
+                initializer_type = candidate[1]
