   336	    private func createPendingChannelsIfPossible() {
   337	        guard self.stateMachine.hasActivated, self.pendingChannelInitializations.count > 0 else {
   338	            // No work to do
   339	            return
   340	        }
   341	
   342	        if !self.stateMachine.disconnected, let multiplexer = self.multiplexer {
   343	            while let next = self.pendingChannelInitializations.popFirst() {
   344	                multiplexer.createChildChannel(next.promise, channelType: next.channelType, next.initializer)
   345	            }
   346	        } else {
