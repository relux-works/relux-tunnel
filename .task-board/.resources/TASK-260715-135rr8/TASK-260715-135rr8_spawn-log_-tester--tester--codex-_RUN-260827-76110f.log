  1190	
  1191	private func lifecycleSegments(
  1192	  samples: [PhysicalMemoryLifecycleSample],
  1193	  segmentSampleCount: Int
  1194	) -> [LifecycleSegment] {
  1195	  guard segmentSampleCount > 1 else { return [] }
  1196	  return stride(from: 0, to: samples.count, by: segmentSampleCount).compactMap { start in
  1197	    let end = min(start + segmentSampleCount, samples.count)
  1198	    let segment = Array(samples[start..<end])
  1199	    guard let first = segment.first, let last = segment.last else { return nil }
  1200	    let analysis = analyzeLifecycleFootprint(
  1201	      segment.map(\.physicalFootprintBytes),
  1202	      warmupSampleCount: 0
  1203	    )
  1204	    let transitions = max(1, segment.count - 1)
  1205	    return LifecycleSegment(
  1206	      firstCycle: first.cycle,
  1207	      lastCycle: last.cycle,
  1208	      sampleCount: segment.count,
  1209	      netPhysicalFootprintChangeBytes: analysis.netChangeBytes,
  1210	      bytesPerCycle: Double(analysis.netChangeBytes) / Double(transitions),
  1211	      increaseTransitionCount: analysis.increaseTransitionCount,
  1212	      equalTransitionCount: analysis.equalTransitionCount,
  1213	      decreaseTransitionCount: analysis.decreaseTransitionCount,
  1214	      initialDescriptors: first.descriptors,
  1215	      finalDescriptors: last.descriptors,
  1216	      initialThreads: first.processThreads,
  1217	      finalThreads: last.processThreads
  1218	    )
  1219	  }
  1220	}
  1221	
  1222	private struct LifecycleConvergencePolicy: Equatable, Sendable {
  1223	  let minimumSampleCount: Int
  1224	  let trailingSampleCount: Int
  1225	  let absolutePostWarmupGrowthCeilingBytes: UInt64
  1226	
  1227	  static let physicalHEVLifecycle = LifecycleConvergencePolicy(
  1228	    minimumSampleCount: 500,
  1229	    trailingSampleCount: 0,
  1230	    absolutePostWarmupGrowthCeilingBytes: 256 * 1_024
  1231	  )
  1232	}
  1233	
  1234	private struct LifecycleFootprintAnalysis: Equatable, Sendable {
  1235	  let warmupSampleCount: Int
  1235	  let warmupSampleCount: Int
  1236	  let analyzedSampleCount: Int
  1237	  let netChangeBytes: Int64
  1238	  let increaseTransitionCount: Int
  1239	  let equalTransitionCount: Int
  1240	  let decreaseTransitionCount: Int
  1241	  let monotonicGrowthObserved: Bool
  1242	  let convergencePolicy: LifecycleConvergencePolicy
  1243	  let trailingNetChangeBytes: Int64
  1244	  let trailingIncreaseTransitionCount: Int
  1245	  let trailingEqualTransitionCount: Int
  1246	  let trailingDecreaseTransitionCount: Int
  1247	  let postWarmupMaximumDrawupBytes: UInt64
  1248	  let trailingMaximumDrawupBytes: UInt64
  1249	  let boundedConvergenceObserved: Bool
  1250	  let increaseCycles: [Int]
  1251	}
  1252	
  1253	private func analyzeLifecycleFootprint(
  1254	  _ samples: [UInt64],
  1255	  warmupSampleCount: Int,
  1256	  convergencePolicy: LifecycleConvergencePolicy = .physicalHEVLifecycle
  1257	) -> LifecycleFootprintAnalysis {
  1258	  let appliedWarmup = min(max(0, warmupSampleCount), samples.count)
  1259	  let analyzed = Array(samples.dropFirst(appliedWarmup))
  1260	  var increases = 0
  1261	  var equals = 0
  1262	  var decreases = 0
  1263	  var increaseCycles: [Int] = []
  1264	  for (offset, transition) in zip(analyzed, analyzed.dropFirst()).enumerated() {
  1265	    let (previous, next) = transition
  1266	    if next > previous {
  1267	      increases += 1
  1268	      increaseCycles.append(appliedWarmup + offset + 2)
  1269	    } else if next == previous {
  1270	      equals += 1
  1271	    } else {
  1272	      decreases += 1
  1273	    }
  1274	  }
  1275	  let netChange: Int64
  1276	  if let first = analyzed.first, let last = analyzed.last {
  1277	    netChange =
  1278	      last >= first
  1279	      ? Int64(clamping: last - first)
  1280	      : -Int64(clamping: first - last)
  1281	  } else {
  1282	    netChange = 0
  1283	  }
  1284	  let trailingSampleCount = min(
  1285	    max(0, convergencePolicy.trailingSampleCount),
  1286	    analyzed.count
  1287	  )
  1288	  let trailing = Array(analyzed.suffix(trailingSampleCount))
  1289	  var trailingIncreases = 0
  1290	  var trailingEquals = 0
  1291	  var trailingDecreases = 0
  1292	  for (previous, next) in zip(trailing, trailing.dropFirst()) {
  1293	    if next > previous {
  1294	      trailingIncreases += 1
  1295	    } else if next == previous {
  1296	      trailingEquals += 1
  1297	    } else {
  1298	      trailingDecreases += 1
  1299	    }
  1300	  }
  1301	  let trailingNetChange: Int64
  1302	  if let first = trailing.first, let last = trailing.last {
  1303	    trailingNetChange =
  1304	      last >= first
  1305	      ? Int64(clamping: last - first)
  1306	      : -Int64(clamping: first - last)
  1307	  } else {
  1308	    trailingNetChange = 0
  1309	  }
  1310	  let postWarmupMaximumDrawup = maximumDrawup(analyzed)
  1311	  let trailingMaximumDrawup = maximumDrawup(trailing)
  1312	  let withinGrowthCeiling =
  1313	    postWarmupMaximumDrawup <= convergencePolicy.absolutePostWarmupGrowthCeilingBytes
  1314	    && trailingMaximumDrawup <= convergencePolicy.absolutePostWarmupGrowthCeilingBytes
  1315	  return LifecycleFootprintAnalysis(
  1316	    warmupSampleCount: appliedWarmup,
  1317	    analyzedSampleCount: analyzed.count,
  1318	    netChangeBytes: netChange,
  1319	    increaseTransitionCount: increases,
  1320	    equalTransitionCount: equals,
  1321	    decreaseTransitionCount: decreases,
  1322	    monotonicGrowthObserved: analyzed.count > 1 && increases > 0 && decreases == 0,
  1323	    convergencePolicy: convergencePolicy,
  1324	    trailingNetChangeBytes: trailingNetChange,
  1325	    trailingIncreaseTransitionCount: trailingIncreases,
  1326	    trailingEqualTransitionCount: trailingEquals,
  1327	    trailingDecreaseTransitionCount: trailingDecreases,
  1328	    postWarmupMaximumDrawupBytes: postWarmupMaximumDrawup,
  1329	    trailingMaximumDrawupBytes: trailingMaximumDrawup,
  1330	    boundedConvergenceObserved: samples.count >= convergencePolicy.minimumSampleCount
  1331	      && trailingSampleCount == convergencePolicy.trailingSampleCount
