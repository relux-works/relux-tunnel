   270	
   271	static void
   272	event_task_entry (void *data)
   273	{
   274	    HevListNode *node;
   275	    int val;
   276	
   277	    LOG_D ("socks5 tunnel event task run");
   278	
   279	    hev_task_add_fd (task_event, event_fds[0], POLLIN);
   280	
   281	    hev_task_io_read (event_fds[0], &val, sizeof (val), NULL, NULL);
   282	
   283	    run = 0;
   284	    node = hev_list_first (&session_set);
   285	    for (; node; node = hev_list_node_next (node)) {
   286	        HevSocks5SessionData *sd;
   287	
   288	        sd = container_of (node, HevSocks5SessionData, node);
   289	        hev_socks5_session_terminate (sd->self);
   290	    }
   291	
   292	    hev_task_join (task_lwip_io);
   293	    hev_task_join (task_lwip_timer);
   294	    hev_task_del_fd (task_event, event_fds[0]);
   295	}
   296	
   297	static void
   298	lwip_io_task_entry (void *data)
   299	{
   300	    const unsigned int mtu = hev_config_get_tunnel_mtu ();
   301	
   302	    LOG_D ("socks5 tunnel lwip task run");
   303	
   304	    hev_tunnel_add_task (tun_fd, task_lwip_io);
   305	
   306	    for (; run;) {
   307	        struct pbuf *buf;
   308	
   309	        buf = hev_tunnel_read (tun_fd, mtu, task_io_yielder, NULL);
   310	        if (!buf)
   311	            continue;
   312	
   313	        stat_tx_packets++;
   314	        stat_tx_bytes += buf->tot_len;
   315	
   316	        hev_task_mutex_lock (&mutex);
   317	        if (netif.input (buf, &netif) != ERR_OK)
   318	            pbuf_free (buf);
   319	        hev_task_mutex_unlock (&mutex);
   320	    }
   321	
   322	    hev_tunnel_del_task (tun_fd, task_lwip_io);
   323	}
   324	
   325	static void
   326	lwip_timer_task_entry (void *data)
   327	{
   328	    unsigned int i;
   329	
   330	    LOG_D ("socks5 tunnel timer task run");
   331	
   332	    for (i = 1; run; i++) {
   333	        hev_task_mutex_lock (&mutex);
   334	        tcp_tmr ();
   335	
   336	        if ((i & 3) == 0) {
   337	#if IP_REASSEMBLY
   338	            ip_reass_tmr ();
   339	#endif
   340	#if LWIP_IPV6
   341	            nd6_tmr ();
   342	#if LWIP_IPV6_REASS
   343	            ip6_reass_tmr ();
   344	#endif
   345	#endif
   346	        }
   347	        hev_task_mutex_unlock (&mutex);
   348	
   349	        if (hev_list_first (&session_set))
   350	            hev_task_sleep (TCP_TMR_INTERVAL);
   351	        else
   352	            hev_task_yield (HEV_TASK_WAITIO);
   353	    }
   354	}
