   690	        try container.decode([String: Int64].self, forKey: .gauges)
   691	      } else {
   692	        [:]
   693	      }
   694	    histograms =
   695	      if container.contains(.histograms) {
   696	        try container.decode([String: RuntimeDiagnosticHistogram].self, forKey: .histograms)
   697	      } else {
   698	        [:]
   699	      }
   700	    errors =
