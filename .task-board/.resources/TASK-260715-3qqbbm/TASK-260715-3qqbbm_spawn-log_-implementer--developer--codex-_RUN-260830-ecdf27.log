    59	def dependency_products(block: str) -> set[str]:
    60	    return set(re.findall(r'\.package\(product:\s*"([^"]+)"\)', block))
    61	
    62	
    63	def target_dependencies(block: str) -> set[str]:
    64	    dependency_match = re.search(
    65	        r"dependencies:\s*\[(.*?)\](?:\s*,\s*(?:linkerSettings|plugins):|\s*\))",
    66	        block,
    67	        re.DOTALL,
    68	    )
    69	    if dependency_match is None:
    70	        raise ContractError("target dependencies are not statically inspectable")
    71	    return set(re.findall(r'"([A-Za-z][A-Za-z0-9]+)"', dependency_match.group(1)))
