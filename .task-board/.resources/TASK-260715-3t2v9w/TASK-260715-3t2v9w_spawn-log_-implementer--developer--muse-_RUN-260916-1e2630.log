{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c613","stream":{"kind":"session","id":"01a0aa7a-9815-7302-a96f-7a8fde67c84b"},"sequence":356,"recorded_at":1780531400000707,"record_type":"event","durability":"durable","causation_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","run_stream":{"kind":"run","id":"7cb39f37-e5ea-43fc-a612-eaf97474622d"},"task_stream":{"kind":"task","id":"01a0aa7b-6fcb-7ac0-9b2c-e0456634dd7e"},"task_id":"01a0aa7b-6fcb-7ac0-9b2c-e0456634dd7e","event":{"kind":"output","task_id":"01a0aa7b-6fcb-7ac0-9b2c-e0456634dd7e","chunk":"Read text file `Sources/ReluxTunnelCore/M1RuntimeComposition.swift`.\n1|import Foundation\n2|\n3|/// TCP admission used by the private M1 packet ingress. Concrete TCP\n4|/// implementations remain outside the composition layer.\n5|public protocol M1TCPIngressConsumer: TCPConsumer {\n6|  func openTCP(\n7|    destination: TunnelEndpoint,\n8|    originator: TunnelEndpoint\n9|  ) async throws -> any SSHByteChannel\n10|}\n11|\n12|/// Safe-DNS admission used by the private M1 packet ingress. Only the\n13|/// composition-owned virtual DNS endpoints are routed here.\n14|public protocol M1DNSIngressConsumer: DNSConsumer {\n15|  func openTCP(\n16|    destination: TunnelEndpoint,\n17|    originator: TunnelEndpoint\n18|  ) async throws -> any SSHByteChannel\n19|\n20|  func exchangeUDP(\n21|    _ query: Data,\n22|    destination: TunnelEndpoint,\n23|    originator: TunnelEndpoint\n24|  ) async throws -> Data\n25|}\n26|\n27|/// Candidate-neutral channel surface retained by an authenticated M1 SSH\n28|/// session. TCP and DNS consumers never receive the concrete transport.\n29|public protocol M1SSHChannelSession: SSHBootstrapSession {\n30|  func openTCP(\n31|    destination: TunnelEndpoint,\n32|    originator: TunnelEndpoint\n33|  ) async throws -> any SSHByteChannel\n34|}\n35|\n36|public enum M1PrivateIngressRequest: Sendable {\n37|  case tcp(destination: TunnelEndpoint, originator: TunnelEndpoint)\n38|  case udp(\n39|    payload: Data,\n40|    destination: TunnelEndpoint,\n41|    originator: TunnelEndpoint\n42|  )\n43|}\n44|\n45|public enum M1PrivateIngressDispatch: Sendable {\n46|  case tcp(any SSHByteChannel)\n47|  case dnsTCP(any SSHByteChannel)\n48|  case dnsUDP(Data)\n49|}\n50|\n51|public enum M1PrivateIngressError: Error, Equatable, Sendable {\n52|  case incompatibleTCPConsumer\n53|  case incompatibleDNSConsumer\n54|  case generalUDPDeferred\n55|}\n56|\n57|public protocol M1PrivateIngressDispatching: Sendable {\n58|  func dispatch(_ request: M1PrivateIngressRequest) async throws\n59|    -> M1PrivateIngressDispatch\n60|}\n61|\n62|/// M1's only private-ingress routing decision.\n63|///\n64|/// TCP CONNECT is admitted by TCP except for the explicitly supplied virtual\n65|/// DNS endpoints. UDP is admitted only for those virtual DNS endpoints; all\n66|/// other UDP fails closed until the later general-UDP milestone.\n67|public struct M1PrivateIngressDispatcher: M1PrivateIngressDispatching {\n68|  private let tcp: any M1TCPIngressConsumer\n69|  private let dns: any M1DNSIngressConsumer\n70|  private let virtualDNSEndpoints: Set<TunnelEndpoint>\n71|\n72|  public init(\n73|    tcp: any M1TCPIngressConsumer,\n74|    dns: any M1DNSIngressConsumer,\n75|    virtualDNSEndpoints: Set<TunnelEndpoint>\n76|  ) {\n77|    self.tcp = tcp\n78|    self.dns = dns\n79|    self.virtualDNSEndpoints = virtualDNSEndpoints\n80|  }\n81|\n82|  public func dispatch(\n83|    _ request: M1PrivateIngressRequest\n84|  ) async throws -> M1PrivateIngressDispatch {\n85|    switch request {\n86|    case .tcp(let destination, let originator):\n87|      if virtualDNSEndpoints.contains(destination) {\n88|        return .dnsTCP(\n89|          try await dns.openTCP(destination: destination, originator: originator)\n90|        )\n91|      }\n92|      return .tcp(\n93|        try await tcp.openTCP(destination: destination, originator: originator)\n94|      )\n95|    case .udp(let payload, let destination, let originator):\n96|      guard virtualDNSEndpoints.contains(destination) else {\n97|        throw M1PrivateIngressError.generalUDPDeferred\n98|      }\n99|      return .dnsUDP(\n100|        try await dns.exchangeUDP(\n101|          payload,\n102|          destination: destination,\n103|          originator: originator\n104|        )\n105|      )\n106|    }\n107|  }\n108|}\n109|\n110|public typealias M1PacketBridgeBuilder =\n111|  @Sendable (\n112|    _ ingress: any M1PrivateIngressDispatching,\n113|    _ runtimeGeneration: UInt64\n114|  ) throws -> any PacketBridge\n115|\n116|/// Resource-free packet-plane preflight.\n117|///\n118|/// The builder may construct owners but must not create descriptors, listeners,\n119|/// native leases/threads, or PacketFlow reads. Those operations belong to the\n120|/// returned bridge's `start` call, reached only through `activateReads`.\n121|public struct BridgeBackedM1PacketPlaneFactory: M1PacketPlaneFactory {\n122|  private let configuration: PacketBridgeConfiguration\n123|  private let virtualDNSEndpoints: Set<TunnelEndpoint>\n124|  private let makeBridge: M1PacketBridgeBuilder\n125|\n126|  public init(\n127|    configuration: PacketBridgeConfiguration,\n128|    virtualDNSEndpoints: Set<TunnelEndpoint>,\n129|    makeBridge: @escaping M1PacketBridgeBuilder\n130|  ) {\n131|    self.configuration = configuration\n132|    self.virtualDNSEndpoints = virtualDNSEndpoints\n133|    self.makeBridge = makeBridge\n134|  }\n135|\n136|  public func prepare(\n137|    configuration: RuntimeConfigurationSnapshot,\n138|    tcp: any TCPConsumer,\n139|    dns: any DNSConsumer,\n140|    runtimeGeneration: UInt64,\n141|    healthSink: any TunnelRuntimeHealthEventSink\n142|  ) async throws -> any M1PacketPlaneSession {\n143|    guard let tcp = tcp as? any M1TCPIngressConsumer else {\n144|      throw M1PrivateIngressError.incompatibleTCPConsumer\n145|    }\n146|    guard let dns = dns as? any M1DNSIngressConsumer else {\n147|      throw M1PrivateIngressError.incompatibleDNSConsumer\n148|    }\n149|    let ingress = M1PrivateIngressDispatcher(\n150|      tcp: tcp,\n151|      dns: dns,\n152|      virtualDNSEndpoints: virtualDNSEndpoints\n153|    )\n154|    let bridge = try makeBridge(ingress, runtimeGeneration)\n155|    return BridgeBackedM1PacketPlaneSession(\n156|      bridge: bridge,\n157|      configuration: self.configuration,\n158|      runtimeGeneration: runtimeGeneration,\n159|      healthSink: healthSink\n160|    )\n161|  }\n162|}\n163|\n164|/// One-generation owner of the accepted PacketBridge.\n165|public actor BridgeBackedM1PacketPlaneSession: M1PacketPlaneSession {\n166|  private enum State {\n167|    case prepared\n168|    case activating\n169|    case active\n170|    case failed\n171|    case stopped\n172|  }\n173|\n174|  private let bridge: any PacketBridge\n175|  private let configuration: PacketBridgeConfiguration\n176|  private let runtimeGeneration: UInt64\n177|  private let healthSink: any TunnelRuntimeHealthEventSink\n178|  private var state = State.prepared\n179|\n180|  public init(\n181|    bridge: any PacketBridge,\n182|    configuration: PacketBridgeConfiguration,\n183|    runtimeGeneration: UInt64,\n184|    healthSink: any TunnelRuntimeHealthEventSink\n185|  ) {\n186|    self.bridge = bridge\n187|    self.configuration = configuration\n188|    self.runtimeGeneration = runtimeGeneration\n189|    self.healthSink = healthSink\n190|  }\n191|\n192|  public func activateReads(packetFlow: any PacketFlow) async throws {\n193|    guard state == .prepared else {\n194|      throw PacketFlowBridgeError.alreadyActive\n195|    }\n196|    state = .activating\n197|    do {\n198|      _ = try await bridge.start(\n199|        packetFlow: packetFlow,\n200|        configuration: configuration\n201|      )\n202|      state = .active\n203|    } catch {\n204|      state = .failed\n205|      await healthSink.receive(\n206|        TunnelRuntimeHealthEvent(\n207|          runtimeGeneration: runtimeGeneration,\n208|          component: .packetPlane,\n209|          health: .unhealthy\n210|        )\n211|      )\n212|      throw error\n213|    }\n214|  }\n215|\n216|  public func stop() async {\n217|    guard state != .stopped else { return }\n218|    await bridge.stop()\n219|    state = .stopped\n220|  }\n221|\n222|  public func health() async -> TunnelRuntimeComponentHealth {\n223|    switch state {\n224|    case .prepared, .activating, .active:\n225|      .healthy\n226|    case .failed, .stopped:\n227|      .unhealthy\n228|    }\n229|  }\n230|}","final_result":true}}}
