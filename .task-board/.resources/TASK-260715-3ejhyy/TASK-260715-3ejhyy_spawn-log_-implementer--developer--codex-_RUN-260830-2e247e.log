+      ),
+      algorithms: SSHAlgorithmPolicy(
+        keyExchange: ["curve25519-sha256"],
+        hostKey: ["ssh-ed25519"],
+        cipher: ["aes256-ctr"],
+        mac: ["hmac-sha2-256"]
+      ),
+      timeouts: try ownershipTimeouts(),
+      rekey: SSHRekeyPolicy(
+        protectedByteThresholdPerDirection: 4_096,
+        elapsedTimeThreshold: .milliseconds(100),
+        timeout: .seconds(10)
+      ),
