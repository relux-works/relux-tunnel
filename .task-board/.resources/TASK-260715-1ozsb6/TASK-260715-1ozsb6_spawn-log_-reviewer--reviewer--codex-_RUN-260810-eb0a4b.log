  1299	  private func channelDispose(
  1300	    identity: SSHChannelIdentity,
  1301	    disposition: SSHTransportErrorCode,
  1302	    graceful: Bool,
  1303	    terminalEvent: SSHTransportEventKind?
  1304	  ) async {
  1305	    guard channels[identity] != nil else { return }
  1306	    guard disposingChannels[identity] == nil else {
  1307	      await waitForChannelOperationsToDrain(identity: identity)
  1308	      return
  1309	    }
  1310	    disposingChannels[identity] = disposition
  1311	    await waitForChannelOperationsToDrain(identity: identity)
  1312	    guard let record = channels.removeValue(forKey: identity) else { return }
  1313	    let deadline = dependencies.clock.now().advanced(
  1314	      by: configuration?.timeouts.channelClose ?? .seconds(1)
  1315	    )
  1316	    if graceful {
  1317	      while libssh2_channel_close(record.pointer) == LIBSSH2_ERROR_EAGAIN {
  1318	        do { try await cleanupProgress(until: deadline) } catch { break }
  1319	      }
  1320	    }
  1321	    while libssh2_channel_free(record.pointer) == LIBSSH2_ERROR_EAGAIN {
  1322	      do { try await cleanupProgress(until: deadline) } catch { break }
  1323	    }
  1324	    disposingChannels.removeValue(forKey: identity)
  1325	    pendingWriteBytes.removeValue(forKey: identity)
  1326	    if let terminalEvent { await emit(terminalEvent) }
  1327	  }
