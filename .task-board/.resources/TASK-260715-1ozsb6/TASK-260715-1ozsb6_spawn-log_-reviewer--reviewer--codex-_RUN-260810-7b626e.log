   639	  private func progress(until deadline: ContinuousClock.Instant, phase: SSHTransportPhase)
   640	    async throws
   641	  {
   642	    try checkCancellation(phase: phase)
   643	    let now = dependencies.clock.now()
   644	    guard now < deadline else { throw transportError(code: .timedOut, phase: phase) }
   645	    let remaining = now.duration(to: deadline)
   646	    if context.signatureIsPending() {
   647	      try await dependencies.clock.sleep(
   648	        for: min(remaining, LibSSH2AdapterConstants.minimumProgressDelay))
   649	      return
   650	    }
   651	    guard let connection, let engineSession else {
   652	      throw transportError(code: .connectionClosed, phase: phase)
   653	    }
   654	    let directions = libssh2_session_block_directions(engineSession)
   655	    var interests = Set<SSHTCPReadiness>()
   656	    if directions & LIBSSH2_SESSION_BLOCK_INBOUND != 0 { interests.insert(.readable) }
   657	    if directions & LIBSSH2_SESSION_BLOCK_OUTBOUND != 0 { interests.insert(.writable) }
   658	    if interests.isEmpty { interests = [.readable, .writable] }
   659	    let requestedInterests = interests
   660	    try await withTimeout(remaining, clock: dependencies.clock) {
   661	      try await self.context.network.service(
   662	        connection: connection,
   663	        interests: requestedInterests
   664	      )
   665	    }
   666	  }
