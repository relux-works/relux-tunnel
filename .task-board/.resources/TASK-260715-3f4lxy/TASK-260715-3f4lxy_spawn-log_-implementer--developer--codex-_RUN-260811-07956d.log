   229	    encoder.outputFormatting = [.sortedKeys, .withoutEscapingSlashes]
   230	    do {
   231	      let data = try encoder.encode(wire)
   232	      guard data.count <= maximumSnapshotBytes else {
   233	        throw SSHProfileSnapshotLoaderError.profileOversize
   234	      }
   235	      return data
   236	    } catch let error as SSHProfileSnapshotLoaderError {
   237	      throw error
   238	    } catch {
   239	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   240	    }
   241	  }
   242	
   243	  public static func decode(_ data: Data) throws -> SSHProfileSnapshotV1 {
   244	    let validation: StrictJSONValidator.ValidationResult
   245	    do {
   246	      validation = try StrictJSONValidator.validate(
   247	        data,
   248	        maximumBytes: maximumSnapshotBytes,
   249	        maximumDepth: SSHProfileSnapshotV1.maximumNestingDepth,
   250	        requiresSortedKeys: true,
   251	        allowsInsignificantWhitespace: false,
   252	        requiresCanonicalStrings: true,
   253	        requiresCanonicalNumbers: true
   254	      )
   255	    } catch RuntimeMessageCodecError.payloadTooLarge {
   256	      throw SSHProfileSnapshotLoaderError.profileOversize
   257	    } catch {
   258	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   259	    }
   260	
   261	    guard !validation.allObjectKeys.contains(where: isProhibitedFieldName) else {
   262	      throw SSHProfileSnapshotLoaderError.profileContainsProhibitedField
   263	    }
   264	
   265	    let header: SSHProfileSnapshotHeader
   266	    do {
   267	      header = try JSONDecoder().decode(SSHProfileSnapshotHeader.self, from: data)
   268	    } catch {
   269	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   270	    }
   271	    guard header.protocolVersion == UInt64(SSHProfileSnapshotV1.currentProtocolVersion),
   272	      header.schemaVersion == UInt64(SSHProfileSnapshotV1.currentSchemaVersion),
   273	      header.kind == SSHProfileSnapshotV1.kind
   274	    else {
   275	      throw SSHProfileSnapshotLoaderError.profileVersionUnsupported
   276	    }
   277	
   278	    do {
   279	      return try validate(JSONDecoder().decode(SSHProfileSnapshotWire.self, from: data))
   280	    } catch let error as SSHProfileSnapshotLoaderError {
   281	      throw error
   282	    } catch {
   283	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   284	    }
   285	  }
   286	
   287	  private static func validate(_ wire: SSHProfileSnapshotWire) throws -> SSHProfileSnapshotV1 {
   288	    guard wire.protocolVersion == UInt64(SSHProfileSnapshotV1.currentProtocolVersion),
   289	      wire.schemaVersion == UInt64(SSHProfileSnapshotV1.currentSchemaVersion),
   290	      wire.kind == SSHProfileSnapshotV1.kind
   291	    else {
   292	      throw SSHProfileSnapshotLoaderError.profileVersionUnsupported
   293	    }
   294	    guard wire.configurationGeneration >= 1 else {
   295	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.configurationGeneration)
   296	    }
   297	    let profileID = try canonicalUUID(wire.profileID, field: .profileID)
   298	    let createdAt = try timestamp(wire.createdAt, field: .createdAt)
   299	    let updatedAt = try timestamp(wire.updatedAt, field: .updatedAt)
   300	    guard createdAt.date <= updatedAt.date else {
   301	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.updatedAt)
   302	    }
   303	    try validateDisplayName(wire.displayName)
   304	    let canonicalHost = try validateHost(wire.canonicalHost)
   305	    guard (1...65_535).contains(wire.port), let port = UInt16(exactly: wire.port) else {
   306	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.port)
   307	    }
   308	    try validateAccount(wire.account)
   309	    let credentialReference = try canonicalUUID(
   310	      wire.credential.ref,
   311	      field: .credentialReference
   312	    )
   313	    guard wire.credential.generation >= 1 else {
   314	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.credentialGeneration)
   315	    }
   316	    let hostPolicy = try validateHostPolicy(wire.hostPolicy)
   317	
   318	    return SSHProfileSnapshotV1(
   319	      configurationGeneration: wire.configurationGeneration,
   320	      profileID: OpaqueProfileIdentifier(profileID),
   321	      createdAt: SSHProfileTimestamp(createdAt.rawValue),
   322	      updatedAt: SSHProfileTimestamp(updatedAt.rawValue),
   323	      displayName: wire.displayName,
   324	      canonicalHost: canonicalHost,
   325	      port: port,
   326	      account: wire.account,
   327	      credential: SSHProfileCredentialReferenceV1(
   328	        reference: OpaqueCredentialReference(credentialReference),
   329	        generation: wire.credential.generation
   330	      ),
   331	      hostPolicy: hostPolicy
   332	    )
   333	  }
   334	
   335	  private static func validateHostPolicy(
   336	    _ wire: SSHProfileHostPolicyWire
   337	  ) throws -> SSHHostPolicyV1 {
   338	    guard
   339	      (1...SSHHostKeyAlgorithm.canonicalPreferenceOrder.count).contains(
   340	        wire.allowedAlgorithms.count
   341	      )
   342	    else {
   343	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.allowedAlgorithms)
   344	    }
   345	
   346	    let algorithms: [SSHHostKeyAlgorithm] = try wire.allowedAlgorithms.map { value in
   347	      guard let algorithm = SSHHostKeyAlgorithm(rawValue: value) else {
   348	        throw SSHProfileSnapshotLoaderError.profileInvalidField(.allowedAlgorithms)
   349	      }
   350	      return algorithm
   351	    }
   352	    let canonicalIndexes = algorithms.compactMap {
   353	      SSHHostKeyAlgorithm.canonicalPreferenceOrder.firstIndex(of: $0)
   354	    }
   355	    guard zip(canonicalIndexes, canonicalIndexes.dropFirst()).allSatisfy(<) else {
   356	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.allowedAlgorithms)
   357	    }
   358	    guard wire.records.count <= 8 else {
   359	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   360	    }
   361	
   362	    var tuples: Set<SSHHostIdentityTuple> = []
   363	    var approvedCount = 0
   364	    var records: [SSHHostIdentityRecordV1] = []
   365	    for record in wire.records {
   366	      guard let algorithm = SSHHostKeyAlgorithm(rawValue: record.algorithm),
   367	        algorithms.contains(algorithm),
   368	        let state = SSHHostIdentityState(rawValue: record.state),
   369	        let provenance = SSHHostIdentityProvenance(rawValue: record.provenance)
   370	      else {
   371	        throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   372	      }
   373	      let fingerprint = try fingerprint(record.fingerprintSHA256)
   374	      let tuple = SSHHostIdentityTuple(algorithm: algorithm, digest: fingerprint.digest)
   375	      guard tuples.insert(tuple).inserted else {
   376	        throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   377	      }
   378	      let firstSeenAt = try timestamp(record.firstSeenAt, field: .trustRecords)
   379	      let lastSeenAt = try timestamp(record.lastSeenAt, field: .trustRecords)
   380	      guard firstSeenAt.date <= lastSeenAt.date else {
   381	        throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   382	      }
   383	      let approvedAt = try record.approvedAt.map { value in
   384	        let parsed = try timestamp(value, field: .trustRecords)
   385	        return SSHProfileTimestamp(parsed.rawValue)
   386	      }
   387	      let revokedAt = try record.revokedAt.map { value in
   388	        let parsed = try timestamp(value, field: .trustRecords)
   389	        return SSHProfileTimestamp(parsed.rawValue)
   390	      }
   391	      let revocationReason = record.revocationReason.flatMap(
   392	        SSHHostIdentityRevocationReason.init(rawValue:)
   393	      )
   394	
   395	      switch state {
   396	      case .approved:
   397	        approvedCount += 1
   398	        guard approvedAt != nil, revokedAt == nil, record.revocationReason == nil else {
   399	          throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   400	        }
   401	      case .revoked:
   402	        guard revokedAt != nil, revocationReason != nil else {
   403	          throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   404	        }
   405	      }
   406	      if record.revocationReason != nil, revocationReason == nil {
   407	        throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   408	      }
   409	
   410	      records.append(
   411	        SSHHostIdentityRecordV1(
   412	          algorithm: algorithm,
   413	          fingerprintSHA256: SSHHostKeyFingerprint(fingerprint.rawValue),
   414	          state: state,
   415	          provenance: provenance,
   416	          firstSeenAt: SSHProfileTimestamp(firstSeenAt.rawValue),
   417	          lastSeenAt: SSHProfileTimestamp(lastSeenAt.rawValue),
   418	          approvedAt: approvedAt,
   419	          revokedAt: revokedAt,
   420	          revocationReason: revocationReason
   421	        )
   422	      )
   423	    }
   424	    guard approvedCount <= 1 else {
   425	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   426	    }
   427	
   428	    let sortedTuples = tuples.sorted(by: SSHHostIdentityTuple.isOrderedBefore)
   429	    let actualTuples = records.map {
   430	      SSHHostIdentityTuple(
   431	        algorithm: $0.algorithm,
   432	        digest: fingerprintDigest($0.fingerprintSHA256.rawValue)!
   433	      )
   434	    }
   435	    guard actualTuples == sortedTuples else {
   436	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   437	    }
   438	    return SSHHostPolicyV1(allowedAlgorithms: algorithms, records: records)
   439	  }
   440	
   441	  private static func validateDisplayName(_ value: String) throws {
   442	    guard value.utf8.elementsEqual(value.precomposedStringWithCanonicalMapping.utf8),
   443	      value == value.trimmingCharacters(in: .whitespacesAndNewlines),
   444	      (1...128).contains(value.unicodeScalars.count),
   445	      !value.unicodeScalars.contains(where: isRejectedDisplayScalar)
   446	    else {
   447	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.displayName)
   448	    }
   449	  }
   450	
   451	  private static func validateAccount(_ value: String) throws {
   452	    guard value.utf8.elementsEqual(value.precomposedStringWithCanonicalMapping.utf8),
   453	      value == value.trimmingCharacters(in: .whitespacesAndNewlines),
   454	      (1...64).contains(value.utf8.count),
   455	      !value.unicodeScalars.contains(where: isRejectedAccountScalar)
   456	    else {
   457	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.account)
   458	    }
   459	  }
   460	
   461	  private static func validateHost(
   462	    _ wire: SSHProfileCanonicalHostWire
   463	  ) throws -> SSHProfileCanonicalHost {
   464	    guard let kind = SSHProfileHostKind(rawValue: wire.kind) else {
   465	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.canonicalHost)
   466	    }
   467	    let value = wire.value
   468	    guard !value.isEmpty,
   469	      value == value.trimmingCharacters(in: CharacterSet(charactersIn: " \t\r\n")),
   470	      !value.unicodeScalars.contains(where: { $0.value < 0x20 || $0.value == 0x7F }),
   471	      !value.contains(where: { $0.isWhitespace }),
   472	      !value.contains("@"), !value.contains("/"), !value.contains("?"),
   473	      !value.contains("#"), !value.contains("["), !value.contains("]"),
   474	      !value.contains("%"), !value.contains("://")
   475	    else {
   476	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.canonicalHost)
   477	    }
   478	
   479	    let isCanonical: Bool
   480	    switch kind {
   481	    case .dns:
   482	      isCanonical = isCanonicalDNS(value)
   483	    case .ipv4:
   484	      isCanonical = canonicalNumericAddress(value, family: AF_INET) == value
   485	    case .ipv6:
   486	      isCanonical = canonicalNumericAddress(value, family: AF_INET6) == value
   487	    }
   488	    guard isCanonical else {
   489	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.canonicalHost)
   490	    }
   491	    return SSHProfileCanonicalHost(kind: kind, value: value)
   492	  }
   493	
   494	  private static func isCanonicalDNS(_ value: String) -> Bool {
   495	    guard value.utf8.count <= 253,
   496	      value.unicodeScalars.allSatisfy({ $0.isASCII }),
   497	      value == value.lowercased(),
   498	      !value.hasSuffix("."),
   499	      canonicalNumericAddress(value, family: AF_INET) == nil,
   500	      canonicalNumericAddress(value, family: AF_INET6) == nil
   501	    else { return false }
   502	
   503	    let labels = value.split(separator: ".", omittingEmptySubsequences: false)
   504	    guard !labels.isEmpty else { return false }
   505	    if labels.count == 4,
   506	      labels.allSatisfy({ label in
   507	        !label.isEmpty && label.allSatisfy(\.isNumber)
   508	      })
   509	    {
   510	      return false
   511	    }
   512	    for label in labels {
   513	      guard (1...63).contains(label.utf8.count),
   514	        label.first != "-", label.last != "-",
   515	        label.allSatisfy({ $0.isASCII && ($0.isLetter || $0.isNumber || $0 == "-") })
   516	      else { return false }
   517	      if label.count >= 4,
   518	        label[label.index(label.startIndex, offsetBy: 2)] == "-",
   519	        label[label.index(label.startIndex, offsetBy: 3)] == "-",
   520	        !label.hasPrefix("xn--")
   521	      {
   522	        return false
   523	      }
   524	    }
   525	
   526	    var components = URLComponents()
   527	    components.scheme = "ssh"
   528	    components.host = value
   529	    guard let unicodeHost = components.host,
   530	      let encodedHost = components.url?.host()?.lowercased(),
   531	      encodedHost == value
   532	    else { return false }
   533	    var roundTrip = URLComponents()
   534	    roundTrip.scheme = "ssh"
   535	    roundTrip.host = unicodeHost
   536	    return roundTrip.url?.host()?.lowercased() == value
   537	  }
   538	
   539	  private static func canonicalNumericAddress(_ value: String, family: Int32) -> String? {
   540	    if family == AF_INET {
   541	      var address = in_addr()
   542	      guard value.withCString({ inet_pton(AF_INET, $0, &address) }) == 1 else { return nil }
   543	      var buffer = [CChar](repeating: 0, count: Int(INET_ADDRSTRLEN))
   544	      guard inet_ntop(AF_INET, &address, &buffer, socklen_t(buffer.count)) != nil else {
   545	        return nil
   546	      }
   547	      return String(
   548	        decoding: buffer.prefix(while: { $0 != 0 }).map { UInt8(bitPattern: $0) },
   549	        as: UTF8.self
   550	      )
   551	    }
   552	    var address = in6_addr()
   553	    guard value.withCString({ inet_pton(AF_INET6, $0, &address) }) == 1 else { return nil }
   554	    var buffer = [CChar](repeating: 0, count: Int(INET6_ADDRSTRLEN))
   555	    guard inet_ntop(AF_INET6, &address, &buffer, socklen_t(buffer.count)) != nil else {
   556	      return nil
   557	    }
   558	    return String(
   559	      decoding: buffer.prefix(while: { $0 != 0 }).map { UInt8(bitPattern: $0) },
   560	      as: UTF8.self
   561	    )
   562	  }
   563	
   564	  private static func canonicalUUID(
   565	    _ value: String,
   566	    field: SSHProfileSnapshotField
   567	  ) throws -> UUID {
   568	    guard let uuid = UUID(uuidString: value), uuid.uuidString.lowercased() == value else {
   569	      throw SSHProfileSnapshotLoaderError.profileInvalidField(field)
   570	    }
   571	    return uuid
   572	  }
   573	
   574	  private static func timestamp(
   575	    _ value: String,
   576	    field: SSHProfileSnapshotField
   577	  ) throws -> (rawValue: String, date: Date) {
   578	    let bytes = Array(value.utf8)
   579	    guard bytes.count == 24,
   580	      bytes[4] == UInt8(ascii: "-"), bytes[7] == UInt8(ascii: "-"),
   581	      bytes[10] == UInt8(ascii: "T"), bytes[13] == UInt8(ascii: ":"),
   582	      bytes[16] == UInt8(ascii: ":"), bytes[19] == UInt8(ascii: "."),
   583	      bytes[23] == UInt8(ascii: "Z"),
   584	      bytes.enumerated().allSatisfy({ index, byte in
   585	        [4, 7, 10, 13, 16, 19, 23].contains(index)
   586	          || (UInt8(ascii: "0")...UInt8(ascii: "9")).contains(byte)
   587	      })
   588	    else {
   589	      throw SSHProfileSnapshotLoaderError.profileInvalidField(field)
   590	    }
   591	    let formatter = ISO8601DateFormatter()
   592	    formatter.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
   593	    formatter.timeZone = TimeZone(secondsFromGMT: 0)
   594	    guard let date = formatter.date(from: value), formatter.string(from: date) == value else {
   595	      throw SSHProfileSnapshotLoaderError.profileInvalidField(field)
   596	    }
   597	    return (value, date)
   598	  }
   599	
   600	  private static func fingerprint(
   601	    _ value: String
   602	  ) throws -> (rawValue: String, digest: Data) {
   603	    guard let digest = fingerprintDigest(value) else {
   604	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.trustRecords)
   605	    }
   606	    return (value, digest)
   607	  }
   608	
   609	  private static func fingerprintDigest(_ value: String) -> Data? {
   610	    guard value.hasPrefix("SHA256:"), value.utf8.count == 50 else { return nil }
   611	    let encoded = String(value.dropFirst(7))
   612	    guard encoded.utf8.count == 43,
   613	      encoded.unicodeScalars.allSatisfy({ scalar in
   614	        scalar.isASCII
   615	          && (("A"..."Z").contains(Character(scalar))
   616	            || ("a"..."z").contains(Character(scalar))
   617	            || ("0"..."9").contains(Character(scalar))
   618	            || scalar == "+" || scalar == "/")
   619	      }),
   620	      let data = Data(base64Encoded: encoded + "="), data.count == 32,
   621	      data.base64EncodedString().dropLast() == encoded
   622	    else { return nil }
   623	    return data
   624	  }
   625	
   626	  private static func isRejectedDisplayScalar(_ scalar: Unicode.Scalar) -> Bool {
   627	    CharacterSet.controlCharacters.contains(scalar)
   628	      || scalar.value == 0x2028 || scalar.value == 0x2029
   629	      || (0x202A...0x202E).contains(scalar.value)
   630	      || (0x2066...0x2069).contains(scalar.value)
   631	  }
   632	
   633	  private static func isRejectedAccountScalar(_ scalar: Unicode.Scalar) -> Bool {
   634	    scalar.value == 0 || CharacterSet.controlCharacters.contains(scalar)
   635	      || scalar.value == 0x2028 || scalar.value == 0x2029
   636	  }
   637	
   638	  private static func isProhibitedFieldName(_ name: String) -> Bool {
   639	    let normalized = name.lowercased().unicodeScalars.filter {
   640	      CharacterSet.alphanumerics.contains($0)
   641	    }.map(String.init).joined()
   642	    return [
   643	      "privatekey", "privatekeybytes", "passphrase", "decryptedkey", "keybytes",
   644	      "rawhostkey", "password", "seed", "stagingcredential",
   645	    ].contains(normalized)
   646	  }
   647	}
   648	
   649	public enum SSHProfileProviderConfigurationCodec {
   650	  public static let maximumEnvelopeBytes = RuntimeMessageSizeLimit.providerConfiguration
   651	
   652	  public static func encode(
   653	    _ snapshot: SSHProfileSnapshotV1
   654	  ) throws -> [String: VPNProviderConfigurationValue] {
   655	    let data = try SSHProfileSnapshotCodec.encode(snapshot)
   656	    let configuration: [String: VPNProviderConfigurationValue] = [
   657	      OwnedVPNManagerRepository.ownerKey: .string(OwnedVPNManagerRepository.ownerValue),
   658	      OwnedVPNManagerRepository.managerContractKey: .integer(
   659	        OwnedVPNManagerRepository.managerContractVersion
   660	      ),
   661	      OwnedVPNManagerRepository.configurationReferenceKey: .data(data),
   662	    ]
   663	    guard try envelopeSize(configuration) <= maximumEnvelopeBytes else {
   664	      throw SSHProfileSnapshotLoaderError.profileOversize
   665	    }
   666	    return configuration
   667	  }
   668	
   669	  public static func decode(
   670	    _ configuration: [String: VPNProviderConfigurationValue]?
   671	  ) throws -> SSHProfileSnapshotV1 {
   672	    try decodeCapture(configuration).snapshot
   673	  }
   674	
   675	  public static func envelopeSize(
   676	    _ configuration: [String: VPNProviderConfigurationValue]
   677	  ) throws -> Int {
   678	    let propertyList = try exactPropertyList(configuration)
   679	    do {
   680	      return try PropertyListSerialization.data(
   681	        fromPropertyList: propertyList,
   682	        format: .binary,
   683	        options: 0
   684	      ).count
   685	    } catch {
   686	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   687	    }
   688	  }
   689	
   690	  static func decodeCapture(
   691	    _ configuration: [String: VPNProviderConfigurationValue]?
   692	  ) throws -> (snapshot: SSHProfileSnapshotV1, data: Data) {
   693	    guard let configuration else {
   694	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   695	    }
   696	    let propertyList = try exactPropertyList(configuration)
   697	    guard
   698	      case .data(let data) = configuration[
   699	        OwnedVPNManagerRepository.configurationReferenceKey
   700	      ]
   701	    else {
   702	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   703	    }
   704	    guard data.count <= maximumEnvelopeBytes else {
   705	      throw SSHProfileSnapshotLoaderError.profileOversize
   706	    }
   707	    do {
   708	      let envelope = try PropertyListSerialization.data(
   709	        fromPropertyList: propertyList,
   710	        format: .binary,
   711	        options: 0
   712	      )
   713	      guard envelope.count <= maximumEnvelopeBytes else {
   714	        throw SSHProfileSnapshotLoaderError.profileOversize
   715	      }
   716	    } catch let error as SSHProfileSnapshotLoaderError {
   717	      throw error
   718	    } catch {
   719	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   720	    }
   721	    return (try SSHProfileSnapshotCodec.decode(data), data)
   722	  }
   723	
   724	  private static func exactPropertyList(
   725	    _ configuration: [String: VPNProviderConfigurationValue]
   726	  ) throws -> [String: Any] {
   727	    let requiredKeys: Set<String> = [
   728	      OwnedVPNManagerRepository.ownerKey,
   729	      OwnedVPNManagerRepository.managerContractKey,
   730	      OwnedVPNManagerRepository.configurationReferenceKey,
   731	    ]
   732	    guard Set(configuration.keys) == requiredKeys,
   733	      configuration[OwnedVPNManagerRepository.ownerKey]
   734	        == .string(OwnedVPNManagerRepository.ownerValue)
   735	    else {
   736	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   737	    }
   738	    guard
   739	      case .integer(let managerVersion)? = configuration[
   740	        OwnedVPNManagerRepository.managerContractKey
   741	      ]
   742	    else {
   743	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   744	    }
   745	    guard managerVersion == OwnedVPNManagerRepository.managerContractVersion else {
   746	      throw SSHProfileSnapshotLoaderError.profileVersionUnsupported
   747	    }
   748	    guard
   749	      case .data(let data)? = configuration[
   750	        OwnedVPNManagerRepository.configurationReferenceKey
   751	      ]
   752	    else {
   753	      throw SSHProfileSnapshotLoaderError.profileCorrupt
   754	    }
   755	    return [
   756	      OwnedVPNManagerRepository.ownerKey: OwnedVPNManagerRepository.ownerValue,
   757	      OwnedVPNManagerRepository.managerContractKey: NSNumber(
   758	        value: OwnedVPNManagerRepository.managerContractVersion
   759	      ),
   760	      OwnedVPNManagerRepository.configurationReferenceKey: data,
   761	    ]
   762	  }
   763	}
   764	
   765	public struct SSHProfileSnapshotExpectation: Equatable, Sendable {
   766	  public let profileID: OpaqueProfileIdentifier
   767	  public let configurationGeneration: UInt64
   768	
   769	  public init(profileID: OpaqueProfileIdentifier, configurationGeneration: UInt64) {
   770	    self.profileID = profileID
   771	    self.configurationGeneration = configurationGeneration
   772	  }
   773	}
   774	
   775	/// A once-only, thread-safe capture for one provider runtime start.
   776	///
   777	/// Construct a fresh loader for each start. It never consults storage, performs
   778	/// credential work, or mutates a profile. Concurrent candidates race only for
   779	/// the first complete validated capture; all differing candidates fail closed.
   780	public final class SSHProfileRuntimeSnapshotLoader: @unchecked Sendable {
   781	  private struct Capture {
   782	    let data: Data
   783	    let snapshot: SSHProfileSnapshotV1
   784	  }
   785	
   786	  private let lock = NSLock()
   787	  private var capture: Capture?
   788	
   789	  public init() {}
   790	
   791	  public func capture(
   792	    from providerConfiguration: [String: VPNProviderConfigurationValue]?,
   793	    expectation: SSHProfileSnapshotExpectation? = nil
   794	  ) throws -> SSHProfileSnapshotV1 {
   795	    let candidate = try SSHProfileProviderConfigurationCodec.decodeCapture(
   796	      providerConfiguration
   797	    )
   798	    if let expectation {
   799	      guard candidate.snapshot.profileID == expectation.profileID,
   800	        candidate.snapshot.configurationGeneration == expectation.configurationGeneration
   801	      else {
   802	        throw SSHProfileSnapshotLoaderError.profileGenerationMismatch
   803	      }
   804	    }
   805	
   806	    return try lock.withLock {
   807	      if let capture {
   808	        guard capture.data == candidate.data else {
   809	          throw SSHProfileSnapshotLoaderError.profileGenerationMismatch
   810	        }
   811	        return capture.snapshot
   812	      }
   813	      let immutableCapture = Capture(data: candidate.data, snapshot: candidate.snapshot)
   814	      capture = immutableCapture
   815	      return immutableCapture.snapshot
   816	    }
   817	  }
   818	}
