+import re
+import stat
+import struct
+import sys
+import tarfile
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent.parent
+DEFAULT_CONTRACT = ROOT / "relay" / "asset-bundle-source-v1.json"
+DEFAULT_SCHEMA = ROOT / "relay" / "asset-manifest-v1.schema.json"
+DEFAULT_ARCHIVE = (
+    ROOT
+    / ".task-board"
