   453	private func fixture(
   454	  generation: UInt64 = 7,
   455	  account: String = "fixture-account",
   456	  host: SSHProfileCanonicalHost = .init(kind: .dns, value: "example.com")
   457	) -> SSHProfileSnapshotV1 {
   458	  let digest = Data(repeating: 0x01, count: 32).base64EncodedString().dropLast()
   459	  let record = SSHHostIdentityRecordV1(
   460	    algorithm: .sshEd25519,
   461	    fingerprintSHA256: SSHHostKeyFingerprint("SHA256:\(digest)"),
   462	    state: .approved,
   463	    provenance: .firstUseApproval,
   464	    firstSeenAt: SSHProfileTimestamp("2026-08-11T10:00:00.000Z"),
   465	    lastSeenAt: SSHProfileTimestamp("2026-08-11T10:00:01.000Z"),
   466	    approvedAt: SSHProfileTimestamp("2026-08-11T10:00:01.000Z"),
   467	    revokedAt: nil,
   468	    revocationReason: nil
   469	  )
   470	  return SSHProfileSnapshotV1(
   471	    configurationGeneration: generation,
   472	    profileID: OpaqueProfileIdentifier(
   473	      UUID(uuidString: "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa")!
   474	    ),
   475	    createdAt: SSHProfileTimestamp("2026-08-11T09:00:00.000Z"),
   476	    updatedAt: SSHProfileTimestamp("2026-08-11T10:00:01.000Z"),
   477	    displayName: "Fixture Profile",
   478	    canonicalHost: host,
   479	    port: 22,
   480	    account: account,
   481	    credential: SSHProfileCredentialReferenceV1(
   482	      reference: OpaqueCredentialReference(
   483	        UUID(uuidString: "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb")!
   484	      ),
   485	      generation: 3
   486	    ),
   487	    hostPolicy: SSHHostPolicyV1(
   488	      allowedAlgorithms: [.sshEd25519, .rsaSHA2256],
   489	      records: [record]
   490	    )
   491	  )
   492	}
   493	
   494	private func mutateJSON(
   495	  _ data: Data,
   496	  mutation: (inout [String: Any]) throws -> Void
   497	) throws -> Data {
   498	  var object = try #require(
   499	    JSONSerialization.jsonObject(with: data) as? [String: Any]
   500	  )
   501	  try mutation(&object)
   502	  return try JSONSerialization.data(
   503	    withJSONObject: object,
   504	    options: [.sortedKeys, .withoutEscapingSlashes]
   505	  )
   506	}
   507	
   508	private func mutatePolicy(
   509	  _ data: Data,
   510	  mutation: (inout [String: Any]) throws -> Void
   511	) throws -> Data {
   512	  try mutateJSON(data) { object in
   513	    var policy = try #require(object["hostPolicy"] as? [String: Any])
   514	    try mutation(&policy)
   515	    object["hostPolicy"] = policy
   516	  }
   517	}
   518	
   519	private func mutateFirstRecord(
   520	  _ data: Data,
   521	  mutation: (inout [String: Any]) throws -> Void
   522	) throws -> Data {
   523	  try mutatePolicy(data) { policy in
   524	    var records = try #require(policy["records"] as? [[String: Any]])
   525	    var first = try #require(records.first)
   526	    try mutation(&first)
   527	    records[0] = first
   528	    policy["records"] = records
   529	  }
   530	}
   531	
   532	private func containsData(_ value: Any) -> Bool {
   533	  if value is Data { return true }
   534	  return Mirror(reflecting: value).children.contains { containsData($0.value) }
   535	}
   536	
   537	private func platformValue(_ value: VPNProviderConfigurationValue) -> Any? {
   538	  switch value {
   539	  case .string(let value): value
   540	  case .integer(let value): NSNumber(value: value)
   541	  case .unsignedInteger(let value): NSNumber(value: value)
   542	  case .data(let value): value
   543	  case .unsupported: nil
   544	  }
   545	}

