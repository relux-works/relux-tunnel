run_step() {
  name=$1
  shift
  log="$logs/$name.log"
  printf 'RUN: %s\n' "$name" | tee -a "$summary"
  if "$@" >"$log" 2>&1; then
    printf 'PASS: %s (log: %s)\n' "$name" "${log#"$repo_root"/}" | tee -a "$summary"
  else
    status=$?
    printf 'FAIL: %s (exit %s; log: %s)\n' \
      "$name" "$status" "${log#"$repo_root"/}" | tee -a "$summary" >&2
    tail -n 80 "$log" >&2
    exit "$status"
  fi
}

