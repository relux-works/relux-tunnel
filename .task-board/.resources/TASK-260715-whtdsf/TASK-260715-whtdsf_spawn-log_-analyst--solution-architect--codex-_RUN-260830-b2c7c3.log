package cmd

import (
	"context"
	"errors"
	"fmt"
	"io/fs"
	"os"
	"strconv"
	"strings"

	"github.com/aagrigore/task-board/internal/changerequest"
	"github.com/aagrigore/task-board/internal/spawnruntime"
	"github.com/aagrigore/task-board/internal/worktree"
	"github.com/relux-works/skill-agent-facing-api/agentquery"
	pkgboard "github.com/relux-works/skill-project-management/pkg/board"
	"github.com/relux-works/skill-project-management/pkg/board/query"
	"github.com/relux-works/skill-project-management/pkg/remoteconfig"
)

// changeRequestMutations are the mutations whose persistence is local-only.
//
// §9.1 scopes the whole managed workspace path to a local authoritative board,
// and this is the list the CLI-side refusal is keyed to. It is a var so a test
// can assert the exact membership rather than restating it.
var changeRequestMutations = map[string]struct{}{
	"accept_cr": {},
}

// MutationRequiresLocalBoard reports whether a mutation name is one of the
// Change Request mutations that has no remote persistence path.
func MutationRequiresLocalBoard(name string) bool {
	_, ok := changeRequestMutations[strings.ToLower(strings.TrimSpace(name))]
	return ok
}

// rejectRemoteChangeRequestMutation is the §9.1 precondition on the accept_cr
// surface (design matrix row 13i).
//
// It runs in `m`'s validation phase, BEFORE the remote passthrough and before
// any local execution, so a refusal writes no CR record, uploads no diff
// resource, and mutates no element field. There is no remote Change Request
// persistence path: the record lives under the control root and the board-state
// commit it feeds has no referent on a server-side board.
func rejectRemoteChangeRequestMutation(ast *agentquery.Query) error {
	if ast == nil {
		return nil
	}
	named := ""
	for _, statement := range ast.Statements {
		if MutationRequiresLocalBoard(statement.Operation) {
			named = strings.ToLower(strings.TrimSpace(statement.Operation))
			break
		}
	}
	if named == "" {
		return nil
	}
	if err := requireWorktreeCapability(); err != nil {
		return fmt.Errorf("%s requires a local authoritative board: %w", named, err)
	}
	return nil
}

// RegisterChangeRequestMutations registers the Change Request mutations on a
// local schema.
//
// They live here rather than in pkg/board/query for a structural reason, not a
// stylistic one: the Change Request store is a control-root filesystem record,
// and pkg/board is the library board-server also links. Registering accept_cr
// there would put a mutation on the server's surface that the server cannot
// implement.
func RegisterChangeRequestMutations(s *agentquery.Schema[query.BoardItem]) {
	s.MutationWithMetadata("accept_cr", func(ctx agentquery.MutationContext[query.BoardItem]) (any, error) {
		return runAcceptChangeRequest(ctx)
	}, agentquery.MutationMetadata{
		Description: "Record an evidence-backed reviewer acceptance of a Change Request revision and park the element at to-review",
		Parameters: []agentquery.ParameterDef{
			{Name: "id", Type: "string", Required: true, Description: "Element ID carrying the Change Request"},
			{Name: "revision", Type: "int", Required: true, Description: "Change Request revision being accepted (expected-revision CAS)"},
			{Name: "evidence", Type: "string", Required: true, Description: "Task-scoped outcome resource name carrying the verdict evidence"},
			// There is deliberately no commit_ack parameter. A reviewer archetype
			// must not acknowledge a commit, and acceptance is not a done
			// transition: the element parks at to-review until the orchestrator
			// checkpoints or integrates it.
		},
		Examples: []string{
			"accept_cr(TASK-260803-323q82, revision=2, evidence=TASK-260803-323q82_review-verdict.md)",
		},
		Idempotent: false,
	})
}

func runAcceptChangeRequest(ctx agentquery.MutationContext[query.BoardItem]) (any, error) {
	// §9.1 again, at the mutation itself. The `m` command already refuses before
	// either transport; this second evaluation is what makes the refusal true of
	// the mutation rather than only of one command that happens to call it.
	if err := requireWorktreeCapability(); err != nil {
		return nil, fmt.Errorf("accept_cr requires a local authoritative board: %w", err)
	}

	// The reviewer commit_ack prohibition, stated as a refusal rather than left
	// to be silently ignored.
	//
	// The signature declares no commit_ack parameter, but the DSL validator does
	// not reject an unknown key on its own, so an argument the caller believes it
	// supplied would otherwise be dropped without a word. Acceptance is not a
	// done transition and never carries an acknowledgement: the element parks at
	// to-review and the orchestrator makes the done transition later.
	for key := range ctx.ArgMap {
		if strings.EqualFold(strings.TrimSpace(key), "commit_ack") {
			return nil, fmt.Errorf(
				"accept_cr does not accept commit_ack: acceptance parks the element at %s and the commit-owning mover supplies commit_ack=%s on the later done transition",
				pkgboard.StatusToReview, pkgboard.VersionControlCommitAcknowledgement)
		}
	}

	elementID := strings.TrimSpace(ctx.PositionalArg())
	if elementID == "" {
		elementID = strings.TrimSpace(ctx.ArgMap["id"])
	}
	if elementID == "" {
		return nil, fmt.Errorf("id is required")
	}
	revisionRaw := strings.TrimSpace(ctx.ArgMap["revision"])
	if revisionRaw == "" {
		return nil, fmt.Errorf("revision is required")
	}
	revision, err := strconv.Atoi(revisionRaw)
	if err != nil || revision <= 0 {
		return nil, fmt.Errorf("revision must be a positive integer, got %q", revisionRaw)
	}
	evidence := strings.TrimSpace(ctx.ArgMap["evidence"])
	if evidence == "" {
		return nil, fmt.Errorf("evidence is required")
	}

	// Who is calling.
	//
	// This runs before the CR store is read, before the evidence lookup, and
	// before any write, so an unauthorized caller leaves the record and the
	// element exactly as it found them.
	reviewerRunID, reviewerRun, err := requireReviewerAcceptanceAuthority(elementID, revision)
	if err != nil {
		return nil, err
	}

	controlRoot, err := worktreeControlRoot()
	if err != nil {
		return nil, err
	}
	crStore := changerequest.NewStore(controlRoot)
	record, err := crStore.Current(elementID)
	if err != nil {
		return nil, err
	}
	if record.Revision != revision {
		return nil, fmt.Errorf(
			"%s: expected revision %d, but the current Change Request revision is %d",
			changerequest.ErrorRevisionConflict, revision, record.Revision)
	}

	if err := requireChangeRequestEvidence(elementID, evidence, reviewerRun); err != nil {
		return nil, err
	}
	progress, err := store.ReadProgress(elementID)
	if err != nil {
		return nil, fmt.Errorf("reading %s progress to verify reviewer checklist gate: %w", elementID, err)
	}
	if _, _, err := pkgboard.ValidateChecklistGate(elementID, progress); err != nil {
		return nil, fmt.Errorf("accept_cr reviewer checklist gate: %w", err)
	}

	if ctx.DryRun {
		return map[string]any{
			"dry_run":  true,
			"id":       elementID,
			"revision": revision,
			"evidence": evidence,
			"status":   string(pkgboard.StatusToReview),
		}, nil
	}

	// Order matters, and it is the safe direction.
	//
	// The board status moves first. If the CR write then fails, the element is
	// parked at to-review with no accepted CR — and a reviewer run in that state
	// is still cancelled and respawned, which is a recoverable outcome. The
	// reverse order would leave an accepted CR whose element never left
	// `reviewing`, and the CR-first derivation would report an acceptance the
	// board does not show.
	activityStore, ok := any(store).(pkgboard.TransactionalActivityStore)
	if !ok {
		return nil, fmt.Errorf("accept_cr requires transactional activity support")
	}
	mutationContext, err := localActivityMutationContext(context.Background(), "cmd.runAcceptChangeRequest")
	if err != nil {
		return nil, fmt.Errorf("creating accept_cr activity context: %w", err)
	}
	var changes *pkgboard.ChangeSet
	_, err = query.ExecuteActivityDomainMutation(context.Background(), activityStore, mutationContext, []pkgboard.ActivityMutationHint{{
		ElementID: elementID, Operation: pkgboard.ActivityOperationProgress,
	}}, func(transactionStore pkgboard.DataStore) error {
		var mutationErr error
		changes, mutationErr = pkgboard.NewConsistencyService(transactionStore).SetStatusWithOptions(elementID, pkgboard.StatusToReview, pkgboard.StatusChangeOptions{})
		return mutationErr
	})
	if err != nil {
		return nil, err
	}

	// The acceptance is recorded through the store's own Accept, not through a
	// Mutate body written here.
	//
	// §6.2's acceptance-invalidation gate and §6.1's base check both read
	// `reviewed_trunk_oid`, and a story_final acceptance is the only thing that
	// records it. Accept resolves it from the record's own base and CHECKS that
	// base is contained in trunk's history before stamping it, so the field is a
	// verified attestation rather than a copy — which is what a reviewer-supplied
	// or blindly-propagated value would be.
	trunkRef, err := acceptanceTrunkRef(controlRoot)
	if err != nil {
		return nil, err
	}
	accepted, err := crStore.Accept(changerequest.AcceptRequest{
		ElementID:        elementID,
		ExpectedRevision: revision,
		ReviewerRunID:    reviewerRunID,
		EvidenceResource: evidence,
		ControlRoot:      controlRoot,
		TrunkRef:         trunkRef,
	})
	if err != nil {
		return nil, err
	}

	result := map[string]any{
		"id":               elementID,
		"cr_id":            accepted.ID,
		"revision":         accepted.Revision,
		"cr_state":         string(accepted.State),
		"repository_delta": string(accepted.RepositoryDelta),
		"reviewer_run_id":  accepted.ReviewerRunID,
		"evidence":         evidence,
		"status":           string(pkgboard.StatusToReview),
		"next":             "the orchestrator checkpoints or integrates this accepted revision and then makes the done transition",
	}
	if changes != nil {
		result["primary"] = map[string]any{
			"element_id": changes.Primary.ElementID,
			"action":     string(changes.Primary.Action),
			"field":      changes.Primary.Field,
			"old_value":  changes.Primary.OldValue,
			"new_value":  changes.Primary.NewValue,
		}
	}
	return result, nil
}

// acceptanceTrunkRef resolves the trunk ref the reviewed base is checked
// against.
//
// It goes through worktree.ResolveTrunk — the same resolution provisioning and
// integration use — rather than reading a configured string directly, so the
// three cannot disagree about which branch trunk is. An ambiguous or unreadable
// resolution refuses the acceptance: an attestation that cannot name the trunk
// it is about cannot be checked, and an unchecked one is what this path exists
// to stop being.
func acceptanceTrunkRef(controlRoot string) (string, error) {
	configured := remoteconfig.ResolveSpawnWorktreeIsolation(
		remoteconfig.NewSidecarSpawnProvider(remoteconfig.DefaultToolName)).IntegrationBaseBranch
	trunk, err := worktree.ResolveTrunk(worktreeGitRunner(), controlRoot, configured)
	if err != nil {
		return "", fmt.Errorf("accept_cr could not resolve the trunk branch to check the reviewed base against: %w", err)
	}
	return trunk.Ref, nil
}

// requireReviewerAcceptanceAuthority answers the question accept_cr used to
// skip entirely: who is calling.
//
// The evidence gate below proves that *a* task-scoped outcome resource with the
// named name exists on the element. It cannot tell a reviewer's verdict from the
// producer's own `_results.md`, so without this the producer that wrote the
// candidate could accept it, stamp its own run id as `reviewer_run_id`, and then
// have `worktree checkpoint` close the leaf as done with
// commit_ack=scope_committed — the checkpoint's sole authorization is the
// accepted CR record.
//
// The rule is the symmetric twin of rejectReviewerCommitAcknowledgement: resolve
// the caller's tracked run, load its manifest, verify the manifest's identity,
// and read the archetype. The polarity is what differs, and it decides how
// absence is handled. That guard FORBIDS, so "no tracked run" means there is no
// reviewer to forbid and it passes. This one AUTHORIZES, so "no tracked run"
// means nobody authorized anything and it refuses. Every indeterminate answer —
// unresolvable control root, unreadable manifest, mismatched identity — refuses
// for the same reason: a failure to read is not a fact about the caller.
//
// The revision binding is the second half. A reviewer run carries the revision
// it was launched against (spawn_workspace.go's resolveReviewerChangeRequest

diff --git a/.temp/TASK-260715-whtdsf/check-contract.sh b/.temp/TASK-260715-whtdsf/check-contract.sh
