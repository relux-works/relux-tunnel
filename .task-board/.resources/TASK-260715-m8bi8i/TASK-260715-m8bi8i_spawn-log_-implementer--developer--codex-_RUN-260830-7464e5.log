+    let consumer = M1HarnessDNSConsumer(
+      session: session,
+      generation: runtimeGeneration,
+      healthSink: healthSink,
+      probe: probe,
+      recorder: recorder
+    )
+    probe.setDNSConsumer(consumer)
+    return consumer
+  }
