+  ) {
+    guard let generation, cleanupGeneration == generation else { return }
+    activeGeneration = nil
+    cleanupTask = nil
+    cleanupGeneration = nil
+    phase = keepStoppingAfterCleanup ? .stopping : .idle
+  }
