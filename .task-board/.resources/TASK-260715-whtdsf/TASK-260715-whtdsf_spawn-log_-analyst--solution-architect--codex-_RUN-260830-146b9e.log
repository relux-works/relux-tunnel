+#!/bin/sh
+set -eu
+
+source_doc=docs/TASK-260715-whtdsf_ci-trust-and-quality-gate-contract.md
+run_dir=$(mktemp -d .temp/TASK-260715-whtdsf/negative-contract-rework6.XXXXXX)
+
+expect_rejected() {
+  fixture=$1
+  if CONTRACT_DOC="$fixture" .temp/TASK-260715-whtdsf/check-contract.sh > "$fixture.log" 2>&1; then
+    printf 'FAIL admitted=%s\n' "$fixture"
+    return 1
+  fi
+  printf 'PASS rejected=%s\n' "$fixture"
+}
+
+cp "$source_doc" "$run_dir/repository-dispatch.md"
+perl -pi -e 's/`issues: types: \[opened\]`/`repository_dispatch: types: [relux_release_request]`/' "$run_dir/repository-dispatch.md"
+expect_rejected "$run_dir/repository-dispatch.md"
+
+cp "$source_doc" "$run_dir/contents-write-requester.md"
+perl -pi -e 's/`Issues: write`/`Contents: write`/g' "$run_dir/contents-write-requester.md"
+expect_rejected "$run_dir/contents-write-requester.md"
+
+cp "$source_doc" "$run_dir/cross-row-same.md"
+perl -pi -e 'if (!$done && /^\| `policy\/github-actions`/) { s/\| Untrusted PR, merge-queue, or protected-branch exact event SHA from a clean checkout; checked-in workflows and CI policy \|/| Same |/; $done=1 }' "$run_dir/cross-row-same.md"
+expect_rejected "$run_dir/cross-row-same.md"
+
+cp "$source_doc" "$run_dir/missing-retention.md"
+perl -pi -e 'if (!$done && /^\| `policy\/github-actions`/) { s/; verification\/90d \|/ |/; $done=1 }' "$run_dir/missing-retention.md"
+expect_rejected "$run_dir/missing-retention.md"
+
+cp "$source_doc" "$run_dir/missing-network-capability.md"
+perl -pi -e 'if (!$done && /^\| `policy\/github-actions`/) { s/GitHub-hosted macOS public egress exists/Only checkout is authorized/; $done=1 }' "$run_dir/missing-network-capability.md"
+expect_rejected "$run_dir/missing-network-capability.md"
+
+printf 'negative_contract_fixtures=5 rejected=5\n'
