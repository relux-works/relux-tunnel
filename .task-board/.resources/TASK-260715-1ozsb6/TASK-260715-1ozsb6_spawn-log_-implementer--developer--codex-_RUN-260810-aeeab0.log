   642	    try checkCancellation(phase: phase)
   643	    let now = dependencies.clock.now()
   644	    guard now < deadline else { throw transportError(code: .timedOut, phase: phase) }
   645	    let remaining = now.duration(to: deadline)
   646	    if context.signatureIsPending() {
   647	      try await dependencies.clock.sleep(
   648	        for: min(remaining, LibSSH2AdapterConstants.minimumProgressDelay))
   649	      return
   650	    }
   651	    guard let connection, let engineSession else {
   652	      throw transportError(code: .connectionClosed, phase: phase)
   653	    }
   654	    let directions = libssh2_session_block_directions(engineSession)
   655	    var interests = Set<SSHTCPReadiness>()
   656	    if directions & LIBSSH2_SESSION_BLOCK_INBOUND != 0 { interests.insert(.readable) }
   657	    if directions & LIBSSH2_SESSION_BLOCK_OUTBOUND != 0 { interests.insert(.writable) }
   658	    if interests.isEmpty { interests = [.readable, .writable] }
   659	    let requestedInterests = interests
   660	    try await withTimeout(remaining, clock: dependencies.clock) {
   661	      try await self.context.network.service(
   662	        connection: connection,
   663	        interests: requestedInterests
   664	      )
   665	    }
   666	  }
   667	
   668	  private func startAutomaticTasks(configuration: SSHConnectionConfiguration) {
   669	    automaticRekeyTask = Task { [weak self, clock = dependencies.clock] in
   670	      while !Task.isCancelled {
   671	        do {
   672	          try await clock.sleep(for: configuration.rekey.elapsedTimeThreshold)
   673	          try await self?.requestRekey(reason: .timeThreshold)
   674	        } catch { return }
   675	      }
   676	    }
   677	    automaticKeepaliveTask = Task { [weak self, clock = dependencies.clock] in
   678	      while !Task.isCancelled {
   679	        do {
   680	          try await clock.sleep(for: configuration.keepalive.interval)
   681	          _ = try await self?.sendKeepalive()
   682	        } catch { return }
   683	      }
   684	    }
   685	  }
   686	
   687	  func channelRead(
   688	    identity: SSHChannelIdentity,
   689	    maximumBytes: Int,
   690	    stream: Int32
   691	  ) async throws -> Data? {
   692	    guard maximumBytes > 0 else {
   693	      throw transportError(
   694	        code: .invalidArgument,
   695	        phase: .channelRead,
   696	        scope: .channel(identity)
   697	      )
   698	    }
   699	    guard let record = channels[identity], !record.closed, let configuration else {
   700	      throw transportError(code: .channelClosed, phase: .channelRead, scope: .channel(identity))
   701	    }
   702	    let count = min(maximumBytes, record.policy.maximumBufferedReadBytes)
   703	    let deadline = dependencies.clock.now().advanced(by: configuration.timeouts.writeCreditWait)
   704	    while true {
   705	      try checkCancellation(phase: .channelRead)
   706	      var data = Data(count: count)
   707	      let result = data.withUnsafeMutableBytes { bytes in
   708	        libssh2_channel_read_ex(
   709	          record.pointer,
   710	          stream,
   711	          bytes.bindMemory(to: CChar.self).baseAddress,
   712	          bytes.count
   713	        )
   714	      }
   715	      if result > 0 {
   716	        data.removeSubrange(Int(result)..<data.count)
   717	        counters.payloadBytesReceived += UInt64(result)
   718	        await metric(.increment(.payloadBytesReceived, by: UInt64(result)))
   719	        await reconcileProtectedMetrics()
   720	        scheduleByteRekeyIfNeeded()
   721	        return data
   722	      }
   723	      if result == 0, libssh2_channel_eof(record.pointer) != 0 {
   724	        await emit(.channelEOF(channel: identity, direction: .remoteRead))
   725	        return nil
   726	      }
   727	      guard result == LIBSSH2_ERROR_EAGAIN || result == 0 else {
   728	        throw engineError(
   729	          Int32(result),
   730	          phase: .channelRead,
   731	          fallback: .connectionLost
   732	        )
   733	      }
   734	      try await progress(until: deadline, phase: .channelRead)
   735	    }
   736	  }
   737	
   738	  func channelWrite(identity: SSHChannelIdentity, bytes: Data) async throws -> Int {
   739	    guard !bytes.isEmpty else {
   740	      throw transportError(code: .invalidArgument, phase: .channelWrite, scope: .channel(identity))
   741	    }
   742	    guard let record = channels[identity], !record.closed, !record.writeEOF,
   743	      let configuration
   744	    else {
   745	      throw transportError(code: .writeAfterEOF, phase: .channelWrite, scope: .channel(identity))
   746	    }
   747	    let acceptedPrefix = min(
   748	      bytes.count,
   749	      record.policy.maximumWriteCallBytes,
   750	      record.policy.maximumQueuedWriteBytes
   751	    )
   752	    let deadline = dependencies.clock.now().advanced(by: configuration.timeouts.writeCreditWait)
   753	    while true {
   754	      try checkCancellation(phase: .channelWrite)
   755	      let result = bytes.withUnsafeBytes { raw in
   756	        libssh2_channel_write_ex(
   757	          record.pointer,
   758	          0,
   759	          raw.bindMemory(to: CChar.self).baseAddress,
   760	          acceptedPrefix
   761	        )
   762	      }
   763	      if result > 0 {
   764	        counters.payloadBytesSent += UInt64(result)
   765	        await metric(.increment(.payloadBytesSent, by: UInt64(result)))
   766	        await reconcileProtectedMetrics()
   767	        scheduleByteRekeyIfNeeded()
   768	        return result
   769	      }
   770	      guard result == LIBSSH2_ERROR_EAGAIN else {
   771	        throw engineError(Int32(result), phase: .channelWrite, fallback: .connectionLost)
   772	      }
   773	      counters.writeBackpressureWaits += 1
   774	      await metric(.increment(.writeBackpressureWaits, by: 1))
   775	      await emit(.writeBackpressureBegan(identity))
   776	      let started = dependencies.clock.now()
   777	      try await progress(until: deadline, phase: .channelWrite)
   778	      await emit(
   779	        .writeBackpressureEnded(
   780	          channel: identity,
   781	          waitDuration: started.duration(to: dependencies.clock.now())
   782	        )
   783	      )
   784	    }
   785	  }
   786	
   787	  func channelFinishWriting(identity: SSHChannelIdentity) async throws {
   788	    guard var record = channels[identity], !record.closed, let configuration else {
   789	      throw transportError(code: .channelClosed, phase: .channelEOF, scope: .channel(identity))
   790	    }
   791	    if record.writeEOF { return }
   792	    let deadline = dependencies.clock.now().advanced(by: configuration.timeouts.channelClose)
   793	    while true {
   794	      let result = libssh2_channel_send_eof(record.pointer)
   795	      if result == 0 { break }
   796	      guard result == LIBSSH2_ERROR_EAGAIN else {
   797	        throw engineError(result, phase: .channelEOF, fallback: .channelClosed)
   798	      }
   799	      try await progress(until: deadline, phase: .channelEOF)
   800	    }
   801	    record.writeEOF = true
   802	    channels[identity] = record
   803	    await emit(.channelEOF(channel: identity, direction: .localWrite))
   804	  }
   805	
   806	  func channelExit(identity: SSHChannelIdentity) async throws -> SSHExecExit {
   807	    guard let record = channels[identity], record.kind == .exec, let configuration else {
   808	      throw transportError(code: .invalidState, phase: .execExit, scope: .channel(identity))
   809	    }
   810	    let deadline = dependencies.clock.now().advanced(by: configuration.timeouts.execExit)
   811	    while libssh2_channel_eof(record.pointer) == 0 {
   812	      try await progress(until: deadline, phase: .execExit)
   813	    }
   814	
   815	    var signal: UnsafeMutablePointer<CChar>?
   816	    var signalLength = 0
   817	    let result = libssh2_channel_get_exit_signal(
   818	      record.pointer,
   819	      &signal,
   820	      &signalLength,
   821	      nil,
   822	      nil,
   823	      nil,
   824	      nil
   825	    )
   826	    guard result == 0 else { return .notReported }
   827	    guard let signal, signalLength > 0 else {
   828	      // libssh2 exposes status 0 without a presence bit. Returning it would
   829	      // fabricate the M3-deferred exact-exit semantic.
   830	      return .notReported
   831	    }
   832	    let name = Data(bytes: signal, count: signalLength).withUnsafeBytes {
   833	      String(decoding: $0.bindMemory(to: UInt8.self), as: UTF8.self)
   834	    }
   835	    if let engineSession { libssh2_free(engineSession, signal) }
   836	    return .signal(
   837	      SSHExecSignal(name: execSignalName(name), coreDumped: .unsupported)
   838	    )
   839	  }
