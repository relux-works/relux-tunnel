   399	private func expectHarnessOwnedResourcesReleased(
   400	  _ harness: RealHEVBridgeHarness,
   401	  descriptorBaseline: Int
   402	) async {
   403	  let released = await eventually {
   404	    await harness.ownedResourceSnapshot().allReleased
   405	  }
   406	  let resources = await harness.ownedResourceSnapshot()
   407	  let observedDescriptorCount = openDescriptorCount()
   408	  #expect(
   409	    released,
   410	    """
   411	    Harness-owned resources were not released: \(resources). Process-global descriptor \
   412	    diagnostics only: baseline=\(descriptorBaseline), observed=\(observedDescriptorCount), \
   413	    delta=\(observedDescriptorCount - descriptorBaseline).
   414	    """
   415	  )
   416	}
