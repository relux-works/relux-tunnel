diff --git a/.temp/TASK-260720-3vwls7/libssh2-a34302491c164d53c900fec9b3cbb050ecebe719/src/session.c b/.temp/TASK-260720-3vwls7/libssh2-a34302491c164d53c900fec9b3cbb050ecebe719/src/session.c
