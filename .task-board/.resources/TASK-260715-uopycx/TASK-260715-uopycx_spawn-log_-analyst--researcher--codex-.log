   471	    tcp_accept (tcp, tcp_accept_handler);
   472	
   473	    udp = udp_new_ip_type (IPADDR_TYPE_ANY);
   474	    udp_bind_netif (udp, &netif);
   475	    udp_bind (udp, NULL, 0);
   476	    udp_recv (udp, udp_recv_handler, NULL);
   477	
   478	    return 0;
   479	}
   480	
   481	static void
   482	gateway_fini (void)
   483	{
   484	    udp_remove (udp);
   485	    tcp_close (tcp);
   486	    netif_remove (&netif);
   487	}
   488	
   489	static int
   490	event_task_init (void)
   400	static int
   401	hev_config_parse_doc (yaml_document_t *doc)
   402	{
   403	    yaml_node_t *root;
   404	    yaml_node_pair_t *pair;
   405	    int min_task_stack_size;
   406	    int udp_buffer_size;
   407	
   408	    root = yaml_document_get_root_node (doc);
   409	    if (!root || YAML_MAPPING_NODE != root->type)
   410	        return -1;
   411	
   412	    for (pair = root->data.mapping.pairs.start;
   413	         pair < root->data.mapping.pairs.top; pair++) {
   414	        yaml_node_t *node;
   415	        const char *key;
   416	        int res = 0;
   417	
   418	        if (!pair->key || !pair->value)
   419	            break;
   420	
   421	        node = yaml_document_get_node (doc, pair->key);
   422	        if (!node || YAML_SCALAR_NODE != node->type)
   423	            break;
   424	
   425	        key = (const char *)node->data.scalar.value;
   426	        node = yaml_document_get_node (doc, pair->value);
   427	
   428	        if (0 == strcmp (key, "tunnel"))
   429	            res = hev_config_parse_tunnel (doc, node);
   430	        else if (0 == strcmp (key, "socks5"))
   431	            res = hev_config_parse_socks5 (doc, node);
   432	        else if (0 == strcmp (key, "mapdns"))
   433	            res = hev_config_parse_mapdns (doc, node);
   434	        else if (0 == strcmp (key, "misc"))
   435	            res = hev_config_parse_misc (doc, node);
   436	
   437	        if (res < 0)
   438	            return -1;
   439	    }
   440	
   441	    if (tcp_buffer_size > TCP_SND_BUF)
   442	        tcp_buffer_size = TCP_SND_BUF;
   443	
   444	    udp_buffer_size = UDP_BUF_SIZE * udp_copy_buffer_nums;
   445	
   446	    if (tcp_buffer_size > udp_buffer_size)
   447	        min_task_stack_size = TASK_STACK_SIZE + tcp_buffer_size;
   448	    else
   449	        min_task_stack_size = TASK_STACK_SIZE + udp_buffer_size;
   450	
   451	    if (task_stack_size < min_task_stack_size)
   452	        task_stack_size = min_task_stack_size;
   453	
   454	    return 0;
   455	}
