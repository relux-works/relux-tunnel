ilege":"non-root","secretReference":"lima-store://relux-m0-260715-39xz9g/user"},"opensshVersion":"OpenSSH_9.6p1","os":{"architecture":"aarch64","name":"Ubuntu","version":"24.04"},"reachability":"verified","userKeyTypes":["ssh-ed25519"]},{"configuration":{"alias":"relux","exposure":"existing owner-approved SSH configuration only","hostAddressRecorded":false,"userRecorded":false},"hostKeys":[{"fingerprintMode":"pre-auth-observed","fingerprintSHA256":"SHA256:0rW8XQXvHoWyOSnIAFaCT3NJmFRJF8khYQGdoZnvycg","type":"ssh-ed25519"},{"fingerprintMode":"pre-auth-observed","fingerprintSHA256":"SHA256:TLorKoiqGs1taG4Dyl2co80/DaahdKSs9Z2kJtyEVmg","type":"ecdsa-sha2-nistp256"},{"fingerprintMode":"pre-auth-observed","fingerprintSHA256":"SHA256:kKrHhGHo1ZSIck7qvp0POWPHUA2WLJNpvGCVIGpZHwc","type":"ssh-rsa"}],"id":"relux-real","identity":{"privilege":"non-root","secretReference":"ssh-config://relux"},"opensshVersion":"OpenSSH_9.9p2","os":{"architecture":"x86_64","name":"macOS","version":"runtime-current"},"reachability":"verified","userKeyTypes":["ssh-ed25519"]}],"taskId":"TASK-260715-39xz9g","teardown":{"evidence":"post-run absence of task VM, task sshd processes, listeners, private key files, and retained traffic payload","persistentRootService":false,"steps":["stop and delete only Lima instance relux-m0-260715-39xz9g","terminate only task-owned loopback sshd and endpoint processes","remove task-scoped ephemeral private keys and hashed known_hosts","retain only public fingerprints, non-secret configuration, counts, hashes, and secret-reference names"]},"traffic":{"blockBytes":1048576,"bytes":5368709120,"expectedSHA256":"SHA256:fc01cfd7aebf90ff9491f8556131b6ef575c3e1fa33a0277ba28920bbaee7f54","generator":"repeat one SHA-256 counter-expanded seed block and stream it","retainPayload":false,"seed":"TASK-260715-39xz9g"}}
