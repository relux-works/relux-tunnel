{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c45f","stream":{"kind":"session","id":"01a0aa7a-9815-7302-a96f-7a8fde67c84b"},"sequence":138,"recorded_at":1780531400000271,"record_type":"event","durability":"durable","causation_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","run_stream":{"kind":"run","id":"7cb39f37-e5ea-43fc-a612-eaf97474622d"},"task_stream":{"kind":"task","id":"01a0aa7a-e86c-79e3-8e79-61c5840c786e"},"task_id":"01a0aa7a-e86c-79e3-8e79-61c5840c786e","event":{"kind":"output","task_id":"01a0aa7a-e86c-79e3-8e79-61c5840c786e","chunk":"Read text file `Sources/ReluxTunnelCore/SSHBootstrapDiagnostics.swift`.\n1|import Darwin\n2|import Foundation\n3|\n4|/// The sole public error domain for profile-driven SSH bootstrap failures.\n5|public enum SSHBootstrapErrorDomain: String, Codable, Sendable {\n6|  case sshProfileBootstrap\n7|}\n8|\n9|/// Stable bootstrap stages. Values are diagnostic wire tokens and contain no instance data.\n10|public enum SSHBootstrapStage: String, Codable, CaseIterable, Sendable {\n11|  case profileLoad\n12|  case physicalPathResolution\n13|  case endpointConnect\n14|  case algorithmNegotiation\n15|  case hostVerification\n16|  case credentialAccess\n17|  case publicKeyAuthentication\n18|  case cancellation\n19|  case sessionClose\n20|}\n21|\n22|/// Stable public codes for the macOS profile-driven bootstrap boundary.\n23|///\n24|/// Raw engine, Network.framework, socket, Security.framework, and parser descriptions never\n25|/// cross this catalog. Integer values exposed through `NSError` are assigned by `providerCode`.\n26|public enum SSHBootstrapErrorCode: String, Codable, CaseIterable, Sendable {\n27|  case profileOversize\n28|  case profileCorrupt\n29|  case profileVersionUnsupported\n30|  case profileInvalidField\n31|  case profileGenerationMismatch\n32|  case profileContainsProhibitedField\n33|  case profilePublicationReconciliationRequired\n34|\n35|  case pathUnavailable\n36|  case endpointConnectFailed\n37|  case negotiationFailed\n38|\n39|  case hostTrustRequired\n40|  case hostKeyChanged\n41|  case hostKeyAlgorithmUnsupported\n42|  case hostIdentityRevoked\n43|  case hostPolicyRejected\n44|  case trustChallengeExpired\n45|  case trustChallengeMismatch\n46|  case trustHistoryFull\n47|\n48|  case credentialNotProvisioned\n49|  case credentialAccessDenied\n50|  case credentialGenerationMismatch\n51|  case credentialMalformed\n52|  case credentialPassphraseRequired\n53|  case credentialPassphraseInvalid\n54|  case credentialKeyUnsupported\n55|  case credentialMutationConflict\n56|  case credentialReferenceCollision\n57|  case credentialFormatRegistryUnavailable\n58|  case credentialReconciliationProfileSetUnavailable\n59|  case credentialReconciliationLimitExceeded\n60|  case credentialReconciliationFailed\n61|\n62|  case authenticationRejected\n63|  case operationCancelled\n64|  case userStopped\n65|  case operationTimedOut\n66|  case transportInterrupted\n67|  case sessionCloseFailed\n68|  case internalInvariant\n69|\n70|  /// Stable integer used when the error crosses an `NSError` provider boundary.\n71|  public var providerCode: Int {\n72|    switch self {\n73|    case .profileOversize: 1_001\n74|    case .profileCorrupt: 1_002\n75|    case .profileVersionUnsupported: 1_003\n76|    case .profileInvalidField: 1_004\n77|    case .profileGenerationMismatch: 1_005\n78|    case .profileContainsProhibitedField: 1_006\n79|    case .profilePublicationReconciliationRequired: 1_007\n80|    case .pathUnavailable: 2_001\n81|    case .endpointConnectFailed: 3_001\n82|    case .negotiationFailed: 4_001\n83|    case .hostTrustRequired: 5_001\n84|    case .hostKeyChanged: 5_002\n85|    case .hostKeyAlgorithmUnsupported: 5_003\n86|    case .hostIdentityRevoked: 5_004\n87|    case .hostPolicyRejected: 5_005\n88|    case .trustChallengeExpired: 5_006\n89|    case .trustChallengeMismatch: 5_007\n90|    case .trustHistoryFull: 5_008\n91|    case .credentialNotProvisioned: 6_001\n92|    case .credentialAccessDenied: 6_002\n93|    case .credentialGenerationMismatch: 6_003\n94|    case .credentialMalformed: 6_004\n95|    case .credentialPassphraseRequired: 6_005\n96|    case .credentialPassphraseInvalid: 6_006\n97|    case .credentialKeyUnsupported: 6_007\n98|    case .credentialMutationConflict: 6_008\n99|    case .credentialReferenceCollision: 6_009\n100|    case .credentialFormatRegistryUnavailable: 6_010\n101|    case .credentialReconciliationProfileSetUnavailable: 6_011\n102|    case .credentialReconciliationLimitExceeded: 6_012\n103|    case .credentialReconciliationFailed: 6_013\n104|    case .authenticationRejected: 7_001\n105|    case .operationCancelled: 8_001\n106|    case .userStopped: 8_002\n107|    case .operationTimedOut: 8_003\n108|    case .transportInterrupted: 8_004\n109|    case .sessionCloseFailed: 9_001\n110|    case .internalInvariant: 9_999\n111|    }\n112|  }\n113|}\n114|\n115|/// Finite user-action category. Presentation text belongs to a later UI task.\n116|public enum SSHBootstrapUserActionCategory: String, Codable, CaseIterable, Sendable {\n117|  case none\n118|  case retryLater\n119|  case reviewProfile\n120|  case checkNetwork\n121|  case approveHost\n122|  case replaceHostTrust\n123|  case reviewHostTrust\n124|  case restoreCredential\n125|  case reviewCredential\n126|  case contactSupport\n127|}\n128|\n129|/// Classification recorded for later lifecycle policy. This type does not perform a retry.\n130|public enum SSHBootstrapRetryDisposition: String, Codable, CaseIterable, Sendable {\n131|  case terminal\n132|  case retryableLater\n133|  case cancelled\n134|\n135|  public var isRetryable: Bool { self == .retryableLater }\n136|}\n137|\n138|/// Numeric endpoint family only; an address and port cannot be represented here.\n139|public enum SSHBootstrapEndpointFamily: String, Codable, CaseIterable, Sendable {\n140|  case ipv4\n141|  case ipv6\n142|\n143|  public init(_ family: SSHNetworkAddressFamily) {\n144|    self = family == .ipv4 ? .ipv4 : .ipv6\n145|  }\n146|}\n147|\n148|/// Reviewed algorithm context. Unknown or hostile algorithm names collapse to `unsupported`.\n149|public enum SSHBootstrapAlgorithmContext: String, Codable, CaseIterable, Sendable {\n150|  case sshEd25519 = \"ssh-ed25519\"\n151|  case ecdsaNISTP256 = \"ecdsa-sha2-nistp256\"\n152|  case ecdsaNISTP384 = \"ecdsa-sha2-nistp384\"\n153|  case ecdsaNISTP521 = \"ecdsa-sha2-nistp521\"\n154|  case rsaSHA2512 = \"rsa-sha2-512\"\n155|  case rsaSHA2256 = \"rsa-sha2-256\"\n156|  case unsupported\n157|\n158|  public init(hostKeyAlgorithm: String) {\n159|    self = Self(rawValue: hostKeyAlgorithm) ?? .unsupported\n160|  }\n161|\n162|  public init(_ algorithm: SSHHostKeyAlgorithm) {\n163|    self.init(hostKeyAlgorithm: algorithm.rawValue)\n164|  }\n165|}\n166|\n167|/// Bounded, non-identifying context allowed in provider diagnostics.\n168|public struct SSHBootstrapDiagnosticContext: Codable, Equatable, Sendable {\n169|  public let endpointFamily: SSHBootstrapEndpointFamily?\n170|  public let algorithm: SSHBootstrapAlgorithmContext?\n171|\n172|  public init(\n173|    endpointFamily: SSHBootstrapEndpointFamily? = nil,\n174|    algorithm: SSHBootstrapAlgorithmContext? = nil\n175|  ) {\n176|    self.endpointFamily = endpointFamily\n177|    self.algorithm = algorithm\n178|  }\n179|\n180|  public static let none = SSHBootstrapDiagnosticContext()\n181|}\n182|\n183|/// Privacy-safe snapshot projection. Its schema admits no underlying error or free-form string.\n184|public struct SSHBootstrapDiagnostic: Codable, Equatable, Sendable {\n185|  public let domain: SSHBootstrapErrorDomain\n186|  public let code: SSHBootstrapErrorCode\n187|  public let stage: SSHBootstrapStage\n188|  public let configurationGeneration: UInt64\n189|  public let userAction: SSHBootstrapUserActionCategory\n190|  public let retryDisposition: SSHBootstrapRetryDisposition\n191|  public let context: SSHBootstrapDiagnosticContext\n192|\n193|  public init(\n194|    code: SSHBootstrapErrorCode,\n195|    stage: SSHBootstrapStage,\n196|    configurationGeneration: UInt64,\n197|    userAction: SSHBootstrapUserActionCategory,\n198|    retryDisposition: SSHBootstrapRetryDisposition,\n199|    context: SSHBootstrapDiagnosticContext = .none\n200|  ) {\n201|    domain = .sshProfileBootstrap\n202|    self.code = code\n203|    self.stage = stage\n204|    self.configurationGeneration = configurationGeneration\n205|    self.userAction = userAction\n206|    self.retryDisposition = retryDisposition\n207|    self.context = context\n208|  }\n209|}\n210|\n211|/// Public provider error. The `NSError` bridge includes only stable finite fields.\n212|public struct SSHBootstrapProviderError: Error, Equatable, Sendable, CustomNSError,\n213|  CustomStringConvertible, CustomDebugStringConvertible\n214|{\n215|  public static let errorDomain = SSHBootstrapErrorDomain.sshProfileBootstrap.rawValue\n216|\n217|  public let diagnostic: SSHBootstrapDiagnostic\n218|\n219|  public init(diagnostic: SSHBootstrapDiagnostic) {\n220|    self.diagnostic = diagnostic\n221|  }\n222|\n223|  public var errorCode: Int { diagnostic.code.providerCode }\n224|\n225|  public var errorUserInfo: [String: Any] {\n226|    var result: [String: Any] = [\n227|      \"stage\": diagnostic.stage.rawValue,\n228|      \"code\": diagnostic.code.rawValue,\n229|      \"configurationGeneration\": diagnostic.configurationGeneration,\n230|      \"userAction\": diagnostic.userAction.rawValue,\n231|      \"retryDisposition\": diagnostic.retryDisposition.rawValue,\n232|    ]\n233|    if let endpointFamily = diagnostic.context.endpointFamily {\n234|      result[\"endpointFamily\"] = endpointFamily.rawValue\n235|    }\n236|    if let algorithm = diagnostic.context.algorithm {\n237|      result[\"algorithm\"] = algorithm.rawValue\n238|    }\n239|    return result\n240|  }\n241|\n242|  public var description: String {\n243|    \"\\(Self.errorDomain).\\(diagnostic.code.rawValue)\"\n244|  }\n245|\n246|  public var debugDescription: String { description }\n247|}\n248|\n249|/// Typed, privacy-safe platform transport causes retained behind the public projection.\n250|public enum SSHBootstrapTransportCause: Hashable, Sendable {\n251|  case unavailable\n252|  case timedOut\n253|  case connectionRefused\n254|  case connectionReset\n255|  case connectionAborted\n256|  case temporaryResourceExhaustion\n257|  case cancelled\n258|  case unexpected\n259|}\n260|\n261|public enum SSHBootstrapHostCause: Equatable, Sendable {\n262|  case trustRequired\n263|  case changed\n264|  case algorithmUnsupported\n265|  case revoked\n266|  case policyRejected\n267|}\n268|\n269|public enum SSHBootstrapCredentialCause: Equatable, Sendable {\n270|  case notProvisioned\n271|  case accessDenied\n272|  case generationMismatch\n273|  case malformed\n274|  case passphraseRequired\n275|  case passphraseInvalid\n276|  case keyUnsupported\n277|  case mutationConflict\n278|  case referenceCollision\n279|  case formatRegistryUnavailable\n280|  case reconciliationProfileSetUnavailable\n281|  case reconciliationLimitExceeded\n282|  case reconciliationFailed\n283|}\n284|\n285|public enum SSHBootstrapAuthenticationCause: Equatable, Sendable {\n286|  case rejected\n287|  case methodUnavailable\n288|  case keyAlgorithmUnavailable\n289|  case signatureFailed\n290|}\n291|\n292|public enum SSHBootstrapCancellationCause: Equatable, Sendable {\n293|  case taskCancelled\n294|  case userStopped\n295|}\n296|\n297|public enum SSHBootstrapSessionCloseCause: Equatable, Sendable {\n298|  case timedOut\n299|  case transportFailure\n300|  case invariantViolation\n301|}\n302|\n303|/// Internal mapping evidence is deliberately typed and contains no source description.\n304|public enum SSHBootstrapInternalCause: Equatable, Sendable {\n305|  case profile(SSHProfileSnapshotLoaderError)\n306|  case physicalPath(SSHBootstrapTransportCause)\n307|  case endpointConnect(SSHBootstrapTransportCause)\n308|  case negotiation(SSHBootstrapTransportCause)\n309|  case host(SSHBootstrapHostCause)\n310|  case credential(SSHBootstrapCredentialCause)\n311|  case authentication(SSHBootstrapAuthenticationCause)\n312|  case cancellation(SSHBootstrapCancellationCause)\n313|  case operationTimedOut(SSHBootstrapStage)\n314|  case transportInterrupted(SSHBootstrapStage, SSHBootstrapTransportCause)\n315|  case sessionClose(SSHBootstrapSessionCloseCause)\n316|  case invariantViolation(SSHBootstrapStage)\n317|}\n318|\n319|/// Testable mapping result. Provider consumers should expose `providerError`, not `cause`.\n320|struct SSHBootstrapMappedFailure: Equatable, Sendable {\n321|  let cause: SSHBootstrapInternalCause\n322|  let providerError: SSHBootstrapProviderError\n323|}\n324|\n325|/// Stable bootstrap mapping. It classifies only; it never schedules a retry.\n326|public enum SSHBootstrapErrorMapper {\n327|  public static func profile(\n328|    _ error: SSHProfileSnapshotLoaderError,\n329|    configurationGeneration: UInt64 = 0\n330|  ) -> SSHBootstrapProviderError {\n331|    map(.profile(error), configurationGeneration: configurationGeneration).providerError\n332|  }\n333|\n334|  public static func transport(\n335|    _ error: SSHTransportError,\n336|    configurationGeneration: UInt64,\n337|    context: SSHBootstrapDiagnosticContext = .none\n338|  ) -> SSHBootstrapProviderError {\n339|    map(transportCause(error), configurationGeneration: configurationGeneration, context: context)\n340|      .providerError\n341|  }\n342|\n343|  /// Maps an untrusted platform error without retaining its domain, userInfo, or description.\n344|  public static func transport(\n345|    _ error: any Error,\n346|    stage: SSHBootstrapStage,\n347|    configurationGeneration: UInt64,\n348|    context: SSHBootstrapDiagnosticContext = .none\n349|  ) -> SSHBootstrapProviderError {\n350|    let normalized: SSHBootstrapTransportCause\n351|    if error is CancellationError {\n352|      normalized = .cancelled\n353|    } else {\n354|      let nsError = error as NSError\n355|      if nsError.domain == NSPOSIXErrorDomain {\n356|        normalized = posixCause(Int32(clamping: nsError.code))\n357|      } else if nsError.domain == NSURLErrorDomain {\n358|        normalized = urlCause(nsError.code)\n359|      } else {\n360|        normalized = .unexpected\n361|      }\n362|    }\n363|    return transport(\n364|      normalized,\n365|      stage: stage,\n366|      configurationGeneration: configurationGeneration,\n367|      context: context\n368|    )\n369|  }\n370|\n371|  public static func transport(\n372|    posixCode: Int32,\n373|    stage: SSHBootstrapStage,\n374|    configurationGeneration: UInt64,\n375|    context: SSHBootstrapDiagnosticContext = .none\n376|  ) -> SSHBootstrapProviderError {\n377|    transport(\n378|      posixCause(posixCode),\n379|      stage: stage,\n380|      configurationGeneration: configurationGeneration,\n381|      context: context\n382|    )\n383|  }\n384|\n385|  public static func transport(\n386|    _ cause: SSHBootstrapTransportCause,\n387|    stage: SSHBootstrapStage,\n388|    configurationGeneration: UInt64,\n389|    context: SSHBootstrapDiagnosticContext = .none\n390|  ) -> SSHBootstrapProviderError {\n391|    let internalCause: SSHBootstrapInternalCause\n392|    switch stage {\n393|    case .physicalPathResolution:\n394|      internalCause = .physicalPath(cause)\n395|    case .endpointConnect:\n396|      internalCause = .endpointConnect(cause)\n397|    case .algorithmNegotiation:\n398|      internalCause = .negotiation(cause)\n399|    case .cancellation:\n400|      internalCause = .cancellation(.taskCancelled)\n401|    default:\n402|      internalCause = .invariantViolation(stage)\n403|    }\n404|    return map(\n405|      internalCause,\n406|      configurationGeneration: configurationGeneration,\n407|      context: context\n408|    ).providerError\n409|  }\n410|\n411|  public static func host(\n412|    _ cause: SSHBootstrapHostCause,\n413|    configurationGeneration: UInt64,\n414|    context: SSHBootstrapDiagnosticContext = .none\n415|  ) -> SSHBootstrapProviderError {\n416|    map(.host(cause), configurationGeneration: configurationGeneration, context: context)\n417|      .providerError\n418|  }\n419|\n420|  public static func credential(\n421|    _ cause: SSHBootstrapCredentialCause,\n422|    configurationGeneration: UInt64\n423|  ) -> SSHBootstrapProviderError {\n424|    map(.credential(cause), configurationGeneration: configurationGeneration).providerError\n425|  }\n426|\n427|  public static func authentication(\n428|    _ cause: SSHBootstrapAuthenticationCause,\n429|    configurationGeneration: UInt64,\n430|    context: SSHBootstrapDiagnosticContext = .none\n431|  ) -> SSHBootstrapProviderError {\n432|    map(\n433|      .authentication(cause),\n434|      configurationGeneration: configurationGeneration,\n435|      context: context\n436|    ).providerError\n437|  }\n438|\n439|  public static func cancellation(\n440|    _ cause: SSHBootstrapCancellationCause,\n441|    configurationGeneration: UInt64\n442|  ) -> SSHBootstrapProviderError {\n443|    map(.cancellation(cause), configurationGeneration: configurationGeneration).providerError\n444|  }\n445|\n446|  public static func sessionClose(\n447|    _ cause: SSHBootstrapSessionCloseCause,\n448|    configurationGeneration: UInt64\n449|  ) -> SSHBootstrapProviderError {\n450|    map(.sessionClose(cause), configurationGeneration: configurationGeneration).providerError\n451|  }\n452|\n453|  static func map(\n454|    _ cause: SSHBootstrapInternalCause,\n455|    configurationGeneration: UInt64,\n456|    context: SSHBootstrapDiagnosticContext = .none\n457|  ) -> SSHBootstrapMappedFailure {\n458|    let values = projection(for: cause)\n459|    return SSHBootstrapMappedFailure(\n460|      cause: cause,\n461|      providerError: SSHBootstrapProviderError(\n462|        diagnostic: SSHBootstrapDiagnostic(\n463|          code: values.code,\n464|          stage: values.stage,\n465|          configurationGeneration: configurationGeneration,\n466|          userAction: values.action,\n467|          retryDisposition: values.retry,\n468|          context: context\n469|        )\n470|      )\n471|    )\n472|  }\n473|\n474|  private static func projection(\n475|    for cause: SSHBootstrapInternalCause\n476|  ) -> (\n477|    code: SSHBootstrapErrorCode,\n478|    stage: SSHBootstrapStage,\n479|    action: SSHBootstrapUserActionCategory,\n480|    retry: SSHBootstrapRetryDisposition\n481|  ) {\n482|    switch cause {\n483|    case .profile(let error):\n484|      let code: SSHBootstrapErrorCode =\n485|        switch error {\n486|        case .profileOversize: .profileOversize\n487|        case .profileCorrupt: .profileCorrupt\n488|        case .profileVersionUnsupported: .profileVersionUnsupported\n489|        case .profileInvalidField: .profileInvalidField\n490|        case .profileGenerationMismatch: .profileGenerationMismatch\n491|        case .profileContainsProhibitedField: .profileContainsProhibitedField\n492|        }\n493|      return (code, .profileLoad, .reviewProfile, .terminal)\n494|\n495|    case .physicalPath(let cause):\n496|      return transportProjection(cause, stage: .physicalPathResolution)\n497|    case .endpointConnect(let cause):\n498|      return transportProjection(cause, stage: .endpointConnect)\n499|    case .negotiation(let cause):\n500|      return transportProjection(cause, stage: .algorithmNegotiation)\n(more lines below)","final_result":true}}}
