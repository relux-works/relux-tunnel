diff --git a/Tests/ReluxTunnelHarnessTests/DeterministicSessionFactoryTests.swift b/Tests/ReluxTunnelHarnessTests/DeterministicSessionFactoryTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..e3ac0d54fd7364c1f24dc4e0440e1209e6878ca2
