   374	private final class CompositionFactoryProbe: @unchecked Sendable {
   375	  private let lock = NSLock()
   376	  private var values: [String: Int] = [:]
   377	  private var transportBuffers: [Int] = []
   378	  private var receiveWindows: [Int] = []
   379	  private var capabilityChecks: [Bool] = []
   380	
   381	  var totalFactoryCalls: Int { lock.withLock { values.values.reduce(0, +) } }
   382	  var configurationSources: Int { count("configuration") }
   383	  var sshBootstraps: Int { count("ssh") }
   384	  var tcpFactories: Int { count("tcp") }
   385	  var dnsFactories: Int { count("dns") }
   386	  var privateIngressAdapters: Int { count("ingress") }
   387	  var settingsBuilders: Int { count("settingsBuilder") }
   388	  var settingsAppliers: Int { count("settingsApplier") }
   389	  var snapshotStores: Int { count("snapshot") }
   390	  var acceptedTransportBufferBytes: [Int] { lock.withLock { transportBuffers } }
   391	  var acceptedReceiveWindowBytes: [Int] { lock.withLock { receiveWindows } }
   392	  var selectedSSHCapabilityChecks: [Bool] { lock.withLock { capabilityChecks } }
   393	
   394	  func recordConfigurationSource() { increment("configuration") }
   395	  func recordTCPFactory() { increment("tcp") }
   396	  func recordDNSFactory() { increment("dns") }
   397	  func recordPrivateIngressAdapter() { increment("ingress") }
   398	  func recordSettingsBuilder() { increment("settingsBuilder") }
   399	  func recordSettingsApplier() { increment("settingsApplier") }
   400	  func recordSnapshotStore() { increment("snapshot") }
   401	
   402	  func recordSSH(
   403	    transportBufferBytes: Int,
   404	    receiveWindowBytes: Int,
   405	    selectedCapabilities: Bool
   406	  ) {
   407	    lock.withLock {
   408	      values["ssh", default: 0] += 1
   409	      transportBuffers.append(transportBufferBytes)
   410	      receiveWindows.append(receiveWindowBytes)
   411	      capabilityChecks.append(selectedCapabilities)
   412	    }
   413	  }
   414	
   415	  private func increment(_ key: String) {
   416	    lock.withLock { values[key, default: 0] += 1 }
   417	  }
   418	
   419	  private func count(_ key: String) -> Int {
   420	    lock.withLock { values[key, default: 0] }
   421	  }
   422	}
