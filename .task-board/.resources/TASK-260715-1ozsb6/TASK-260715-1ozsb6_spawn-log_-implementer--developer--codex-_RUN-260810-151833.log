   234	
   235	/// FIFO gate for libssh2 state machines stored on the shared session object.
   236	/// Channel payload I/O remains independently interleavable; channel opens,
   237	/// rekeys, and reply-requiring global requests hold one permit across EAGAIN.
   238	final class LibSSH2SessionOperationGate: @unchecked Sendable {
   239	  private struct Waiter {
   240	    let identifier: UUID
   241	    let continuation: CheckedContinuation<LibSSH2SessionOperationPermit, Error>
   242	  }
   243	
   244	  private let lock = NSLock()
   245	  private let maximumWaiters: Int
   246	  private var activeIdentifier: UUID?
   247	  private var waiters: [Waiter] = []
   248	  private var shutDown = false
   249	
   250	  init(maximumWaiters: Int) {
   251	    precondition(maximumWaiters > 0)
   252	    self.maximumWaiters = maximumWaiters
   253	  }
   254	
   255	  var pendingCount: Int {
   256	    lock.withLock { waiters.count + (activeIdentifier == nil ? 0 : 1) }
   257	  }
   258	
   259	  func acquire() async throws -> LibSSH2SessionOperationPermit {
   260	    let identifier = UUID()
   261	    return try await withTaskCancellationHandler {
   262	      try Task.checkCancellation()
   263	      let permit = try await withCheckedThrowingContinuation { continuation in
   264	        let immediate: Result<LibSSH2SessionOperationPermit, Error>? = lock.withLock {
   265	          if Task.isCancelled { return .failure(CancellationError()) }
   266	          if shutDown { return .failure(LibSSH2SessionOperationGateError.shutDown) }
   267	          if activeIdentifier == nil {
   268	            activeIdentifier = identifier
   269	            return .success(LibSSH2SessionOperationPermit(identifier: identifier))
   270	          }
   271	          guard waiters.count < maximumWaiters else {
   272	            return .failure(LibSSH2SessionOperationGateError.resourceLimitExceeded)
   273	          }
   274	          waiters.append(Waiter(identifier: identifier, continuation: continuation))
   275	          return nil
   276	        }
   277	        if let immediate { continuation.resume(with: immediate) }
   278	      }
   279	      try Task.checkCancellation()
   280	      return permit
   281	    } onCancel: {
   282	      self.cancelAcquisition(identifier: identifier)
   283	    }
   284	  }
   285	
   286	  func release(_ permit: LibSSH2SessionOperationPermit) {
   287	    let next: Waiter? = lock.withLock {
   288	      guard activeIdentifier == permit.identifier else { return nil }
   289	      guard !waiters.isEmpty, !shutDown else {
   290	        activeIdentifier = nil
   291	        return nil
   292	      }
   293	      let next = waiters.removeFirst()
   294	      activeIdentifier = next.identifier
   295	      return next
   296	    }
   297	    if let next {
   298	      next.continuation.resume(
   299	        returning: LibSSH2SessionOperationPermit(identifier: next.identifier))
   300	    }
   301	  }
   302	
   303	  func cancelPending() {
   304	    let cancelled: [Waiter] = lock.withLock {
   305	      shutDown = true
   306	      let cancelled = waiters
   307	      waiters.removeAll(keepingCapacity: false)
   308	      return cancelled
   309	    }
   310	    for waiter in cancelled {
   311	      waiter.continuation.resume(throwing: LibSSH2SessionOperationGateError.shutDown)
   312	    }
   313	  }
   314	
   315	  private func cancelAcquisition(identifier: UUID) {
   316	    let action: (cancelled: Waiter?, promoted: Waiter?) = lock.withLock {
   317	      if let index = waiters.firstIndex(where: { $0.identifier == identifier }) {
   318	        return (waiters.remove(at: index), nil)
   319	      }
   320	      guard activeIdentifier == identifier else { return (nil, nil) }
   321	      guard !waiters.isEmpty, !shutDown else {
   322	        activeIdentifier = nil
   323	        return (nil, nil)
   324	      }
   325	      let promoted = waiters.removeFirst()
   326	      activeIdentifier = promoted.identifier
   327	      return (nil, promoted)
   328	    }
   329	    action.cancelled?.continuation.resume(throwing: CancellationError())
   330	    if let promoted = action.promoted {
   331	      promoted.continuation.resume(
   332	        returning: LibSSH2SessionOperationPermit(identifier: promoted.identifier))
   333	    }
   334	  }
   335	}
