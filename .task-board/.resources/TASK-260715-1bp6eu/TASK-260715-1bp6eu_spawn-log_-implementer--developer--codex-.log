+    let reason = ProviderStopReason.apple(rawValue: rawReason, duringStartup: phase == .starting)
+    await performStop(reason: reason, gate: gate)
+  }
+
+  private func performStop(
+    reason: ProviderStopReason,
+    gate: ProviderOnceGate<Void>?
