let package = Package(
  name: "ReluxTunnel",
  platforms: [
    .iOS(.v18),
    .macOS(.v15),
  ],
  products: [
    .library(name: "ReluxAppleUITestShared", targets: ["ReluxAppleUITestShared"]),
