+  @Test("configuration replacement is monotonic and changes bounded history capacity")
+  func configurationReplacement() async throws {
+    let clock = ManualMemoryClock()
+    let service = ScriptedMemoryService(Array(repeating: sample(), count: 5))
+    let controller = MemoryWatermarkController(
+      configuration: try configuration(historyLimit: 4), platform: service, clock: clock)
+    _ = try observed(
+      await controller.observe(trigger: .admission, ledger: ledger(clock: clock)))
+
+    await #expect(
