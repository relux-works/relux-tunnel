   684	private final class RandomizedLocalByteStream: LocalNonblockingByteStream,
   685	  @unchecked Sendable
   686	{
   687	  private let lock = NSLock()
   688	  private let inbound: Data
   689	  private let readPressureInterval: Int
   690	  private let writePressureInterval: Int
   691	  private var generator: PumpLCG
   692	  private var readOffset = 0
   693	  private var output = Data()
   694	  private var readAttempts = 0
   695	  private var writeAttempts = 0
   696	  private var readPressureDelivered = false
   697	  private var writePressureDelivered = false
   698	  private var cancelled = false
   699	  private var largestReadRequest = 0
   700	
   701	  init(
   702	    inbound: Data,
   703	    seed: UInt64,
   704	    readPressureInterval: Int,
   705	    writePressureInterval: Int
   706	  ) {
   707	    self.inbound = inbound
   708	    generator = PumpLCG(state: seed)
   709	    self.readPressureInterval = readPressureInterval
   710	    self.writePressureInterval = writePressureInterval
   711	  }
   712	
   713	  var writtenBytes: Data { lock.withLock { output } }
   714	  var maximumReadRequest: Int { lock.withLock { largestReadRequest } }
   715	
   716	  func readSome(maximumBytes: Int) async throws -> LocalByteStreamReadResult {
   717	    try Task<Never, Never>.checkCancellation()
   718	    return lock.withLock {
   719	      if cancelled { return .endOfStream }
   720	      largestReadRequest = max(largestReadRequest, maximumBytes)
   721	      readAttempts += 1
   722	      if readPressureInterval > 0,
   723	        readAttempts.isMultiple(of: readPressureInterval),
   724	        !readPressureDelivered
   725	      {
   726	        readPressureDelivered = true
   727	        return .wouldBlock
   728	      }
   729	      readPressureDelivered = false
   730	      guard readOffset < inbound.count else { return .endOfStream }
   731	      let fragment = min(
   732	        maximumBytes,
   733	        min(inbound.count - readOffset, generator.nextInt(upperBound: 97) + 1)
   734	      )
   735	      let bytes = inbound[readOffset..<(readOffset + fragment)]
   736	      readOffset += fragment
   737	      return .bytes(bytes)
   738	    }
   739	  }
   740	
   741	  func writeSome(_ bytes: Data) async throws -> LocalByteStreamWriteResult {
   742	    try Task<Never, Never>.checkCancellation()
   743	    return lock.withLock {
   744	      if cancelled { return .peerClosed }
   745	      writeAttempts += 1
   746	      if writePressureInterval > 0,
   747	        writeAttempts.isMultiple(of: writePressureInterval),
   748	        !writePressureDelivered
   749	      {
   750	        writePressureDelivered = true
   751	        return .wouldBlock
   752	      }
   753	      writePressureDelivered = false
   754	      let count = min(bytes.count, generator.nextInt(upperBound: 83) + 1)
   755	      output.append(bytes.prefix(count))
   756	      return .written(count)
   757	    }
   758	  }
   759	
   760	  func waitForReadiness(_ readiness: LocalByteStreamReadiness) async throws
   761	    -> LocalByteStreamReadinessEvent
   762	  {
   763	    try Task<Never, Never>.checkCancellation()
   764	    await Task.yield()
   765	    try Task<Never, Never>.checkCancellation()
   766	    return lock.withLock { cancelled ? .peerClosed : .ready }
   767	  }
   768	
   769	  func cancelPendingOperations() {
   770	    lock.withLock { cancelled = true }
   771	  }
   772	}
   773	
   774	private final class RandomizedSSHByteChannel: SSHByteChannel, @unchecked Sendable {
   775	  let identity = SSHChannelIdentity(
   776	    rawValue: UUID(uuidString: "00000000-0000-0000-0000-000000000101")!)
   777	
   778	  private let lock = NSLock()
   779	  private let inbound: Data
   780	  private var generator: PumpLCG
   781	  private var readOffset = 0
   782	  private var output = Data()
   783	  private var cancelled = false
   784	  private var largestReadRequest = 0
   785	  private var largestWriteRequest = 0
   786	
   787	  init(inbound: Data, seed: UInt64) {
   788	    self.inbound = inbound
   789	    generator = PumpLCG(state: seed)
   790	  }
   791	
   792	  var writtenBytes: Data { lock.withLock { output } }
   793	  var maximumReadRequest: Int { lock.withLock { largestReadRequest } }
   794	  var maximumWriteRequest: Int { lock.withLock { largestWriteRequest } }
   795	
   796	  func read(maximumBytes: Int) async throws -> Data? {
   797	    try Task<Never, Never>.checkCancellation()
   798	    await Task.yield()
   799	    try Task<Never, Never>.checkCancellation()
   800	    return lock.withLock {
   801	      if cancelled { return nil }
   802	      largestReadRequest = max(largestReadRequest, maximumBytes)
   803	      guard readOffset < inbound.count else { return nil }
   804	      let fragment = min(
   805	        maximumBytes,
   806	        min(inbound.count - readOffset, generator.nextInt(upperBound: 89) + 1)
   807	      )
   808	      let bytes = inbound[readOffset..<(readOffset + fragment)]
   809	      readOffset += fragment
   810	      return bytes
   811	    }
   812	  }
   813	
   814	  func writeSome(_ bytes: Data) async throws -> Int {
   815	    try Task<Never, Never>.checkCancellation()
   816	    await Task.yield()
   817	    try Task<Never, Never>.checkCancellation()
   818	    return lock.withLock {
   819	      if cancelled { return 0 }
   820	      largestWriteRequest = max(largestWriteRequest, bytes.count)
   821	      let count = min(bytes.count, generator.nextInt(upperBound: 67) + 1)
   822	      output.append(bytes.prefix(count))
   823	      return count
