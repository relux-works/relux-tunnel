+    frameworks = target_phase(text, provider, "PBXFrameworksBuildPhase")
+    resources = target_phase(text, provider, "PBXResourcesBuildPhase")
+    require_phase_edge(
+        text,
+        frameworks,
+        "productRef",
+        "ReluxTunnelMacOSAdapter",
+        "Frameworks",
+    )
+    require_phase_edge(
+        text,
