+      return OwnershipConfigurationSource(
+        trace: trace,
+        configuration: runtimeConfiguration
+      )
+    },
+    makeSSHRuntimeServices: {
+      trace.record("ssh.services.create")
+      return MacOSProductionSSHRuntimeServices(
