  1169	      bytes: Array(data),
  1170	      maximumDepth: maximumDepth,
  1171	      requiresSortedKeys: requiresSortedKeys,
  1172	      allowsInsignificantWhitespace: allowsInsignificantWhitespace,
  1173	      requiresCanonicalStrings: requiresCanonicalStrings,
  1174	      requiresCanonicalNumbers: requiresCanonicalNumbers
  1175	    )
  1176	    return try parser.parseDocument()
  1177	  }
  1178	}
