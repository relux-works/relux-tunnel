    46	/// Public-API adapter for the macOS provider's `NEPacketTunnelFlow`.
    47	public final class MacOSPacketFlowAdapter: PacketFlow, @unchecked Sendable {
    48	  private let boundary: PacketFlowAdapterBoundary
    49	
    50	  public init(packetFlow: NEPacketTunnelFlow) {
    51	    boundary = PacketFlowAdapterBoundary(
    52	      driver: MacOSNEPacketFlowDriver(packetFlow: packetFlow)
    53	    )
    54	  }
    55	
    56	  public init(driver: any PacketFlowPlatformDriver) {
    57	    boundary = PacketFlowAdapterBoundary(driver: driver)
    58	  }
    59	
    60	  public func readPackets() async throws -> PacketReadBatch {
    61	    try await boundary.readPackets()
    62	  }
    63	
    64	  public func writePackets(_ packets: [TunnelPacket]) async throws {
    65	    try boundary.writePackets(packets)
    66	  }
    67	
    68	  public func shutdown() async {
    69	    boundary.shutDown()
    70	  }
    71	}
