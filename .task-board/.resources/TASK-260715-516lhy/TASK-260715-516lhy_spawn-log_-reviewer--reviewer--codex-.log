   431	
   432	func validateEnvelopeMetadata(
   433		metadata EnvelopeMetadata,
   434		negotiatedFeatures FeatureSet,
   435		validator EnvelopeMetadataValidator,
   436		phase CodecPhase,
   437	) *CodecError {
   438		if metadata.Flags&EnvelopeFlagsReservedMask != 0 {
   439			return codecFailure(CodecReservedFlags, phase)
   440		}
   441		if metadata.Flags != 0 && (metadata.Flags != EnvelopeFlagDNSPriority ||
   442			metadata.Type != MessageTypeUDPDatagram ||
   443			metadata.Direction != EnvelopeClientToRelay ||
   444			negotiatedFeatures&FeatureSetDNSPriorityHint == 0) {
   445			return codecFailure(CodecInvalidFlags, phase)
   446		}
   447		generated, ok := messageMetadata(metadata.Type)
   448		if !ok {
   449			return codecFailure(CodecUnknownMessageType, phase)
   450		}
   451		if generated.Direction == MessageDirectionClientToRelay && metadata.Direction != EnvelopeClientToRelay ||
   452			generated.Direction == MessageDirectionRelayToClient && metadata.Direction != EnvelopeRelayToClient {
   453			return codecFailure(CodecInvalidDirection, phase)
   454		}
   455		if generated.AssociationID == AssociationIDRuleZero && metadata.AssociationID != 0 ||
   456			generated.AssociationID == AssociationIDRuleNonzero && metadata.AssociationID == 0 {
   457			return codecFailure(CodecInvalidAssociationID, phase)
   458		}
   459		if generated.PayloadShape == PayloadShapeFixed && metadata.PayloadLength != generated.FixedPayloadWidth {
   460			return codecFailure(CodecInvalidPayloadLength, phase)
   461		}
   462		if validator != nil {
   463			if err := validator(metadata); err != nil {
   464				return codecFailure(CodecMetadataRejected, CodecPhaseMetadata)
   465			}
   466		}
   467		return nil
   468	}
   469	
   470	func messageMetadata(messageType MessageType) (MessageMetadata, bool) {
   471		for _, metadata := range MessageMetadataTable {
   472			if metadata.Type == messageType {
   473				return metadata, true
   474			}
   475		}
   476		return MessageMetadata{}, false
   477	}
   478	
   479	func validEnvelopeDirection(direction EnvelopeDirection) bool {
   480		return direction == EnvelopeClientToRelay || direction == EnvelopeRelayToClient
   481	}
