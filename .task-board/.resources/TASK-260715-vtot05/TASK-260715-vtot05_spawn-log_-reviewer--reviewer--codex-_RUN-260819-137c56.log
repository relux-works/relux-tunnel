   606	def build_manifest(contract: dict[str, Any], contents: list[bytes]) -> dict[str, Any]:
   607	    assets: list[dict[str, Any]] = []
   608	    for source, binary in zip(contract["assets"], contents, strict=True):
   609	        digest = sha256_bytes(binary)
   610	        identity = {
   611	            "schemaVersion": IDENTITY_SCHEMA_VERSION,
   612	            "relayProtocolVersion": contract["relayProtocolVersion"],
   613	            "relayVersion": contract["relayVersion"],
   614	            "sourceCommit": contract["sourceCommit"],
   615	            "os": source["os"],
   616	            "arch": source["arch"],
   617	            "selfSha256": digest,
   618	        }
   619	        assets.append(
   620	            {
   621	                "os": source["os"],
   622	                "arch": source["arch"],
   623	                "fileName": source["fileName"],
   624	                "bundleLocation": f"{contract['bundleSubdirectory']}/{source['fileName']}",
   625	                "byteSize": len(binary),
   626	                "sha256": digest,
   627	                "relayProtocolVersion": contract["relayProtocolVersion"],
   628	                "buildIdentity": identity,
   629	                "buildProvenanceReference": "#/buildProvenance",
   630	                "sourceProvenanceReference": "#/supplyChain",
   631	            }
   632	        )
   633	    return {
   634	        "schemaVersion": contract["manifestSchemaVersion"],
   635	        "relayProtocolVersion": contract["relayProtocolVersion"],
   636	        "buildProvenance": contract["buildProvenance"],
   637	        "supplyChain": contract["supplyChain"],
   638	        "assets": assets,
   639	    }
