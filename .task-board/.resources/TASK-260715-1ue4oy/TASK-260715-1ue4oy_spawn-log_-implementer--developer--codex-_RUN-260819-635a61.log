            os.fsync(parent_descriptor)
            if event_hook is not None:
                event_hook("after_exchange", bundle)
        finally:
            remove_owned_directory(staging, displaced_identity)
            os.fsync(parent_descriptor)
    finally:
        os.close(parent_descriptor)


