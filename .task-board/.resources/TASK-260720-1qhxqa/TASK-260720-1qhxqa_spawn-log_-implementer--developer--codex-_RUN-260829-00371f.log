+        "acceptedGraphRevision": "7dc73ac6e7325f86a4a178a0558619f0fc9d1490",
+        "generatedFilesSha256": "d5c5fd2899750f5b9e90de096e2b0552df22384a5ecbea793c0f19df630b7fc6"
+      },
+      "requiredCapabilities": [
+        "deterministic double generation",
