+  "$task_output/ReluxProxyMacTunnel-build-settings.log" >/dev/null
+
+arch=$(uname -m)
+python3 scripts/native-dependency-tool.py inspect-linked \
+  --binary "$release_provider_binary" \
+  --architectures "$arch"
+
 echo "macOS host/provider target validation passed"
