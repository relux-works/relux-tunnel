	--syft "$(RELAY_SYFT)" \
	--relay-version "$(RELAY_VERSION)" \
	--source-commit "$(SOURCE_COMMIT)" \
	--source-date-epoch "$(SOURCE_DATE_EPOCH)" \
	--require-provenance

RELAY_GO_ENV = \
	GOROOT="$(RELAY_GOROOT)" \
