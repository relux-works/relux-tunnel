import AppKit
import SwiftUI

struct MenuContentView: View {
    @ObservedObject var controller: TunnelController

    @AppStorage("sshHost") private var host = "relux"
    @AppStorage("sshAccount") private var account = "administrator"
    @AppStorage("localPort") private var localPort = 1_080

    private var configuration: TunnelConfiguration {
        TunnelConfiguration(host: host, account: account, localPort: localPort)
    }

    var body: some View {
        VStack(alignment: .leading, spacing: 14) {
            HStack(spacing: 10) {
                Image(systemName: controller.status.symbolName)
                    .font(.title2)
                    .foregroundStyle(statusColor)
                    .symbolEffect(.pulse, isActive: isTransitioning)

                VStack(alignment: .leading, spacing: 2) {
                    Text("Relux Proxy")
                        .font(.headline)
                    Text(controller.status.title)
                        .font(.subheadline)
                        .foregroundStyle(.secondary)
                }

                Spacer()
            }

            Divider()

            Grid(alignment: .leading, horizontalSpacing: 12, verticalSpacing: 10) {
                GridRow {
                    Text("SSH host")
                    TextField("relux", text: $host)
                        .textFieldStyle(.roundedBorder)
                }
                GridRow {
                    Text("Account")
                    TextField("administrator", text: $account)
                        .textFieldStyle(.roundedBorder)
                }
                GridRow {
                    Text("SOCKS port")
                    TextField("1080", value: $localPort, format: .number.grouping(.never))
                        .textFieldStyle(.roundedBorder)
                }
            }
            .disabled(controller.status.preventsEditing)

            HStack {
                Text("Proxy endpoint")
                    .foregroundStyle(.secondary)
                Spacer()
                Text(configuration.localEndpoint)
                    .font(.system(.body, design: .monospaced))
                    .textSelection(.enabled)
            }

            if case let .failed(message) = controller.status {
                Text(message)
                    .font(.caption)
                    .foregroundStyle(.red)
                    .fixedSize(horizontal: false, vertical: true)
            } else if let validationError = configuration.validationError {
                Text(validationError)
                    .font(.caption)
                    .foregroundStyle(.orange)
                    .fixedSize(horizontal: false, vertical: true)
            }

            Button(action: toggleConnection) {
                HStack {
                    Spacer()
                    Text(connectionButtonTitle)
                    Spacer()
                }
            }
            .buttonStyle(.borderedProminent)
            .controlSize(.large)
            .disabled(connectionButtonDisabled)

            Divider()

            HStack {
                Text("Firefox: SOCKS v5 + proxy DNS")
                    .font(.caption)
                    .foregroundStyle(.secondary)
                Spacer()
                Button("Quit") {
                    controller.shutdown()
                    NSApp.terminate(nil)
                }
                .keyboardShortcut("q")
            }
        }
        .padding(16)
        .frame(width: 360)
    }

    private var isTransitioning: Bool {
        controller.status == .connecting || controller.status == .disconnecting
    }

    private var statusColor: Color {
        switch controller.status {
        case .disconnected: .secondary
        case .connecting, .disconnecting: .orange
        case .connected: .green
        case .failed: .red
        }
    }

    private var connectionButtonTitle: String {
        switch controller.status {
        case .disconnected, .failed: "Connect"
        case .connecting: "Connecting…"
        case .connected: "Disconnect"
        case .disconnecting: "Disconnecting…"
        }
    }

    private var connectionButtonDisabled: Bool {
        switch controller.status {
        case .connecting, .disconnecting:
            true
        case .disconnected, .failed:
            configuration.validationError != nil
        case .connected:
            false
        }
    }

    private func toggleConnection() {
        if controller.status.isConnected {
            controller.disconnect()
        } else {
            controller.connect(configuration: configuration)
        }
    }
}
name: ci

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  macos:
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v7
      - name: Test
        run: swift test
      - name: Build universal app bundle
        env:
          SIGN_IDENTITY: "-"
        run: scripts/build-app.sh
name: release

on:
  push:
    tags: ["v*"]

permissions:
  contents: write
  id-token: write
  attestations: write

concurrency:
  group: release-${{ github.ref }}
  cancel-in-progress: false

jobs:
  notarized-dmg:
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0

      - name: Import Developer ID identity
        env:
          MACOS_CERT_P12: ${{ secrets.MACOS_CERT_P12 }}
        run: |
          echo "$MACOS_CERT_P12" | base64 --decode > /tmp/relux-devid.p12
          security create-keychain -p ci-temp ci.keychain
          security set-keychain-settings -lut 21600 ci.keychain
          security unlock-keychain -p ci-temp ci.keychain
          security import /tmp/relux-devid.p12 -k ci.keychain -P "" -T /usr/bin/codesign
          security set-key-partition-list -S apple-tool:,apple: -s -k ci-temp ci.keychain
          security list-keychains -d user -s ci.keychain login.keychain
          rm -f /tmp/relux-devid.p12

      - name: Build signed universal app
        env:
          VERSION: ${{ github.ref_name }}
          BUILD_NUMBER: ${{ github.run_number }}
          SIGN_IDENTITY: "Developer ID Application: Relux Works, LLC (262RZ595FP)"
        run: scripts/build-app.sh

      - name: Package and sign DMG
        env:
          VERSION: ${{ github.ref_name }}
        run: |
          scripts/create-dmg.sh
          codesign --force --sign "Developer ID Application: Relux Works, LLC (262RZ595FP)" \
            --timestamp dist/ReluxProxy-*.dmg

      - name: Notarize and staple
        env:
          ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
          ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
          ASC_KEY_P8: ${{ secrets.ASC_KEY_P8 }}
        run: |
          echo "$ASC_KEY_P8" | base64 --decode > /tmp/asc.p8
          xcrun notarytool submit dist/ReluxProxy-*.dmg \
            --key /tmp/asc.p8 \
            --key-id "$ASC_KEY_ID" \
            --issuer "$ASC_ISSUER_ID" \
            --wait
          rm -f /tmp/asc.p8
          xcrun stapler staple dist/ReluxProxy-*.dmg
          xcrun stapler validate dist/ReluxProxy-*.dmg
          spctl -a -t open --context context:primary-signature -v dist/ReluxProxy-*.dmg

      - name: Create stable latest asset and checksums
        run: |
          cp dist/ReluxProxy-*.dmg dist/ReluxProxy.dmg
          (cd dist && shasum -a 256 ReluxProxy-*.dmg ReluxProxy.dmg > SHA256SUMS)

      - name: Attest build provenance
        uses: actions/attest-build-provenance@v4
        with:
          subject-path: dist/ReluxProxy*.dmg

      - name: Publish GitHub release
        uses: softprops/action-gh-release@v3
        with:
          files: |
            dist/ReluxProxy-*.dmg
            dist/ReluxProxy.dmg
            dist/SHA256SUMS
          generate_release_notes: true
