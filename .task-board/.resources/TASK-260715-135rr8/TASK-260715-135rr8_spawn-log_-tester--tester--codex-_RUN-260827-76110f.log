  1111	private func measureRealHEVLifecycle(cycles: Int) async throws
  1112	  -> PhysicalMemoryLifecycleEvidence
  1113	{
  1114	  var acceptedSessions = 0
  1115	  var samples = preallocatedLifecycleSamples(cycles: cycles)
  1116	  let initial = try physicalProcessSnapshot()
  1117	
  1118	  for iteration in 0..<cycles {
  1119	    let descriptorBaseline = openDescriptorCount()
  1120	    let harness = RealHEVBridgeHarness(adapterMode: .stallAfterAuthentication)
  1121	    let handle = try await harness.start()
  1122	    try harness.driver.deliver(
  1123	      makeUDPPacket(
  1124	        family: .ipv4,
  1125	        source: Data([10, 43, UInt8(iteration / 250), UInt8(iteration % 250 + 1)]),
  1126	        destination: Data([192, 0, 2, 1]),
  1127	        sourcePort: UInt16(55_000 + iteration),
  1128	        destinationPort: 7,
  1129	        payload: Data([UInt8(truncatingIfNeeded: iteration)])
  1130	      )
  1131	    )
  1132	    #expect(
  1133	      await eventually(timeout: .seconds(3)) {
  1134	        harness.adapter.acceptedCount == 1
  1135	      },
  1136	      "cycle \(iteration) did not reach the real SOCKS boundary"
  1137	    )
  1138	    acceptedSessions += harness.adapter.acceptedCount
  1139	
  1140	    harness.adapter.closeAll()
  1141	    await harness.stop(handle)
  1142	    harness.driver.releaseLateRead()
  1143	    let driver = harness.driver.snapshot()
  1144	    let access = harness.accessRecorder.snapshot()
  1145	    let metrics = await harness.metrics.snapshot()
  1146	    #expect(driver.outstandingReadCount == 0)
  1147	    #expect(driver.queuedBatchCount == 0)
  1148	    #expect(harness.adapter.liveChannelCount == 0)
  1149	    #expect(access.starts == 1)
  1150	    #expect(access.stops == 1)
  1151	    #expect(metrics.counters["hev_start_total"] == 1)
  1152	    #expect(metrics.counters["hev_main_return_total"] == 1)
  1153	    #expect(await harness.bridge.lifecycleState() == .stopped(lastRunID: "integration-run-1"))
  1154	    let ownedResources = await expectHarnessOwnedResourcesReleased(
  1155	      harness,
  1156	      descriptorBaseline: descriptorBaseline
  1157	    )
  1158	    let process = try physicalProcessSnapshot()
  1159	    samples.append(
  1160	      PhysicalMemoryLifecycleSample(
  1161	        cycle: iteration + 1,
  1162	        descriptors: process.descriptors,
  1163	        processThreads: process.threads,
  1164	        physicalFootprintBytes: process.physicalFootprintBytes,
  1165	        liveHEVSessionsAfterCleanup: ownedResources.liveSOCKSChannels,
  1166	        outstandingReadsAfterCleanup: ownedResources.outstandingPacketReads,
  1167	        queuedBatchesAfterCleanup: ownedResources.queuedPacketBatches,
  1168	        boundaryStarts: ownedResources.boundaryStarts,
  1169	        boundaryStops: ownedResources.boundaryStops,
  1170	        hevStartTotal: metrics.counters["hev_start_total", default: 0],
  1171	        hevMainReturnTotal: metrics.counters["hev_main_return_total", default: 0],
  1172	        reachedHEVDescriptorClosed: ownedResources.reachedHEVDescriptorClosed,
  1173	        reachedBridgeDescriptorClosed: ownedResources.reachedBridgeDescriptorClosed,
  1174	        cleanupCloseErrors: ownedResources.cleanupCloseErrors,
  1175	        ownedResourcesReleased: ownedResources.allReleased
  1176	      )
  1177	    )
  1178	  }
  1179	
  1180	  let final = try physicalProcessSnapshot()
  1181	  let footprintAnalysis = analyzeLifecycleFootprint(
  1182	    samples.map(\.physicalFootprintBytes),
  1183	    warmupSampleCount: 10,
  1184	    convergencePolicy: .physicalHEVLifecycle
  1185	  )
  1186	  #expect(acceptedSessions == cycles)
  1187	  let ownedResourceReleaseFailureCycles = samples.compactMap {
  1188	    $0.ownedResourcesReleased ? nil : $0.cycle
  1189	  }
  1190	  let evidenceGatePassed = lifecycleEvidenceGatePassed(
  1191	    cycles: cycles,
  1192	    residentFootprintBoundObserved: footprintAnalysis.residentFootprintBoundObserved,
  1193	    ownedResourceReleaseFailureCycles: ownedResourceReleaseFailureCycles
  1194	  )
  1195	  let failureReason = evidenceGatePassed
  1196	    ? "none"
  1197	    : "lifecycle evidence gate failed: cycles=\(cycles)/\(footprintAnalysis.convergencePolicy.minimumSampleCount), resident-footprint-bound=\(footprintAnalysis.residentFootprintBoundObserved), post-warmup maximum drawup=\(footprintAnalysis.postWarmupMaximumDrawupBytes)/\(footprintAnalysis.convergencePolicy.absolutePostWarmupGrowthCeilingBytes), owned-resource-release failures=\(ownedResourceReleaseFailureCycles)"
  1198	  return PhysicalMemoryLifecycleEvidence(
  1199	    cycles: cycles,
  1200	    result:
  1201	      evidenceGatePassed
  1202	      ? "measured in this emitting process; every lifecycle-owned resource was released and resident physical-footprint drawup stayed within the fixed bound"
  1203	      : "measured in this emitting process; raw evidence was preserved before the lifecycle evidence gate failed",
  1204	    evidenceGatePassed: evidenceGatePassed,
  1205	    failureReason: failureReason,
  1206	    cancellationPoints:
  1207	      "covered by PacketFlowBridge lifecycle/fault suites at pre-borrow, active read, and stop",
  1208	    initialDescriptors: initial.descriptors,
  1209	    finalDescriptors: final.descriptors,
  1210	    initialThreads: initial.threads,
  1211	    finalThreads: final.threads,
  1212	    initialPhysicalFootprintBytes: initial.physicalFootprintBytes,
  1213	    finalPhysicalFootprintBytes: final.physicalFootprintBytes,
  1214	    warmupSampleCount: footprintAnalysis.warmupSampleCount,
  1215	    analyzedSampleCount: footprintAnalysis.analyzedSampleCount,

