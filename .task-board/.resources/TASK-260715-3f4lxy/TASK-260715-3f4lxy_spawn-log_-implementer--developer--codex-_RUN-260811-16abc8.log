+
+    for account in ["", " account", "account\n", String(repeating: "a", count: 65)] {
+      let data = try mutateJSON(validData) { object in object["account"] = account }
+      #expect(throws: SSHProfileSnapshotLoaderError.profileInvalidField(.account)) {
