    if case .startupFailed(let failure) = error as? TunnelRuntimeCoordinatorError {
      setFailure(failure)
      return error
    }
    let fallback = Self.error(domain: .runtimeInvariant, code: "startup_failed")
    setFailure(fallback)
    return TunnelRuntimeCoordinatorError.startupFailed(fallback)
  }

