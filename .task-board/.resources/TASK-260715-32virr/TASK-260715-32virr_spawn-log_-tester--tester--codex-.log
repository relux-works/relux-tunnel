   640	  private func requireMandatoryHealth() async throws {
   641	    let checks: [(TunnelRuntimeMandatoryComponent, any TunnelRuntimeHealthProviding)] = [
   642	      (.ssh, requireResource(sshSession)),
   643	      (.tcp, requireResource(tcpConsumer)),
   644	      (.dns, requireResource(dnsConsumer)),
   645	      (.packetPlane, requireResource(packetPlane)),
   646	    ]
   647	    for (component, provider) in checks {
   648	      let health = await provider.health()
   649	      try checkCancellationAndOwnership()
   650	      guard health == .healthy else {
   651	        throw TunnelRuntimeCoordinatorError.startupFailed(Self.healthFailure(for: component))
   652	      }
   653	    }
   654	  }
   655	
   656	  private func requireResource<T>(_ resource: T?) -> T {
   657	    guard let resource else {
   658	      preconditionFailure("Coordinator health check requested before acquisition")
   659	    }
   660	    return resource
   661	  }
   662	
   663	  private func mapped<T>(
   664	    fallback: RedactedRuntimeError,
   665	    operation: () async throws -> T
   666	  ) async throws -> T {
   667	    try checkCancellationAndOwnership()
   668	    do {
   669	      return try await operation()
   670	    } catch {
   671	      throw map(error, fallback: fallback)
   672	    }
   673	  }
   674	
   675	  private func map(_ error: any Error, fallback: RedactedRuntimeError) -> any Error {
   676	    if error is CancellationError {
   677	      return CancellationError()
   678	    }
   679	    if let error = error as? TunnelRuntimeCoordinatorError {
   680	      return error
   681	    }
   682	    return TunnelRuntimeCoordinatorError.startupFailed(fallback)
   683	  }
   684	
   685	  private func checkCancellationAndOwnership(allowUsable: Bool = false) throws {
   686	    try Task<Never, Never>.checkCancellation()
   687	    try environment.cancellation.checkCancellation()
   688	    let isOwnedState: Bool
   689	    switch state {
   690	    case .starting:
   691	      isOwnedState = true
   692	    case .usableTCPDNS:
   693	      isOwnedState = allowUsable
   694	    case .disconnected, .stopping, .failed:
   695	      isOwnedState = false
   696	    }
   697	    guard isOwnedState, termination == nil else {
   698	      throw CancellationError()
   699	    }
   700	  }
   701	
   702	  private func classifyStartupError(_ error: any Error) -> any Error {
   703	    if error is CancellationError {
   704	      if case .failed(let failure) = termination {
   705	        return TunnelRuntimeCoordinatorError.startupFailed(failure)
   706	      }
   707	      if termination == nil {
   708	        termination = .cancelled
   709	      }
   710	      return CancellationError()
   711	    }
   712	    if case .startupFailed(let failure) = error as? TunnelRuntimeCoordinatorError {
   713	      setFailure(failure)
   714	      return error
   715	    }
   716	    let fallback = Self.error(domain: .runtimeInvariant, code: "startup_failed")
   717	    setFailure(fallback)
   718	    return TunnelRuntimeCoordinatorError.startupFailed(fallback)
   719	  }
   720	
   721	  private func setFailure(_ failure: RedactedRuntimeError) {
   722	    if primaryFailure == nil {
   723	      primaryFailure = failure
   724	    }
   725	    if termination == nil {
   726	      termination = .failed(failure)
   727	    }
   728	  }
   729	
   730	  private func transitionToStopping() async {
   731	    guard state != .stopping, state != .disconnected, state != .failed else { return }
   732	    state = .stopping
   733	    await publishCurrentState()
   734	  }
