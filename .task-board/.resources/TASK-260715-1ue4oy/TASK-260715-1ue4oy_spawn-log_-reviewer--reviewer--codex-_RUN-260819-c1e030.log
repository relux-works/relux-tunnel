    destinations: [.mac],
    product: .unitTests,
    bundleId: "$(RELUX_MACOS_PROVIDER_BUNDLE_ID).tests",
    deploymentTargets: macOSDeploymentTargets,
    infoPlist: "Tests/ReluxProxyTargetContractSupport/Info.plist",
    sources: [
      "Tests/ReluxProxyMacTunnelTests/**",
