   609	
   610	int
   611	hev_socks5_tunnel_init (int tun_fd)
   612	{
   613	    int res;
   614	
   615	    LOG_D ("socks5 tunnel init");
   616	
   617	    res = tunnel_init (tun_fd);
   618	    if (res < 0)
   619	        goto exit;
   620	
   621	    res = gateway_init ();
   622	    if (res < 0)
   623	        goto exit;
   624	
   625	    res = event_task_init ();
   626	    if (res < 0)
   627	        goto exit;
   628	
   629	    res = lwip_io_task_init ();
   630	    if (res < 0)
   631	        goto exit;
   632	
   633	    res = lwip_timer_task_init ();
   634	    if (res < 0)
   635	        goto exit;
   636	
   637	    res = mapped_dns_init ();
   638	    if (res < 0)
   639	        goto exit;
   640	
   641	    signal (SIGPIPE, SIG_IGN);
   642	
   643	    hev_task_mutex_init (&mutex);
   644	
   645	    return 0;
   646	
   647	exit:
   648	    hev_socks5_tunnel_fini ();
   649	    return -1;
   650	}
   651	
   652	void
   653	hev_socks5_tunnel_fini (void)
   654	{
   655	    LOG_D ("socks5 tunnel fini");
   656	
   657	    mapped_dns_fini ();
   658	    lwip_timer_task_fini ();
   659	    lwip_io_task_fini ();
   660	    event_task_fini ();
   661	    gateway_fini ();
   662	    tunnel_fini ();
   663	
   664	    stat_tx_packets = 0;
   665	    stat_rx_packets = 0;
   666	    stat_tx_bytes = 0;
   667	    stat_rx_bytes = 0;
   668	}
   669	
   670	int
   671	hev_socks5_tunnel_run (void)
   672	{
   673	    LOG_D ("socks5 tunnel run");
   674	
   675	    task_event = hev_task_ref (task_event);
   676	    hev_task_run (task_event, event_task_entry, NULL);
   677	
   678	    task_lwip_io = hev_task_ref (task_lwip_io);
   679	    hev_task_run (task_lwip_io, lwip_io_task_entry, NULL);
   680	
   681	    task_lwip_timer = hev_task_ref (task_lwip_timer);
   682	    hev_task_run (task_lwip_timer, lwip_timer_task_entry, NULL);
   683	
   684	    run = 1;
   685	    hev_task_system_run ();
   686	
   687	    return 0;
   688	}
   689	
   690	void
   691	hev_socks5_tunnel_stop (void)
   692	{
   693	    int res = 0;
   694	    int fd;
   695	
   696	    LOG_D ("socks5 tunnel stop");
   697	
   698	    for (;;) {
   699	        fd = READ_ONCE (event_fds[1]);
   700	        if (fd >= 0)
   701	            break;
   702	        /* Wait for async initialization */
   703	        usleep (100 * 1000);
   704	    }
   705	
   706	    res = write (fd, &res, 1);
   707	    assert (res > 0 && "socks5 tunnel write event");
   708	}
