+  let fingerprint = SSHHostKeyFingerprint(
+    "SHA256:ungWv48Bz+pBQUDeXa4iI7ADYaOWF3qctBD/YfIAFa0"
+  )
+  return [
+    HostDecisionCase(
+      name: "acceptMatch",
+      decision: .acceptMatch(SSHTrustRecordReference(rawValue: "trust-record")),
+      isAccepted: true
+    ),
+    HostDecisionCase(
