+if rg -n '/Users/|/home/|file:///|BEGIN [A-Z ]*PRIVATE KEY|AKIA[0-9A-Z]{16}|tb_[A-Za-z0-9]{16,}|sk-[A-Za-z0-9]{16,}' "${privacy_targets[@]}"; then
