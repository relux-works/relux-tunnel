  2034	  private func execSignalName(_ value: String) -> SSHExecSignalName {
  2035	    switch value.uppercased() {
  2036	    case "HUP": .hangup
  2037	    case "INT": .interrupt
  2038	    case "QUIT": .quit
  2039	    case "ILL": .illegalInstruction
  2040	    case "ABRT": .abort
  2041	    case "FPE": .floatingPointException
  2042	    case "KILL": .kill
  2043	    case "SEGV": .segmentationFault
  2044	    case "PIPE": .pipe
  2045	    case "ALRM": .alarm
  2046	    case "TERM": .terminate
  2047	    default: .other(value)
  2048	    }
  2049	  }
