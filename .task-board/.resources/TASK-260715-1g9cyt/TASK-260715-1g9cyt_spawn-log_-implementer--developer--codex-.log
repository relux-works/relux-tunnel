+        "linkage": "static",
+        "artifact_path": "NativeDependencies/Artifacts/ReluxNativeFixture.xcframework",
+        "application_extension_api_only": true
+      },
+      "compiler": {
+        "tool": "xcrun --sdk <sdk> clang",
+        "common_c_flags": [
+          "-Os",
+          "-Wall",
+          "-Wextra",
+          "-Werror",
+          "-fapplication-extension",
+          "-ffunction-sections",
+          "-fdata-sections",
+          "-fno-common",
