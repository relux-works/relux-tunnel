+        "verify_command": "./scripts/native-dependency-tool.py verify --dependency relux-native-fixture"
+      },
+      "artifact": {
+        "file_sha256": {}
+      }
+    },
+    "hev-lwip": {
+      "revision": "ad7600497931205105b08367bd1b450048157e40",
+      "upstream": "https://github.com/heiher/hev-socks5-tunnel",
+      "source": {
+        "kind": "git_archive_with_submodules",
+        "sha256": "1d48d9b8a4dd5befc3460fda3ac4684149ace458c1630ca5f5692c9dc8dd154f",
+        "submodules": [
+          {"path": "src/core", "revision": "c234519072ff5b928b90b304da9a666bcb440455", "sha256": "4b17bed847de4336adad9961c1a6943ab4a4df670da057a12c50a0d06c3b2438"},
+          {"path": "third-part/hev-task-system", "revision": "b1afa0e21fb4ed5a69560e78e54baf0efdebe171", "sha256": "3e3ef1eaa15b151e48123e006a98ef9de134914488fb38bcc44626cd239ffe93"},
+          {"path": "third-part/lwip", "revision": "2a11c14c7a32887af25a034e82ef18b0b12076ac", "sha256": "3a2252de07e42d3e5d31d8af97005eb73d7f0ed7725d029f0025c99ab5a0497f"},
+          {"path": "third-part/yaml", "revision": "efa36117a8646d26d12b58e05bac472d7854a70d", "sha256": "b0f33a1062e687bef8f86d5e0690895e8e5f7f5fdeda285216a00bfcc5616334"}
+        ]
+      },
+      "integration": {
+        "swiftpm_kind": "binaryTarget",
+        "future_target_name": "CHevSocks5Tunnel",
+        "future_adapter_target": "ReluxTunnelHEVAdapter",
+        "linkage": "static",
+        "artifact_path": "NativeDependencies/Artifacts/HevSocks5Tunnel.xcframework",
+        "application_extension_api_only": true
+      },
+      "compiler": {
+        "source": "pinned upstream build-apple.sh",
+        "common_flags": ["-O3", "-pipe", "-Wall", "-Werror", "-DENABLE_LIBRARY"],
+        "slice_flags": "-arch <arch> -m<sdk>-version-min=<minimum>",
+        "linker_flags": "-arch <arch> -m<sdk>-version-min=<minimum> -Wl,-Bsymbolic-functions",
+        "required_slices": [
+          {"library_identifier": "ios-arm64", "platform": "ios", "minimum": "15.0", "architectures": ["arm64"]},
+          {"library_identifier": "ios-arm64_x86_64-simulator", "platform": "ios", "variant": "simulator", "minimum": "15.0", "architectures": ["arm64", "x86_64"]},
+          {"library_identifier": "macos-arm64_x86_64", "platform": "macos", "minimum": "10.14", "architectures": ["arm64", "x86_64"]}
+        ]
+      },
+      "license": {
+        "components": [
+          {"name": "hev-socks5-tunnel", "spdx": "MIT", "path": "LICENSE"},
+          {"name": "hev-socks5-core", "spdx": "MIT", "path": "src/core/LICENSE"},
+          {"name": "hev-task-system", "spdx": "MIT", "path": "third-part/hev-task-system/LICENSE"},
+          {"name": "lwIP", "spdx": "BSD-3-Clause", "path": "third-part/lwip/LICENSE"},
+          {"name": "yaml", "spdx": "MIT", "path": "third-part/yaml/License"}
+        ],
+        "notices_output": "NativeDependencies/Generated/HEV_THIRD_PARTY_NOTICES.txt"
+      },
+      "rebuild": {
+        "command": "./scripts/native-dependency-tool.py build-hev --source-dir <pinned-recursive-checkout> --output NativeDependencies/Artifacts/HevSocks5Tunnel.xcframework --notices NativeDependencies/Generated/HEV_THIRD_PARTY_NOTICES.txt",
+        "upstream_command": "./build-apple.sh",
+        "xcode_build": "17F42"
+      }
+    }
+  }
+}
