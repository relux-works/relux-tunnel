+python3 -W error::ResourceWarning -m unittest -v scripts/tests/test_relay_release.py
+python3 -m trace --count --missing --summary --coverdir .build/relay/TASK-260715-1q03sa/trace --module unittest scripts/tests/test_relay_release.py
