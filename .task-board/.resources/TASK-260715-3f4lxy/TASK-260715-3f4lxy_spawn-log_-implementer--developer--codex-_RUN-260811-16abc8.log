+    let canonicalHost = try validateHost(wire.canonicalHost)
+    guard (1...65_535).contains(wire.port), let port = UInt16(exactly: wire.port) else {
+      throw SSHProfileSnapshotLoaderError.profileInvalidField(.port)
+    }
