OPENSSH_SHA256_FINGERPRINT = re.compile(r"^SHA256:([A-Za-z0-9+/]{43})$")
SHA256_HEX_DIGEST = re.compile(r"^SHA256:[0-9a-f]{64}$")
SECRET_MARKERS = (
