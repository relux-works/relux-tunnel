+
+    switch site {
+    case .localReadable:
+      readBehavior = .wouldBlockStall
+      writeBehavior = .accept
+      channelRead = .eof
+      channelWrite = .accept
+      scheduler = nil
+    case .localWritable:
+      readBehavior = .eof
+      writeBehavior = .wouldBlockStall
+      channelRead = .oneChunkThenEOF(Data([1]))
+      channelWrite = .accept
+      scheduler = nil
