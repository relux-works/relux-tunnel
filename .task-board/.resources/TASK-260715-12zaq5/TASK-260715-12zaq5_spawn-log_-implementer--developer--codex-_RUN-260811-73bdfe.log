   455	extension SSHHostKeyDecision {
   456	  public var outcome: SSHHostDecisionOutcome {
   457	    switch self {
   458	    case .acceptMatch, .acceptApproved:
   459	      .matchAccepted
   460	    case .trustRequired:
   461	      .trustRequired
   462	    case .rejectChanged:
   463	      .changedRejected
   464	    case .rejectRevoked:
   465	      .revokedRejected
   466	    case .rejectAlgorithm:
   467	      .algorithmRejected
   468	    case .rejectHostMismatch:
   469	      .hostMismatchRejected
   470	    case .rejectMalformed:
   471	      .malformedRejected
   472	    case .rejectPolicy:
   473	      .policyRejected
   474	    }
   475	  }
   476	
   477	  public func acceptance(for input: SSHHostKeyPolicyInput) throws -> SSHHostKeyAcceptance {
   478	    switch self {
   479	    case .acceptMatch(let reference):
   480	      guard !reference.rawValue.isEmpty else {
   481	        throw SSHContractValidationError.empty(.trustRecordReference)
