+    exitCode = (error as? any HarnessExitCodeProvidingError)?.harnessExitCode ?? .failure
+  }
+}
+
 private enum HarnessRunEvent: Sendable {
   case commandSucceeded
-  case commandFailed(String)
+  case commandFailed(HarnessCommandFailure)
