+        selected,
+        ensure_ascii=False,
+        allow_nan=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    sys.stdout.buffer.write(serialized)
+except (DomainError, json.JSONDecodeError, KeyError, OSError, TypeError) as error:
