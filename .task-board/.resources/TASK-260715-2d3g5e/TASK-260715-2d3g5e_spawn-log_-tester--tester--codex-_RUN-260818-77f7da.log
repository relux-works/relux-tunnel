    }
    let deadline = dependencies.clock.now().advanced(by: timeout)
    while true {
      try checkCancellation(phase: .initialKeyExchange)
      let result = libssh2_session_handshake(engineSession, LibSSH2AdapterConstants.socketToken)
      if result == 0 {

