-        directoryDescriptor, component, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC
-      )
-      guard nextDescriptor >= 0 else { throw MTUMatrixError.unsafeOutputPath }
-      _ = Darwin.close(directoryDescriptor)
