+  public func retireAfterGracefulCleanup() {
+    lock.withLock {
+      state = .retired
+      handles.removeAll(keepingCapacity: false)
+    }
+  }
+
+  var registeredHandleCount: Int {
+    lock.withLock { handles.count }
+  }
+
+  private enum RegistrationAction {
+    case accepted
+    case cancelAndForceClose
+  }
+}
