+    capture_output=True,
+    text=True,
+).stdout.splitlines())
+assert actual == expected, sorted(actual ^ expected)
+print("relay metadata rotation: changed-files=10/10")
+PY
+  test "$(find .build/relay/relay-assets-v1 -type f | wc -l | tr -d ' ')" -eq 5
