+          try await self.clock.sleep(for: self.timeout)
+          outcome = .failure(LibSSH2TimeoutError.elapsed)
+        } catch {
+          outcome = .failure(error)
+        }
+        self.childCompleted(.timer, outcome: outcome)
+      }
