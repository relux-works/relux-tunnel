     1	import AppKit
     2	import Foundation
     3	import ReluxSnapshotDiffSupport
     4	import Testing
     5	
     6	@Suite("Snapshot failure artifacts")
     7	struct SnapshotDiffSupportTests {
     8	  @Test("mismatch writes reference failed and visual diff images")
     9	  func mismatchArtifacts() throws {
    10	    let root = FileManager.default.temporaryDirectory
    11	      .appendingPathComponent("relux-snapshot-diff-\(UUID().uuidString)")
    12	    defer { try? FileManager.default.removeItem(at: root) }
    13	    try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)
    14	    let reference = root.appendingPathComponent("expected.png")
    15	    let failed = root.appendingPathComponent("actual.png")
    16	    try png(color: NSColor(deviceRed: 0, green: 0, blue: 1, alpha: 1)).write(to: reference)
    17	    try png(color: NSColor(deviceRed: 1, green: 0, blue: 0, alpha: 1)).write(to: failed)
    18	
    19	    let output = root.appendingPathComponent("artifacts")
    20	    #expect(
    21	      try !SnapshotDiff.compare(reference: reference, failed: failed, outputDirectory: output))
    22	    for name in ["reference.png", "failed.png", "diff.png"] {
    23	      #expect(FileManager.default.fileExists(atPath: output.appendingPathComponent(name).path))
    24	    }
    25	  }
    26	
    27	  private func png(color: NSColor) throws -> Data {
    28	    let image = NSImage(size: NSSize(width: 2, height: 2))
    29	    image.lockFocus()
    30	    color.setFill()
    31	    NSRect(x: 0, y: 0, width: 2, height: 2).fill()
    32	    image.unlockFocus()
    33	    guard
    34	      let tiff = image.tiffRepresentation,
    35	      let bitmap = NSBitmapImageRep(data: tiff),
    36	      let data = bitmap.representation(using: .png, properties: [:])
    37	    else {
    38	      throw SnapshotDiffError.cannotEncodePNG
    39	    }
    40	    return data
    41	  }
    42	}

