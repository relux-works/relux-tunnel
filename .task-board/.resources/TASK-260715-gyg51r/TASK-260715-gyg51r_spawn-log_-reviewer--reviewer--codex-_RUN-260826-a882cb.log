    guard currentFlags >= 0, Darwin.fcntl(receiver, F_SETFL, currentFlags | O_NONBLOCK) == 0 else {
      throw socketError("fcntl nonblocking")
    }
    if pressure == .mixed {
      let senderFlags = Darwin.fcntl(sender, F_GETFL)
