   698	  private func validateAlgorithmPolicy(_ policy: SSHAlgorithmPolicy) throws {
   699	    let capabilities = LibSSH2TransportFactory().capabilities
   700	    guard Set(policy.keyExchange).isSubset(of: capabilities.keyExchangeAlgorithms),
   701	      Set(policy.hostKey).isSubset(of: capabilities.hostKeyAlgorithms),
