   506	  private static func validateHost(
   507	    _ wire: SSHProfileCanonicalHostWire
   508	  ) throws -> SSHProfileCanonicalHost {
   509	    guard let kind = SSHProfileHostKind(rawValue: wire.kind) else {
   510	      throw SSHProfileSnapshotLoaderError.profileInvalidField(.canonicalHost)
   511	    }
   512	    let value = wire.value
   513	    guard !value.isEmpty,
   514	      value == value.trimmingCharacters(in: CharacterSet(charactersIn: " \t\r\n")),
