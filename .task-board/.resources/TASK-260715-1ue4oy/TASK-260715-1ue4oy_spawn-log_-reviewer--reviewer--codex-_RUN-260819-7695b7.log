   400	def read_archive_assets(archive: Path, contract: dict[str, Any]) -> list[bytes]:
   401	    provenance = validate_provenance(contract["buildProvenance"])
   402	    if sha256_file(archive) != provenance["archiveSHA256"]:
   403	        raise AssetManifestError("trusted relay archive checksum mismatch")
   404	    try:
   405	        with tarfile.open(archive, mode="r:gz") as bundle:
   406	            members = bundle.getmembers()
   407	            names = [member.name for member in members]
   408	            expected_names = [asset["archivePath"] for asset in contract["assets"]]
   409	            if names != expected_names or len(set(names)) != len(names):
   410	                raise AssetManifestError(
   411	                    "trusted relay archive member set or order changed"
   412	                )
   413	            contents_by_target: list[bytes] = []
   414	            for member, asset in zip(members, contract["assets"], strict=True):
   415	                if (
   416	                    not member.isfile()
   417	                    or member.issym()
   418	                    or member.islnk()
   419	                    or member.size != asset["byteSize"]
   420	                    or stat.S_IMODE(member.mode) != 0o755
   421	                ):
   422	                    raise AssetManifestError(
   423	                        "trusted relay archive contains an unsafe asset"
   424	                    )
   425	                stream = bundle.extractfile(member)
   426	                if stream is None:
   427	                    raise AssetManifestError(
   428	                        "trusted relay archive asset is unreadable"
   429	                    )
   430	                contents = stream.read(asset["byteSize"] + 1)
   431	                if len(contents) != member.size or stream.read(1):
   432	                    raise AssetManifestError("trusted relay archive asset is truncated")
   433	                if len(contents) != asset["byteSize"]:
   434	                    raise AssetManifestError(
   435	                        "trusted relay archive asset size mismatch"
   436	                    )
   437	                if sha256_bytes(contents) != asset["sha256"]:
   438	                    raise AssetManifestError(
   439	                        "trusted relay archive asset checksum mismatch"
   440	                    )
   441	                verify_binary_header(contents, asset["os"], asset["arch"])
   442	                verify_embedded_identity(contents, contract)
   443	                contents_by_target.append(contents)
   444	    except (OSError, tarfile.TarError) as error:
   445	        raise AssetManifestError("trusted relay archive is unparseable") from error
   446	    return contents_by_target
