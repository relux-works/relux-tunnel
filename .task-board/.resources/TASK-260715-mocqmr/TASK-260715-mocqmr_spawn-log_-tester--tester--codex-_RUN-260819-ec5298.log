+                self.restype = None
+
+            def __call__(self, *arguments: object) -> int:
+                self.calls.append(arguments)
+                return next(self.results)
+
+        class FakeLibc:
+            def __init__(self) -> None:
+                self.syscall = FakeFunction([6, 9, 0])
+                self.prctl = FakeFunction([0, 0])
+
