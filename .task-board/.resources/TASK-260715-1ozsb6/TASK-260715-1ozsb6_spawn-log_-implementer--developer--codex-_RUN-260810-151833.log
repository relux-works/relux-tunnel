   985	  private func startAutomaticTasks(configuration: SSHConnectionConfiguration) {
   986	    automaticRekeyTask = Task { [weak self, clock = dependencies.clock] in
   987	      while !Task.isCancelled {
   988	        do {
   989	          try await clock.sleep(for: configuration.rekey.elapsedTimeThreshold)
   990	          try await self?.requestRekey(reason: .timeThreshold)
   991	        } catch { return }
   992	      }
   993	    }
   994	    automaticKeepaliveTask = Task { [weak self, clock = dependencies.clock] in
   995	      while !Task.isCancelled {
   996	        do {
   997	          try await clock.sleep(for: configuration.keepalive.interval)
   998	          _ = try await self?.sendKeepalive()
   999	        } catch {
  1000	          guard
  1001	            await self?.handleAutomaticKeepaliveFailure(
  1002	              error,
  1003	              policy: configuration.keepalive
  1004	            ) == true
  1005	          else { return }
  1006	        }
  1007	      }
  1008	    }
  1009	  }
  1010	
  1011	  private func handleAutomaticKeepaliveFailure(
  1012	    _ error: Error,
  1013	    policy: SSHKeepalivePolicy
  1014	  ) async -> Bool {
  1015	    guard state == .ready else { return false }
  1016	    consecutiveKeepaliveFailures += 1
  1017	    guard consecutiveKeepaliveFailures > policy.allowedConsecutiveMisses else {
  1018	      return true
  1019	    }
  1020	    let mapped = map(error, phase: .keepalive, fallback: .keepaliveFailed)
  1021	    await recordTerminalOperation(mapped)
  1022	    try? await transition(to: .failed)
  1023	    await emit(.error(code: mapped.code, phase: mapped.phase, scope: mapped.scope))
  1024	    await tearDown()
  1025	    return false
  1026	  }
