   939	def atomic_rename_at(
   940	    directory_descriptor: int,
   941	    source_name: str,
   942	    destination_name: str,
   943	    *,
   944	    exchange: bool,
   945	) -> None:
   946	    for name in (source_name, destination_name):
   947	        if not name or name in {".", ".."} or PurePosixPath(name).name != name:
   948	            raise AssetManifestError("relay asset publication name is unsafe")
   949	    library = ctypes.CDLL(None, use_errno=True)
   950	    source_bytes = os.fsencode(source_name)
   951	    destination_bytes = os.fsencode(destination_name)
   952	    if sys.platform == "darwin":
   953	        function = library.renameatx_np
   954	        function.argtypes = [
   955	            ctypes.c_int,
   956	            ctypes.c_char_p,
   957	            ctypes.c_int,
   958	            ctypes.c_char_p,
   959	            ctypes.c_uint,
   960	        ]
   961	        function.restype = ctypes.c_int
   962	        flag = 0x00000002 if exchange else 0x00000004
   963	        result = function(
   964	            directory_descriptor,
   965	            source_bytes,
   966	            directory_descriptor,
   967	            destination_bytes,
   968	            flag,
   969	        )
   970	    elif sys.platform.startswith("linux"):
   971	        function = library.renameat2
   972	        function.argtypes = [
   973	            ctypes.c_int,
   974	            ctypes.c_char_p,
   975	            ctypes.c_int,
   976	            ctypes.c_char_p,
   977	            ctypes.c_uint,
   978	        ]
   979	        function.restype = ctypes.c_int
   980	        flag = 0x00000002 if exchange else 0x00000001
   981	        result = function(
   982	            directory_descriptor,
   983	            source_bytes,
   984	            directory_descriptor,
   985	            destination_bytes,
   986	            flag,
   987	        )
   988	    else:
   989	        raise AssetManifestError(
   990	            "atomic relay asset directory replacement is unavailable"
   991	        )
   992	    if result != 0:
   993	        error_number = ctypes.get_errno()
   994	        operation = "replacement" if exchange else "initial publication"
   995	        raise AssetManifestError(
   996	            f"atomic relay asset directory {operation} failed"
   997	        ) from OSError(error_number, os.strerror(error_number))
