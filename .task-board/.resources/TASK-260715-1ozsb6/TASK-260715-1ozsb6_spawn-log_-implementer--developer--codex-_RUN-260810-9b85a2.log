   109	  private func serviceExclusively(
   110	    connection: any SSHTCPConnection,
   111	    interests: Set<SSHTCPReadiness>
   112	  ) async throws {
   113	    var requested = interests
   114	    let counts = bufferedByteCounts
   115	    if counts.outbound > 0 { requested.insert(.writable) }
   116	    if counts.inbound < maximumBufferedBytes { requested.insert(.readable) }
   117	    guard !requested.isEmpty else { return }
   118	
   119	    let ready = try await connection.waitForReadiness(requested)
   120	    if ready.contains(.writable) {
   121	      let bytes = lock.withLock { Data(outbound.prefix(maximumBufferedBytes)) }
   122	      if !bytes.isEmpty {
   123	        let written = try await connection.writeSome(bytes)
   124	        guard written > 0, written <= bytes.count else {
   125	          throw LibSSH2BridgeError.invalidSocketWriteCount
   126	        }
   127	        lock.withLock { outbound.removeFirst(written) }
   128	      }
   129	    }
   130	    if ready.contains(.readable) {
   131	      let capacity = lock.withLock { maximumBufferedBytes - inbound.count }
   132	      if capacity > 0 {
   133	        if let bytes = try await connection.readSome(maximumBytes: capacity) {
   134	          guard bytes.count <= capacity else {
   135	            throw LibSSH2BridgeError.socketReadExceededBound
   136	          }
   137	          lock.withLock { inbound.append(bytes) }
   138	        } else {
   139	          lock.withLock { remoteEOF = true }
   140	        }
   141	      }
   142	    }
   143	  }
