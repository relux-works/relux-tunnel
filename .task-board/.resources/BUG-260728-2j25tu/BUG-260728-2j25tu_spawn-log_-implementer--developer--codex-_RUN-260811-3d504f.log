   764	  private func readLoop() {
   765	    do {
   766	      try configureTimeouts()
   767	      let started = DispatchTime.now().uptimeNanoseconds
   768	      var bytes = [UInt8](repeating: 0, count: 4_096)
   769	      while !lock.withLock({ closed }) {
   770	        let count = try channel.withBorrowedDescriptor { descriptor in
   771	          Darwin.recv(descriptor, &bytes, bytes.count, 0)
   772	        }
   773	        if count > 0 {
   774	          let events = decoder.consume(Data(bytes.prefix(count)))
   775	          for event in events {
   776	            switch event {
   777	            case .requestAccepted:
   778	              try sendSOCKSReply(code: 0)
   779	              owner?.requestAccepted()
   780	            case .requestRejected(let code):
   781	              try? sendSOCKSReply(code: code)
   782	              owner?.requestRejected()
   783	              close(notifyRegistry: true)
   784	              return
   785	            case .record(let record):
   786	              owner?.recordInputRecord(byteCount: record.count)
   787	              enqueueInbound(record)
   788	            case .discardedOversized(let localPolicy):
   789	              owner?.recordOversizedInbound(localPolicy: localPolicy)
   790	            case .fatal:
   791	              owner?.recordMalformedInbound()
   792	              close(notifyRegistry: true)
   793	              return
   794	            }
   795	          }
   796	        } else if count == 0 {
   797	          close(notifyRegistry: true)
   798	          return
   799	        } else if errno != EINTR && errno != EAGAIN && errno != EWOULDBLOCK {
   800	          close(notifyRegistry: true)
   801	          return
   802	        }
   803	
   804	        if key == nil {
   805	          let elapsed = DispatchTime.now().uptimeNanoseconds - started
   806	          if elapsed >= UInt64(admissionTimeoutMilliseconds) * 1_000_000 {
   807	            owner?.recordAdmissionTimeout()
   808	            close(notifyRegistry: false)
   809	            return
   810	          }
   811	        }
   812	      }
   813	    } catch {
   814	      close(notifyRegistry: true)
   815	    }
   816	  }
