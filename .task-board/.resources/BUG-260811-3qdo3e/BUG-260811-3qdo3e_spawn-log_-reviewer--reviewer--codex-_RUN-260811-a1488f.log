while [ "$i" -le 20 ]; do
  log="$review_dir/unfiltered-$(printf '"'%02d' \""'$i").log"
  swift test --skip-build >"$log" 2>&1
  rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "run $i FAIL exit=$rc log=$log"
    tail -n 40 "$log"
    exit "$rc"
  fi
  summary=$(rg '"'Test run with [0-9]+ tests in [0-9]+ suites passed' \""'$log" | tail -n 1)
  count=$(printf '"'%s\\n' \""'$summary" | sed -E '"'s/.*with ([0-9]+) tests.*/\\1/')
  if [ -z \""'$summary" ] || [ "$count" -lt 427 ]; then
    echo "run $i FAIL invalid-summary log=$log"
    tail -n 40 "$log"
    exit 97
  fi
  echo "run $i PASS exit=0 tests=$count"
  i=$((i + 1))
done
