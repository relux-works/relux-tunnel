  1673	private enum LibSSH2TimeoutError: Error {
  1674	  case elapsed
  1675	}
  1676	
  1677	private func withTimeout<Value: Sendable>(
  1678	  _ timeout: Duration,
  1679	  clock: any TunnelClock,
  1680	  operation: @escaping @Sendable () async throws -> Value
  1681	) async throws -> Value {
  1682	  try await withThrowingTaskGroup(of: Value.self) { group in
  1683	    group.addTask { try await operation() }
  1684	    group.addTask {
  1685	      try await clock.sleep(for: timeout)
  1686	      throw LibSSH2TimeoutError.elapsed
  1687	    }
  1688	
  1689	    let result: Result<Value, Error>
  1690	    do {
  1691	      result = .success(try await group.next()!)
  1692	    } catch {
  1693	      result = .failure(error)
  1694	    }
  1695	    group.cancelAll()
  1696	    while !group.isEmpty { _ = try? await group.next() }
  1697	    return try result.get()
  1698	  }
  1699	}
