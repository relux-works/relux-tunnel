+
+  func evaluate(_ input: SSHHostKeyPolicyInput) async throws -> SSHHostKeyDecision {
+    trace.record("ssh.host-policy.evaluate")
+    return .acceptMatch(
+      input.trustRecordReference
+        ?? SSHTrustRecordReference(rawValue: "missing-trust-reference")
+    )
+  }
+}
