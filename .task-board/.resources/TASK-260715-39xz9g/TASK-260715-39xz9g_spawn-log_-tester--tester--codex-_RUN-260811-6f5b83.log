    def _generate_key(self, path: Path, key_type: str, comment: str) -> None:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        arguments = [
            "/usr/bin/ssh-keygen",
            "-q",
            "-t",
            key_type,
            "-N",
            "",
            "-C",
            comment,
            "-f",
            str(path),
        ]
        if key_type == "ecdsa":
            arguments[4:4] = ["-b", "256"]
        _run(arguments)
        os.chmod(path, 0o600)

