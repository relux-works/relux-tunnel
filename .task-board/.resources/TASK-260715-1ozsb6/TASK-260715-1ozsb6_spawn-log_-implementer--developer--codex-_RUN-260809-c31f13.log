+    #expect(context.outstandingAllocationCount == 1)
+    let replacement = try #require(context.reallocate(pointer, byteCount: 32))
+    #expect(context.outstandingAllocationCount == 1)
+    context.free(replacement)
+    #expect(context.outstandingAllocationCount == 0)
