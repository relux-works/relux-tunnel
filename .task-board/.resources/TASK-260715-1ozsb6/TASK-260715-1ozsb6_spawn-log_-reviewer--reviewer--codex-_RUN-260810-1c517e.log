  2179	  private func remainingDuration(until deadline: ContinuousClock.Instant) -> Duration? {
  2180	    let now = dependencies.clock.now()
  2181	    guard now < deadline else { return nil }
  2182	    return now.duration(to: deadline)
  2183	  }
  2184	
  2185	  private func clearAutomaticTaskReferences() {
  2186	    automaticRekeyTask = nil
  2187	    automaticKeepaliveTask = nil
  2188	    byteRekeyTask = nil
  2189	    rekeyFlightTask = nil
  2190	    rekeyFlightInProgress = false
