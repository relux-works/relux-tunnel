   714	  public func snapshot() async -> SSHTransportSnapshot {
   715	    await reconcileProtectedMetrics()
   716	    let counts = context.network.bufferedByteCounts
   717	    let direct = channels.values.filter { $0.kind == .directTCPIP && !$0.closed }.count
   718	    let exec = channels.values.filter { $0.kind == .exec && !$0.closed }.count
   719	    return SSHTransportSnapshot(
   720	      lane: lane,
   721	      connectionState: state,
   722	      negotiatedAlgorithms: negotiatedAlgorithms,
   723	      keyExchangeGeneration: .unsupported,
   724	      counters: counters,
   725	      gauges: SSHTransportGauges(
   726	        openDirectChannels: Int64(direct),
   727	        openExecChannels: Int64(exec),
   728	        pendingChannelOpens: Int64(pendingChannelOpens),
   729	        pendingReads: Int64(pendingReads.count),
   730	        pendingWrites: Int64(pendingWriteOperations),
   731	        queuedWriteBytes: Int64(pendingWriteBytes.values.reduce(0, +)),
   732	        bufferedReadBytes: Int64(counts.inbound),
   733	        remainingReceiveWindowBytes: .unsupported,
   734	        activeKeyExchange: .unsupported,
   735	        consecutiveKeepaliveMisses: .unsupported,
