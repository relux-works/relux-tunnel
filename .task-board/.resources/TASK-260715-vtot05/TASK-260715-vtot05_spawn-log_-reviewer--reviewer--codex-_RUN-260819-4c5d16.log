   959	def supply_chain_reference(
   960	    config: dict[str, Any], outputs: dict[str, bytes]
   961	) -> dict[str, Any]:
   962	    return {
   963	        "kind": "repositoryGenerated",
   964	        "taskID": config["taskID"],
   965	        "manifestLinkageSHA256": linkage_id(config),
   966	        "provenanceFile": config["outputs"]["provenance"],
   967	        "provenanceSHA256": sha256_bytes(outputs[config["outputs"]["provenance"]]),
   968	        "inventoryFile": config["outputs"]["inventory"],
   969	        "inventorySHA256": sha256_bytes(outputs[config["outputs"]["inventory"]]),
   970	        "noticesFile": config["outputs"]["notices"],
   971	        "noticesSHA256": sha256_bytes(outputs[config["outputs"]["notices"]]),
