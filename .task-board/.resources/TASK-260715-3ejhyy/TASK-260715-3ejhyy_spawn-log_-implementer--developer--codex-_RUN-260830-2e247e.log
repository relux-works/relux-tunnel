    on descriptor: Int32,
    bytes: UnsafeRawBufferPointer
  ) throws -> Int
  func receiveDatagram(
    on descriptor: Int32,
    into bytes: UnsafeMutableRawBufferPointer
  ) throws -> PacketBridgeReceiveResult
