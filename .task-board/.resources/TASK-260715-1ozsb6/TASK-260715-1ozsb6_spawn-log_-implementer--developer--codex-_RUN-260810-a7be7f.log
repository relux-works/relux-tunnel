  private func performUpload(_ request: SSHExecUploadRequest) async throws -> SSHExecExit {
    let channel = try await openExecChannel(request: request.exec, policy: request.channelPolicy)
    let execChannel = channel as! LibSSH2ExecChannel
    do {
      async let stdout: Void = drain(channel: execChannel, standardError: false)
      async let stderr: Void = drain(channel: execChannel, standardError: true)
      while let bytes = try await request.source.read(maximumBytes: request.chunkBytes) {
        guard !bytes.isEmpty, bytes.count <= request.chunkBytes else {
          throw transportError(code: .protocolViolation, phase: .uploadSource)
        }
        var offset = 0
        while offset < bytes.count {
          let written = try await execChannel.writeSome(Data(bytes[offset...]))
          offset += written
        }
      }
      try await execChannel.finishWriting()
      let exit = try await execChannel.waitForExit()
      _ = try await (stdout, stderr)
      await execChannel.close()
      return exit
    } catch {
      await execChannel.cancel()
      throw map(error, phase: .uploadSource)
    }
  }

  private func drain(channel: LibSSH2ExecChannel, standardError: Bool) async throws {
    while true {
      let bytes =
        if standardError {
          try await channel.readStandardError(maximumBytes: 16 * 1_024)
        } else {
          try await channel.read(maximumBytes: 16 * 1_024)
        }
      if bytes == nil { return }
    }
  }

