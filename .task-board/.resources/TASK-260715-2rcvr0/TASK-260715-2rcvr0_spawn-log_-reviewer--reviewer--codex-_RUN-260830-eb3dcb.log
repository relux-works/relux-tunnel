   680	    runtimeGeneration = try container.decode(UInt64.self, forKey: .runtimeGeneration)
   681	    snapshotSequence = try container.decode(UInt64.self, forKey: .snapshotSequence)
   682	    counters =
   683	      if container.contains(.counters) {
   684	        try container.decode([String: UInt64].self, forKey: .counters)
   685	      } else {
   686	        [:]
   687	      }
   688	    gauges =
