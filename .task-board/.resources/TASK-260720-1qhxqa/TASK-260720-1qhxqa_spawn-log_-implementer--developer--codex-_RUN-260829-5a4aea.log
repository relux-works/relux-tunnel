   441	def package_dependencies(block: str, row: str) -> list[str]:
   442	    dependencies: list[str] = []
   443	    for entry in split_swift_array(array_field(block, "dependencies", row), row):
   444	        match = re.fullmatch(r'"([^"\\]+)"', entry)
   445	        if match is None:
   446	            raise BindingError(row, f"unknown package dependency expression: {entry}")
   447	        dependencies.append(match.group(1))
   448	    return dependencies
