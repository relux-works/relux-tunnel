   403	def split_swift_array(value: str, row: str) -> list[str]:
   404	    entries: list[str] = []
   405	    start = 0
   406	    depths = {"(": 0, "[": 0, "{": 0}
   407	    closing = {")": "(", "]": "[", "}": "{"}
   408	    in_string = False
   409	    escaped = False
   410	    for index, character in enumerate(value):
   411	        if in_string:
   412	            if escaped:
   413	                escaped = False
   414	            elif character == "\\":
   415	                escaped = True
   416	            elif character == '"':
   417	                in_string = False
   418	            continue
   419	        if character == '"':
   420	            in_string = True
   421	        elif character in depths:
   422	            depths[character] += 1
   423	        elif character in closing:
   424	            opening = closing[character]
   425	            depths[opening] -= 1
   426	            if depths[opening] < 0:
   427	                raise BindingError(row, "malformed Swift array entry")
   428	        elif character == "," and not any(depths.values()):
   429	            entry = value[start:index].strip()
   430	            if entry:
   431	                entries.append(entry)
   432	            start = index + 1
   433	    if in_string or any(depths.values()):
   434	        raise BindingError(row, "malformed Swift array entry")
   435	    final = value[start:].strip()
   436	    if final:
   437	        entries.append(final)
   438	    return entries
