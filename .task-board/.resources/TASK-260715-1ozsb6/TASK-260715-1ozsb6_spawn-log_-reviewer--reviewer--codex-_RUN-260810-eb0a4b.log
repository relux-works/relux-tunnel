   647	  private func configureEngine(configuration: SSHConnectionConfiguration) throws {
   648	    let opaque = Unmanaged.passUnretained(context).toOpaque()
   649	    sessionContextPointer = opaque
   650	    let freeCallback = unsafeBitCast(reluxLibSSH2FreeCallback, to: OpaquePointer.self)
   651	    guard
   652	      let session = libssh2_session_init_ex(
   653	        reluxLibSSH2AllocateCallback,
   654	        freeCallback,
   655	        reluxLibSSH2ReallocateCallback,
   656	        opaque
   657	      )
   658	    else {
   659	      throw transportError(code: .resourceLimitExceeded, phase: .initialKeyExchange)
   660	    }
   661	    engineSession = session
   662	    libssh2_session_set_blocking(session, 0)
   663	    let sendCallback: (@convention(c) () -> Void)? = unsafeBitCast(
   664	      reluxLibSSH2SendCallback,
   665	      to: Optional<@convention(c) () -> Void>.self
   666	    )
   667	    let receiveCallback: (@convention(c) () -> Void)? = unsafeBitCast(
   668	      reluxLibSSH2ReceiveCallback,
   669	      to: Optional<@convention(c) () -> Void>.self
   670	    )
   671	    _ = libssh2_session_callback_set2(session, Int32(LIBSSH2_CALLBACK_SEND), sendCallback)
   672	    _ = libssh2_session_callback_set2(session, Int32(LIBSSH2_CALLBACK_RECV), receiveCallback)
   673	
   674	    try setPreference(Int32(LIBSSH2_METHOD_KEX), configuration.algorithms.keyExchange)
   675	    try setPreference(Int32(LIBSSH2_METHOD_HOSTKEY), configuration.algorithms.hostKey)
   676	    try setPreference(Int32(LIBSSH2_METHOD_CRYPT_CS), configuration.algorithms.cipher)
   677	    try setPreference(Int32(LIBSSH2_METHOD_CRYPT_SC), configuration.algorithms.cipher)
   678	    try setPreference(Int32(LIBSSH2_METHOD_MAC_CS), configuration.algorithms.mac)
   679	    try setPreference(Int32(LIBSSH2_METHOD_MAC_SC), configuration.algorithms.mac)
   680	    try setPreference(Int32(LIBSSH2_METHOD_SIGN_ALGO), configuration.algorithms.hostKey)
   681	    libssh2_keepalive_config(
   682	      session,
   683	      1,
   684	      UInt32(max(2, configuration.keepalive.interval.wholeSeconds))
   685	    )
   686	  }
