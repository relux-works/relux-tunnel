+          port: server.port,
+          credential: credential,
+          trace: trace,
+          observer: recorder,
+          metrics: recorder,
+          logger: recorder
+        )
+      ) as! LibSSH2Transport
+    do {
+      _ = try await rejectedUserTransport.connect(
