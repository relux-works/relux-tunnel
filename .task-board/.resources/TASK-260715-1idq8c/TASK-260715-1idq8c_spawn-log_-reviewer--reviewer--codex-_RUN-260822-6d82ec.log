     9	
    10	    init(fixture: ReluxUITestFixture) {
    11	      #if os(iOS)
    12	        XCUIDevice.shared.orientation = .portrait
    13	      #endif
    14	      let app = XCUIApplication()
    15	      let configuration = ReluxUITest.LaunchConfiguration(fixture: fixture)
    16	      app.launchArguments = configuration.arguments
    17	      app.launchEnvironment = configuration.environment
