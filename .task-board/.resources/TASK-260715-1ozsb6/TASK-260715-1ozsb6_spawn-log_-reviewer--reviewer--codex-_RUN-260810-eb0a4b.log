  1172	  func channelFinishWriting(identity: SSHChannelIdentity) async throws {
  1173	    try beginChannelOperation(identity: identity, phase: .channelEOF)
  1174	    do {
  1175	      try await performChannelFinishWriting(identity: identity)
  1176	      finishChannelOperation(identity: identity)
  1177	    } catch {
  1178	      finishChannelOperation(identity: identity)
  1179	      let mapped = map(error, phase: .channelEOF)
  1180	      await recordTerminalOperation(mapped)
  1181	      throw mapped
  1182	    }
  1183	  }
  1184	
  1185	  private func performChannelFinishWriting(identity: SSHChannelIdentity) async throws {
  1186	    guard var record = channels[identity], !record.closed, let configuration else {
  1187	      throw transportError(code: .channelClosed, phase: .channelEOF, scope: .channel(identity))
  1188	    }
  1189	    if record.writeEOF { return }
  1190	    let deadline = dependencies.clock.now().advanced(by: configuration.timeouts.channelClose)
  1191	    while true {
  1192	      try checkChannelDisposition(identity: identity, phase: .channelEOF)
  1193	      let result = libssh2_channel_send_eof(record.pointer)
  1194	      if result == 0 { break }
  1195	      guard result == LIBSSH2_ERROR_EAGAIN else {
  1196	        throw engineError(result, phase: .channelEOF, fallback: .channelClosed)
  1197	      }
  1198	      try await progress(until: deadline, phase: .channelEOF)
  1199	    }
  1200	    record.writeEOF = true
  1201	    channels[identity] = record
  1202	    await emit(.channelEOF(channel: identity, direction: .localWrite))
  1203	  }
