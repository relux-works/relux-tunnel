    71	static err_t
    72	netif_output_handler (struct netif *netif, struct pbuf *p)
    73	{
    74	    ssize_t s;
    75	
    76	    s = hev_tunnel_write (tun_fd, p);
    77	    if (s <= 0) {
    78	        if (errno == EAGAIN)
    79	            return ERR_WOULDBLOCK;
    80	        LOG_W ("socks5 tunnel write");
    81	        return ERR_IF;
    82	    }
    83	
    84	    stat_rx_packets++;
    85	    stat_rx_bytes += s;
    86	
    87	    return ERR_OK;
    88	}
    89	
    90	static err_t
    91	netif_output_v4_handler (struct netif *netif, struct pbuf *p,
    92	                         const ip4_addr_t *ipaddr)
    93	{
    94	    return netif_output_handler (netif, p);
    95	}
    96	
    97	static err_t
    98	netif_output_v6_handler (struct netif *netif, struct pbuf *p,
    99	                         const ip6_addr_t *ipaddr)
   100	{
   101	    return netif_output_handler (netif, p);
   102	}
