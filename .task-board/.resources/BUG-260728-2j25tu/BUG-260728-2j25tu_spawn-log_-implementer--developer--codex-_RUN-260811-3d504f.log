   429	  func nonterminalRelayErrorsDoNotRefreshIdleActivity(
   430	    code: RelayProtocolV1.UDPErrorCode
   431	  ) async throws {
   432	    let relay = RecordingUDPRelay()
   433	    let clock = ManualUDPAdapterClock()
   434	    let adapter = try makeAdapter(relay: relay, clock: clock)
   435	    let peer = try await openHEVAssociation(adapter: adapter)
   436	    defer { Darwin.close(peer) }
   437	    let request = try record(
   438	      address: .domain(Data("idle.example".utf8)),
   439	      port: 443,
   440	      payload: Data([1])
   441	    )
   442	    try sendAll(request, to: peer)
   443	    let submission = await relay.next()
   444	    await waitUntil { clock.pendingSleeps == 1 }
   445	
   446	    let admitted = await adapter.snapshot()
   447	    let originalDeadline = try #require(clock.onlyPendingDeadline)
   448	    let originalTimerArms = clock.timerArms
   449	    #expect(admitted.registry.metrics.activityUpdates == 1)
   450	    #expect(admitted.registry.scheduledTimers == 1)
   451	
   452	    clock.advance(by: .milliseconds(9_999))
   453	    let result = await adapter.receiveRelayError(
   454	      associationID: submission.envelope.associationID,
   455	      generation: 41,
   456	      error: .generated(code)
   457	    )
   458	    guard case .applied(let key, from: .active, to: .active) = result else {
   459	      Issue.record("nonterminal relay error did not preserve active state")
   460	      return
   461	    }
   462	    #expect(key.associationID == submission.envelope.associationID)
   463	
   464	    let observed = await adapter.snapshot()
   465	    #expect(observed.registry.metrics.activityUpdates == admitted.registry.metrics.activityUpdates)
   466	    #expect(observed.registry.scheduledTimers == 1)
   467	    #expect(clock.pendingSleeps == 1)
   468	    #expect(clock.onlyPendingDeadline == originalDeadline)
   469	    #expect(clock.timerArms == originalTimerArms)
   470	    #expect(observed.metrics.remoteErrors == 1)
   471	    #expect(
   472	      observed.metrics.remoteQueueSaturatedDropped
   473	        == (code == .queueSaturated ? 1 : 0)
   474	    )
   475	    #expect(
   476	      observed.metrics.remoteDatagramTooLargeDropped
   477	        == (code == .datagramTooLarge ? 1 : 0)
   478	    )
   479	    #expect(relay.snapshot().isEmpty)
   480	
   481	    clock.advance(by: .milliseconds(1))
   482	    #expect(try await receiveEOF(from: peer))
   483	    let expiryClose = await relay.next()
   484	    #expect(expiryClose.envelope.type == .closeAssociation)
   485	    #expect(expiryClose.envelope.associationID == submission.envelope.associationID)
   486	    _ = await adapter.receiveRelayClose(
   487	      associationID: submission.envelope.associationID,
   488	      generation: 41
   489	    )
   490	
   491	    let baseline = await adapter.snapshot()
   492	    #expect(baseline.activeConnections == 0)
   493	    #expect(baseline.registry.associationCount == 0)
   494	    #expect(baseline.registry.metrics.activityUpdates == admitted.registry.metrics.activityUpdates)
   495	    #expect(baseline.registry.metrics.idleExpired == 1)
   496	    #expect(baseline.registry.metrics.terminalCleanups == 1)
   497	    #expect(baseline.inboundQueuedBytes == 0)
   498	    #expect(baseline.outboundQueuedBytes == 0)
   499	    #expect(clock.pendingSleeps == 0)
   500	  }
