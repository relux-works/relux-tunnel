+  func readSome(maximumBytes: Int) async throws -> Data? {
+    await suspendUntilReleased()
+    return nil
+  }
+
+  func writeSome(_ bytes: Data) async throws -> Int {
+    writeCount += 1
+    return bytes.count
+  }
+
+  func close() async {
+    closeCount += 1
+    await suspendUntilReleased()
+  }
