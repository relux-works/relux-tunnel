+    }
+    if seen_sdks != expected_sdks:
+        raise NativeDependencyError(
+            "HEV build script SDK coverage mismatch: expected "
+            f"{sorted(expected_sdks)}, got {sorted(seen_sdks)}"
+        )
+    return rendered
