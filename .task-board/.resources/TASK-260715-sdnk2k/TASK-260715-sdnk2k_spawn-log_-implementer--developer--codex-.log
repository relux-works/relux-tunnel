+      readBehavior = .eof
+      writeBehavior = .accept
+      channelRead = .stall
+      channelWrite = .accept
+      scheduler = nil
+    case .sshWrite:
+      readBehavior = .oneChunkThenEOF(Data([1]))
+      writeBehavior = .accept
+      channelRead = .eof
+      channelWrite = .stall
+      scheduler = nil
+    case .fairnessYield:
+      readBehavior = .oneChunkThenEOF(Data([1, 2]))
+      writeBehavior = .accept
+      channelRead = .eof
+      channelWrite = .accept
+      scheduler = FirstYieldGateBytePumpScheduler()
