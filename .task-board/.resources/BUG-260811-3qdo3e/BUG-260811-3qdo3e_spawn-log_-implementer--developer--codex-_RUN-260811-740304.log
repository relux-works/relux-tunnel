   202	    guard !tasks.isEmpty else { return true }
   203	    for task in tasks { task.cancel() }
   204	    let now = clock.now()
   205	    guard now < deadline else {
   206	      _ = lock.withLock { serviceDrainWaiters.removeValue(forKey: identifier) }
   207	      return false
   208	    }
   209	    let timer = Task {
   210	      do {
   211	        try await clock.sleep(for: now.duration(to: deadline))
