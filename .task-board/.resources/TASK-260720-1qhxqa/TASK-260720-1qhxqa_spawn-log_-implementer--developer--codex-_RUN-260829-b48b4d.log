    def test_production_entry_point_rejects_extra_dependency_in_every_protected_closure(
        self,
    ) -> None:
        mutants = (
            (
                "provider",
                "Project.swift",
                "ReluxProxyMacTunnel",
                '.package(product: "ReluxTunnelCore")',
            ),
            (
                "macos-adapter",
                "Package.swift",
                "ReluxTunnelMacOSAdapter",
                '"UnauthorizedMacOSDependency"',
