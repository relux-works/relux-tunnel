   585	    def _probe(self, server_id: str) -> dict:
   586	        state = self._load_state(server_id)
   587	        facts = self._prove_reachability(server_id, state)
   588	        runtime = state["runtime"]
   589	        if server_id.startswith("macos-"):
   590	            fingerprints = [_fingerprint_public_key(Path(state["hostKey"] + ".pub"))]
   591	            os_name = "macOS"
   592	            os_version = _run(["/usr/bin/sw_vers", "-productVersion"]).stdout.decode().strip()
   593	            openssh = _ssh_version()
   594	            user_types = [state["userKeyType"]]
   595	        else:
   596	            fingerprints = _scan_fingerprints(runtime["host"], runtime["port"])
   597	            os_name = "Ubuntu" if server_id == "linux-current" else "macOS"
   598	            os_version = "24.04" if server_id == "linux-current" else "runtime-current"
   599	            openssh = facts["openssh"]
   600	            user_types = ["ssh-ed25519"]
   601	        return {
   602	            "observation": {
   603	                "architecture": facts["arch"],
   604	                "hostKeyFingerprints": fingerprints,
   605	                "opensshVersion": openssh,
   606	                "osName": os_name,
   607	                "osVersion": os_version,
   608	                "privilege": "non-root",
   609	                "reachable": True,
   610	                "userKeyTypes": user_types,
   611	            },
   612	            "status": "ok",
   613	        }
   614	
   615	    def _control(self, server_id: str, scenario_id: str) -> dict:
   616	        state = self._load_state(server_id)
   617	        runtime = dict(state["runtime"])
   618	        if server_id not in {"macos-current", "macos-approved-older-profile"}:
   619	            raise ProviderError("destructive scenario controls are restricted to task-owned macOS fixtures")
   620	        directory = self._server_dir(server_id)
   621	        if scenario_id == "host-key-first-use":
   622	            known_hosts = directory / "known-hosts-empty"
   623	            known_hosts.write_bytes(b"")
   624	            runtime["scenarioControl"] = {
   625	                "knownHostsReference": f"ephemeral-file://{known_hosts}"
   626	            }
   627	        elif scenario_id == "host-key-change":
   628	            previous_fingerprint = _fingerprint_public_key(Path(state["hostKey"] + ".pub"))
   629	            old_process = next(
   630	                process for process in state["processes"] if process.get("kind") == "sshd"
   631	            )
   632	            self._terminate_owned_process(old_process["pid"], old_process["marker"])
   633	            changed = directory / f"host-key-changed-{int(time.time_ns())}"
   634	            key_type = "ecdsa" if server_id == "macos-approved-older-profile" else "ed25519"
   635	            self._generate_key(changed, key_type, f"{fixture.TASK_ID}-{server_id}-changed")
   636	            replacement = self._start_macos_sshd(server_id, runtime["port"], changed)
   637	            replacement["kind"] = "sshd"
   638	            state["processes"] = [
   639	                replacement if process is old_process else process for process in state["processes"]
   640	            ]
   641	            state["hostKey"] = str(changed)
   642	            runtime["scenarioControl"] = {"approvedFingerprint": previous_fingerprint}
   643	        elif scenario_id == "auth-rejection":
   644	            rejected = directory / f"user-key-rejected-{int(time.time_ns())}"
   645	            self._generate_key(rejected, "ed25519", f"{fixture.TASK_ID}-{server_id}-rejected")
   646	            runtime["identityReference"] = f"ephemeral-file://{rejected}"
   647	            runtime["scenarioControl"] = {"authentication": "unapproved-public-key"}
   648	        elif scenario_id == "channel-rejection":
   649	            runtime["scenarioControl"] = {
   650	                "rejectedDestination": {"host": "127.0.0.1", "port": _free_port()}
   651	            }
   652	        elif scenario_id == "server-rekey":
   653	            runtime["scenarioControl"] = {"rekeyLimitBytes": 32 * 1024}
   654	        else:
   655	            endpoint = {
   656	                "early-close": "early-close", "half-close": "half-close",
   657	                "reset": "reset", "disconnect": "disconnect",
   658	            }.get(scenario_id)
   659	            if endpoint:
   660	                runtime["scenarioControl"] = {"endpoint": endpoint}
   661	            elif scenario_id == "latency":
   662	                runtime["scenarioControl"] = {"latencyMilliseconds": 75}
   663	            elif scenario_id == "loss":
   664	                runtime["scenarioControl"] = {"deterministicDropEvery": 10}
   665	        state["runtime"] = state["runtime"]
   666	        self._save_state(server_id, state)
   667	        return {
   668	            "fixtureEvidenceCode": fixture.SCENARIO_FIXTURE_EVIDENCE[scenario_id],
   669	            "runtime": runtime,
   670	            "scenarioId": scenario_id,
   671	            "status": "ok",
   672	        }
