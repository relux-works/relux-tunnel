   316	extension NIOSSHHandler {
   317	    /// Creates an SSH channel.
   318	    ///
   319	    /// This function is **not** thread-safe: it may only be called from on the channel.
   320	    ///
   321	    /// - parameters:
   322	    ///     - promise: An `EventLoopPromise` that will be fulfilled with the channel when it becomes active.
   323	    ///     - channelType: The type of the channel to create. Defaults to ``SSHChannelType/session`` for running remote processes.
   324	    ///     - channelInitializer: A callback that will be invoked to initialize the channel.
   325	    public func createChannel(
   326	        _ promise: EventLoopPromise<Channel>? = nil,
   327	        channelType: SSHChannelType = .session,
   328	        _ channelInitializer: ((Channel, SSHChannelType) -> EventLoopFuture<Void>)?
   329	    ) {
   330	        self.pendingChannelInitializations.append(
   331	            (promise: promise, channelType: channelType, initializer: channelInitializer)
   332	        )
   333	        self.createPendingChannelsIfPossible()
   334	    }
   335	
   336	    private func createPendingChannelsIfPossible() {
   337	        guard self.stateMachine.hasActivated, self.pendingChannelInitializations.count > 0 else {
   338	            // No work to do
   339	            return
   340	        }
   341	
   342	        if !self.stateMachine.disconnected, let multiplexer = self.multiplexer {
   343	            while let next = self.pendingChannelInitializations.popFirst() {
   344	                multiplexer.createChildChannel(next.promise, channelType: next.channelType, next.initializer)
   345	            }
   346	        } else {
   347	            while let next = self.pendingChannelInitializations.popFirst() {
   348	                next.promise?.fail(NIOSSHError.creatingChannelAfterClosure)
   349	            }
   350	        }
   351	    }
   352	}
