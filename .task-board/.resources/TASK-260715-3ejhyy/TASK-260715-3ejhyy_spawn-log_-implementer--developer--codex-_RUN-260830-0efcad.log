  let root = URL(fileURLWithPath: #filePath)
    .deletingLastPathComponent()
    .deletingLastPathComponent()
    .deletingLastPathComponent()
  return try! Data(
    contentsOf: root.appendingPathComponent(
      "Configuration/TASK-260720-1qhxqa_m0-production-bindings-v1.json"
    )
  )
}

