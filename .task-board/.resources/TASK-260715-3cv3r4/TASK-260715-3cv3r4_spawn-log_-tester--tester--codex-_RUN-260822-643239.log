+    HostDecisionCase(
+      name: "acceptMatch",
+      decision: .acceptMatch(SSHTrustRecordReference(rawValue: "trust-record")),
+      isAccepted: true
+    ),
+    HostDecisionCase(
+      name: "acceptApproved",
+      decision: .acceptApproved(
+        SSHApprovedHostIdentityMatch(
