   205	      maximumReservedBytes: maximumReservedBytes,
   206	      reservedBytes: reservedBytes,
   207	      peakReservedBytes: peakReservedBytes,
   208	      successfulReservations: successfulReservations,
   209	      deniedReservations: deniedReservations,
   210	      releases: releases,
   211	      releaseViolations: releaseViolations
   212	    )
   213	  }
