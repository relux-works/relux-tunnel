+#!/usr/bin/env bash
+set -euo pipefail
+
+repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
+cd "$repo_root"
+
+same_bytes() {
+  cmp -s "$1" "$2" || {
+    echo "copy mismatch: $1 != $2" >&2
+    exit 1
+  }
+}
+
+protocol_source=.research/260721_task-260715-2kchi0-m3-performance-evidence-protocol.md
+same_bytes "$protocol_source" .task-board/.resources/TASK-260715-2kchi0/TASK-260715-2kchi0_m3-performance-evidence-protocol-v1.md
+protocol_copy_count=1
+while IFS= read -r path; do
+  same_bytes "$protocol_source" "$path"
+  protocol_copy_count=$((protocol_copy_count + 1))
+done < <(find .task-board/.resources -type f -name '*_m3-evidence-protocol-v1.md' | sort)
+[[ "$protocol_copy_count" -eq 19 ]]
+
+fixture_count=0
+for source_path in .research/fixtures/TASK-260715-2kchi0_*; do
+  suffix=${source_path##*/TASK-260715-2kchi0_}
+  same_bytes "$source_path" ".task-board/.resources/TASK-260715-2kchi0/TASK-260715-2kchi0_$suffix"
+  same_bytes "$source_path" ".task-board/.resources/TASK-260721-2ohf99/TASK-260721-2ohf99_$suffix"
+  fixture_count=$((fixture_count + 1))
+done
+[[ "$fixture_count" -eq 12 ]]
+
+schema_source=.research/fixtures/TASK-260715-2kchi0_m3-evidence-manifest-v1.schema.json
+schema_copy_count=0
+while IFS= read -r path; do
+  same_bytes "$schema_source" "$path"
+  schema_copy_count=$((schema_copy_count + 1))
+done < <(find .task-board/.resources -type f -name '*_m3-evidence-manifest-v1.schema.json' | sort)
+[[ "$schema_copy_count" -eq 6 ]]
+
+puml_source=diagrams/TASK-260715-2kchi0_measurement-evidence-flow.puml
+puml_copy_count=0
+while IFS= read -r path; do
+  same_bytes "$puml_source" "$path"
+  puml_copy_count=$((puml_copy_count + 1))
+done < <(find .task-board/.resources -type f \( -name '*_measurement-evidence-flow.puml' -o -name '*_m3-measurement-evidence-flow.puml' \) | sort)
+[[ "$puml_copy_count" -eq 3 ]]
+
+svg_source=diagrams/artefacts/TASK-260715-2kchi0_measurement-evidence-flow.svg
+same_bytes "$svg_source" .task-board/.resources/TASK-260715-2kchi0/TASK-260715-2kchi0_measurement-evidence-flow.svg
+
+same_bytes scripts/tests/TASK-260715-2kchi0_test-m3-jcs-hashes.sh \
+  .task-board/.resources/TASK-260715-2kchi0/TASK-260715-2kchi0_test-m3-jcs-hashes.sh
+same_bytes scripts/tests/TASK-260715-2kchi0_test-m3-jcs-hashes.sh \
+  .task-board/.resources/TASK-260721-2ohf99/TASK-260721-2ohf99_test-m3-jcs-hashes.sh
+same_bytes .research/260722_task-260721-2ohf99-m3-validator-semantic-rules.md \
+  .task-board/.resources/TASK-260721-2ohf99/TASK-260721-2ohf99_rework-02-semantic-rules.md
+
+java -jar .temp/tools/plantuml.jar -checkonly "$puml_source" >/dev/null
+xmllint --noout "$svg_source"
+if rg -ni 'warning|error|exception|unparsable|deprecated' "$svg_source"; then
+  echo "rendered SVG contains a warning/error marker" >&2
+  exit 1
+fi
+
+jq -e 'all(.artifacts[];
+  (.logicalReference | startswith("/") | not) and
+  (.logicalReference | contains("..") | not) and
+  (.logicalReference | contains("\\\\") | not))' \
+  .research/fixtures/TASK-260715-2kchi0_valid-pass.json >/dev/null
+
+privacy_targets=(
+  .research/260721_task-260715-2kchi0-m3-performance-evidence-protocol.md
+  .research/260722_task-260721-2ohf99-m3-validator-semantic-rules.md
+  .research/fixtures
+  scripts/tests/TASK-260715-2kchi0_test-m3-jcs-hashes.sh
+  diagrams/TASK-260715-2kchi0_measurement-evidence-flow.puml
+)
+privacy_hits=.temp/TASK-260715-2kchi0/privacy-hits.txt
+unexpected_privacy_hits=.temp/TASK-260715-2kchi0/privacy-hits-unexpected.txt
+rg -n '/Users/|/home/|file:///|BEGIN [A-Z ]*PRIVATE KEY|AKIA[0-9A-Z]{16}|tb_[A-Za-z0-9]{16,}|sk-[A-Za-z0-9]{16,}' \
+  "${privacy_targets[@]}" >"$privacy_hits" || true
+rg -v '/Users/synthetic-fixture-account/' "$privacy_hits" >"$unexpected_privacy_hits" || true
+if [[ -s "$unexpected_privacy_hits" ]]; then
+  cat "$unexpected_privacy_hits" >&2
+  echo "privacy/secret scan found a prohibited local identifier or credential shape" >&2
+  exit 1
+fi
+
+task_ids_file=.temp/TASK-260715-2kchi0/protocol-task-ids.txt
+rg -o 'TASK-[0-9]{6}-[a-z0-9]+' "$protocol_source" | sort -u >"$task_ids_file"
+[[ "$(wc -l <"$task_ids_file" | tr -d '[:space:]')" -eq 57 ]]
+while IFS= read -r task_id; do
+  task-board --no-update-check q --format compact "get($task_id) { id title status }" >/dev/null
+done <"$task_ids_file"
+
+task-board --no-update-check validate >/dev/null
+task-board --no-update-check q --format compact 'plan(STORY-260715-19ii11, mode=children)' >/dev/null
+git diff --check
+
+echo "TASK-260715-2kchi0 copy/privacy/diagram/board audit: pass"
