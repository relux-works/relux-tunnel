+                        member = tarfile.TarInfo(member_name)
+                        member.size = len(contents)
+                        member.mode = 0o755
+                        member.uid = 0
+                        member.gid = 0
+                        member.uname = "root"
+                        member.gname = "root"
+                        member.mtime = epoch
+                        bundle.addfile(member, io.BytesIO(contents))
