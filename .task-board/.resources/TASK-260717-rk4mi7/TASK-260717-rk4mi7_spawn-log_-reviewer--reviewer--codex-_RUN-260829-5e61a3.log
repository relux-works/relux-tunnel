   130	@MainActor
   131	protocol ReluxUpdateScheduling: AnyObject {
   132	  func scheduleAutomaticChecks(
   133	    every interval: TimeInterval,
   134	    using updater: any ReluxUpdaterControlling
   135	  )
   136	  func cancelAutomaticChecks(using updater: any ReluxUpdaterControlling)
   137	}
   138	
   139	@MainActor
   140	final class ReluxSparkleUpdateScheduler: ReluxUpdateScheduling {
   141	  private var scheduledInterval: TimeInterval?
   142	
   143	  func scheduleAutomaticChecks(
   144	    every interval: TimeInterval,
   145	    using updater: any ReluxUpdaterControlling
   146	  ) {
   147	    guard scheduledInterval != interval || !updater.automaticallyChecksForUpdates else { return }
   148	    scheduledInterval = interval
   149	    updater.updateCheckInterval = interval
   150	    updater.automaticallyChecksForUpdates = true
   151	    updater.resetUpdateCycle()
   152	  }
   153	
   154	  func cancelAutomaticChecks(using updater: any ReluxUpdaterControlling) {
   155	    guard scheduledInterval != nil || updater.automaticallyChecksForUpdates else { return }
   156	    scheduledInterval = nil
   157	    updater.automaticallyChecksForUpdates = false
   158	    updater.resetUpdateCycle()
   159	  }
   160	}
