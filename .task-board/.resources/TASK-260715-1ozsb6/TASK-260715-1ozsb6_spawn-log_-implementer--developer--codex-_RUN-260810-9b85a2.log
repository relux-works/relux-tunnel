+}
+
+private func fixtureDependencies(
+  port: UInt16,
+  credential: P256FixtureCredential,
+  trace: AdapterFixtureTrace
+) -> SSHTransportDependencies {
+  SSHTransportDependencies(
+    resolver: FixtureResolver(),
