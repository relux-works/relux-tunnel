+            label=label,
+            maximum_size=maximum_size,
+            expected_size=expected_size,
+        )
+    except OSError as error:
+        raise AssetManifestError(f"{label} could not be read") from error
+    finally:
+        os.close(descriptor)
+    return contents, status
