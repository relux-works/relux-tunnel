 /* Keep-alive stuff. */
 
+static void global_request_reset(LIBSSH2_SESSION *session)
+{
+    SSH2_SAFEFREE(session, session->globalReq_packet);
+    session->globalReq_packet_len = 0;
+    session->globalReq_state = ssh2_NB_state_idle;
+    memset(&session->globalReq_packet_requirev_state, 0,
+           sizeof(session->globalReq_packet_requirev_state));
+}
+
+int libssh2_session_global_request(
+    LIBSSH2_SESSION *session,
+    const char *request_name,
+    size_t request_name_len,
+    const unsigned char *payload,
+    size_t payload_len,
+    LIBSSH2_GLOBAL_REQUEST_REPLY *reply)
+{
+    static const unsigned char reply_codes[3] =
+        { SSH_MSG_REQUEST_SUCCESS, SSH_MSG_REQUEST_FAILURE, 0 };
+    unsigned char *data;
+    size_t data_len;
+    int rc;
+
+    if(!session || !reply)
+        return LIBSSH2_ERROR_BAD_USE;
+    if(!request_name || !request_name_len ||
+       request_name_len > LIBSSH2_GLOBAL_REQUEST_MAX_NAME_LENGTH ||
+       payload_len > LIBSSH2_GLOBAL_REQUEST_MAX_PAYLOAD_LENGTH ||
+       (payload_len && !payload))
+        return LIBSSH2_ERROR_INVAL;
+
+    *reply = LIBSSH2_GLOBAL_REQUEST_REPLY_NONE;
+
+    if(session->globalReq_state == ssh2_NB_state_idle) {
+        unsigned char *cursor;
+
+        session->globalReq_packet_len = 1 + 4 + request_name_len + 1 +
+            payload_len;
+        cursor = session->globalReq_packet =
+            SSH2_ALLOC(session, session->globalReq_packet_len);
+        if(!cursor)
+            return ssh2_err(session, LIBSSH2_ERROR_ALLOC,
+                            "Unable to allocate global-request packet");
+
+        *(cursor++) = SSH_MSG_GLOBAL_REQUEST;
+        ssh2_store_str(&cursor, request_name, request_name_len);
+        *(cursor++) = 1; /* want_reply */
+        if(payload_len)
+            memcpy(cursor, payload, payload_len);
+        session->globalReq_state = ssh2_NB_state_created;
+    }
+    else {
+        const unsigned char *packet_name = session->globalReq_packet + 5;
+        const unsigned char *packet_payload = packet_name + request_name_len + 1;
+
+        if(session->globalReq_packet_len !=
+           1 + 4 + request_name_len + 1 + payload_len ||
+           ssh2_ntohu32(session->globalReq_packet + 1) != request_name_len ||
+           memcmp(packet_name, request_name, request_name_len) ||
+           (payload_len && memcmp(packet_payload, payload, payload_len)))
+            return LIBSSH2_ERROR_BAD_USE;
+    }
+
+    if(session->globalReq_state == ssh2_NB_state_created) {
+        rc = ssh2_transport_send(session, session->globalReq_packet,
+                                 session->globalReq_packet_len, NULL, 0);
+        if(rc == LIBSSH2_ERROR_EAGAIN)
+            return rc;
+        if(rc) {
+            global_request_reset(session);
+            return rc;
+        }
+        session->globalReq_state = ssh2_NB_state_sent;
+    }
+
+    rc = ssh2_packet_requirev(session, reply_codes, &data, &data_len,
+                              0, NULL, 0,
+                              &session->globalReq_packet_requirev_state);
+    if(rc == LIBSSH2_ERROR_EAGAIN || rc == LIBSSH2_ERROR_TIMEOUT)
+        return rc;
+    if(rc) {
+        global_request_reset(session);
+        return rc;
+    }
+    if(data_len < 1) {
+        SSH2_FREE(session, data);
+        global_request_reset(session);
+        return ssh2_err(session, LIBSSH2_ERROR_PROTO,
+                        "Invalid global-request reply");
+    }
+
+    *reply = data[0] == SSH_MSG_REQUEST_SUCCESS ?
+        LIBSSH2_GLOBAL_REQUEST_REPLY_SUCCESS :
+        LIBSSH2_GLOBAL_REQUEST_REPLY_FAILURE;
+    SSH2_FREE(session, data);
+    global_request_reset(session);
+    return 0;
+}
+
 void libssh2_keepalive_config(LIBSSH2_SESSION *session,
                               int want_reply,
