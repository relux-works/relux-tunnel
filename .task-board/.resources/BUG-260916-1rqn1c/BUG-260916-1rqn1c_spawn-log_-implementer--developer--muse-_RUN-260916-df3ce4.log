{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc05","stream":{"kind":"session","id":"01a0aa36-84df-7ea0-97e7-e05c9626f459"},"sequence":1117,"recorded_at":1780531400002229,"record_type":"event","durability":"durable","causation_id":"c23023ed-e109-49ec-9468-86fe7a097ec0","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c23023ed-e109-49ec-9468-86fe7a097ec0","run_stream":{"kind":"run","id":"c23023ed-e109-49ec-9468-86fe7a097ec0"},"call_id":"call_01a0aa3bf9c97576947303a5c15dfcb2","text":"Read text file `scripts/select-native-xcode.sh`.\n(59 line(s) above)\n60|developer_dir=\"$xcode_app/Contents/Developer\"\n61|current_dir=$(xcode-select -p)\n62|if [ \"$current_dir\" != \"$developer_dir\" ]; then\n63|  sudo xcode-select -s \"$developer_dir\"\n64|fi\n65|\n66|version_output=$(xcodebuild -version)\n67|# Exact complete build value: the pin must equal the whole token after\n68|# \"Build version \", never a substring (17F42 must not match 17F420).\n69|build_line=$(printf '%s\\n' \"$version_output\" | grep '^Build version ' | tail -n 1)\n70|actual_build=${build_line#Build version }\n71|if [ \"$actual_build\" != \"$expected_build\" ]; then\n72|  echo \"select-native-xcode: Xcode build mismatch: expected Build version $expected_build, got $version_output\" >&2\n73|  exit 1\n74|fi\n75|\n76|echo \"select-native-xcode: using $xcode_app (Build version $expected_build)\"","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
