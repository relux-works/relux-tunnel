+            ++*eagain_count;
+            if(wait_socket(socket_fd, session) <= 0)
+                return LIBSSH2_ERROR_TIMEOUT;
+        }
+    } while(rc == LIBSSH2_ERROR_EAGAIN);
+    return rc;
