   385	  public func tryReserveHandshake() -> Result<TCPHandshakeReservation, TCPAdmissionRejection> {
   386	    state.withLock { state in
   387	      guard state.sessionHealth == .healthy else {
   388	        return .failure(reject(.sessionUnavailable, state: &state))
   389	      }
   390	      guard state.handshakes.count < configuration.maximumPendingHandshakes else {
   391	        return .failure(reject(.handshakeCapacity, state: &state))
   392	      }
   393	      guard let id = state.allocateID() else {
   394	        return .failure(reject(.identifierCapacity, state: &state))
   395	      }
   396	      state.handshakes.insert(id)
   397	      state.peakPendingHandshakes = max(state.peakPendingHandshakes, state.handshakes.count)
   398	      emitGauges(state)
   399	      return .success(TCPHandshakeReservation(registry: self, id: id))
   400	    }
   401	  }
   402	
   403	  public func admitAuthenticated(
   404	    _ handshake: TCPHandshakeReservation,
   405	    queuedBytes: TCPFlowQueuedByteReservation
   406	  ) -> Result<TCPFlowReservation, TCPAdmissionRejection> {
   407	    guard handshake.registry === self, handshake.claim() else {
   408	      recordReleaseViolation()
   409	      return .failure(TCPAdmissionRejection(reason: .sessionUnavailable))
   410	    }
   411	    return state.withLock { state in
   412	      guard state.handshakes.remove(handshake.id) != nil else {
   413	        state.releaseViolations = Self.incremented(state.releaseViolations)
   414	        diagnostics?.recordTCPAdapterCounter(.reservationReleaseViolationTotal, by: 1)
   415	        return .failure(TCPAdmissionRejection(reason: .sessionUnavailable))
   416	      }
   417	      state.acceptedAuthenticated = Self.incremented(state.acceptedAuthenticated)
   418	      diagnostics?.recordTCPAdapterCounter(.acceptedAuthenticatedTotal, by: 1)
   419	      guard state.sessionHealth == .healthy else {
   420	        emitGauges(state)
   421	        return .failure(reject(.sessionUnavailable, state: &state))
   422	      }
   423	      guard state.flows.count < configuration.maximumReservedFlows else {
   424	        emitGauges(state)
   425	        return .failure(reject(.flowCapacity, state: &state))
   426	      }
   427	      let (proposedBytes, overflow) = state.reservedQueuedBytes.addingReportingOverflow(
   428	        queuedBytes.totalBytes
   429	      )
   430	      guard !overflow, proposedBytes <= configuration.maximumAggregateQueuedBytes else {
   431	        emitGauges(state)
   432	        return .failure(reject(.queuedByteCapacity, state: &state))
   433	      }
   434	
   435	      guard let id = state.allocateID() else {
   436	        emitGauges(state)
   437	        return .failure(reject(.identifierCapacity, state: &state))
   438	      }
   439	      state.flows[id] = FlowRecord(queuedBytes: queuedBytes)
   440	      state.reservedQueuedBytes = proposedBytes
   441	      state.peakReservedFlows = max(state.peakReservedFlows, state.flows.count)
   442	      state.peakReservedQueuedBytes = max(state.peakReservedQueuedBytes, proposedBytes)
   443	      diagnostics?.recordTCPFlowReserved()
   444	      emitGauges(state)
   445	      return .success(TCPFlowReservation(registry: self, id: id))
   446	    }
   447	  }
