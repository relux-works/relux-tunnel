+    manifest_path = bundle / MANIFEST_NAME
+    manifest, encoded = load_json(manifest_path, "relay asset manifest")
+    if encoded != stable_json(manifest):
+        raise AssetManifestError("relay asset manifest is not canonical deterministic JSON")
+    validate_manifest(manifest, contract)
+    for asset, source in zip(manifest["assets"], contract["assets"], strict=True):
+        binary_path = bundle / asset["fileName"]
+        contents = read_regular_file(binary_path, "relay asset")
+        try:
+            mode = stat.S_IMODE(binary_path.stat(follow_symlinks=False).st_mode)
+        except OSError as error:
+            raise AssetManifestError("relay asset metadata is unavailable") from error
+        if mode & 0o111 == 0 or len(contents) == 0:
+            raise AssetManifestError("relay asset is zero-length or not executable")
+        if len(contents) != asset["byteSize"] or sha256_bytes(contents) != asset["sha256"]:
+            raise AssetManifestError("relay asset bytes do not match the manifest")
+        verify_binary_header(contents, source["os"], source["arch"])
