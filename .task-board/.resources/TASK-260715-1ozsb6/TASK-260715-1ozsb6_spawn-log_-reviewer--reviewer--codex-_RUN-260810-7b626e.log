  1156	
  1157	private func withTimeout<Value: Sendable>(
  1158	  _ timeout: Duration,
  1159	  clock: any TunnelClock,
  1160	  operation: @escaping @Sendable () async throws -> Value
  1161	) async throws -> Value {
  1162	  try await withThrowingTaskGroup(of: Value.self) { group in
  1163	    group.addTask { try await operation() }
  1164	    group.addTask {
  1165	      try await clock.sleep(for: timeout)
  1166	      throw LibSSH2TimeoutError.elapsed
  1167	    }
  1168	    guard let result = try await group.next() else { throw LibSSH2TimeoutError.elapsed }
  1169	    group.cancelAll()
  1170	    return result
  1171	  }
  1172	}
  1173	
  1174	extension Duration {
  1175	  fileprivate var wholeSeconds: Int64 {
  1176	    let components = components
  1177	    let fractional = components.attoseconds == 0 ? 0 : 1
  1178	    return max(1, components.seconds + Int64(fractional))
  1179	  }
  1180	}

