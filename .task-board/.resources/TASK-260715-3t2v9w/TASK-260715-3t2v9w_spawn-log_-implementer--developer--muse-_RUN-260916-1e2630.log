onfigurationGeneration,\n466|          userAction: values.action,\n467|          retryDisposition: values.retry,\n468|          context: context\n469|        )\n470|      )\n471|    )\n472|  }\n473|\n474|  private static func projection(\n475|    for cause: SSHBootstrapInternalCause\n476|  ) -> (\n477|    code: SSHBootstrapErrorCode,\n478|    stage: SSHBootstrapStage,\n479|    action: SSHBootstrapUserActionCategory,\n480|    retry: SSHBootstrapRetryDisposition\n481|  ) {\n482|    switch cause {\n483|    case .profile(let error):\n484|      let code: SSHBootstrapErrorCode =\n485|        switch error {\n486|        case .profileOversize: .profileOversize\n487|        case .profileCorrupt: .profileCorrupt\n488|        case .profileVersionUnsupported: .profileVersionUnsupported\n489|        case .profileInvalidField: .profileInvalidField\n490|        case .profileGenerationMismatch: .profileGenerationMismatch\n491|        case .profileContainsProhibitedField: .profileContainsProhibitedField\n492|        }\n493|      return (code, .profileLoad, .reviewProfile, .terminal)\n494|\n495|    case .physicalPath(let cause):\n496|      return transportProjection(cause, stage: .physicalPathResolution)\n497|    case .endpointConnect(let cause):\n498|      return transportProjection(cause, stage: .endpointConnect)\n499|    case .negotiation(let cause):\n500|      return transportProjection(cause, stage: .algorithmNegotiation)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
