  2199	    if directions & LIBSSH2_SESSION_BLOCK_INBOUND != 0 { interests.insert(.readable) }
  2200	    if directions & LIBSSH2_SESSION_BLOCK_OUTBOUND != 0 { interests.insert(.writable) }
  2201	    if interests.isEmpty { interests = [.readable, .writable] }
  2202	    let requestedInterests = interests
  2203	    try await withTimeout(
  2204	      now.duration(to: deadline),
  2205	      clock: dependencies.clock,
  2206	      registry: asyncOperations
  2207	    ) {
  2208	      try await self.context.network.service(
  2209	        connection: connection,
  2210	        interests: requestedInterests
  2211	      )
  2212	    }
  2213	  }
