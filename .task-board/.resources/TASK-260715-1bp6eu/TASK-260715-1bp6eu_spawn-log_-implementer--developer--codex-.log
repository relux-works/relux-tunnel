+private actor GatedSnapshotSource: ProviderRuntimeSnapshotSource {
+  private let gate: AsyncGate
+  private let requested = AsyncChannel<Void>()
+  private var value: TunnelRuntimePublishedSnapshot?
+
+  init(gate: AsyncGate) {
+    self.gate = gate
