+    case .borrowStopRequested: .borrowStopRequested
+    case .borrowReturned: .borrowReturned
+    case .hevDescriptorClosed: .hevDescriptorClosed
+    case .bridgeDescriptorClosed: .bridgeDescriptorClosed
