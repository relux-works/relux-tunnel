+      throw error
+    } catch {
+      throw SSHProfileSnapshotLoaderError.profileCorrupt
+    }
+  }
+
+  public static func decode(_ data: Data) throws -> SSHProfileSnapshotV1 {
+    let validation: StrictJSONValidator.ValidationResult
