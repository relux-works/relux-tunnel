     1	import AppKit
     2	import Foundation
     3	import ReluxSnapshotDiffSupport
     4	import Testing
     5	
     6	@Suite("Snapshot failure artifacts")
     7	struct SnapshotDiffSupportTests {
     8	  @Test("mismatch writes reference failed and visual diff images")
     9	  func mismatchArtifacts() throws {
    10	    let root = FileManager.default.temporaryDirectory
    11	      .appendingPathComponent("relux-snapshot-diff-\(UUID().uuidString)")
    12	    defer { try? FileManager.default.removeItem(at: root) }
    13	    try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)
    14	    let reference = root.appendingPathComponent("expected.png")
    15	    let failed = root.appendingPathComponent("actual.png")
    16	    try png(color: NSColor(deviceRed: 0, green: 0, blue: 1, alpha: 1)).write(to: reference)
    17	    try png(color: NSColor(deviceRed: 1, green: 0, blue: 0, alpha: 1)).write(to: failed)
    18	
    19	    let output = root.appendingPathComponent("artifacts")
    20	    #expect(
    21	      try !SnapshotDiff.compare(reference: reference, failed: failed, outputDirectory: output))
    22	    for name in ["reference.png", "failed.png", "diff.png"] {
    23	      #expect(FileManager.default.fileExists(atPath: output.appendingPathComponent(name).path))
    24	    }
    25	  }
    26	
    27	  private func png(color: NSColor) throws -> Data {
    28	    let image = NSImage(size: NSSize(width: 2, height: 2))
    29	    image.lockFocus()
    30	    color.setFill()
    31	    NSRect(x: 0, y: 0, width: 2, height: 2).fill()
    32	    image.unlockFocus()
    33	    guard
    34	      let tiff = image.tiffRepresentation,
    35	      let bitmap = NSBitmapImageRep(data: tiff),
    36	      let data = bitmap.representation(using: .png, properties: [:])
    37	    else {
    38	      throw SnapshotDiffError.cannotEncodePNG
    39	    }
    40	    return data
    41	  }
    42	}

===== docs/apple-ui-test-validation.md =====
     1	# Apple UI-test and screenshot validation
     2	
     3	This is the reusable UI-validation foundation for the macOS client and the
     4	shared iOS Simulator proof. It is deliberately isolated from production tunnel
     5	behavior: the two fixture hosts have no dependency on NetworkExtension, either
     6	platform adapter, the packet-tunnel provider, VPN preferences, credentials, or
     7	network clients.
     8	
     9	## Source and target ownership
    10	
    11	`ReluxAppleUITestShared` is the single source of truth for accessibility
    12	identifiers, timeout values, typed launch keys, and deterministic fixture names.
    13	The macOS containing app imports the module as a compile-time integration anchor;
    14	both fixture hosts and both UI-test targets consume the same package product.
    15	Raw `RELUX_UI_TEST_*` keys are confined to
    16	`ReluxUITestLaunchConfiguration.swift` and checked by
    17	`scripts/check-apple-ui-test-contract.py`.
    18	
    19	The generated test-only target graph is:
    20	
    21	```text
    22	ReluxProxyMacUITests -> ReluxProxyMacUITestFixtureHost -> ReluxAppleUITestShared
    23	ReluxProxyIOSUITests -> ReluxProxyIOSUITestFixtureHost -> ReluxAppleUITestShared
    24	```
    25	
    26	The dormant production `ReluxProxyIOS` and `ReluxProxyIOSTunnel` targets remain
    27	deferred. The iOS target above is a simulator-safe fixture host, not resumed
    28	product scope. Neither UI-test scheme embeds or builds a packet-tunnel provider.
    29	
    30	`ReluxUITest.PageElement`, `ComponentElement`, `PageManager`, and
    31	`Page.FixtureHost` are shared by the two UI-test targets. Page methods describe
    32	the expected state or action (`waitForAppearance`, `waitForFixture`,
    33	`confirmFixture`) and synchronize with `waitForExistence` or XCTest predicate
    34	expectations. Fixed wall-clock sleeps are prohibited by the contract check.
    35	
    36	## Deterministic fixture launch
    37	
    38	Construct only `ReluxUITest.LaunchConfiguration(fixture:)`. It generates the
    39	complete launch arguments and environment; tests and scripts must not spell raw
    40	keys independently. Parsing fails closed unless the current schema, a known
    41	fixture, UI-test mode, and the `disabled` network boundary are all present.
    42	
    43	The fixture matrix covers:
    44	
    45	- profile: empty, configured;
    46	- trust: unknown, approved, changed, revoked;
    47	- capability: available, unavailable;
    48	- failure: authentication, transport, relay;
    49	- diagnostic: empty, populated;
    50	- onboarding: required, complete;
    51	- migration: required, complete;
    52	- privacy: redacted.
    53	
    54	Every value is a deterministic non-secret enum case. The fixture host renders
    55	only public labels and cannot connect, mutate VPN preferences, request system
    56	extension or NetworkExtension approval, or bypass a production safety decision.
    57	
    58	## Smoke, xcresult, extraction, and diffs
    59	
    60	Run the focused contract gate first:
    61	
    62	```bash
    63	make apple-ui-test-contract
    64	```
    65	
    66	Run the complete build-host gate and a controlled snapshot mismatch with:
    67	
    68	```bash
    69	make apple-ui-test-smoke
    70	```
    71	
    72	Each invocation creates a unique directory below
    73	`.temp/TASK-260715-1idq8c/apple-ui-test/`. The native macOS row performs an
    74	unsigned `build-for-testing`, retains its Xcode log and `.xctestrun` product
    75	inventory, and does not launch the app or test runner. The iOS Simulator row
    76	runs the smoke, writes an `.xcresult` and Xcode log, then passes the result to
    77	`scripts/extract_apple_ui_test_artifacts.py`. The extractor exports only
    78	`Step_*` PNG attachments into test-specific directories and writes
    79	`screenshots.json`. The runtime row then independently validates that manifest,
    80	requires non-empty PNG files for both expected smoke steps, and propagates any
    81	extractor or validation failure to the aggregate gate. The focused contract
    82	gate includes an injected extractor-failure regression against the production
    83	smoke script.
    84	
    85	The controlled mismatch invokes `relux-snapshot-diff`. An image mismatch is the
    86	expected exit code `1` and must produce the three review files
    87	`reference.png`, `failed.png`, and `diff.png`. Exit `0` means the images match;
    88	exit `2` means the comparison could not be performed. Product-screen SwiftUI
    89	snapshot suites are intentionally not added before product screens exist; the
    90	diff engine and Swift Testing artifact suite establish the failure workflow
    91	without inventing business UI.
    92	
    93	This workstation keeps `CODE_SIGNING_ALLOWED=NO` and
    94	`CODE_SIGNING_REQUIRED=NO`. The iOS Simulator row can run unsigned. Native
    95	macOS runtime proof is explicitly deferred to `TASK-260822-3q4grm` on the
    96	dedicated signed test host. `summary.txt` records that owner and distinguishes
    97	the successful native macOS build-for-testing row from the deferred runtime
    98	row. Do not sign, install, or launch the native fixture here to make that row
    99	look complete.
   100	
   101	## Mandatory visual review
   102	
   103	Extraction is not acceptance. A human or reviewing agent must open every
   104	step-named PNG and record a result for all four checks:
   105	
   106	| Check | Required evidence |
   107	| --- | --- |
   108	| Orientation | expected portrait/landscape orientation; no rotation or sideways content |
   109	| Layout | content uses the expected viewport; no clipped, collapsed, or corner-squashed UI |
   110	| Content | required state labels/actions are present and readable |
   111	| Rendering | image is not empty, black, frozen on launch, or otherwise missing the app UI |
   112	
   113	Record the inspected filenames, destination, and pass/fail findings in the
   114	task-scoped outcome. A passing test process without this review is incomplete.
   115	
   116	## Separate physical-device evidence contract
   117	
   118	Physical-device-only evidence is never inferred from Simulator, native Mac, or
   119	unsigned build results. Each later physical row must attach a separate resource
   120	named `TASK-<row-id>_physical-apple-ui-evidence.md` and a task-scoped artifact
   121	directory containing:
   122	
   123	- device class/model and OS/build (identifier redacted to a non-reversible
   124	  suffix or lane-local alias);
   125	- exact authorized test command, destination class, scheme, test identifier,
   126	  and exit code;
   127	- `.xcresult`, extracted step screenshots, and `screenshots.json`;
   128	- the four-field visual review above for every screenshot;
   129	- signing/provisioning lane name without certificate, profile, Keychain, UDID,
   130	  credential, or secret bytes;
   131	- explicit statement whether the row is fixture-only or separately authorized
   132	  for product/system VPN behavior.
   133	
   134	Any row that installs or launches the product/provider, requests approval,
   135	creates or changes VPN preferences, or exercises real routing/DNS/tunnel state
   136	belongs to its named physical security gate and must not be run under this
   137	fixture smoke contract. Designed-for-iPad Mac is not a UI-test destination.

===== scripts/check-apple-ui-test-contract.py =====
     1	#!/usr/bin/env python3
     2	"""Static safety and single-source checks for Apple UI-test infrastructure."""
     3	
     4	from __future__ import annotations
     5	
     6	import re
     7	from pathlib import Path
     8	
     9	
    10	ROOT = Path(__file__).resolve().parent.parent
    11	SHARED = ROOT / "Sources/ReluxAppleUITestShared"
    12	FIXTURE_HOST = ROOT / "App/ReluxUITestFixtureHost"
    13	UI_TESTS = ROOT / "Tests/ReluxAppleUITestsShared"
    14	LAUNCH_KEYS = SHARED / "ReluxUITestLaunchConfiguration.swift"
    15	
    16	
    17	def fail(message: str) -> None:
    18	    raise SystemExit(f"error: {message}")
    19	
    20	
    21	def swift_files(*roots: Path) -> list[Path]:
    22	    return sorted(path for root in roots for path in root.rglob("*.swift"))
    23	
    24	
    25	def main() -> int:
    26	    files = swift_files(SHARED, FIXTURE_HOST, UI_TESTS)
    27	    if not files:
    28	        fail("Apple UI-test sources are missing")
    29	
    30	    forbidden_waits = re.compile(r"\b(Thread\.sleep|sleep|usleep)\s*\(")
    31	    for path in files:
    32	        text = path.read_text(encoding="utf-8")
    33	        if forbidden_waits.search(text):
    34	            fail(f"fixed wall-clock wait found in {path.relative_to(ROOT)}")
    35	        if path != LAUNCH_KEYS and "RELUX_UI_TEST_" in text:
    36	            fail(f"raw launch key duplicated outside shared authority: {path.relative_to(ROOT)}")
    37	
    38	    project = (ROOT / "Project.swift").read_text(encoding="utf-8")
    39	    for name in (
    40	        "ReluxProxyMacUITestFixtureHost",
    41	        "ReluxProxyMacUITests",
    42	        "ReluxProxyIOSUITestFixtureHost",
    43	        "ReluxProxyIOSUITests",
    44	    ):
    45	        if name not in project:
    46	            fail(f"missing generated target definition: {name}")
    47	    infrastructure = project[project.index("private let appleUITestInfrastructureTargets") :]
    48	    infrastructure = infrastructure[: infrastructure.index("private var generatedSchemeNames")]
    49	    for forbidden in ("NetworkExtension", "ReluxTunnelIOSAdapter", "ReluxTunnelMacOSAdapter"):
    50	        if forbidden in infrastructure:
    51	            fail(f"fixture graph contains prohibited production dependency: {forbidden}")
    52	
    53	    fixtures = (SHARED / "ReluxUITestFixture.swift").read_text(encoding="utf-8")
    54	    for category in (
    55	        "profile",
    56	        "trust",
    57	        "capability",
    58	        "failure",
    59	        "diagnostic",
    60	        "onboarding",
    61	        "migration",
    62	        "privacy",
    63	    ):
    64	        if f"case {category}" not in fixtures:
    65	            fail(f"fixture category missing: {category}")
    66	
    67	    smoke = (ROOT / "scripts/run-apple-ui-test-smoke.sh").read_text(encoding="utf-8")
    68	    for required in (
    69	        "build-for-testing",
    70	        "macos_runtime_status=deferred",
    71	        "macos_runtime_owner=TASK-260822-3q4grm",
    72	        "validate_apple_ui_test_artifacts.py",
    73	        "ios_simulator_artifact_exit",
    74	        "aggregate_build_host_exit",
    75	    ):
    76	        if required not in smoke:
    77	            fail(f"build-host smoke contract missing: {required}")
    78	    if "run_ui_test \\\n  ReluxProxyMacUITests" in smoke:
    79	        fail("build-host smoke must not launch native macOS XCUITest")
    80	
    81	    print("Apple UI-test source, synchronization, fixture, and safety contracts passed")
    82	    return 0
    83	
    84	
    85	if __name__ == "__main__":
    86	    raise SystemExit(main())

===== scripts/extract_apple_ui_test_artifacts.py =====
     1	#!/usr/bin/env python3
     2	"""Extract step screenshots from xcresult into a task-scoped review directory."""
     3	
     4	from __future__ import annotations
     5	
     6	import argparse
     7	import json
     8	import re
     9	import shutil
    10	import subprocess
    11	from pathlib import Path
    12	
    13	
    14	SAFE_COMPONENT = re.compile(r"[^A-Za-z0-9._-]+")
    15	
    16	
    17	def safe_component(value: str) -> str:
    18	    value = SAFE_COMPONENT.sub("_", value).strip("._")
    19	    return value or "unnamed"
    20	
    21	
    22	def organize_attachments(export_directory: Path, output_directory: Path) -> list[dict[str, str]]:
    23	    manifest_path = export_directory / "manifest.json"
    24	    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    25	    records: list[dict[str, str]] = []
    26	    for test in manifest:
    27	        test_name = safe_component(test["testIdentifier"])
    28	        for attachment in test["attachments"]:
    29	            source = export_directory / attachment["exportedFileName"]
    30	            suggested = attachment["suggestedHumanReadableName"]
    31	            if source.suffix.lower() != ".png" or not suggested.startswith("Step_"):
    32	                continue
    33	            destination_directory = output_directory / "screenshots" / test_name
    34	            destination_directory.mkdir(parents=True, exist_ok=True)
    35	            suggested_stem = suggested[:-4] if suggested.lower().endswith(".png") else suggested
    36	            destination = destination_directory / f"{safe_component(suggested_stem)}.png"
    37	            shutil.copy2(source, destination)
    38	            records.append(
    39	                {
    40	                    "test": test["testIdentifier"],
    41	                    "name": suggested,
    42	                    "path": str(destination),
    43	                    "failure": str(bool(attachment["isAssociatedWithFailure"])).lower(),
    44	                }
    45	            )
    46	    records.sort(key=lambda record: (record["test"], record["name"]))
    47	    return records
    48	
    49	
    50	def main() -> int:
    51	    parser = argparse.ArgumentParser()
    52	    parser.add_argument("xcresult", type=Path)
    53	    parser.add_argument("output", type=Path)
    54	    args = parser.parse_args()
    55	
    56	    if ".temp" not in args.output.parts:
    57	        parser.error("output must be task-scoped beneath .temp")
    58	    export_directory = args.output / "xcresult-attachments"
    59	    screenshots_directory = args.output / "screenshots"
    60	    if export_directory.exists():
    61	        shutil.rmtree(export_directory)
    62	    if screenshots_directory.exists():
    63	        shutil.rmtree(screenshots_directory)
    64	    export_directory.mkdir(parents=True)
    65	    subprocess.run(
    66	        [
    67	            "xcrun",
    68	            "xcresulttool",
    69	            "export",
    70	            "attachments",
    71	            "--path",
    72	            str(args.xcresult),
    73	            "--output-path",
    74	            str(export_directory),
    75	        ],
    76	        check=True,
    77	    )
    78	    records = organize_attachments(export_directory, args.output)
    79	    summary = {
    80	        "schemaVersion": 1,
    81	        "xcresult": str(args.xcresult),
    82	        "stepScreenshotCount": len(records),
    83	        "screenshots": records,
    84	    }
    85	    (args.output / "screenshots.json").write_text(
    86	        json.dumps(summary, indent=2, sort_keys=True) + "\n",
    87	        encoding="utf-8",
    88	    )
    89	    if not records:
    90	        raise SystemExit("no step-named PNG screenshots found")
    91	    print(f"extracted {len(records)} step screenshots to {args.output / 'screenshots'}")
    92	    return 0
    93	
    94	
    95	if __name__ == "__main__":
    96	    raise SystemExit(main())

===== scripts/generate-snapshot-diff-fixtures.swift =====
     1	#!/usr/bin/swift
     2	import AppKit
     3	import Foundation
     4	
     5	guard CommandLine.arguments.count == 2 else {
     6	  FileHandle.standardError.write(
     7	    Data("usage: generate-snapshot-diff-fixtures.swift OUTPUT_DIRECTORY\n".utf8))
     8	  exit(2)
     9	}
    10	
    11	let output = URL(fileURLWithPath: CommandLine.arguments[1], isDirectory: true)
    12	try FileManager.default.createDirectory(at: output, withIntermediateDirectories: true)
    13	
    14	func write(_ color: NSColor, to url: URL) throws {
    15	  guard
    16	    let bitmap = NSBitmapImageRep(
    17	      bitmapDataPlanes: nil,
    18	      pixelsWide: 32,
    19	      pixelsHigh: 32,
    20	      bitsPerSample: 8,
    21	      samplesPerPixel: 4,
    22	      hasAlpha: true,
    23	      isPlanar: false,
    24	      colorSpaceName: .deviceRGB,
    25	      bytesPerRow: 0,
    26	      bitsPerPixel: 0
    27	    )
    28	  else {
    29	    throw CocoaError(.fileWriteUnknown)
    30	  }
    31	  for y in 0..<bitmap.pixelsHigh {
    32	    for x in 0..<bitmap.pixelsWide {
    33	      bitmap.setColor(color, atX: x, y: y)
    34	    }
    35	  }
    36	  guard let data = bitmap.representation(using: .png, properties: [:]) else {
    37	    throw CocoaError(.fileWriteUnknown)
    38	  }
    39	  try data.write(to: url, options: .atomic)
    40	}
    41	
    42	try write(
    43	  NSColor(deviceRed: 0.10, green: 0.35, blue: 0.90, alpha: 1),
    44	  to: output.appendingPathComponent("reference-input.png")
    45	)
    46	try write(
    47	  NSColor(deviceRed: 0.95, green: 0.35, blue: 0.10, alpha: 1),
    48	  to: output.appendingPathComponent("failed-input.png")
    49	)

===== scripts/run-apple-ui-test-smoke.sh =====
     1	#!/bin/sh
     2	set -eu
     3	
     4	repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
     5	task_root=${RELUX_APPLE_UI_TEST_OUTPUT_ROOT:-"$repo_root/.temp/TASK-260715-1idq8c/apple-ui-test"}
     6	workspace_generator=${RELUX_APPLE_UI_TEST_WORKSPACE_GENERATOR:-"$repo_root/scripts/generate-workspace.sh"}
     7	xcodebuild_command=${RELUX_APPLE_UI_TEST_XCODEBUILD:-xcodebuild}
     8	xcrun_command=${RELUX_APPLE_UI_TEST_XCRUN:-xcrun}
     9	extractor_command=${RELUX_APPLE_UI_TEST_EXTRACTOR:-"$repo_root/scripts/extract_apple_ui_test_artifacts.py"}
    10	swift_command=${RELUX_APPLE_UI_TEST_SWIFT:-swift}
    11	mkdir -p "$task_root"
    12	run_root=$(mktemp -d "$task_root/run.XXXXXX")
    13	macos_derived_data="$run_root/DerivedData-macos"
    14	ios_derived_data="$run_root/DerivedData-ios-simulator"
    15	cd "$repo_root"
    16	
    17	"$workspace_generator" --clean
    18	
    19	build_macos_for_testing() {
    20	  log="$run_root/macos-build-for-testing-xcodebuild.log"
    21	  products="$run_root/macos-build-for-testing-products.txt"
    22	
    23	  if "$xcodebuild_command" \
    24	    -workspace ReluxTunnel.xcworkspace \
    25	    -scheme ReluxProxyMacUITests \
    26	    -configuration Debug \
    27	    -destination 'platform=macOS' \
    28	    -derivedDataPath "$macos_derived_data" \
    29	    CODE_SIGNING_ALLOWED=NO \
    30	    CODE_SIGNING_REQUIRED=NO \
    31	    build-for-testing > "$log" 2>&1; then
    32	    row_status=0
    33	  else
    34	    row_status=$?
    35	  fi
    36	
    37	  find \
    38	    "$repo_root/.build/Products" \
    39	    "$macos_derived_data/Build/Products" \
    40	    -name 'ReluxProxyMacUITests_*.xctestrun' -print \
    41	    > "$products" 2>/dev/null || true
    42	  if [ "$row_status" -eq 0 ] && [ ! -s "$products" ]; then
    43	    echo "error: native macOS build-for-testing produced no xctestrun" >> "$log"
    44	    row_status=1
    45	  fi
    46	  return "$row_status"
    47	}
    48	
    49	run_ui_test() {
    50	  scheme=$1
    51	  destination=$2
    52	  result_name=$3
    53	  test_target=$4
    54	  result_bundle="$run_root/$result_name.xcresult"
    55	  artifacts_directory="$run_root/$result_name-artifacts"
    56	  log="$run_root/$result_name-xcodebuild.log"
    57	
    58	  if "$xcodebuild_command" \
    59	    -workspace ReluxTunnel.xcworkspace \
    60	    -scheme "$scheme" \
    61	    -configuration Debug \
    62	    -destination "$destination" \
    63	    -derivedDataPath "$ios_derived_data" \
    64	    -resultBundlePath "$result_bundle" \
    65	    -only-testing:"$test_target/ReluxUITestSmokeTests/testDiagnosticFixtureProducesStepScreenshots" \
    66	    CODE_SIGNING_ALLOWED=NO \
    67	    CODE_SIGNING_REQUIRED=NO \
    68	    test > "$log" 2>&1; then
    69	    row_status=0
    70	  else
    71	    row_status=$?
    72	  fi
    73	  ui_test_xcodebuild_status=$row_status
    74	
    75	  if [ "$row_status" -ne 0 ]; then
    76	    ui_test_artifact_status=not_run
    77	    return "$row_status"
    78	  fi
    79	
    80	  if "$extractor_command" "$result_bundle" "$artifacts_directory" >> "$log" 2>&1; then
    81	    :
    82	  else
    83	    extraction_status=$?
    84	    ui_test_artifact_status=$extraction_status
    85	    echo "error: screenshot extraction failed with exit $extraction_status" >> "$log"
    86	    return "$extraction_status"
    87	  fi
    88	
    89	  if python3 scripts/validate_apple_ui_test_artifacts.py \
    90	    "$artifacts_directory" \
    91	    --expected-step Step_01__diagnostic_fixture_ready \
    92	    --expected-step Step_02__diagnostic_fixture_confirmed >> "$log" 2>&1; then
    93	    ui_test_artifact_status=0
    94	    return 0
    95	  else
    96	    validation_status=$?
    97	    ui_test_artifact_status=$validation_status
    98	    echo "error: screenshot evidence validation failed with exit $validation_status" >> "$log"
    99	    return "$validation_status"
   100	  fi
   101	}
   102	
   103	if build_macos_for_testing; then
   104	  macos_status=0
   105	else
   106	  macos_status=$?
   107	fi
   108	
   109	simulator_id=$(
   110	  "$xcrun_command" simctl list devices available -j | python3 -c '
   111	import json, sys
   112	devices = json.load(sys.stdin)["devices"]
   113	for runtime in sorted(devices, reverse=True):
   114	    for device in devices[runtime]:
   115	        if device.get("isAvailable") and device.get("name", "").startswith("iPhone"):
   116	            print(device["udid"])
   117	            raise SystemExit(0)
   118	raise SystemExit("no available iPhone Simulator")
   119	'
   120	)
   121	if run_ui_test \
   122	  ReluxProxyIOSUITests \
   123	  "platform=iOS Simulator,id=$simulator_id" \
   124	  ios-simulator \
   125	  ReluxProxyIOSUITests; then
   126	  ios_status=0
   127	else
   128	  ios_status=$?
   129	fi
   130	ios_xcodebuild_status=$ui_test_xcodebuild_status
   131	ios_artifact_status=$ui_test_artifact_status
   132	
   133	snapshot_inputs="$run_root/snapshot-inputs"
   134	snapshot_artifacts="$run_root/snapshot-diff-artifacts/controlled-mismatch"
   135	"$swift_command" scripts/generate-snapshot-diff-fixtures.swift "$snapshot_inputs"
   136	set +e
   137	"$swift_command" run relux-snapshot-diff \
   138	  "$snapshot_inputs/reference-input.png" \
   139	  "$snapshot_inputs/failed-input.png" \
   140	  "$snapshot_artifacts" > "$run_root/snapshot-diff.log" 2>&1
   141	snapshot_status=$?
   142	set -e
   143	if [ "$snapshot_status" -ne 1 ]; then
   144	  echo "error: controlled snapshot mismatch returned $snapshot_status, expected 1" >&2
   145	  exit 1
   146	fi
   147	for artifact in reference.png failed.png diff.png; do
   148	  test -f "$snapshot_artifacts/$artifact"
   149	done
   150	
   151	if [ "$macos_status" -eq 0 ] && [ "$ios_status" -eq 0 ]; then
   152	  aggregate_status=0
   153	else
   154	  aggregate_status=1
   155	fi
   156	
   157	printf '%s\n' \
   158	  "macos_build_for_testing_exit=$macos_status" \
   159	  'macos_runtime_status=deferred' \
   160	  'macos_runtime_owner=TASK-260822-3q4grm' \
   161	  "ios_simulator_xcodebuild_exit=$ios_xcodebuild_status" \
   162	  "ios_simulator_artifact_exit=$ios_artifact_status" \
   163	  "ios_simulator_row_exit=$ios_status" \
   164	  "snapshot_diff_exit=$snapshot_status" \
   165	  "aggregate_build_host_exit=$aggregate_status" \
   166	  > "$run_root/summary.txt"
   167	printf '%s\n' "$run_root"
   168	
   169	exit "$aggregate_status"

