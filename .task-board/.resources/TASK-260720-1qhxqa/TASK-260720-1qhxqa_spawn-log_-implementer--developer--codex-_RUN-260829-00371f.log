+    "taskId",
+    "acceptedOutcome",
+    "reviewerVerdict",
+    "supersession",
+    "sourceOrBinaryPins",
+    "requiredCapabilities",
+    "bindings",
+    "licenseAndMaintenanceObligations",
+    "revalidationTriggers",
+}
+RESOURCE_KEYS = {"resourceName", "sha256"}
+VERDICT_KEYS = {
+    "resourceName",
+    "sha256",
+    "verdict",
+    "acceptedAt",
+    "timestampPrecision",
+}
+SUPERSESSION_KEYS = {"status", "supersededBy"}
+COMPATIBILITY_KEYS = {"id", "result", "condition"}
+CONSUMER_KEYS = {
+    "taskId",
+    "soleM0BindingSource",
+    "productionCallSite",
+    "failureBehavior",
+}
