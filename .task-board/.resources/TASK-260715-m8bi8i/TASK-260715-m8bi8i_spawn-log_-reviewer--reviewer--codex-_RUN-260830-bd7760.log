/bin/zsh -lc "sed -n '261,500p' /Users/iv/.claude/skills/architecture-diagrams/SKILL.md && wc -l /Users/iv/.claude/skills/project-management/references/statuses.md /Users/iv/.claude/skills/project-management/references/resources-and-bugs.md /Users/iv/.claude/skills/project-management/references/roles.md /Users/iv/.claude/skills/project-management/references/negative-evidence.md && sed -n '1,260p' /Users/iv/.claude/skills/project-management/references/statuses.md && sed -n '1,260p' /Users/iv/.claude/skills/project-management/references/resources-and-bugs.md && sed -n '1,260p' /Users/iv/.claude/skills/project-management/references/roles.md && sed -n '1,260p' /Users/iv/.claude/skills/project-management/references/negative-evidence.md" in /Users/iv/Developer/relux-tunnel/.temp/STORY-260715-1y04r0/worktree
