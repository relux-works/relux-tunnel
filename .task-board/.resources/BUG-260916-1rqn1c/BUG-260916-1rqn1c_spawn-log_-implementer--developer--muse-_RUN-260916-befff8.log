{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c831","stream":{"kind":"session","id":"01a0aa16-3b54-7fb3-a8e8-7c1297771955"},"sequence":627,"recorded_at":1780531400001249,"record_type":"event","durability":"durable","causation_id":"2c2593ed-ac6a-4422-9347-544e1af6ae8d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2c2593ed-ac6a-4422-9347-544e1af6ae8d","run_stream":{"kind":"run","id":"2c2593ed-ac6a-4422-9347-544e1af6ae8d"},"task_stream":{"kind":"task","id":"01a0aa18-3728-7fd3-9b9a-2fb3e5379f45"},"task_id":"01a0aa18-3728-7fd3-9b9a-2fb3e5379f45","event":{"kind":"output","task_id":"01a0aa18-3728-7fd3-9b9a-2fb3e5379f45","chunk":"Read text file `scripts/libssh2-fork-tool.py`.\n(499 line(s) above)\n500|                \"inspect\",\n501|                \"--dependency\",\n502|                DEPENDENCY_NAME,\n503|                \"--xcframework\",\n504|                str(candidate),\n505|            ]\n506|        )\n507|        output = output.resolve()\n508|        if output.suffix != \".xcframework\" or output == REPOSITORY_ROOT:\n509|            raise ForkError(f\"refusing unsafe XCFramework output path: {output}\")\n510|        output.parent.mkdir(parents=True, exist_ok=True)\n511|        if output.exists():\n512|            shutil.rmtree(output)\n513|        shutil.copytree(candidate, output, copy_function=shutil.copy2)\n514|\n515|    print(json.dumps(artifact_hashes(output), indent=2, sort_keys=True))\n516|\n517|\n518|def verify_xcode_build(item: dict[str, Any]) -> None:\n519|    output = run([\"xcodebuild\", \"-version\"], capture=True)\n520|    expected = f\"Build version {item['compiler']['xcode_build']}\"\n521|    if expected not in output:\n522|        raise ForkError(f\"Xcode build mismatch: expected {expected}, got {output.strip()}\")\n523|\n524|\n525|def verify_artifact(item: dict[str, Any]) -> None:\n526|    verify_patch_manifest(item)\n527|    verify_xcode_build(item)\n528|    artifact = REPOSITORY_ROOT / item[\"integration\"][\"artifact_path\"]\n529|    run(\n530|        [\n531|            str(REPOSITORY_ROOT / \"scripts\" / \"native-dependency-tool.py\"),\n532|            \"inspect\",\n533|            \"--dependency\",\n534|            DEPENDENCY_NAME,\n535|            \"--xcframework\",\n536|            str(artifact),\n537|            \"--verify-lock\",\n538|        ]\n539|    )\n540|    for slice_ in item[\"compiler\"][\"slices\"]:\n541|        slice_dir = artifact / slice_[\"library_identifier\"]\n542|        archive = slice_dir / \"libReluxLibSSH2.a\"\n543|        symbols = run([\"nm\", \"-gU\", str(archive)], capture=True)\n544|        for symbol in item[\"integration\"][\"required_symbols\"]:\n545|            if f\"_{symbol}\" not in symbols.split():\n546|                raise ForkError(f\"missing public symbol {symbol} in {archive}\")\n547|        headers = slice_dir / \"Headers\"\n548|        actual_headers = sorted(path.name for path in headers.iterdir() if path.is_file())\n549|        if actual_headers != sorted(item[\"integration\"][\"public_headers\"]):\n550|            raise ForkError(f\"unexpected public headers in {slice_dir}: {actual_headers}\")\n551|        public_header = (headers / \"libssh2.h\").read_text(encoding=\"utf-8\")\n552|        required_declarations = (\n553|            \"LIBSSH2_API int libssh2_session_rekey\",\n554|            \"LIBSSH2_API void libssh2_session_server_kex_observer_set\",\n555|            \"LIBSSH2_API int libssh2_session_server_kex_status\",\n556|            \"LIBSSH2_API int libssh2_session_global_request\",\n557|        )\n558|        if any(\n559|            declaration not in public_header\n560|            for declaration in required_declarations\n561|        ):\n562|            raise ForkError(\"XCFramework public header omits an observation API\")\n563|        if (headers / \"libssh2_priv.h\").exists():\n564|            raise ForkError(\"private libssh2 header leaked into XCFramework\")\n565|\n566|    notice_path = REPOSITORY_ROOT / item[\"license\"][\"notices_output\"]\n567|    if not notice_path.is_file():\n568|        raise ForkError(f\"missing generated notices: {notice_path}\")\n569|    actual_notice_hash = sha256_file(notice_path)\n570|    if actual_notice_hash != item[\"license\"][\"notices_sha256\"]:\n571|        raise ForkError(\n572|            f\"notice hash mismatch: expected {item['license']['notices_sha256']}, \"\n573|            f\"got {actual_notice_hash}\"\n574|        )\n575|    package = (REPOSITORY_ROOT / \"Package.swift\").read_text(encoding=\"utf-8\")\n576|    if 'name: \"ReluxLibSSH2\"' not in package or item[\"integration\"][\"artifact_path\"] not in package:\n577|        raise ForkError(\"Package.swift does not expose the ReluxLibSSH2 binary target\")\n578|\n579|\n(more lines below)","final_result":true}}}
