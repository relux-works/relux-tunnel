-    return try result.get()
-  }
+  let race = LibSSH2TimeoutRace(
+    timeout: timeout,
+    clock: clock,
+    registry: registry,
+    operation: operation
+  )
+  try registry.register(race)
+  race.start()
+  return try await race.wait()
