   683	      guard now < deadline else { throw LibSSH2TimeoutError.elapsed }
   684	      try await withTimeout(
   685	        now.duration(to: deadline),
   686	        clock: dependencies.clock,
   687	        registry: asyncOperations
   688	      ) {
   689	        try await waiter.wait()
   690	      }
   691	    } catch {
   692	      rekeyWaiters.removeValue(forKey: waiter.identifier)
