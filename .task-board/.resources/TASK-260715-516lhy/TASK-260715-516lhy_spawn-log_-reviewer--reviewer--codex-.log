   395	private func patternedData(count: Int) -> Data {
   396	  Data((0..<count).map { UInt8(truncatingIfNeeded: $0 &* 31 &+ 7) })
   397	}
   398	
   399	/// Independent HEV oracle: the header tails above are literal recorded layout
   400	/// bytes, and only the unsigned network-order MSGLEN is inserted here.
   401	private func hevOracle(headerTail: [UInt8], data: Data) -> Data {
   402	  var wire = Data([
   403	    UInt8(truncatingIfNeeded: data.count >> 8),
   404	    UInt8(truncatingIfNeeded: data.count),
   405	  ])
   406	  wire.append(contentsOf: headerTail)
   407	  wire.append(data)
   408	  return wire
   409	}
