│   │   ├── containers.dsl       # Container view
│   │   └── components.dsl       # Component views
│   └── styles/
│       └── styles.dsl           # Visual theme
├── plantuml/
│   ├── _includes/               # Shared styling (optional)
│   │   ├── theme.puml
│   │   └── common.puml
│   ├── sequence/
│   │   └── auth-flow.puml
│   └── component/
│       └── api-structure.puml
└── artefacts/                   # Generated outputs (PNG/SVG)
    ├── c4/
    └── plantuml/
```

