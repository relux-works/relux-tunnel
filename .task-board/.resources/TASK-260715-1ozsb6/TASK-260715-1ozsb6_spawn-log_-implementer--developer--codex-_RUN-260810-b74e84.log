+  @unchecked Sendable
+{
+  enum Child {
+    case operation
+    case timer
+  }
+
+  let identifier = UUID()
+
+  private let lock = NSLock()
+  private weak var registry: LibSSH2OwnedAsyncOperationRegistry?
