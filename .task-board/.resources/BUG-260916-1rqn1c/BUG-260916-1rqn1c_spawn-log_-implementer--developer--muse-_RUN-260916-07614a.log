:\\n./scripts/tests/test_native_toolchain_alignment.py:25:# Xcode 26.5 build 17F42 ships at /Applications/Xcode_26.5.app on macos-26,\\n./scripts/tests/test_native_toolchain_alignment.py:26:# whose default is Xcode 26.6 build 17F113. macos-15 tops out at Xcode 26.3\\n./scripts/tests/test_native_toolchain_alignment.py:29:REQUIRED_RUNS_ON = \\\"macos-26\\\"\\n./scripts/tests/test_native_toolchain_alignment.py:70:            # Stage the pinned app plus the macos-26 default as a decoy, so a\\n./scripts/tests/test_native_toolchain_alignment.py:119:        self.assertIn(f\\\"runs-on: {REQUIRED_RUNS_ON}\\\", block,\\n./scripts/tests/test_native_toolchain_alignment.py:120:                      \\\"credential-free job must run on macos-26: macos-15 ships \\\"\\n./scripts/tests/test_native_toolchain_alignment.py:122:        self.assertNotIn(\\\"runs-on: macos-15\\\\n\\\", block + \\\"\\\\n\\\")\\n./scripts/tests/test_native_toolchain_alignment.py:128:                      \\\"the macos-26 default (Xcode 26.6, 17F113) is not the pin\\\")\\n./scripts/tests/test_native_toolchain_alignment.py:159:        # Mirrors hosted run35091586150: macos-15 default Xcode 16.4 (16F6).\\n./scripts/tests/test_native_toolchain_alignment.py:169:        # macos-26 default Xcode 26.6 (17F113) is close to but not the pin.\\n./scripts/select-native-xcode.sh:42:# (actions/runner-images images/macos/macos-26-arm64-Readme.md). A build with\\n./.github/workflows/ci.yml:19:    # macos-26 is the arm64 image; keep this label paired with the arm64 Mise checksum.\\n./.github/workflows/ci.yml:21:    # present on macos-26, absent from macos-15 (at most Xcode 26.3).\\n./.github/workflows/ci.yml:22:    runs-on: macos-26\\n./.github/workflows/ci.yml:45:        # The macos-26 default is Xcode 26.6 (17F113); native verification\\n./.github/workflows/ci.yml:72:    runs-on: ubuntu-latest\\n./.github/workflows/ci.yml:110:    runs-on: ubuntu-24.04\\n./.github/workflows/ci.yml:150:            runner: macos-15-intel\\n./.