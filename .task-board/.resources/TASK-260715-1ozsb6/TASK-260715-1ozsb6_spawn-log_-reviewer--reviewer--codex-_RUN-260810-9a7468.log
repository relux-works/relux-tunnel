  1864	    byteRekeyScheduled = true
  1865	    byteRekeyTask = Task { [weak self] in
  1866	      try? await self?.requestRekey(reason: .byteThreshold, waitsForFatalTeardown: false)
  1867	      await self?.clearByteRekeySchedule()
  1868	    }
  1869	  }
