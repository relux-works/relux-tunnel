   715	  private func sendKeepalive(
   716	    deferBehindRekey: Bool
   717	  ) async throws -> SSHDeferredSemanticReport<Duration> {
   718	    guard let configuration else {
   719	      throw transportError(code: .invalidState, phase: .keepalive)
   720	    }
   721	    guard !keepaliveInFlight else {
   722	      throw transportError(code: .operationInProgress, phase: .keepalive, scope: .operation)
   723	    }
   724	    keepaliveInFlight = true
   725	    let timeout = min(
   726	      configuration.timeouts.keepaliveReply,
   727	      configuration.keepalive.replyTimeout
   728	    )
   729	    let now = dependencies.clock.now()
   730	    let admissionDeadline =
   731	      if deferBehindRekey, state == .rekeying {
   732	        rekeyFlightDeadline ?? now.advanced(by: configuration.rekey.timeout)
   733	      } else {
   734	        now.advanced(by: timeout)
   735	      }
   736	    let permit: LibSSH2SessionOperationPermit
   737	    do {
   738	      permit = try await beginSessionOperation(
   739	        phase: .keepalive,
   740	        until: admissionDeadline,
   741	        allowsRekeying: true,
   742	        scope: .operation
   743	      )
   744	    } catch {
   745	      keepaliveInFlight = false
   746	      throw error
   747	    }
   748	    do {
   749	      let replyDeadline = dependencies.clock.now().advanced(by: timeout)
   750	      let result = try await performSendKeepalive(until: replyDeadline)
   751	      finishSessionOperation(permit)
   752	      keepaliveInFlight = false
   753	      return result
   754	    } catch {
   755	      finishSessionOperation(permit)
   756	      keepaliveInFlight = false
   757	      let mapped = await handleOperationFailure(
   758	        error,
   759	        phase: .keepalive,
   760	        fallback: .keepaliveFailed,
   761	        scope: .operation
   762	      )
   763	      throw mapped
   764	    }
   765	  }
