cleanup() {
  case "$DRIFT_TEMP" in
    "${TMPDIR:-/tmp}"/relux-probe-drift.*) rm -rf "$DRIFT_TEMP" ;;
    *) echo "refusing to clean unexpected drift-test path" >&2 ;;
  esac
}
trap cleanup EXIT INT TERM

expect_drift() {
  name="$1"
  expected="$2"
  app="$3"
