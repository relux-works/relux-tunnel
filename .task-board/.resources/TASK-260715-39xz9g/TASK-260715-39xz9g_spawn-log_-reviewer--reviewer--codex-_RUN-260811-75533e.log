   438	class TCPImpairmentProxy:
   439	    """Applies latency or deterministic connection loss to an SSH TCP path."""
   440	
   441	    def __init__(
   442	        self,
   443	        upstream_host: str,
   444	        upstream_port: int,
   445	        *,
   446	        latency_milliseconds: int = 0,
   447	        deterministic_drop_every: int = 0,
   448	    ):
   449	        if latency_milliseconds < 0 or deterministic_drop_every < 0:
   450	            raise FixtureError("network impairment values cannot be negative")
   451	        self.upstream = (upstream_host, upstream_port)
   452	        self.latency_milliseconds = latency_milliseconds
   453	        self.deterministic_drop_every = deterministic_drop_every
   454	        self.connection_count = 0
   455	        self.dropped_connections: list[int] = []
   456	        self._connections: set[socket.socket] = set()
   457	        self._lock = threading.Lock()
   458	        self._stopped = threading.Event()
   459	        self._listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
   460	        self._listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
   461	        self._listener.bind(("127.0.0.1", 0))
   462	        self._listener.listen()
   463	        self._listener.settimeout(0.1)
   464	        self.host, self.port = self._listener.getsockname()
   465	        self._thread = threading.Thread(target=self._accept, daemon=True)
   466	        self._thread.start()
   467	
   468	    def _accept(self) -> None:
   469	        while not self._stopped.is_set():
   470	            try:
   471	                downstream, _ = self._listener.accept()
   472	            except TimeoutError:
   473	                continue
   474	            except OSError:
   475	                break
   476	            with self._lock:
   477	                self.connection_count += 1
   478	                ordinal = self.connection_count
   479	            if self.deterministic_drop_every and ordinal % self.deterministic_drop_every == 0:
   480	                downstream.setsockopt(
   481	                    socket.SOL_SOCKET,
   482	                    socket.SO_LINGER,
   483	                    struct.pack("ii", 1, 0),
   484	                )
   485	                downstream.close()
   486	                with self._lock:
   487	                    self.dropped_connections.append(ordinal)
   488	                continue
   489	            try:
   490	                upstream = socket.create_connection(self.upstream, timeout=2)
   491	            except OSError:
   492	                downstream.close()
   493	                continue
   494	            with self._lock:
   495	                self._connections.update((downstream, upstream))
   496	            threading.Thread(
   497	                target=self._bridge,
   498	                args=(downstream, upstream),
   499	                daemon=True,
   500	            ).start()
   501	
   502	    def _bridge(self, downstream: socket.socket, upstream: socket.socket) -> None:
   503	        pumps = [
   504	            threading.Thread(target=self._pump, args=(downstream, upstream), daemon=True),
   505	            threading.Thread(target=self._pump, args=(upstream, downstream), daemon=True),
   506	        ]
   507	        for pump in pumps:
   508	            pump.start()
   509	        for pump in pumps:
   510	            pump.join()
   511	        for connection in (downstream, upstream):
   512	            with self._lock:
   513	                self._connections.discard(connection)
   514	            connection.close()
   515	
   516	    def _pump(self, source: socket.socket, destination: socket.socket) -> None:
   517	        try:
   518	            while True:
   519	                chunk = source.recv(64 * 1024)
   520	                if not chunk:
   521	                    try:
   522	                        destination.shutdown(socket.SHUT_WR)
   523	                    except OSError:
   524	                        pass
   525	                    return
   526	                apply_latency(self.latency_milliseconds)
   527	                destination.sendall(chunk)
   528	        except OSError:
   529	            return
   530	
   531	    def stop(self) -> None:
   532	        self._stopped.set()
   533	        self._listener.close()
   534	        with self._lock:
   535	            connections = list(self._connections)
   536	        for connection in connections:
   537	            try:
   538	                connection.shutdown(socket.SHUT_RDWR)
   539	            except OSError:
   540	                pass
   541	            connection.close()
   542	        self._thread.join(timeout=2)
   543	
   544	    def public_address(self) -> dict[str, object]:
   545	        return {"host": self.host, "port": self.port}
