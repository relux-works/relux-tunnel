+  func resolve(_ value: Value) {
+    let continuation = lock.withLock { () -> CheckedContinuation<Value, Never>? in
+      guard result == nil else { return nil }
+      result = value
+      let continuation = self.continuation
+      self.continuation = nil
+      return continuation
