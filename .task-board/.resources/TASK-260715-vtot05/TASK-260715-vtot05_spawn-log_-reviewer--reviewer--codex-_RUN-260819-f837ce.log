   908	def scan_runtime(config: dict[str, Any], root: Path = ROOT) -> None:
   909	    policy = config["runtimePolicy"]
   910	    validate_runtime_policy(policy)
   911	    extensions = set(policy["scanExtensions"])
   912	    excluded_suffixes = tuple(policy["excludedFileSuffixes"])
   913	    scanned_files = 0
   914	    for relative_root in policy["scanRoots"]:
   915	        scan_root = root / relative_root
   916	        if not scan_root.is_dir() or scan_root.is_symlink():
   917	            raise SupplyChainError(
   918	                f"runtime audit root is unavailable: {relative_root}"
   919	            )
   920	        resolved_scan_root = scan_root.resolve(strict=True)
   921	        for path in sorted(scan_root.rglob("*")):
   922	            if path.is_symlink():
   923	                raise SupplyChainError(
   924	                    f"runtime audit scope contains a symlink: {path.relative_to(root)}"
   925	                )
   926	            if (
   927	                not path.is_file()
   928	                or path.suffix not in extensions
   929	                or path.name.endswith(excluded_suffixes)
   930	            ):
   931	                continue
   932	            resolved_path = path.resolve(strict=True)
   933	            if not resolved_path.is_relative_to(resolved_scan_root):
   934	                raise SupplyChainError(
   935	                    f"runtime audit source escapes its root: {path.relative_to(root)}"
   936	                )
   937	            try:
   938	                text = path.read_text(encoding="utf-8")
   939	            except (OSError, UnicodeDecodeError) as error:
   940	                raise SupplyChainError(
   941	                    f"runtime audit source is unreadable: {path.relative_to(root)}"
   942	                ) from error
   943	            scanned_files += 1
   944	            for label, pattern in FORBIDDEN_RUNTIME_PATTERNS:
   945	                for match in pattern.finditer(text):
   946	                    if label == "Foundation Data URL loader" and (
   947	                        LOCAL_FILE_DATA_READ_PATTERN.match(text, match.start())
   948	                    ):
   949	                        continue
   950	                    raise SupplyChainError(
   951	                        "application runtime code-download surface found "
   952	                        f"({label}): {path.relative_to(root)}"
   953	                    )
   954	    if scanned_files == 0:
   955	        raise SupplyChainError("runtime audit scanned no application source files")
