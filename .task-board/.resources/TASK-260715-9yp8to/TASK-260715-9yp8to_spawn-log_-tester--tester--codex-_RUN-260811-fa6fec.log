+      wait "$app_pid" 2>/dev/null || true
+    fi
+    if [ -n "$log_pid" ] && kill -0 "$log_pid" >/dev/null 2>&1; then
+      kill -TERM "$log_pid" >/dev/null 2>&1 || true
+      wait "$log_pid" 2>/dev/null || true
