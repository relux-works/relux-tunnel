+      "203.0.113.44",
+      "SHA256:private-fingerprint",
+      "private-user",
+      "credential-reference-private",
+      "destination.private",
+      "origin.private",
+      "private exec command",
+      "/private/remote/path",
+      "private-key-material",
+      "payload-secret",
