     guard let value = value as? [String: Any] else {
       throw MacOSProductionBindingError.malformedManifest
     }
     return value
   }
 
   private static func array(_ value: Any?) throws -> [Any] {
     guard let value = value as? [Any] else {
       throw MacOSProductionBindingError.malformedManifest
     }
     return value
   }
 
