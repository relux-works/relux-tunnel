  1263	  public static func authenticationFailure(
  1264	    _ outcome: SSHAuthenticationOutcome,
  1265	    lane: SSHLaneIdentity,
  1266	    cancellationPhase: SSHTransportPhase = .authentication
  1267	  ) -> SSHTransportError? {
  1268	    let code: SSHTransportErrorCode
  1269	    let phase: SSHTransportPhase
  1270	    let retry: SSHRetryDisposition
  1271	    switch outcome {
  1272	    case .success:
