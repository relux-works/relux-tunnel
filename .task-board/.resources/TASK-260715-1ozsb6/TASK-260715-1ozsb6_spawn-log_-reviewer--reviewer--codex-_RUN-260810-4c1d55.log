   447	  private func performUpload(_ request: SSHExecUploadRequest) async throws -> SSHExecExit {
   448	    let channel = try await openExecChannel(request: request.exec, policy: request.channelPolicy)
   449	    let execChannel = channel as! LibSSH2ExecChannel
   450	    do {
   451	      async let stdout: Void = drain(channel: execChannel, standardError: false)
   452	      async let stderr: Void = drain(channel: execChannel, standardError: true)
   453	      while let bytes = try await request.source.read(maximumBytes: request.chunkBytes) {
   454	        guard !bytes.isEmpty, bytes.count <= request.chunkBytes else {
   455	          throw transportError(code: .protocolViolation, phase: .uploadSource)
   456	        }
