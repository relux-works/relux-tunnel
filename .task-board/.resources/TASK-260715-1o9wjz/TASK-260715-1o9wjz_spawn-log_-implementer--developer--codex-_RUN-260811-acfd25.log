+    #expect(dictionary[kSecUseKeychain as String] == nil)
+    #expect(dictionary[kSecAttrAccessGroup as String] == nil)
+    #expect(dictionary[kSecAttrAccessible as String] == nil)
+    #expect(Set(dictionary.keys) == Self.expectedQueryKeys)
+  }
