+    #expect(metrics.counters["packet_bridge_startup_failure_total"] == 1)
+    #expect(metrics.counters["packet_bridge_terminal_failure_total"] == 1)
+    #expect(fixture.logger.messages.filter { $0.message == "packet_bridge.fatal" }.count == 1)
+  }
