   937	  public func handleAppMessage(_ message: Data) async throws -> Data {
   938	    if message.count > RuntimeMessageSizeLimit.command {
   939	      throw ProviderMessageError.invalidPayload(.payloadTooLarge)
   940	    }
   941	    if ProviderMessageCodec.isVersionCandidate(message) {
   942	      return try ProviderMessageCodec.response(to: message)
   943	    }
   944	    return await routeMessage(message)
   945	  }
   946	
   947	  public nonisolated func handleAppMessage(
   948	    _ message: Data,
   949	    responseHandler: ProviderMessageResponseHandler?
   950	  ) {
   951	    let gate = responseHandler.map(ProviderOnceGate<Data>.init)
   952	    Task { [weak self] in
   953	      let response: Data
   954	      if ProviderMessageCodec.isVersionCandidate(message) {
   955	        do {
   956	          response = try ProviderMessageCodec.response(to: message)
   957	        } catch let error as ProviderMessageError {
   958	          response = Self.protocolErrorResponse(
   959	            requestID: nil,
   960	            code: Self.protocolCode(for: error)
   961	          )
   962	        } catch {
   963	          response = Self.protocolErrorResponse(requestID: nil, code: .corruptPayload)
   964	        }
   965	      } else {
   966	        response =
   967	          await self?.routeMessage(message, gate: gate)
   968	          ?? Self.protocolErrorResponse(requestID: nil, code: .corruptPayload)
   969	      }
   970	      gate?.complete(response)
   971	    }
   972	  }
   973	
   974	  private func routeMessage(
   975	    _ message: Data,
   976	    gate: ProviderOnceGate<Data>? = nil
   977	  ) async -> Data {
   978	    let command: RuntimeCommand
   979	    do {
   980	      command = try RuntimeMessageCodec.decodeCommand(message)
   981	    } catch let error as RuntimeMessageCodecError {
   982	      return Self.protocolErrorResponse(requestID: nil, code: error.protocolErrorCode)
   983	    } catch {
   984	      return Self.protocolErrorResponse(requestID: nil, code: .corruptPayload)
   985	    }
   986	
   987	    guard let requestID = command.requestID else {
   988	      return Self.protocolErrorResponse(requestID: nil, code: .unsupportedValue)
   989	    }
   990	    guard phase == .running, let generation = activeGeneration?.identifier else {
   991	      return Self.protocolErrorResponse(requestID: requestID, code: .unsupportedValue)
   992	    }
   993	    guard reserveRequest(requestID.rawValue, generation: generation) else {
   994	      return Self.protocolErrorResponse(requestID: requestID, code: .unsupportedValue)
   995	    }
   996	    if let gate {
   997	      pendingMessageGates[requestID.rawValue] = gate
   998	    }
   999	
  1000	    let response: Data
  1001	    do {
  1002	      switch command.kind {
  1003	      case .getProtocolCapabilities:
  1004	        response = try RuntimeMessageCodec.encode(
  1005	          RuntimeProtocolCapabilitiesSnapshot(
  1006	            requestID: requestID,
  1007	            kinds: Self.readOnlyCapabilities
  1008	          )
  1009	        )
  1010	      case .getRuntimeSnapshot:
  1011	        guard let snapshot = await lookupSnapshot(generation: generation) else {
  1012	          throw ProviderAdapterError.runtimeStartupFailed
  1013	        }
  1014	        response = try RuntimeMessageCodec.encode(
  1015	          RuntimeLifecycleSnapshot(
  1016	            requestID: requestID,
  1017	            runtimeGeneration: snapshot.lifecycle.runtimeGeneration,
  1018	            snapshotSequence: snapshot.lifecycle.snapshotSequence,
  1019	            lifecycleState: snapshot.lifecycle.lifecycleState,
  1020	            routeState: snapshot.lifecycle.routeState,
  1021	            tcp: snapshot.lifecycle.tcp,
  1022	            safeDNS: snapshot.lifecycle.safeDNS,
  1023	            udp: snapshot.lifecycle.udp,
  1024	            routeMode: snapshot.lifecycle.routeMode,
  1025	            routesInstalled: snapshot.lifecycle.routesInstalled,
  1026	            healthy: snapshot.lifecycle.healthy,
  1027	            error: snapshot.lifecycle.error
  1028	          )
  1029	        )
  1030	      case .getCapabilities:
  1031	        guard let snapshot = await lookupSnapshot(generation: generation) else {
  1032	          throw ProviderAdapterError.runtimeStartupFailed
  1033	        }
  1034	        response = try RuntimeMessageCodec.encode(
  1035	          RuntimeCapabilitySnapshot(
  1036	            requestID: requestID,
  1037	            runtimeGeneration: snapshot.capabilities.runtimeGeneration,
  1038	            snapshotSequence: snapshot.capabilities.snapshotSequence,
  1039	            tcp: snapshot.capabilities.tcp,
  1040	            safeDNS: snapshot.capabilities.safeDNS,
  1041	            udp: snapshot.capabilities.udp,
  1042	            routeMode: snapshot.capabilities.routeMode,
  1043	            routesInstalled: snapshot.capabilities.routesInstalled,
  1044	            healthy: snapshot.capabilities.healthy
  1045	          )
  1046	        )
  1047	      case .getDiagnostics:
  1048	        guard
  1049	          let diagnostics = await lookupDiagnostics(
  1050	            requestID: requestID,
  1051	            generation: generation
  1052	          )
  1053	        else {
  1054	          throw ProviderAdapterError.startCancelled
  1055	        }
  1056	        response = try RuntimeMessageCodec.encode(
  1057	          diagnostics
  1058	        )
  1059	      }
  1060	    } catch let error as RuntimeMessageCodecError {
  1061	      finishRequest(requestID.rawValue, generation: generation)
  1062	      return Self.protocolErrorResponse(requestID: requestID, code: error.protocolErrorCode)
  1063	    } catch {
  1064	      finishRequest(requestID.rawValue, generation: generation)
  1065	      return Self.protocolErrorResponse(requestID: requestID, code: .corruptPayload)
  1066	    }
  1067	
  1068	    guard phase == .running, activeGeneration?.identifier == generation else {
  1069	      finishRequest(requestID.rawValue, generation: generation)
  1070	      return Self.protocolErrorResponse(requestID: requestID, code: .unsupportedValue)
  1071	    }
  1072	    finishRequest(requestID.rawValue, generation: generation)
  1073	    return response
  1074	  }
  1075	
  1076	  private func lookupSnapshot(generation: UInt64) async -> TunnelRuntimePublishedSnapshot? {
  1077	    guard activeGeneration?.identifier == generation else { return nil }
  1078	    guard let signal = activeGeneration?.retirementSignal else { return nil }
  1079	    let first = ProviderFirstResult<SnapshotLookupResult>()
  1080	    Task { [snapshotSource] in
  1081	      first.resolve(.value(await snapshotSource.latestProviderSnapshot()))
  1082	    }
  1083	    let retirement = Task {
  1084	      do {
  1085	        try await signal.wait()
  1086	        first.resolve(.retired)
  1087	      } catch {
  1088	        // The source won and removed this retirement subscription.
  1089	      }
  1090	    }
  1091	    let result = await first.wait()
  1092	    if case .value = result { retirement.cancel() }
  1093	    switch result {
  1094	    case .value(let snapshot):
  1095	      return snapshot
  1096	    case .retired:
  1097	      return nil
  1098	    }
  1099	  }
  1100	
  1101	  private func lookupDiagnostics(
  1102	    requestID: OpaqueRuntimeRequestIdentifier,
  1103	    generation: UInt64
  1104	  ) async -> RuntimeDiagnosticsSnapshot? {
  1105	    guard activeGeneration?.identifier == generation else { return nil }
  1106	    guard let signal = activeGeneration?.retirementSignal else { return nil }
  1107	    let first = ProviderFirstResult<DiagnosticsLookupResult>()
  1108	    Task { [diagnosticsSource] in
  1109	      do {
  1110	        first.resolve(
  1111	          .value(
  1112	            .success(
  1113	              try await diagnosticsSource.providerDiagnosticsSnapshot(requestID: requestID)
  1114	            ))
  1115	        )
  1116	      } catch {
  1117	        first.resolve(.value(.failure(.runtimeStartupFailed)))
  1118	      }
  1119	    }
  1120	    let retirement = Task {
  1121	      do {
  1122	        try await signal.wait()
  1123	        first.resolve(.retired)
  1124	      } catch {
  1125	        // The source won and removed this retirement subscription.
  1126	      }
  1127	    }
  1128	    let result = await first.wait()
  1129	    if case .value = result { retirement.cancel() }
  1130	    switch result {
  1131	    case .value(.success(let snapshot)):
  1132	      return snapshot
  1133	    case .value(.failure), .retired:
  1134	      return nil
  1135	    }
  1136	  }
  1137	
  1138	  private static let readOnlyCapabilities: [RuntimeKindCapability] = [
  1139	    .init(kind: .getProtocolCapabilities, schemaVersions: .currentSchema),
  1140	    .init(kind: .getRuntimeSnapshot, schemaVersions: .currentSchema),
  1141	    .init(kind: .getCapabilities, schemaVersions: .currentSchema),
  1142	    .init(kind: .getDiagnostics, schemaVersions: .currentSchema),
  1143	    .init(kind: .protocolCapabilities, schemaVersions: .currentSchema),
  1144	    .init(kind: .runtimeSnapshot, schemaVersions: .currentSchema),
  1145	    .init(kind: .capabilitySnapshot, schemaVersions: .currentSchema),
  1146	    .init(kind: .diagnosticsSnapshot, schemaVersions: .currentSchema),
  1147	    .init(kind: .protocolError, schemaVersions: .currentSchema),
  1148	  ]
  1149	
  1150	  private static func protocolErrorResponse(
  1151	    requestID: OpaqueRuntimeRequestIdentifier?,
  1152	    code: RuntimeProtocolErrorCode
  1153	  ) -> Data {
  1154	    let error = RuntimeProtocolError(requestID: requestID, code: code)
  1155	    guard let encoded = try? RuntimeMessageCodec.encode(error) else {
  1156	      preconditionFailure("The fixed v1 protocol error must fit its encoded bound")
  1157	    }
  1158	    return encoded
  1159	  }
  1160	
  1161	  private static func protocolCode(for error: ProviderMessageError) -> RuntimeProtocolErrorCode {
  1162	    switch error {
  1163	    case .unsupportedProtocolVersion:
  1164	      .unsupportedProtocolVersion
  1165	    case .unsupportedKind:
  1166	      .unsupportedKind
  1167	    case .invalidPayload(let code):
  1168	      code
  1169	    }
  1170	  }
  1171	
  1172	  private func resetRequestLedger(for generation: UInt64) {
  1173	    requestLedgerGeneration = generation
  1174	    activeRequestIDs.removeAll(keepingCapacity: true)
  1175	    recentRequestIDs.removeAll(keepingCapacity: true)
  1176	    recentRequestOrder.removeAll(keepingCapacity: true)
  1177	    pendingMessageGates.removeAll(keepingCapacity: true)
  1178	  }
  1179	
  1180	  private func retireRequestLedger(generation: UInt64) {
  1181	    guard requestLedgerGeneration == generation else { return }
  1182	    let pendingGates = pendingMessageGates
  1183	    pendingMessageGates.removeAll(keepingCapacity: false)
  1184	    for (requestID, gate) in pendingGates {
  1185	      gate.complete(
  1186	        Self.protocolErrorResponse(
  1187	          requestID: OpaqueRuntimeRequestIdentifier(requestID),
  1188	          code: .unsupportedValue
  1189	        )
  1190	      )
  1191	    }
  1192	    requestLedgerGeneration = nil
  1193	    activeRequestIDs.removeAll(keepingCapacity: false)
  1194	    recentRequestIDs.removeAll(keepingCapacity: false)
  1195	    recentRequestOrder.removeAll(keepingCapacity: false)
  1196	  }
  1197	
  1198	  private func reserveRequest(_ requestID: UUID, generation: UInt64) -> Bool {
  1199	    guard requestLedgerGeneration == generation,
  1200	      activeRequestIDs.count < Self.maximumRememberedRequestIDs,
  1201	      !activeRequestIDs.contains(requestID),
  1202	      !recentRequestIDs.contains(requestID)
  1203	    else { return false }
