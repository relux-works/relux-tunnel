def git_bytes(rev,path):
    return subprocess.run(['git','show',f'{rev}:{path}'],cwd=root,check=True,capture_output=True).stdout

def verify_records(label,rev,records,expected_aggregate):
    lines=[]
    for rec in records:
        digest=hashlib.sha256(git_bytes(rev,rec['path'])).hexdigest()
        assert digest==rec['sha256'], (label,rec['path'],digest,rec['sha256'])
        lines.append(f\"{digest}  {rec['path']}\\n\")
    aggregate=hashlib.sha256(''.join(lines).encode()).hexdigest()
    assert aggregate==expected_aggregate,(label,aggregate,expected_aggregate)
    print(label,'revision',rev,'files',len(records),'aggregate',aggregate)

src=cfg['source']; build=cfg['build']
