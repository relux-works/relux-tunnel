{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c653","stream":{"kind":"session","id":"01a0aa7a-9815-7302-a96f-7a8fde67c84b"},"sequence":388,"recorded_at":1780531400000771,"record_type":"event","durability":"durable","causation_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7cb39f37-e5ea-43fc-a612-eaf97474622d","run_stream":{"kind":"run","id":"7cb39f37-e5ea-43fc-a612-eaf97474622d"},"task_stream":{"kind":"task","id":"01a0aa7b-a45f-70d1-9e7c-30761cbcad86"},"task_id":"01a0aa7b-a45f-70d1-9e7c-30761cbcad86","event":{"kind":"output","task_id":"01a0aa7b-a45f-70d1-9e7c-30761cbcad86","chunk":"Read text file `Sources/ReluxTunnelCore/SSHContracts.swift`.\n(499 line(s) above)\n500|      )\n501|    case .trustRequired, .rejectChanged, .rejectRevoked, .rejectAlgorithm,\n502|      .rejectHostMismatch, .rejectMalformed, .rejectPolicy:\n503|      throw SSHHostAcceptanceError.rejected(outcome)\n504|    }\n505|  }\n506|}\n507|\n508|extension SSHHostKeyDecision: CustomStringConvertible, CustomDebugStringConvertible {\n509|  public var description: String { \"SSHHostKeyDecision(\\(outcome.rawValue))\" }\n510|  public var debugDescription: String { description }\n511|}\n512|\n513|public struct SSHCredentialRequest: Equatable, Sendable, CustomStringConvertible,\n514|  CustomDebugStringConvertible\n515|{\n516|  public let credentialReference: SSHCredentialReference\n517|  public let credentialGeneration: UInt64\n518|  public let username: String\n519|  public let allowedPublicKeyAlgorithms: [String]\n520|  public let acceptedHost: SSHHostKeyAcceptance\n521|\n522|  public init(\n523|    credentialReference: SSHCredentialReference,\n524|    credentialGeneration: UInt64,\n525|    username: String,\n526|    allowedPublicKeyAlgorithms: [String],\n527|    acceptedHost: SSHHostKeyAcceptance\n528|  ) {\n529|    self.credentialReference = credentialReference\n530|    self.credentialGeneration = credentialGeneration\n531|    self.username = username\n532|    self.allowedPublicKeyAlgorithms = allowedPublicKeyAlgorithms\n533|    self.acceptedHost = acceptedHost\n534|  }\n535|\n536|  public var description: String { \"SSHCredentialRequest(<redacted>)\" }\n537|  public var debugDescription: String { description }\n538|}\n539|\n540|public enum SSHAuthenticationOutcome: String, CaseIterable, Equatable, Sendable {\n541|  case success\n542|  case rejectedByServer\n543|  case methodUnavailable\n544|  case keyAlgorithmUnavailable\n545|  case credentialUnavailable\n546|  case credentialInteractionRequired\n547|  case signatureFailed\n548|  case cancelled\n549|  case timedOut\n550|}\n551|\n552|// MARK: - Configuration and capability report\n553|\n554|public struct SSHAlgorithmPolicy: Equatable, Sendable {\n555|  public let keyExchange: [String]\n556|  public let hostKey: [String]\n557|  public let cipher: [String]\n558|  public let mac: [String]\n559|\n560|  public init(\n561|    keyExchange: [String],\n562|    hostKey: [String],\n563|    cipher: [String],\n564|    mac: [String]\n565|  ) throws {\n566|    try Self.requireAlgorithms(keyExchange, field: .keyExchangeAlgorithms)\n567|    try Self.requireAlgorithms(hostKey, field: .hostKeyAlgorithms)\n568|    try Self.requireAlgorithms(cipher, field: .cipherAlgorithms)\n569|    try Self.requireAlgorithms(mac, field: .macAlgorithms)\n570|    self.keyExchange = keyExchange\n571|    self.hostKey = hostKey\n572|    self.cipher = cipher\n573|    self.mac = mac\n574|  }\n575|\n576|  private static func requireAlgorithms(\n577|    _ algorithms: [String],\n578|    field: SSHValidationField\n579|  ) throws {\n580|    guard !algorithms.isEmpty,\n581|      algorithms.allSatisfy({ !$0.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty })\n582|    else {\n583|      throw SSHContractValidationError.empty(field)\n584|    }\n585|  }\n586|}\n587|\n588|public struct SSHTimeoutPolicy: Equatable, Sendable {\n589|  public let resolution: Duration\n590|  public let tcpConnect: Duration\n591|  public let initialKeyExchange: Duration\n592|  public let hostDecision: Duration\n593|  public let credentialLookup: Duration\n594|  public let authentication: Duration\n595|  public let channelOpen: Duration\n596|  public let writeCreditWait: Duration\n597|  public let explicitRekey: Duration\n598|  public let keepaliveReply: Duration\n599|  public let execExit: Duration\n600|  public let upload: Duration\n601|  public let channelClose: Duration\n602|  public let transportClose: Duration\n603|\n604|  public init(\n605|    resolution: Duration,\n606|    tcpConnect: Duration,\n607|    initialKeyExchange: Duration,\n608|    hostDecision: Duration,\n609|    credentialLookup: Duration,\n610|    authentication: Duration,\n611|    channelOpen: Duration,\n612|    writeCreditWait: Duration,\n613|    explicitRekey: Duration,\n614|    keepaliveReply: Duration,\n615|    execExit: Duration,\n616|    upload: Duration,\n617|    channelClose: Duration,\n618|    transportClose: Duration\n619|  ) throws {\n620|    let values: [(Duration, SSHValidationField)] = [\n621|      (resolution, .resolutionTimeout),\n622|      (tcpConnect, .tcpConnectTimeout),\n623|      (initialKeyExchange, .initialKeyExchangeTimeout),\n624|      (hostDecision, .hostDecisionTimeout),\n625|      (credentialLookup, .credentialLookupTimeout),\n626|      (authentication, .authenticationTimeout),\n627|      (channelOpen, .channelOpenTimeout),\n628|      (writeCreditWait, .writeCreditWaitTimeout),\n629|      (explicitRekey, .explicitRekeyTimeout),\n630|      (keepaliveReply, .keepaliveReplyPolicyTimeout),\n631|      (execExit, .execExitTimeout),\n632|      (upload, .uploadTimeout),\n633|      (channelClose, .channelCloseTimeout),\n634|      (transportClose, .transportCloseTimeout),\n635|    ]\n636|    for (duration, field) in values where duration <= .zero {\n637|      throw SSHContractValidationError.nonPositive(field)\n638|    }\n639|    self.resolution = resolution\n640|    self.tcpConnect = tcpConnect\n641|    self.initialKeyExchange = initialKeyExchange\n642|    self.hostDecision = hostDecision\n643|    self.credentialLookup = credentialLookup\n644|    self.authentication = authentication\n645|    self.channelOpen = channelOpen\n646|    self.writeCreditWait = writeCreditWait\n647|    self.explicitRekey = explicitRekey\n648|    self.keepaliveReply = keepaliveReply\n649|    self.execExit = execExit\n650|    self.upload = upload\n651|    self.channelClose = channelClose\n652|    self.transportClose = transportClose\n653|  }\n654|}\n655|\n656|public struct SSHRekeyPolicy: Equatable, Sendable {\n657|  public let protectedByteThresholdPerDirection: UInt64\n658|  public let elapsedTimeThreshold: Duration\n659|  public let timeout: Duration\n660|\n661|  public init(\n662|    protectedByteThresholdPerDirection: UInt64,\n663|    elapsedTimeThreshold: Duration,\n664|    timeout: Duration\n665|  ) throws {\n666|    guard protectedByteThresholdPerDirection > 0 else {\n667|      throw SSHContractValidationError.nonPositive(.protectedByteThresholdPerDirection)\n668|    }\n669|    guard elapsedTimeThreshold > .zero else {\n670|      throw SSHContractValidationError.nonPositive(.rekeyElapsedTimeThreshold)\n671|    }\n672|    guard timeout > .zero else {\n673|      throw SSHContractValidationError.nonPositive(.rekeyTimeout)\n674|    }\n675|    self.protectedByteThresholdPerDirection = protectedByteThresholdPerDirection\n676|    self.elapsedTimeThreshold = elapsedTimeThreshold\n677|    self.timeout = timeout\n678|  }\n679|}\n680|\n681|public struct SSHKeepalivePolicy: Equatable, Sendable {\n682|  public let interval: Duration\n683|  public let replyTimeout: Duration\n684|  public let allowedConsecutiveMisses: Int\n685|\n686|  public init(\n687|    interval: Duration,\n688|    replyTimeout: Duration,\n689|    allowedConsecutiveMisses: Int\n690|  ) throws {\n691|    guard interval > .zero else {\n692|      throw SSHContractValidationError.nonPositive(.keepaliveInterval)\n693|    }\n694|    guard replyTimeout > .zero else {\n695|      throw SSHContractValidationError.nonPositive(.keepaliveReplyTimeout)\n696|    }\n697|    guard allowedConsecutiveMisses >= 0 else {\n698|      throw SSHContractValidationError.negative(.allowedConsecutiveKeepaliveMisses)\n699|    }\n700|    self.interval = interval\n701|    self.replyTimeout = replyTimeout\n702|    self.allowedConsecutiveMisses = allowedConsecutiveMisses\n703|  }\n704|}\n705|\n706|public struct SSHConnectionConfiguration: Equatable, Sendable {\n707|  public let canonicalHostname: String\n708|  public let endpoint: TunnelEndpoint\n709|  public let username: String\n710|  public let profileReference: TunnelConfigurationReference\n711|  public let credentialReference: SSHCredentialReference\n712|  public let credentialGeneration: UInt64\n713|  public let trustRecordReference: SSHTrustRecordReference?\n714|  public let algorithms: SSHAlgorithmPolicy\n715|  public let timeouts: SSHTimeoutPolicy\n716|  public let rekey: SSHRekeyPolicy\n717|  public let keepalive: SSHKeepalivePolicy\n718|\n719|  public init(\n720|    canonicalHostname: String,\n721|    endpoint: TunnelEndpoint,\n722|    username: String,\n723|    profileReference: TunnelConfigurationReference,\n724|    credentialReference: SSHCredentialReference,\n725|    credentialGeneration: UInt64,\n726|    trustRecordReference: SSHTrustRecordReference?,\n727|    algorithms: SSHAlgorithmPolicy,\n728|    timeouts: SSHTimeoutPolicy,\n729|    rekey: SSHRekeyPolicy,\n730|    keepalive: SSHKeepalivePolicy\n731|  ) throws {\n732|    guard !canonicalHostname.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {\n733|      throw SSHContractValidationError.empty(.canonicalHostname)\n734|    }\n735|    guard !endpoint.host.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {\n736|      throw SSHContractValidationError.empty(.endpointHost)\n737|    }\n738|    guard endpoint.port > 0