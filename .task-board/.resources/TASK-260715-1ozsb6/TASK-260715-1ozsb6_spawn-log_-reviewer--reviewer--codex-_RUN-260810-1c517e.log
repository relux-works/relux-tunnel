   737	  private func performRequestRekey(until deadline: ContinuousClock.Instant) async throws {
   738	    guard state == .ready else {
   739	      throw transportError(code: .invalidState, phase: .rekey)
   740	    }
   741	    await emit(.rekeyTriggered(rekeyReasons))
   742	    try await transition(to: .rekeying)
   743	    await emit(.rekeyStarted(reasons: rekeyReasons, generation: counters.rekeysSucceeded + 1))
   744	    do {
   745	      while true {
   746	        try checkCancellation(phase: .rekey)
   747	        guard state == .rekeying, let engineSession else {
   748	          throw transportError(code: .cancelled, phase: .rekey)
   749	        }
   750	        let result = libssh2_session_rekey(engineSession)
   751	        if result == 0 { break }
   752	        guard result == LIBSSH2_ERROR_EAGAIN else {
   753	          throw engineError(result, phase: .rekey, fallback: .rekeyFailed)
   754	        }
   755	        try await progress(until: deadline, phase: .rekey)
   756	      }
   757	      counters.rekeysSucceeded += 1
   758	      rekeySentBytesBaseline = counters.protectedBytesSent
   759	      rekeyReceivedBytesBaseline = counters.protectedBytesReceived
   760	      await metric(.increment(.rekeysSucceeded, by: 1))
   761	      await emit(.rekeySucceeded(reasons: rekeyReasons, generation: counters.rekeysSucceeded))
   762	      try await transition(to: .ready)
   763	    } catch {
   764	      counters.rekeysFailed += 1
   765	      await metric(.increment(.rekeysFailed, by: 1))
   766	      await emit(
   767	        .rekeyFailed(
   768	          reasons: rekeyReasons,
   769	          generation: counters.rekeysSucceeded + 1,
   770	          code: .rekeyFailed
   771	        )
   772	      )
   773	      throw map(error, phase: .rekey, fallback: .rekeyFailed)
   774	    }
   775	  }
