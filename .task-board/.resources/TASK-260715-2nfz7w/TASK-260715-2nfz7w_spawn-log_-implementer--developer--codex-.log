+        .testTarget(
+            name: "ReluxTunnelCoreTests",
+            dependencies: [
+                "ReluxTunnelCore",
+                "ReluxTunnelIOSAdapter",
+                "ReluxTunnelMacOSAdapter",
+            ]
+        ),
+    ]
+)
