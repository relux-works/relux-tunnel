	GOCACHE="$(RELAY_DEV_WORK)/go-build-cache" \
	GOMODCACHE="$(RELAY_DEV_WORK)/go-module-cache" \
	GOPATH="$(RELAY_DEV_WORK)/go-path" \
	LC_ALL=C \
