    41	@Suite("Relux receive-window policy")
    42	struct ReluxWindowPolicyTests {
    43	    @Test(
    44	        "Configured initial windows are emitted on channel open",
    45	        arguments: [
    46	            NIOSSHChannelWindowConfiguration(
    47	                initialWindowSize: 32 * 1024,
    48	                maximumWindowSize: 32 * 1024,
    49	                windowAdjustmentThreshold: 16 * 1024
    50	            ),
    51	            NIOSSHChannelWindowConfiguration(
    52	                initialWindowSize: 64 * 1024,
    53	                maximumWindowSize: 64 * 1024,
    54	                windowAdjustmentThreshold: 32 * 1024
    55	            ),
    56	            NIOSSHChannelWindowConfiguration(
    57	                initialWindowSize: 512 * 1024,
    58	                maximumWindowSize: 1024 * 1024,
    59	                windowAdjustmentThreshold: 256 * 1024
    60	            ),
    61	        ]
    62	    )
    63	    func configuredInitialWindowIsOnWire(configuration: NIOSSHChannelWindowConfiguration) throws {
    64	        let delegate = DummyDelegate()
    65	        let multiplexer = SSHChannelMultiplexer(
    66	            delegate: delegate,
    67	            allocator: delegate.allocator,
    68	            childChannelInitializer: nil
    69	        )
    70	        defer {
    71	            multiplexer.parentChannelInactive()
    72	            multiplexer.parentHandlerRemoved()
    73	            delegate._channel.embeddedEventLoop.run()
    74	            _ = try? delegate._channel.finish(acceptAlreadyClosed: true)
    75	        }
    76	
    77	        var childChannel: Channel?
    78	        multiplexer.createChildChannel(nil, channelType: .session) { channel, _ in
    79	            childChannel = channel
    80	            return channel.setOption(SSHChildChannelOptions.receiveWindowConfiguration, value: configuration)
    81	        }
    82	        delegate._channel.embeddedEventLoop.run()
    83	
    84	        guard case .channelOpen(let open)? = delegate.writes.first?.0 else {
    85	            Issue.record("Expected a channel-open message")
    86	            return
    87	        }
    88	        #expect(open.initialWindowSize == configuration.initialWindowSize)
    89	
    90	        let snapshot = try #require(
    91	            try childChannel?.getOption(SSHChildChannelOptions.receiveWindowSnapshot).wait()
    92	        )
    93	        #expect(snapshot.initialWindowSize == configuration.initialWindowSize)
    94	        #expect(snapshot.maximumWindowSize == configuration.maximumWindowSize)
    95	        #expect(snapshot.remainingWindowSize == configuration.initialWindowSize)
    96	    }
