   368	  private func receiveExactly(_ count: Int, from descriptor: Int32) -> [UInt8]? {
   369	    guard count >= 0 else { return nil }
   370	    if count == 0 { return [] }
   371	    var bytes = [UInt8](repeating: 0, count: count)
   372	    var offset = 0
   373	    while offset < count {
   374	      let received = bytes.withUnsafeMutableBytes { buffer in
   375	        Darwin.recv(descriptor, buffer.baseAddress! + offset, count - offset, 0)
   376	      }
   377	      if received > 0 {
   378	        offset += received
   379	      } else if received < 0 && errno == EINTR {
   380	        continue
   381	      } else {
   382	        return nil
   383	      }
   384	    }
   385	    return bytes
   386	  }
   387	
   388	  private func sendAll(_ bytes: [UInt8], to descriptor: Int32) -> Bool {
   389	    var offset = 0
   390	    while offset < bytes.count {
   391	      let sent = bytes.withUnsafeBytes { buffer in
   392	        Darwin.send(descriptor, buffer.baseAddress! + offset, bytes.count - offset, 0)
   393	      }
   394	      if sent > 0 {
   395	        offset += sent
   396	      } else if sent < 0 && errno == EINTR {
   397	        continue
   398	      } else {
   399	        return false
   400	      }
   401	    }
   402	    return true
   403	  }
