{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c60d","stream":{"kind":"session","id":"01a0a9c6-18e8-73c2-87df-807f8e977157"},"sequence":353,"recorded_at":1780531400000701,"record_type":"event","durability":"durable","causation_id":"7f8b7742-5a98-412e-8203-1d9787ac5c82","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"7f8b7742-5a98-412e-8203-1d9787ac5c82","run_stream":{"kind":"run","id":"7f8b7742-5a98-412e-8203-1d9787ac5c82"},"call_id":"call_01a0a9c6ebfd73c28ac2abb7bb2812b9","text":"Read text file `scripts/tests/test-credential-free-validation.sh`.\n1|#!/bin/sh\n2|set -eu\n3|\n4|repo_root=$(CDPATH='' cd -- \"$(dirname -- \"$0\")/../..\" && pwd)\n5|work_root=$(mktemp -d \"${TMPDIR:-/tmp}/relux-credential-free-contract.XXXXXX\")\n6|cleanup() {\n7|  case \"$work_root\" in\n8|    \"${TMPDIR:-/tmp}\"/relux-credential-free-contract.*) rm -rf \"$work_root\" ;;\n9|    *) echo \"warning: refusing to clean unexpected test path: $work_root\" >&2 ;;\n10|  esac\n11|}\n12|trap cleanup EXIT INT TERM\n13|\n14|write_list() {\n15|  destination=$1\n16|  shift\n17|  {\n18|    echo 'Information about workspace \"ReluxTunnel\":'\n19|    echo '    Schemes:'\n20|    for scheme in \"$@\"; do\n21|      printf '        %s\\n' \"$scheme\"\n22|    done\n23|  } > \"$destination\"\n24|}\n25|\n26|valid=\"$work_root/valid.log\"\n27|missing=\"$work_root/missing.log\"\n28|unexpected=\"$work_root/unexpected.log\"\n29|adversarial=\"$work_root/adversarial.log\"\n30|\n31|write_list \"$valid\" \\\n32|  relux-relay relux-relay-protocol-test ReluxProxyMac ReluxProxyMacTunnel \\\n33|  ReluxTunnelCore ReluxTunnelHarness\n34|write_list \"$missing\" \\\n35|  relux-relay relux-relay-protocol-test ReluxProxyMacTunnel \\\n36|  ReluxTunnelCore ReluxTunnelHarness\n37|write_list \"$unexpected\" \\\n38|  relux-relay relux-relay-protocol-test ReluxProxyMac ReluxProxyMacTunnel \\\n39|  ReluxTunnelCore ReluxTunnelHarness UnexpectedScheme\n40|write_list \"$adversarial\" \\\n41|  relux-relay relux-relay-protocol-test ReluxProxyMacTunnel \\\n42|  ReluxTunnelCore ReluxTunnelHarness UnexpectedScheme\n43|\n44|\"$repo_root/scripts/check-workspace-schemes.sh\" \"$valid\" >/dev/null\n45|for invalid in \"$missing\" \"$unexpected\" \"$adversarial\"; do\n46|  if \"$repo_root/scripts/check-workspace-schemes.sh\" \"$invalid\" >/dev/null 2>&1; then\n47|    echo \"error: invalid scheme fixture unexpectedly passed: $invalid\" >&2\n48|    exit 1\n49|  fi\n50|done\n51|\n52|workflow=\"$repo_root/.github/workflows/ci.yml\"\n53|runner_label='    runs-on: macos-15'\n54|mise_action='      - uses: jdx/mise-action@3c2e0cf82a5b2e5249f0d3635a4d83d0ae861518 # v4.2.5'\n55|arm64_checksum='          sha256: c7a0eb1035de974b42d36b69c4b55b836c06b455b990dd6ac530aaf05d4a8a17 # mise-v2026.3.10-macos-arm64'\n56|test \"$(grep -Fxc \"$runner_label\" \"$workflow\")\" -eq 1\n57|test \"$(grep -Fxc \"$mise_action\" \"$workflow\")\" -eq 1\n58|grep -Fx '          version: 2026.3.10' \"$workflow\" >/dev/null\n59|test \"$(grep -Fxc \"$arm64_checksum\" \"$workflow\")\" -eq 1\n60|grep -Fx '          install: false' \"$workflow\" >/dev/null\n61|test \"$(grep -Fc 'make credential-free-validate LEGACY_ROOT=' \"$workflow\")\" -eq 1\n62|\n63|runner_line=$(grep -nF \"$runner_label\" \"$workflow\" | cut -d: -f1)\n64|mise_line=$(grep -nF \"$mise_action\" \"$workflow\" | cut -d: -f1)\n65|checksum_line=$(grep -nF \"$arm64_checksum\" \"$workflow\" | cut -d: -f1)\n66|gate_line=$(grep -nF 'make credential-free-validate LEGACY_ROOT=' \"$workflow\" | cut -d: -f1)\n67|test \"$runner_line\" -lt \"$mise_line\"\n68|test \"$mise_line\" -lt \"$checksum_line\"\n69|test \"$mise_line\" -lt \"$gate_line\"\n70|\n71|\"$repo_root/scripts/tests/test-generated-provider-graph.sh\" >/dev/null\n72|\n73|echo \"credential-free validation contract tests passed\"","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
