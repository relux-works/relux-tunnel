+private final class SecurityMatcherSpy: @unchecked Sendable {
+  private let lock = NSLock()
+  private var calls = 0
+
+  var callCount: Int {
+    lock.withLock { calls }
+  }
+
+  func copyMatching(
+    _ query: CFDictionary,
+    _ result: UnsafeMutablePointer<CFTypeRef?>
+  ) -> OSStatus {
+    lock.withLock { calls += 1 }
+    return errSecInternalError
+  }
+}
