   680	  private func fits(used: Int, adding: Int, ceiling: Int) -> Bool {
   681	    let (candidate, overflow) = used.addingReportingOverflow(adding)
   682	    return !overflow && candidate <= ceiling
   683	  }
   684	
   685	  private mutating func recordRefusal(_ refusal: SSHReceiveWindowRefusal) {
   686	    metrics.refusals[refusal, default: 0] = metrics.refusals[refusal, default: 0]
   687	      .saturatingAdd(1)
   688	  }
   689	}
   690	
   691	private func saturatingAdd(_ lhs: Int, _ rhs: Int) -> Int {
   692	  let (result, overflow) = lhs.addingReportingOverflow(rhs)
   693	  return overflow ? Int.max : result
   694	}
   695	
   696	private func saturatingMultiply(_ lhs: Int, _ rhs: Int) -> Int {
   697	  let (result, overflow) = lhs.multipliedReportingOverflow(by: rhs)
   698	  return overflow ? Int.max : result
   699	}
   700	
   701	private func ceilMultiplyDivide(_ lhs: UInt64, _ rhs: UInt64, by divisor: UInt64) -> UInt64 {
   702	  let quotient = lhs / divisor
   703	  let remainder = lhs % divisor
   704	  let (base, baseOverflow) = quotient.multipliedReportingOverflow(by: rhs)
   705	  if baseOverflow { return .max }
   706	  let product = remainder.multipliedFullWidth(by: rhs)
   707	  let division = divisor.dividingFullWidth(product)
   708	  let roundedFraction =
   709	    division.remainder == 0
   710	    ? division.quotient : division.quotient.saturatingAdd(1)
