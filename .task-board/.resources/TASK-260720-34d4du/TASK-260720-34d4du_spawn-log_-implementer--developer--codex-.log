   279	            break
   280	        case .possibleFutureMessage(let future):
   281	            // TODO(cory): This is not right, but for now it's good enough.
   282	            future.hop(to: context.eventLoop).assumeIsolatedUnsafeUnchecked().whenComplete { result in
   283	                switch result {
   284	                case .success(.some(let message)):
   285	                    do {
   286	                        try self.writeMessage(message, context: context)
   287	                        self.pendingWrite = false
   288	                        context.flush()
   289	                    } catch {
   290	                        context.fireErrorCaught(error)
   291	                    }
   292	                case .success(.none):
