2\\n  printf '%s\\\\n' \\\"$actual_schemes\\\" >&2\\n  exit 1\\nfi\\n\\necho \\\"generated workspace scheme set is exact\\\"\\n\",\n  \"original_output_bytes\": 992,\n  \"original_output_tokens\": 248,\n  \"truncated\": false\n}","final_result":true}}}
