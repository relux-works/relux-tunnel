===== scripts/build-app.sh =====
     1	#!/bin/bash
     2	set -euo pipefail
     3	
     4	ROOT="$(cd "$(dirname "$0")/.." && pwd)"
     5	VERSION="${VERSION:-0.1.0-dev}"
     6	VERSION="${VERSION#v}"
     7	SHORT_VERSION="${VERSION%%-*}"
     8	BUILD_NUMBER="${BUILD_NUMBER:-$(git -C "$ROOT" rev-list --count HEAD 2>/dev/null || echo 1)}"
     9	APP_NAME="ReluxProxy"
    10	BUNDLE="$ROOT/dist/$APP_NAME.app"
    11	SIGN_IDENTITY="${SIGN_IDENTITY:-Developer ID Application: Relux Works, LLC (262RZ595FP)}"
    12	
    13	cd "$ROOT"
    14	rm -rf "$BUNDLE"
    15	mkdir -p "$BUNDLE/Contents/MacOS" "$BUNDLE/Contents/Resources"
    16	
    17	BUILD_ARGUMENTS=(-c release)
    18	if [[ "${UNIVERSAL:-1}" == "1" ]]; then
    19	    BUILD_ARGUMENTS+=(--arch arm64 --arch x86_64)
    20	fi
    21	
    22	swift build "${BUILD_ARGUMENTS[@]}"
    23	BIN_DIR="$(swift build "${BUILD_ARGUMENTS[@]}" --show-bin-path)"
    24	cp "$BIN_DIR/ReluxProxy" "$BUNDLE/Contents/MacOS/ReluxProxy"
    25	cp "$ROOT/Resources/Info.plist" "$BUNDLE/Contents/Info.plist"
    26	swift "$ROOT/scripts/generate-icon.swift" "$BUNDLE/Contents/Resources/ReluxProxy.icns"
    27	
    28	/usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $SHORT_VERSION" "$BUNDLE/Contents/Info.plist"
    29	/usr/libexec/PlistBuddy -c "Set :CFBundleVersion $BUILD_NUMBER" "$BUNDLE/Contents/Info.plist"
    30	
    31	if [[ "$SIGN_IDENTITY" == "-" ]]; then
    32	    codesign --force --sign - "$BUNDLE"
    33	elif security find-identity -v -p codesigning | grep -Fq "$SIGN_IDENTITY"; then
    34	    codesign --force --options runtime --timestamp --sign "$SIGN_IDENTITY" "$BUNDLE"
    35	else
    36	    echo "warning: '$SIGN_IDENTITY' not found; using an ad-hoc signature" >&2
    37	    codesign --force --sign - "$BUNDLE"
    38	fi
    39	
    40	codesign --verify --deep --strict --verbose=2 "$BUNDLE"
    41	echo "Built $BUNDLE ($VERSION, build $BUILD_NUMBER)"

===== scripts/create-dmg.sh =====
     1	#!/bin/bash
     2	set -euo pipefail
     3	
     4	ROOT="$(cd "$(dirname "$0")/.." && pwd)"
     5	VERSION="${VERSION:-0.1.0-dev}"
     6	VERSION="${VERSION#v}"
     7	APP="$ROOT/dist/ReluxProxy.app"
     8	DMG="$ROOT/dist/ReluxProxy-v$VERSION-universal.dmg"
     9	STAGE="$ROOT/.build/dmg-root"
    10	
    11	if [[ ! -d "$APP" ]]; then
    12	    echo "error: $APP does not exist; run scripts/build-app.sh first" >&2
    13	    exit 1
    14	fi
    15	
    16	rm -rf "$STAGE" "$DMG"
    17	mkdir -p "$STAGE"
    18	cp -R "$APP" "$STAGE/"
    19	ln -s /Applications "$STAGE/Applications"
    20	hdiutil create -volname "Relux Proxy" -srcfolder "$STAGE" -ov -format UDZO "$DMG"
    21	echo "Built $DMG"

