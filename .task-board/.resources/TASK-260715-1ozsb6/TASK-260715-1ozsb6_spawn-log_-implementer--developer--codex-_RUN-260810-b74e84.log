+      result = outcome
+      defer { self.continuation = nil }
+      return self.continuation
+    }
+    continuation?.resume(with: outcome)
+  }
+
+  private func cancelTasks() {
+    let tasks = lock.withLock { (operationTask, timerTask) }
+    tasks.0?.cancel()
+    tasks.1?.cancel()
+  }
+}
