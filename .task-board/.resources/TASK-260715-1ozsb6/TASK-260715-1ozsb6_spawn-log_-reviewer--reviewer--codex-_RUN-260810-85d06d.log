+    OpaquePointer?,
+    UnsafeMutablePointer<UnsafeMutablePointer<UInt8>?>?,
+    UnsafeMutablePointer<Int>?,
+    UnsafePointer<UInt8>?,
+    Int,
+    UnsafeMutablePointer<UnsafeMutableRawPointer?>?
+  ) -> Int32 = { _, signature, signatureLength, payload, payloadLength, abstract in
