   274	/// Fixed-size aggregate state shared by runtime layers.
   275	///
   276	/// Snapshot creation only copies this bounded state while holding the lock.
   277	/// Callers encode the returned immutable value after the lock has been released.
   278	public final class RuntimeDiagnosticsStore: @unchecked Sendable {
   279	  private struct State {
   280	    var runtimeGeneration: UInt64
   281	    var snapshotSequence: UInt64 = 0
   282	    var counters = Dictionary(
   283	      uniqueKeysWithValues: RuntimeDiagnosticsSchema.counterNames.map { ($0, UInt64.zero) }
   284	    )
   285	    var gauges = Dictionary(
   286	      uniqueKeysWithValues: RuntimeDiagnosticsSchema.gaugeNames.map { ($0, Int64.zero) }
   287	    )
   288	    var dnsLatencyCounts = Array(
   289	      repeating: UInt64.zero,
   290	      count: RuntimeDiagnosticsSchema.dnsLatencyBucketUpperBoundsMilliseconds.count
   291	    )
   292	    var errors: [RuntimeErrorDomain: RedactedRuntimeError] = [:]
   293	    var hasAvailableMemorySample = false
   294	
   295	    init(runtimeGeneration: UInt64) {
   296	      self.runtimeGeneration = runtimeGeneration
   297	    }
   298	  }
   299	
   300	  private let lock = NSLock()
   301	  private var state: State
   302	
   303	  public init(runtimeGeneration: UInt64) {
   304	    state = State(runtimeGeneration: runtimeGeneration)
   305	  }
   306	
   307	  public func recorder() -> RuntimeDiagnosticsRecorder {
   308	    lock.withLock {
   309	      RuntimeDiagnosticsRecorder(store: self, runtimeGeneration: state.runtimeGeneration)
   310	    }
   311	  }
   312	
   313	  /// Advances to a strictly newer generation and drops all prior aggregates.
   314	  public func beginGeneration(_ runtimeGeneration: UInt64) throws
   315	    -> RuntimeDiagnosticsRecorder
   316	  {
   317	    try lock.withLock {
   318	      guard runtimeGeneration > state.runtimeGeneration else {
   319	        throw RuntimeDiagnosticsStoreError.generationMustIncrease(
   320	          current: state.runtimeGeneration,
   321	          proposed: runtimeGeneration
   322	        )
   323	      }
   324	      state = State(runtimeGeneration: runtimeGeneration)
   325	      return RuntimeDiagnosticsRecorder(store: self, runtimeGeneration: runtimeGeneration)
   326	    }
   327	  }
   328	
   329	  /// Returns one immutable, self-consistent snapshot without polling any component.
   330	  public func snapshot(
   331	    requestID: OpaqueRuntimeRequestIdentifier? = nil
   332	  ) throws -> RuntimeDiagnosticsSnapshot {
   333	    try lock.withLock {
   334	      guard state.snapshotSequence < UInt64.max else {
   335	        throw RuntimeDiagnosticsStoreError.snapshotSequenceExhausted(
   336	          runtimeGeneration: state.runtimeGeneration
   337	        )
   338	      }
   339	      state.snapshotSequence += 1
   340	      let buckets = zip(
   341	        RuntimeDiagnosticsSchema.dnsLatencyBucketUpperBoundsMilliseconds,
   342	        state.dnsLatencyCounts
   343	      ).map(RuntimeDiagnosticBucket.init)
   344	      return RuntimeDiagnosticsSnapshot(
   345	        requestID: requestID,
   346	        runtimeGeneration: state.runtimeGeneration,
   347	        snapshotSequence: state.snapshotSequence,
   348	        counters: state.counters,
   349	        gauges: state.gauges,
   350	        histograms: [
   351	          "dns_latency_milliseconds": RuntimeDiagnosticHistogram(
   352	            unit: .milliseconds,
   353	            buckets: buckets
   354	          )
   355	        ],
   356	        errors: state.errors.values.sorted { $0.domain.rawValue < $1.domain.rawValue }
   357	      )
   358	    }
   359	  }
   360	
   361	  fileprivate func incrementCounter(_ name: String, by amount: UInt64, generation: UInt64) {
   362	    guard amount > 0 else { return }
   363	    lock.withLock {
   364	      guard generation == state.runtimeGeneration else { return }
   365	      guard RuntimeDiagnosticsSchema.counterNameSet.contains(name) else {
   366	        incrementKnownCounter("diagnostics_rejected_metric_update_total", by: 1)
   367	        return
   368	      }
   369	      incrementKnownCounter(name, by: amount)
   370	    }
   371	  }
   372	
   373	  fileprivate func setGauge(_ name: String, to value: Int64, generation: UInt64) {
   374	    lock.withLock {
   375	      guard generation == state.runtimeGeneration else { return }
   376	      guard value >= 0, RuntimeDiagnosticsSchema.gaugeNameSet.contains(name) else {
   377	        incrementKnownCounter("diagnostics_rejected_metric_update_total", by: 1)
   378	        return
   379	      }
   380	      switch name {
   381	      case "packet_bridge_forward_datagram_max_bytes",
   382	        "packet_bridge_reverse_datagram_max_bytes",
   383	        "memory_physical_footprint_peak_bytes",
   384	        "tcp_peak_flows",
   385	        "hev_transmitted_packets",
   386	        "hev_transmitted_bytes",
   387	        "hev_received_packets",
   388	        "hev_received_bytes":
   389	        state.gauges[name] = max(state.gauges[name] ?? 0, value)
   390	      case "memory_available_min_bytes":
   391	        if state.hasAvailableMemorySample {
   392	          state.gauges[name] = min(state.gauges[name] ?? value, value)
   393	        } else {
   394	          state.gauges[name] = value
   395	          state.hasAvailableMemorySample = true
   396	        }
   397	      default:
   398	        state.gauges[name] = value
   399	      }
   400	    }
   401	  }
   402	
   403	  fileprivate func metricsSnapshot(generation: UInt64) -> TunnelMetricsSnapshot {
   404	    lock.withLock {
   405	      guard generation == state.runtimeGeneration else {
   406	        return TunnelMetricsSnapshot(
   407	          schemaVersion: RuntimeDiagnosticsSchema.version,
   408	          counters: Dictionary(
   409	            uniqueKeysWithValues: RuntimeDiagnosticsSchema.counterNames.map { ($0, 0) }
   410	          ),
   411	          gauges: Dictionary(
   412	            uniqueKeysWithValues: RuntimeDiagnosticsSchema.gaugeNames.map { ($0, 0) }
   413	          )
   414	        )
   415	      }
   416	      return TunnelMetricsSnapshot(
   417	        schemaVersion: RuntimeDiagnosticsSchema.version,
   418	        counters: state.counters,
   419	        gauges: state.gauges
   420	      )
   421	    }
   422	  }
   423	
   424	  fileprivate func recordStateTransition(
   425	    to lifecycleState: TunnelLifecycleState,
   426	    atUptimeMilliseconds: UInt64,
   427	    generation: UInt64
   428	  ) {
   429	    lock.withLock {
   430	      guard generation == state.runtimeGeneration else { return }
   431	      incrementKnownCounter(RuntimeDiagnosticsMetricMap.transitionCounter(lifecycleState), by: 1)
   432	      let timeGauge = RuntimeDiagnosticsMetricMap.transitionTimeGauge(lifecycleState)
   433	      state.gauges[timeGauge] = max(
   434	        state.gauges[timeGauge] ?? 0,
   435	        clampedInt64(atUptimeMilliseconds)
   436	      )
   437	    }
   438	  }
   439	
   440	  fileprivate func recordTCPFlowOpened(generation: UInt64) {
   441	    lock.withLock {
   442	      guard generation == state.runtimeGeneration else { return }
   443	      incrementKnownCounter("tcp_flows_opened_total", by: 1)
   444	      let current = state.gauges["tcp_active_flows"] ?? 0
   445	      let active = current == Int64.max ? Int64.max : current + 1
   446	      state.gauges["tcp_active_flows"] = active
   447	      state.gauges["tcp_peak_flows"] = max(state.gauges["tcp_peak_flows"] ?? 0, active)
   448	    }
   449	  }
   450	
   451	  fileprivate func recordTCPFlowClosed(generation: UInt64) {
   452	    lock.withLock {
   453	      guard generation == state.runtimeGeneration else { return }
   454	      let active = state.gauges["tcp_active_flows"] ?? 0
   455	      guard active > 0 else {
   456	        incrementKnownCounter("diagnostics_rejected_metric_update_total", by: 1)
   457	        return
   458	      }
   459	      state.gauges["tcp_active_flows"] = active - 1
   460	      incrementKnownCounter("tcp_flows_closed_total", by: 1)
   461	    }
   462	  }
   463	
   464	  fileprivate func recordDNSResult(
   465	    _ result: RuntimeDNSResultClass,
   466	    latencyMilliseconds: UInt64,
   467	    generation: UInt64
   468	  ) {
   469	    lock.withLock {
   470	      guard generation == state.runtimeGeneration else { return }
   471	      incrementKnownCounter(RuntimeDiagnosticsMetricMap.dnsResultCounter(result), by: 1)
   472	      for index in state.dnsLatencyCounts.indices
   473	      where latencyMilliseconds
   474	        <= RuntimeDiagnosticsSchema.dnsLatencyBucketUpperBoundsMilliseconds[index]
   475	      {
   476	        state.dnsLatencyCounts[index] = state.dnsLatencyCounts[index].saturatingAdding(1)
   477	      }
   478	    }
   479	  }
   480	
   481	  fileprivate func recordRoute(
   482	    mode: RuntimeRouteMode,
   483	    installed: Bool,
   484	    generation: UInt64
   485	  ) {
   486	    lock.withLock {
   487	      guard generation == state.runtimeGeneration else { return }
   488	      state.gauges["route_mode_compatible"] = mode == .compatible ? 1 : 0
   489	      state.gauges["route_mode_unknown"] = mode == .unknown ? 1 : 0
   490	      state.gauges["route_installed"] = installed ? 1 : 0
   491	    }
   492	  }
   493	
   494	  fileprivate func recordMemorySample(
   495	    physicalFootprintBytes: UInt64,
   496	    availableMemoryBytes: UInt64,
   497	    generation: UInt64
   498	  ) {
   499	    lock.withLock {
   500	      guard generation == state.runtimeGeneration else { return }
   501	      let footprint = clampedInt64(physicalFootprintBytes)
   502	      let available = clampedInt64(availableMemoryBytes)
   503	      incrementKnownCounter("memory_sample_total", by: 1)
   504	      state.gauges["memory_physical_footprint_bytes"] = footprint
   505	      state.gauges["memory_physical_footprint_peak_bytes"] = max(
   506	        state.gauges["memory_physical_footprint_peak_bytes"] ?? 0,
   507	        footprint
   508	      )
   509	      state.gauges["memory_available_bytes"] = available
   510	      state.gauges["memory_available_min_bytes"] =
   511	        state.hasAvailableMemorySample
   512	        ? min(state.gauges["memory_available_min_bytes"] ?? available, available)
   513	        : available
   514	      state.hasAvailableMemorySample = true
   515	    }
   516	  }
   517	
   518	  fileprivate func recordError(_ error: RedactedRuntimeError, generation: UInt64) {
   519	    lock.withLock {
   520	      guard generation == state.runtimeGeneration else { return }
   521	      state.errors[error.domain] = error
   522	    }
   523	  }
   524	
   525	  fileprivate func clearError(domain: RuntimeErrorDomain, generation: UInt64) {
   526	    lock.withLock {
   527	      guard generation == state.runtimeGeneration else { return }
   528	      state.errors.removeValue(forKey: domain)
   529	    }
   530	  }
   531	
   532	  private func incrementKnownCounter(_ name: String, by amount: UInt64) {
   533	    state.counters[name] = (state.counters[name] ?? 0).saturatingAdding(amount)
   534	  }
   535	
   536	  private func clampedInt64(_ value: UInt64) -> Int64 {
   537	    value > UInt64(Int64.max) ? Int64.max : Int64(value)
   538	  }
   539	}
