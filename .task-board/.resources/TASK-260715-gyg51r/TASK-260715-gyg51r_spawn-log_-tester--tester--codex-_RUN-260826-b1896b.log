+    if descriptor >= 0 {
+      lock.lock()
+      activeCount += 1
+      lock.unlock()
+    }
+    return descriptor
+  }
+
+  func closeSocket(_ descriptor: Int32) -> Int32 {
+    let result = Darwin.close(descriptor)
+    if result == 0 {
+      lock.lock()
+      activeCount -= 1
+      lock.unlock()
+    }
+    return result
+  }
