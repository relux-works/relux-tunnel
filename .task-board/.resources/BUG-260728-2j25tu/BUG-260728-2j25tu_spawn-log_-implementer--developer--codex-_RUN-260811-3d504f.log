   818	  private func enqueueInbound(_ record: Data) {
   819	    let charge = queueCharge(for: record.count)
   820	    guard charge <= perAssociationQueuedBytes, owner?.reserveInbound(charge) == true else {
   821	      owner?.recordInputQueueSaturation()
   822	      return
   823	    }
   824	    let continuation = lock.withLock { () -> AsyncStream<Void>.Continuation? in
   825	      guard !closed else { return nil }
   826	      let (next, overflow) = inboundBytes.addingReportingOverflow(charge)
   827	      guard !overflow, next <= perAssociationQueuedBytes else { return nil }
   828	      inbound.append((record, charge))
   829	      inboundBytes = next
   830	      return signalContinuation
   831	    }
   832	    guard let continuation else {
   833	      owner?.releaseInbound(charge)
   834	      owner?.recordInputQueueSaturation()
   835	      return
   836	    }
   837	    continuation.yield(())
   838	  }
