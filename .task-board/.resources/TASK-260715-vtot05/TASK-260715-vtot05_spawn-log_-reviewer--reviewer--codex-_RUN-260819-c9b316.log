   782	        "buildRecipeRevision": config["build"]["recipeRevision"],
   783	        "buildRecipeAggregateSHA256": config["build"]["recipeAggregateSHA256"],
   784	        "toolchainManifestSHA256": next(
   785	            item["sha256"]
