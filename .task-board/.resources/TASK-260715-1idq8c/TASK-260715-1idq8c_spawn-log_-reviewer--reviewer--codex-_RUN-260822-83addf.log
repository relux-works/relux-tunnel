===== scripts/validate_apple_ui_test_artifacts.py =====
     1	#!/usr/bin/env python3
     2	"""Fail closed unless extracted UI-test screenshot evidence is complete."""
     3	
     4	from __future__ import annotations
     5	
     6	import argparse
     7	import json
     8	from pathlib import Path
     9	
    10	
    11	def validate_artifacts(output: Path, expected_steps: list[str]) -> list[Path]:
    12	    manifest_path = output / "screenshots.json"
    13	    try:
    14	        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    15	    except (OSError, json.JSONDecodeError) as error:
    16	        raise ValueError(f"cannot read valid screenshots.json: {error}") from error
    17	
    18	    if not isinstance(manifest, dict) or manifest.get("schemaVersion") != 1:
    19	        raise ValueError("screenshots.json must be a schemaVersion 1 object")
    20	    screenshots = manifest.get("screenshots")
    21	    if not isinstance(screenshots, list) or not screenshots:
    22	        raise ValueError("screenshots.json must contain at least one screenshot")
    23	    if manifest.get("stepScreenshotCount") != len(screenshots):
    24	        raise ValueError("stepScreenshotCount does not match screenshots")
    25	
    26	    output_root = output.resolve()
    27	    paths: list[Path] = []
    28	    names: list[str] = []
    29	    for index, record in enumerate(screenshots):
    30	        if not isinstance(record, dict) or not isinstance(record.get("path"), str):
    31	            raise ValueError(f"screenshot record {index} has no string path")
    32	        path = Path(record["path"]).resolve()
    33	        if output_root not in path.parents:
    34	            raise ValueError(f"screenshot record {index} escapes the artifact directory")
    35	        if path.suffix.lower() != ".png" or not path.is_file() or path.stat().st_size == 0:
    36	            raise ValueError(f"screenshot record {index} is not a non-empty PNG file")
    37	        paths.append(path)
    38	        names.append(path.stem)
    39	
    40	    for expected in expected_steps:
    41	        matches = [name for name in names if name == expected or name.startswith(f"{expected}_")]
    42	        if len(matches) != 1:
    43	            raise ValueError(f"expected exactly one {expected} PNG, found {len(matches)}")
    44	    return paths
    45	
    46	
    47	def main() -> int:
    48	    parser = argparse.ArgumentParser()
    49	    parser.add_argument("output", type=Path)
    50	    parser.add_argument("--expected-step", action="append", default=[])
    51	    args = parser.parse_args()
    52	    try:
    53	        paths = validate_artifacts(args.output, args.expected_step)
    54	    except ValueError as error:
    55	        parser.error(str(error))
    56	    print(f"validated {len(paths)} step screenshots in {args.output}")
    57	    return 0
    58	
    59	
    60	if __name__ == "__main__":
    61	    raise SystemExit(main())

