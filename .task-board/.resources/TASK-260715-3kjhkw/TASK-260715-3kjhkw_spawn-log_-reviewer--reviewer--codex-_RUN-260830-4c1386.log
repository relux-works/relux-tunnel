   177	        ], field: "classCapacity.\(channelClass.rawValue)")
   178	    }
   179	    guard controlInitialWindowBytes <= classLimits[.control]!.maximumAdvertisedWindowBytes,
   180	      ordinaryInitialWindowBytes <= classLimits[.ordinary]!.maximumAdvertisedWindowBytes,
   181	      bulkMaximumWindowBytes <= classLimits[.bulk]!.maximumAdvertisedWindowBytes,
   182	      relayMaximumWindowBytes <= classLimits[.relay]!.maximumAdvertisedWindowBytes
   183	    else {
   184	      throw SSHReceiveWindowConfigurationError.inconsistentBounds("initialAndClassMaximum")
   185	    }
   186	
   187	    self.controlInitialWindowBytes = controlInitialWindowBytes
   188	    self.ordinaryInitialWindowBytes = ordinaryInitialWindowBytes
   189	    self.bulkMinimumWindowBytes = bulkMinimumWindowBytes
   190	    self.bulkMaximumWindowBytes = bulkMaximumWindowBytes
   191	    self.maximumMeasuredBandwidthBitsPerSecond = maximumMeasuredBandwidthBitsPerSecond
   192	    self.maximumMeasuredRTTNanoseconds = maximumMeasuredRTTNanoseconds
   193	    self.relayControlWindowBytes = relayControlWindowBytes
   194	    self.relayBurstDatagramCount = relayBurstDatagramCount
   195	    self.relayMaximumFrameBodyBytes = relayMaximumFrameBodyBytes
   196	    self.relayMaximumWindowBytes = relayMaximumWindowBytes
   197	    self.softInitialWindowCapBytes = softInitialWindowCapBytes
   198	    self.perChannelWindowCeilingBytes = perChannelWindowCeilingBytes
   199	    self.perLaneWindowCeilingBytes = perLaneWindowCeilingBytes
   200	    self.globalWindowCeilingBytes = globalWindowCeilingBytes
   201	    self.globalLedgerCeilingBytes = globalLedgerCeilingBytes
   202	    self.classLimits = classLimits
   203	  }
   204	
   205	  fileprivate static func checkedSum(_ values: [Int], field: String) throws -> Int {
   206	    try values.reduce(0) { partial, value in
   207	      let (sum, overflow) = partial.addingReportingOverflow(value)
   208	      guard !overflow else {
   209	        throw SSHReceiveWindowConfigurationError.arithmeticOverflow(field)
   210	      }
   211	      return sum
   212	    }
   213	  }
   214	}
