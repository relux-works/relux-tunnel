+                index += 3
+            else:
+                index += 1
+        elif state == "raw-string":
+            closing = '"' + ("#" * raw_hashes)
+            if text.startswith(closing, index):
+                state = "code"
+                index += len(closing)
+            else:
+                index += 1
+        else:
+            closing = '\"\"\"' + ("#" * raw_hashes)
+            if text.startswith(closing, index):
+                state = "code"
+                index += len(closing)
+            else:
+                index += 1
+    if state in {
+        "block-comment",
+        "string",
+        "multiline-string",
+        "raw-string",
+        "raw-multiline-string",
+    }:
