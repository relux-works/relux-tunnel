   156	/// Shared non-waiting reservation authority for all pump-owned byte buffers.
   157	///
   158	/// Reservations cover fixed capacities rather than current `Data.count`, so
   159	/// concurrent flows cannot overcommit the caller's aggregate ceiling. Capacity
   160	/// denial never queues a waiter.
   161	public actor BytePumpBufferBudget {
   162	  public nonisolated let maximumReservedBytes: Int
   163	
   164	  private var reservedBytes = 0
   165	  private var peakReservedBytes = 0
   166	  private var successfulReservations: UInt64 = 0
   167	  private var deniedReservations: UInt64 = 0
   168	  private var releases: UInt64 = 0
   169	  private var releaseViolations: UInt64 = 0
   170	
   171	  public init(maximumReservedBytes: Int) throws {
   172	    guard maximumReservedBytes > 0 else {
   173	      throw BytePumpConfigurationError.nonPositive(.maximumAggregateReservedBytes)
   174	    }
   175	    self.maximumReservedBytes = maximumReservedBytes
   176	  }
   177	
   178	  public func tryReserve(bytes: Int) -> Bool {
   179	    guard bytes > 0 else {
   180	      deniedReservations = Self.incremented(deniedReservations)
   181	      return false
   182	    }
