/bin/zsh -lc 'mkdir -p .inspection
host_profile=.build/Products/Debug/ReluxTunnelMacHostProvisioning.app/Contents/embedded.provisionprofile
security cms -D -i "$host_profile" > .inspection/host.plist
profile_json=$(plutil -convert json -o - .inspection/host.plist)
current_device=$(ioreg -rd1 -c IOPlatformExpertDevice | awk -F'"'\"' '/IOPlatformUUID/{print "'$(NF-1); exit}'"')
current_device_ref="'$(printf '"'%s' \""'$current_device" | shasum -a 256 | awk '"'{print substr("'$1,1,12)}'"')
profile_has_current="'$(printf '"'%s' \""'$profile_json" | jq --arg device "$current_device" '"'[.ProvisionedDevices[]?] | any(. == "'$device)'"')
profile_device_count="'$(printf '"'%s' \""'$profile_json" | jq '"'.ProvisionedDevices | length')
printf '%s' \""'$profile_json" | jq --arg deviceRef "sha256:$current_device_ref" --argjson hasCurrent "$profile_has_current" --argjson deviceCount "$profile_device_count" '"'{name:.Name, uuid:.UUID, platform:.Platform, teamIdentifier:.TeamIdentifier, applicationIdentifierPrefix:.ApplicationIdentifierPrefix, applicationIdentifier:.Entitlements[\"com.apple.application-identifier\"], networkExtension:.Entitlements[\"com.apple.developer.networking.networkextension\"], appGroupsPresent:(.Entitlements | has(\"com.apple.security.application-groups\")), keychainAccessGroups:.Entitlements[\"keychain-access-groups\"], provisionedDeviceCount:"'$deviceCount, containsCurrentMac:$hasCurrent, currentMacRef:$deviceRef, creationDate:.CreationDate, expirationDate:.ExpirationDate, getTaskAllow:.Entitlements["get-task-allow"], developerCertificateCount:(.DeveloperCertificates|length)}'"'" in /Users/iv/Developer/relux-tunnel/.temp/TASK-260715-3jloqy/provisioning-project
