      ) {
        await connection.close()
      }
    }
    if ownedTasks.isEmpty {
      clearAutomaticTaskReferences()
    } else if let remaining = remainingDuration(until: deadline) {
      _ = try? await withReservedTimeout(
        remaining,
        clock: dependencies.clock,
