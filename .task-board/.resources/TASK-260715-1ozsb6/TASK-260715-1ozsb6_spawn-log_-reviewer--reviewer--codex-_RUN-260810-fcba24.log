  1551	  private func performChannelExit(identity: SSHChannelIdentity) async throws -> SSHExecExit {
  1552	    guard let record = channels[identity], record.kind == .exec, let configuration else {
  1553	      throw transportError(code: .invalidState, phase: .execExit, scope: .channel(identity))
  1554	    }
  1555	    let deadline = dependencies.clock.now().advanced(by: configuration.timeouts.execExit)
  1556	    while libssh2_channel_eof(record.pointer) == 0 {
  1557	      try checkChannelDisposition(identity: identity, phase: .execExit)
  1558	      try await progress(
  1559	        until: deadline,
  1560	        phase: .execExit,
  1561	        scope: .channel(identity)
  1562	      )
  1563	    }
  1564	
  1565	    var signal: UnsafeMutablePointer<CChar>?
  1566	    var signalLength = 0
  1567	    let result = libssh2_channel_get_exit_signal(
  1568	      record.pointer,
  1569	      &signal,
  1570	      &signalLength,
  1571	      nil,
  1572	      nil,
  1573	      nil,
  1574	      nil
  1575	    )
  1576	    guard result == 0 else { return .notReported }
  1577	    guard let signal, signalLength > 0 else {
  1578	      // libssh2 exposes status 0 without a presence bit. Returning it would
  1579	      // fabricate the M3-deferred exact-exit semantic.
  1580	      return .notReported
  1581	    }
