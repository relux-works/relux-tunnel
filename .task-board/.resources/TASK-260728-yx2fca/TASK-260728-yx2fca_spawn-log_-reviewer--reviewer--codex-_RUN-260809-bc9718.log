    exec: SSHExecRequest,
    source: any SSHUploadSource,
    channelPolicy: SSHChannelPolicy,
    chunkBytes: Int
  ) throws {
    guard chunkBytes > 0 else {
      throw SSHContractValidationError.nonPositive(.uploadChunkBytes)
