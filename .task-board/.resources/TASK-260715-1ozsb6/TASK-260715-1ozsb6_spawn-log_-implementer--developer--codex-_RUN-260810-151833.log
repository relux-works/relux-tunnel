  1719	    case "INT": .interrupt
  1720	    case "QUIT": .quit
  1721	    case "ILL": .illegalInstruction
  1722	    case "ABRT": .abort
  1723	    case "FPE": .floatingPointException
  1724	    case "KILL": .kill
  1725	    case "SEGV": .segmentationFault
  1726	    case "PIPE": .pipe
