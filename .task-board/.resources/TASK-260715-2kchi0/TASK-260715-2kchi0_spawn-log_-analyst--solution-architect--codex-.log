+  "$base" "$fixtures/TASK-260715-2kchi0_invalid-environment-measured-pass-invalid.overlay.json" \
+  >"$output_dir/invalid-environment-status.json"
+reject invalid-environment-status "$output_dir/invalid-environment-status.json"
+
+hostile_filters=(
+  '.review.reviewer = {"available":false,"reasonCode":"not-measured","reason":"Hostile mutation.","ownerTaskID":"TASK-260721-2ohf99"}'
+  '.review.reviewedAtUTC = {"available":false,"reasonCode":"not-measured","reason":"Hostile mutation.","ownerTaskID":"TASK-260721-2ohf99"}'
+  '.review.classification = {"available":false,"reasonCode":"not-measured","reason":"Hostile mutation.","ownerTaskID":"TASK-260721-2ohf99"}'
+  '.review.comparisonGroupID = {"available":false,"reasonCode":"not-measured","reason":"Hostile mutation.","ownerTaskID":"TASK-260721-2ohf99"}'
+  '.review.candidateCount = 0'
+  '.review.exactCoverage = {"available":false,"reasonCode":"not-measured","reason":"Hostile mutation.","ownerTaskID":"TASK-260721-2ohf99"}'
+  '.comparison = {"available":false,"reasonCode":"not-measured","reason":"Hostile mutation.","ownerTaskID":"TASK-260721-2ohf99"}'
+  '.review.acceptedUpdateLineage = []'
+  '.authority.provisional = true'
+  '.authority.blockers = ["TASK-260715-1gjxer"]'
+  '.policies.dns.productionAuthorizationPermitted = false'
+  '.gates.cleanup.passed = false'
+  '.privacy.privacyScan.passed = false'
+)
+
+hostile_index=0
+for filter in "${hostile_filters[@]}"; do
+  hostile_index=$((hostile_index + 1))
+  jq "$filter" "$output_dir/production.json" >"$output_dir/production-hostile-$hostile_index.json"
+  reject "production-hostile-$hostile_index" "$output_dir/production-hostile-$hostile_index.json"
+done
+
+echo "TASK-260715-2kchi0 contract schema regression: pass"
