        *family = HEV_SOCKS5_ADDR_FAMILY_IPV4;
        break;
    }
    case HEV_SOCKS5_ADDR_TYPE_IPV6: {
        hev_socks5_ipv6_into_sockaddr6 (addr, saddr);
        *family = HEV_SOCKS5_ADDR_FAMILY_IPV6;
        break;
    }
    case HEV_SOCKS5_ADDR_TYPE_NAME: {
        char name[256];
        uint16_t port;
