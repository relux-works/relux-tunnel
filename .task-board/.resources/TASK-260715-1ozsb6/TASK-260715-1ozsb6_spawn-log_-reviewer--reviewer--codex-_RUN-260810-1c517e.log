   304	  private var waiters: [Waiter] = []
   305	  private var shutDown = false
   306	
   307	  init(maximumWaiters: Int) {
   308	    precondition(maximumWaiters > 0)
   309	    self.maximumWaiters = maximumWaiters
   310	  }
   311	
   312	  var pendingCount: Int {
   313	    lock.withLock { waiters.count + (activeIdentifier == nil ? 0 : 1) }
