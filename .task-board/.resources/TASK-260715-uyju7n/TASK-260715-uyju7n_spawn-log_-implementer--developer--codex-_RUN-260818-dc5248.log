// --- check_item / uncheck_item / add_checklist_item ---

func registerCheckItem(s *agentquery.Schema[BoardItem], store board.DataStore) {
	s.MutationWithMetadata("check_item", func(ctx agentquery.MutationContext[BoardItem]) (any, error) {
		id := positionalArg(ctx.Args)
		itemStr := ctx.ArgMap["item"]
		if id == "" {
			return nil, fmt.Errorf("id is required")
		}
		if itemStr == "" {
			return nil, fmt.Errorf("item is required")
		}

		itemNum, err := strconv.Atoi(itemStr)
		if err != nil {
			return nil, fmt.Errorf("item must be an integer: %w", err)
		}

		if ctx.DryRun {
			pd, err := store.ReadProgress(id)
			if err != nil {
				return nil, err
			}
			if itemNum < 1 || itemNum > len(pd.Checklist) {
				return nil, fmt.Errorf("item %d out of range (1-%d)", itemNum, len(pd.Checklist))
			}
			return map[string]any{
				"dry_run": true,
				"id":      id,
				"item":    itemNum,
				"text":    pd.Checklist[itemNum-1].Text,
			}, nil
		}

		return withSerializedMutation(store, func() (any, error) {
			pd, err := store.ReadProgress(id)
			if err != nil {
				return nil, err
			}

			if itemNum < 1 || itemNum > len(pd.Checklist) {
				return nil, fmt.Errorf("item %d out of range (1-%d)", itemNum, len(pd.Checklist))
			}

			pd.Checklist[itemNum-1].Checked = true
			if err := store.WriteProgress(id, pd); err != nil {
				return nil, err
			}

			return map[string]any{
				"id":      id,
				"item":    itemNum,
				"text":    pd.Checklist[itemNum-1].Text,
				"checked": true,
			}, nil
		})
	}, agentquery.MutationMetadata{
		Description: "Check a checklist item",
		Parameters: []agentquery.ParameterDef{
			{Name: "id", Type: "string", Required: true, Description: "Element ID"},
			{Name: "item", Type: "int", Required: true, Description: "Checklist item number (1-based)"},
		},
		Examples:   []string{"check_item(TASK-260218-abc123, item=1)"},
		Idempotent: true,
	})
}

func registerUncheckItem(s *agentquery.Schema[BoardItem], store board.DataStore) {
	s.MutationWithMetadata("uncheck_item", func(ctx agentquery.MutationContext[BoardItem]) (any, error) {
		id := positionalArg(ctx.Args)
		itemStr := ctx.ArgMap["item"]
		if id == "" {
			return nil, fmt.Errorf("id is required")
		}
		if itemStr == "" {
			return nil, fmt.Errorf("item is required")
		}

		itemNum, err := strconv.Atoi(itemStr)
		if err != nil {
			return nil, fmt.Errorf("item must be an integer: %w", err)
		}

		if ctx.DryRun {
			pd, err := store.ReadProgress(id)
			if err != nil {
				return nil, err
			}
			if itemNum < 1 || itemNum > len(pd.Checklist) {
				return nil, fmt.Errorf("item %d out of range (1-%d)", itemNum, len(pd.Checklist))
			}
			return map[string]any{
				"dry_run": true,
				"id":      id,
				"item":    itemNum,
				"text":    pd.Checklist[itemNum-1].Text,
			}, nil
		}

		return withSerializedMutation(store, func() (any, error) {
			pd, err := store.ReadProgress(id)
			if err != nil {
				return nil, err
			}

			if itemNum < 1 || itemNum > len(pd.Checklist) {
				return nil, fmt.Errorf("item %d out of range (1-%d)", itemNum, len(pd.Checklist))
			}

			pd.Checklist[itemNum-1].Checked = false
			if err := store.WriteProgress(id, pd); err != nil {
				return nil, err
			}

			return map[string]any{
				"id":        id,
				"item":      itemNum,
				"text":      pd.Checklist[itemNum-1].Text,
				"unchecked": true,
			}, nil
		})
	}, agentquery.MutationMetadata{
		Description: "Uncheck a checklist item",
		Parameters: []agentquery.ParameterDef{
			{Name: "id", Type: "string", Required: true, Description: "Element ID"},
			{Name: "item", Type: "int", Required: true, Description: "Checklist item number (1-based)"},
		},
		Examples:   []string{"uncheck_item(TASK-260218-abc123, item=2)"},
		Idempotent: true,
	})
}

