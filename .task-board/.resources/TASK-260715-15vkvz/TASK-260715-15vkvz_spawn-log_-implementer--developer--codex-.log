+        register: { source.register($0) },
+        unregister: { source.unregister($0) },
+        completion: completion
+      )
+    case .macOS:
+      MacOSVPNStatusObservation(
+        status: { source.readStatus() },
+        register: { source.register($0) },
+        unregister: { source.unregister($0) },
