   552	/// Validated finite-token error code. It cannot contain endpoints or error text.
   553	public struct RedactedRuntimeErrorCode: Codable, Hashable, Sendable {
   554	  public static let maximumUTF8Bytes = 64
   555	  public let rawValue: String
   556	
   557	  public init(_ rawValue: String) throws {
   558	    guard Self.isValid(rawValue) else {
   559	      throw RuntimeMessageCodecError.unsupportedValue
   560	    }
   561	    self.rawValue = rawValue
   562	  }
   563	
   564	  public init(from decoder: any Decoder) throws {
   565	    try self.init(try decoder.singleValueContainer().decode(String.self))
   566	  }
   567	
   568	  public func encode(to encoder: any Encoder) throws {
   569	    var container = encoder.singleValueContainer()
   570	    try container.encode(rawValue)
   571	  }
   572	
   573	  private static func isValid(_ value: String) -> Bool {
   574	    guard !value.isEmpty, value.utf8.count <= maximumUTF8Bytes else { return false }
   575	    return value.utf8.allSatisfy {
   576	      (UInt8(ascii: "a")...UInt8(ascii: "z")).contains($0)
   577	        || (UInt8(ascii: "0")...UInt8(ascii: "9")).contains($0)
   578	        || $0 == UInt8(ascii: "_")
   579	    }
   580	  }
   581	}
