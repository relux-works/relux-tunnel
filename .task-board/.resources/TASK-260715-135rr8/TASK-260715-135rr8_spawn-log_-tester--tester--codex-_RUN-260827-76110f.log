  1057	private func measureRealHEVLifecycle(
  1058	  cycles: Int,
  1059	  enforceTrendGate: Bool = true
  1060	) async throws
  1061	  -> PhysicalMemoryLifecycleEvidence
  1062	{
  1063	  var acceptedSessions = 0
  1064	  var samples = preallocatedLifecycleSamples(cycles: cycles)
  1065	  let initial = try physicalProcessSnapshot()
  1066	
  1067	  for iteration in 0..<cycles {
  1068	    let descriptorBaseline = openDescriptorCount()
  1069	    let harness = RealHEVBridgeHarness(adapterMode: .stallAfterAuthentication)
  1070	    let handle = try await harness.start()
  1071	    try harness.driver.deliver(
  1072	      makeUDPPacket(
  1073	        family: .ipv4,
  1074	        source: Data([10, 43, UInt8(iteration / 250), UInt8(iteration % 250 + 1)]),
  1075	        destination: Data([192, 0, 2, 1]),
  1076	        sourcePort: UInt16(55_000 + iteration),
  1077	        destinationPort: 7,
  1078	        payload: Data([UInt8(truncatingIfNeeded: iteration)])
  1079	      )
  1080	    )
  1081	    #expect(
  1082	      await eventually(timeout: .seconds(3)) {
  1083	        harness.adapter.acceptedCount == 1
  1084	      },
  1085	      "cycle \(iteration) did not reach the real SOCKS boundary"
  1086	    )
  1087	    acceptedSessions += harness.adapter.acceptedCount
  1088	
  1089	    harness.adapter.closeAll()
  1090	    await harness.stop(handle)
  1091	    harness.driver.releaseLateRead()
  1092	    let driver = harness.driver.snapshot()
  1093	    let access = harness.accessRecorder.snapshot()
  1094	    let metrics = await harness.metrics.snapshot()
  1095	    #expect(driver.outstandingReadCount == 0)
  1096	    #expect(driver.queuedBatchCount == 0)
  1097	    #expect(harness.adapter.liveChannelCount == 0)
  1098	    #expect(access.starts == 1)
  1099	    #expect(access.stops == 1)
  1100	    #expect(metrics.counters["hev_start_total"] == 1)
  1101	    #expect(metrics.counters["hev_main_return_total"] == 1)
  1102	    #expect(await harness.bridge.lifecycleState() == .stopped(lastRunID: "integration-run-1"))
  1103	    await expectHarnessOwnedResourcesReleased(
  1104	      harness,
  1105	      descriptorBaseline: descriptorBaseline
  1106	    )
  1107	    let process = try physicalProcessSnapshot()
  1108	    samples.append(
  1109	      PhysicalMemoryLifecycleSample(
  1110	        cycle: iteration + 1,
  1111	        descriptors: process.descriptors,
  1112	        processThreads: process.threads,
  1113	        physicalFootprintBytes: process.physicalFootprintBytes,
  1114	        liveHEVSessionsAfterCleanup: harness.adapter.liveChannelCount,
  1115	        outstandingReadsAfterCleanup: driver.outstandingReadCount,
  1116	        queuedBatchesAfterCleanup: driver.queuedBatchCount,
  1117	        boundaryStarts: access.starts,
  1118	        boundaryStops: access.stops,
  1119	        hevStartTotal: metrics.counters["hev_start_total", default: 0],
  1120	        hevMainReturnTotal: metrics.counters["hev_main_return_total", default: 0]
  1121	      )
  1122	    )
  1123	  }
  1124	
  1125	  let final = try physicalProcessSnapshot()
  1126	  let footprintAnalysis = analyzeLifecycleFootprint(
  1127	    samples.map(\.physicalFootprintBytes),
  1128	    warmupSampleCount: 10,
  1129	    convergencePolicy: .physicalHEVLifecycle
  1130	  )
  1131	  #expect(acceptedSessions == cycles)
  1132	  guard !enforceTrendGate || footprintAnalysis.boundedConvergenceObserved else {
  1133	    throw IntegrationTestError.fixture(
  1134	      "physical footprint did not prove bounded convergence: samples=\(footprintAnalysis.analyzedSampleCount), post-warmup net/max-drawup=\(footprintAnalysis.netChangeBytes)/\(footprintAnalysis.postWarmupMaximumDrawupBytes), trailing net/max-drawup=\(footprintAnalysis.trailingNetChangeBytes)/\(footprintAnalysis.trailingMaximumDrawupBytes), trailing increase/equal/decrease=\(footprintAnalysis.trailingIncreaseTransitionCount)/\(footprintAnalysis.trailingEqualTransitionCount)/\(footprintAnalysis.trailingDecreaseTransitionCount), ceiling=\(footprintAnalysis.convergencePolicy.absolutePostWarmupGrowthCeilingBytes)"
  1135	    )
  1136	  }
  1137	  return PhysicalMemoryLifecycleEvidence(
  1138	    cycles: cycles,
  1139	    result:
  1140	      footprintAnalysis.boundedConvergenceObserved
  1141	      ? "measured in this emitting process; ownership invariants and bounded physical-footprint convergence passed"
  1142	      : "measured in this emitting process; ownership invariants passed but bounded physical-footprint convergence was not established",
  1143	    cancellationPoints:
  1144	      "covered by PacketFlowBridge lifecycle/fault suites at pre-borrow, active read, and stop",
  1145	    initialDescriptors: initial.descriptors,
  1146	    finalDescriptors: final.descriptors,
  1147	    initialThreads: initial.threads,
  1148	    finalThreads: final.threads,
  1149	    initialPhysicalFootprintBytes: initial.physicalFootprintBytes,
  1150	    finalPhysicalFootprintBytes: final.physicalFootprintBytes,
  1151	    warmupSampleCount: footprintAnalysis.warmupSampleCount,
  1152	    analyzedSampleCount: footprintAnalysis.analyzedSampleCount,
  1153	    netPhysicalFootprintChangeBytes: footprintAnalysis.netChangeBytes,
  1154	    increaseTransitionCount: footprintAnalysis.increaseTransitionCount,
  1155	    equalTransitionCount: footprintAnalysis.equalTransitionCount,
  1156	    decreaseTransitionCount: footprintAnalysis.decreaseTransitionCount,
  1157	    monotonicGrowthObserved: footprintAnalysis.monotonicGrowthObserved,
  1158	    minimumCycleCountForConvergence: footprintAnalysis.convergencePolicy.minimumSampleCount,
  1159	    trailingSampleCount: footprintAnalysis.convergencePolicy.trailingSampleCount,
  1160	    absolutePostWarmupGrowthCeilingBytes: footprintAnalysis.convergencePolicy
  1161	      .absolutePostWarmupGrowthCeilingBytes,
  1162	    trailingNetPhysicalFootprintChangeBytes: footprintAnalysis.trailingNetChangeBytes,
  1163	    trailingIncreaseTransitionCount: footprintAnalysis.trailingIncreaseTransitionCount,
  1164	    trailingEqualTransitionCount: footprintAnalysis.trailingEqualTransitionCount,
  1165	    trailingDecreaseTransitionCount: footprintAnalysis.trailingDecreaseTransitionCount,
  1166	    postWarmupMaximumDrawupBytes: footprintAnalysis.postWarmupMaximumDrawupBytes,
  1167	    trailingMaximumDrawupBytes: footprintAnalysis.trailingMaximumDrawupBytes,
  1168	    boundedConvergenceObserved: footprintAnalysis.boundedConvergenceObserved,
  1169	    increaseCycles: footprintAnalysis.increaseCycles,
  1170	    samples: samples
  1171	  )
  1172	}
