+#!/usr/bin/env python3
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parents[3]
+MODULE_PATH = ROOT / "scripts" / "relay_supply_chain.py"
+SPEC = importlib.util.spec_from_file_location("relay_supply_chain_review", MODULE_PATH)
+assert SPEC is not None and SPEC.loader is not None
+SUPPLY_CHAIN = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(SUPPLY_CHAIN)
+CONFIG = SUPPLY_CHAIN.load_json(SUPPLY_CHAIN.SOURCE_PATH)
+
+
+OBJC_COMMAND = (
+    "/usr/bin/clang",
+    "-fsyntax-only",
+    "-x",
+    "objective-c",
+    "-framework",
+    "Foundation",
+    "-",
+)
+C_COMMAND = ("/usr/bin/clang", "-fsyntax-only", "-x", "c", "-")
+
+
+NEGATIVE_CASES = (
+    (
+        "objc-url-hash",
+        "Downloader.m",
+        "#import <Foundation/Foundation.h>\n#define JOIN(a,b) a ## b\nNSData *f(NSURL *u){return [NSData JOIN(dataWith,ContentsOfURL):u];}\n",
+        OBJC_COMMAND,
+        "Objective-C NSData URL loader",
+    ),
+    (
+        "objc-url-digraph",
+        "Downloader.m",
+        "#import <Foundation/Foundation.h>\n#define JOIN(a,b) a %:%: b\nNSData *f(NSURL *u){return [NSData JOIN(dataWith,ContentsOfURL):u];}\n",
+        OBJC_COMMAND,
+        "Objective-C NSData URL loader",
+    ),
+    (
+        "objc-reflection-hash",
+        "Downloader.m",
+        "#import <Foundation/Foundation.h>\n#define JOIN(a,b) a ## b\nid f(id o,SEL s){return [o JOIN(perform,Selector):s];}\n",
+        OBJC_COMMAND,
+        "Objective-C dynamic URL loader",
+    ),
+    (
+        "objc-reflection-digraph",
+        "Downloader.m",
+        "#import <Foundation/Foundation.h>\n#define JOIN(a,b) a %:%: b\nid f(id o,SEL s){return [o JOIN(perform,Selector):s];}\n",
+        OBJC_COMMAND,
+        "Objective-C dynamic URL loader",
+    ),
+    (
+        "foundation-hash",
+        "Downloader.m",
+        "#import <Foundation/Foundation.h>\n#define JOIN(a,b) a ## b\nClass f(void){return [JOIN(NSURL,Session) class];}\n",
+        OBJC_COMMAND,
+        "Foundation network loader",
+    ),
+    (
+        "foundation-digraph",
+        "Downloader.m",
+        "#import <Foundation/Foundation.h>\n#define JOIN(a,b) a %:%: b\nClass f(void){return [JOIN(NSURL,Session) class];}\n",
+        OBJC_COMMAND,
+        "Foundation network loader",
+    ),
+    (
+        "c-process-hash",
+        "downloader.c",
+        "int system(const char *);\n#define JOIN(a,b) a ## b\nint f(char*c){return JOIN(sys,tem)(c);}\n",
+        C_COMMAND,
+        "C-family process execution",
+    ),
+    (
+        "c-process-digraph",
+        "downloader.c",
+        "int system(const char *);\n#define JOIN(a,b) a %:%: b\nint f(char*c){return JOIN(sys,tem)(c);}\n",
+        C_COMMAND,
+        "C-family process execution",
+    ),
+    (
+        "libcurl-hash",
+        "downloader.c",
+        "int curl_easy_perform(void *);\n#define JOIN(a,b) a ## b\nint f(void*h){return JOIN(curl_,easy_perform)(h);}\n",
+        C_COMMAND,
+        "C/C++ libcurl use",
+    ),
+    (
+        "libcurl-digraph",
+        "downloader.c",
+        "int curl_easy_perform(void *);\n#define JOIN(a,b) a %:%: b\nint f(void*h){return JOIN(curl_,easy_perform)(h);}\n",
+        C_COMMAND,
+        "C/C++ libcurl use",
+    ),
+)
+
+
+SAFE_SOURCE = (
+    "#define JOIN(a,b) a ## b\n"
+    "int safeValue = 0;\n"
+    "int f(void){return JOIN(safe,Value);}\n"
+    'const char *note = "dataWith ## ContentsOfURL; perform %:%: Selector";\n'
+    "/* NSURL ## Session; NSSelector ## FromString */\n"
+)
+
+
+def runtime_root(base: Path, file_name: str, source: str) -> Path:
+    for name in ("App", "Sources", "relay"):
+        (base / name).mkdir()
+    (base / "Sources" / file_name).write_text(source, encoding="utf-8")
+    return base
+
+
+def compile_fixture(name: str, source: str, command: tuple[str, ...]) -> None:
+    result = subprocess.run(command, input=source, text=True, capture_output=True)
+    print(f"{name}: compile_exit={result.returncode}")
+    if result.returncode != 0:
+        print(result.stderr, file=sys.stderr)
+        raise SystemExit(1)
+
+
+def main() -> int:
+    failures: list[str] = []
+    for name, file_name, source, command, expected_reason in NEGATIVE_CASES:
+        compile_fixture(name, source, command)
+        with tempfile.TemporaryDirectory() as temporary:
+            root = runtime_root(Path(temporary), file_name, source)
+            try:
+                SUPPLY_CHAIN.scan_runtime(CONFIG, root)
+            except SUPPLY_CHAIN.SupplyChainError as error:
+                message = str(error)
+                rejected = expected_reason in message
+                print(f"{name}: audit_rejected={rejected} reason={message}")
+                if not rejected:
+                    failures.append(name)
+            else:
+                print(f"{name}: audit_rejected=False reason=ACCEPTED")
+                failures.append(name)
+
+    compile_fixture("safe-control", SAFE_SOURCE, C_COMMAND)
+    with tempfile.TemporaryDirectory() as temporary:
+        root = runtime_root(Path(temporary), "Safe.m", SAFE_SOURCE)
+        try:
+            SUPPLY_CHAIN.scan_runtime(CONFIG, root)
+        except SUPPLY_CHAIN.SupplyChainError as error:
+            print(f"safe-control: audit_accepted=False reason={error}")
+            failures.append("safe-control")
+        else:
+            print("safe-control: audit_accepted=True")
+
+    if failures:
+        print("failures=" + ",".join(failures), file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
