+}
+
+private struct PhysicalMemoryMatrixRow: Codable, Sendable {
+  let stage: String
+  let requestedFlowCount: Int
+  let flowCount: Int
+  let traffic: String
+  let physicalFootprintBytes: UInt64
+  let peakPhysicalFootprintBytes: UInt64
+  let availableMemoryBytes: UInt64?
