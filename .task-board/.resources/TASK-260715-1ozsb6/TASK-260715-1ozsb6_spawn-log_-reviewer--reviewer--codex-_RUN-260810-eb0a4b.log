  1482	  private func recordHostDecision(_ decision: SSHHostKeyDecision) async {
  1483	    switch decision.outcome {
  1484	    case .firstUseAccepted:
  1485	      counters.hostFirstUseAccepted += 1
  1486	      await metric(.increment(.hostFirstUseAccepted, by: 1))
  1487	    case .matchAccepted:
  1488	      counters.hostMatchAccepted += 1
  1489	      await metric(.increment(.hostMatchAccepted, by: 1))
  1490	    case .unknownRejected:
  1491	      counters.hostUnknownRejected += 1
  1492	      await metric(.increment(.hostUnknownRejected, by: 1))
  1493	    case .changedRejected:
  1494	      counters.hostChangedRejected += 1
  1495	      await metric(.increment(.hostChangedRejected, by: 1))
  1496	    case .algorithmRejected:
  1497	      counters.hostAlgorithmRejected += 1
  1498	      await metric(.increment(.hostAlgorithmRejected, by: 1))
  1499	    case .policyRejected:
  1500	      break
  1501	    }
  1502	    await emit(.hostDecision(decision.outcome))
  1503	  }
