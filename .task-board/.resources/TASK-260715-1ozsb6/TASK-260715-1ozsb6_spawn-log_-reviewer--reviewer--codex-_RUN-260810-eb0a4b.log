   608	        pendingWrites: Int64(pendingWriteOperations),
   609	        queuedWriteBytes: Int64(pendingWriteBytes.values.reduce(0, +)),
   610	        bufferedReadBytes: Int64(counts.inbound),
   611	        remainingReceiveWindowBytes: .unsupported,
   612	        activeKeyExchange: .unsupported,
