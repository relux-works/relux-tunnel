  if [ "$scan_rc" -eq 1 ]; then
    echo "GATE_RESULT secret_payload_marker_scan exit=0"
  else
    echo "GATE_RESULT secret_payload_marker_scan exit=$scan_rc"
  fi
fi
task-board validate
board_rc=$?
echo "GATE_RESULT board_validate exit=$board_rc"
