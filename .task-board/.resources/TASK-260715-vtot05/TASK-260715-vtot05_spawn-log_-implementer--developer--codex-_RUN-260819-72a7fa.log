+                ) from error
+            scanned_files += 1
+            for label, pattern in FORBIDDEN_RUNTIME_PATTERNS:
+                for match in pattern.finditer(text):
+                    if label == "Foundation Data URL loader" and (
+                        LOCAL_FILE_DATA_READ_PATTERN.match(text, match.start())
+                    ):
+                        continue
