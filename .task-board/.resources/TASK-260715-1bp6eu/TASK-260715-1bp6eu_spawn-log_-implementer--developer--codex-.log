+
+  private func stopAndJoin(
+    reason: ProviderStopReason,
+    generation: UInt64,
+    keepStoppingAfterCleanup: Bool
+  ) async {
+    guard activeGeneration?.identifier == generation || cleanupGeneration == generation else {
+      return
