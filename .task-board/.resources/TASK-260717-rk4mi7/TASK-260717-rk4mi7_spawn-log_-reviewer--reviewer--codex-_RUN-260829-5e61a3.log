   369	  var supportsGentleScheduledUpdateReminders: Bool { true }
   370	
   371	  func standardUserDriverShouldHandleShowingScheduledUpdate(
   372	    _ update: SUAppcastItem,
   373	    andInImmediateFocus immediateFocus: Bool
   374	  ) -> Bool {
   375	    ReluxScheduledUpdatePresentationPolicy.letsSparklePresent(userInitiated: false)
   376	  }
   377	
   378	  func standardUserDriverWillHandleShowingUpdate(
   379	    _ handleShowingUpdate: Bool,
   380	    forUpdate update: SUAppcastItem,
   381	    state: SPUUserUpdateState
   382	  ) {
   383	    if !ReluxScheduledUpdatePresentationPolicy.letsSparklePresent(
   384	      userInitiated: state.userInitiated
   385	    ) {
   386	      Task { @MainActor in
   387	        presentationModel.receive(.updateAvailable)
