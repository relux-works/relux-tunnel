   846	def atomic_exchange(left: Path, right: Path) -> None:
   847	    library = ctypes.CDLL(None, use_errno=True)
   848	    left_bytes = os.fsencode(left)
   849	    right_bytes = os.fsencode(right)
   850	    if sys.platform == "darwin":
   851	        function = library.renameatx_np
   852	        function.argtypes = [
   853	            ctypes.c_int,
   854	            ctypes.c_char_p,
   855	            ctypes.c_int,
   856	            ctypes.c_char_p,
   857	            ctypes.c_uint,
   858	        ]
   859	        function.restype = ctypes.c_int
   860	        result = function(-2, left_bytes, -2, right_bytes, 0x00000002)
   861	    elif sys.platform.startswith("linux"):
   862	        function = library.renameat2
   863	        function.argtypes = [
   864	            ctypes.c_int,
   865	            ctypes.c_char_p,
   866	            ctypes.c_int,
   867	            ctypes.c_char_p,
   868	            ctypes.c_uint,
   869	        ]
   870	        function.restype = ctypes.c_int
   871	        result = function(-100, left_bytes, -100, right_bytes, 0x00000002)
   872	    else:
   873	        raise AssetManifestError(
   874	            "atomic relay asset directory replacement is unavailable"
   875	        )
   876	    if result != 0:
   877	        error_number = ctypes.get_errno()
   878	        raise AssetManifestError(
   879	            "atomic relay asset directory replacement failed"
   880	        ) from OSError(error_number, os.strerror(error_number))
