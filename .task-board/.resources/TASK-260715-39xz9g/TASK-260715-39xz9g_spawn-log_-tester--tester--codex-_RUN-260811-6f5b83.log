/bin/zsh -lc 'cat /Users/iv/.agents/.instructions/INSTRUCTIONS_PLATFORM.md /Users/iv/.agents/.instructions/INSTRUCTIONS_STRUCTURE.md /Users/iv/.agents/.instructions/INSTRUCTIONS_ATTACHMENTS.md /Users/iv/.agents/.instructions/INSTRUCTIONS_TOOLS.md /Users/iv/.agents/.instructions/INSTRUCTIONS_SKILLS.md /Users/iv/.agents/.instructions/INSTRUCTIONS_SKILL_TRIGGERS.md /Users/iv/.agents/.instructions/INSTRUCTIONS_DIAGRAMS.md /Users/iv/.agents/.instructions/INSTRUCTIONS_TESTING.md /Users/iv/.agents/.instructions/INSTRUCTIONS_WORKFLOW.md /Users/iv/.agents/.instructions/INSTRUCTIONS_DOCS.md' in /Users/iv/Developer/relux-tunnel
