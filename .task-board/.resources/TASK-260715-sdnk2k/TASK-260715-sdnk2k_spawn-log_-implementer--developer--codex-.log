+      local.pendingReadinessCount == 1
+    case .localWritable:
+      local.pendingReadinessCount == 1
+    case .sshRead:
+      channel.pendingReadCount == 1
+    case .sshWrite:
+      channel.pendingWriteCount == 1
+    case .fairnessYield:
+      scheduler?.firstYieldReached == true
