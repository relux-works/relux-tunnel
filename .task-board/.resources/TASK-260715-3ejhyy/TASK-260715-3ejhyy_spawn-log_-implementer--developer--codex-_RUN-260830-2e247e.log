+    #expect(startup.firstIndex(of: "settings.apply")! < startup.firstIndex(of: "packet.activate")!)
+
+    await runtime.stop(reason: .userInitiated)
+    await runtime.stop(reason: .userInitiated)
+
+    assertHarnessOrder(
+      [
+        "tcp.close-admission", "dns.close-admission", "packet.stop", "settings.clear",
