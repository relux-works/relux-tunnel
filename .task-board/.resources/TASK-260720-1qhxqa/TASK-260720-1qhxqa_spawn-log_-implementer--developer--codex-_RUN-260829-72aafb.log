   225	    row: str,
   226	) -> None:
   227	    require_exact_keys(resource, RESOURCE_KEYS, row)
   228	    resource_name = resource["resourceName"]
   229	    expected_digest = resource["sha256"]
   230	    if not isinstance(resource_name, str) or not resource_name.startswith(task_id):
   231	        raise BindingError(row, "resource name is not task-scoped")
   232	    path = resources_root / task_id / resource_name
   233	    if not path.is_file():
   234	        raise BindingError(row, f"accepted resource missing: {task_id}/{resource_name}")
   235	    actual_digest = sha256(path)
   236	    if actual_digest != expected_digest:
   237	        raise BindingError(
   238	            row,
   239	            f"SHA-256 mismatch for {task_id}/{resource_name}: expected {expected_digest}, got {actual_digest}",
   240	        )
