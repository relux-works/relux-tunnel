+    let scheduler = FirstYieldGateBytePumpScheduler()
+    let diagnostics = RecordingBytePumpDiagnostics()
+    let budget = try BytePumpBufferBudget(maximumReservedBytes: 128)
+    let pump = try BoundedFullDuplexBytePump(
