  1298	  private func performChannelRead(
  1299	    identity: SSHChannelIdentity,
  1300	    maximumBytes: Int,
  1301	    stream: Int32
  1302	  ) async throws -> Data? {
  1303	    guard maximumBytes > 0 else {
  1304	      throw transportError(
  1305	        code: .invalidArgument,
  1306	        phase: .channelRead,
  1307	        scope: .channel(identity)
  1308	      )
  1309	    }
  1310	    guard let record = channels[identity], !record.closed else {
  1311	      throw transportError(code: .channelClosed, phase: .channelRead, scope: .channel(identity))
  1312	    }
  1313	    let count = min(maximumBytes, record.policy.maximumBufferedReadBytes)
  1314	    while true {
  1315	      try checkCancellation(phase: .channelRead, scope: .channel(identity))
  1316	      try checkChannelDisposition(identity: identity, phase: .channelRead)
  1317	      var data = Data(count: count)
  1318	      let result = data.withUnsafeMutableBytes { bytes in
  1319	        libssh2_channel_read_ex(
  1320	          record.pointer,
  1321	          stream,
  1322	          bytes.bindMemory(to: CChar.self).baseAddress,
  1323	          bytes.count
  1324	        )
  1325	      }
  1326	      if result > 0 {
  1327	        data.removeSubrange(Int(result)..<data.count)
  1328	        counters.payloadBytesReceived += UInt64(result)
  1329	        await metric(.increment(.payloadBytesReceived, by: UInt64(result)))
  1330	        await reconcileProtectedMetrics()
  1331	        scheduleByteRekeyIfNeeded()
  1332	        return data
  1333	      }
  1334	      if result == 0, libssh2_channel_eof(record.pointer) != 0 {
  1335	        await emit(.channelEOF(channel: identity, direction: .remoteRead))
  1336	        return nil
  1337	      }
  1338	      guard result == LIBSSH2_ERROR_EAGAIN || result == 0 else {
  1339	        throw engineError(
  1340	          Int32(result),
  1341	          phase: .channelRead,
  1342	          fallback: .connectionLost,
  1343	          scope: .channel(identity)
  1344	        )
  1345	      }
  1346	      try await progress(phase: .channelRead, scope: .channel(identity))
  1347	    }
  1348	  }
