   559	  private func performSendKeepalive() async throws -> SSHDeferredSemanticReport<Duration> {
   560	    guard state == .ready, let configuration else {
   561	      throw transportError(code: .invalidState, phase: .keepalive)
   562	    }
   563	    let deadline = dependencies.clock.now().advanced(by: configuration.timeouts.keepaliveReply)
   564	    while true {
   565	      try checkCancellation(phase: .keepalive)
   566	      guard state == .ready, let engineSession else {
   567	        throw transportError(code: .cancelled, phase: .keepalive)
   568	      }
