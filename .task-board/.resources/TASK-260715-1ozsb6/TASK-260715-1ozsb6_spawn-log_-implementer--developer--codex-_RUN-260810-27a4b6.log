+  func complete(with result: Result<Void, Error>) {
+    let continuation: CheckedContinuation<Void, Error>? = lock.withLock {
+      guard self.result == nil else { return nil }
+      self.result = result
+      defer { self.continuation = nil }
+      return self.continuation
