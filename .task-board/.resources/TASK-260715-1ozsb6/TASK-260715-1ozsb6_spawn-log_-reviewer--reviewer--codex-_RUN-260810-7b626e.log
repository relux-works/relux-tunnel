   461	      gauges: SSHTransportGauges(
   462	        openDirectChannels: Int64(direct),
   463	        openExecChannels: Int64(exec),
   464	        queuedWriteBytes: Int64(counts.outbound),
   465	        bufferedReadBytes: Int64(counts.inbound),
   466	        remainingReceiveWindowBytes: .unsupported,
   467	        activeKeyExchange: .unsupported,
   468	        consecutiveKeepaliveMisses: .unsupported,
   469	        lastKeepaliveRTTNanoseconds: .unsupported
