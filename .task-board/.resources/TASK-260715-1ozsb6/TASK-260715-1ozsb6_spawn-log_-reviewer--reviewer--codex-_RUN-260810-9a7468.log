   671	  private func performRequestRekey(until deadline: ContinuousClock.Instant) async throws {
   672	    guard state == .ready else {
   673	      throw transportError(code: .invalidState, phase: .rekey)
   674	    }
   675	    await emit(.rekeyTriggered(rekeyReasons))
   676	    try await transition(to: .rekeying)
   677	    await emit(.rekeyStarted(reasons: rekeyReasons, generation: counters.rekeysSucceeded + 1))
   678	    do {
   679	      while true {
   680	        try checkCancellation(phase: .rekey)
   681	        guard state == .rekeying, let engineSession else {
   682	          throw transportError(code: .cancelled, phase: .rekey)
   683	        }
   684	        let result = libssh2_session_rekey(engineSession)
   685	        if result == 0 { break }
   686	        guard result == LIBSSH2_ERROR_EAGAIN else {
   687	          throw engineError(result, phase: .rekey, fallback: .rekeyFailed)
   688	        }
   689	        try await progress(until: deadline, phase: .rekey)
   690	      }
   691	      counters.rekeysSucceeded += 1
   692	      rekeySentBytesBaseline = counters.protectedBytesSent
   693	      rekeyReceivedBytesBaseline = counters.protectedBytesReceived
   694	      await metric(.increment(.rekeysSucceeded, by: 1))
   695	      await emit(.rekeySucceeded(reasons: rekeyReasons, generation: counters.rekeysSucceeded))
   696	      try await transition(to: .ready)
   697	    } catch {
   698	      counters.rekeysFailed += 1
   699	      await metric(.increment(.rekeysFailed, by: 1))
   700	      await emit(
   701	        .rekeyFailed(
   702	          reasons: rekeyReasons,
   703	          generation: counters.rekeysSucceeded + 1,
   704	          code: .rekeyFailed
   705	        )
   706	      )
   707	      throw map(error, phase: .rekey, fallback: .rekeyFailed)
   708	    }
   709	  }
