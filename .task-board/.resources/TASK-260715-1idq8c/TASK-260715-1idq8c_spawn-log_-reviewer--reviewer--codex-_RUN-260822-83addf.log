===== scripts/check-apple-ui-test-contract.py =====
     1	#!/usr/bin/env python3
     2	"""Static safety and single-source checks for Apple UI-test infrastructure."""
     3	
     4	from __future__ import annotations
     5	
     6	import re
     7	from pathlib import Path
     8	
     9	
    10	ROOT = Path(__file__).resolve().parent.parent
    11	SHARED = ROOT / "Sources/ReluxAppleUITestShared"
    12	FIXTURE_HOST = ROOT / "App/ReluxUITestFixtureHost"
    13	UI_TESTS = ROOT / "Tests/ReluxAppleUITestsShared"
    14	LAUNCH_KEYS = SHARED / "ReluxUITestLaunchConfiguration.swift"
    15	
    16	
    17	def fail(message: str) -> None:
    18	    raise SystemExit(f"error: {message}")
    19	
    20	
    21	def swift_files(*roots: Path) -> list[Path]:
    22	    return sorted(path for root in roots for path in root.rglob("*.swift"))
    23	
    24	
    25	def main() -> int:
    26	    files = swift_files(SHARED, FIXTURE_HOST, UI_TESTS)
    27	    if not files:
    28	        fail("Apple UI-test sources are missing")
    29	
    30	    forbidden_waits = re.compile(r"\b(Thread\.sleep|sleep|usleep)\s*\(")
    31	    for path in files:
    32	        text = path.read_text(encoding="utf-8")
    33	        if forbidden_waits.search(text):
    34	            fail(f"fixed wall-clock wait found in {path.relative_to(ROOT)}")
    35	        if path != LAUNCH_KEYS and "RELUX_UI_TEST_" in text:
    36	            fail(f"raw launch key duplicated outside shared authority: {path.relative_to(ROOT)}")
    37	
    38	    project = (ROOT / "Project.swift").read_text(encoding="utf-8")
    39	    for name in (
    40	        "ReluxProxyMacUITestFixtureHost",
    41	        "ReluxProxyMacUITests",
    42	        "ReluxProxyIOSUITestFixtureHost",
    43	        "ReluxProxyIOSUITests",
    44	    ):
    45	        if name not in project:
    46	            fail(f"missing generated target definition: {name}")
    47	    infrastructure = project[project.index("private let appleUITestInfrastructureTargets") :]
    48	    infrastructure = infrastructure[: infrastructure.index("private var generatedSchemeNames")]
    49	    for forbidden in ("NetworkExtension", "ReluxTunnelIOSAdapter", "ReluxTunnelMacOSAdapter"):
    50	        if forbidden in infrastructure:
    51	            fail(f"fixture graph contains prohibited production dependency: {forbidden}")
    52	
    53	    fixtures = (SHARED / "ReluxUITestFixture.swift").read_text(encoding="utf-8")
    54	    for category in (
    55	        "profile",
    56	        "trust",
    57	        "capability",
    58	        "failure",
    59	        "diagnostic",
    60	        "onboarding",
    61	        "migration",
    62	        "privacy",
    63	    ):
    64	        if f"case {category}" not in fixtures:
    65	            fail(f"fixture category missing: {category}")
    66	
    67	    smoke = (ROOT / "scripts/run-apple-ui-test-smoke.sh").read_text(encoding="utf-8")
    68	    for required in (
    69	        "build-for-testing",
    70	        "macos_runtime_status=deferred",
    71	        "macos_runtime_owner=TASK-260822-3q4grm",
    72	        "validate_apple_ui_test_artifacts.py",
    73	        "ios_simulator_artifact_exit",
    74	        "aggregate_build_host_exit",
    75	    ):
    76	        if required not in smoke:
    77	            fail(f"build-host smoke contract missing: {required}")
    78	    if "run_ui_test \\\n  ReluxProxyMacUITests" in smoke:
    79	        fail("build-host smoke must not launch native macOS XCUITest")
    80	
    81	    print("Apple UI-test source, synchronization, fixture, and safety contracts passed")
    82	    return 0
    83	
    84	
    85	if __name__ == "__main__":
    86	    raise SystemExit(main())

===== scripts/extract_apple_ui_test_artifacts.py =====
     1	#!/usr/bin/env python3
     2	"""Extract step screenshots from xcresult into a task-scoped review directory."""
     3	
     4	from __future__ import annotations
     5	
     6	import argparse
     7	import json
     8	import re
     9	import shutil
    10	import subprocess
    11	from pathlib import Path
    12	
    13	
    14	SAFE_COMPONENT = re.compile(r"[^A-Za-z0-9._-]+")
    15	
    16	
    17	def safe_component(value: str) -> str:
    18	    value = SAFE_COMPONENT.sub("_", value).strip("._")
    19	    return value or "unnamed"
    20	
    21	
    22	def organize_attachments(export_directory: Path, output_directory: Path) -> list[dict[str, str]]:
    23	    manifest_path = export_directory / "manifest.json"
    24	    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    25	    records: list[dict[str, str]] = []
    26	    for test in manifest:
    27	        test_name = safe_component(test["testIdentifier"])
    28	        for attachment in test["attachments"]:
    29	            source = export_directory / attachment["exportedFileName"]
    30	            suggested = attachment["suggestedHumanReadableName"]
    31	            if source.suffix.lower() != ".png" or not suggested.startswith("Step_"):
    32	                continue
    33	            destination_directory = output_directory / "screenshots" / test_name
    34	            destination_directory.mkdir(parents=True, exist_ok=True)
    35	            suggested_stem = suggested[:-4] if suggested.lower().endswith(".png") else suggested
    36	            destination = destination_directory / f"{safe_component(suggested_stem)}.png"
    37	            shutil.copy2(source, destination)
    38	            records.append(
    39	                {
    40	                    "test": test["testIdentifier"],
    41	                    "name": suggested,
    42	                    "path": str(destination),
    43	                    "failure": str(bool(attachment["isAssociatedWithFailure"])).lower(),
    44	                }
    45	            )
    46	    records.sort(key=lambda record: (record["test"], record["name"]))
    47	    return records
    48	
    49	
    50	def main() -> int:
    51	    parser = argparse.ArgumentParser()
    52	    parser.add_argument("xcresult", type=Path)
    53	    parser.add_argument("output", type=Path)
    54	    args = parser.parse_args()
    55	
    56	    if ".temp" not in args.output.parts:
    57	        parser.error("output must be task-scoped beneath .temp")
    58	    export_directory = args.output / "xcresult-attachments"
    59	    screenshots_directory = args.output / "screenshots"
    60	    if export_directory.exists():
    61	        shutil.rmtree(export_directory)
    62	    if screenshots_directory.exists():
    63	        shutil.rmtree(screenshots_directory)
    64	    export_directory.mkdir(parents=True)
    65	    subprocess.run(
    66	        [
    67	            "xcrun",
    68	            "xcresulttool",
    69	            "export",
    70	            "attachments",
    71	            "--path",
    72	            str(args.xcresult),
    73	            "--output-path",
    74	            str(export_directory),
    75	        ],
    76	        check=True,
    77	    )
    78	    records = organize_attachments(export_directory, args.output)
    79	    summary = {
    80	        "schemaVersion": 1,
    81	        "xcresult": str(args.xcresult),
    82	        "stepScreenshotCount": len(records),
    83	        "screenshots": records,
    84	    }
    85	    (args.output / "screenshots.json").write_text(
    86	        json.dumps(summary, indent=2, sort_keys=True) + "\n",
    87	        encoding="utf-8",
    88	    )
    89	    if not records:
    90	        raise SystemExit("no step-named PNG screenshots found")
    91	    print(f"extracted {len(records)} step screenshots to {args.output / 'screenshots'}")
    92	    return 0
    93	
    94	
    95	if __name__ == "__main__":
    96	    raise SystemExit(main())

===== scripts/validate_apple_ui_test_artifacts.py =====
     1	#!/usr/bin/env python3
     2	"""Fail closed unless extracted UI-test screenshot evidence is complete."""
     3	
     4	from __future__ import annotations
     5	
     6	import argparse
     7	import json
     8	from pathlib import Path
     9	
    10	
    11	def validate_artifacts(output: Path, expected_steps: list[str]) -> list[Path]:
    12	    manifest_path = output / "screenshots.json"
    13	    try:
    14	        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    15	    except (OSError, json.JSONDecodeError) as error:
    16	        raise ValueError(f"cannot read valid screenshots.json: {error}") from error
    17	
    18	    if not isinstance(manifest, dict) or manifest.get("schemaVersion") != 1:
    19	        raise ValueError("screenshots.json must be a schemaVersion 1 object")
    20	    screenshots = manifest.get("screenshots")
    21	    if not isinstance(screenshots, list) or not screenshots:
    22	        raise ValueError("screenshots.json must contain at least one screenshot")
    23	    if manifest.get("stepScreenshotCount") != len(screenshots):
    24	        raise ValueError("stepScreenshotCount does not match screenshots")
    25	
    26	    output_root = output.resolve()
    27	    paths: list[Path] = []
    28	    names: list[str] = []
    29	    for index, record in enumerate(screenshots):
    30	        if not isinstance(record, dict) or not isinstance(record.get("path"), str):
    31	            raise ValueError(f"screenshot record {index} has no string path")
    32	        path = Path(record["path"]).resolve()
    33	        if output_root not in path.parents:
    34	            raise ValueError(f"screenshot record {index} escapes the artifact directory")
    35	        if path.suffix.lower() != ".png" or not path.is_file() or path.stat().st_size == 0:
    36	            raise ValueError(f"screenshot record {index} is not a non-empty PNG file")
    37	        paths.append(path)
    38	        names.append(path.stem)
    39	
    40	    for expected in expected_steps:
    41	        matches = [name for name in names if name == expected or name.startswith(f"{expected}_")]
    42	        if len(matches) != 1:
    43	            raise ValueError(f"expected exactly one {expected} PNG, found {len(matches)}")
    44	    return paths
    45	
    46	
    47	def main() -> int:
    48	    parser = argparse.ArgumentParser()
    49	    parser.add_argument("output", type=Path)
    50	    parser.add_argument("--expected-step", action="append", default=[])
    51	    args = parser.parse_args()
    52	    try:
    53	        paths = validate_artifacts(args.output, args.expected_step)
    54	    except ValueError as error:
    55	        parser.error(str(error))
    56	    print(f"validated {len(paths)} step screenshots in {args.output}")
    57	    return 0
    58	
    59	
    60	if __name__ == "__main__":
    61	    raise SystemExit(main())

