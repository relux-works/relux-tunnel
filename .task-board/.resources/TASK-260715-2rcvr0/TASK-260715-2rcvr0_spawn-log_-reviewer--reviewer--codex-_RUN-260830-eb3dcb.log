    99	      guard state != .retired else { return [] }
   100	      state = .cancelling
   101	      return Array(handles.values)
   102	    }
   103	    for handle in snapshot {
   104	      handle.cancelProviderWork()
   105	    }
   106	  }
   107	
   108	  public func forceCloseAll() {
