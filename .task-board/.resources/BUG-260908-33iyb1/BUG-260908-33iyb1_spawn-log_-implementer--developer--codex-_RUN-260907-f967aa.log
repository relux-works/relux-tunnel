def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "command", choices=("generate", "validate", "check", "render-swift")
    )
    parser.add_argument("--contract", type=Path, default=DEFAULT_CONTRACT)
