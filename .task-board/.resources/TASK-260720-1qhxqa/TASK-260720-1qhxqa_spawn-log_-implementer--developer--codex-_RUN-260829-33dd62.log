#!/usr/bin/env python3
"""Fail-closed validator for the accepted M0 production binding manifest."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import sys
from pathlib import Path
from typing import Any


EXPECTED_TASKS = {
