+    try:
+        timestamp = datetime.fromtimestamp(epoch, tz=timezone.utc)
+    except (OSError, OverflowError, ValueError) as error:
+        raise ReleaseError("SOURCE_DATE_EPOCH cannot be represented as UTC") from error
