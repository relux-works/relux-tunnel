   917	  private func progress(
   918	    until deadline: ContinuousClock.Instant,
   919	    phase: SSHTransportPhase,
   920	    scope: SSHTransportErrorScope? = nil
   921	  )
   922	    async throws
   923	  {
   924	    try checkCancellation(phase: phase, scope: scope)
   925	    let now = dependencies.clock.now()
   926	    guard now < deadline else {
   927	      throw transportError(code: .timedOut, phase: phase, scope: scope)
   928	    }
   929	    let remaining = now.duration(to: deadline)
   930	    if context.signatureIsPending() {
   931	      do {
   932	        try await withTimeout(remaining, clock: dependencies.clock) {
   933	          try await self.context.waitForSignature()
   934	        }
   935	      } catch {
   936	        await context.cancelSignatureAndWait()
   937	        throw error
   938	      }
   939	      return
   940	    }
   941	    guard let connection, let engineSession else {
   942	      throw transportError(code: .connectionClosed, phase: phase)
   943	    }
   944	    let directions = libssh2_session_block_directions(engineSession)
   945	    var interests = Set<SSHTCPReadiness>()
   946	    if directions & LIBSSH2_SESSION_BLOCK_INBOUND != 0 { interests.insert(.readable) }
   947	    if directions & LIBSSH2_SESSION_BLOCK_OUTBOUND != 0 { interests.insert(.writable) }
   948	    if interests.isEmpty { interests = [.readable, .writable] }
   949	    let requestedInterests = interests
   950	    do {
   951	      try await withTimeout(remaining, clock: dependencies.clock) {
   952	        try await self.context.network.service(
   953	          connection: connection,
   954	          interests: requestedInterests
   955	        )
   956	      }
   957	    } catch is LibSSH2TimeoutError {
   958	      throw transportError(code: .timedOut, phase: phase, scope: scope)
   959	    } catch is CancellationError {
   960	      throw transportError(code: .cancelled, phase: phase, scope: scope)
   961	    }
   962	  }
   963	
   964	  private func progress(
   965	    phase: SSHTransportPhase,
   966	    scope: SSHTransportErrorScope
   967	  ) async throws {
   968	    try checkCancellation(phase: phase, scope: scope)
   969	    guard let connection, let engineSession else {
   970	      throw transportError(code: .connectionClosed, phase: phase)
   971	    }
   972	    let directions = libssh2_session_block_directions(engineSession)
   973	    var interests = Set<SSHTCPReadiness>()
   974	    if directions & LIBSSH2_SESSION_BLOCK_INBOUND != 0 { interests.insert(.readable) }
   975	    if directions & LIBSSH2_SESSION_BLOCK_OUTBOUND != 0 { interests.insert(.writable) }
   976	    if interests.isEmpty { interests = [.readable, .writable] }
   977	    do {
   978	      try await context.network.service(connection: connection, interests: interests)
   979	      try checkCancellation(phase: phase, scope: scope)
   980	    } catch is CancellationError {
   981	      throw transportError(code: .cancelled, phase: phase, scope: scope)
   982	    }
   983	  }
