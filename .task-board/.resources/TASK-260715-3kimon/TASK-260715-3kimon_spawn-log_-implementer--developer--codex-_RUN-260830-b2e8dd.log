+    let interval = trigger == .cadence ? configuration.cadence : configuration.minimumEventInterval
+    guard let prior else { return false }
+    return prior.duration(to: now) < interval
+  }
+
+  private func markAccepted(trigger: MemoryObservationTrigger, at now: ContinuousClock.Instant) {
