  )

  static let capabilities = RuntimeCapabilitySnapshot(
    requestID: requestID,
    runtimeGeneration: 9,
    snapshotSequence: 3,
    tcp: true,
    safeDNS: true,
    udp: false,
    routeMode: .compatible,
    routesInstalled: true,
    healthy: true
