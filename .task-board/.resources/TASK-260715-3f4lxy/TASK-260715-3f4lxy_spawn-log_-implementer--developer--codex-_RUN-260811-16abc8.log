+      .init(kind: .dns, value: "example.com."),
+      .init(kind: .dns, value: "example..com"),
+      .init(kind: .dns, value: "_ssh.example.com"),
+      .init(kind: .dns, value: "ssh://example.com"),
+      .init(kind: .dns, value: "example.com:22"),
