   213	      } catch {
   214	        waiter.complete(with: .failure(error))
   215	      }
   216	    }
   217	    defer {
   218	      timer.cancel()
   219	      _ = lock.withLock { serviceDrainWaiters.removeValue(forKey: identifier) }
   220	    }
   221	    do {
   222	      try await waiter.wait()
   223	      return true
   224	    } catch {
   225	      return false
   226	    }
   227	  }
