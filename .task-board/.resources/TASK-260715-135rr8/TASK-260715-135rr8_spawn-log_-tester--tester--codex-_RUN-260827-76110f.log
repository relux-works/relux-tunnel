  1347	private func physicalProcessSnapshot() throws -> PhysicalProcessSnapshot {
  1348	  var virtualMemory = task_vm_info_data_t()
  1349	  var virtualMemoryCount = mach_msg_type_number_t(
  1350	    MemoryLayout<task_vm_info_data_t>.size / MemoryLayout<natural_t>.size
  1351	  )
  1352	  let virtualMemoryStatus = withUnsafeMutablePointer(to: &virtualMemory) { pointer in
  1353	    pointer.withMemoryRebound(to: integer_t.self, capacity: Int(virtualMemoryCount)) {
  1354	      task_info(
  1355	        mach_task_self_,
  1356	        task_flavor_t(TASK_VM_INFO),
  1357	        $0,
  1358	        &virtualMemoryCount
  1359	      )
  1360	    }
  1361	  }
  1362	  guard virtualMemoryStatus == KERN_SUCCESS else {
  1363	    throw IntegrationTestError.fixture("task_info(TASK_VM_INFO)=\(virtualMemoryStatus)")
  1364	  }
  1365	  var taskInfo = proc_taskinfo()
  1366	  let taskInfoSize = Int32(MemoryLayout<proc_taskinfo>.size)
  1367	  let read = withUnsafeMutablePointer(to: &taskInfo) {
  1368	    proc_pidinfo(getpid(), PROC_PIDTASKINFO, 0, $0, taskInfoSize)
  1369	  }
  1370	  guard read == taskInfoSize else {
  1371	    throw IntegrationTestError.systemCall("proc_pidinfo(PROC_PIDTASKINFO)", errno)
  1372	  }
  1373	  return PhysicalProcessSnapshot(
  1374	    physicalFootprintBytes: virtualMemory.phys_footprint,
  1375	    peakPhysicalFootprintBytes: UInt64(max(0, virtualMemory.ledger_phys_footprint_peak)),
  1376	    availableMemoryBytes: nil,
  1377	    availableMemoryAvailability:
  1378	      "unavailable: os_proc_available_memory is explicitly unavailable on macOS in the public SDK; no host-memory proxy substituted",
  1379	    descriptors: openDescriptorCount(),
  1380	    threads: Int(taskInfo.pti_threadnum)
  1381	  )
  1382	}
